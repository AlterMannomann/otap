SQL> DECLARE
  2    l_count NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO l_count FROM user_scheduler_jobs WHERE job_name = 'OTAP_MAINTENANCE';
  5    IF l_count = 1
  6    THEN
  7  	 -- drop the job
  8  	 DBMS_SCHEDULER.DISABLE(name => 'OTAP_MAINTENANCE', force => TRUE);
  9  	 DBMS_SCHEDULER.DROP_JOB(job_name => 'OTAP_MAINTENANCE', force => TRUE);
 10  	 DBMS_OUTPUT.PUT_LINE('Disabled and dropped job OTAP_MAINTENANCE');
 11    ELSE
 12  	 -- inform job does not exist
 13  	 DBMS_OUTPUT.PUT_LINE('WARNING Job OTAP_MAINTENANCE does not exist, do nothing');
 14    END IF;
 15  END;
