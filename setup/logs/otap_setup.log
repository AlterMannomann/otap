694    FUNCTION has_table( p_table_name      IN 	   VARCHAR2
695  			 , o_otap_session    IN OUT NOCOPY OTAP_SESSION
696  			 , p_schema	     IN 	   VARCHAR2	DEFAULT NULL
697  			 , p_description     IN 	   VARCHAR2	DEFAULT NULL
698  			 , p_expected_result IN 	   NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
699  			 )
700  	 RETURN VARCHAR2
701    IS
702  	 l_script	    VARCHAR2(1024 CHAR) 		 := 'otap_api.has_table';
703  	 l_start	    TIMESTAMP;
704  	 l_result	    INTEGER;
705  	 l_return	    VARCHAR2(4000 CHAR);
706  	 l_errors	    otap_results.test_errors%TYPE;
707  	 l_schema	    otap_results.db_schema%TYPE;
708  	 l_desc 	    otap_results.test_desc%TYPE;
709  	 l_tmp_otap_session OTAP_SESSION;
710    BEGIN
711  	 l_start  := SYSTIMESTAMP;
712  	 -- default return
713  	 l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED) || ' ' || otap_constants.OTAP_INTERNAL_NA;
714  	 -- own begin-end for the transaction after the function
715  	 BEGIN
716  	   -- own begin-end block for the function itself and prepare
717  	   BEGIN
718  	     l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
719  	     l_desc   := otap_string.reduce( otap_report.get_exists_msg( p_object_name => p_table_name
720  								       , p_schema_name => l_schema
721  								       , p_object_type => otap_util.CFG_LABEL_TABLE
722  								       , p_sub_object => NULL
723  								       , p_desc => p_description
724  								       )
725  					   , 256
726  					   )
727  	     ;
728  	     -- call function
729  	     l_result := otap_schema.has_table( p_table_name
730  					      , l_errors
731  					      , l_schema
732  					      , p_expected_result
733  					      )
734  	     ;
735  	   EXCEPTION
736  	     WHEN OTHERS THEN
737  	     -- consume error
738  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
739  	     l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
740  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
741  	   END;
742  	   -- write result
743  	   l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
744  	 EXCEPTION
745  	   WHEN OTHERS THEN
746  	     -- consume error
747  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
748  	     l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
749  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
750  	     -- try again
751  	     l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
752  	 END;
753  	 -- return result or let exception happen
754  	 RETURN l_return;
755    END has_table;
756  
