 21    FUNCTION init_test( p_test_count      IN NUMBER	 DEFAULT 0
 22  			 , p_test_set	     IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_TEST_SET
 23  			 , p_test_group      IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_TEST_GROUP
 24  			 , p_prefix	     IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_PREFIX
 25  			 , p_name_precedence IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_TRUE
 26  			 , p_include_pkg     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
