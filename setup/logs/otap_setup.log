129    PROCEDURE set_default_prefix(p_default_prefix IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_PREFIX)
130    IS
131  	 l_prefix otap_config.config_value%TYPE;
132    BEGIN
133  	 l_prefix := CASE
134  		       WHEN LENGTH(p_default_prefix) > otap_constants.OTAP_PREFIX_MAX_SIZE
135  			 OR INSTR(p_default_prefix, '_') > 0
136  		       THEN otap_constants.OTAP_DEFAULT_PREFIX
137  		       ELSE p_default_prefix
138  		     END
139  	 ;
140  	 set_config_value(otap_constants.OTAP_CFG_DEFAULT_PREFIX, l_prefix);
141    END set_default_prefix;
