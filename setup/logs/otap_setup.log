  4    PROCEDURE otap_session_verify(p_otap_session IN OTAP_SESSION)
  5    IS
  6  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_verify';
  7  	 l_statement VARCHAR2(32767 CHAR);
  8  	 l_message   VARCHAR2(32767 CHAR);
  9  	 l_delimiter VARCHAR2(1 CHAR);
 10    BEGIN
 11  	 -- we expect all fields to be NOT NULL including empty strings
 12  	 IF    p_otap_session				  IS NULL
 13  	    OR p_otap_session.test_executor		  IS NULL
 14  	    OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
 15  	    OR p_otap_session.test_set			  IS NULL
 16  	    OR LENGTH(TRIM(p_otap_session.test_set))	   = 0
 17  	    OR p_otap_session.test_group		  IS NULL
 18  	    OR LENGTH(TRIM(p_otap_session.test_group))	   = 0
 19  	    OR p_otap_session.test_name 		  IS NULL
 20  	    OR LENGTH(TRIM(p_otap_session.test_name))	   = 0
 21  	    OR p_otap_session.db_user			  IS NULL
 22  	    OR LENGTH(TRIM(p_otap_session.db_user))	   = 0
 23  	    OR p_otap_session.db_schema 		  IS NULL
 24  	    OR LENGTH(TRIM(p_otap_session.db_schema))	   = 0
 25  	    OR p_otap_session.test_prefix		  IS NULL
 26  	    OR p_otap_session.session_language		  IS NULL
 27  	    OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
 28  	    OR p_otap_session.test_count		  IS NULL
 29  	    OR p_otap_session.intended_count		  IS NULL
 30  	    OR p_otap_session.persist_test		  IS NULL
 31  	    OR p_otap_session.name_precedence		  IS NULL
 32  	    OR p_otap_session.include_packages		  IS NULL
 33  	    OR p_otap_session.session_start		  IS NULL
 34  	    OR p_otap_session.session_id		  IS NULL
 35  	    OR p_otap_session.error_count		  IS NULL
 36  	    OR p_otap_session.session_view_id		  IS NULL
 37  	 THEN
 38  	   l_delimiter := '';
 39  	   l_statement := q'[p_otap_session				IS NULL
 40  OR p_otap_session.test_executor		   IS NULL
 41  OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
 42  OR p_otap_session.test_set 		   IS NULL
 43  OR LENGTH(TRIM(p_otap_session.test_set))	    = 0
 44  OR p_otap_session.test_group		   IS NULL
 45  OR LENGTH(TRIM(p_otap_session.test_group))     = 0
 46  OR p_otap_session.test_name		   IS NULL
 47  OR LENGTH(TRIM(p_otap_session.test_name))	    = 0
 48  OR p_otap_session.db_user			   IS NULL
 49  OR LENGTH(TRIM(p_otap_session.db_user))	    = 0
 50  OR p_otap_session.db_schema		   IS NULL
 51  OR LENGTH(TRIM(p_otap_session.db_schema))	    = 0
 52  OR p_otap_session.test_prefix		   IS NULL
 53  OR p_otap_session.session_language 	   IS NULL
 54  OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
 55  OR p_otap_session.test_count		   IS NULL
 56  OR p_otap_session.intended_count		   IS NULL
 57  OR p_otap_session.persist_test		   IS NULL
 58  OR p_otap_session.name_precedence		   IS NULL
 59  OR p_otap_session.include_packages 	   IS NULL
 60  OR p_otap_session.session_start		   IS NULL
 61  OR p_otap_session.session_id		   IS NULL
 62  OR p_otap_session.error_count		   IS NULL
 63  OR p_otap_session.session_view_id		   IS NULL]'
 64  	   ;
 65  	   -- if we fail, find out the columns that are NULL
 66  	   l_message := 'ERROR otap_objects.otap_session_verify. Invalid OTAP_SESSION object. NULL errors: ';
 67  	   IF p_otap_session IS NULL
 68  	   THEN
 69  	     l_message := l_message || 'Complete OTAP_SESSION object NULL';
 70  	   ELSE
 71  	     -- check the fields
 72  	     IF p_otap_session.test_executor IS NULL OR LENGTH(TRIM(p_otap_session.test_executor)) = 0
 73  	     THEN
 74  	       l_message := l_message || l_delimiter || 'test_executor';
 75  	       l_delimiter := ',';
 76  	     END IF;
 77  	     IF p_otap_session.test_set IS NULL OR LENGTH(TRIM(p_otap_session.test_set)) = 0
 78  	     THEN
 79  	       l_message := l_message || l_delimiter || 'test_set';
 80  	       l_delimiter := ',';
 81  	     END IF;
 82  	     IF p_otap_session.test_group IS NULL OR LENGTH(TRIM(p_otap_session.test_group)) = 0
 83  	     THEN
 84  	       l_message := l_message || l_delimiter || 'test_group';
 85  	       l_delimiter := ',';
 86  	     END IF;
 87  	     IF p_otap_session.test_name IS NULL OR LENGTH(TRIM(p_otap_session.test_name)) = 0
 88  	     THEN
 89  	       l_message := l_message || l_delimiter || 'test_name';
 90  	       l_delimiter := ',';
 91  	     END IF;
 92  	     IF p_otap_session.db_user IS NULL OR LENGTH(TRIM(p_otap_session.db_user)) = 0
 93  	     THEN
 94  	       l_message := l_message || l_delimiter || 'db_user';
 95  	       l_delimiter := ',';
 96  	     END IF;
 97  	     IF p_otap_session.db_schema IS NULL OR LENGTH(TRIM(p_otap_session.db_schema)) = 0
 98  	     THEN
 99  	       l_message := l_message || l_delimiter || 'db_schema';
100  	       l_delimiter := ',';
101  	     END IF;
102  	     IF p_otap_session.test_prefix IS NULL OR LENGTH(TRIM(p_otap_session.test_prefix)) = 0
103  	     THEN
104  	       l_message := l_message || l_delimiter || 'test_prefix';
105  	       l_delimiter := ',';
106  	     END IF;
107  	     IF p_otap_session.session_language IS NULL OR LENGTH(TRIM(p_otap_session.session_language)) = 0
108  	     THEN
109  	       l_message := l_message || l_delimiter || 'session_language';
110  	       l_delimiter := ',';
111  	     END IF;
112  	     IF p_otap_session.test_count IS NULL
113  	     THEN
114  	       l_message := l_message || l_delimiter || 'test_count';
115  	       l_delimiter := ',';
116  	     END IF;
117  	     IF p_otap_session.intended_count IS NULL
118  	     THEN
119  	       l_message := l_message || l_delimiter || 'intended_count';
120  	       l_delimiter := ',';
121  	     END IF;
122  	     IF p_otap_session.persist_test IS NULL
123  	     THEN
124  	       l_message := l_message || l_delimiter || 'persist_test';
125  	       l_delimiter := ',';
126  	     END IF;
127  	     IF p_otap_session.name_precedence IS NULL
128  	     THEN
129  	       l_message := l_message || l_delimiter || 'name_precedence';
130  	       l_delimiter := ',';
131  	     END IF;
132  	     IF p_otap_session.include_packages IS NULL
133  	     THEN
134  	       l_message := l_message || l_delimiter || 'include_packages';
135  	       l_delimiter := ',';
136  	     END IF;
137  	     IF p_otap_session.session_start IS NULL
138  	     THEN
139  	       l_message := l_message || l_delimiter || 'session_start';
140  	       l_delimiter := ',';
141  	     END IF;
142  	     IF p_otap_session.session_id IS NULL
143  	     THEN
144  	       l_message := l_message || l_delimiter || 'session_id';
145  	       l_delimiter := ',';
146  	     END IF;
147  	     IF p_otap_session.error_count IS NULL
148  	     THEN
149  	       l_message := l_message || l_delimiter || 'error_count';
150  	       l_delimiter := ',';
151  	     END IF;
152  	     IF p_otap_session.session_view_id IS NULL
153  	     THEN
154  	       l_message := l_message || l_delimiter || 'session_view_id';
155  	       l_delimiter := ',';
156  	     END IF;
157  	   END IF;
158  	   otap_log.log('EXCEPTION -20099 ' || l_message, 'otap_objects.otap_session_verify', l_statement);
159  	   RAISE_APPLICATION_ERROR(-20099, l_message);
160  	 END IF;
161    EXCEPTION
162  	 WHEN OTHERS THEN
163  	   IF SQLCODE != -20099
164  	   THEN
165  	     -- log unhandled exceptions
166  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
167  	   END IF;
168  	   RAISE;
169    END otap_session_verify;
