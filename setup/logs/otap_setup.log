229    FUNCTION translate_yes_no(p_bool_num IN NUMBER)
230  	 RETURN VARCHAR2
231  	 DETERMINISTIC
232  	 PARALLEL_ENABLE
233    IS
234  	 l_return  VARCHAR2(10);
235    BEGIN
236  	 l_return := CASE p_bool_num
237  		       WHEN otap_constants.OTAP_NUM_TRUE
238  		       THEN otap_constants.OTAP_CHAR_TRUE_YES
239  		       WHEN otap_constants.OTAP_NUM_FALSE
240  		       THEN otap_constants.OTAP_CHAR_FALSE_NO
241  		       ELSE NULL
242  		     END;
243  	 RETURN l_return;
244    END translate_yes_no;
245  
246    FUNCTION translate_bool(p_bool_num IN NUMBER)
247  	 RETURN VARCHAR2
248  	 DETERMINISTIC
249  	 PARALLEL_ENABLE
250    IS
251  	 l_return  VARCHAR2(10);
252    BEGIN
253  	 l_return := CASE p_bool_num
254  		       WHEN otap_constants.OTAP_NUM_TRUE
255  		       THEN otap_constants.OTAP_CHAR_TRUE
256  		       WHEN otap_constants.OTAP_NUM_FALSE
257  		       THEN otap_constants.OTAP_CHAR_FALSE
258  		       ELSE NULL
259  		     END;
260  	 RETURN l_return;
261    END translate_bool;
262  
263    FUNCTION translate_test_result(p_test_results IN NUMBER)
264  	 RETURN VARCHAR2
265  	 DETERMINISTIC
266  	 PARALLEL_ENABLE
267    IS
268  	 l_return  VARCHAR2(10);
269    BEGIN
270  	 l_return := CASE p_test_results
271  		       WHEN otap_constants.OTAP_NUM_TEST_PASSED
272  		       THEN otap_constants.OTAP_CHAR_TEST_PASSED
273  		       WHEN otap_constants.OTAP_NUM_TEST_FAILED
274  		       THEN otap_constants.OTAP_CHAR_TEST_FAILED
275  		       WHEN otap_constants.OTAP_NUM_TEST_UNDEFINED
276  		       THEN otap_constants.OTAP_CHAR_TEST_UNDEFINED
277  		       ELSE NULL
278  		     END;
279  	 RETURN l_return;
280    END translate_test_result;
281  
282  END;
