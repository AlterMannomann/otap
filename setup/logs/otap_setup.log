724    FUNCTION build_msg( p_cfg_template  IN VARCHAR2
725  			 , p_type_label    IN VARCHAR2 DEFAULT NULL
726  			 , p_param1	   IN VARCHAR2 DEFAULT NULL
727  			 , p_param1_value  IN VARCHAR2 DEFAULT NULL
728  			 , p_param2	   IN VARCHAR2 DEFAULT NULL
729  			 , p_param2_value  IN VARCHAR2 DEFAULT NULL
730  			 , p_param3	   IN VARCHAR2 DEFAULT NULL
731  			 , p_param3_value  IN VARCHAR2 DEFAULT NULL
732  			 , p_param4	   IN VARCHAR2 DEFAULT NULL
733  			 , p_param4_value  IN VARCHAR2 DEFAULT NULL
734  			 , p_param5	   IN VARCHAR2 DEFAULT NULL
735  			 , p_param5_value  IN VARCHAR2 DEFAULT NULL
736  			 , p_param6n	   IN VARCHAR2 DEFAULT NULL
737  			 , p_param6n_value IN VARCHAR2 DEFAULT NULL
738  			 , p_description   IN VARCHAR2 DEFAULT NULL
739  			 , p_language_id   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
740  			 )
741  	 RETURN VARCHAR2
742    IS
743  	 l_script	 VARCHAR2(256 CHAR) := 'otap_util.build_msg';
744  	 l_text_result	 VARCHAR2(4000 CHAR);
745  	 l_label	 VARCHAR2(256 CHAR);
746  	 l_var_count	 INTEGER;
747    BEGIN
748  	 IF p_description IS NOT NULL
749  	 THEN
750  	   l_text_result := otap_string.reduce(p_description, 4000);
751  	 ELSE
752  	   IF p_cfg_template IS NULL
753  	   THEN
754  	     l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' missing description and template identifier';
755  	     otap_log.log(l_text_result, l_script);
756  	   ELSE
757  	     l_text_result := otap_util.get_config_value(p_cfg_template, p_language_id);
758  	     IF l_text_result = otap_constants.OTAP_INTERNAL_ERROR
759  	     THEN
760  	       l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' invalid template identifier ' || p_cfg_template;
761  	       otap_log.log(l_text_result, l_script);
762  	     ELSE
763  	       -- check variables, only modify if present, otherwise text is delivered as is
764  	       l_var_count := REGEXP_COUNT(l_text_result, '@');
765  	       -- check also that @@ comes in pairs like valid variables
766  	       IF l_var_count != 0 AND MOD(l_var_count, 2) = 0
767  	       THEN
768  		 -- check type present
769  		 IF	p_type_label					  IS NOT NULL
770  		    AND INSTR(l_text_result, otap_constants.OTAP_TYPE_VAR) > 0
771  		 THEN
772  		   l_label := otap_util.get_config_value(p_type_label, p_language_id);
773  		   -- do nothing on errors
774  		   IF l_label != otap_constants.OTAP_INTERNAL_ERROR
775  		   THEN
776  		     -- replace if exists in template
777  		     l_text_result := REPLACE(l_text_result, otap_constants.OTAP_TYPE_VAR, l_label);
778  		   ELSE
779  		     otap_log.log('Type ignored, Invalid label used: ' || p_type_label, l_script);
780  		   END IF;
781  		 END IF;
782  		 -- check vars and replace if condition met
783  		 IF p_param1_value IS NOT NULL
784  		 THEN
785  		   IF	  p_param1		     IS NOT NULL
786  		      AND REGEXP_COUNT(p_param1, '@') = 2
787  		   THEN
788  		     -- replace, may work, may not
789  		     l_text_result := REPLACE(l_text_result, p_param1, p_param1_value);
790  		   ELSE
791  		     -- ignore, log error
792  		     otap_log.log('Value without variable name: ' || p_param1_value || ' or invalid parameter: ' || NVL(p_param1, 'NULL'), l_script);
793  		   END IF;
794  		 END IF;
795  		 IF p_param2_value IS NOT NULL
796  		 THEN
797  		   IF	  p_param2		     IS NOT NULL
798  		      AND REGEXP_COUNT(p_param2, '@') = 2
799  		   THEN
800  		     -- replace, may work, may not
801  		     l_text_result := REPLACE(l_text_result, p_param2, p_param2_value);
802  		   ELSE
803  		     -- ignore, log error
804  		     otap_log.log('Value without variable name: ' || p_param2_value || ' or invalid parameter: ' || NVL(p_param2, 'NULL'), l_script);
805  		   END IF;
806  		 END IF;
807  		 IF p_param3_value IS NOT NULL
808  		 THEN
809  		   IF	  p_param3		     IS NOT NULL
810  		      AND REGEXP_COUNT(p_param3, '@') = 2
811  		   THEN
812  		     -- replace, may work, may not
813  		     l_text_result := REPLACE(l_text_result, p_param3, p_param3_value);
814  		   ELSE
815  		     -- ignore, log error
816  		     otap_log.log('Value without variable name: ' || p_param3_value || ' or invalid parameter: ' || NVL(p_param3, 'NULL'), l_script);
817  		   END IF;
818  		 END IF;
819  		 IF p_param4_value IS NOT NULL
820  		 THEN
821  		   IF	  p_param4		     IS NOT NULL
822  		      AND REGEXP_COUNT(p_param4, '@') = 2
823  		   THEN
824  		     -- replace, may work, may not
825  		     l_text_result := REPLACE(l_text_result, p_param4, p_param4_value);
826  		   ELSE
827  		     -- ignore, log error
828  		     otap_log.log('Value without variable name: ' || p_param4_value || ' or invalid parameter: ' || NVL(p_param4, 'NULL'), l_script);
829  		   END IF;
830  		 END IF;
831  		 IF p_param5_value IS NOT NULL
832  		 THEN
833  		   IF	  p_param5		     IS NOT NULL
834  		      AND REGEXP_COUNT(p_param5, '@') = 2
835  		   THEN
836  		     -- replace, may work, may not
837  		     l_text_result := REPLACE(l_text_result, p_param5, p_param5_value);
838  		   ELSE
839  		     -- ignore, log error
840  		     otap_log.log('Value without variable name: ' || p_param5_value || ' or invalid parameter: ' || NVL(p_param5, 'NULL'), l_script);
841  		   END IF;
842  		 END IF;
843  		 -- allow NULL value for replace
844  		 IF p_param6n IS NOT NULL
845  		 THEN
846  		   IF REGEXP_COUNT(p_param6n, '@') = 2
847  		   THEN
848  		     -- replace, may work, may not
849  		     l_text_result := REPLACE(l_text_result, p_param6n, p_param6n_value);
850  		   ELSE
851  		     -- ignore, log error
852  		     otap_log.log('Invalid parameter p_param6n: ' || p_param6n, l_script);
853  		   END IF;
854  		 END IF;
855  	       END IF;
856  	     END IF;
857  	   END IF;
858  	 END IF;
859  	 -- remove duplicate space chars
860  	 l_text_result := otap_string.flatten(l_text_result, 4000);
861  	 RETURN l_text_result;
862    EXCEPTION
863  	 WHEN OTHERS THEN
864  	   otap_log.log(SQLERRM, l_script, 'Prepare message from template');
865  	   RAISE;
866  	 RETURN l_text_result;
867    END build_msg;
