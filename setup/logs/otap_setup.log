SQL> -- @status@ represents SNIPPET_SUMMARY_ERROR or SNIPPET_SUMMARY_SUCCESS
SQL> -- @runtime@ represents the runtime as Oracle interval
SQL> -- @runs@ represent the amount of tests executed for the set, group or test name
SQL> -- @errors@ represent the amount of tests with errors for the set, group or test name
SQL> -- @issues@ represent the amount of test setup or internal errors for the set, group or test name
SQL> INSERT INTO otap_config
  2    (config_name, config_value, config_type, config_max_length, translatable, config_description)
  3    VALUES
  4    ('TEMPLATE_SUMMARY', '@status@ runtime: @runtime@ (runs: @runs@ errors: @errors@ issues: @issues@)', otap_constants.get_otap_config_type_char, 256, 1, 'Used as a template, all @variables@ will be replaced by corresponding values. The @variablename@ cannot be changed. Limited to 256 chars, recommended shorter than 80 chars.')
  5  ;

