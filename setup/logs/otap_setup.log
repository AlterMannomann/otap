 60    * @return The given border or a valid border length.
 61    */
 62    FUNCTION check_border(p_border IN INTEGER DEFAULT otap_constants.OTAP_FALLBACK_BORDER)
 63  	 RETURN NUMBER
 64    ;
 65  
