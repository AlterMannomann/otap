393    FUNCTION get_result_line( p_test_state  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
394  			       , p_issue_state IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
395  			       , p_runtime     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
396  			       , p_test_desc   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
397  			       , p_min_fill    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
398  			       )
399  	 RETURN VARCHAR2
400    IS
401  	 l_return_text	 VARCHAR2(32767 CHAR);
402  	 l_template_text VARCHAR2(32767 CHAR);
403  	 l_test_state	 VARCHAR2(32767 CHAR);
404  	 l_issue_state	 VARCHAR2(32767 CHAR);
405  	 l_runtime	 VARCHAR2(32767 CHAR);
406  	 l_desc 	 VARCHAR2(32767 CHAR);
407  	 l_runtime_len	 INTEGER;
408  	 l_desc_len	 INTEGER;
409    BEGIN
410  	 -- get and prepare template
411  	 -- assigning directly the runtime length leads to different result 29 instead of 19 which is the expected value
412  	 -- fetch by SQL
413  	 SELECT LENGTH(TRIM((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_runtime_len FROM dual;
414  	 -- DOES NOT WORK correct: l_runtime_len := LENGTH(TRIM((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND));
415  	 l_desc_len    := NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH) - ((2 * otap_util.get_length_test_state) + l_runtime_len + 3);
416  	 IF l_desc_len <= 0
417  	 THEN
418  	   -- wrong configuration, use a default, display will be not correct but possible
419  	   l_desc_len := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
420  	 END IF;
421  	 -- states must be padded to max state size for correct formatting and consider the layout
422  	 IF otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT) = otap_constants.OTAP_LAYOUT_RIGHT
423  	 THEN
424  	   l_test_state  := otap_string.cut(LPAD(NVL(p_test_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state, ' '), otap_util.get_length_test_state);
425  	   l_issue_state := otap_string.cut(LPAD(NVL(p_issue_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state, ' '), otap_util.get_length_test_state);
426  	   l_runtime	 := otap_string.cut(LPAD(NVL(p_runtime, otap_constants.OTAP_INTERNAL_NA), l_runtime_len, ' '), l_runtime_len);
427  	   l_desc	 := otap_string.cut(LPAD(NVL(p_test_desc, otap_constants.OTAP_INTERNAL_NA), l_desc_len, ' '), l_desc_len);
428  	 ELSE
429  	   -- treat middle and left the same way
430  	   l_test_state  := otap_string.cut(RPAD(NVL(p_test_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state, ' '), otap_util.get_length_test_state);
431  	   l_issue_state := otap_string.cut(RPAD(NVL(p_issue_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state, ' '), otap_util.get_length_test_state);
432  	   l_runtime	 := otap_string.cut(RPAD(NVL(p_runtime, otap_constants.OTAP_INTERNAL_NA), l_runtime_len, ' '), l_runtime_len);
433  	   l_desc	 := otap_string.cut(RPAD(NVL(p_test_desc, otap_constants.OTAP_INTERNAL_NA), l_desc_len, ' '), l_desc_len);
434  	 END IF;
435  	 l_template_text := otap_util.get_config_value(otap_util.CFG_TEMPLATE_RESULT_LINE);
436  	 l_template_text := REPLACE(l_template_text, '@teststate@', l_test_state);
437  	 l_template_text := REPLACE(l_template_text, '@issuestate@', l_issue_state);
438  	 l_template_text := REPLACE(l_template_text, '@runtime@', l_runtime);
439  	 l_template_text := REPLACE(l_template_text, '@testdesc@', l_desc);
440  	 -- get borderless
441  	 l_return_text := otap_report.borderless( l_template_text
442  						, GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), NVL(LENGTH(l_template_text), 0), otap_util.get_length_headers)
443  						)
444  	 ;
445  	 RETURN l_return_text;
446    EXCEPTION
447  	 WHEN OTHERS THEN
448  	   otap_log.log(SQLERRM, 'otap_report.get_result_line', 'Build result line by template');
449  	   RAISE;
450    END get_result_line;
