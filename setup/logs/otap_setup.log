SQL> CREATE OR REPLACE TRIGGER otap_config_upd_trg
  2    BEFORE UPDATE ON otap_config
  3    FOR EACH ROW
  4  BEGIN
  5    -- deny update of config names
  6    :NEW.config_name := :OLD.config_name;
  7    -- translatable is OUT var, prepare var before
  8    :NEW.translatable := NVL(:NEW.translatable, :OLD.translatable);
  9    -- validate config_value and raise
 10    :NEW.config_value := otap_util.validate_config_value( NVL(:NEW.config_name, :OLD.config_name)
 11  							   , NVL(:NEW.config_value, :OLD.config_value)
 12  							   , NVL(:NEW.config_type, :OLD.config_type)
 13  							   , :NEW.translatable
 14  							   , NVL(:NEW.config_max_length, :OLD.config_max_length)
 15  							   )
 16    ;
 17    -- ensure some values are not overwritten
 18    :NEW.created	   := :OLD.created;
 19    :NEW.created_by	   := :OLD.created_by;
 20    :NEW.created_by_os  := :OLD.created_by_os;
 21    :NEW.updated	   := SYSDATE;
 22    :NEW.updated_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 23    :NEW.updated_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 24  END;
