100    *
101    * @return The given string size or the calculated minimum/maximum size.
102    */
103    FUNCTION check_string_size(p_string_length IN INTEGER DEFAULT 0)
104  	 RETURN NUMBER
105    ;
106  
107    /** FUNCTION otap_string.check_layout
108    * Constraints the layout to allowed values. Invalid values will return otap_constants.OTAP_LAYOUT_DEFAULT.
109    *
110    * @param p_layout A valid layout orientation indicator as defined in OTAP_CONSTANTS.
