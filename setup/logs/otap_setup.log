413    FUNCTION get_summary( p_runtime	IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
414  			   , p_runs	IN NUMBER   DEFAULT 0
415  			   , p_errors	IN NUMBER   DEFAULT 0
416  			   , p_issues	IN NUMBER   DEFAULT 0
417  			   , p_min_fill IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
418  			   )
419  	 RETURN VARCHAR2
420    IS
421  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.get_summary';
422  	 l_message VARCHAR2(4000 CHAR);
423  	 l_status  VARCHAR2(4000 CHAR);
424    BEGIN
425  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
426  	 -- execute the wrapped function in an extra block
427  	 BEGIN
428  	   l_status := CASE
429  			 WHEN p_issues > 0
430  			 THEN otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
431  			 WHEN p_errors > 0 AND p_issues <= 0
432  			 THEN otap_constants.OTAP_FALLBACK_TEXT_TEST_FAILED
433  			 ELSE otap_constants.OTAP_FALLBACK_TEXT_TEST_PASSED
434  		       END
435  	   ;
436  	   l_message := otap_report.get_summary(l_status, p_runtime, p_runs, p_errors, p_issues, p_min_fill);
437  	 EXCEPTION
438  	   WHEN OTHERS THEN
439  	     -- consume error
440  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_summary');
441  	     l_message := otap_string.reduce('Internal otap error get report summary: ' || SQLERRM, 4000);
442  	 END;
443  	 -- return or let exception happen
444  	 RETURN l_message;
445    END get_summary;
