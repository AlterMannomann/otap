691    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
692  				  , p_test_passed	IN NUMBER
693  				  , p_test_session_id	IN NUMBER
694  				  , p_test_executor	IN VARCHAR2
695  				  , p_test_set		IN VARCHAR2
696  				  , p_db_user		IN VARCHAR2
697  				  , p_db_schema 	IN VARCHAR2
698  				  , p_test_group	IN VARCHAR2
699  				  , p_test_start	IN TIMESTAMP
700  				  , p_test_end		IN TIMESTAMP
701  				  , p_test_name 	IN VARCHAR2
702  				  , p_test_desc 	IN VARCHAR2
703  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
704  				  )
705    IS
706  	 PRAGMA AUTONOMOUS_TRANSACTION;
707  	 l_script      VARCHAR2(256 CHAR) := 'otap_util.write_test_result';
708  	 l_to_delete   NUMBER;
709  	 l_test_passed NUMBER;
710  	 l_errors      otap_results.test_errors%TYPE;
711    BEGIN
712  	 l_to_delete   := CASE
713  			    WHEN p_to_delete IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
714  			    THEN p_to_delete
715  			    ELSE otap_constants.OTAP_NUM_TRUE
716  			  END
717  	 ;
718  	 -- this is an error and must be handled
719  	 IF p_test_passed NOT IN (otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
720  	 THEN
721  	   l_errors := otap_string.reduce('Invalid test result: ' || p_test_passed || ' ' || p_test_errors, 4000);
722  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
723  	 ELSE
724  	   l_test_passed := p_test_passed;
725  	   l_errors := p_test_errors;
726  	 END IF;
727  	 INSERT INTO otap_results
728  	   ( to_delete
729  	   , test_passed
730  	   , test_session_id
731  	   , test_executor
732  	   , test_set
733  	   , db_user
734  	   , db_schema
735  	   , test_group
736  	   , test_start
737  	   , test_end
738  	   , test_name
739  	   , test_desc
740  	   , test_errors
741  	   ) VALUES ( l_to_delete
742  		    , l_test_passed
743  		    , p_test_session_id
744  		    , p_test_executor
745  		    , p_test_set
746  		    , p_db_user
747  		    , p_db_schema
748  		    , p_test_group
749  		    , p_test_start
750  		    , p_test_end
751  		    , p_test_name
752  		    , p_test_desc
753  		    , l_errors
754  		    )
755  	 ;
756  	 COMMIT;
757    EXCEPTION
758  	 WHEN OTHERS THEN
759  	   otap_log.log(SQLERRM, l_script, 'INSERT into otap_results');
760  	   ROLLBACK;
761  	   RAISE;
762    END write_test_result;
763  
764    PROCEDURE result_cleanup
765    IS
766  	 PRAGMA AUTONOMOUS_TRANSACTION;
767  	 l_script	     VARCHAR2(256 CHAR) := 'otap_util.result_cleanup';
768  	 l_delete_before     DATE;
769  	 l_delete_start      DATE;
770  	 l_delete_batch_size NUMBER;
771  	 l_delete_delay      NUMBER;
772  	 l_row_counter	     NUMBER;
773  	 l_processed	     NUMBER;
774  	 l_delete_msg	     VARCHAR2(32767 CHAR);
775  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
776  	 IS
777  	   SELECT *
778  	     FROM otap_results
779  	    WHERE test_run_date < cp_delete_before
780  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
781  	 ;
782    BEGIN
783  	 -- read config values before starting, values will not change until finished
784  	 l_delete_start      := SYSDATE;
785  	 l_delete_before     := TRUNC(SYSDATE - otap_util.get_config_number(otap_util.CFG_PRESERVE_DAYS));
786  	 l_delete_batch_size := otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE);
787  	 l_delete_delay      := otap_util.get_config_number(otap_util.CFG_DELETE_DELAY);
788  	 l_row_counter	     := 0;
789  	 l_processed	     := 0;
790  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
791  	 otap_log.log(l_delete_msg, l_script, 'Procedure start', 'OTAP_DEBUG');
792  	 FOR rec IN cur_delete_tests(l_delete_before)
793  	 LOOP
794  	   IF l_row_counter >= l_delete_batch_size
795  	   THEN
796  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
797  	     otap_log.log(l_delete_msg, l_script, 'Batch size reached and wait', 'OTAP_DEBUG');
798  	     -- commit the batch
799  	     COMMIT;
800  	     -- reset counter
801  	     l_row_counter := 0;
802  	     -- wait defined time
803  	     DBMS_SESSION.SLEEP(l_delete_delay);
804  	   END IF;
805  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
806  	   l_row_counter := l_row_counter + 1;
807  	   l_processed	 := l_processed + 1;
808  	 END LOOP;
809  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
810  	 otap_log.log(l_delete_msg, l_script, 'Procedure end', 'OTAP_DEBUG');
811  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
812    EXCEPTION
813  	 WHEN OTHERS THEN
814  	   otap_log.log(SQLERRM, l_script, 'DELETE FROM otap_results');
815    END result_cleanup;
816  
817    FUNCTION max_text_size(p_session_id IN NUMBER)
818  	 RETURN NUMBER
819    IS
820  	 l_result NUMBER;
821    BEGIN
822  	 -- use UNION not GREATEST to get a result in any case
823  	 SELECT MAX(str_length) AS max_length
824  	   INTO l_result
825  	   FROM (SELECT otap_constants.get_otap_num_min_fill_length AS str_length FROM dual
826  		  UNION ALL
827  		 SELECT MAX(LENGTH(test_set)) FROM otap_results WHERE test_session_id = p_session_id
828  		  UNION ALL
829  		 SELECT MAX(LENGTH(test_group)) FROM otap_results WHERE test_session_id = p_session_id
830  		  UNION ALL
831  		 SELECT MAX(LENGTH(test_name)) FROM otap_results WHERE test_session_id = p_session_id
832  		  UNION ALL
833  		 SELECT MAX(LENGTH(test_desc)) FROM otap_results WHERE test_session_id = p_session_id
834  		)
835  	 ;
836  	 RETURN l_result;
837    EXCEPTION
838  	 WHEN OTHERS THEN
839  	   otap_log.log(SQLERRM, 'otap_util.max_text_size', 'Get max text size for a given session id');
840  	   RAISE;
841    END max_text_size;
842  
843  END;
