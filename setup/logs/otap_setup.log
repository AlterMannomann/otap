2144  	FUNCTION type_tests( p_like_type     IN VARCHAR2 DEFAULT '%'
2145  			   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2146  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
2147  			   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2148  			   , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2149  			   )
2150  	  RETURN otap_view_result_tbl PIPELINED
2151  	IS
2152  	  l_statement	VARCHAR2(4000 CHAR);
2153  	  l_schema	VARCHAR2(128 CHAR);
2154  	  l_like	VARCHAR2(256 CHAR);
2155  	  l_test_count	INTEGER;
2156  	  l_pad_par	INTEGER;
2157  	  CURSOR cur_types( cp_schema IN VARCHAR2
2158  			  , cp_like   IN VARCHAR2
2159  			  , cp_excl   IN NUMBER
2160  			  )
2161  	  IS
2162  	    SELECT dbo.owner
2163  		 , dbo.object_name
2164  		 , dbo.object_type
2165  		 , dbt.typecode
2166  		 , dbt.predefined
2167  		 , dbt.incomplete
2168  		 , dbt.attributes
2169  		 , dbt.methods
2170  		 , dbt.final
2171  		 , dbt.instantiable
2172  		 , dbt.persistable
2173  	      FROM dba_objects dbo
2174  	      LEFT OUTER JOIN dba_types dbt
2175  		ON dbo.owner = dbt.owner
2176  	       AND dbo.object_name = dbt.type_name
2177  	     WHERE dbo.owner	      = cp_schema
2178  	       AND dbo.object_type    = 'TYPE'
2179  	       AND dbo.object_name LIKE cp_like ESCAPE '\'
2180  	       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
2181  	  ;
2182  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2183  			   , cp_schema IN VARCHAR2
2184  			   , cp_type   IN VARCHAR2
2185  			   , cp_object IN VARCHAR2
2186  			   , cp_scope  IN VARCHAR2
2187  			   , cp_count  IN NUMBER
2188  			   , cp_show   IN NUMBER
2189  			   )
2190  	  IS
2191  	    SELECT result_text
2192  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2193  	  ;
2194  	  CURSOR cur_footer(cp_show IN NUMBER)
2195  	  IS
2196  	    SELECT result_text
2197  	      FROM TABLE(otap_generate.get_footer(cp_show))
2198  	  ;
2199  	BEGIN
2200  	  l_like   := NVL(p_like_type, '%');
2201  	  l_schema := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
2202  	  -- get count
2203  	  SELECT COUNT(*)
2204  	    INTO l_test_count
2205  	    FROM dba_objects dbo
2206  	    LEFT OUTER JOIN dba_types dbt
2207  	      ON dbo.owner = dbt.owner
2208  	     AND dbo.object_name = dbt.type_name
2209  	   WHERE dbo.owner	    = l_schema
2210  	     AND dbo.object_type    = 'TYPE'
2211  	     AND dbo.object_name LIKE l_like ESCAPE '\'
2212  	     AND NOT otap_string.is_sys_object(dbo.object_name, p_excl_sysgen)
2213  	  ;
2214  	  -- get header
2215  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'types', NULL, l_like, l_test_count, p_show_header)
2216  	  LOOP
2217  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2218  	  END LOOP;
2219  	  l_pad_par := otap_generate.get_code_prefix_len + 18;
2220  	  -- build name row
2221  	  l_statement := otap_generate.get_code_pad || '-- set test name for types';
2222  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2223  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''types'')' || otap_generate.get_code_postfix;
2224  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2225  	  FOR rec in cur_types(l_schema, l_like, p_excl_sysgen)
2226  	  LOOP
2227  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_type( p_type_name => ''' || rec.object_name || '''';
2228  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2229  	    IF rec.typecode IS NOT NULL
2230  	    THEN
2231  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_typecode => ''' || rec.typecode || '''';
2232  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2233  	    END IF;
2234  	    IF rec.attributes IS NOT NULL
2235  	    THEN
2236  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_attributes => ''' || rec.attributes || '''';
2237  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2238  	    END IF;
2239  	    IF rec.methods IS NOT NULL
2240  	    THEN
2241  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_methods => ''' || rec.methods || '''';
2242  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2243  	    END IF;
2244  	    IF rec.predefined IS NOT NULL
2245  	    THEN
2246  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_predefined => ''' || rec.predefined || '''';
2247  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2248  	    END IF;
2249  	    IF rec.incomplete IS NOT NULL
2250  	    THEN
2251  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_incomplete => ''' || rec.incomplete || '''';
2252  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2253  	    END IF;
2254  	    IF rec.final IS NOT NULL
2255  	    THEN
2256  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_final => ''' || rec.final || '''';
2257  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2258  	    END IF;
2259  	    IF rec.persistable IS NOT NULL
2260  	    THEN
2261  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_persistable => ''' || rec.persistable || '''';
2262  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2263  	    END IF;
2264  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
2265  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2266  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2267  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2268  	  END LOOP;
2269  	  FOR rec IN cur_footer(p_show_header)
2270  	  LOOP
2271  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2272  	  END LOOP;
2273  	  RETURN;
2274  	EXCEPTION
2275  	  WHEN NO_DATA_NEEDED THEN
2276  	    RAISE;
2277  	END type_tests;
