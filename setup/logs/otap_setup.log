 82    *
 83    * @param p_title_length The length of the title to verify.
 84    * @param p_border The minimum border length to consider for decoration.
 85    *
 86    * @return The given title size or the calculated maximum size.
 87    */
 88    FUNCTION check_title_size( p_title_length IN INTEGER DEFAULT 0
 89  				, p_border	 IN INTEGER DEFAULT otap_constants.OTAP_FALLBACK_BORDER
 90  				)
