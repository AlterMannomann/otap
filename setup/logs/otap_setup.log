201    FUNCTION otap_session_set( p_test_count		IN	      NUMBER
202  				, p_test_set		IN	      VARCHAR2
203  				, p_test_group		IN	      VARCHAR2
204  				, p_test_name		IN	      VARCHAR2
205  				, p_prefix		IN	      VARCHAR2
206  				, p_name_precedence	IN	      NUMBER
207  				, p_include_pkg 	IN	      NUMBER
208  				, p_persist		IN	      NUMBER
209  				, p_schema		IN	      VARCHAR2
210  				, p_user		IN	      VARCHAR2
211  				, p_executor		IN	      VARCHAR2
212  				, o_otap_session	IN OUT NOCOPY OTAP_SESSION
213  				)
214  	 RETURN VARCHAR2
215    IS
216  	 l_script    VARCHAR2(1024) := 'otap_objects.otap_session_set';
217  	 l_message   VARCHAR2(4000);
218  	 l_delimiter VARCHAR2(1);
219    BEGIN
220  	 -- verify the current object
221  	 otap_objects.otap_session_verify(o_otap_session);
222  	 -- now verify the input
223  	 IF    p_schema    IS NULL
224  	    OR p_user	   IS NULL
225  	    OR p_executor  IS NULL
226  	 THEN
227  	   l_message := 'ERROR otap_objects.otap_session_set. Invalid OTAP_SESSION initialization. NULL errors: ';
228  	   l_delimiter := '';
229  	   IF p_schema IS NULL
230  	   THEN
231  	     l_message := l_message || l_delimiter || 'p_schema';
232  	     l_delimiter := ',';
233  	   END IF;
234  	   IF p_user IS NULL
235  	   THEN
236  	     l_message := l_message || l_delimiter || 'p_user';
237  	     l_delimiter := ',';
238  	   END IF;
239  	   IF p_executor IS NULL
240  	   THEN
241  	     l_message := l_message || l_delimiter || 'p_executor';
242  	   END IF;
243  	   l_message := l_message || ' The variable default should never be overwritten by users.';
244  	   otap_util.log('EXCEPTION -20099 ' || l_message, l_script, 'p_schema IS NULL OR p_user IS NULL OR p_executor IS NULL');
245  	   RAISE_APPLICATION_ERROR(-20099, l_message);
246  	 END IF;
247  	 -- check prefix length
248  	 IF    LENGTH(p_prefix) <= 4
249  	    OR LENGTH(p_prefix) > 0
250  	 THEN
251  	   -- no delimiter allowed
252  	   IF REGEXP_INSTR(p_prefix, '[_|$|#]') = 0
253  	   THEN
254  	     o_otap_session.test_prefix := UPPER(TRIM(p_prefix));
255  	   ELSE
256  	     o_otap_session.test_prefix := otap_constants.OTAP_DEFAULT_PREFIX;
257  	     otap_util.log('ERROR checking otap test prefix ' || p_prefix || ' delimiters _, $, # not allowed', l_script, 'REGEXP_INSTR(p_prefix, ''[_|$|#]'') = 0');
258  	   END IF;
259  	 ELSE
260  	   -- leave prefix as defined, log error
261  	   o_otap_session.test_prefix := otap_constants.OTAP_DEFAULT_PREFIX;
262  	   otap_util.log('ERROR checking otap test prefix ' || p_prefix || ' length, only length 1-4 allowed', l_script, 'LENGTH(p_prefix) <= 4 OR LENGTH(p_prefix) > 0');
263  	 END IF;
264  	 -- check bool values
265  	 IF NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
266  	 THEN
267  	   o_otap_session.name_precedence := (NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) = otap_constants.OTAP_NUM_TRUE);
268  	 END IF;
269  	 IF NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
270  	 THEN
271  	   o_otap_session.include_packages := (NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
272  	 END IF;
273  	 IF NVL(p_persist, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
274  	 THEN
275  	   o_otap_session.persist_test := (NVL(p_persist, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
276  	 END IF;
277  	 -- now start setting the new values
278  	 o_otap_session.test_executor	:= p_executor;
279  	 o_otap_session.db_user 	:= p_user;
280  	 o_otap_session.db_schema	:= p_schema;
281  	 o_otap_session.intended_count	:= NVL(p_test_count, 0);
282  	 -- keep old values if not specified
283  	 o_otap_session.test_set	:= NVL(p_test_set, o_otap_session.test_set);
284  	 o_otap_session.test_group	:= NVL(p_test_group, o_otap_session.test_group);
285  	 o_otap_session.test_name	:= NVL(p_test_name, o_otap_session.test_name);
286  	 -- reset other session values
287  	 o_otap_session.test_count	:= 0;
288  	 o_otap_session.error_count	:= 0;
289  	 o_otap_session.session_start	:= SYSDATE;
290  	 o_otap_session.session_id	:= otap_test_session_seq.NEXTVAL;
291  	 -- set view id equal to session id
292  	 o_otap_session.session_view_id := o_otap_session.session_id;
293  	 l_message := otap_objects.otap_session_show(o_otap_session);
294  	 RETURN l_message;
295    EXCEPTION
296  	 WHEN OTHERS THEN
297  	   IF SQLCODE != -20099
298  	   THEN
299  	     -- log unhandled exceptions
300  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
301  	   END IF;
302  	   RAISE;
303    END otap_session_set;
