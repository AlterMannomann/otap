256    PROCEDURE validate_translatable(p_otap_identifier IN VARCHAR2)
257    IS
258  	 l_script	   VARCHAR2(1024 CHAR) := 'otap_util.validate_translatable';
259  	 l_is_translatable INTEGER;
260  	 l_exists	   INTEGER;
261    BEGIN
262  	 SELECT COUNT(*)
263  	   INTO l_exists
264  	   FROM otap_config
265  	  WHERE config_name = TRIM(UPPER(p_otap_identifier))
266  	 ;
267  	 IF l_exists > 0
268  	 THEN
269  	   SELECT COUNT(*)
270  	     INTO l_is_translatable
271  	     FROM otap_config
272  	   WHERE config_name   = TRIM(UPPER(p_otap_identifier))
273  	     AND translatable  = otap_constants.OTAP_NUM_TRUE
274  	   ;
275  	   IF l_is_translatable = 0
276  	   THEN
277  	     -- log the error
278  	     otap_log.log('-20020 The given identifier: ' || NVL(p_otap_identifier, 'NULL') || ' cannot be translated. Ask your admin to adjust this configuration item.', l_script);
279  	     -- only direct testing could call this currently as table has a NOT NULL constraint
280  	     RAISE_APPLICATION_ERROR(-20020, 'The given identifier: ' || NVL(p_otap_identifier, 'NULL') || ' cannot be translated. Ask your admin to adjust this configuration item.');
281  	   END IF;
282  	 END IF;
283    END validate_translatable;
