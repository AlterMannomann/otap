124    PROCEDURE verify_otap_session(p_otap_session IN OTAP_SESSION)
125    IS
126  	 l_statement VARCHAR2(32767);
127    BEGIN
128  	 -- we expect all fields to be NOT NULL including empty strings
129  	 IF    p_otap_session				  IS NULL
130  	    OR p_otap_session.test_executor		  IS NULL
131  	    OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
132  	    OR p_otap_session.test_set			  IS NULL
133  	    OR LENGTH(TRIM(p_otap_session.test_set))	   = 0
134  	    OR p_otap_session.test_group		  IS NULL
135  	    OR LENGTH(TRIM(p_otap_session.test_group))	   = 0
136  	    OR p_otap_session.test_name 		  IS NULL
137  	    OR LENGTH(TRIM(p_otap_session.test_name))	   = 0
138  	    OR p_otap_session.db_user			  IS NULL
139  	    OR LENGTH(TRIM(p_otap_session.db_user))	   = 0
140  	    OR p_otap_session.db_schema 		  IS NULL
141  	    OR LENGTH(TRIM(p_otap_session.db_schema))	   = 0
142  	    OR p_otap_session.test_prefix		  IS NULL
143  	    OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
144  	    OR p_otap_session.test_count		  IS NULL
145  	    OR p_otap_session.intended_count		  IS NULL
146  	    OR p_otap_session.persist_test		  IS NULL
147  	    OR p_otap_session.name_precedence		  IS NULL
148  	    OR p_otap_session.include_packages		  IS NULL
149  	 THEN
150  	   l_statement := q'[p_otap_session				IS NULL
151  OR p_otap_session.test_executor		   IS NULL
152  OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
153  OR p_otap_session.test_set 		   IS NULL
154  OR LENGTH(TRIM(p_otap_session.test_set))	    = 0
155  OR p_otap_session.test_group		   IS NULL
156  OR LENGTH(TRIM(p_otap_session.test_group))     = 0
157  OR p_otap_session.test_name		   IS NULL
158  OR LENGTH(TRIM(p_otap_session.test_name))	    = 0
159  OR p_otap_session.db_user			   IS NULL
160  OR LENGTH(TRIM(p_otap_session.db_user))	    = 0
161  OR p_otap_session.db_schema		   IS NULL
162  OR LENGTH(TRIM(p_otap_session.db_schema))	    = 0
163  OR p_otap_session.test_prefix		   IS NULL
164  OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
165  OR p_otap_session.test_count		   IS NULL
166  OR p_otap_session.intended_count		   IS NULL
167  OR p_otap_session.persist_test		   IS NULL
168  OR p_otap_session.name_precedence		   IS NULL
169  OR p_otap_session.include_packages 	   IS NULL]'
170  	   ;
171  	   otap_util.log('EXCEPTION -20099 invalid OTAP_SESSION object. Internal error. OTAP_TEST session_record must be complete, NULL not allowed. Not possible to continue. Test results will not reliable.', 'otap_plan.verify_otap_session', l_statement);
172  	   RAISE_APPLICATION_ERROR(-20099, 'ERROR otap_plan.verify_otap_session. Internal error. OTAP_TEST session_record must be complete, NULL not allowed. Not possible to continue. Test results are not reliable.');
173  	 END IF;
174    END verify_otap_session;
