 37    FUNCTION borderless( p_string	 IN VARCHAR2
 38  			  , p_min_fill	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
 39  			  )
 40  	 RETURN VARCHAR2
 41    IS
 42  	 l_border      INTEGER;
 43  	 l_layout      VARCHAR2(1 CHAR);
 44  	 l_string_size INTEGER;
 45  	 l_min_fill    INTEGER;
 46  	 l_min_length  INTEGER;
 47  	 l_string      VARCHAR2(32767 CHAR);
 48  	 l_return_text VARCHAR2(32767 CHAR);
 49    BEGIN
 50  	 l_border      := otap_util.get_config_value(otap_util.CFG_DEFAULT_BORDER);
 51  	 l_layout      := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT));
 52  	 l_string_size := otap_string.check_string_size(NVL(LENGTH(p_string), 0));
 53  	 l_string      := otap_string.reduce(p_string, l_string_size);
 54  	 l_min_fill    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_string_size);
 55  	 l_min_length  := otap_string.line_size(l_string_size, l_border);
 56  	 l_return_text := otap_string.borderless(l_string, l_min_length, l_layout);
 57  	 RETURN l_return_text;
 58    EXCEPTION
 59  	 WHEN OTHERS THEN
 60  	   otap_log.log(SQLERRM, 'otap_report.borderless', 'Create borderless report line');
 61  	   RAISE;
 62    END borderless;
