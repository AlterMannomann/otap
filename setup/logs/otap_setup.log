869    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
870  				  , p_test_passed	IN NUMBER
871  				  , p_test_session_id	IN NUMBER
872  				  , p_test_executor	IN VARCHAR2
873  				  , p_test_set		IN VARCHAR2
874  				  , p_db_user		IN VARCHAR2
875  				  , p_db_schema 	IN VARCHAR2
876  				  , p_test_group	IN VARCHAR2
877  				  , p_test_start	IN TIMESTAMP
878  				  , p_test_end		IN TIMESTAMP
879  				  , p_test_name 	IN VARCHAR2
880  				  , p_test_desc 	IN VARCHAR2
881  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
882  				  )
883    IS
884  	 PRAGMA AUTONOMOUS_TRANSACTION;
885  	 l_script      VARCHAR2(256 CHAR) := 'otap_util.write_test_result';
886  	 l_to_delete   NUMBER;
887  	 l_test_passed NUMBER;
888  	 l_errors      otap_results.test_errors%TYPE;
889    BEGIN
890  	 l_to_delete   := CASE
891  			    WHEN p_to_delete IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
892  			    THEN p_to_delete
893  			    ELSE otap_constants.OTAP_NUM_TRUE
894  			  END
895  	 ;
896  	 -- this is an error and must be handled
897  	 IF p_test_passed NOT IN (otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
898  	 THEN
899  	   l_errors := otap_string.reduce('Invalid test result: ' || p_test_passed || ' ' || p_test_errors, 4000);
900  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
901  	 ELSE
902  	   l_test_passed := p_test_passed;
903  	   l_errors := p_test_errors;
904  	 END IF;
905  	 INSERT INTO otap_results
906  	   ( to_delete
907  	   , test_passed
908  	   , test_session_id
909  	   , test_executor
910  	   , test_set
911  	   , db_user
912  	   , db_schema
913  	   , test_group
914  	   , test_start
915  	   , test_end
916  	   , test_name
917  	   , test_desc
918  	   , test_errors
919  	   ) VALUES ( l_to_delete
920  		    , l_test_passed
921  		    , p_test_session_id
922  		    , p_test_executor
923  		    , p_test_set
924  		    , p_db_user
925  		    , p_db_schema
926  		    , p_test_group
927  		    , p_test_start
928  		    , p_test_end
929  		    , p_test_name
930  		    , p_test_desc
931  		    , l_errors
932  		    )
933  	 ;
934  	 COMMIT;
935    EXCEPTION
936  	 WHEN OTHERS THEN
937  	   otap_log.log(SQLERRM, l_script, 'INSERT into otap_results');
938  	   ROLLBACK;
939  	   RAISE;
940    END write_test_result;
941  
942    PROCEDURE result_cleanup
943    IS
944  	 PRAGMA AUTONOMOUS_TRANSACTION;
945  	 l_script	     VARCHAR2(256 CHAR) := 'otap_util.result_cleanup';
946  	 l_delete_before     DATE;
947  	 l_delete_start      DATE;
948  	 l_delete_batch_size NUMBER;
949  	 l_delete_delay      NUMBER;
950  	 l_row_counter	     NUMBER;
951  	 l_processed	     NUMBER;
952  	 l_delete_msg	     VARCHAR2(32767 CHAR);
953  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
954  	 IS
955  	   SELECT *
956  	     FROM otap_results
957  	    WHERE test_run_date < cp_delete_before
958  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
959  	 ;
960    BEGIN
961  	 -- read config values before starting, values will not change until finished
962  	 l_delete_start      := SYSDATE;
963  	 l_delete_before     := TRUNC(SYSDATE - otap_util.get_config_number(otap_util.CFG_PRESERVE_DAYS));
964  	 l_delete_batch_size := otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE);
965  	 l_delete_delay      := otap_util.get_config_number(otap_util.CFG_DELETE_DELAY);
966  	 l_row_counter	     := 0;
967  	 l_processed	     := 0;
968  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
969  	 otap_log.log(l_delete_msg, l_script, 'Procedure start', 'OTAP_DEBUG');
970  	 FOR rec IN cur_delete_tests(l_delete_before)
971  	 LOOP
972  	   IF l_row_counter >= l_delete_batch_size
973  	   THEN
974  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
975  	     otap_log.log(l_delete_msg, l_script, 'Batch size reached and wait', 'OTAP_DEBUG');
976  	     -- commit the batch
977  	     COMMIT;
978  	     -- reset counter
979  	     l_row_counter := 0;
980  	     -- wait defined time
981  	     DBMS_SESSION.SLEEP(l_delete_delay);
982  	   END IF;
983  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
984  	   l_row_counter := l_row_counter + 1;
985  	   l_processed	 := l_processed + 1;
986  	 END LOOP;
987  	 -- commit any pending deletes
988  	 COMMIT;
989  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
990  	 otap_log.log(l_delete_msg, l_script, 'Procedure end', 'OTAP_DEBUG');
991  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
992    EXCEPTION
993  	 WHEN OTHERS THEN
994  	   otap_log.log(SQLERRM, l_script, 'DELETE FROM otap_results');
995    END result_cleanup;
996  
997    FUNCTION max_text_size(p_session_id IN NUMBER)
998  	 RETURN NUMBER
999    IS
1000  	  l_result NUMBER;
1001  	BEGIN
1002  	  -- use UNION not GREATEST to get a result in any case
1003  	  SELECT MAX(str_length) AS max_length
1004  	    INTO l_result
1005  	    FROM (SELECT otap_constants.get_otap_num_min_fill_length AS str_length FROM dual
1006  		   UNION ALL
1007  		  SELECT MAX(LENGTH(test_set)) FROM otap_results WHERE test_session_id = p_session_id
1008  		   UNION ALL
1009  		  SELECT MAX(LENGTH(test_group)) FROM otap_results WHERE test_session_id = p_session_id
1010  		   UNION ALL
1011  		  SELECT MAX(LENGTH(test_name)) FROM otap_results WHERE test_session_id = p_session_id
1012  		   UNION ALL
1013  		  SELECT MAX(LENGTH(test_desc)) FROM otap_results WHERE test_session_id = p_session_id
1014  		 )
1015  	  ;
1016  	  RETURN l_result;
1017  	EXCEPTION
1018  	  WHEN OTHERS THEN
1019  	    otap_log.log(SQLERRM, 'otap_util.max_text_size', 'Get max text size for a given session id');
1020  	    RAISE;
1021  	END max_text_size;
1022  
1023  	FUNCTION interval_size
1024  	  RETURN NUMBER
1025  	IS
1026  	  l_interval_size NUMBER;
1027  	BEGIN
1028  	  SELECT LENGTH(TRIM((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval_size FROM dual;
1029  	  RETURN l_interval_size;
1030  	EXCEPTION
1031  	  WHEN OTHERS THEN
1032  	    otap_log.log(SQLERRM, 'otap_util.interval_size', 'Get interval text size as displayed in SQL');
1033  	    RAISE;
1034  	END interval_size;
1035  
1036  END;
