359    FUNCTION get_summary( p_runtime	IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
360  			   , p_runs	IN NUMBER   DEFAULT 0
361  			   , p_errors	IN NUMBER   DEFAULT 0
362  			   , p_issues	IN NUMBER   DEFAULT 0
