402    FUNCTION throws_ok( p_statement	     IN 	   VARCHAR2
403  			 , p_sqlerrm	     IN 	   VARCHAR2
404  			 , o_errors		OUT NOCOPY VARCHAR2
405  			 , p_header_def      IN 	   VARCHAR2 DEFAULT NULL
406  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
407  			 )
408  	 RETURN INTEGER
409    IS
410  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_ok';
411  	 l_test_passed	 INTEGER;
412  	 l_expected	 INTEGER;
413  	 l_errors	 VARCHAR2(32767 CHAR);
414  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
415  	 l_sqlcode	 NUMBER;
416    BEGIN
417  	 l_errors      := NULL;
418  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
419  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
420  	 IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
421  	 THEN
422  	   IF l_sqlerrm = p_sqlerrm
423  	   THEN
424  	     l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
425  	   ELSE
426  	     -- decide which case happened
427  	     IF l_sqlcode = -20100
428  	     THEN
429  	       -- invalid header, l_errors should be set and logged already
430  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
431  	     ELSE
432  	       -- exception happened but does not match
433  	       l_errors      := l_errors || 'Given error message does not match with ' || l_sqlerrm;
434  	       l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
435  	       otap_log.log(l_errors, l_script);
436  	     END IF;
437  	   END IF;
438  	 ELSE
439  	   -- no exception raised, l_errors should be set and logged already
440  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
441  	   otap_log.log(l_errors, l_script);
442  	 END IF;
443  	 -- now decide on the expected result the final state and if errors are returned
444  	 IF l_test_passed != l_expected
445  	 THEN
446  	   o_errors := otap_string.reduce(l_errors, 4000);
447  	 ELSE
448  	   -- overwrite states from before, as we fulfill expected
449  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
450  	   -- overwrite errors expected
451  	   o_errors := NULL;
452  	 END IF;
453  	 RETURN l_test_passed;
454    EXCEPTION
455  	 WHEN OTHERS THEN
456  	   IF SQLCODE != -20099
457  	   THEN
458  	     -- log unhandled exceptions
459  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
460  	   END IF;
461  	   RAISE;
462    END throws_ok;
