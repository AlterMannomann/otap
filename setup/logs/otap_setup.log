2855  	  l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED, o_otap_session.session_language) || ' ' || otap_constants.OTAP_INTERNAL_NA;
2856  	  l_schema := COALESCE(p_schema, o_otap_session.db_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'));
2857  	  BEGIN
2858  	    -- define variables
2859  	    l_copy   := otap_objects.otap_session_test_setup( o_otap_session
2860  							    , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_SET, o_otap_session.session_language)
2861  							    , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_GROUP, o_otap_session.session_language)
2862  							    , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_NAME, o_otap_session.session_language)
2863  							    )
2864  	    ;
2865  	    l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
2866  	    l_desc   := p_description;
2867  	    l_errors := p_errors;
2868  	    -- write result
2869  	    l_return := otap_plan.write_test_result(l_desc, l_copy, l_schema, l_result, l_start, l_errors);
2870  	    -- take over the test and error count changes
2871  	    o_otap_session.test_count  := l_copy.test_count;
2872  	    o_otap_session.error_count := l_copy.error_count;
2873  	  EXCEPTION
2874  	    WHEN OTHERS THEN
2875  	      -- consume error
2876  	      l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
2877  	      l_errors := otap_string.reduce(p_errors || ' Internal error ' || l_script || ': ' || SQLERRM, 4000);
2878  	      otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
2879  	      -- try again
2880  	      l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
2881  	  END;
2882  	  -- return result or let exception happen
2883  	  RETURN l_return;
2884  	END test_error;
2885  
2886  	FUNCTION test_error_check( p_have	 IN NUMBER
2887  				 , p_want	 IN NUMBER
2888  				 , p_description IN VARCHAR2
2889  				 , o_otap_session    IN OUT NOCOPY OTAP_SESSION
2890  				 , p_schema	 IN VARCHAR2 DEFAULT NULL
2891  				 )
2892  	  RETURN VARCHAR2
2893  	IS
2894  	  l_script	     VARCHAR2(1024 CHAR)		  := 'otap_api.test_error_check';
2895  	  l_start	     TIMESTAMP;
2896  	  l_result	     INTEGER;
2897  	  l_return	     VARCHAR2(4000 CHAR);
2898  	  l_errors	     otap_results.test_errors%TYPE;
2899  	  l_schema	     otap_results.db_schema%TYPE;
2900  	  l_desc	     otap_results.test_desc%TYPE;
2901  	  l_copy	     OTAP_SESSION;
2902  	BEGIN
2903  	  l_start  := SYSTIMESTAMP;
2904  	  -- default return
2905  	  l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED, o_otap_session.session_language) || ' ' || otap_constants.OTAP_INTERNAL_NA;
2906  	  l_schema := COALESCE(p_schema, o_otap_session.db_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'));
2907  	  BEGIN
2908  	    -- define variables
2909  	    l_copy   := otap_objects.otap_session_test_setup( o_otap_session
2910  							    , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_SET, o_otap_session.session_language)
2911  							    , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_GROUP, o_otap_session.session_language)
2912  							    , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_NAME, o_otap_session.session_language)
2913  							    )
2914  	    ;
2915  	    l_return := otap_api.is_eq(p_have, p_want, l_copy, p_description);
2916  	    -- take over the test and error count changes
2917  	    o_otap_session.test_count  := l_copy.test_count;
2918  	    o_otap_session.error_count := l_copy.error_count;
2919  	  EXCEPTION
2920  	    WHEN OTHERS THEN
2921  	      -- consume error
2922  	      l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
2923  	      l_errors := otap_string.reduce(l_script || ': ' || SQLERRM, 4000);
2924  	      otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
2925  	      -- try again
2926  	      l_return := otap_plan.write_test_result(p_description, o_otap_session, l_schema, l_result, l_start, l_errors);
2927  	  END;
2928  	  -- return result or let exception happen
2929  	  RETURN l_return;
2930  	END test_error_check;
