283    FUNCTION match_regex( p_have	       IN	     VARCHAR2
284  			   , p_regex	       IN	     VARCHAR2
285  			   , o_errors		  OUT NOCOPY VARCHAR2
286  			   , p_param	       IN	     VARCHAR2 DEFAULT NULL
287  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
288  			   )
289  	 RETURN INTEGER
290    IS
291  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.match_regex';
292  	 l_test_passed	 INTEGER;
293  	 l_count	 INTEGER;
294  	 l_expected	 INTEGER;
295  	 l_errors	 VARCHAR2(32767 CHAR);
296    BEGIN
297  	 l_errors      := NULL;
298  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
299  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
300  	 IF p_regex IS NOT NULL
301  	 THEN
302  	   IF p_param IS NOT NULL
303  	   THEN
304  	     -- check parameter
305  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_param, '^[icmnx]*$');
306  	     IF l_count = 1
307  	     THEN
308  	       SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_have, p_regex, p_param);
309  	       l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
310  	     ELSE
311  	       -- invalid parameter
312  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
313  	       l_errors      := 'Not allowed: p_param(' || p_param || ') only i, c, m, n or x supported. Case sensitive.';
314  	       -- log error
315  	       otap_log.log(l_errors, l_script);
316  	     END IF;
317  	   ELSE
318  	     -- leave fail on REGEXP_LIKE if p_have is NULL or params are wrong
319  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_have, p_regex);
320  	     l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
321  	   END IF;
322  	 ELSE
323  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
324  	   l_errors	 := 'Not allowed: p_regex(NULL)';
325  	   -- log error
326  	   otap_log.log(l_errors, l_script);
327  	 END IF;
328  	 -- now decide on the expected result the final state and if errors are returned
329  	 IF l_test_passed != l_expected
330  	 THEN
331  	   o_errors := otap_string.reduce(l_errors, 4000);
332  	 ELSE
333  	   -- overwrite states from before, as we fulfill expected
334  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
335  	   -- overwrite errors expected
336  	   o_errors := NULL;
337  	 END IF;
338  	 RETURN l_test_passed;
339    EXCEPTION
340  	 WHEN OTHERS THEN
341  	   IF SQLCODE != -20099
342  	   THEN
343  	     -- log unhandled exceptions
344  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
345  	   END IF;
346  	   RAISE;
347    END match_regex;
