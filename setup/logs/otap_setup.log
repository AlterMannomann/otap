 76    FUNCTION prepare( p_title_prefix IN	       VARCHAR2
 77  		       , p_schema	IN	       VARCHAR2
 78  		       , p_object_type	IN	       VARCHAR2
 79  		       , p_object	IN	       VARCHAR2
 80  		       , o_set		   OUT NOCOPY  VARCHAR2
 81  		       , o_group	   OUT NOCOPY  VARCHAR2
 82  		       , o_name 	   OUT NOCOPY  VARCHAR2
 83  		       )
 84  	 RETURN VARCHAR2
 85    IS
 86  	 l_set	     VARCHAR2(256 CHAR);
 87  	 l_group     VARCHAR2(256 CHAR);
 88  	 l_name      VARCHAR2(256 CHAR);
 89  	 l_fn_set    VARCHAR2(40 CHAR);
 90  	 l_fn_group  VARCHAR2(30 CHAR);
 91  	 l_fn_name   VARCHAR2(30 CHAR);
 92  	 l_prc_name  VARCHAR2(128 CHAR);
 93    BEGIN
 94  	 -- define display values first
 95  	 l_set	     := NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'));
 96  	 l_fn_set    := otap_string.reduce(REGEXP_REPLACE(l_set, '[^[:alnum:]]'), 30);
 97  	 l_prc_name  := 'test_' || l_fn_set;
 98  	 l_group     := NULL;
 99  	 l_name      := NULL;
100  	 IF p_title_prefix IS NOT NULL
101  	 THEN
102  	   l_fn_set    := otap_string.reduce(REGEXP_REPLACE(p_title_prefix, '[^[:alnum:]]'), 10) || otap_string.reduce(REGEXP_REPLACE(l_set, '[^[:alnum:]]'), 30);
103  	   l_prc_name  := 'test_' || l_fn_set;
104  	   l_set       := otap_string.reduce(TRIM(p_title_prefix) || ' ' || l_set, 256);
105  	 END IF;
106  	 IF p_object_type IS NOT NULL
107  	 THEN
108  	   l_fn_group  := otap_string.reduce(REGEXP_REPLACE(p_object_type, '[^[:alnum:]]'), 30);
109  	   l_group     := otap_string.reduce(p_object_type, 256);
110  	   l_prc_name  := l_prc_name || '_' || l_fn_group;
111  	   IF p_object IS NOT NULL
112  	   THEN
113  	     -- if we arrive here we must not care about extra underscores
114  	     l_fn_name	 := otap_string.reduce(REGEXP_REPLACE(p_object, '[^[:alnum:]_]'), 30);
115  	     l_name	 := otap_string.reduce(p_object, 256);
116  	     l_prc_name  := l_prc_name || '_' || l_fn_name;
117  	   END IF;
118  	 END IF;
119  	 -- set out vars
120  	 o_set	 := l_set;
121  	 o_group := l_group;
122  	 o_name  := l_name;
123  	 RETURN LOWER(l_prc_name);
124    END prepare;
125  
126    PROCEDURE prepare( p_title_prefix IN		VARCHAR2
127  			, p_schema	 IN		VARCHAR2
128  			, p_object_type  IN		VARCHAR2
129  			, p_object	 IN		VARCHAR2
130  			, o_set 	    OUT NOCOPY	VARCHAR2
131  			, o_group	    OUT NOCOPY	VARCHAR2
132  			, o_name	    OUT NOCOPY	VARCHAR2
133  			)
134    IS
135  	 l_ignore VARCHAR2(128 CHAR);
136    BEGIN
137  	 l_ignore := otap_generate.prepare(p_title_prefix, p_schema, p_object_type, p_object, o_set, o_group, o_name);
138    END prepare;
