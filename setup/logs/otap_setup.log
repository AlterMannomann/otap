176    FUNCTION init_test( p_test_count 	 IN	       NUMBER
177  			 , p_test_set		 IN	       VARCHAR2
178  			 , p_test_group 	 IN	       VARCHAR2
179  			 , p_prefix		 IN	       VARCHAR2
180  			 , p_name_precedence	 IN	       NUMBER
181  			 , p_include_pkg	 IN	       NUMBER
182  			 , p_persist		 IN	       NUMBER
183  			 , p_schema		 IN	       VARCHAR2
184  			 , p_user		 IN	       VARCHAR2
185  			 , p_executor		 IN	       VARCHAR2
186  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
187  			 )
188  	 RETURN VARCHAR2
189    IS
190  	 l_script  VARCHAR2(1024) := 'otap_plan.init_test';
191  	 l_message VARCHAR2(4000);
192    BEGIN
193  	 IF    p_schema    IS NULL
194  	    OR p_user	   IS NULL
195  	    OR p_executor  IS NULL
196  	 THEN
197  	   otap_util.log('EXCEPTION -20099 invalid otap_test initialization. Internal error. Neither schema, user or executor can be NULL nor should they be set by the user', l_script, 'p_schema IS NULL OR p_user IS NULL OR p_executor IS NULL');
198  	   RAISE_APPLICATION_ERROR(-20099, 'ERROR otap_plan.init_test. Internal error. Invalid otap_test initialization. Neither schema, user or executor can be NULL nor should they be set by the user');
199  	 END IF;
200  	 -- if test count is not 0 this is a reset, write a test count record, if intended count is set
201  	 IF	o_otap_session.test_count      > 0
202  	    AND (   o_otap_session.intended_count  > 0
203  		 OR NVL(p_test_count, 0)	   > 0
204  		)
205  	 THEN
206  	   -- write record with current values
207  	   write_count_result(o_otap_session);
208  	   -- reset test count
209  	   o_otap_session.test_count	 := 0;
210  	 END IF;
211  	 -- now start setting the new values
212  	 o_otap_session.test_executor  := p_executor;
213  	 o_otap_session.db_user        := p_user;
214  	 o_otap_session.db_schema      := p_schema;
215  	 IF NVL(p_test_count, 0) > 0
216  	 THEN
217  	   o_otap_session.intended_count := p_test_count;
218  	 END IF;
219  	 -- check prefix length
220  	 IF    LENGTH(p_prefix) <= 4
221  	    OR LENGTH(p_prefix) > 0
222  	 THEN
223  	   -- no delimiter allowed
224  	   IF REGEXP_INSTR(p_prefix, '[_|$|#]') = 0
225  	   THEN
226  	     o_otap_session.test_prefix := UPPER(TRIM(p_prefix));
227  	   ELSE
228  	     otap_util.log('ERROR checking otap test prefix ' || p_prefix || ' delimiters _, $, # not allowed', l_script, 'REGEXP_INSTR(p_prefix, ''[_|$|#]'') = 0');
229  	   END IF;
230  	 ELSE
231  	   -- leave prefix as defined, log error
232  	   otap_util.log('ERROR checking otap test prefix ' || p_prefix || ' length, only length 1-4 allowed', l_script, 'LENGTH(p_prefix) <= 4 OR LENGTH(p_prefix) > 0');
233  	 END IF;
234  	 o_otap_session.test_set   := NVL(p_test_set, otap_constants.OTAP_DEFAULT_TEST_SET);
235  	 o_otap_session.test_group := NVL(p_test_group, otap_constants.OTAP_DEFAULT_TEST_GROUP);
236  	 IF NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
237  	 THEN
238  	   o_otap_session.name_precedence := (NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) = otap_constants.OTAP_NUM_TRUE);
239  	 END IF;
240  	 IF NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
241  	 THEN
242  	   o_otap_session.include_packages := (NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
243  	 END IF;
244  	 IF NVL(p_persist, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
245  	 THEN
246  	   o_otap_session.persist_test := (NVL(p_persist, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
247  	 END IF;
248  	 l_message := otap_plan.current_test_setting(o_otap_session);
249  	 RETURN l_message;
250    EXCEPTION
251  	 WHEN OTHERS THEN
252  	   IF SQLCODE != -20099
253  	   THEN
254  	     otap_util.log(SQLERRM, l_script, 'otap_plan.init_test call');
255  	   END IF;
256  	   RAISE;
257    END init_test;
258  
259    FUNCTION set_test_name( p_test_name     IN	     VARCHAR2
260  			     , o_otap_session  IN OUT NOCOPY OTAP_SESSION
261  			     )
