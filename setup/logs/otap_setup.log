378    FUNCTION get_label_id(p_object_type IN VARCHAR2)
379  	 RETURN VARCHAR2
380    IS
381  	 l_script VARCHAR2(1024 CHAR) := 'otap_util.get_label_id';
382  	 l_return VARCHAR2(256 CHAR);
383  	 l_count  INTEGER;
384    BEGIN
385  	 SELECT COUNT(*)
386  	   INTO l_count
387  	   FROM otap_labels_mv
388  	  WHERE otap_label_source = UPPER(p_object_type)
