270  
271    FUNCTION get_header( p_title_prefix  IN VARCHAR2 DEFAULT NULL
272  			  , p_schema	    IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
273  			  , p_object_type   IN VARCHAR2 DEFAULT NULL
274  			  , p_object	    IN VARCHAR2 DEFAULT NULL
275  			  , p_scope	    IN VARCHAR2 DEFAULT '%'
276  			  , p_script_count  IN NUMBER	DEFAULT 0
277  			  , p_show_header   IN NUMBER	DEFAULT otap_constants.OTAP_NUM_TRUE
278  			  )
279  	 RETURN otap_view_result_tbl PIPELINED
280    IS
281  	 CURSOR cur_fn_header( cp_prefix IN VARCHAR2
282  			     , cp_schema IN VARCHAR2
283  			     , cp_type	 IN VARCHAR2
284  			     , cp_object IN VARCHAR2
285  			     , cp_scope  IN VARCHAR2
286  			     , cp_count  IN NUMBER
287  			     , cp_show	 IN NUMBER
288  			     )
289  	 IS
290  	   SELECT result_text
291  	     FROM TABLE(otap_generate.build_function_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
292  	 ;
293  	 CURSOR cur_prc_header( cp_prefix IN VARCHAR2
294  			      , cp_schema IN VARCHAR2
295  			      , cp_type   IN VARCHAR2
296  			      , cp_object IN VARCHAR2
297  			      , cp_scope  IN VARCHAR2
298  			      , cp_count  IN NUMBER
299  			      , cp_show   IN NUMBER
300  			      )
301  	 IS
302  	   SELECT result_text
303  	     FROM TABLE(otap_generate.build_procedure_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
304  	 ;
305  	 CURSOR cur_scr_header( cp_prefix IN VARCHAR2
306  			      , cp_schema IN VARCHAR2
307  			      , cp_type   IN VARCHAR2
308  			      , cp_object IN VARCHAR2
309  			      , cp_scope  IN VARCHAR2
310  			      , cp_count  IN NUMBER
311  			      , cp_show   IN NUMBER
312  			      )
313  	 IS
314  	   SELECT result_text
315  	     FROM TABLE(otap_generate.build_script_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
316  	 ;
317    BEGIN
318  	 IF generation_type = otap_constants.OTAP_GEN_TYPE_FUNCTION
319  	 THEN
320  	   FOR rec IN cur_fn_header(p_title_prefix, p_schema, p_object_type, p_object, p_scope, p_script_count, p_show_header)
321  	   LOOP
322  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
323  	   END LOOP;
324  	 ELSIF generation_type = otap_constants.OTAP_GEN_TYPE_PROCEDURE
325  	 THEN
326  	   FOR rec IN cur_prc_header(p_title_prefix, p_schema, p_object_type, p_object, p_scope, p_script_count, p_show_header)
327  	   LOOP
328  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
329  	   END LOOP;
330  	 ELSE
331  	   -- all other cases script
332  	   FOR rec IN cur_scr_header(p_title_prefix, p_schema, p_object_type, p_object, p_scope, p_script_count, p_show_header)
333  	   LOOP
334  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
335  	   END LOOP;
336  	 END IF;
337  	 RETURN;
338    EXCEPTION
339  	 WHEN NO_DATA_NEEDED THEN
340  	   RAISE;
341    END get_header;
342  
343    FUNCTION build_script_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
344  	 RETURN otap_view_result_tbl PIPELINED
345    IS
346  	 l_statement   VARCHAR2(4000 CHAR);
347    BEGIN
348  	 -- build finish
349  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
350  	 THEN
351  	   l_statement := '-- end OTAP tests';
352  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
353  	   l_statement := '-- finish test session';
354  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
355  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
356  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
357  	   l_statement := '/* alternative option get and return finish code';
358  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
359  	   l_statement := 'COLUMN EXIT_CODE NEW_VAL EXIT_CODE';
360  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
361  	   l_statement := 'SELECT otap_test.finish_test_with_exit_code AS EXIT_CODE FROM dual;';
362  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
363  	   l_statement := 'RETURN &' || 'EXIT_CODE';
364  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
365  	   l_statement := '*/';
366  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
367  	   l_statement := '-- get result';
368  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
369  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
370  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
371  	   -- add AI and copyright
372  	   l_statement := '-- ' || LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
373  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
374  	   l_statement := '-- ' || LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
375  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
376  	   l_statement := '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT1;
377  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
378  	   l_statement := '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT2;
379  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
380  	   l_statement := '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT3;
381  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
382  	 END IF;
383  	 RETURN;
384    EXCEPTION
385  	 WHEN NO_DATA_NEEDED THEN
386  	   RAISE;
387    END build_script_footer;
388  
389    FUNCTION build_function_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
390  	 RETURN otap_view_result_tbl PIPELINED
391    IS
392  	 l_statement   VARCHAR2(4000 CHAR);
393    BEGIN
394  	 -- build finish
395  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
396  	 THEN
397  	   l_statement := otap_generate.get_code_pad || '-- end OTAP tests';
398  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
399  	   l_statement := otap_generate.get_code_pad || '-- finish test session';
400  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
401  	   l_statement := otap_generate.get_code_pad || 'l_return := otap_test.finish_test_with_exit_code;';
402  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
403  	   l_statement := otap_generate.get_code_pad || '-- you may want to insert functionality to persist the report or id to your system';
404  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
405  	   l_statement := otap_generate.get_code_pad || '-- or consume exceptions to guarantee following functions or procedures will run';
406  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
407  	   -- add AI and copyright
408  	   l_statement := otap_generate.get_code_pad || '-- ' || LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
409  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
410  	   l_statement := otap_generate.get_code_pad || '-- ' || LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
411  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
412  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT1;
413  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
414  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT2;
415  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
416  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT3;
417  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
418  	   l_statement := otap_generate.get_code_pad || 'RETURN l_return;';
419  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
420  	   l_statement := 'END;';
421  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
422  	   l_statement := '/';
423  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
424  	 END IF;
425  	 RETURN;
426    EXCEPTION
427  	 WHEN NO_DATA_NEEDED THEN
428  	   RAISE;
429    END build_function_footer;
