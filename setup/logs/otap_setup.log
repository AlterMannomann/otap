171    FUNCTION otap_session_show(p_otap_session IN OTAP_SESSION)
172  	 RETURN VARCHAR2
173    IS
174  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_show';
175  	 l_message VARCHAR2(4000 CHAR);
176    BEGIN
177  	 -- verify the current object
178  	 otap_objects.otap_session_verify(p_otap_session);
179  	 -- build the message
180  	 l_message := 'Current test settings' || otap_constants.OTAP_INTERNAL_LF ||
181  		      'Test session id: ' || p_otap_session.session_id || otap_constants.OTAP_INTERNAL_LF ||
182  		      'Test set: ' || p_otap_session.test_set || otap_constants.OTAP_INTERNAL_LF ||
183  		      'Test group: ' || p_otap_session.test_group || otap_constants.OTAP_INTERNAL_LF ||
184  		      'Test name: ' || p_otap_session.test_name || otap_constants.OTAP_INTERNAL_LF ||
185  		      'Executor: ' || p_otap_session.test_executor || otap_constants.OTAP_INTERNAL_LF ||
186  		      'DB user: ' || p_otap_session.db_user || otap_constants.OTAP_INTERNAL_LF ||
187  		      'DB schema: ' || p_otap_session.db_schema || otap_constants.OTAP_INTERNAL_LF ||
188  		      'Test identifier prefix: ' || p_otap_session.test_prefix || otap_constants.OTAP_INTERNAL_LF ||
189  		      'Session language: ' || p_otap_session.session_language || otap_constants.OTAP_INTERNAL_LF ||
190  		      'Current tests:' || p_otap_session.test_count || otap_constants.OTAP_INTERNAL_LF ||
191  		      'Expected tests: ' || CASE WHEN p_otap_session.intended_count > 0 THEN TO_CHAR(p_otap_session.intended_count) ELSE 'Not set' END || otap_constants.OTAP_INTERNAL_LF ||
192  		      'Name precedence: ' || CASE WHEN p_otap_session.name_precedence THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
193  		      'Include packages: ' || CASE WHEN p_otap_session.include_packages THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
194  		      'Persist: ' || CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
195  		      'Current view id: ' || CASE WHEN p_otap_session.session_view_id = 0 THEN 'Not set' ELSE TO_CHAR(p_otap_session.session_view_id) END || otap_constants.OTAP_INTERNAL_LF ||
196  		      'Test start: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
197  	 ;
198  	 l_message := otap_string.reduce(l_message, 4000);
199  	 RETURN l_message;
200    EXCEPTION
201  	 WHEN OTHERS THEN
202  	   IF SQLCODE != -20099
203  	   THEN
204  	     -- log unhandled exceptions
205  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
206  	   END IF;
207  	   RAISE;
208    END otap_session_show;
