710    PROCEDURE result_cleanup
711    IS
712  	 PRAGMA AUTONOMOUS_TRANSACTION;
713  	 l_script	     VARCHAR2(256 CHAR) := 'otap_util.result_cleanup';
714  	 l_delete_before     DATE;
715  	 l_delete_start      DATE;
716  	 l_delete_batch_size NUMBER;
717  	 l_delete_delay      NUMBER;
718  	 l_row_counter	     NUMBER;
719  	 l_processed	     NUMBER;
720  	 l_delete_msg	     VARCHAR2(32767 CHAR);
721  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
722  	 IS
723  	   SELECT *
724  	     FROM otap_results
725  	    WHERE test_run_date < cp_delete_before
726  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
727  	 ;
728    BEGIN
729  	 -- read config values before starting, values will not change until finished
730  	 l_delete_start      := SYSDATE;
731  	 l_delete_before     := TRUNC(SYSDATE - otap_util.get_config_number(otap_util.CFG_PRESERVE_DAYS));
732  	 l_delete_batch_size := otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE);
733  	 l_delete_delay      := otap_util.get_config_number(otap_util.CFG_DELETE_DELAY);
734  	 l_row_counter	     := 0;
735  	 l_processed	     := 0;
736  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
737  	 otap_log.log(l_delete_msg, l_script, 'Procedure start', 'OTAP_DEBUG');
738  	 FOR rec IN cur_delete_tests(l_delete_before)
739  	 LOOP
740  	   IF l_row_counter >= l_delete_batch_size
741  	   THEN
742  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
743  	     otap_log.log(l_delete_msg, l_script, 'Batch size reached and wait', 'OTAP_DEBUG');
744  	     -- commit the batch
745  	     COMMIT;
746  	     -- reset counter
747  	     l_row_counter := 0;
748  	     -- wait defined time
749  	     DBMS_SESSION.SLEEP(l_delete_delay);
750  	   END IF;
751  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
752  	   l_row_counter := l_row_counter + 1;
753  	   l_processed	 := l_processed + 1;
754  	 END LOOP;
755  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
756  	 otap_log.log(l_delete_msg, l_script, 'Procedure end', 'OTAP_DEBUG');
757  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
758    EXCEPTION
759  	 WHEN OTHERS THEN
760  	   otap_log.log(SQLERRM, l_script, 'DELETE FROM otap_results');
761    END result_cleanup;
762  
763    FUNCTION max_text_size(p_session_id IN NUMBER)
764  	 RETURN NUMBER
765    IS
766  	 l_result NUMBER;
767    BEGIN
768  	 -- use UNION not GREATEST to get a result in any case
769  	 SELECT MAX(str_length) AS max_length
770  	   INTO l_result
771  	   FROM (SELECT otap_constants.get_otap_num_min_fill_length AS str_length FROM dual
772  		  UNION ALL
773  		 SELECT MAX(LENGTH(test_set)) FROM otap_results WHERE test_session_id = p_session_id
774  		  UNION ALL
775  		 SELECT MAX(LENGTH(test_group)) FROM otap_results WHERE test_session_id = p_session_id
776  		  UNION ALL
777  		 SELECT MAX(LENGTH(test_name)) FROM otap_results WHERE test_session_id = p_session_id
778  		  UNION ALL
779  		 SELECT MAX(LENGTH(test_desc)) FROM otap_results WHERE test_session_id = p_session_id
780  		)
781  	 ;
782  	 RETURN l_result;
783    EXCEPTION
784  	 WHEN OTHERS THEN
785  	   otap_log.log(SQLERRM, 'otap_util.max_text_size', 'Get max text size for a given session id');
786  	   RAISE;
787    END max_text_size;
788  
789  END;
