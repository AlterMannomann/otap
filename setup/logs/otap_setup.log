 54    FUNCTION init_test( p_test_count 	 IN	       NUMBER
 55  			 , p_test_set		 IN	       VARCHAR2
 56  			 , p_test_group 	 IN	       VARCHAR2
 57  			 , p_test_name		 IN	       VARCHAR2
 58  			 , p_prefix		 IN	       VARCHAR2
 59  			 , p_language_id	 IN	       VARCHAR2
 60  			 , p_name_precedence	 IN	       NUMBER
 61  			 , p_include_pkg	 IN	       NUMBER
 62  			 , p_persist		 IN	       NUMBER
 63  			 , p_schema		 IN	       VARCHAR2
 64  			 , p_user		 IN	       VARCHAR2
 65  			 , p_executor		 IN	       VARCHAR2
 66  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
 67  			 )
 68  	 RETURN VARCHAR2
 69    IS
 70  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.init_test';
 71  	 l_message VARCHAR2(4000 CHAR);
 72    BEGIN
 73  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
 74  	 -- execute the wrapped function in an extra block
 75  	 BEGIN
 76  	   l_message := otap_plan.init_test(p_test_count, p_test_set, p_test_group, p_test_name, p_prefix, p_language_id, p_name_precedence, p_include_pkg, p_persist, p_schema, p_user, p_executor, o_otap_session);
 77  	 EXCEPTION
 78  	   WHEN OTHERS THEN
 79  	     -- consume error
 80  	     otap_log.log(SQLERRM, l_script, 'Calling otap_plan.init_test');
 81  	     l_message := otap_string.reduce('Internal otap error init session variable: ' || SQLERRM, 4000);
 82  	 END;
 83  	 -- return or let exception happen
 84  	 RETURN l_message;
 85    END init_test;
