SQL> -- trigger
SQL> CREATE OR REPLACE TRIGGER otap_config_ins_trg
  2    BEFORE INSERT ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  , 'FORMAT_HEADER_CHAR'
 13  				  , 'FORMAT_SET_CHAR'
 14  				  , 'FORMAT_GROUP_CHAR'
 15  				  , 'FORMAT_NAME_CHAR'
 16  				  , 'TEXT_TRUE'
 17  				  , 'TEXT_FALSE'
 18  				  , 'TEXT_TRUE_YES'
 19  				  , 'TEXT_FALSE_NO'
 20  				  , 'TEXT_TEST_PASSED'
 21  				  , 'TEXT_TEST_FAILED'
 22  				  , 'TEXT_TEST_UNDEFINED'
 23  				  , 'DEFAULT_PREFIX'
 24  				  , 'DEFAULT_TEST_SET'
 25  				  , 'DEFAULT_TEST_GROUP'
 26  				  , 'DEFAULT_TEST_NAME'
 27  				  , 'DEFAULT_LAYOUT'
 28  				  , 'DEFAULT_RESULT_LAYOUT'
 29  				  , 'DEFAULT_BORDER'
 30  				  , 'TEXT_REPORT_START'
 31  				  , 'TEXT_REPORT_END'
 32  				  , 'TEXT_RESULT_HEADER'
 33  				  , 'FORMAT_RESULT_HEADER'
 34  				  , 'TEXT_SUMMARY_SUCCESS'
 35  				  , 'TEXT_SUMMARY_ERROR'
 36  				  , 'SUMMARY_TEMPLATE'
 37  				  , 'ERRORS_TEMPLATE'
 38  				  , 'ERROR_DETAILS_TEMPLATE'
 39  				  , 'NO_DATA_TEMPLATE'
 40  				  , 'SESSION_ID_TEMPLATE'
 41  				  , 'SET_TEMPLATE'
 42  				  , 'GROUP_TEMPLATE'
 43  				  , 'TEST_NAME_TEMPLATE'
 44  				  , 'RESULT_LINE_TEMPLATE'
 45  				  , 'FN_HAS_TABLE_TEMPLATE'
 46  				  )
 47    THEN
 48  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 49    END IF;
 50    -- remove any leading and trailing blanks from config_value
 51    :NEW.config_value   := TRIM(:NEW.config_value);
 52    -- check empty strings contained only spaces
 53    IF :NEW.config_value IS NULL OR LENGTH(:NEW.config_value) = 0
 54    THEN
 55  	 RAISE_APPLICATION_ERROR(-20002, 'The given config_value is not supported. Empty or only spaces.');
 56    END IF;
 57    :NEW.created	   := SYSDATE;
 58    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 59    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 60    -- check max length if defined
 61    IF :NEW.config_type = 'CHAR'
 62    THEN
 63  	 IF :NEW.config_max_length > 0
 64  	 THEN
 65  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 66  	   THEN
 67  	     RAISE_APPLICATION_ERROR(-20003, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 68  	   END IF;
 69  	 END IF;
 70    END IF;
 71    -- check number type
 72    IF :NEW.config_type = 'NUMBER'
 73    THEN
 74  	 l_ok := TRUE;
 75  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 76  	 BEGIN
 77  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 78  	 EXCEPTION
 79  	   WHEN OTHERS THEN
 80  	     l_ok := FALSE;
 81  	 END;
 82  	 IF NOT l_ok
 83  	 THEN
 84  	   RAISE_APPLICATION_ERROR(-20004, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 85  	 END IF;
 86    END IF;
 87    -- handle NULLs
 88    IF :NEW.config_name = 'PRESERVE_DAYS'
 89    THEN
 90  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_PRESERVE_DAYS));
 91    END IF;
 92    IF :NEW.config_name = 'DELETE_DELAY'
 93    THEN
 94  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DELETE_DELAY));
 95    END IF;
 96    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
 97    THEN
 98  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DELETE_BATCH_SIZE));
 99    END IF;
100    IF :NEW.config_name = 'DEBUG_MODE'
101    THEN
102  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DEBUG_MODE));
103    END IF;
104    -- check layout options
105    IF     :NEW.config_name = 'DEFAULT_LAYOUT'
106  	  AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
107    THEN
108  	 :NEW.config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
109    END IF;
110    IF     :NEW.config_name = 'DEFAULT_RESULT_LAYOUT'
111  	  AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
112    THEN
113  	 :NEW.config_value := otap_constants.OTAP_LAYOUT_LEFT;
114    END IF;
115    -- check border options
116    IF     :NEW.config_name = 'DEFAULT_BORDER'
117  	  AND (   TO_NUMBER(:NEW.config_value) < 2
118  	       OR TO_NUMBER(:NEW.config_value) > 10
119  	      )
120    THEN
121  	 :NEW.config_value := otap_constants.OTAP_BORDER_DEFAULT;
122    END IF;
123  END;
124  /

