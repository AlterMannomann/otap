106    FUNCTION result_view(p_session_id IN NUMBER)
107  	 RETURN otap_view_result_tbl PIPELINED
108    IS
109  	 l_delim_updown VARCHAR2(1 CHAR) := '=';
110  	 l_delim_tests	VARCHAR2(1 CHAR) := '-';
111  	 l_text_column	VARCHAR2(4000 CHAR);
112  	 l_has_errors	INTEGER;
113  	 l_has_records	INTEGER;
114  	 l_report_size	INTEGER;
115  	 CURSOR cur_test_sets(cp_session_id IN NUMBER)
116  	 IS
117  	   SELECT test_set
118  		, COUNT(*) AS test_runs
119  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
120  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
121  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
122  	     FROM otap_results
123  	    WHERE test_session_id = cp_session_id
124  	      AND test_name	 != otap_api.get_text_test_count_name
125  	    GROUP BY test_set
126  	    ORDER BY MIN(test_run_date)
127  	 ;
128  	 CURSOR cur_test_groups( cp_session_id IN NUMBER
129  			       , cp_test_set   IN VARCHAR2
130  			       )
131  	 IS
132  	   SELECT test_group
133  		, COUNT(*) AS test_runs
134  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
135  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
136  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
137  	     FROM otap_results
138  	    WHERE test_session_id = cp_session_id
139  	      AND test_set	  = cp_test_set
140  	      AND test_name	 != otap_api.get_text_test_count_name
141  	    GROUP BY test_group
142  	    ORDER BY MIN(test_run_date)
143  	 ;
144  	 CURSOR cur_test_names( cp_session_id IN NUMBER
145  			      , cp_test_set   IN VARCHAR2
146  			      , cp_test_group IN VARCHAR2
147  			      )
148  	 IS
149  	   SELECT test_name
150  		, COUNT(*) AS test_runs
151  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
152  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
153  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
154  	     FROM otap_results
155  	    WHERE test_session_id = cp_session_id
156  	      AND test_set	  = cp_test_set
157  	      AND test_group	  = cp_test_group
158  	      AND test_name	 != otap_api.get_text_test_count_name
159  	    GROUP BY test_name
160  	    ORDER BY MIN(test_run_date)
161  	 ;
162  	 CURSOR cur_test_count(cp_session_id IN NUMBER)
163  	 IS
164  	   SELECT test_name
165  		, COUNT(*) AS test_runs
166  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
167  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
168  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
169  	     FROM otap_results
170  	    WHERE test_session_id = cp_session_id
171  	      AND test_name	  = otap_api.get_text_test_count_name
172  	    GROUP BY test_name
173  	    ORDER BY MIN(test_run_date)
174  	 ;
175  	 CURSOR cur_session_total(cp_session_id IN NUMBER)
176  	 IS
177  	   SELECT test_session_id
178  		, COUNT(DISTINCT test_set) AS test_sets
179  		, COUNT(DISTINCT test_group) AS test_groups
180  		, COUNT(DISTINCT test_name) AS test_names
181  		, COUNT(DISTINCT test_desc) AS test_descs
182  		, COUNT(*) AS test_runs
183  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
184  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
185  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
186  	     FROM otap_results
187  	    WHERE test_session_id = cp_session_id
188  		  -- exclude optional extra total count test
189  	      AND test_name	 != otap_api.get_text_test_count_name
190  	    GROUP BY test_session_id
191  	    ORDER BY MIN(test_run_date)
192  	 ;
193  	 CURSOR cur_tests( cp_session_id IN NUMBER
194  			 , cp_test_set	 IN VARCHAR2
195  			 , cp_test_group IN VARCHAR2
196  			 , cp_test_name  IN VARCHAR2
197  			 )
198  	 IS
199  	   SELECT test_desc
200  		, test_passed
201  		, otap_api.test_result_to_text(test_passed) AS test_state
202  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
203  		, test_errors
204  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
205  	     FROM otap_results
206  	    WHERE test_session_id = cp_session_id
207  	      AND test_set	  = cp_test_set
208  	      AND test_group	  = cp_test_group
209  	      AND test_name	  = cp_test_name
210  	    ORDER BY test_run_date
211  	 ;
212  	 CURSOR cur_count_tests( cp_session_id IN NUMBER
213  			       , cp_test_name  IN VARCHAR2
214  			       )
215  	 IS
216  	   SELECT test_desc
217  		, test_passed
218  		, otap_api.test_result_to_text(test_passed) AS test_state
219  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
220  		, test_errors
221  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
222  	     FROM otap_results
223  	    WHERE test_session_id = cp_session_id
224  	      AND test_name	  = cp_test_name
225  	    ORDER BY test_run_date
226  	 ;
227    BEGIN
228  	 l_report_size := otap_api.max_text_size(p_session_id);
229  	 -- header row
230  	 l_text_column := otap_api.get_report_header(l_report_size);
231  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
232  	 l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
233  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
234  	 -- check for records
235  	 SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
236  	 IF l_has_records > 0
237  	 THEN
238  	   -- loop through the set
239  	   FOR rec_set IN cur_test_sets(p_session_id)
240  	   LOOP
241  	     -- build test set column
242  	     l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size);
243  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
244  	     -- build test set summary
245  	     l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size);
246  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
247  	     -- loop through the group
248  	     FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set)
249  	     LOOP
250  	       l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size);
251  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
252  	       -- build test set summary
253  	       l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size);
254  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
255  	       -- loop through the names
256  	       FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group)
257  	       LOOP
258  		 l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size);
259  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
260  		 -- build test set summary
261  		 l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size);
262  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
263  		 -- build header
264  		 l_text_column := otap_api.get_result_header(l_report_size);
265  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
266  		 l_text_column := otap_api.get_result_underline(l_report_size);
267  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
268  		 -- loop through the tests
269  		 FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
270  		 LOOP
271  		   l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
272  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
273  		 END LOOP;
274  		 SELECT COUNT(*)
275  		   INTO l_has_errors
276  		   FROM otap_results
277  		  WHERE test_session_id = p_session_id
278  		    AND test_set	= rec_set.test_set
279  		    AND test_group	= rec_grp.test_group
280  		    AND test_name	= rec_nam.test_name
281  		    AND test_errors    IS NOT NULL
282  		 ;
283  		 IF l_has_errors > 0
284  		 THEN
285  		   -- build error delimiter for tests
286  		   l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size);
287  		   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
288  		   FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
289  		   LOOP
290  		     IF rec_tst.test_errors IS NOT NULL
291  		     THEN
292  		       l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
293  		       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
294  		     END IF;
295  		   END LOOP;
296  		 END IF;
297  	       END LOOP;
298  	     END LOOP;
299  	   END LOOP;
300  	   -- no loop through the test count if exists
301  	   FOR rec IN cur_test_count(p_session_id)
302  	   LOOP
303  	     -- build header
304  	     l_text_column := otap_api.get_test_count_header(l_report_size);
305  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
306  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
307  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
308  	     -- build header
309  	     l_text_column := otap_api.get_result_header(l_report_size);
310  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
311  	     l_text_column := otap_api.get_result_underline(l_report_size);
312  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
313  	     -- loop through the tests
314  	     FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
315  	     LOOP
316  	       l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
317  	       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
318  	     END LOOP;
319  	     SELECT COUNT(*)
320  	       INTO l_has_errors
321  	       FROM otap_results
322  	      WHERE test_session_id = p_session_id
323  		AND test_name	    = rec.test_name
324  		AND test_errors    IS NOT NULL
325  	     ;
326  	     IF l_has_errors > 0
327  	     THEN
328  	       -- build error delimiter for tests
329  	       l_text_column := otap_api.get_error_result_header(rec.test_name, l_report_size);
330  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
331  	       FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
332  	       LOOP
333  		 IF rec_tst.test_errors IS NOT NULL
334  		 THEN
335  		   l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
336  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
337  		 END IF;
338  	       END LOOP;
339  	     END IF;
340  	   END LOOP;
341  	   -- eventually build the totals for the test session
342  	   l_text_column := otap_api.get_report_total(l_report_size);
343  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
344  	   FOR rec IN cur_session_total(p_session_id)
345  	   LOOP
346  	     l_text_column := otap_api.get_report_total_details(rec.test_sets, rec.test_groups, rec.test_names, rec.test_descs, l_report_size);
347  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
348  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
349  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
350  	   END LOOP;
351  	 ELSE
352  	   l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size);
353  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
354  	 END IF;
355  	 -- footer row
356  	 l_text_column := otap_api.get_report_footer(l_report_size);
357  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
358  	 -- add AI and copyright
359  	 l_text_column := LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
360  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
361  	 l_text_column := LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
362  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
363  	 l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT1;
364  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
365  	 l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT2;
366  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
367  	 l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT3;
368  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
369  	 RETURN;
370    EXCEPTION
371  	 WHEN NO_DATA_NEEDED THEN
372  	   RAISE;
373  	 WHEN OTHERS THEN
374  	   IF SQLCODE != -20099
375  	   THEN
376  	     otap_log.log(SQLERRM, 'otap_test.result_view', 'Unhandled exception otap_test.result_view');
377  	   END IF;
378  	   RAISE;
379    END result_view;
