408    /** FUNCTION otap_test.is_eq
409    * Checks given data of type VARCHAR2, NUMBER and DATE against a given value. As "IS" is a reserved word in Oracle
410    * this is the equivalent of is and isnt. isnt is achieved by setting expected result to otap_constants.OTAP_NUM_TEST_FAILED.
411    *
412    * Other types are more or less problematic, e.g. you can't declare in Oracle a function with date and timestamp parameter. If providing
413    * TIMESTAMP Oracle gets confused which function to use. Try to convert or cast the types to the base types. CAST will probably not
414    * preserve all information. TO_CHAR is almost always an option.
415    *
416    * Passing simply NULL, NULL without that datatypes are defined by columns, the function will fail with ORA-06553: Too much declarations
417    * of is_eq. To do a NULL test, use, according to p_have datatype, TO_CHAR(NULL), TO_NUMBER(NULL) or TO_DATE(NULL) so correct function
418    * signature is identified and function does not fail.
419    *
420    * @param p_have The data to check.
421    * @param p_want The expected data. Must have the same datatype as p_have.
422    * @param p_description The test description if any. If not given, a description is generated, see template.
423    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
424    *
425    * @return The test result as text.
426    */
427    FUNCTION is_eq( p_have		 IN	VARCHAR2
428  		     , p_want		 IN	VARCHAR2
429  		     , p_description	 IN	VARCHAR2 DEFAULT NULL
430  		     , p_expected_result IN	NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
431  		     )
432  	 RETURN VARCHAR2
433    ;
434    FUNCTION is_eq( p_have		 IN	NUMBER
435  		     , p_want		 IN	NUMBER
436  		     , p_description	 IN	VARCHAR2 DEFAULT NULL
437  		     , p_expected_result IN	NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
438  		     )
439  	 RETURN VARCHAR2
440    ;
441    FUNCTION is_eq( p_have		 IN	DATE
442  		     , p_want		 IN	DATE
443  		     , p_description	 IN	VARCHAR2 DEFAULT NULL
444  		     , p_expected_result IN	NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
445  		     )
