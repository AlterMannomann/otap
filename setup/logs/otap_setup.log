118  	       l_delimiter := ',';
119  	     END IF;
120  	     IF p_otap_session.name_precedence IS NULL
121  	     THEN
122  	       l_message := l_message || l_delimiter || 'name_precedence';
123  	       l_delimiter := ',';
124  	     END IF;
125  	     IF p_otap_session.include_packages IS NULL
126  	     THEN
127  	       l_message := l_message || l_delimiter || 'include_packages';
128  	       l_delimiter := ',';
129  	     END IF;
