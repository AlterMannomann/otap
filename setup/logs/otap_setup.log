1110  				  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1111  				  )
1112  	  RETURN INTEGER
1113  	IS
1114  	  l_script	    VARCHAR2(1024 CHAR)    := 'otap_schema.has_scheduler_job';
1115  	  l_test_passed     INTEGER;
