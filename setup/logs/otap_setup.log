SQL> -- description
SQL> COMMENT ON TABLE otap_results IS 'Persist the results of otap test runs. Flat table. Restricted update by trigger. Will use the alias ores.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.to_delete IS 'Indicator for deletion of this record. Only 0 (no) and 1 (yes) allowed. Placed as first column to speed up test result cleanup.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_run_id IS 'The generated id for each record, part of the primary key. The primary key is only implemented for correct DELETE access.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_run_date IS 'The date of executing the test, part of the primary key. Set by trigger. The primary key is only implemented for correct DELETE access. Defines the persist duration, if TO_DELETE is set to 1.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_passed IS 'Indicator for test passed. 0 test not started or incomplete, 1 test passed, -1 test failed. No other values allowed.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_session_id IS 'The internal id for a test session. Keeping tests of a test session together. Managed by OTAP_TEST package and sequence OTAP_TEST_SESSION_SEQ. Once set to a value other then 0, not changed on updates.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.deleted IS 'The last date TO_DELETE was set to 1. Set by trigger.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.deleted_by IS 'The session user that set TO_DELETE to 1. Set by trigger.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_executor IS 'The session user that created the entry. Set by trigger.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_set IS 'The name of the test set the entry belongs to. Default OTAP test set. Use test sets to separate application tests.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_group IS 'The name of the test group the entry belongs to. Default OTAP test group. Use test groups to separate functionality tests.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_start IS 'The timestamp of the test start. To be set by test functions';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_end IS 'The timestamp of the test end. To be set by test functions';

Comment created.

SQL> COMMENT ON COLUMN otap_results.db_user IS 'The database user owning the test object. Set to current user by default. Can be overwritten.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.db_schema IS 'The database schema of the test object. Set to current schema by default. Can be overwritten.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_name IS 'The name of a test. Use short names describing the test. Limited to 256 chars.';

Comment created.

SQL> COMMENT ON COLUMN otap_results.test_desc IS 'A short and precise test description. Should be unique under the name, group and set running. Uniqueness not verified. Limited to 256 chars.';

