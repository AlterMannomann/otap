SQL> -- trigger
SQL> CREATE OR REPLACE TRIGGER otap_config_ins_trg
  2    BEFORE INSERT ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  , 'FORMAT_HEADER_CHAR'
 13  				  , 'FORMAT_SET_CHAR'
 14  				  , 'FORMAT_GROUP_CHAR'
 15  				  , 'FORMAT_NAME_CHAR'
 16  				  , 'TEXT_TRUE'
 17  				  , 'TEXT_FALSE'
 18  				  , 'TEXT_TRUE_YES'
 19  				  , 'TEXT_FALSE_NO'
 20  				  , 'TEXT_TEST_PASSED'
 21  				  , 'TEXT_TEST_FAILED'
 22  				  , 'TEXT_TEST_UNDEFINED'
 23  				  , 'DEFAULT_PREFIX'
 24  				  , 'DEFAULT_TEST_SET'
 25  				  , 'DEFAULT_TEST_GROUP'
 26  				  , 'DEFAULT_TEST_NAME'
 27  				  , 'DEFAULT_LAYOUT'
 28  				  , 'DEFAULT_RESULT_LAYOUT'
 29  				  , 'DEFAULT_BORDER'
 30  				  , 'TEXT_REPORT_START'
 31  				  , 'TEXT_REPORT_END'
 32  				  , 'TEXT_RESULT_HEADER'
 33  				  , 'FORMAT_RESULT_HEADER'
 34  				  , 'TEXT_SUMMARY_SUCCESS'
 35  				  , 'TEXT_SUMMARY_ERROR'
 36  				  , 'SUMMARY_TEMPLATE'
 37  				  , 'ERRORS_TEMPLATE'
 38  				  , 'ERROR_DETAILS_TEMPLATE'
 39  				  , 'NO_DATA_TEMPLATE'
 40  				  , 'SESSION_ID_TEMPLATE'
 41  				  , 'SET_TEMPLATE'
 42  				  , 'GROUP_TEMPLATE'
 43  				  , 'TEST_NAME_TEMPLATE'
 44  				  , 'RESULT_LINE_TEMPLATE'
 45  				  )
 46    THEN
 47  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 48    END IF;
 49    -- remove any leading and trailing blanks from config_value
 50    :NEW.config_value   := TRIM(:NEW.config_value);
 51    -- check empty strings contained only spaces
 52    IF :NEW.config_value IS NULL OR LENGTH(:NEW.config_value) = 0
 53    THEN
 54  	 RAISE_APPLICATION_ERROR(-20002, 'The given config_value is not supported. Empty or only spaces.');
 55    END IF;
 56    :NEW.created	   := SYSDATE;
 57    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 58    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 59    -- check max length if defined
 60    IF :NEW.config_type = 'CHAR'
 61    THEN
 62  	 IF :NEW.config_max_length > 0
 63  	 THEN
 64  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 65  	   THEN
 66  	     RAISE_APPLICATION_ERROR(-20003, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 67  	   END IF;
 68  	 END IF;
 69    END IF;
 70    -- check number type
 71    IF :NEW.config_type = 'NUMBER'
 72    THEN
 73  	 l_ok := TRUE;
 74  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 75  	 BEGIN
 76  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 77  	 EXCEPTION
 78  	   WHEN OTHERS THEN
 79  	     l_ok := FALSE;
 80  	 END;
 81  	 IF NOT l_ok
 82  	 THEN
 83  	   RAISE_APPLICATION_ERROR(-20004, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 84  	 END IF;
 85    END IF;
 86    -- handle NULLs
 87    IF :NEW.config_name = 'PRESERVE_DAYS'
 88    THEN
 89  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_PRESERVE_DAYS));
 90    END IF;
 91    IF :NEW.config_name = 'DELETE_DELAY'
 92    THEN
 93  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DELETE_DELAY));
 94    END IF;
 95    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
 96    THEN
 97  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DELETE_BATCH_SIZE));
 98    END IF;
 99    IF :NEW.config_name = 'DEBUG_MODE'
100    THEN
101  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DEBUG_MODE));
102    END IF;
103    -- check layout options
104    IF     :NEW.config_name = 'DEFAULT_LAYOUT'
105  	  AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
106    THEN
107  	 :NEW.config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
108    END IF;
109    IF     :NEW.config_name = 'DEFAULT_RESULT_LAYOUT'
110  	  AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
111    THEN
112  	 :NEW.config_value := otap_constants.OTAP_LAYOUT_LEFT;
113    END IF;
114    -- check border options
115    IF     :NEW.config_name = 'DEFAULT_BORDER'
116  	  AND (   TO_NUMBER(:NEW.config_value) < 2
117  	       OR TO_NUMBER(:NEW.config_value) > 10
118  	      )
119    THEN
120  	 :NEW.config_value := otap_constants.OTAP_BORDER_DEFAULT;
121    END IF;
122  END;
123  /

