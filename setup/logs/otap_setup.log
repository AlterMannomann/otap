342    FUNCTION get_config_number(p_config_name IN VARCHAR2)
343  	 RETURN NUMBER
344    IS
345  	 l_script      VARCHAR2(1024 CHAR)	       := 'otap_util.get_config_number';
346  	 l_varchar     otap_config.config_value%TYPE;
347  	 l_return      INTEGER; -- only integer in configuration
348  	 l_has_config  INTEGER;
349    BEGIN
350  	 l_return := NULL;
351  	 SELECT COUNT(*)
352  	   INTO l_has_config
353  	   FROM otap_config
354  	  WHERE config_name = UPPER(p_config_name)
355  	    AND config_type = 'NUMBER'
356  	 ;
357  	 IF l_has_config = 1
358  	 THEN
359  	   l_varchar := otap_util.get_config_value(p_config_name);
360  	   IF otap_util.is_integer(l_varchar)
361  	   THEN
362  	     l_return := TO_NUMBER(l_varchar);
363  	   ELSE
364  	     l_return := NULL;
365  	     otap_log.log('Invalid numeric value for config_name: ' || UPPER(p_config_name) || ' return NULL. Value: ' || l_varchar, l_script, 'otap_util.is_integer(l_varchar)');
366  	   END IF;
367  	 ELSE
368  	   l_return := NULL;
369  	   otap_log.log('Invalid numeric config_name: ' || UPPER(p_config_name) || ' return NULL. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name) AND config_type = ''NUMBER''');
370  	 END IF;
371  	 RETURN l_return;
372    EXCEPTION
373  	 WHEN OTHERS THEN
374  	   otap_log.log(SQLERRM, l_script);
375  	   RAISE;
376    END get_config_number;
