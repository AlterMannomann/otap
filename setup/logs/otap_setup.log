313  	     l_return := -1;
314  	 END;
315  	 -- return or let exception happen
316  	 RETURN l_return;
317    END otap_session_get_report_id;
318  
319    FUNCTION set_active_report_id( p_report_id    IN 	   NUMBER
320  				    , o_otap_session IN OUT NOCOPY OTAP_SESSION
321  				    )
322  	 RETURN VARCHAR2
323    IS
324  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.set_active_report_id';
325  	 l_message VARCHAR2(4000);
326  	 l_return  NUMBER;
327  	 l_old_id  NUMBER;
328  	 l_count   NUMBER;
329    BEGIN
330  	 l_return  := 0;
331  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
332  	 -- execute the wrapped function in an extra block
333  	 BEGIN
334  	   -- save the old id for compare
335  	   l_old_id := otap_objects.otap_session_get_report_id(o_otap_session);
336  	   IF l_old_id = p_report_id
337  	   THEN
338  	     -- nothing to do
339  	     l_message := 'The report id ' || p_report_id || ' is currently active. No change.';
340  	   ELSE
341  	     -- check given id
342  	     SELECT COUNT(*) INTO l_count FROM otap_results WHERE test_session_id = p_report_id;
343  	     IF l_count > 0
344  	     THEN
345  	       l_return := otap_objects.otap_session_set_session_view_id(p_report_id, o_otap_session);
346  	     ELSE
347  	       otap_log.log('Invalid report id ' || p_report_id || ' does not exist in OTAP_RESULTS', l_script);
348  	       l_return  := l_old_id;
349  	       l_message := 'Report id ' || p_report_id || ' not found';
350  	     END IF;
351  	     IF l_return != l_old_id
352  	     THEN
353  	       l_message := 'New report id ' || l_return;
354  	     ELSE
355  	       l_message := 'ERROR report id ' || l_return || ' not changed. ' || l_message;
356  	     END IF;
357  	   END IF;
358  	 EXCEPTION
359  	   WHEN OTHERS THEN
360  	     -- consume error
361  	     otap_log.log(SQLERRM, l_script, 'Checking and calling otap_objects.otap_session_set_session_view_id');
362  	     l_message := otap_string.reduce('ERROR ' || l_script || ': ' || SQLERRM, 4000);
363  	 END;
364  	 -- return or let exception happen
365  	 RETURN l_message;
366    END set_active_report_id;
