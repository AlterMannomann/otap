322  				       , p_otap_session.intended_count
323  				       , p_otap_session.persist_test
324  				       , p_otap_session.name_precedence
325  				       , p_otap_session.include_packages
326  				       , p_otap_session.session_start
327  				       , p_otap_session.session_id
328  				       , p_otap_session.error_count
329  				       , p_otap_session.session_view_id
330  				       )
331  	 ;
332  	 RETURN l_otap_session;
333    EXCEPTION
334  	 WHEN OTHERS THEN
335  	   IF SQLCODE != -20099
