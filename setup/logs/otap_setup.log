 43    PROCEDURE validate_config_name( p_config_name IN VARCHAR2
 44  				     , p_del_trigger IN BOOLEAN  DEFAULT FALSE
 45  				     )
 46    IS
 47  	 l_script VARCHAR2(1024 CHAR) := 'otap_util.validate_config_name';
 48    BEGIN
 49  
 50  	 IF NOT p_del_trigger
 51  	 THEN
 52  	   -- check name against a fixed list
 53  	   IF p_config_name NOT IN ( otap_constants.OTAP_CFG_DEBUG_MODE
 54  				   , otap_util.CFG_DEFAULT_BORDER
 55  				   , otap_util.CFG_DEFAULT_LABEL_COLUMN
 56  				   , otap_util.CFG_DEFAULT_LAYOUT
 57  				   , otap_util.CFG_DEFAULT_PREFIX
 58  				   , otap_util.CFG_DEFAULT_RESULT_LAYOUT
 59  				   , otap_util.CFG_DEFAULT_TEST_GROUP
 60  				   , otap_util.CFG_DEFAULT_TEST_NAME
 61  				   , otap_util.CFG_DEFAULT_TEST_SET
 62  				   , otap_util.CFG_DEFAULT_LANGUAGE
 63  				   , otap_util.CFG_DELETE_BATCH_SIZE
 64  				   , otap_util.CFG_DELETE_DELAY
 65  				   , otap_util.CFG_FORMAT_GROUP_CHAR
 66  				   , otap_util.CFG_FORMAT_HEADER_CHAR
 67  				   , otap_util.CFG_FORMAT_NAME_CHAR
 68  				   , otap_util.CFG_FORMAT_SET_CHAR
 69  				   , otap_util.CFG_PRESERVE_DAYS
 70  				   , otap_util.CFG_TEMPLATE_COUNT_DESC
 71  				   , otap_util.CFG_TEMPLATE_ERRORS
 72  				   , otap_util.CFG_TEMPLATE_ERROR_DETAILS
 73  				   , otap_util.CFG_TEMPLATE_EXISTS
 74  				   , otap_util.CFG_TEMPLATE_EXISTSX
 75  				   , otap_util.CFG_TEMPLATE_EXISTS_C
 76  				   , otap_util.CFG_TEMPLATE_EXISTS_CX
 77  				   , otap_util.CFG_TEMPLATE_EXISTS_F
 78  				   , otap_util.CFG_TEMPLATE_EXISTS_FX
 79  				   , otap_util.CFG_TEMPLATE_GROUP
 80  				   , otap_util.CFG_TEMPLATE_MATCH
 81  				   , otap_util.CFG_TEMPLATE_NO_DATA
 82  				   , otap_util.CFG_TEMPLATE_REPORT_TOTAL
 83  				   , otap_util.CFG_TEMPLATE_RESULT_LINE
 84  				   , otap_util.CFG_TEMPLATE_SESSION_ID
 85  				   , otap_util.CFG_TEMPLATE_SET
 86  				   , otap_util.CFG_TEMPLATE_SUMMARY
 87  				   , otap_util.CFG_TEMPLATE_TEST_NAME
 88  				   , otap_util.CFG_TEXT_FALSE
 89  				   , otap_util.CFG_TEXT_FALSE_NO
 90  				   , otap_util.CFG_TEXT_REPORT_END
 91  				   , otap_util.CFG_TEXT_REPORT_START
 92  				   , otap_util.CFG_TEXT_REPORT_TOTAL
 93  				   , otap_util.CFG_TEXT_RESULT_HEADER
 94  				   , otap_util.CFG_TEXT_RESULT_LINE
 95  				   , otap_util.CFG_TEXT_SUMMARY_HEADER
 96  				   , otap_util.CFG_TEXT_TEST_SETUP_SET
 97  				   , otap_util.CFG_TEXT_TEST_SETUP_GROUP
 98  				   , otap_util.CFG_TEXT_TEST_SETUP_NAME
 99  				   , otap_util.CFG_TEXT_TEST_FAILED
100  				   , otap_util.CFG_TEXT_TEST_PASSED
101  				   , otap_util.CFG_TEXT_TEST_UNDEFINED
102  				   , otap_util.CFG_TEXT_TRUE
103  				   , otap_util.CFG_TEXT_TRUE_YES
104  				   )
105  	   THEN
106  	     -- log the error
107  	     otap_log.log('-20001 The configuration name: ' || NVL(p_config_name, 'NULL') || ' is not supported', l_script);
108  	     -- only direct testing could call this currently as table has a NOT NULL constraint
109  	     RAISE_APPLICATION_ERROR(-20001, 'The configuration name: ' || NVL(p_config_name, 'NULL') || ' is not supported.');
110  	   END IF;
111  	 ELSE
112  	   -- check name against a fixed list
113  	   IF p_config_name IN ( otap_constants.OTAP_CFG_DEBUG_MODE
114  			       , otap_util.CFG_DEFAULT_BORDER
115  			       , otap_util.CFG_DEFAULT_LABEL_COLUMN
