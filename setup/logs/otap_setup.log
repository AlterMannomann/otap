SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> -- requires login with the correct otap schema
SQL> -- table is NOT qualified and created in the schema active at execution
SQL> -- a private temporary table is no option as it does not support CLOB
SQL> -- DO NOT ADJUST the defaults unless you adjust them as well in OTAP_CONSTANTS. Tables unluckily
SQL> -- do not support defaults from package variables or functions unless they are public. otap does
SQL> -- not manage what can be seen by whom. You may create public synonyms for otap, but this is your
SQL> -- responsibility and depends on your database policies.
SQL> -- As this is mainly some special sort of temporary table the delete marker is the first bit or byte
SQL> -- depending on database implementation, to make delete runs as fast as possible. An integer below 128
SQL> -- should not require more than a byte. If only 0 and 1 is possible a bit should be more than enough.
SQL> -- Using CHAR for different language support.
SQL> CREATE TABLE otap_results
  2    ( to_delete	 NUMBER(1, 0)	      DEFAULT 0 					NOT NULL
  3    , test_run_id	 NUMBER(38, 0)	      GENERATED ALWAYS AS IDENTITY (NOCACHE CYCLE MAXVALUE 9999999999999999999999999999)
  4    , test_run_date	 TIMESTAMP	      DEFAULT SYSTIMESTAMP				NOT NULL
  5    , test_passed	 NUMBER(1, 0)	      DEFAULT 0 					NOT NULL
  6    , test_session_id NUMBER(38, 0)	      DEFAULT 0 					NOT NULL
  7    , test_executor	 VARCHAR2(128 CHAR)   DEFAULT SYS_CONTEXT('USERENV', 'SESSION_USER')	NOT NULL
  8    , test_set	 VARCHAR2(256 CHAR)   DEFAULT 'OTAP test set'				NOT NULL
  9    , db_user	 VARCHAR2(128 CHAR)   DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_USER')	NOT NULL
 10    , db_schema	 VARCHAR2(128 CHAR)   DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')	NOT NULL
 11    , test_group	 VARCHAR2(256 CHAR)   DEFAULT 'OTAP test group' 			NOT NULL
 12    , test_start	 TIMESTAMP								NOT NULL
 13    , test_end	 TIMESTAMP								NOT NULL
 14    , test_name	 VARCHAR2(256 CHAR)							NOT NULL
 15    , test_desc	 VARCHAR2(256 CHAR)							NOT NULL
 16    , deleted	 DATE
 17    , deleted_by	 VARCHAR2(128 CHAR)
 18    , test_errors	 VARCHAR2(4000 CHAR)
 19    )
 20  ;

