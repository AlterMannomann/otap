538    FUNCTION has_constraint( p_table_name	  IN		VARCHAR2
539  			      , o_errors	     OUT NOCOPY VARCHAR2
540  			      , p_constraint_type IN		VARCHAR2 DEFAULT 'C'
541  			      , p_column_name	  IN		VARCHAR2 DEFAULT NULL
542  			      , p_constraint	  IN		VARCHAR2 DEFAULT NULL
543  			      , p_schema	  IN		VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
544  			      , p_expected_result IN		NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
545  			      )
546  	 RETURN INTEGER
547    IS
548  	 l_script	   VARCHAR2(1024 CHAR)	  := 'otap_schema.has_constraint';
549  	 l_test_passed	   INTEGER;
550  	 l_expected	   INTEGER;
551  	 l_has_constraint  INTEGER;
552  	 l_constraint_type CHAR(1 CHAR);
553  	 l_table_name	   VARCHAR2(128 CHAR);
554  	 l_column_name	   VARCHAR2(128 CHAR);
555  	 l_constraint_name VARCHAR2(128 CHAR);
556  	 l_schema_to_use   VARCHAR2(128 CHAR);
557  	 l_errors	   VARCHAR2(32767 CHAR);
558    BEGIN
559  	 l_errors	   := NULL;
560  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
561  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
562  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
563  	 l_column_name	   := otap_string.reduce(p_column_name, 128);
564  	 l_constraint_name := otap_string.reduce(p_constraint, 128);
565  	 l_constraint_type := otap_string.reduce(UPPER(p_constraint_type), 1);
566  	 IF	l_table_name	    IS NOT NULL
567  	    AND LENGTH(l_table_name) > 0
568  	    AND l_constraint_type   IN ('P', 'U', 'R', 'C', 'F', 'O', 'V', 'H')
569  	 THEN
570  	   -- schema
571  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
572  	   -- check
573  	   SELECT COUNT(*)
574  	     INTO l_has_constraint
575  	     FROM dba_constraints dco
576  	     LEFT OUTER JOIN dba_cons_columns dcc
577  	       ON dco.owner			   = dcc.owner
578  	      AND dco.constraint_name		   = dcc.constraint_name
579  	      AND dco.table_name		   = dcc.table_name
580  	    WHERE dco.owner			   = l_schema_to_use
581  	      AND dco.table_name		   = l_table_name
582  	      AND NVL(dcc.column_name, 'n/a')	   = NVL(l_column_name, NVL(dcc.column_name, 'n/a'))
583  	      AND NVL(dco.constraint_name, 'n/a')  = NVL(l_constraint_name, NVL(dco.constraint_name, 'n/a'))
584  	      AND dco.constraint_type		   = l_constraint_type
585  	   ;
586  	   -- we may find more than one entry for combined primary keys
587  	   l_test_passed := CASE WHEN l_has_constraint = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
588  	 ELSE
589  	   -- missing mandatory table name
590  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
591  	   l_errors	       := 'Not allowed: ' || CASE WHEN l_table_name IS NULL THEN 'p_table_name(NULL) ' END ||
592  						     CASE
593  						       WHEN l_constraint_type NOT IN ('P', 'U', 'R', 'C', 'F', 'O', 'V', 'H')
594  						       THEN 'p_constraint_type(' || NVL(p_constraint_type, 'NULL') || ') '
595  						     END
596  	   ;
597  	   otap_log.log(l_errors, l_script, 'Table name NULL or invalid constraint type');
598  	 END IF;
599  	 -- now decide on the expected result the final state and if errors are returned
600  	 IF l_test_passed != l_expected
601  	 THEN
602  	   o_errors := otap_string.reduce(l_errors, 4000);
603  	 ELSE
604  	   -- overwrite states from before, as we fulfill expected
605  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
606  	   -- overwrite errors expected
607  	   o_errors := NULL;
608  	 END IF;
609  	 RETURN l_test_passed;
610    EXCEPTION
611  	 WHEN OTHERS THEN
612  	   IF SQLCODE != -20099
613  	   THEN
614  	     -- log unhandled exceptions
615  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
616  	   END IF;
617  	   RAISE;
618    END has_constraint;
619  
620    FUNCTION has_ref_constraint( p_table_name      IN	    VARCHAR2
621  				  , o_errors		 OUT NOCOPY VARCHAR2
622  				  , p_constraint_type IN	    VARCHAR2 DEFAULT 'R'
623  				  , p_column_name     IN	    VARCHAR2 DEFAULT NULL
624  				  , p_constraint      IN	    VARCHAR2 DEFAULT NULL
625  				  , p_schema	      IN	    VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
626  				  , p_r_table_name    IN	    VARCHAR2 DEFAULT NULL
627  				  , p_r_column_name   IN	    VARCHAR2 DEFAULT NULL
628  				  , p_r_constraint    IN	    VARCHAR2 DEFAULT NULL
629  				  , p_r_schema	      IN	    VARCHAR2 DEFAULT NULL
630  				  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
631  				  )
632  	 RETURN INTEGER
633    IS
634  	 l_script	     VARCHAR2(1024 CHAR)    := 'otap_schema.has_ref_constraint';
635  	 l_test_passed	     INTEGER;
636  	 l_expected	     INTEGER;
637  	 l_has_constraint    INTEGER;
638  	 l_constraint_type   CHAR(1 CHAR);
639  	 l_table_name	     VARCHAR2(128 CHAR);
640  	 l_column_name	     VARCHAR2(128 CHAR);
641  	 l_constraint_name   VARCHAR2(128 CHAR);
642  	 l_schema_to_use     VARCHAR2(128 CHAR);
643  	 l_r_table_name      VARCHAR2(128 CHAR);
644  	 l_r_column_name     VARCHAR2(128 CHAR);
645  	 l_r_constraint_name VARCHAR2(128 CHAR);
646  	 l_r_schema	     VARCHAR2(128 CHAR);
647  	 l_errors	     VARCHAR2(32767 CHAR);
648    BEGIN
649  	 l_errors	     := NULL;
650  	 l_test_passed	     := otap_constants.OTAP_NUM_TEST_UNDEFINED;
651  	 l_expected	     := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
652  	 l_table_name	     := otap_string.reduce(p_table_name, 128);
653  	 l_column_name	     := otap_string.reduce(p_column_name, 128);
654  	 l_constraint_name   := otap_string.reduce(p_constraint, 128);
655  	 l_r_table_name      := otap_string.reduce(p_r_table_name, 128);
656  	 l_r_column_name     := otap_string.reduce(p_r_column_name, 128);
657  	 l_r_constraint_name := otap_string.reduce(p_r_constraint, 128);
658  	 l_r_schema	     := otap_string.reduce(p_r_schema, 128);
659  	 l_constraint_type   := otap_string.reduce(UPPER(p_constraint_type), 1);
660  	 IF	l_table_name	    IS NOT NULL
661  	    AND LENGTH(l_table_name) > 0
662  	    AND l_constraint_type   IN ('R', 'F')
663  	 THEN
664  	   -- schema
665  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
666  	   -- check
667  	   SELECT COUNT(*)
668  	     INTO l_has_constraint
669  	     FROM dba_constraints dco
670  	     LEFT OUTER JOIN dba_cons_columns dcc
671  	       ON dco.owner	      = dcc.owner
672  	      AND dco.constraint_name = dcc.constraint_name
673  	      AND dco.table_name      = dcc.table_name
674  	     LEFT OUTER JOIN dba_cons_columns dcr
675  	       ON dco.r_owner			     = dcr.owner
676  	      AND dco.r_constraint_name 	     = dcr.constraint_name
677  	    WHERE dco.owner			     = l_schema_to_use
678  	      AND dco.table_name		     = l_table_name
679  	      AND NVL(dcc.column_name, 'n/a')	     = NVL(l_column_name, NVL(dcc.column_name, 'n/a'))
680  	      AND dco.constraint_name		     = NVL(l_constraint_name, dco.constraint_name)
681  	      AND NVL(dco.r_owner, 'n/a')	     = NVL(l_r_schema, NVL(dco.r_owner, 'n/a'))
682  	      AND NVL(dco.r_constraint_name, 'n/a')  = NVL(l_r_constraint_name, NVL(dco.r_constraint_name, 'n/a'))
683  	      AND NVL(dcr.table_name, 'n/a')	     = NVL(l_r_table_name, NVL(dcr.table_name, 'n/a'))
684  	      AND NVL(dcr.column_name, 'n/a')	     = NVL(l_r_column_name, NVL(dcr.column_name, 'n/a'))
685  	      AND dco.constraint_type		     = l_constraint_type
686  	   ;
687  	   -- we may find more than one entry for combined primary keys
688  	   l_test_passed := CASE WHEN l_has_constraint = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
689  	 ELSE
690  	   -- missing mandatory table name
691  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
692  	   l_errors	       := 'Not allowed: ' || CASE WHEN l_table_name IS NULL THEN 'p_table_name(NULL) ' END ||
693  						     CASE
694  						       WHEN l_constraint_type NOT IN ('R', 'F')
695  						       THEN 'p_constraint_type(' || NVL(p_constraint_type, 'NULL') || ')'
696  						     END
697  	   ;
698  	   otap_log.log(l_errors, l_script, 'Table name NULL or invalid constraint type');
699  	 END IF;
700  	 -- now decide on the expected result the final state and if errors are returned
701  	 IF l_test_passed != l_expected
702  	 THEN
703  	   o_errors := otap_string.reduce(l_errors, 4000);
704  	 ELSE
705  	   -- overwrite states from before, as we fulfill expected
706  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
707  	   -- overwrite errors expected
708  	   o_errors := NULL;
709  	 END IF;
710  	 RETURN l_test_passed;
711    EXCEPTION
712  	 WHEN OTHERS THEN
713  	   IF SQLCODE != -20099
714  	   THEN
715  	     -- log unhandled exceptions
716  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
717  	   END IF;
718  	   RAISE;
719    END has_ref_constraint;
720  
721    FUNCTION has_not_null_constraint( p_table_name	   IN		 VARCHAR2
722  				       , p_column_name	   IN		 VARCHAR2
723  				       , o_errors	      OUT NOCOPY VARCHAR2
724  				       , p_constraint	   IN		 VARCHAR2 DEFAULT NULL
725  				       , p_schema	   IN		 VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
726  				       , p_expected_result IN		 NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
727  				       )
728  	 RETURN INTEGER
729    IS
730  	 l_script	   VARCHAR2(1024 CHAR)	  := 'otap_schema.has_not_null_constraint';
731  	 l_test_passed	   INTEGER;
732  	 l_expected	   INTEGER;
733  	 l_has_constraint  INTEGER;
734  	 l_constraint_type CHAR(1 CHAR);
735  	 l_table_name	   VARCHAR2(128 CHAR);
736  	 l_column_name	   VARCHAR2(128 CHAR);
737  	 l_constraint_name VARCHAR2(128 CHAR);
738  	 l_schema_to_use   VARCHAR2(128 CHAR);
739  	 l_errors	   VARCHAR2(32767 CHAR);
740    BEGIN
741  	 l_errors	   := NULL;
742  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
743  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
744  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
745  	 l_column_name	   := otap_string.reduce(p_column_name, 128);
746  	 l_constraint_name := otap_string.reduce(p_constraint, 128);
747  	 l_constraint_type := 'C';
748  	 IF	l_table_name	     IS NOT NULL
749  	    AND LENGTH(l_table_name)  > 0
750  	    AND l_column_name	     IS NOT NULL
751  	    AND LENGTH(l_column_name) > 0
752  	 THEN
753  	   -- schema
754  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
755  	   -- check
756  	   SELECT COUNT(*)
757  	     INTO l_has_constraint
758  	     FROM dba_constraints dco
759  	     LEFT OUTER JOIN dba_cons_columns dcc
760  	       ON dco.owner						      = dcc.owner
761  	      AND dco.constraint_name					      = dcc.constraint_name
762  	      AND dco.table_name					      = dcc.table_name
763  	    WHERE dco.owner						      = l_schema_to_use
764  	      AND dco.table_name					      = l_table_name
765  	      AND dcc.column_name					      = l_column_name
766  	      AND INSTR(UPPER(dco.search_condition_vc), UPPER(l_column_name)) > 0
767  	      AND INSTR( otap_string.flatten( UPPER(dco.search_condition_vc)
768  					    , 4000)
769  		       , 'IS NOT NULL'
770  		       )						      > 0
771  	      AND dco.constraint_name					      = NVL(l_constraint_name, dco.constraint_name)
772  	      AND dco.constraint_type					      = l_constraint_type
773  	   ;
774  	   -- we may find more than one entry for combined primary keys
775  	   l_test_passed := CASE WHEN l_has_constraint = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
776  	 ELSE
777  	   -- missing mandatory table name
778  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
779  	   l_errors	       := 'Not allowed: ' || CASE WHEN l_table_name IS NULL THEN 'p_table_name(NULL) ' END ||
780  						     CASE WHEN l_column_name IS NULL THEN 'p_column_name(NULL) ' END
781  	   ;
782  	   otap_log.log(l_errors, l_script, 'Table name or column name NULL');
783  	 END IF;
784  	 -- now decide on the expected result the final state and if errors are returned
785  	 IF l_test_passed != l_expected
786  	 THEN
787  	   o_errors := otap_string.reduce(l_errors, 4000);
788  	 ELSE
789  	   -- overwrite states from before, as we fulfill expected
790  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
791  	   -- overwrite errors expected
792  	   o_errors := NULL;
793  	 END IF;
794  	 RETURN l_test_passed;
795    EXCEPTION
796  	 WHEN OTHERS THEN
797  	   IF SQLCODE != -20099
798  	   THEN
799  	     -- log unhandled exceptions
800  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
801  	   END IF;
802  	   RAISE;
803    END has_not_null_constraint;
804  
805  END;
806  /

