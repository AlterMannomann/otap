301  	 l_message VARCHAR2(4000 CHAR);
302  	 l_status  VARCHAR2(4000 CHAR);
303    BEGIN
304  	 l_message := otap_constants.OTAP_ERROR_IDENTIFIER;
305  	 -- execute the wrapped function in an extra block
306  	 BEGIN
307  	   l_status := CASE
308  			 WHEN p_issues > 0
309  			 THEN otap_constants.OTAP_TEXT_TEST_UNDEFINED
310  			 WHEN p_errors > 0 AND p_issues <= 0
311  			 THEN otap_constants.OTAP_TEXT_TEST_FAILED
312  			 ELSE otap_constants.OTAP_TEXT_TEST_PASSED
313  		       END
314  	   ;
315  	   l_message := otap_report.get_summary(l_status, p_runtime, p_runs, p_errors, p_issues, p_min_fill);
316  	 EXCEPTION
317  	   WHEN OTHERS THEN
318  	     -- consume error
319  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_summary');
320  	     l_message := otap_string.reduce('Internal otap error get report summary: ' || SQLERRM, 4000);
321  	 END;
322  	 -- return or let exception happen
323  	 RETURN l_message;
324    END get_summary;
