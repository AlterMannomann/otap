SQL> 
SQL> -- trigger
SQL> CREATE OR REPLACE TRIGGER otap_config_ins_trg
  2    BEFORE INSERT ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  )
 12    THEN
 13  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 14    END IF;
 15    -- remove any leading and trailing blanks from config_value
 16    :NEW.config_value   := TRIM(:NEW.config_value);
 17    :NEW.created	   := SYSDATE;
 18    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 19    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 20    -- check max length if defined
 21    IF :NEW.config_type = 'CHAR'
 22    THEN
 23  	 IF :NEW.config_max_length > 0
 24  	 THEN
 25  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 26  	   THEN
 27  	     RAISE_APPLICATION_ERROR(-20002, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 28  	   END IF;
 29  	 END IF;
 30    END IF;
 31    -- check number type
 32    IF :NEW.config_type = 'NUMBER'
 33    THEN
 34  	 l_ok := TRUE;
 35  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 36  	 BEGIN
 37  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 38  	 EXCEPTION
 39  	   WHEN OTHERS THEN
 40  	     l_ok := FALSE;
 41  	 END;
 42  	 IF NOT l_ok
 43  	 THEN
 44  	   RAISE_APPLICATION_ERROR(-20003, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 45  	 END IF;
 46    END IF;
 47    -- handle NULLs
 48    IF :NEW.config_name = 'PRESERVE_DAYS'
 49    THEN
 50  	 :NEW.config_value := NVL(:NEW.config_value, '1');
 51    END IF;
 52    IF :NEW.config_name = 'DELETE_DELAY'
 53    THEN
 54  	 :NEW.config_value := NVL(:NEW.config_value, '10');
 55    END IF;
 56    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
 57    THEN
 58  	 :NEW.config_value := NVL(:NEW.config_value, '1000');
 59    END IF;
 60  END;
 61  /

Trigger created.

SQL> CREATE OR REPLACE TRIGGER otap_config_upd_trg
  2    BEFORE UPDATE ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  )
 12    THEN
 13  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 14    END IF;
 15    -- remove any leading and trailing blanks from config_value
 16    :NEW.config_value := TRIM(:NEW.config_value);
 17    -- ensure some values are not overwritten
 18    :NEW.created	   := :OLD.created;
 19    :NEW.created_by	   := :OLD.created_by;
 20    :NEW.created_by_os  := :OLD.created_by_os;
 21    -- check max length if defined
 22    IF :NEW.config_type = 'CHAR'
 23    THEN
 24  	 IF :NEW.config_max_length > 0
 25  	 THEN
 26  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 27  	   THEN
 28  	     RAISE_APPLICATION_ERROR(-20002, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 29  	   END IF;
 30  	 END IF;
 31    END IF;
 32    -- check number type
 33    IF :NEW.config_type = 'NUMBER'
 34    THEN
 35  	 l_ok := TRUE;
 36  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 37  	 BEGIN
 38  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 39  	 EXCEPTION
 40  	   WHEN OTHERS THEN
 41  	     l_ok := FALSE;
 42  	 END;
 43  	 IF NOT l_ok
 44  	 THEN
 45  	   RAISE_APPLICATION_ERROR(-20003, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 46  	 END IF;
 47    END IF;
 48    -- check range
 49    IF :NEW.config_name = 'PRESERVE_DAYS'
 50    THEN
 51  	 IF    TO_NUMBER(:NEW.config_value) > 7
 52  	    OR TO_NUMBER(:NEW.config_value) < 1
 53  	 THEN
 54  	   :NEW.config_value := '1';
 55  	 END IF;
 56    END IF;
 57    IF :NEW.config_name = 'DELETE_DELAY'
 58    THEN
 59  	 IF    TO_NUMBER(:NEW.config_value) > 600
 60  	    OR TO_NUMBER(:NEW.config_value) < 1
 61  	 THEN
 62  	   :NEW.config_value := '10';
 63  	 END IF;
 64    END IF;
 65    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
 66    THEN
 67  	 IF    TO_NUMBER(:NEW.config_value) > 10000
 68  	    OR TO_NUMBER(:NEW.config_value) < 100
 69  	 THEN
 70  	   :NEW.config_value := '1000';
 71  	 END IF;
 72    END IF;
 73  END;
 74  /

