470    FUNCTION get_separator_line( p_char     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
471  				  , p_min_fill IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
472  				  )
473  	 RETURN VARCHAR2
474    IS
475  	 l_char        VARCHAR2(1 CHAR);
476  	 l_return_text VARCHAR2(32767 CHAR);
477  	 l_line 	    otap_config.config_value%TYPE;
478    BEGIN
479  	 l_char := otap_string.check_decoration(p_char);
480  	 l_return_text := otap_report.decorate( NULL
481  					      , GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), otap_util.get_length_headers)
482  					      , l_char
483  					      )
484  	 ;
485  	 RETURN l_return_text;
