104  
105    FUNCTION result_view(p_session_id IN NUMBER)
106  	 RETURN otap_view_result_tbl PIPELINED
107    IS
108  	 l_text_column	VARCHAR2(4000 CHAR);
109  	 CURSOR cur_report(cp_session_id IN NUMBER)
110  	 IS
111  	   SELECT result_text
112  		, result_errors
113  	     FROM TABLE(otap_api.result_view(cp_session_id))
114  	 ;
115    BEGIN
116  	 FOR rec IN cur_report(p_session_id)
117  	 LOOP
118  	   PIPE ROW (otap_view_result_rec(rec.result_text, rec.result_errors));
119  	 END LOOP;
120  	 RETURN;
121    EXCEPTION
122  	 WHEN NO_DATA_NEEDED THEN
123  	   RAISE;
124  	 WHEN OTHERS THEN
125  	   IF SQLCODE != -20099
126  	   THEN
127  	     otap_log.log(SQLERRM, 'otap_test.result_view', 'Unhandled exception otap_test.result_view');
128  	   END IF;
129  	   RAISE;
130    END result_view;
