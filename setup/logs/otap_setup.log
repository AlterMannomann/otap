115  	 l_template_text := REPLACE(l_template_text, '@descs@', TRIM(TO_CHAR(NVL(p_descriptions, 0))));
116  	 -- get borderless
117  	 l_return_text := otap_report.borderless( l_template_text
118  						, GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), NVL(LENGTH(l_template_text), 0), otap_util.get_length_headers)
119  						)
120  	 ;
121  	 RETURN l_return_text;
122    EXCEPTION
123  	 WHEN OTHERS THEN
124  	   otap_log.log(SQLERRM, 'otap_report.get_report_total_details', 'Report totals template replacement');
125  	   RAISE;
126    END get_report_total_details;
