SQL> CREATE OR REPLACE PACKAGE BODY otap_plan
  2  AS
  3    -- for description see header file
  4    PROCEDURE write_test_result( p_test_description IN VARCHAR2
  5  				  , p_otap_session     IN OTAP_SESSION
  6  				  , p_test_passed      IN NUMBER
  7  				  , p_test_start       IN TIMESTAMP
  8  				  , p_test_end	       IN TIMESTAMP
  9  				  , p_test_errors      IN VARCHAR2
 10  				  )
 11    IS
 12  	 PRAGMA AUTONOMOUS_TRANSACTION;
 13  	 l_script	     VARCHAR2(1024) := 'otap_plan.write_test_result';
 14  	 l_test_passed	     INTEGER;
 15  	 l_test_description  VARCHAR2(256);
 16  	 l_errors	     VARCHAR2(4000);
 17  	 l_to_delete	     INTEGER;
 18    BEGIN
 19  	 otap_objects.otap_session_verify(p_otap_session);
 20  	 IF LENGTH(TRIM(l_errors)) > 4000
 21  	 THEN
 22  	   l_errors := SUBSTR(TRIM(p_test_errors), 1, 4000);
 23  	 ELSE
 24  	   l_errors := TRIM(p_test_errors);
 25  	 END IF;
 26  	 IF p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 27  	 THEN
 28  	   l_test_passed := p_test_passed;
 29  	 ELSE
 30  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
 31  	   l_errors	 := SUBSTR('Invalid test passed value: ' || p_test_passed || otap_constants.OTAP_LF || l_errors, 1, 4000);
 32  	   otap_util.log('ERROR The given value for test passed ' || p_test_passed || ' for test description ' || p_test_description || ' is not valid.', l_script, 'p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)');
 33  	 END IF;
 34  	 IF p_test_description IS NULL
 35  	 THEN
 36  	   l_test_description := 'Unspecified test ' || TIMESTAMP_TO_SCN(SYSTIMESTAMP);
 37  	   l_errors	      := SUBSTR('Missing test description' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 38  	 ELSE
 39  	   IF LENGTH(p_test_description) > 256
 40  	   THEN
 41  	     l_test_description := SUBSTR(TRIM(p_test_description), 1, 256);
 42  	     l_errors		:= SUBSTR('Test description too long, cutted' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 43  	   ELSE
 44  	     l_test_description := TRIM(p_test_description);
 45  	   END IF;
 46  	 END IF;
 47  	 -- set delete flag as stored
 48  	 l_to_delete := CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_NUM_FALSE ELSE otap_constants.OTAP_NUM_TRUE END;
 49  	 -- ready to insert
 50  	 INSERT INTO otap_results
 51  	   ( to_delete
 52  	   , test_passed
 53  	   , test_session_id
 54  	   , test_executor
 55  	   , test_set
 56  	   , test_group
 57  	   , test_name
 58  	   , test_desc
 59  	   , test_start
 60  	   , test_end
 61  	   , db_user
 62  	   , db_schema
 63  	   , test_errors
 64  	   ) VALUES ( l_to_delete
 65  		    , l_test_passed
 66  		    , p_otap_session.session_id
 67  		    , p_otap_session.test_executor
 68  		    , p_otap_session.test_set
 69  		    , p_otap_session.test_group
 70  		    , p_otap_session.test_name
 71  		    , l_test_description
 72  		    , p_test_start
 73  		    , p_test_end
 74  		    , p_otap_session.db_user
 75  		    , p_otap_session.db_schema
 76  		    , l_errors
 77  		    )
 78  	 ;
 79  	 COMMIT;
 80    EXCEPTION
 81  	 WHEN OTHERS THEN
 82  	   IF SQLCODE != -20099
 83  	   THEN
 84  	     -- log unhandled exceptions
 85  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 86  	   END IF;
 87  	   RAISE;
 88    END write_test_result;
 89  
 90    PROCEDURE write_count_result(p_otap_session IN OTAP_SESSION)
 91    IS
 92  	 l_script	     VARCHAR2(1024) := 'otap_plan.write_count_result';
 93  	 l_test_passed	     INTEGER;
 94  	 l_test_description  VARCHAR2(256);
 95  	 l_errors	     VARCHAR2(4000);
 96  	 l_start	     TIMESTAMP;
 97  	 l_end		     TIMESTAMP;
 98    BEGIN
 99  	 l_start := SYSTIMESTAMP;
100  	 -- only write a record, if intended count is set, do nothing otherwise
101  	 IF p_otap_session.intended_count > 0
102  	 THEN
103  	   l_test_passed      := CASE WHEN p_otap_session.test_count = p_otap_session.intended_count THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
104  	   l_test_description := 'Run ' || p_otap_session.test_count || ' of ' || p_otap_session.intended_count || ' tests, this test excluded';
105  	   l_errors	      := NULL;
106  	   l_end	      := SYSTIMESTAMP;
107  	   write_test_result(l_test_description, p_otap_session, l_test_passed, l_start, l_end, l_errors);
108  	 END IF;
109    EXCEPTION
110  	 WHEN OTHERS THEN
111  	   IF SQLCODE != -20099
112  	   THEN
113  	     -- log unhandled exceptions
114  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
115  	   END IF;
116  	   RAISE;
117    END write_count_result;
118  
119    FUNCTION init_test( p_test_count 	 IN	       NUMBER
120  			 , p_test_set		 IN	       VARCHAR2
121  			 , p_test_group 	 IN	       VARCHAR2
122  			 , p_test_name		 IN	       VARCHAR2
123  			 , p_prefix		 IN	       VARCHAR2
124  			 , p_name_precedence	 IN	       NUMBER
125  			 , p_include_pkg	 IN	       NUMBER
126  			 , p_persist		 IN	       NUMBER
127  			 , p_schema		 IN	       VARCHAR2
128  			 , p_user		 IN	       VARCHAR2
129  			 , p_executor		 IN	       VARCHAR2
130  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
131  			 )
132  	 RETURN VARCHAR2
133    IS
134  	 l_script  VARCHAR2(1024) := 'otap_plan.init_test';
135  	 l_message VARCHAR2(4000);
136    BEGIN
137  	 -- if test count is not 0 this is a reset, write a test count record, if intended count is set
138  	 IF	o_otap_session.test_count      > 0
139  	    AND (   o_otap_session.intended_count  > 0
140  		 OR NVL(p_test_count, 0)	   > 0
141  		)
142  	 THEN
143  	   -- write record with current values
144  	   write_count_result(o_otap_session);
145  	   l_message := 'Closed test session summary' || otap_constants.OTAP_LF;
146  	   l_message := l_message || otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_LF;
147  	 END IF;
148  	 -- now start setting the new values
149  	 l_message := l_message || otap_objects.otap_session_set( p_test_count
150  								, p_test_set
151  								, p_test_group
152  								, p_test_name
153  								, p_prefix
154  								, p_name_precedence
155  								, p_include_pkg
156  								, p_persist
157  								, p_schema
158  								, p_user
159  								, p_executor
160  								, o_otap_session
161  								)
162  	 ;
163  	 RETURN l_message;
164    EXCEPTION
165  	 WHEN OTHERS THEN
166  	   IF SQLCODE != -20099
167  	   THEN
168  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
169  	   END IF;
170  	   RAISE;
171    END init_test;
172  
173    FUNCTION run_tests( p_like_expression   IN VARCHAR2 DEFAULT '%'
174  			 , p_schema_overwrite  IN VARCHAR2 DEFAULT NULL
175  			 , p_otap_session      IN OTAP_SESSION
176  			 )
177  	 RETURN VARCHAR2
178    IS
179  	 l_script  VARCHAR2(1024) := 'otap_plan.run_tests';
180  	 l_message VARCHAR2(4000);
181  	 l_schema  VARCHAR2(128);
182  	 l_like    VARCHAR2(256);
183  	 l_test    VARCHAR2(257);
184  	 CURSOR cur_tests_to_run( cp_schema IN VARCHAR2
185  				, cp_like   IN VARCHAR2
186  				)
187  	 IS
188  	   SELECT owner
189  		, object_name
190  	     FROM dba_objects
191  	    WHERE object_type	 = 'PROCEDURE'
192  	      AND owner 	 = cp_schema
193  	      AND object_name LIKE cp_like ESCAPE '\'
194  	 ;
195    BEGIN
196  	 l_schema := NVL(p_schema_overwrite, p_otap_session.db_schema);
197  	 l_like   := p_otap_session.test_prefix || '\' || otap_constants.OTAP_DEFAULT_DELIMITER || NVL(p_like_expression, '%');
198  	 -- loop over records found
199  	 FOR rec IN cur_tests_to_run(l_schema, l_like)
200  	 LOOP
201  	   NULL;
202  	 END LOOP;
203  	 RETURN l_message;
204    EXCEPTION
205  	 WHEN OTHERS THEN
206  	   IF SQLCODE != -20099
207  	   THEN
208  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
209  	   END IF;
210  	   RAISE;
211    END run_tests;
212  
213    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
214  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
215  			   )
216  	 RETURN VARCHAR2
217    IS
218  	 l_script  VARCHAR2(1024) := 'otap_plan.finish_test';
219  	 l_message VARCHAR2(4000);
220    BEGIN
221  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
222  	 THEN
223  	   otap_plan.write_count_result(o_otap_session);
224  	 END IF;
225  	 l_message := otap_objects.otap_session_finish(o_otap_session);
226  	 RETURN l_message;
227    EXCEPTION
228  	 WHEN OTHERS THEN
229  	   IF SQLCODE != -20099
230  	   THEN
231  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
232  	   END IF;
233  	   RAISE;
234    END finish_test;
235  
236  END;
237  /

