SQL> CREATE OR REPLACE TRIGGER otap_config_upd_trg
  2    BEFORE UPDATE ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  , 'FORMAT_HEADER_CHAR'
 13  				  , 'FORMAT_SET_CHAR'
 14  				  , 'FORMAT_GROUP_CHAR'
 15  				  , 'FORMAT_NAME_CHAR'
 16  				  , 'TEXT_TRUE'
 17  				  , 'TEXT_FALSE'
 18  				  , 'TEXT_TRUE_YES'
 19  				  , 'TEXT_FALSE_NO'
 20  				  , 'TEXT_TEST_PASSED'
 21  				  , 'TEXT_TEST_FAILED'
 22  				  , 'TEXT_TEST_UNDEFINED'
 23  				  , 'DEFAULT_PREFIX'
 24  				  , 'DEFAULT_TEST_SET'
 25  				  , 'DEFAULT_TEST_GROUP'
 26  				  , 'DEFAULT_TEST_NAME'
 27  				  , 'DEFAULT_LAYOUT'
 28  				  , 'DEFAULT_RESULT_LAYOUT'
 29  				  , 'DEFAULT_BORDER'
 30  				  , 'TEXT_REPORT_START'
 31  				  , 'TEXT_REPORT_END'
 32  				  , 'TEXT_RESULT_HEADER'
 33  				  , 'FORMAT_RESULT_HEADER'
 34  				  , 'TEXT_SUMMARY_SUCCESS'
 35  				  , 'TEXT_SUMMARY_ERROR'
 36  				  , 'SUMMARY_TEMPLATE'
 37  				  , 'ERRORS_TEMPLATE'
 38  				  , 'ERROR_DETAILS_TEMPLATE'
 39  				  , 'NO_DATA_TEMPLATE'
 40  				  , 'SESSION_ID_TEMPLATE'
 41  				  , 'SET_TEMPLATE'
 42  				  , 'GROUP_TEMPLATE'
 43  				  , 'TEST_NAME_TEMPLATE'
 44  				  , 'RESULT_LINE_TEMPLATE'
 45  				  )
 46    THEN
 47  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 48    END IF;
 49    -- remove any leading and trailing blanks from config_value, do not accept NULLS, overwrite with OLD in this case
 50    :NEW.config_value := NVL(TRIM(:NEW.config_value), :OLD.config_value);
 51    -- ensure some values are not overwritten
 52    :NEW.created	   := :OLD.created;
 53    :NEW.created_by	   := :OLD.created_by;
 54    :NEW.created_by_os  := :OLD.created_by_os;
 55    -- check max length if defined
 56    IF :NEW.config_type = 'CHAR'
 57    THEN
 58  	 IF :NEW.config_max_length > 0
 59  	 THEN
 60  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 61  	   THEN
 62  	     RAISE_APPLICATION_ERROR(-20003, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 63  	   END IF;
 64  	 END IF;
 65    END IF;
 66    -- check number type
 67    IF :NEW.config_type = 'NUMBER'
 68    THEN
 69  	 l_ok := TRUE;
 70  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 71  	 BEGIN
 72  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 73  	 EXCEPTION
 74  	   WHEN OTHERS THEN
 75  	     l_ok := FALSE;
 76  	 END;
 77  	 IF NOT l_ok
 78  	 THEN
 79  	   RAISE_APPLICATION_ERROR(-20004, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 80  	 END IF;
 81    END IF;
 82    -- check range if value changed
 83    IF :NEW.config_value != :OLD.config_value
 84    THEN
 85  	 IF :NEW.config_name = 'PRESERVE_DAYS'
 86  	 THEN
 87  	   IF	 TO_NUMBER(:NEW.config_value) > 7
 88  	      OR TO_NUMBER(:NEW.config_value) < 1
 89  	   THEN
 90  	     :NEW.config_value := '1';
 91  	   END IF;
 92  	 END IF;
 93  	 IF :NEW.config_name = 'DELETE_DELAY'
 94  	 THEN
 95  	   IF	 TO_NUMBER(:NEW.config_value) > 600
 96  	      OR TO_NUMBER(:NEW.config_value) < 1
 97  	   THEN
 98  	     :NEW.config_value := '10';
 99  	   END IF;
100  	 END IF;
101  	 IF :NEW.config_name = 'DELETE_BATCH_SIZE'
102  	 THEN
103  	   IF	 TO_NUMBER(:NEW.config_value) > 10000
104  	      OR TO_NUMBER(:NEW.config_value) < 100
105  	   THEN
106  	     :NEW.config_value := '1000';
107  	   END IF;
108  	 END IF;
109  	 IF :NEW.config_name = 'DEBUG_MODE'
110  	 THEN
111  	   IF TO_NUMBER(:NEW.config_value) NOT IN (0, 1)
112  	   THEN
113  	     :NEW.config_value := '0';
114  	   END IF;
115  	 END IF;
116  	 IF :NEW.config_name = 'DEFAULT_PREFIX'
117  	 THEN
118  	   IF INSTR(:NEW.config_value, '_') > 0
119  	   THEN
120  	     -- do not change if prefix contains invalid char
121  	     :NEW.config_value := :OLD.config_value;
122  	   END IF;
123  	 END IF;
124  	 -- check layout options
125  	 IF    :NEW.config_name = 'DEFAULT_LAYOUT'
126  	   AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
127  	 THEN
128  	   :NEW.config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
129  	 END IF;
130  	 IF	:NEW.config_name = 'DEFAULT_RESULT_LAYOUT'
131  	    AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
132  	 THEN
133  	   :NEW.config_value := otap_constants.OTAP_LAYOUT_LEFT;
134  	 END IF;
135  	 -- check border options
136  	  IF	 :NEW.config_name = 'DEFAULT_BORDER'
137  	     AND (   TO_NUMBER(:NEW.config_value) < 2
138  		  OR TO_NUMBER(:NEW.config_value) > 10
139  		 )
140  	 THEN
141  	   :NEW.config_value := otap_constants.OTAP_BORDER_DEFAULT;
142  	 END IF;
143    END IF;
144  END;
145  /

