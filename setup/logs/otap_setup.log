864    FUNCTION result_view( p_session_id   IN NUMBER
865  			   , p_language_id  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
866  			   )
867  	 RETURN otap_view_result_tbl PIPELINED
868    IS
869  	 l_delim_updown VARCHAR2(1 CHAR) := '=';
870  	 l_delim_tests	VARCHAR2(1 CHAR) := '-';
871  	 l_text_column	VARCHAR2(4000 CHAR);
872  	 l_setup_set	VARCHAR2(256 CHAR);
873  	 l_setup_group	VARCHAR2(256 CHAR);
874  	 l_setup_name	VARCHAR2(256 CHAR);
875  	 l_has_errors	INTEGER;
876  	 l_has_records	INTEGER;
877  	 l_report_size	INTEGER;
878  	 CURSOR cur_test_sets( cp_session_id  IN NUMBER
879  			     , cp_setup_set   IN VARCHAR2
880  			     )
881  	 IS
882  	   SELECT test_set
883  		, COUNT(*) AS test_runs
884  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
885  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
886  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
887  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
888  	     FROM otap_results
889  	    WHERE test_session_id = cp_session_id
890  	      AND test_set	 != cp_setup_set
891  	    GROUP BY test_set
892  	    ORDER BY MIN(test_run_date)
893  	 ;
894  	 CURSOR cur_test_groups( cp_session_id	IN NUMBER
895  			       , cp_test_set	IN VARCHAR2
896  			       , cp_setup_group IN VARCHAR2
897  			       )
898  	 IS
899  	   SELECT test_group
900  		, COUNT(*) AS test_runs
901  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
902  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
903  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
904  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
905  	     FROM otap_results
906  	    WHERE test_session_id = cp_session_id
907  	      AND test_set	  = cp_test_set
908  	      AND test_group	 != cp_setup_group
909  	    GROUP BY test_group
910  	    ORDER BY MIN(test_run_date)
911  	 ;
912  	 CURSOR cur_test_names( cp_session_id  IN NUMBER
913  			      , cp_test_set    IN VARCHAR2
914  			      , cp_test_group  IN VARCHAR2
915  			      , cp_setup_name  IN VARCHAR2
916  			      )
917  	 IS
918  	   SELECT test_name
919  		, COUNT(*) AS test_runs
920  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
921  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
922  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
923  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
924  	     FROM otap_results
925  	    WHERE test_session_id = cp_session_id
926  	      AND test_set	  = cp_test_set
927  	      AND test_group	  = cp_test_group
928  	      AND test_name	 != cp_setup_name
929  	    GROUP BY test_name
930  	    ORDER BY MIN(test_run_date)
931  	 ;
932  	 CURSOR cur_setup_sets( cp_session_id  IN NUMBER
933  			      , cp_setup_set   IN VARCHAR2
934  			      )
935  	 IS
936  	   SELECT test_set
937  		, COUNT(*) AS test_runs
938  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
939  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
940  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
941  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
942  	     FROM otap_results
943  	    WHERE test_session_id = cp_session_id
944  	      AND test_set	  = cp_setup_set
945  	    GROUP BY test_set
946  	    ORDER BY MIN(test_run_date)
947  	 ;
948  	 CURSOR cur_setup_groups( cp_session_id  IN NUMBER
949  				, cp_test_set	 IN VARCHAR2
950  				, cp_setup_group IN VARCHAR2
951  				)
952  	 IS
953  	   SELECT test_group
954  		, COUNT(*) AS test_runs
955  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
956  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
957  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
958  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
959  	     FROM otap_results
960  	    WHERE test_session_id = cp_session_id
961  	      AND test_set	  = cp_test_set
962  	      AND test_group	  = cp_setup_group
963  	    GROUP BY test_group
964  	    ORDER BY MIN(test_run_date)
965  	 ;
966  	 CURSOR cur_setup_names( cp_session_id	IN NUMBER
967  			       , cp_test_set	IN VARCHAR2
968  			       , cp_test_group	IN VARCHAR2
969  			       , cp_setup_name	IN VARCHAR2
970  			       )
971  	 IS
972  	   SELECT test_name
973  		, COUNT(*) AS test_runs
974  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
975  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
976  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
977  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
978  	     FROM otap_results
979  	    WHERE test_session_id = cp_session_id
980  	      AND test_set	  = cp_test_set
981  	      AND test_group	  = cp_test_group
982  	      AND test_name	  = cp_setup_name
983  	    GROUP BY test_name
984  	    ORDER BY MIN(test_run_date)
985  	 ;
986  	 CURSOR cur_session_total(cp_session_id  IN NUMBER)
987  	 IS
988  	   SELECT test_session_id
989  		, COUNT(DISTINCT test_set) AS test_sets
990  		, COUNT(DISTINCT test_group) AS test_groups
991  		, COUNT(DISTINCT test_name) AS test_names
992  		, COUNT(DISTINCT test_desc) AS test_descs
993  		, COUNT(*) AS test_runs
994  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
995  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
996  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
997  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
998  	     FROM otap_results
999  	    WHERE test_session_id = cp_session_id
1000  	     GROUP BY test_session_id
1001  	     ORDER BY MIN(test_run_date)
1002  	  ;
1003  	  CURSOR cur_tests( cp_session_id  IN NUMBER
1004  			  , cp_test_set    IN VARCHAR2
1005  			  , cp_test_group  IN VARCHAR2
1006  			  , cp_test_name   IN VARCHAR2
1007  			  , cp_language_id IN VARCHAR2
1008  			  )
1009  	  IS
1010  	    SELECT test_desc
1011  		 , test_passed
1012  		 , otap_api.test_result_to_text(test_passed, cp_language_id) AS test_state
1013  		 , CAST((test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS run_time
1014  		 , test_errors
1015  		 , otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END, cp_language_id) AS issue_state
1016  	      FROM otap_results
1017  	     WHERE test_session_id = cp_session_id
1018  	       AND test_set	   = cp_test_set
1019  	       AND test_group	   = cp_test_group
1020  	       AND test_name	   = cp_test_name
1021  	     ORDER BY test_run_date
1022  	  ;
1023  	BEGIN
1024  	  l_setup_set	:= otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_SET, p_language_id);
1025  	  l_setup_group := otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_GROUP, p_language_id);
1026  	  l_setup_name	:= otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_NAME, p_language_id);
1027  	  l_report_size := otap_api.max_text_size(p_session_id, p_language_id);
1028  	  -- header row
1029  	  l_text_column := otap_api.get_report_header(l_report_size, p_language_id);
1030  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1031  	  l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
1032  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1033  	  -- check for records
1034  	  SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
1035  	  IF l_has_records > 0
1036  	  THEN
1037  	    -- loop through the set
1038  	    FOR rec_set IN cur_test_sets(p_session_id, l_setup_set)
1039  	    LOOP
1040  	      -- build test set column
1041  	      l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size, p_language_id);
1042  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1043  	      -- build test set summary
1044  	      l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1045  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1046  	      l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.exec_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size, p_language_id);
1047  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1048  	      -- loop through the group
1049  	      FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set, l_setup_group)
1050  	      LOOP
1051  		l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size, p_language_id);
1052  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1053  		-- build test set summary
1054  		l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1055  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1056  		l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.exec_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size, p_language_id);
1057  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1058  		-- loop through the names
1059  		FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group, l_setup_name)
1060  		LOOP
1061  		  l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size, p_language_id);
1062  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1063  		  -- build test set summary
1064  		  l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1065  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1066  		  l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.exec_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size, p_language_id);
1067  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1068  		  -- build header
1069  		  l_text_column := otap_api.get_result_header(l_report_size, p_language_id);
1070  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1071  		  --l_text_column := otap_api.get_result_underline(l_report_size, p_language_id);
1072  		  --PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1073  		  -- loop through the tests
1074  		  FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1075  		  LOOP
1076  		    l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size, p_language_id);
1077  		    PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1078  		  END LOOP;
1079  		  SELECT COUNT(*)
1080  		    INTO l_has_errors
1081  		    FROM otap_results
1082  		   WHERE test_session_id = p_session_id
1083  		     AND test_set	 = rec_set.test_set
1084  		     AND test_group	 = rec_grp.test_group
1085  		     AND test_name	 = rec_nam.test_name
1086  		     AND test_errors	IS NOT NULL
1087  		  ;
1088  		  IF l_has_errors > 0
1089  		  THEN
1090  		    -- build error delimiter for tests
1091  		    l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size, p_language_id);
1092  		    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1093  		    FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1094  		    LOOP
1095  		      IF rec_tst.test_errors IS NOT NULL
1096  		      THEN
1097  			l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size, p_language_id);
1098  			PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1099  		      END IF;
1100  		    END LOOP;
1101  		  END IF;
1102  		END LOOP;
1103  	      END LOOP;
1104  	    END LOOP;
1105  	    -- no loop through the test setup checks like count if exists
1106  	    FOR rec_set IN cur_setup_sets(p_session_id, l_setup_set)
1107  	    LOOP
1108  	      -- build test set column
1109  	      l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size, p_language_id);
1110  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1111  	      -- build test set summary
1112  	      l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1113  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1114  	      l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.exec_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size, p_language_id);
1115  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1116  	      -- loop through the group
1117  	      FOR rec_grp IN cur_setup_groups(p_session_id, rec_set.test_set, l_setup_group)
1118  	      LOOP
1119  		l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size, p_language_id);
1120  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1121  		-- build test set summary
1122  		l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.exec_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size, p_language_id);
1123  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1124  		-- loop through the names
1125  		FOR rec_nam IN cur_setup_names(p_session_id, rec_set.test_set, rec_grp.test_group, l_setup_name)
1126  		LOOP
1127  		  l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size, p_language_id);
1128  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1129  		  -- build test set summary
1130  		  l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1131  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1132  		  l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.exec_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size, p_language_id);
1133  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1134  		  -- build header
1135  		  l_text_column := otap_api.get_result_header(l_report_size, p_language_id);
1136  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1137  		  --l_text_column := otap_api.get_result_underline(l_report_size, p_language_id);
1138  		  --PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1139  		  -- loop through the tests
1140  		  FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1141  		  LOOP
1142  		    l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size, p_language_id);
1143  		    PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1144  		  END LOOP;
1145  		  SELECT COUNT(*)
1146  		    INTO l_has_errors
1147  		    FROM otap_results
1148  		   WHERE test_session_id = p_session_id
1149  		     AND test_set	 = rec_set.test_set
1150  		     AND test_group	 = rec_grp.test_group
1151  		     AND test_name	 = rec_nam.test_name
1152  		     AND test_errors	IS NOT NULL
1153  		  ;
1154  		  IF l_has_errors > 0
1155  		  THEN
1156  		    -- build error delimiter for tests
1157  		    l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size, p_language_id);
1158  		    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1159  		    FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1160  		    LOOP
1161  		      IF rec_tst.test_errors IS NOT NULL
1162  		      THEN
1163  			l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size, p_language_id);
1164  			PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1165  		      END IF;
1166  		    END LOOP;
1167  		  END IF;
1168  		END LOOP;
1169  	      END LOOP;
1170  	    END LOOP;
1171  	    -- eventually build the totals for the test session
1172  	    l_text_column := otap_api.get_report_total(l_report_size, p_language_id);
1173  	    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1174  	    FOR rec IN cur_session_total(p_session_id)
1175  	    LOOP
1176  	      l_text_column := otap_api.get_report_total_details(rec.test_sets, rec.test_groups, rec.test_names, rec.test_descs, l_report_size, p_language_id);
1177  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1178  	      l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1179  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1180  	      l_text_column := otap_api.get_summary(rec.run_time, rec.exec_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size, p_language_id);
1181  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1182  	    END LOOP;
1183  	  ELSE
1184  	    l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size, p_language_id);
1185  	    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1186  	  END IF;
1187  	  -- footer row
1188  	  l_text_column := otap_api.get_report_footer(l_report_size, p_language_id);
1189  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1190  	  -- add AI and copyright
1191  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_NAME, l_report_size);
1192  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1193  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_VERSION_NR, l_report_size);
1194  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1195  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_COPYRIGHT1, l_report_size);
1196  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1197  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_COPYRIGHT2, l_report_size);
1198  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1199  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_COPYRIGHT3, l_report_size);
1200  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1201  	  RETURN;
1202  	EXCEPTION
1203  	  WHEN NO_DATA_NEEDED THEN
1204  	    RAISE;
1205  	  WHEN OTHERS THEN
1206  	    IF SQLCODE != -20099
1207  	    THEN
1208  	      otap_log.log(SQLERRM, 'otap_api.result_view', 'Unhandled exception otap_api.result_view');
1209  	    END IF;
1210  	    RAISE;
1211  	END result_view;
