 53    FUNCTION check_border(p_border IN INTEGER DEFAULT otap_constants.OTAP_BORDER_DEFAULT)
 54  	 RETURN NUMBER
 55    IS
 56  	 l_script VARCHAR2(256) := 'otap_string.check_border';
 57  	 l_border INTEGER;
 58    BEGIN
 59  	 IF NVL(p_border, otap_constants.OTAP_BORDER_DEFAULT) NOT BETWEEN 2 AND 10
 60  	 THEN
 61  	   l_border := otap_constants.OTAP_BORDER_DEFAULT;
 62  	 ELSE
 63  	   l_border := NVL(p_border, otap_constants.OTAP_BORDER_DEFAULT);
 64  	 END IF;
 65  	 RETURN l_border;
 66    EXCEPTION
 67  	 WHEN OTHERS THEN
 68  	   otap_log.log(SQLERRM, l_script, 'Check border constraints');
 69  	   RAISE;
 70    END check_border;
 71  
 72    FUNCTION check_line_size(p_line_size IN INTEGER DEFAULT otap_constants.OTAP_REPORT_MIN_FILL_LENGTH)
 73  	 RETURN NUMBER
 74    IS
 75  	 l_script    VARCHAR2(256) := 'otap_string.check_line_size';
 76  	 l_line_size INTEGER;
 77    BEGIN
 78  	 IF NVL(p_line_size, otap_constants.OTAP_REPORT_MIN_FILL_LENGTH) NOT BETWEEN otap_constants.OTAP_REPORT_MIN_FILL_LENGTH AND otap_constants.OTAP_REPORT_MAX_FILL_LENGTH
 79  	 THEN
 80  	   IF p_line_size > otap_constants.OTAP_REPORT_MAX_FILL_LENGTH
 81  	   THEN
 82  	     l_line_size := otap_constants.OTAP_REPORT_MAX_FILL_LENGTH;
 83  	   ELSE
 84  	     l_line_size := otap_constants.OTAP_REPORT_MIN_FILL_LENGTH;
 85  	   END IF;
 86  	 ELSE
 87  	   l_line_size := NVL(p_line_size, otap_constants.OTAP_REPORT_MIN_FILL_LENGTH);
 88  	 END IF;
 89  	 RETURN l_line_size;
 90    EXCEPTION
 91  	 WHEN OTHERS THEN
 92  	   otap_log.log(SQLERRM, l_script, 'Check line size constraints');
 93  	   RAISE;
 94    END check_line_size;
 95  
 96    FUNCTION check_title_size( p_title_length IN INTEGER DEFAULT 0
 97  				, p_border	 IN INTEGER DEFAULT otap_constants.OTAP_BORDER_DEFAULT
 98  				)
 99  	 RETURN NUMBER
100    IS
101  	 l_script     VARCHAR2(256) := 'otap_string.check_title_size';
102  	 l_title_size INTEGER;
103  	 l_border     INTEGER;
104    BEGIN
105  	 l_border := otap_string.check_border(p_border);
106  	 IF (NVL(p_title_length, 0) + (l_border * 2)) > otap_constants.OTAP_REPORT_MAX_FILL_LENGTH
107  	 THEN
108  	   l_title_size := otap_constants.OTAP_REPORT_MAX_FILL_LENGTH - (l_border * 2);
109  	 ELSE
110  	   l_title_size := NVL(p_title_length, 0);
111  	 END IF;
112  	 RETURN l_title_size;
113    EXCEPTION
114  	 WHEN OTHERS THEN
115  	   otap_log.log(SQLERRM, l_script, 'Check title size constraints');
116  	   RAISE;
117    END check_title_size;
