 70    FUNCTION finish_test(p_write_count_rec IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
 71  	 RETURN VARCHAR2
 72    IS
 73  	 l_message VARCHAR2(4000);
 74    BEGIN
 75  	 l_message := otap_api.finish_test(p_write_count_rec, session_record);
 76  	 RETURN l_message;
 77    EXCEPTION
 78  	 WHEN OTHERS THEN
 79  	   IF SQLCODE != -20099
 80  	   THEN
 81  	     otap_log.log(SQLERRM, 'otap_test.finish_test', 'l_message := otap_api.finish_test(p_write_count_rec, session_record)');
 82  	   END IF;
 83  	   RAISE;
 84    END finish_test;
