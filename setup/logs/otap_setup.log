276    FUNCTION set_active_report_id( p_report_id    IN 	   NUMBER
277  				    , o_otap_session IN OUT NOCOPY OTAP_SESSION
278  				    )
279  	 RETURN VARCHAR2
280    IS
281  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.set_active_report_id';
282  	 l_message VARCHAR2(4000);
283  	 l_return  NUMBER;
284  	 l_old_id  NUMBER;
285  	 l_count   NUMBER;
286    BEGIN
287  	 l_return  := 0;
288  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
289  	 -- execute the wrapped function in an extra block
290  	 BEGIN
291  	   -- save the old id for compare
292  	   l_old_id := otap_objects.otap_session_get_report_id(o_otap_session);
293  	   IF l_old_id = p_report_id
294  	   THEN
295  	     -- nothing to do
296  	     l_message := 'The report id ' || p_report_id || ' is currently active. No change.';
297  	   ELSE
298  	     -- check given id
299  	     SELECT COUNT(*) INTO l_count FROM otap_results WHERE test_session_id = p_report_id;
300  	     IF l_count > 0
301  	     THEN
302  	       l_return := otap_objects.otap_session_set_session_view_id(p_report_id, o_otap_session);
303  	     ELSE
304  	       otap_log.log('Invalid report id ' || p_report_id || ' does not exist in OTAP_RESULTS', l_script);
305  	       l_return  := l_old_id;
306  	       l_message := 'Report id ' || p_report_id || ' not found';
307  	     END IF;
308  	     IF l_return != l_old_id
309  	     THEN
310  	       l_message := 'New report id ' || l_return;
311  	     ELSE
312  	       l_message := 'ERROR report id ' || l_return || ' not changed. ' || l_message;
313  	     END IF;
314  	   END IF;
315  	 EXCEPTION
316  	   WHEN OTHERS THEN
317  	     -- consume error
318  	     otap_log.log(SQLERRM, l_script, 'Checking and calling otap_objects.otap_session_set_session_view_id');
319  	     l_message := otap_string.reduce('ERROR ' || l_script || ': ' || SQLERRM, 4000);
320  	 END;
321  	 -- return or let exception happen
322  	 RETURN l_message;
323    END set_active_report_id;
