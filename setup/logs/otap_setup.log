202    FUNCTION otap_session_set( p_test_count		IN	      NUMBER
203  				, p_test_set		IN	      VARCHAR2
204  				, p_test_group		IN	      VARCHAR2
205  				, p_test_name		IN	      VARCHAR2
206  				, p_prefix		IN	      VARCHAR2
207  				, p_name_precedence	IN	      NUMBER
208  				, p_include_pkg 	IN	      NUMBER
209  				, p_persist		IN	      NUMBER
210  				, p_schema		IN	      VARCHAR2
211  				, p_user		IN	      VARCHAR2
212  				, p_executor		IN	      VARCHAR2
213  				, o_otap_session	IN OUT NOCOPY OTAP_SESSION
214  				)
215  	 RETURN VARCHAR2
216    IS
217  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_set';
218  	 l_message   VARCHAR2(32767 CHAR);
219  	 l_delimiter VARCHAR2(1 CHAR);
220    BEGIN
221  	 -- verify the current object
222  	 otap_objects.otap_session_verify(o_otap_session);
223  	 -- now verify the input
224  	 IF    p_schema    IS NULL
225  	    OR p_user	   IS NULL
226  	    OR p_executor  IS NULL
227  	 THEN
228  	   l_message := 'ERROR otap_objects.otap_session_set. Invalid OTAP_SESSION initialization. NULL errors: ';
229  	   l_delimiter := '';
230  	   IF p_schema IS NULL
231  	   THEN
232  	     l_message := l_message || l_delimiter || 'p_schema';
233  	     l_delimiter := ',';
234  	   END IF;
235  	   IF p_user IS NULL
236  	   THEN
237  	     l_message := l_message || l_delimiter || 'p_user';
238  	     l_delimiter := ',';
239  	   END IF;
240  	   IF p_executor IS NULL
241  	   THEN
242  	     l_message := l_message || l_delimiter || 'p_executor';
243  	   END IF;
244  	   l_message := l_message || ' The variable default should never be overwritten by users.';
245  	   otap_log.log('EXCEPTION -20099 ' || l_message, l_script, 'p_schema IS NULL OR p_user IS NULL OR p_executor IS NULL');
246  	   RAISE_APPLICATION_ERROR(-20099, l_message);
247  	 END IF;
248  	 -- check prefix length
249  	 IF    LENGTH(p_prefix) <= 4
250  	    OR LENGTH(p_prefix) > 0
251  	 THEN
252  	   -- no delimiter allowed
253  	   IF REGEXP_INSTR(p_prefix, '[_|$|#]') = 0
254  	   THEN
255  	     o_otap_session.test_prefix := UPPER(TRIM(p_prefix));
256  	   ELSE
257  	     o_otap_session.test_prefix := otap_constants.OTAP_DEFAULT_PREFIX;
258  	     otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' delimiters _, $, # not allowed', l_script, 'REGEXP_INSTR(p_prefix, ''[_|$|#]'') = 0');
259  	   END IF;
260  	 ELSE
261  	   -- leave prefix as defined, log error
262  	   o_otap_session.test_prefix := otap_constants.OTAP_DEFAULT_PREFIX;
263  	   otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' length, only length 1-4 allowed', l_script, 'LENGTH(p_prefix) <= 4 OR LENGTH(p_prefix) > 0');
264  	 END IF;
265  	 -- check bool values
266  	 IF NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
267  	 THEN
268  	   o_otap_session.name_precedence := (NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) = otap_constants.OTAP_NUM_TRUE);
269  	 END IF;
270  	 IF NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
271  	 THEN
272  	   o_otap_session.include_packages := (NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
273  	 END IF;
274  	 IF NVL(p_persist, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
275  	 THEN
276  	   o_otap_session.persist_test := (NVL(p_persist, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
277  	 END IF;
278  	 -- now start setting the new values
279  	 o_otap_session.test_executor	:= p_executor;
280  	 o_otap_session.db_user 	:= p_user;
281  	 o_otap_session.db_schema	:= p_schema;
282  	 o_otap_session.intended_count	:= NVL(p_test_count, 0);
283  	 -- keep old values if not specified
284  	 o_otap_session.test_set	:= NVL(p_test_set, o_otap_session.test_set);
285  	 o_otap_session.test_group	:= NVL(p_test_group, o_otap_session.test_group);
286  	 o_otap_session.test_name	:= NVL(p_test_name, o_otap_session.test_name);
287  	 -- reset other session values
288  	 o_otap_session.test_count	:= 0;
289  	 o_otap_session.error_count	:= 0;
290  	 o_otap_session.session_start	:= SYSDATE;
291  	 o_otap_session.session_id	:= otap_test_session_seq.NEXTVAL;
292  	 -- set view id equal to session id
293  	 o_otap_session.session_view_id := o_otap_session.session_id;
294  	 l_message := otap_objects.otap_session_show(o_otap_session);
295  	 RETURN l_message;
296    EXCEPTION
297  	 WHEN OTHERS THEN
298  	   IF SQLCODE != -20099
299  	   THEN
300  	     -- log unhandled exceptions
301  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
302  	   END IF;
303  	   RAISE;
304    END otap_session_set;
