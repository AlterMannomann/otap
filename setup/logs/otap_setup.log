SQL> CREATE OR REPLACE PACKAGE BODY otap_plan
  2  AS
  3    -- for description see header file
  4    PROCEDURE write_test_result( p_test_description IN VARCHAR2
  5  				  , p_otap_session     IN OTAP_SESSION
  6  				  , p_test_passed      IN NUMBER
  7  				  , p_test_start       IN TIMESTAMP
  8  				  , p_test_end	       IN TIMESTAMP
  9  				  , p_test_errors      IN VARCHAR2
 10  				  )
 11    IS
 12  	 PRAGMA AUTONOMOUS_TRANSACTION;
 13  	 l_script	     VARCHAR2(1024 CHAR) := 'otap_plan.write_test_result';
 14  	 l_test_passed	     INTEGER;
 15  	 l_test_description  VARCHAR2(256 CHAR);
 16  	 l_errors	     VARCHAR2(4000 CHAR);
 17  	 l_to_delete	     INTEGER;
 18    BEGIN
 19  	 otap_objects.otap_session_verify(p_otap_session);
 20  	 IF LENGTH(TRIM(l_errors)) > 4000
 21  	 THEN
 22  	   l_errors := SUBSTR(TRIM(p_test_errors), 1, 4000);
 23  	 ELSE
 24  	   l_errors := TRIM(p_test_errors);
 25  	 END IF;
 26  	 IF p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 27  	 THEN
 28  	   l_test_passed := p_test_passed;
 29  	 ELSE
 30  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
 31  	   l_errors	 := SUBSTR('Invalid test passed value: ' || p_test_passed || otap_constants.OTAP_LF || l_errors, 1, 4000);
 32  	   otap_log.log('ERROR The given value for test passed ' || p_test_passed || ' for test description ' || p_test_description || ' is not valid.', l_script, 'p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)');
 33  	 END IF;
 34  	 IF p_test_description IS NULL
 35  	 THEN
 36  	   l_test_description := 'Unspecified test ' || TIMESTAMP_TO_SCN(SYSTIMESTAMP);
 37  	   l_errors	      := SUBSTR('Missing test description' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 38  	 ELSE
 39  	   IF LENGTH(p_test_description) > 256
 40  	   THEN
 41  	     l_test_description := SUBSTR(TRIM(p_test_description), 1, 256);
 42  	     l_errors		:= SUBSTR('Test description too long, cutted' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 43  	   ELSE
 44  	     l_test_description := TRIM(p_test_description);
 45  	   END IF;
 46  	 END IF;
 47  	 -- set delete flag as stored
 48  	 l_to_delete := CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_NUM_FALSE ELSE otap_constants.OTAP_NUM_TRUE END;
 49  	 -- ready to insert
 50  	 otap_results_util.write_test_result( l_to_delete
 51  					    , l_test_passed
 52  					    , p_otap_session.session_id
 53  					    , p_otap_session.test_executor
 54  					    , p_otap_session.test_set
 55  					    , p_otap_session.db_user
 56  					    , p_otap_session.db_schema
 57  					    , p_otap_session.test_group
 58  					    , p_test_start
 59  					    , p_test_end
 60  					    , p_otap_session.test_name
 61  					    , l_test_description
 62  					    , l_errors
 63  					    )
 64  	 ;
 65    EXCEPTION
 66  	 WHEN OTHERS THEN
 67  	   IF SQLCODE != -20099
 68  	   THEN
 69  	     -- log unhandled exceptions
 70  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 71  	   END IF;
 72  	   RAISE;
 73    END write_test_result;
 74  
 75    PROCEDURE write_count_result(p_otap_session IN OTAP_SESSION)
 76    IS
 77  	 l_script	     VARCHAR2(1024 CHAR) := 'otap_plan.write_count_result';
 78  	 l_test_passed	     INTEGER;
 79  	 l_test_description  VARCHAR2(256 CHAR);
 80  	 l_errors	     VARCHAR2(4000 CHAR);
 81  	 l_start	     TIMESTAMP;
 82  	 l_end		     TIMESTAMP;
 83  	 l_tmp_otap_session  OTAP_SESSION;
 84    BEGIN
 85  	 l_start := SYSTIMESTAMP;
 86  	 -- only write a record, if intended count is set, do nothing otherwise
 87  	 IF p_otap_session.intended_count > 0
 88  	 THEN
 89  	   l_test_passed      := CASE WHEN p_otap_session.test_count = p_otap_session.intended_count THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
 90  	   l_test_description := otap_string.reduce(otap_report.get_count_desc(p_otap_session.test_count, p_otap_session.intended_count), 256);
 91  	   l_errors	      := NULL;
 92  	   l_end	      := SYSTIMESTAMP;
 93  	   l_tmp_otap_session := otap_objects.otap_session_copy(p_otap_session);
 94  	   l_tmp_otap_session.test_name := otap_config_util.get_text_test_count_name;
 95  	   otap_plan.write_test_result(l_test_description, l_tmp_otap_session, l_test_passed, l_start, l_end, l_errors);
 96  	 END IF;
 97    EXCEPTION
 98  	 WHEN OTHERS THEN
 99  	   IF SQLCODE != -20099
100  	   THEN
101  	     -- log unhandled exceptions
102  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
103  	   END IF;
104  	   RAISE;
105    END write_count_result;
106  
107    FUNCTION init_test( p_test_count 	 IN	       NUMBER
108  			 , p_test_set		 IN	       VARCHAR2
109  			 , p_test_group 	 IN	       VARCHAR2
110  			 , p_test_name		 IN	       VARCHAR2
111  			 , p_prefix		 IN	       VARCHAR2
112  			 , p_name_precedence	 IN	       NUMBER
113  			 , p_include_pkg	 IN	       NUMBER
114  			 , p_persist		 IN	       NUMBER
115  			 , p_schema		 IN	       VARCHAR2
116  			 , p_user		 IN	       VARCHAR2
117  			 , p_executor		 IN	       VARCHAR2
118  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
119  			 )
120  	 RETURN VARCHAR2
121    IS
122  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.init_test';
123  	 l_message VARCHAR2(4000 CHAR);
124    BEGIN
125  	 -- if test count is not 0 this is a reset, write a test count record, if intended count is set
126  	 IF	o_otap_session.test_count      > 0
127  	    AND (   o_otap_session.intended_count  > 0
128  		 OR NVL(p_test_count, 0)	   > 0
129  		)
130  	 THEN
131  	   -- write record with current values
132  	   otap_plan.write_count_result(o_otap_session);
133  	   l_message := 'Closed test session summary' || otap_constants.OTAP_LF;
134  	   l_message := l_message || otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_LF;
135  	 END IF;
136  	 -- now start setting the new values
137  	 l_message := l_message || otap_objects.otap_session_set( p_test_count
138  								, p_test_set
139  								, p_test_group
140  								, p_test_name
141  								, p_prefix
142  								, p_name_precedence
143  								, p_include_pkg
144  								, p_persist
145  								, p_schema
146  								, p_user
147  								, p_executor
148  								, o_otap_session
149  								)
150  	 ;
151  	 RETURN l_message;
152    EXCEPTION
153  	 WHEN OTHERS THEN
154  	   IF SQLCODE != -20099
155  	   THEN
156  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
157  	   END IF;
158  	   RAISE;
159    END init_test;
160  
161    FUNCTION run_tests( p_like_expression   IN VARCHAR2 DEFAULT '%'
162  			 , p_schema_overwrite  IN VARCHAR2 DEFAULT NULL
163  			 , p_otap_session      IN OTAP_SESSION
164  			 )
165  	 RETURN VARCHAR2
166    IS
167  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.run_tests';
168  	 l_message VARCHAR2(4000 CHAR);
169  	 l_schema  VARCHAR2(128 CHAR);
170  	 l_like    VARCHAR2(256 CHAR);
171  	 l_test    VARCHAR2(257 CHAR);
172  	 CURSOR cur_tests_to_run( cp_schema IN VARCHAR2
173  				, cp_like   IN VARCHAR2
174  				)
175  	 IS
176  	   SELECT owner
177  		, object_name
178  	     FROM dba_objects
179  	    WHERE object_type	 = 'PROCEDURE'
180  	      AND owner 	 = cp_schema
181  	      AND object_name LIKE cp_like ESCAPE '\'
182  	 ;
183    BEGIN
184  	 l_schema := NVL(p_schema_overwrite, p_otap_session.db_schema);
185  	 l_like   := p_otap_session.test_prefix || '\' || otap_constants.OTAP_DEFAULT_DELIMITER || NVL(p_like_expression, '%');
186  	 -- loop over records found
187  	 FOR rec IN cur_tests_to_run(l_schema, l_like)
188  	 LOOP
189  	   NULL;
190  	 END LOOP;
191  	 RETURN l_message;
192    EXCEPTION
193  	 WHEN OTHERS THEN
194  	   IF SQLCODE != -20099
195  	   THEN
196  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
197  	   END IF;
198  	   RAISE;
199    END run_tests;
200  
201    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
202  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
203  			   )
204  	 RETURN VARCHAR2
205    IS
206  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.finish_test';
207  	 l_message VARCHAR2(4000 CHAR);
208    BEGIN
209  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
210  	 THEN
211  	   otap_plan.write_count_result(o_otap_session);
212  	 END IF;
213  	 l_message := otap_objects.otap_session_finish(o_otap_session);
214  	 RETURN l_message;
215    EXCEPTION
216  	 WHEN OTHERS THEN
217  	   IF SQLCODE != -20099
218  	   THEN
219  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
220  	   END IF;
221  	   RAISE;
222    END finish_test;
223  
224  END;
225  /

