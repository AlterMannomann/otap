 36    FUNCTION flatten( p_string VARCHAR2 DEFAULT NULL
 37  		       , p_size   INTEGER  DEFAULT 0
 38  		       )
 39  	 RETURN VARCHAR2
 40    IS
 41  	 l_script VARCHAR2(256 CHAR) := 'otap_string.flatten';
 42  	 l_string VARCHAR2(32767 CHAR);
 43    BEGIN
 44  	 l_string := REGEXP_REPLACE(p_string, '\s{2,}', ' ');
 45  	 l_string := CASE WHEN LENGTH(l_string) > p_size THEN SUBSTR(l_string, 1, p_size) ELSE l_string END;
 46  	 RETURN l_string;
 47    EXCEPTION
 48  	 WHEN OTHERS THEN
 49  	   otap_log.log(SQLERRM, l_script, 'Flatten and cut the given string, remove useless white space chars');
 50  	   RAISE;
 51    END flatten;
