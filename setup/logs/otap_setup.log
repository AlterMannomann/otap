201    FUNCTION right_deco( p_title_length IN INTEGER  DEFAULT 0
202  			  , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_REPORT_MIN_FILL_LENGTH
203  			  , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FORMAT_NAME_CHAR
