163    FUNCTION is_eq( p_have		 IN	       VARCHAR2
164  		     , p_want		 IN	       VARCHAR2
165  		     , o_errors 	    OUT NOCOPY VARCHAR2
166  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
167  		     )
168  	 RETURN INTEGER
169    IS
170  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.is_eq';
171  	 l_test_passed	 INTEGER;
172  	 l_result	 INTEGER;
173  	 l_expected	 INTEGER;
174    BEGIN
175  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
176  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
177  	 IF p_want IS NOT NULL
178  	 THEN
179  	   IF p_have IS NOT NULL
180  	   THEN
181  	     l_result := CASE WHEN p_have = p_want THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
182  	   ELSE
183  	     l_result := otap_constants.OTAP_NUM_TEST_FAILED;
184  	   END IF;
185  	 ELSE
186  	   -- compare against NULL, p_want already checked
187  	   l_result := CASE WHEN p_have IS NULL THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
188  	 END IF;
189  	 l_test_passed := CASE WHEN l_expected = l_result THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
190  	 -- we expect currently no usage error only raise
191  	 o_errors      := NULL;
192  	 RETURN l_test_passed;
193    EXCEPTION
194  	 WHEN OTHERS THEN
195  	   IF SQLCODE != -20099
196  	   THEN
197  	     -- log unhandled exceptions
198  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' varchar2 call');
199  	   END IF;
200  	   RAISE;
201    END is_eq; -- VARCHAR2
