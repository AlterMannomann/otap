349    FUNCTION alike( p_have		 IN	       VARCHAR2
350  		     , p_like		 IN	       VARCHAR2
351  		     , o_errors 	    OUT NOCOPY VARCHAR2
352  		     , p_case_sensitive  IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_FALSE
353  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
354  		     )
355  	 RETURN INTEGER
356    IS
357  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.alike';
358  	 l_test_passed	 INTEGER;
359  	 l_count	 INTEGER;
360  	 l_expected	 INTEGER;
361  	 l_like 	 VARCHAR2(32767 CHAR);
362  	 l_have 	 VARCHAR2(32767 CHAR);
363  	 l_errors	 VARCHAR2(32767 CHAR);
364    BEGIN
365  	 l_errors      := NULL;
366  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
367  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
368  	 l_like        := CASE WHEN p_case_sensitive = otap_constants.OTAP_NUM_TRUE THEN p_like ELSE UPPER(p_like) END;
369  	 l_have        := CASE WHEN p_case_sensitive = otap_constants.OTAP_NUM_TRUE THEN p_have ELSE UPPER(p_have) END;
370  	 IF p_like IS NOT NULL
371  	 THEN
372  	   -- leave fail on LIKE if p_have is NULL
373  	   SELECT COUNT(*) INTO l_count FROM dual WHERE l_have LIKE l_like;
374  	   l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
375  	 ELSE
376  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
377  	   l_errors	 := 'Not allowed: p_like(NULL)';
378  	   -- log error
379  	   otap_log.log(l_errors, l_script);
380  	 END IF;
381  	 -- now decide on the expected result the final state and if errors are returned
382  	 IF l_test_passed != l_expected
383  	 THEN
384  	   o_errors := otap_string.reduce(l_errors, 4000);
385  	 ELSE
386  	   -- overwrite states from before, as we fulfill expected
387  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
388  	   -- overwrite errors expected
389  	   o_errors := NULL;
390  	 END IF;
391  	 RETURN l_test_passed;
392    EXCEPTION
393  	 WHEN OTHERS THEN
394  	   IF SQLCODE != -20099
395  	   THEN
396  	     -- log unhandled exceptions
397  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
398  	   END IF;
399  	   RAISE;
400    END alike;
