427    FUNCTION otap_session_get_test_id(p_otap_session IN OTAP_SESSION)
428  	 RETURN NUMBER
429    IS
430  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_get_test_id';
431    BEGIN
432  	 otap_objects.otap_session_verify(p_otap_session);
433  	 RETURN p_otap_session.session_id;
434    EXCEPTION
435  	 WHEN OTHERS THEN
436  	   IF SQLCODE != -20099
437  	   THEN
438  	     -- log unhandled exceptions
439  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
440  	   END IF;
441  	   RAISE;
442    END otap_session_get_test_id;
443  
444    PROCEDURE otap_session_add_test( p_test_passed  IN NUMBER
445  				      , o_otap_session IN OUT NOCOPY OTAP_SESSION
446  				      )
447    IS
448  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_add_test';
449    BEGIN
450  	 otap_objects.otap_session_verify(o_otap_session);
451  	 o_otap_session.test_count := o_otap_session.test_count + 1;
452  	 IF p_test_passed != otap_constants.OTAP_NUM_TEST_PASSED
453  	 THEN
454  	   o_otap_session.error_count := o_otap_session.error_count + 1;
455  	 END IF;
456    EXCEPTION
457  	 WHEN OTHERS THEN
458  	   IF SQLCODE != -20099
459  	   THEN
460  	     -- log unhandled exceptions
461  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
462  	   END IF;
463  	   RAISE;
464    END otap_session_add_test;
465  
466    FUNCTION otap_session_summary(p_otap_session IN OTAP_SESSION)
467  	 RETURN VARCHAR2
468    IS
469  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_summary';
470  	 l_message VARCHAR2(4000);
471    BEGIN
472  	 otap_objects.otap_session_verify(p_otap_session);
473  	 l_message := otap_string.reduce( 'Summary id: ' || TRIM(TO_CHAR(p_otap_session.session_id)) ||
474  					  ' tests: ' || TRIM(TO_CHAR(p_otap_session.test_count)) ||
475  					  CASE WHEN p_otap_session.intended_count > 0 THEN ' from ' || TRIM(TO_CHAR(p_otap_session.intended_count)) END ||
476  					  ' errors: ' || TRIM(TO_CHAR(p_otap_session.error_count)) ||
477  					  ' run time: ' || TRIM(TO_CHAR(((SYSDATE - p_otap_session.session_start) DAY TO SECOND))) ||
478  					  ' started: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
479  					, 4000
480  					)
481  	 ;
482  	 RETURN l_message;
483    EXCEPTION
484  	 WHEN OTHERS THEN
485  	   IF SQLCODE != -20099
486  	   THEN
487  	     -- log unhandled exceptions
488  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
489  	   END IF;
490  	   RAISE;
491    END otap_session_summary;
492  
493    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
494  	 RETURN VARCHAR2
495    IS
496  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_finish';
497  	 l_message VARCHAR2(4000);
498    BEGIN
499  	 -- object gets verified by summary for old session
500  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_LF;
501  	 -- reset values
502  	 o_otap_session.test_count     := 0;
503  	 o_otap_session.error_count    := 0;
504  	 o_otap_session.intended_count := 0;
505  	 o_otap_session.test_set       := otap_constants.OTAP_DEFAULT_TEST_SET;
506  	 o_otap_session.test_group     := otap_constants.OTAP_DEFAULT_TEST_GROUP;
507  	 o_otap_session.test_name      := otap_constants.OTAP_DEFAULT_TEST_NAME;
508  	 o_otap_session.session_start  := SYSDATE;
509  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
510  	 -- do not update the session_view_id so it will keep the old or any set value
511  	 -- every init will set the session_view_id to the current session id
512  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
513  	 RETURN l_message;
514    EXCEPTION
515  	 WHEN OTHERS THEN
516  	   IF SQLCODE != -20099
517  	   THEN
518  	     -- log unhandled exceptions
519  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
520  	   END IF;
521  	   RAISE;
522    END otap_session_finish;
523  
524  END;
525  /

