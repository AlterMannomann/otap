 95    * @exception -20099 Internal error, invalid OTAP_SESSION object.
 96    */
 97    FUNCTION otap_session_set_test_set( p_test_set	  IN		VARCHAR2
 98  					 , o_otap_session IN OUT NOCOPY OTAP_SESSION
 99  					 )
100  	 RETURN VARCHAR2
101    ;
102  
