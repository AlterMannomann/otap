492    FUNCTION get_exists_msg( p_object_name IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
493  			      , p_schema_name IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
494  			      , p_object_type IN VARCHAR2 DEFAULT NULL
495  			      , p_sub_object  IN VARCHAR2 DEFAULT NULL
496  			      , p_test_desc   IN VARCHAR2 DEFAULT NULL
497  			      )
498  	 RETURN VARCHAR2
499    IS
500  	 l_template_text VARCHAR2(32767 CHAR); -- '@type@ @object@ exists check (@schema@)'
501    BEGIN
502  	 IF p_sub_object IS NOT NULL
503  	 THEN
504  	   l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_XEXISTS
505  						 , p_type_label => p_object_type
506  						 , p_param1 => '@object@'
507  						 , p_param1_value => p_object_name
508  						 , p_param2 => '@schema@'
509  						 , p_param2_value => p_schema_name
510  						 , p_param3 => '@subobject@'
511  						 , p_param3_value => p_sub_object
512  						 , p_description => p_test_desc
513  						 )
514  	   ;
515  	 ELSE
516  	   l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_EXISTS
517  						 , p_type_label => p_object_type
518  						 , p_param1 => '@object@'
519  						 , p_param1_value => p_object_name
520  						 , p_param2 => '@schema@'
521  						 , p_param2_value => p_schema_name
522  						 , p_description => p_test_desc
523  						 )
524  	   ;
525  	 END IF;
526  	 RETURN l_template_text;
527    EXCEPTION
528  	 WHEN OTHERS THEN
529  	   otap_log.log(SQLERRM, 'otap_report.get_exists_msg', 'Build exists result message');
530  	   RAISE;
531    END get_exists_msg;
