324  			    , p_required_user IN VARCHAR2 DEFAULT NULL
325  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
326  			    , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
327  			    , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
328  			    )
329  	 RETURN otap_view_result_tbl PIPELINED
330    ;
