SQL> CREATE OR REPLACE PACKAGE BODY otap_plan
  2  AS
  3    -- for description see header file
  4    PROCEDURE write_test_result( p_test_description IN VARCHAR2
  5  				  , p_otap_session     IN OTAP_SESSION
  6  				  , p_test_passed      IN NUMBER
  7  				  , p_test_start       IN TIMESTAMP
  8  				  , p_test_end	       IN TIMESTAMP
  9  				  , p_test_errors      IN VARCHAR2
 10  				  )
 11    IS
 12  	 PRAGMA AUTONOMOUS_TRANSACTION;
 13  	 l_script	     VARCHAR2(1024) := 'otap_plan.write_test_result';
 14  	 l_test_passed	     INTEGER;
 15  	 l_test_description  VARCHAR2(256);
 16  	 l_errors	     VARCHAR2(4000);
 17  	 l_to_delete	     INTEGER;
 18    BEGIN
 19  	 otap_objects.otap_session_verify(p_otap_session);
 20  	 IF LENGTH(TRIM(l_errors)) > 4000
 21  	 THEN
 22  	   l_errors := SUBSTR(TRIM(p_test_errors), 1, 4000);
 23  	 ELSE
 24  	   l_errors := TRIM(p_test_errors);
 25  	 END IF;
 26  	 IF p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 27  	 THEN
 28  	   l_test_passed := p_test_passed;
 29  	 ELSE
 30  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
 31  	   l_errors	 := SUBSTR('Invalid test passed value: ' || p_test_passed || otap_constants.OTAP_LF || l_errors, 1, 4000);
 32  	   otap_log.log('ERROR The given value for test passed ' || p_test_passed || ' for test description ' || p_test_description || ' is not valid.', l_script, 'p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)');
 33  	 END IF;
 34  	 IF p_test_description IS NULL
 35  	 THEN
 36  	   l_test_description := 'Unspecified test ' || TIMESTAMP_TO_SCN(SYSTIMESTAMP);
 37  	   l_errors	      := SUBSTR('Missing test description' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 38  	 ELSE
 39  	   IF LENGTH(p_test_description) > 256
 40  	   THEN
 41  	     l_test_description := SUBSTR(TRIM(p_test_description), 1, 256);
 42  	     l_errors		:= SUBSTR('Test description too long, cutted' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 43  	   ELSE
 44  	     l_test_description := TRIM(p_test_description);
 45  	   END IF;
 46  	 END IF;
 47  	 -- set delete flag as stored
 48  	 l_to_delete := CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_NUM_FALSE ELSE otap_constants.OTAP_NUM_TRUE END;
 49  	 -- ready to insert
 50  	 otap_results_util.write_test_result( l_to_delete
 51  					    , l_test_passed
 52  					    , p_otap_session.session_id
 53  					    , p_otap_session.test_executor
 54  					    , p_otap_session.test_set
 55  					    , p_otap_session.db_user
 56  					    , p_otap_session.db_schema
 57  					    , p_otap_session.test_group
 58  					    , p_test_start
 59  					    , p_test_end
 60  					    , p_otap_session.test_name
 61  					    , l_test_description
 62  					    , l_errors
 63  					    )
 64  	 ;
 65    EXCEPTION
 66  	 WHEN OTHERS THEN
 67  	   IF SQLCODE != -20099
 68  	   THEN
 69  	     -- log unhandled exceptions
 70  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 71  	   END IF;
 72  	   RAISE;
 73    END write_test_result;
 74  
 75    PROCEDURE write_count_result(p_otap_session IN OTAP_SESSION)
 76    IS
 77  	 l_script	     VARCHAR2(1024) := 'otap_plan.write_count_result';
 78  	 l_test_passed	     INTEGER;
 79  	 l_test_description  VARCHAR2(256);
 80  	 l_errors	     VARCHAR2(4000);
 81  	 l_start	     TIMESTAMP;
 82  	 l_end		     TIMESTAMP;
 83    BEGIN
 84  	 l_start := SYSTIMESTAMP;
 85  	 -- only write a record, if intended count is set, do nothing otherwise
 86  	 IF p_otap_session.intended_count > 0
 87  	 THEN
 88  	   l_test_passed      := CASE WHEN p_otap_session.test_count = p_otap_session.intended_count THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
 89  	   l_test_description := 'Run ' || p_otap_session.test_count || ' of ' || p_otap_session.intended_count || ' tests, this test excluded';
 90  	   l_errors	      := NULL;
 91  	   l_end	      := SYSTIMESTAMP;
 92  	   otap_plan.write_test_result(l_test_description, p_otap_session, l_test_passed, l_start, l_end, l_errors);
 93  	 END IF;
 94    EXCEPTION
 95  	 WHEN OTHERS THEN
 96  	   IF SQLCODE != -20099
 97  	   THEN
 98  	     -- log unhandled exceptions
 99  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
100  	   END IF;
101  	   RAISE;
102    END write_count_result;
103  
104    FUNCTION init_test( p_test_count 	 IN	       NUMBER
105  			 , p_test_set		 IN	       VARCHAR2
106  			 , p_test_group 	 IN	       VARCHAR2
107  			 , p_test_name		 IN	       VARCHAR2
108  			 , p_prefix		 IN	       VARCHAR2
109  			 , p_name_precedence	 IN	       NUMBER
110  			 , p_include_pkg	 IN	       NUMBER
111  			 , p_persist		 IN	       NUMBER
112  			 , p_schema		 IN	       VARCHAR2
113  			 , p_user		 IN	       VARCHAR2
114  			 , p_executor		 IN	       VARCHAR2
115  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
116  			 )
117  	 RETURN VARCHAR2
118    IS
119  	 l_script  VARCHAR2(1024) := 'otap_plan.init_test';
120  	 l_message VARCHAR2(4000);
121    BEGIN
122  	 -- if test count is not 0 this is a reset, write a test count record, if intended count is set
123  	 IF	o_otap_session.test_count      > 0
124  	    AND (   o_otap_session.intended_count  > 0
125  		 OR NVL(p_test_count, 0)	   > 0
126  		)
127  	 THEN
128  	   -- write record with current values
129  	   otap_plan.write_count_result(o_otap_session);
130  	   l_message := 'Closed test session summary' || otap_constants.OTAP_LF;
131  	   l_message := l_message || otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_LF;
132  	 END IF;
133  	 -- now start setting the new values
134  	 l_message := l_message || otap_objects.otap_session_set( p_test_count
135  								, p_test_set
136  								, p_test_group
137  								, p_test_name
138  								, p_prefix
139  								, p_name_precedence
140  								, p_include_pkg
141  								, p_persist
142  								, p_schema
143  								, p_user
144  								, p_executor
145  								, o_otap_session
146  								)
147  	 ;
148  	 RETURN l_message;
149    EXCEPTION
150  	 WHEN OTHERS THEN
151  	   IF SQLCODE != -20099
152  	   THEN
153  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
154  	   END IF;
155  	   RAISE;
156    END init_test;
157  
158    FUNCTION run_tests( p_like_expression   IN VARCHAR2 DEFAULT '%'
159  			 , p_schema_overwrite  IN VARCHAR2 DEFAULT NULL
160  			 , p_otap_session      IN OTAP_SESSION
161  			 )
162  	 RETURN VARCHAR2
163    IS
164  	 l_script  VARCHAR2(1024) := 'otap_plan.run_tests';
165  	 l_message VARCHAR2(4000);
166  	 l_schema  VARCHAR2(128);
167  	 l_like    VARCHAR2(256);
168  	 l_test    VARCHAR2(257);
169  	 CURSOR cur_tests_to_run( cp_schema IN VARCHAR2
170  				, cp_like   IN VARCHAR2
171  				)
172  	 IS
173  	   SELECT owner
174  		, object_name
175  	     FROM dba_objects
176  	    WHERE object_type	 = 'PROCEDURE'
177  	      AND owner 	 = cp_schema
178  	      AND object_name LIKE cp_like ESCAPE '\'
179  	 ;
180    BEGIN
181  	 l_schema := NVL(p_schema_overwrite, p_otap_session.db_schema);
182  	 l_like   := p_otap_session.test_prefix || '\' || otap_constants.OTAP_DEFAULT_DELIMITER || NVL(p_like_expression, '%');
183  	 -- loop over records found
184  	 FOR rec IN cur_tests_to_run(l_schema, l_like)
185  	 LOOP
186  	   NULL;
187  	 END LOOP;
188  	 RETURN l_message;
189    EXCEPTION
190  	 WHEN OTHERS THEN
191  	   IF SQLCODE != -20099
192  	   THEN
193  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
194  	   END IF;
195  	   RAISE;
196    END run_tests;
197  
198    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
199  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
200  			   )
201  	 RETURN VARCHAR2
202    IS
203  	 l_script  VARCHAR2(1024) := 'otap_plan.finish_test';
204  	 l_message VARCHAR2(4000);
205    BEGIN
206  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
207  	 THEN
208  	   otap_plan.write_count_result(o_otap_session);
209  	 END IF;
210  	 l_message := otap_objects.otap_session_finish(o_otap_session);
211  	 RETURN l_message;
212    EXCEPTION
213  	 WHEN OTHERS THEN
214  	   IF SQLCODE != -20099
215  	   THEN
216  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
217  	   END IF;
218  	   RAISE;
219    END finish_test;
220  
221  END;
222  /

