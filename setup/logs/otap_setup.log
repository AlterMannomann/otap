 88    FUNCTION result_view(p_session_id IN NUMBER)
 89  	 RETURN otap_view_result_tbl PIPELINED
 90    IS
 91  	 l_delim_updown VARCHAR2(1 CHAR) := '=';
 92  	 l_delim_tests	VARCHAR2(1 CHAR) := '-';
 93  	 l_text_column	VARCHAR2(4000 CHAR);
 94  	 l_has_errors	INTEGER;
 95  	 l_has_records	INTEGER;
 96  	 l_report_size	INTEGER;
 97  	 CURSOR cur_test_sets(cp_session_id IN NUMBER)
 98  	 IS
 99  	   SELECT test_set
100  		, COUNT(*) AS test_runs
101  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
102  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
103  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
104  	     FROM otap_results
105  	    WHERE test_session_id = cp_session_id
106  	      AND test_name	 != otap_api.get_text_test_count_name
107  	    GROUP BY test_set
108  	    ORDER BY MIN(test_run_date)
109  	 ;
110  	 CURSOR cur_test_groups( cp_session_id IN NUMBER
111  			       , cp_test_set   IN VARCHAR2
112  			       )
113  	 IS
114  	   SELECT test_group
115  		, COUNT(*) AS test_runs
116  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
117  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
118  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
119  	     FROM otap_results
120  	    WHERE test_session_id = cp_session_id
121  	      AND test_set	  = cp_test_set
122  	      AND test_name	 != otap_api.get_text_test_count_name
123  	    GROUP BY test_group
124  	    ORDER BY MIN(test_run_date)
125  	 ;
126  	 CURSOR cur_test_names( cp_session_id IN NUMBER
127  			      , cp_test_set   IN VARCHAR2
128  			      , cp_test_group IN VARCHAR2
129  			      )
130  	 IS
131  	   SELECT test_name
132  		, COUNT(*) AS test_runs
133  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
134  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
135  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
136  	     FROM otap_results
137  	    WHERE test_session_id = cp_session_id
138  	      AND test_set	  = cp_test_set
139  	      AND test_group	  = cp_test_group
140  	      AND test_name	 != otap_api.get_text_test_count_name
141  	    GROUP BY test_name
142  	    ORDER BY MIN(test_run_date)
143  	 ;
144  	 CURSOR cur_test_count(cp_session_id IN NUMBER)
145  	 IS
146  	   SELECT test_name
147  		, COUNT(*) AS test_runs
148  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
149  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
150  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
151  	     FROM otap_results
152  	    WHERE test_session_id = cp_session_id
153  	      AND test_name	  = otap_api.get_text_test_count_name
154  	    GROUP BY test_name
155  	    ORDER BY MIN(test_run_date)
156  	 ;
157  	 CURSOR cur_session_total(cp_session_id IN NUMBER)
158  	 IS
159  	   SELECT test_session_id
160  		, COUNT(DISTINCT test_set) AS test_sets
161  		, COUNT(DISTINCT test_group) AS test_groups
162  		, COUNT(DISTINCT test_name) AS test_names
163  		, COUNT(DISTINCT test_desc) AS test_descs
164  		, COUNT(*) AS test_runs
165  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
166  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
167  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
168  	     FROM otap_results
169  	    WHERE test_session_id = cp_session_id
170  		  -- exclude optional extra total count test
171  	      AND test_name	 != otap_api.get_text_test_count_name
172  	    GROUP BY test_session_id
173  	    ORDER BY MIN(test_run_date)
174  	 ;
175  	 CURSOR cur_tests( cp_session_id IN NUMBER
176  			 , cp_test_set	 IN VARCHAR2
177  			 , cp_test_group IN VARCHAR2
178  			 , cp_test_name  IN VARCHAR2
179  			 )
180  	 IS
181  	   SELECT test_desc
182  		, test_passed
183  		, otap_api.test_result_to_text(test_passed) AS test_state
184  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
185  		, test_errors
186  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
187  	     FROM otap_results
188  	    WHERE test_session_id = cp_session_id
189  	      AND test_set	  = cp_test_set
190  	      AND test_group	  = cp_test_group
191  	      AND test_name	  = cp_test_name
192  	    ORDER BY test_run_date
193  	 ;
194  	 CURSOR cur_count_tests( cp_session_id IN NUMBER
195  			       , cp_test_name  IN VARCHAR2
196  			       )
197  	 IS
198  	   SELECT test_desc
199  		, test_passed
200  		, otap_api.test_result_to_text(test_passed) AS test_state
201  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
202  		, test_errors
203  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
204  	     FROM otap_results
205  	    WHERE test_session_id = cp_session_id
206  	      AND test_name	  = cp_test_name
207  	    ORDER BY test_run_date
208  	 ;
209    BEGIN
210  	 l_report_size := otap_api.max_text_size(p_session_id);
211  	 -- header row
212  	 l_text_column := otap_api.get_report_header(l_report_size);
213  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
214  	 l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
215  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
216  	 -- check for records
217  	 SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
218  	 IF l_has_records > 0
219  	 THEN
220  	   -- loop through the set
221  	   FOR rec_set IN cur_test_sets(p_session_id)
222  	   LOOP
223  	     -- build test set column
224  	     l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size);
225  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
226  	     -- build test set summary
227  	     l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size);
228  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
229  	     -- loop through the group
230  	     FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set)
231  	     LOOP
232  	       l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size);
233  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
234  	       -- build test set summary
235  	       l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size);
236  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
237  	       -- loop through the names
238  	       FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group)
239  	       LOOP
240  		 l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size);
241  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
242  		 -- build test set summary
243  		 l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size);
244  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
245  		 -- build header
246  		 l_text_column := otap_api.get_result_header(l_report_size);
247  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
248  		 l_text_column := otap_api.get_result_underline(l_report_size);
249  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
250  		 -- loop through the tests
251  		 FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
252  		 LOOP
253  		   l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
254  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
255  		 END LOOP;
256  		 SELECT COUNT(*)
257  		   INTO l_has_errors
258  		   FROM otap_results
259  		  WHERE test_session_id = p_session_id
260  		    AND test_set	= rec_set.test_set
261  		    AND test_group	= rec_grp.test_group
262  		    AND test_name	= rec_nam.test_name
263  		    AND test_errors    IS NOT NULL
264  		 ;
265  		 IF l_has_errors > 0
266  		 THEN
267  		   -- build error delimiter for tests
268  		   l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size);
269  		   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
270  		   FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
271  		   LOOP
272  		     IF rec_tst.test_errors IS NOT NULL
273  		     THEN
274  		       l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
275  		       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
276  		     END IF;
277  		   END LOOP;
278  		 END IF;
279  	       END LOOP;
280  	     END LOOP;
281  	   END LOOP;
282  	   -- no loop through the test count if exists
283  	   FOR rec IN cur_test_count(p_session_id)
284  	   LOOP
285  	     -- build header
286  	     l_text_column := otap_api.get_test_count_header(l_report_size);
287  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
288  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
289  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
290  	     -- build header
291  	     l_text_column := otap_api.get_result_header(l_report_size);
292  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
293  	     l_text_column := otap_api.get_result_underline(l_report_size);
294  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
295  	     -- loop through the tests
296  	     FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
297  	     LOOP
298  	       l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
299  	       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
300  	     END LOOP;
301  	     SELECT COUNT(*)
302  	       INTO l_has_errors
303  	       FROM otap_results
304  	      WHERE test_session_id = p_session_id
305  		AND test_name	    = rec.test_name
306  		AND test_errors    IS NOT NULL
307  	     ;
308  	     IF l_has_errors > 0
309  	     THEN
310  	       -- build error delimiter for tests
311  	       l_text_column := otap_api.get_error_result_header(rec.test_name, l_report_size);
312  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
313  	       FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
314  	       LOOP
315  		 IF rec_tst.test_errors IS NOT NULL
316  		 THEN
317  		   l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
318  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
319  		 END IF;
320  	       END LOOP;
321  	     END IF;
322  	   END LOOP;
323  	   -- eventually build the totals for the test session
324  	   l_text_column := otap_api.get_report_total(l_report_size);
325  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
326  	   FOR rec IN cur_session_total(p_session_id)
327  	   LOOP
328  	     l_text_column := otap_api.get_report_total_details(rec.test_sets, rec.test_groups, rec.test_names, rec.test_descs, l_report_size);
329  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
330  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
331  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
332  	   END LOOP;
333  	 ELSE
334  	   l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size);
335  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
336  	 END IF;
337  	 -- footer row
338  	 l_text_column := otap_api.get_report_footer(l_report_size);
339  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
340  	 -- add AI and copyright
341  	 l_text_column := LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
342  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
343  	 l_text_column := LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
344  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
345  	 l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT1;
346  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
347  	 l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT2;
348  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
349  	 l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT3;
350  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
351  	 RETURN;
352    EXCEPTION
353  	 WHEN NO_DATA_NEEDED THEN
354  	   RAISE;
355  	 WHEN OTHERS THEN
356  	   IF SQLCODE != -20099
357  	   THEN
