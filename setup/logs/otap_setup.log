166    /** FUNCTION otap_objects.otap_session_summary
167    * Gets a current summary from OTAP_SESSION object. Lists session id, session start, test runs and errors.
168    *
169    * @param p_otap_session The current session_record from OTAP_TEST package.
170    *
171    * @return The current test session summary as text.
172    *
173    * @exception -20099 Internal error, invalid OTAP_SESSION object.
174    */
175    FUNCTION otap_session_summary(p_otap_session IN OTAP_SESSION)
176  	 RETURN VARCHAR2
177    ;
178  
179    /** FUNCTION otap_objects.otap_session_finish
180    * Resets the OTAP_SESSION object. Will set a new session id, reset the counters and the names
181    * for test set, group and name. When a test session is finished, the test session view will not
182    * longer show the tests from the old session.
183    *
184    * @param o_otap_session The current session_record from OTAP_TEST package.
185    *
186    * @return A summary of the old session and details of the new session as text message LF delimited.
187    *
188    * @exception -20099 Internal error, invalid OTAP_SESSION object.
189    */
190    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
191  	 RETURN VARCHAR2
192    ;
193  
194  END;
