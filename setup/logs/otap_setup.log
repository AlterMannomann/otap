179    /** FUNCTION otap_generate.prepare
180    * Maps the schema, object type and object to set, group and name, including the prefix, which prefixes the
181    * set without delimiter and returns the function/procedure name for this mapping.
182    *
183    * If p_object_type is empty, p_object is not used at all and o_name is set to NULL. Only NOT NULL values included.
184    *
185    * The prefix gets cutted to max. 10 chars. Set, group and name are reduced to max. 30 chars. Delimiters are removed.
186    *
187    * @param p_title_prefix An optional title prefix. For function names cutted to 10 chars.
188    * @param p_schema The schema to use for set. For function names cutted to 30 chars.
189    * @param p_object_type The object type to use for group like tables, trigger and so on. For function names cutted to 30 chars.
190    * @param p_object The object name to use for name. For function names cutted to 30 chars.
191    * @param o_set The test set from schema and prefix. Limited to 256 chars.
192    * @param o_group The test group from object type. Limited to 256 chars.
193    * @param o_name The test name from object name. Limited to 256 chars.
194    *
195    * @return A valid function/procedure name of pattern test_(p_title_prefix)<o_set>(_<o_group>(_<o_name>)) with maximum length 128.
196    */
197    FUNCTION prepare( p_title_prefix IN	       VARCHAR2
198  		       , p_schema	IN	       VARCHAR2
199  		       , p_object_type	IN	       VARCHAR2
200  		       , p_object	IN	       VARCHAR2
201  		       , o_set		   OUT NOCOPY  VARCHAR2
202  		       , o_group	   OUT NOCOPY  VARCHAR2
203  		       , o_name 	   OUT NOCOPY  VARCHAR2
204  		       )
205  	 RETURN VARCHAR2
206    ;
