SQL> CREATE OR REPLACE PACKAGE otap_constants
  2  AS
  3    /**
  4    * This package contains all application wide constants needed by otap. Every constant can be accessed via PL/SQL.
  5    * Some constants provide a get function for use in SQL statements.
  6    * This package is available to the otap user role defined in otap_setup_def.sql.
  7    */
  8  
  9    /*====================================== start package constants used by otap ======================================*/
 10  
 11    -- the following constants have get functions that can be used in SQL selects
 12    OTAP_INTERNAL_VERSION_NR CONSTANT CHAR(14)	     := 'v1.0.0-alpha.1';
 13    OTAP_INTERNAL_NAME	CONSTANT CHAR(38)	     := 'otap - Oracle Test Automation Protocol';
 14    OTAP_INTERNAL_COPYRIGHT1 CONSTANT CHAR(80)	     := '(C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
 15    OTAP_INTERNAL_COPYRIGHT2 CONSTANT CHAR(54)	     := 'and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
 16    OTAP_INTERNAL_COPYRIGHT3 CONSTANT CHAR(76)	     := 'Not allowed to be used as AI training material without explicite permission.';
 17    -- we do not know the size of the setup configuration variable, this can be used as a string size attack, package will
 18    -- fail being created. otap can't handle this, must rely on Oracle (hard to believe). Nevertheless names currently
 19    -- (until Oracle 23i) are limited to 128 chars.
 20    OTAP_INTERNAL_USER_ROLE	CONSTANT VARCHAR2(128 CHAR)  := '&OTAP_ROLE';
 21    OTAP_INTERNAL_SCHEMA	CONSTANT VARCHAR2(128 CHAR)  := '&OTAP_USER';
 22    OTAP_INTERNAL_TABLESPACE CONSTANT VARCHAR2(128 CHAR)  := '&OTAP_TABLESPACE';
 23    OTAP_NUM_TRUE		CONSTANT INTEGER	     := 1;
 24    OTAP_NUM_FALSE		CONSTANT INTEGER	     := 0;
 25    OTAP_NUM_TEST_PASSED	CONSTANT INTEGER	     := 1;
 26    OTAP_NUM_TEST_FAILED	CONSTANT INTEGER	     := -1;
 27    OTAP_NUM_TEST_UNDEFINED	CONSTANT INTEGER	     := 0;
 28    OTAP_NUM_MIN_FILL_LENGTH CONSTANT INTEGER	     := 80;
 29    OTAP_NUM_MAX_FILL_LENGTH CONSTANT INTEGER	     := 4000;
 30    -- default fix name delimiter, $ and # are not recommended by Oracle and therefore not configurable
 31    OTAP_INTERNAL_DELIMITER	CONSTANT CHAR(1)	     := '_';
 32    OTAP_INTERNAL_ERROR	CONSTANT CHAR(10)	     := 'OTAP_ERROR';
 33    OTAP_INTERNAL_NA 	CONSTANT CHAR(3)	     := 'N/A';
 34    OTAP_INTERNAL_VAR	CONSTANT CHAR(1)	     := '@';
 35    OTAP_CONFIG_TYPE_NUMBER	CONSTANT CHAR(6)	     := 'NUMBER';
 36    OTAP_CONFIG_TYPE_CHAR	CONSTANT CHAR(4)	     := 'CHAR';
 37  
 38    -- no get functions for the following constants
 39    -- internal otap constants only usable within PLSQL
 40    OTAP_INTERNAL_LF 		   CONSTANT CHAR(1)	   := CHR(10);
 41    OTAP_NUM_PREFIX_MAX_SIZE 	   CONSTANT INTEGER	   := 4;
 42    OTAP_LAYOUT_RIGHT		   CONSTANT CHAR(1)	   := 'R';
 43    OTAP_LAYOUT_MIDDLE		   CONSTANT CHAR(1)	   := 'M';
 44    OTAP_LAYOUT_LEFT 		   CONSTANT CHAR(1)	   := 'L';
 45    OTAP_LABEL_UPPER 		   CONSTANT CHAR(1)	   := 'U';
 46    OTAP_LABEL_LOWER 		   CONSTANT CHAR(1)	   := 'L';
 47    OTAP_LABEL_INIT_CAP		   CONSTANT CHAR(1)	   := 'I';
 48    OTAP_TYPE_VAR			   CONSTANT CHAR(6)	   := '@type@';
 49    -- otap log needs to know the debug mode access name, therefore in otap_constants, other access identifiers are in otap_util
 50    OTAP_CFG_DEBUG_MODE		   CONSTANT CHAR(10)	   := 'DEBUG_MODE';
 51    -- fallback constants for access failure situations, defaults and checks
 52    OTAP_FALLBACK_BORDER		   CONSTANT INTEGER	   := 5;
 53    OTAP_FALLBACK_BORDER_MIN 	   CONSTANT INTEGER	   := 2;
 54    OTAP_FALLBACK_BORDER_MAX 	   CONSTANT INTEGER	   := 10;
 55    OTAP_FALLBACK_PRESERVE_DAYS	   CONSTANT INTEGER	   := 1;
 56    OTAP_FALLBACK_PRESERVE_DAYS_MIN	   CONSTANT INTEGER	   := 1;
 57    OTAP_FALLBACK_PRESERVE_DAYS_MAX	   CONSTANT INTEGER	   := 7;
 58    OTAP_FALLBACK_DELETE_DELAY	   CONSTANT INTEGER	   := 10;
 59    OTAP_FALLBACK_DELETE_DELAY_MIN	   CONSTANT INTEGER	   := 1;
 60    OTAP_FALLBACK_DELETE_DELAY_MAX	   CONSTANT INTEGER	   := 600;
 61    OTAP_FALLBACK_DELETE_BATCH_SIZE	   CONSTANT INTEGER	   := 1000;
 62    OTAP_FALLBACK_DELETE_BATCH_SIZE_MIN CONSTANT INTEGER	   := 100;
 63    OTAP_FALLBACK_DELETE_BATCH_SIZE_MAX CONSTANT INTEGER	   := 10000;
 64    OTAP_FALLBACK_FORMAT_HEADER_CHAR    CONSTANT CHAR(1)	   := '=';
 65    OTAP_FALLBACK_FORMAT_SET_CHAR	   CONSTANT CHAR(1)	   := '*';
 66    OTAP_FALLBACK_FORMAT_GROUP_CHAR	   CONSTANT CHAR(1)	   := '+';
 67    OTAP_FALLBACK_FORMAT_NAME_CHAR	   CONSTANT CHAR(1)	   := '-';
 68    OTAP_FALLBACK_TEXT_TRUE		   CONSTANT CHAR(4)	   := 'true';
 69    OTAP_FALLBACK_TEXT_FALSE 	   CONSTANT CHAR(5)	   := 'false';
 70    OTAP_FALLBACK_TEXT_TRUE_YES	   CONSTANT CHAR(3)	   := 'Yes';
 71    OTAP_FALLBACK_TEXT_FALSE_NO	   CONSTANT CHAR(2)	   := 'No';
 72    OTAP_FALLBACK_TEXT_TEST_PASSED	   CONSTANT CHAR(6)	   := 'Passed';
 73    OTAP_FALLBACK_TEXT_TEST_FAILED	   CONSTANT CHAR(6)	   := 'FAILED';
 74    OTAP_FALLBACK_TEXT_TEST_UNDEFINED   CONSTANT CHAR(9)	   := 'UNDEFINED';
 75    OTAP_FALLBACK_DEFAULT_PREFIX	   CONSTANT CHAR(4)	   := 'TEST';
 76    OTAP_FALLBACK_DEFAULT_TEST_SET	   CONSTANT CHAR(13)	   := 'OTAP test set';
 77    OTAP_FALLBACK_DEFAULT_TEST_GROUP    CONSTANT CHAR(15)	   := 'OTAP test group';
 78    OTAP_FALLBACK_DEFAULT_TEST_NAME	   CONSTANT CHAR(14)	   := 'OTAP test name';
 79    OTAP_FALLBACK_DEFAULT_LANGUAGE	   CONSTANT CHAR(3)	   := 'en';
 80    OTAP_FALLBACK_LAYOUT_DEFAULT	   CONSTANT CHAR(1)	   := 'M';
 81    OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT CONSTANT CHAR(1)	   := 'L';
 82    OTAP_FALLBACK_LABEL_DEFAULT	   CONSTANT CHAR(1)	   := 'L';
 83    /*====================================== end package constants used by otap ======================================*/
