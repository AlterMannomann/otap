442  
443    PROCEDURE otap_session_add_test( p_test_passed  IN NUMBER
444  				      , o_otap_session IN OUT NOCOPY OTAP_SESSION
445  				      )
446    IS
447  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_add_test';
448    BEGIN
449  	 otap_objects.otap_session_verify(o_otap_session);
450  	 o_otap_session.test_count := o_otap_session.test_count + 1;
451  	 IF p_test_passed != otap_constants.OTAP_NUM_TEST_PASSED
452  	 THEN
453  	   o_otap_session.error_count := o_otap_session.error_count + 1;
454  	 END IF;
455    EXCEPTION
456  	 WHEN OTHERS THEN
457  	   IF SQLCODE != -20099
458  	   THEN
459  	     -- log unhandled exceptions
460  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
461  	   END IF;
462  	   RAISE;
