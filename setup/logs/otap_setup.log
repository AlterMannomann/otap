 94  	     END IF;
 95  	     IF p_otap_session.db_schema IS NULL OR LENGTH(TRIM(p_otap_session.db_schema)) = 0
 96  	     THEN
 97  	       l_message := l_message || l_delimiter || 'db_schema';
