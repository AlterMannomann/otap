SQL> CREATE OR REPLACE PACKAGE BODY otap_report
  2  AS
  3  
  4    -- for description see header file
  5    FUNCTION decorate( p_string     IN VARCHAR2
  6  			, p_min_fill   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
  7  			, p_decoration IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
  8  			)
  9  	 RETURN VARCHAR2
 10    IS
 11  	 l_border	    INTEGER;
 12  	 l_layout	    VARCHAR2(1 CHAR);
 13  	 l_decoration	    VARCHAR2(1 CHAR);
 14  	 l_string_size	    INTEGER;
 15  	 l_max_title_length INTEGER;
 16  	 l_min_fill	    INTEGER;
 17  	 l_min_length	    INTEGER;
 18  	 l_string	    VARCHAR2(32767 CHAR);
 19  	 l_return_text	    VARCHAR2(32767 CHAR);
 20    BEGIN
 21  	 l_border	    := otap_util.get_config_value(otap_util.CFG_DEFAULT_BORDER);
 22  	 l_layout	    := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT));
 23  	 l_decoration	    := otap_string.check_decoration(p_decoration);
 24  	 l_string_size	    := otap_string.check_string_size(NVL(LENGTH(p_string), 0));
 25  	 l_string	    := otap_string.reduce(p_string, l_string_size);
 26  	 l_max_title_length := otap_string.check_title_size(l_string_size, l_border);
 27  	 l_min_fill	    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_max_title_length);
 28  	 l_min_length	    := otap_string.line_size(l_max_title_length, l_border);
 29  	 l_return_text	    := otap_string.decorate(l_string, l_decoration, l_min_length, l_layout, l_border);
 30  	 RETURN l_return_text;
 31    EXCEPTION
 32  	 WHEN OTHERS THEN
 33  	   otap_log.log(SQLERRM, 'otap_report.decorate', 'Create decorated report line');
 34  	   RAISE;
 35    END decorate;
