SQL> CREATE OR REPLACE PACKAGE BODY otap_test
  2  AS
  3    -- for description see header file
  4    --========= package session variables =========--
  5    -- define private package sesstion variables and set defaults
  6    session_record OTAP_SESSION := otap_session( SYS_CONTEXT('USERENV', 'SESSION_USER')
  7  						  , otap_constants.OTAP_DEFAULT_TEST_SET
  8  						  , otap_constants.OTAP_DEFAULT_TEST_GROUP
  9  						  , otap_constants.OTAP_DEFAULT_TEST_NAME
