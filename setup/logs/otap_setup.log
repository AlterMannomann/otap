709  	 l_message VARCHAR2(4000 CHAR);
710    BEGIN
711  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
712  	 -- execute the wrapped function in an extra block
713  	 BEGIN
714  	   l_message := otap_report.get_test_count_header(p_min_fill);
715  	 EXCEPTION
716  	   WHEN OTHERS THEN
717  	     -- consume error
718  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_test_count_header');
719  	     l_message := otap_string.reduce('Internal otap error get test count header: ' || SQLERRM, 4000);
720  	 END;
721  	 -- return or let exception happen
722  	 RETURN l_message;
723    END get_test_count_header;
