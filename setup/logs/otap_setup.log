204    FUNCTION max_text_size(p_session_id IN NUMBER)
205  	 RETURN NUMBER
206    IS
207  	 l_script    VARCHAR2(1024 CHAR) := 'otap_api.otap_session_get_test_id';
208  	 l_return    NUMBER;
209  	 l_interval  NUMBER;
210    BEGIN
211  	 l_return := otap_constants.OTAP_REPORT_MIN_FILL_LENGTH;
212  	 -- execute the wrapped function in an extra block
213  	 BEGIN
214  	   l_return := otap_results_util.max_text_size(p_session_id);
215  	   -- now add the extra columns on the result line
216  	   SELECT LENGTH(((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval FROM dual;
217  	   l_return := l_return + l_interval + (2 * otap_config_util.get_length_test_state) + 3;
218  	 EXCEPTION
219  	   WHEN OTHERS THEN
220  	     -- consume error
221  	     otap_log.log(SQLERRM, l_script, 'Calling otap_results_util.max_text_size');
222  	     l_return := otap_constants.OTAP_REPORT_MIN_FILL_LENGTH;
223  	 END;
224  	 -- return or let exception happen
225  	 RETURN l_return;
226    END max_text_size;
