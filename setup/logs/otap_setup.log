694  	 RETURN VARCHAR2
695    IS
696  	 l_message VARCHAR2(4000 CHAR);
697    BEGIN
698  	 otap_api.validate_otap(session_record);
699  	 l_message := otap_api.match_like( p_have
700  					 , p_like
701  					 , session_record
702  					 , p_description
703  					 , p_expected_result
704  					 )
705  	 ;
706  	 RETURN l_message;
707    EXCEPTION
708  	 WHEN OTHERS THEN
709  	   IF SQLCODE != -20099
710  	   THEN
711  	     otap_log.log(SQLERRM, 'otap_test.match_like', 'l_message := otap_api.match_like( p_have, ...');
712  	   END IF;
713  	   RAISE;
714    END match_like;
