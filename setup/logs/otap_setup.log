173    FUNCTION has_package( p_package_name    IN	     VARCHAR2
174  			   , o_errors		  OUT NOCOPY VARCHAR2
175  			   , p_schema	       IN	     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
176  			   , p_package_type    IN	     VARCHAR2 DEFAULT 'PACKAGE'
177  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
178  			   )
179  	 RETURN INTEGER
180    IS
181  	 l_script	 VARCHAR2(1024 CHAR)	:= 'otap_schema.has_package';
182  	 l_ignore	 VARCHAR2(6 CHAR)	:= 'IGNORE';
183  	 l_header	 VARCHAR2(7 CHAR)	:= 'PACKAGE';
184  	 l_body 	 VARCHAR2(12 CHAR)	:= 'PACKAGE BODY';
185  	 l_has_package	 INTEGER;
186  	 l_test_passed	 INTEGER;
187  	 l_expected	 INTEGER;
188  	 l_schema_to_use VARCHAR2(128 CHAR);
189  	 l_package_name  VARCHAR2(128 CHAR);
190  	 l_package_type  VARCHAR2(12 CHAR);
191  	 l_errors	 VARCHAR2(32767 CHAR);
192    BEGIN
193  	 l_errors	 := NULL;
194  	 l_test_passed	 := otap_constants.OTAP_NUM_TEST_UNDEFINED;
195  	 l_expected	 := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
196  	 l_package_name  := otap_string.reduce(p_package_name, 128);
197  	 l_package_type  := otap_string.reduce(UPPER(p_package_type), 12);
198  	 IF	l_package_name	       IS NOT NULL
199  	    AND LENGTH(l_package_name)	> 0
200  	    AND l_package_type	       IN (l_header, l_body)
201  	 THEN
202  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
203  	   SELECT COUNT(*)
204  	     INTO l_has_package
205  	     FROM dba_objects
206  	    WHERE owner       = l_schema_to_use
207  	      AND object_name = l_package_name
208  	      AND object_type = l_package_type
209  	   ;
210  	   -- we should find one or zero entries
211  	   l_test_passed := count_chk(l_has_package, l_errors, l_script);
212  	 ELSE
213  	   -- invalid package name or type
214  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
215  	   l_errors	       := 'Not allowed: ' || CASE
216  						       WHEN l_package_name IS NULL OR LENGTH(l_package_name) = 0
217  						       THEN 'p_package_name(NULL) '
218  						     END ||
219  						     CASE
220  						       WHEN l_package_type NOT IN (l_header, l_body)
221  						       THEN 'p_package_type(' || l_package_type || ') '
222  						     END
223  	   ;
224  	   otap_log.log(l_errors, l_script, 'Package name NULL or type invalid');
225  	 END IF;
226  	 -- now decide on the expected result the final state and if errors are returned
227  	 IF l_test_passed != l_expected
228  	 THEN
229  	   o_errors := otap_string.reduce(l_errors, 4000);
230  	 ELSE
231  	   -- overwrite states from before, as we fulfill expected
232  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
233  	   -- overwrite errors expected
234  	   o_errors := NULL;
235  	 END IF;
236  	 RETURN l_test_passed;
237    EXCEPTION
238  	 WHEN OTHERS THEN
239  	   IF SQLCODE != -20099
240  	   THEN
241  	     -- log unhandled exceptions
242  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
243  	   END IF;
244  	   RAISE;
245    END has_package;
246  
247    FUNCTION has_procedure( p_procedure_name  IN	       VARCHAR2
248  			     , o_errors 	    OUT NOCOPY VARCHAR2
249  			     , p_schema 	 IN	       VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
250  			     , p_procedure_type  IN	       VARCHAR2 DEFAULT 'FUNCTION'
251  			     , p_package_name	 IN	       VARCHAR2 DEFAULT NULL
252  			     , p_return_type	 IN	       VARCHAR2 DEFAULT NULL
253  			     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
254  			     )
255  	 RETURN INTEGER
256    IS
257  	 l_script	  VARCHAR2(1024 CHAR)	 := 'otap_schema.has_procedure';
258  	 l_procedure	  VARCHAR2(9 CHAR)	 := 'PROCEDURE';
259  	 l_function	  VARCHAR2(8 CHAR)	 := 'FUNCTION';
260  	 l_test_passed	  INTEGER;
261  	 l_expected	  INTEGER;
262  	 l_has_procedure  INTEGER;
263  	 l_procedure_name VARCHAR2(128 CHAR);
264  	 l_package_name   VARCHAR2(128 CHAR);
265  	 l_procedure_type VARCHAR2(9 CHAR);
266  	 l_return_type	  VARCHAR2(128 CHAR);
267  	 l_schema_to_use  VARCHAR2(128 CHAR);
268  	 l_errors	  VARCHAR2(32767 CHAR);
269    BEGIN
270  	 l_errors	   := NULL;
271  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
272  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
273  	 l_procedure_name  := otap_string.reduce(p_procedure_name, 128);
274  	 l_package_name    := otap_string.reduce(p_package_name, 128);
275  	 l_procedure_type  := otap_string.reduce(UPPER(p_procedure_type), 9);
276  	 l_return_type	   := otap_string.reduce(UPPER(p_return_type), 128);
277  	 IF	l_procedure_name	IS NOT NULL
278  	    AND LENGTH(l_procedure_name) > 0
279  	    AND l_procedure_type	IN (l_procedure, l_function)
280  	 THEN
281  	   -- schema
282  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
283  	   -- check
284  	     WITH prc AS
285  		  (SELECT dbo.owner
286  			, dbp.procedure_name
287  			, CASE
288  			    WHEN dbr.position	    = 0
289  			     AND dbr.argument_name IS NULL
290  			    THEN 'FUNCTION'
291  			    ELSE 'PROCEDURE'
292  			  END AS procedure_type
293  			, CASE
294  			    WHEN dbr.position	    = 0
295  			     AND dbr.argument_name IS NULL
296  			    THEN dbr.data_type
297  			    ELSE NULL
298  			  END AS return_type
299  			, dbo.status
300  			, dbo.object_name AS package_name
301  		     FROM dba_objects dbo
302  		     LEFT OUTER JOIN dba_procedures dbp
303  		       ON dbo.owner	  = dbp.owner
304  		      AND dbo.object_name = dbp.object_name
305  		      AND dbo.object_type = dbp.object_type
306  		     LEFT OUTER JOIN dba_arguments dbr
307  		       ON dbp.owner	     = dbr.owner
308  		      AND dbp.object_name    = dbr.package_name
309  		      AND dbp.procedure_name = dbr.object_name
310  		      AND dbp.object_id      = dbr.object_id
311  		      AND dbp.subprogram_id  = dbr.subprogram_id
312  		      AND dbr.sequence	     = 1
313  		    WHERE dbo.owner	   = l_schema_to_use
314  		      AND dbo.object_type  = 'PACKAGE'
315  			  -- exclude package itself
316  		      AND dbp.procedure_name IS NOT NULL
317  		    UNION ALL
318  		   SELECT dbo.owner
319  			, dbo.object_name AS procedure_name
320  			, dbo.object_type AS procedure_type
321  			, CASE
322  			    WHEN dbr.position	    = 0
323  			     AND dbr.argument_name IS NULL
324  			    THEN dbr.data_type
325  			    ELSE NULL
326  			  END AS return_type
327  			, dbo.status
328  			, NULL AS package_name
329  		     FROM dba_objects dbo
330  		     LEFT OUTER JOIN dba_procedures dbp
331  		       ON dbo.owner	  = dbp.owner
332  		      AND dbo.object_name = dbp.object_name
333  		      AND dbo.object_type = dbp.object_type
334  		     LEFT OUTER JOIN dba_arguments dbr
335  		       ON dbp.owner	    = dbr.owner
336  		      AND dbp.object_name   = dbr.object_name
337  		      AND dbp.object_id     = dbr.object_id
338  		      AND dbp.subprogram_id = dbr.subprogram_id
339  		      AND dbr.sequence	    = 1
340  		    WHERE dbo.owner	   = l_schema_to_use
341  		      AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
342  		  )
343  	   SELECT COUNT(*)
344  	     INTO l_has_procedure
345  	     FROM prc
346  	    WHERE procedure_name	   = l_procedure_name
347  	      AND procedure_type	   = l_procedure_type
348  	      AND NVL(return_type, 'n/a')  = NVL(l_return_type, NVL(return_type, 'n/a'))
349  	      AND NVL(package_name, 'n/a') = NVL(l_package_name, NVL(package_name, 'n/a'))
350  	   ;
351  	   -- we may find more than 1 entry, if function or procedure has same name but different signature
352  	   l_test_passed := CASE WHEN l_has_procedure = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
353  	 ELSE
354  	   -- invalid package name, type or state
355  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
356  	   l_errors	       := 'Not allowed: ' || CASE
357  						       WHEN l_procedure_name IS NULL OR LENGTH(l_procedure_name) = 0
358  						       THEN 'p_procedure_name(NULL) '
359  						     END ||
360  						     CASE
361  						       WHEN l_procedure_type NOT IN (l_procedure, l_function)
362  						       THEN 'p_procedure_type(' || l_procedure_type || ') '
363  						     END
364  	   ;
365  	   otap_log.log(l_errors, l_script, 'Package name NULL or type invalid');
366  	 END IF;
367  	 -- now decide on the expected result the final state and if errors are returned
368  	 IF l_test_passed != l_expected
369  	 THEN
370  	   o_errors := otap_string.reduce(l_errors, 4000);
371  	 ELSE
372  	   -- overwrite states from before, as we fulfill expected
373  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
374  	   -- overwrite errors expected
375  	   o_errors := NULL;
376  	 END IF;
377  	 RETURN l_test_passed;
378    EXCEPTION
379  	 WHEN OTHERS THEN
380  	   IF SQLCODE != -20099
381  	   THEN
382  	     -- log unhandled exceptions
383  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
384  	   END IF;
385  	   RAISE;
386    END has_procedure;
