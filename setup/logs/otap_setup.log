135    PROCEDURE set_delete_delay(p_delete_delay IN NUMBER DEFAULT 10)
136    IS
137  	 PRAGMA AUTONOMOUS_TRANSACTION;
138  	 l_delete_delay VARCHAR2(3);
139    BEGIN
140  	 IF	 p_delete_delay >= 1
141  	    AND  p_delete_delay <= 600
142  	 THEN
143  	   l_delete_delay := TRIM(TO_CHAR(p_delete_delay));
144  	   UPDATE otap_config
145  	     SET config_value = l_delete_delay
146  	   WHERE config_name = otap_constants.OTAP_CFG_DELETE_DELAY
147  	   ;
148  	   COMMIT;
149  	 ELSE
150  	   otap_util.log('Wrong amount of delete delay seconds ' || p_delete_delay || ' only 1 - 600 allowed. Nothing changed.', 'otap_util.set_delete_delay', 'UPDATE otap_config DELETE_DAY');
151  	 END IF;
152    EXCEPTION
153  	 WHEN OTHERS THEN
154  	   otap_util.log(SQLERRM, 'otap_util.set_delete_delay', 'UPDATE otap_config DELETE_DELAY');
155    END set_delete_delay;
156  
157    FUNCTION delete_batch_size
158  	 RETURN NUMBER
159    IS
160  	 l_return NUMBER;
161    BEGIN
162  	 l_return := 1000;
163  	 SELECT TO_NUMBER(config_value) INTO l_return FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_DELETE_BATCH_SIZE;
164  	 RETURN l_return;
165    EXCEPTION
166  	 WHEN OTHERS THEN
167  	   otap_util.log(SQLERRM, 'otap_util.delete_batch_size', 'SELECT otap_config DELETE_BATCH_SIZE');
168  	   RETURN 1000;
169    END delete_batch_size;
170  
171    PROCEDURE set_delete_batch_size(p_delete_batch_size IN NUMBER DEFAULT 1000)
172    IS
173  	 PRAGMA AUTONOMOUS_TRANSACTION;
174  	 l_delete_batch_size VARCHAR2(5);
175    BEGIN
176  	 IF	 p_delete_batch_size >= 100
177  	    AND  p_delete_batch_size <= 10000
178  	 THEN
179  	   l_delete_batch_size := TRIM(TO_CHAR(p_delete_batch_size));
180  	   UPDATE otap_config
181  	     SET config_value = l_delete_batch_size
182  	   WHERE config_name = otap_constants.OTAP_CFG_DELETE_BATCH_SIZE
183  	   ;
184  	   COMMIT;
185  	 ELSE
186  	   otap_util.log('Wrong amount of delete batch size ' || p_delete_batch_size || ' only 100 - 10000 allowed. Nothing changed.', 'otap_util.set_delete_batch_size', 'UPDATE otap_config DELETE_BATCH_SIZE');
187  	 END IF;
188    EXCEPTION
189  	 WHEN OTHERS THEN
190  	   otap_util.log(SQLERRM, 'otap_util.set_delete_batch_size', 'UPDATE otap_config DELETE_BATCH_SIZE');
191    END set_delete_batch_size;
192  
193    PROCEDURE result_cleanup
194    IS
195  	 PRAGMA AUTONOMOUS_TRANSACTION;
196  	 l_delete_before     DATE;
197  	 l_delete_start      DATE;
198  	 l_delete_batch_size NUMBER;
199  	 l_delete_delay      NUMBER;
200  	 l_row_counter	     NUMBER;
201  	 l_processed	     NUMBER;
202  	 l_delete_msg	     VARCHAR2(32767);
203  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
204  	 IS
205  	   SELECT *
206  	     FROM otap_results
207  	    WHERE test_run_date < cp_delete_before
208  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
209  	 ;
210    BEGIN
211  	 -- read config values before starting, values will not change until finished
212  	 l_delete_start      := SYSDATE;
213  	 l_delete_before     := TRUNC(SYSDATE - otap_util.preserve_days);
214  	 l_delete_batch_size := otap_util.delete_batch_size;
215  	 l_delete_delay      := otap_util.delete_delay;
216  	 l_row_counter	     := 0;
217  	 l_processed	     := 0;
218  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
219  	 otap_util.log(l_delete_msg, 'otap_util.result_cleanup', 'Procedure start', 'OTAP_DEBUG');
220  	 FOR rec IN cur_delete_tests(l_delete_before)
221  	 LOOP
222  	   IF l_row_counter >= l_delete_batch_size
223  	   THEN
224  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
225  	     otap_util.log(l_delete_msg, 'otap_util.result_cleanup', 'Batch size reached and wait', 'OTAP_DEBUG');
226  	     -- commit the batch
227  	     COMMIT;
228  	     -- reset counter
229  	     l_row_counter := 0;
230  	     -- wait defined time
231  	     DBMS_SESSION.SLEEP(l_delete_delay);
232  	   END IF;
233  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
234  	   l_row_counter := l_row_counter + 1;
235  	   l_processed	 := l_processed + 1;
236  	 END LOOP;
237  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
238  	 otap_util.log(l_delete_msg, 'otap_util.result_cleanup', 'Procedure end', 'OTAP_DEBUG');
239  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
240    EXCEPTION
241  	 WHEN OTHERS THEN
242  	   otap_util.log(SQLERRM, 'otap_util.result_cleanup', 'DELETE FROM otap_results');
243    END result_cleanup;
244  
245    FUNCTION format_test_result( p_test_passed IN INTEGER
246  				  , p_description IN VARCHAR2
247  				  )
248  	 RETURN VARCHAR2
249    IS
250  	 l_test_result VARCHAR2(256);
251  	 l_statement   VARCHAR2(32767);
252    BEGIN
253  	 -- result column
254  	 l_test_result := RPAD(otap_constants.translate_test_result(p_test_passed), 10, ' ');
255  	 -- we still have 246 chars
256  	 l_test_result := l_test_result || TRIM(SUBSTR(p_description, 1, 246));
257  	 RETURN l_test_result;
258    EXCEPTION
259  	 WHEN OTHERS THEN
260  	   l_statement := q'[l_test_result := RPAD(otap_constants.translate_test_result(p_test_passed), 10, ' ');
261  l_test_result := l_test_result || TRIM(SUBSTR(p_description, 1, 246));]'
262  	   ;
263  	   otap_util.log('Unexpected exception. Internal error:' || SQLERRM, 'otap_util.format_test_result', l_statement);
264  	   RAISE;
265    END format_test_result;
266  
267  END;
268  /

