  2  AS
  3    /**
  4    * Provides the test run interface to users with otap user role. Allows definition of
  5    * test scope, name and test handling. This package may seem huge in terms of functions
  6    * contained. But every function is only a wrapper for the internal package. To get the
  7    * code executed refer to the called package functions.
  8    *
  9    * Every functionality is available as function, so it can be used in SQL statements as
 10    * well as in packages, procedures and functions. Parameters are kept SQL compatible.
 11    *
 12    * The package keeps private package variables in the body which are valid through the
 13    * session, but not longer. Any values set and used by this package are only valid for the
 14    * current session. EXCEPTIONS, if not handled, ARE RAISED. Every function may raise -20099
 15    * Internal error, if the session variable is in an incorrect state. Functions called can
 16    * rely on the session variable that all fields are set.
 17    *
 18    * Names of test functions and procedures follow this rules:
 19    *  3 delimiter: prefix, test set, test group, test name
 20    *	       <test prefix><delimiter><test set name><delimiter><test group name><delimiter><test name>
 21    *	       e.g. TEST_MYTESTSET_MYGROUP_MYTEST0001
 22    *  2 delimiter: prefix, test group, test name
 23    *	       <test prefix><delimiter><test group name><delimiter><test name>
 24    *	       e.g. TEST_MYGROUP_MYTEST0002
 25    *  1 delimiter: prefix, test name
 26    *	       <test prefix><delimiter><test name>
 27    *	       e.g. TEST_MYTEST0004
 28    * >3 delimiter: prefix, test set, test group, rest is testname
 29    *	       <test prefix><delimiter><test set name><delimiter><test group name>(n <delimiter><test name> occurances)
 30    *	       TEST_MYTESTSET_MYGROUP_MYTEST_WITH_A_VERY_LONG_NAME_0001
 31    *
 32    * Delimiter is limited to underscore _. Oracle strongly discourages from using $ or #. Test functions or procedures
 33    * must contain a delimiter after the prefix. Otherwise they are ignored, e.g. testMyFunction is NOT a valid name
 34    * considered by otap. otap ignores case sensitive names. It handles names as not case sensitive.
 35    *
 36    * Name components not given are replaced by the fall_back session variables. They can be set before the test.
 37    * Otherwise they use the defaults. Default is that names define the test set, test group and name. This can
 38    * also be overwritten before the test. In this case test set and test group are retrieved by the session variables
 39    * and test name equals the whole name without the prefix.
 40    * Defaults for prefix and delimiter are defined in OTAP_CONSTANTS.
 41    */
 42  
 43    /** FUNCTION otap_test.init_test
 44    * This function is at some points equal to pgTap plan. As plan is a reserved name in Oracle, even calling
 45    * a package function plan lead to errors. The name init would have been sufficient, but to avoid naming conflicts
 46    * pgTap plan equivalent in otap is init_test.
 47    *
 48    * This function is optional. If you do not execute this, the default settings will be used. Ensure proper naming of
 49    * your test functions and preocedures to make it work as desired without initialization.
 50    *
 51    * Function will set internal package variables for the duration of the session. If you open a different session, make
 52    * sure that you run init_test before, if needed.
 53    *
 54    * Main functionality is setting the amount of tests to expect. If greater than 0 this will include a test report section
 55    * containing differences in tests expected and tests executed.
 56    *
 57    * Wrapper for otap_api.init_test.
 58    *
 59    * @param p_test_count The amount of tests expected to be executed when called.
 60    * @param p_test_set The name of the test set applied if the name of the executed test procedure or function does not provide a test set name or name precendence is disabled.
 61    * @param p_test_group The name of the test group applied if the name of the executed test procedure or function does not provide a test group name or name precendence is disabled.
 62    * @param p_test_name The name of the test name applied if the name of the executed test procedure or function does not provide a test name or name precendence is disabled.
 63    * @param p_prefix The prefix to use for identifying test functions and procedures. Limited to 4 chars. Test functions and procedures must have a trailing delimiter _ after the prefix to be identified.
 64    * @param p_language_id The session language id to use for test reports and results. Limited to 3 chars. If language has no translation, default is used.
 65    * @param p_name_precedence Can disable the naming conventions for otap. If set to otap_constants.OTAP_NUM_FALSE, all tests will run under the defined test set and group, set by init_test.
 66    * @param p_include_pkg Can enable to search also packages and package procedures and functions that fit the naming convention with the given prefix, if set to otap_constants.OTAP_NUM_TRUE.
 67    * @param p_persist Can enable to persist the test results longer than the current default of PRESERVE_DAYS in OTAP_CONFIG, if set to otap_constants.OTAP_NUM_TRUE.
 68    *
 69    * The following parameters are needed by otap, but should never be overwritten.
 70    * It is the only way otap can find out correctly under which schema and user it is running.
 71    * @param p_schema Reads current schema from caller environment, DO NOT SET, let the defaults provide the value.
 72    * @param p_user Reads current user from caller environment, DO NOT SET, let the defaults provide the value.
 73    * @param p_executor Reads session user from caller environment, DO NOT SET, let the defaults provide the value.
 74    */
 75    FUNCTION init_test( p_test_count      IN NUMBER	 DEFAULT 0
 76  			 , p_test_set	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET
 77  			 , p_test_group      IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP
 78  			 , p_test_name	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME
 79  			 , p_prefix	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX
 80  			 , p_language_id     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 81  			 , p_name_precedence IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_TRUE
 82  			 , p_include_pkg     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 83  			 , p_persist	     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 84  			 -- internal variables from caller environment DO NOT SET them explicitely
 85  			 -- you may want to set p_schema, which is the default schema used for object searches
 86  			 -- but schema test functions provide a schema override, so in general there is no need
 87  			 -- for overwritting this value
 88  			 -- currently no save way exists to get the correct values from inside a procedure of function
 89  			 , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 90  			 , p_user	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_USER')
 91  			 , p_executor	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'SESSION_USER')
 92  			 )
 93  	 RETURN VARCHAR2
 94    ;
