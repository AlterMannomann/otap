SQL> CREATE OR REPLACE PACKAGE BODY otap_plan
  2  AS
  3    -- for description see header file
  4    FUNCTION write_test_result( p_test_description IN	    VARCHAR2
  5  				 , o_otap_session     IN OUT NOCOPY OTAP_SESSION
  6  				 , p_schema_used      IN	    VARCHAR2
  7  				 , p_test_passed      IN	    NUMBER
  8  				 , p_test_start       IN	    TIMESTAMP
  9  				 , p_test_errors      IN	    VARCHAR2
 10  				 )
 11  	 RETURN VARCHAR2
 12    IS
 13  	 l_script	     VARCHAR2(1024 CHAR) := 'otap_plan.write_test_result';
 14  	 l_test_passed	     INTEGER;
 15  	 l_test_description  VARCHAR2(256 CHAR);
 16  	 l_errors	     VARCHAR2(4000 CHAR);
 17  	 l_to_delete	     INTEGER;
 18  	 l_end		     TIMESTAMP;
 19  	 l_return	     VARCHAR2(4000 CHAR);
 20    BEGIN
 21  	 otap_objects.otap_session_verify(o_otap_session);
 22  	 IF LENGTH(TRIM(l_errors)) > 4000
 23  	 THEN
 24  	   l_errors := otap_string.reduce(p_test_errors, 4000);
 25  	 ELSE
 26  	   l_errors := TRIM(p_test_errors);
 27  	 END IF;
 28  	 IF p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 29  	 THEN
 30  	   l_test_passed := p_test_passed;
 31  	 ELSE
 32  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
 33  	   l_errors	 := otap_string.reduce('Invalid test passed value: ' || p_test_passed || otap_constants.OTAP_INTERNAL_LF || l_errors, 4000);
 34  	   otap_log.log('ERROR The given value for test passed ' || p_test_passed || ' for test description ' || p_test_description || ' is not valid.', l_script, 'p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)');
 35  	 END IF;
 36  	 IF p_test_description IS NULL
 37  	 THEN
 38  	   l_test_description := 'Unspecified test ' || TIMESTAMP_TO_SCN(SYSTIMESTAMP);
 39  	   l_errors	      := otap_string.reduce('Missing test description' || otap_constants.OTAP_INTERNAL_LF || l_errors, 4000);
 40  	 ELSE
 41  	   IF LENGTH(p_test_description) > 256
 42  	   THEN
 43  	     l_test_description := otap_string.reduce(p_test_description, 256);
 44  	     l_errors		:= otap_string.reduce('Test description too long, cutted' || otap_constants.OTAP_INTERNAL_LF || l_errors, 4000);
 45  	   ELSE
 46  	     l_test_description := TRIM(p_test_description);
 47  	   END IF;
 48  	 END IF;
 49  	 -- set delete flag as stored
 50  	 l_to_delete := CASE WHEN o_otap_session.persist_test THEN otap_constants.OTAP_NUM_FALSE ELSE otap_constants.OTAP_NUM_TRUE END;
 51  	 l_end := SYSTIMESTAMP;
 52  	 -- ready to insert
 53  	 otap_util.write_test_result( l_to_delete
 54  				    , l_test_passed
 55  				    , o_otap_session.session_id
 56  				    , o_otap_session.test_executor
 57  				    , o_otap_session.test_set
 58  				    , o_otap_session.db_user
 59  				    , NVL(p_schema_used, o_otap_session.db_schema)
 60  				    , o_otap_session.test_group
 61  				    , p_test_start
 62  				    , l_end
 63  				    , o_otap_session.test_name
 64  				    , l_test_description
 65  				    , l_errors
 66  				    )
 67  	 ;
 68  	 -- add test to session var
 69  	 otap_objects.otap_session_add_test(l_test_passed, o_otap_session);
 70  	 l_return := otap_string.reduce(otap_util.test_result_to_text(l_test_passed) || ' ' || l_test_description, 4000);
 71  	 RETURN l_return;
 72    EXCEPTION
 73  	 WHEN OTHERS THEN
 74  	   IF SQLCODE != -20099
 75  	   THEN
 76  	     -- log unhandled exceptions
 77  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 78  	   END IF;
 79  	   RAISE;
 80    END write_test_result;
 81  
 82    PROCEDURE write_count_result(p_otap_session IN OTAP_SESSION)
 83    IS
 84  	 l_script	     VARCHAR2(1024 CHAR) := 'otap_plan.write_count_result';
 85  	 l_test_passed	     INTEGER;
 86  	 l_test_description  VARCHAR2(256 CHAR);
 87  	 l_errors	     VARCHAR2(4000 CHAR);
 88  	 l_start	     TIMESTAMP;
 89  	 l_tmp_otap_session  OTAP_SESSION;
 90  	 l_return	     VARCHAR2(4000 CHAR);
 91    BEGIN
 92  	 l_start := SYSTIMESTAMP;
 93  	 -- only write a record, if intended count is set, do nothing otherwise
 94  	 IF p_otap_session.intended_count > 0
 95  	 THEN
 96  	   l_test_passed      := CASE WHEN p_otap_session.test_count = p_otap_session.intended_count THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
 97  	   l_test_description := otap_string.reduce(otap_report.get_count_desc(p_otap_session.test_count, p_otap_session.intended_count), 256);
 98  	   l_errors	      := NULL;
 99  	   l_tmp_otap_session := otap_objects.otap_session_copy(p_otap_session);
100  	   l_tmp_otap_session.test_name := otap_util.get_config_value(otap_util.CFG_TEXT_TEST_COUNT_NAME);
101  	   l_return := otap_plan.write_test_result(l_test_description, l_tmp_otap_session, NULL, l_test_passed, l_start, l_errors);
102  	 END IF;
103    EXCEPTION
104  	 WHEN OTHERS THEN
105  	   IF SQLCODE != -20099
106  	   THEN
107  	     -- log unhandled exceptions
108  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
109  	   END IF;
110  	   RAISE;
111    END write_count_result;
112  
113    FUNCTION init_test( p_test_count 	 IN	       NUMBER
114  			 , p_test_set		 IN	       VARCHAR2
115  			 , p_test_group 	 IN	       VARCHAR2
116  			 , p_test_name		 IN	       VARCHAR2
117  			 , p_prefix		 IN	       VARCHAR2
118  			 , p_name_precedence	 IN	       NUMBER
119  			 , p_include_pkg	 IN	       NUMBER
120  			 , p_persist		 IN	       NUMBER
121  			 , p_schema		 IN	       VARCHAR2
122  			 , p_user		 IN	       VARCHAR2
123  			 , p_executor		 IN	       VARCHAR2
124  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
125  			 )
126  	 RETURN VARCHAR2
127    IS
128  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.init_test';
129  	 l_message VARCHAR2(4000 CHAR);
130    BEGIN
131  	 -- if test count is not 0 this is a reset, write a test count record, if intended count is set
132  	 IF	o_otap_session.test_count      > 0
133  	    AND (   o_otap_session.intended_count  > 0
134  		 OR NVL(p_test_count, 0)	   > 0
135  		)
136  	 THEN
137  	   -- write record with current values
138  	   otap_plan.write_count_result(o_otap_session);
139  	   l_message := 'Closed test session summary' || otap_constants.OTAP_INTERNAL_LF;
140  	   l_message := l_message || otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_INTERNAL_LF;
141  	 END IF;
142  	 -- now start setting the new values
143  	 l_message := l_message || otap_objects.otap_session_set( p_test_count
144  								, p_test_set
145  								, p_test_group
146  								, p_test_name
147  								, p_prefix
148  								, p_name_precedence
149  								, p_include_pkg
150  								, p_persist
151  								, p_schema
152  								, p_user
153  								, p_executor
154  								, o_otap_session
155  								)
156  	 ;
157  	 RETURN l_message;
158    EXCEPTION
159  	 WHEN OTHERS THEN
160  	   IF SQLCODE != -20099
161  	   THEN
162  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
163  	   END IF;
164  	   RAISE;
165    END init_test;
166  
167    FUNCTION run_tests( p_like_expression   IN VARCHAR2 DEFAULT '%'
168  			 , p_schema_overwrite  IN VARCHAR2 DEFAULT NULL
169  			 , p_otap_session      IN OTAP_SESSION
170  			 )
171  	 RETURN VARCHAR2
172    IS
173  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.run_tests';
174  	 l_message VARCHAR2(4000 CHAR);
175  	 l_schema  VARCHAR2(128 CHAR);
176  	 l_like    VARCHAR2(256 CHAR);
177  	 l_test    VARCHAR2(257 CHAR);
178  	 CURSOR cur_tests_to_run( cp_schema IN VARCHAR2
179  				, cp_like   IN VARCHAR2
180  				)
181  	 IS
182  	   SELECT owner
183  		, object_name
184  	     FROM dba_objects
185  	    WHERE object_type	 = 'PROCEDURE'
186  	      AND owner 	 = cp_schema
187  	      AND object_name LIKE cp_like ESCAPE '\'
188  	 ;
189    BEGIN
190  	 l_schema := NVL(p_schema_overwrite, p_otap_session.db_schema);
191  	 l_like   := p_otap_session.test_prefix || '\' || otap_constants.OTAP_INTERNAL_DELIMITER || NVL(p_like_expression, '%');
192  	 -- loop over records found
193  	 FOR rec IN cur_tests_to_run(l_schema, l_like)
194  	 LOOP
195  	   NULL;
196  	 END LOOP;
197  	 RETURN l_message;
198    EXCEPTION
199  	 WHEN OTHERS THEN
200  	   IF SQLCODE != -20099
201  	   THEN
202  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
203  	   END IF;
204  	   RAISE;
205    END run_tests;
206  
207    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
208  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
209  			   )
210  	 RETURN VARCHAR2
211    IS
212  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.finish_test';
213  	 l_message VARCHAR2(4000 CHAR);
214    BEGIN
215  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
216  	 THEN
217  	   otap_plan.write_count_result(o_otap_session);
218  	 END IF;
219  	 l_message := otap_objects.otap_session_finish(o_otap_session);
220  	 RETURN l_message;
221    EXCEPTION
222  	 WHEN OTHERS THEN
223  	   IF SQLCODE != -20099
224  	   THEN
225  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
226  	   END IF;
227  	   RAISE;
228    END finish_test;
229  
230    FUNCTION finish_test_with_exit_code( p_write_count_rec IN	    NUMBER
231  					  , o_otap_session    IN OUT NOCOPY OTAP_SESSION
232  					  )
233  	 RETURN NUMBER
234    IS
235  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.finish_test_with_exit_code';
236  	 l_message VARCHAR2(4000 CHAR);
237  	 l_return  INTEGER;
238    BEGIN
239  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
240  	 THEN
241  	   otap_plan.write_count_result(o_otap_session);
242  	 END IF;
243  	 -- check the test status of the current session before closing
244  	   WITH trl AS
245  		(SELECT test_session_id
246  		      , CASE test_passed WHEN 1 THEN 0 WHEN -1 THEN 1 ELSE 2 END AS exit_code
247  		   FROM otap_results
248  		  WHERE test_session_id = o_otap_session.session_id
249  		)
250  	 SELECT NVL(MAX(exit_code), 2)
251  	   INTO l_return
252  	   FROM trl
253  	 ;
254  	 -- finish the session
255  	 l_message := otap_objects.otap_session_finish(o_otap_session);
256  	 -- return exit code
257  	 RETURN l_return;
258    EXCEPTION
259  	 WHEN OTHERS THEN
260  	   IF SQLCODE != -20099
261  	   THEN
262  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
263  	   END IF;
264  	   RAISE;
265    END finish_test_with_exit_code;
266  
267  END;
268  /

