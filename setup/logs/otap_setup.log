SQL> CREATE OR REPLACE PACKAGE BODY otap_generate
  2  AS
  3    -- for description see header file
  4    FUNCTION column_tests( p_table	      IN VARCHAR2
  5  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
  6  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
  7  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
  8  			    , p_excl_default  IN VARCHAR2 DEFAULT '$'
  9  			    , p_show_header   IN INTEGER  DEFAULT 1
 10  			    )
 11  	 RETURN otap_view_result_tbl PIPELINED
 12    IS
 13  	 l_statement   VARCHAR2(4000 CHAR);
 14  	 l_schema      VARCHAR2(128 CHAR);
 15  	 l_table       VARCHAR2(128 CHAR);
 16  	 l_base_title  VARCHAR2(256 CHAR);
 17  	 l_like        VARCHAR2(256 CHAR);
 18  	 l_test_count  INTEGER;
 19  	 CURSOR cur_columns( cp_schema IN VARCHAR2
 20  			   , cp_table  IN VARCHAR2
 21  			   , cp_like   IN VARCHAR2
 22  			   )
 23  	 IS
 24  	   SELECT table_name
 25  		, column_name
 26  		, owner
 27  		, data_type
 28  		, data_precision
 29  		, data_length
 30  		, data_scale
 31  		, nullable
 32  		, data_default_vc
 33  	     FROM dba_tab_columns
 34  	    WHERE owner 	 = cp_schema
 35  	      AND table_name	 = cp_table
 36  	      AND column_name LIKE cp_like
 37  	    ORDER BY column_id
 38  	 ;
 39    BEGIN
 40  	 IF p_table IS NOT NULL
 41  	 THEN
 42  	   l_table	:= otap_string.reduce(p_table, 128);
 43  	   l_like	:= NVL(p_like_column, '%');
 44  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
 45  	   l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
 46  	   IF NVL(p_show_header, 1) = 1
 47  	   THEN
 48  	     l_statement := '-- otap GENERATE column test scripts for table ' || l_schema || '.' || l_table || ' scope: ' || l_like;
 49  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 50  	     -- get test count
 51  	     SELECT SUM(expected_tests) + 1 -- add one for the test count test
 52  	       INTO l_test_count
 53  	       FROM (SELECT COUNT(*) AS expected_tests FROM dba_tab_columns WHERE owner = l_schema AND table_name = l_table)
 54  	     ;
 55  	     -- build init
 56  	     l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
 57  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 58  	   END IF;
 59  	   l_statement := '-- loop through columns with names like ' || l_like;
 60  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
 61  	   FOR rec IN cur_columns(l_schema, l_table, l_like)
 62  	   LOOP
 63  	     l_statement := 'SELECT otap_test.has_column( p_table_name => ''' || rec.table_name || '''';
 64  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 65  	     l_statement := '				, p_column_name => ''' || rec.column_name || '''';
 66  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 67  	     l_statement := '				, p_schema => ''' || rec.owner || '''';
 68  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 69  	     l_statement := '				, p_data_type => ''' || rec.data_type || '''';
 70  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 71  	     l_statement := '				, p_data_length => ' || TRIM(TO_CHAR(rec.data_length));
 72  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 73  	     IF rec.data_precision IS NOT NULL
 74  	     THEN
 75  	       l_statement := ' 			  , p_data_precision => ' || TRIM(TO_CHAR(rec.data_precision));
 76  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
 77  	     END IF;
 78  	     IF rec.data_scale IS NOT NULL
 79  	     THEN
 80  	       l_statement := ' 			  , p_data_scale => ' || TRIM(TO_CHAR(rec.data_scale));
 81  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
 82  	     END IF;
 83  	     l_statement := '				, p_nullable => ''' || rec.nullable || '''';
 84  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 85  	     IF     rec.data_default_vc 			      IS NOT NULL
 86  		AND NVL(INSTR(rec.data_default_vc, p_excl_default), 0) = 0
 87  	     THEN
 88  	       IF INSTR(rec.data_default_vc, '''') > 0
 89  	       THEN
 90  		 l_statement := '			    , p_data_default => q''[' || TRIM(rec.data_default_vc) || ']''';
 91  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 92  	       ELSE
 93  		 l_statement := '			    , p_data_default => ''' || TRIM(rec.data_default_vc) || '''';
 94  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 95  	       END IF;
 96  	     END IF;
 97  	     l_statement := '				) FROM dual;';
 98  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 99  	   END LOOP;
100  	   IF NVL(p_show_header, 1) = 1
101  	   THEN
102  	     -- build finish
103  	     l_statement := '-- finish column tests for ' || l_table;
104  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
105  	     l_statement := '-- finish test session';
106  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
107  	     l_statement := 'SELECT otap_test.finish_test FROM dual;';
108  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
109  	     l_statement := 'SELECT * FROM otap_latest_test_results_v;';
110  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
111  	     -- add AI and copyright
112  	     l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
113  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
114  	     l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
115  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
116  	     l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
117  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
118  	   ELSE
119  	     l_statement := '-- finish column tests for ' || l_table;
120  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
121  	   END IF;
122  	 END IF;
123  	 RETURN;
124    EXCEPTION
125  	 WHEN NO_DATA_NEEDED THEN
126  	   RAISE;
127    END column_tests;
128  
129    FUNCTION table_tests( p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
130  			   , p_like_table    IN VARCHAR2 DEFAULT '%'
131  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
132  			   , p_show_header   IN INTEGER  DEFAULT 1
133  			   )
134  	 RETURN otap_view_result_tbl PIPELINED
135    IS
136  	 l_statement   VARCHAR2(4000 CHAR);
137  	 l_schema      VARCHAR2(128 CHAR);
138  	 l_base_title  VARCHAR2(256 CHAR);
139  	 l_like        VARCHAR2(256 CHAR);
140  	 l_test_count  INTEGER;
141  	 CURSOR cur_tables( cp_schema IN VARCHAR2
142  			  , cp_like   IN VARCHAR2
143  			  )
144  	 IS
145  	   SELECT object_name AS table_name
146  	     FROM dba_objects
147  	    WHERE owner 	 = cp_schema
148  	      AND object_type	 = 'TABLE'
149  	      AND object_name LIKE cp_like
150  	 ;
151  	 CURSOR cur_columns( cp_schema IN VARCHAR2
152  			   , cp_table  IN VARCHAR2
153  			   , cp_like   IN VARCHAR2
154  			   , cp_prefix IN VARCHAR2
155  			   )
156  	 IS
157  	   SELECT result_text
158  	     FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, '$', 0))
159  	 ;
160    BEGIN
161  	 l_like       := NVL(p_like_table, '%');
162  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
163  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
164  	 IF NVL(p_show_header, 1) = 1
165  	 THEN
166  	   l_statement := '-- otap GENERATE table test scripts for schema ' || l_schema || ' scope: ' || l_like;
167  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
168  	   -- get test count
169  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
170  	     INTO l_test_count
171  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type = 'TABLE'
172  		    UNION ALL
173  		   SELECT COUNT(*) AS expected_tests FROM dba_tab_columns WHERE owner = l_schema
174  		  )
175  	   ;
176  	   -- build init
177  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
178  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
179  	 END IF;
180  	 -- build group row
181  	 l_statement := '-- set test group for tables';
182  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
183  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' tables'') FROM dual;';
184  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
185  	 l_statement := '-- loop through tables with names like ' || l_like;
186  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
187  	 FOR rec IN cur_tables(l_schema, l_like)
188  	 LOOP
189  	   l_statement := '-- set test name for table';
190  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
191  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' table ' || rec.table_name || ''') FROM dual;';
192  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
193  	   l_statement := 'SELECT otap_test.has_table( p_table_name => ''' || rec.table_name || '''';
194  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
195  	   l_statement := '			     , p_schema => ''' || l_schema || '''';
196  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
197  	   l_statement := '			     ) FROM dual;';
198  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
199  	   FOR colrec IN cur_columns(l_schema, rec.table_name, '%', p_title_prefix)
200  	   LOOP
201  	     PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
202  	   END LOOP;
203  	 END LOOP;
204  	 IF NVL(p_show_header, 1) = 1
205  	 THEN
206  	   -- build finish
207  	   l_statement := '-- finish table tests for ' || l_like;
208  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
209  	   l_statement := '-- finish test session';
210  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
211  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
212  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
213  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
214  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
215  	   -- add AI and copyright
216  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
217  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
218  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
219  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
220  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
221  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
222  	 ELSE
223  	   l_statement := '-- finish table tests for ' || l_like;
224  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
225  	 END IF;
226  	 RETURN;
227    EXCEPTION
228  	 WHEN NO_DATA_NEEDED THEN
229  	   RAISE;
230    END table_tests;
231  
232    FUNCTION trigger_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
233  			     , p_like_trigger  IN VARCHAR2 DEFAULT '%'
234  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
235  			     , p_show_header   IN INTEGER  DEFAULT 1
236  			     )
237  	 RETURN otap_view_result_tbl PIPELINED
238    IS
239  	 l_statement   VARCHAR2(4000 CHAR);
240  	 l_schema      VARCHAR2(128 CHAR);
241  	 l_base_title  VARCHAR2(256 CHAR);
242  	 l_like        VARCHAR2(256 CHAR);
243  	 l_count       INTEGER;
244  	 l_test_count  INTEGER;
245  	 CURSOR cur_table_trigger( cp_schema IN VARCHAR2
246  				 , cp_like   IN VARCHAR2
247  				 )
248  	 IS
249  	   SELECT table_name
250  	     FROM dba_triggers
251  	    WHERE owner 	  = cp_schema
252  	      AND table_name	 IS NOT NULL
253  	      AND trigger_name LIKE cp_like
254  	    GROUP BY table_name
255  	    ORDER BY table_name
256  	 ;
257  	 CURSOR cur_trigger( cp_schema IN VARCHAR2
258  			   , cp_table  IN VARCHAR2
259  			   , cp_like   IN VARCHAR2
260  			   )
261  	 IS
262  	   SELECT trigger_name
263  		, table_name
264  		, table_owner
265  		, owner
266  		, trigger_type
267  		, triggering_event
268  	     FROM dba_triggers
269  	    WHERE owner 	  = cp_schema
270  	      AND table_name	  = cp_table
271  	      AND trigger_name LIKE cp_like
272  	    ORDER BY trigger_name
273  	 ;
274  	 CURSOR cur_other_trigger( cp_schema IN VARCHAR2
275  				 , cp_like   IN VARCHAR2
276  				 )
277  	 IS
278  	   SELECT trigger_name
279  		, owner
280  		, trigger_type
281  		, triggering_event
282  	     FROM dba_triggers
283  	    WHERE owner 	  = cp_schema
284  	      AND table_name	 IS NULL
285  	      AND trigger_name LIKE cp_like
286  	    ORDER BY trigger_name
287  	 ;
288    BEGIN
289  	 l_like       := NVL(p_like_trigger, '%');
290  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
291  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
292  	 IF NVL(p_show_header, 1) = 1
293  	 THEN
294  	   l_statement := '-- otap GENERATE trigger test scripts for schema ' || l_schema || ' scope: ' || l_like;
295  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
296  	   -- get test count
297  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
298  	     INTO l_test_count
299  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_triggers WHERE owner = l_schema)
300  	   ;
301  	   -- build init
302  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
303  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
304  	 END IF;
305  	 -- build group row
306  	 l_statement := '-- set test group for trigger';
307  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
308  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' trigger'') FROM dual;';
309  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
310  	 -- organize trigger by table or not
311  	 -- trigger with table
312  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NOT NULL;
313  	 IF l_count > 0
314  	 THEN
315  	   FOR rec IN cur_table_trigger(l_schema, l_like)
316  	   LOOP
317  	     -- build name
318  	     l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' ' || rec.table_name || ' table trigger'') FROM dual;';
319  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
320  	     l_statement := '-- loop through triggers with names like ' || l_like;
321  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
322  	     FOR rectrg IN cur_trigger(l_schema, rec.table_name, l_like)
323  	     LOOP
324  	       l_statement := 'SELECT otap_test.has_trigger( p_trigger_name => ''' || rectrg.trigger_name || '''';
325  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
326  	       l_statement := ' 			   , p_schema => ''' || rectrg.owner || '''';
327  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
328  	       l_statement := ' 			   , p_trigger_type => ''' || TRIM(rectrg.trigger_type) || '''';
329  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
330  	       l_statement := ' 			   , p_trigger_event => ''' || TRIM(rectrg.triggering_event) || '''';
331  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
332  	       l_statement := ' 			   , p_table_owner => ''' || TRIM(rectrg.table_owner) || '''';
333  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
334  	       l_statement := ' 			   , p_table_name => ''' || TRIM(rectrg.table_name) || '''';
335  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
336  	       l_statement := ' 			   ) FROM dual;';
337  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
338  	     END LOOP;
339  	   END LOOP;
340  	 END IF;
341  	 -- trigger without table
342  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NULL;
343  	 IF l_count > 0
344  	 THEN
345  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' trigger without tables'') FROM dual;';
346  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
347  	   l_statement := '-- loop through triggers with names like ' || l_like;
348  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
349  	   FOR rec IN cur_other_trigger(l_schema, l_like)
350  	   LOOP
351  	     l_statement := 'SELECT otap_test.has_trigger( p_trigger_name => ''' || rec.trigger_name || '''';
352  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
353  	     l_statement := '				 , p_schema => ''' || rec.owner || '''';
354  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
355  	     l_statement := '				 , p_trigger_type => ''' || TRIM(rec.trigger_type) || '''';
356  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
357  	     l_statement := '				 , p_trigger_event => ''' || TRIM(rec.triggering_event) || '''';
358  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
359  	     l_statement := '				 ) FROM dual;';
360  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
361  	   END LOOP;
362  	 END IF;
363  	 IF NVL(p_show_header, 1) = 1
364  	 THEN
365  	   -- build finish
366  	   l_statement := '-- finish trigger tests for ' || l_like;
367  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
368  	   l_statement := '-- finish test session';
369  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
370  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
371  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
372  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
373  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
374  	   -- add AI and copyright
375  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
376  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
377  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
378  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
379  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
380  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
381  	 ELSE
382  	   l_statement := '-- finish trigger tests for ' || l_like;
383  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
384  	 END IF;
385  	 RETURN;
386    EXCEPTION
387  	 WHEN NO_DATA_NEEDED THEN
388  	   RAISE;
389    END trigger_tests;
