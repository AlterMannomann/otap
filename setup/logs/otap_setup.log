1099  	FUNCTION has_scheduler_job( p_job_name	      IN	    VARCHAR2
1100  				  , o_errors		 OUT NOCOPY VARCHAR2
1101  				  , p_job_style       IN	    VARCHAR2 DEFAULT NULL
1102  				  , p_job_type	      IN	    VARCHAR2 DEFAULT NULL
