 53    FUNCTION check_border(p_border IN INTEGER DEFAULT otap_constants.OTAP_FALLBACK_BORDER)
 54  	 RETURN NUMBER
 55    IS
 56  	 l_script VARCHAR2(256 CHAR) := 'otap_string.check_border';
 57  	 l_border INTEGER;
 58    BEGIN
 59  	 IF NVL(p_border, otap_constants.OTAP_FALLBACK_BORDER) NOT BETWEEN 2 AND 10
 60  	 THEN
 61  	   l_border := otap_constants.OTAP_FALLBACK_BORDER;
 62  	 ELSE
 63  	   l_border := NVL(p_border, otap_constants.OTAP_FALLBACK_BORDER);
 64  	 END IF;
 65  	 RETURN l_border;
 66    EXCEPTION
 67  	 WHEN OTHERS THEN
 68  	   otap_log.log(SQLERRM, l_script, 'Check border constraints');
 69  	   RAISE;
 70    END check_border;
 71  
 72    FUNCTION check_line_size(p_line_size IN INTEGER DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH)
 73  	 RETURN NUMBER
 74    IS
 75  	 l_script    VARCHAR2(256 CHAR) := 'otap_string.check_line_size';
 76  	 l_line_size INTEGER;
 77    BEGIN
 78  	 IF NVL(p_line_size, otap_constants.OTAP_NUM_MIN_FILL_LENGTH) NOT BETWEEN otap_constants.OTAP_NUM_MIN_FILL_LENGTH AND otap_constants.OTAP_NUM_MAX_FILL_LENGTH
 79  	 THEN
 80  	   IF p_line_size > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
 81  	   THEN
 82  	     l_line_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH;
 83  	   ELSE
 84  	     l_line_size := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
 85  	   END IF;
 86  	 ELSE
 87  	   l_line_size := NVL(p_line_size, otap_constants.OTAP_NUM_MIN_FILL_LENGTH);
 88  	 END IF;
 89  	 RETURN l_line_size;
 90    EXCEPTION
 91  	 WHEN OTHERS THEN
 92  	   otap_log.log(SQLERRM, l_script, 'Check line size constraints');
 93  	   RAISE;
 94    END check_line_size;
 95  
 96    FUNCTION check_title_size( p_title_length IN INTEGER DEFAULT 0
 97  				, p_border	 IN INTEGER DEFAULT otap_constants.OTAP_FALLBACK_BORDER
 98  				)
 99  	 RETURN NUMBER
100    IS
101  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.check_title_size';
102  	 l_title_size INTEGER;
103  	 l_border     INTEGER;
104    BEGIN
105  	 l_border := otap_string.check_border(p_border);
106  	 IF (NVL(p_title_length, 0) + (l_border * 2)) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
107  	 THEN
108  	   l_title_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH - (l_border * 2);
109  	 ELSE
110  	   l_title_size := NVL(p_title_length, 0);
111  	 END IF;
112  	 RETURN l_title_size;
113    EXCEPTION
114  	 WHEN OTHERS THEN
115  	   otap_log.log(SQLERRM, l_script, 'Check title size constraints');
116  	   RAISE;
117    END check_title_size;
118  
119    FUNCTION check_string_size(p_string_length IN INTEGER DEFAULT 0)
120  	 RETURN NUMBER
121    IS
122  	 l_script      VARCHAR2(256 CHAR) := 'otap_string.check_string_size';
123  	 l_string_size INTEGER;
124    BEGIN
125  	 IF NVL(p_string_length, 0) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
126  	 THEN
127  	   l_string_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH;
128  	 ELSIF NVL(p_string_length, 0) < otap_constants.OTAP_NUM_MIN_FILL_LENGTH
129  	 THEN
130  	   l_string_size := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
131  	 ELSE
132  	   l_string_size := NVL(p_string_length, 0);
133  	 END IF;
134  	 RETURN l_string_size;
135    EXCEPTION
136  	 WHEN OTHERS THEN
137  	   otap_log.log(SQLERRM, l_script, 'Check string size constraints');
138  	   RAISE;
139    END check_string_size;
140  
141    FUNCTION check_layout(p_layout IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT)
142  	 RETURN VARCHAR2
143    IS
144  	 l_script VARCHAR2(256 CHAR) := 'otap_string.check_layout';
145  	 l_layout VARCHAR2(1 CHAR);
146    BEGIN
147  	 l_layout := CASE
148  		       WHEN p_layout IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
149  		       THEN p_layout
150  		       ELSE otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
151  		     END
152  	 ;
153  	 RETURN l_layout;
154    EXCEPTION
155  	 WHEN OTHERS THEN
156  	   otap_log.log(SQLERRM, l_script, 'Check layout constraints');
157  	   RAISE;
158    END check_layout;
159  
160    FUNCTION check_decoration(p_decoration IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR)
161  	 RETURN VARCHAR2
162    IS
163  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.check_decoration';
164  	 l_decoration VARCHAR2(1 CHAR);
165    BEGIN
166  	 l_decoration := SUBSTR(NVL(p_decoration, otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR), 1, 1);
167  	 RETURN l_decoration;
168    EXCEPTION
169  	 WHEN OTHERS THEN
170  	   otap_log.log(SQLERRM, l_script, 'SUBSTR(NVL(p_decoration, otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR), 1, 1)');
171  	   RAISE;
172    END check_decoration;
173  
174    FUNCTION line_size( p_title_length  IN INTEGER
175  			 , p_border	   IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
176  			 , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
177  			 )
178  	 RETURN INTEGER
179    IS
180  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.line_size';
181  	 l_length     INTEGER;
182  	 l_border     INTEGER;
183  	 l_line_size  INTEGER;
184  	 l_title_size INTEGER;
185  	 l_calc_size  INTEGER;
186    BEGIN
187  	 l_border     := otap_string.check_border(p_border);
188  	 l_line_size  := otap_string.check_line_size(p_min_fill);
189  	 l_title_size := otap_string.check_title_size(p_title_length, l_border);
190  	 l_calc_size  := l_title_size + (l_border * 2);
191  	 l_length     := GREATEST(NVL(l_calc_size, 0), l_line_size);
192  	 IF l_length < otap_constants.OTAP_NUM_MIN_FILL_LENGTH
193  	 THEN
194  	   l_length := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
195  	 ELSIF l_length > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
196  	 THEN
197  	   l_length := otap_constants.OTAP_NUM_MAX_FILL_LENGTH;
198  	 END IF;
199  	 RETURN l_length;
200    EXCEPTION
201  	 WHEN OTHERS THEN
202  	   otap_log.log(SQLERRM, l_script, 'Calculate decorated line size');
203  	   RAISE;
204    END line_size;
205  
206    FUNCTION max_size( p_title_length IN INTEGER
207  			, p_line_size	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
208  			, p_border	 IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
209  			)
210  	 RETURN INTEGER
211    IS
212  	 l_script VARCHAR2(256 CHAR) := 'otap_string.max_size';
213  	 l_title_length INTEGER;
214  	 l_line_size	INTEGER;
215  	 l_border	INTEGER;
216  	 l_max_size	INTEGER;
217    BEGIN
218  	 l_line_size	:= otap_string.check_line_size(p_line_size);
219  	 l_border	:= otap_string.check_border(p_border);
220  	 l_title_length := otap_string.check_title_size(p_title_length, l_border);
221  	 IF l_title_length <= 0
222  	 THEN
223  	   l_max_size := 0;
224  	 ELSE
225  	   IF (l_title_length + (l_border * 2)) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
226  	   THEN
227  	     l_max_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH - (l_border * 2);
228  	   ELSE
229  	     l_max_size := l_title_length;
230  	   END IF;
231  	 END IF;
232  	 RETURN l_max_size;
233    EXCEPTION
234  	 WHEN OTHERS THEN
235  	   otap_log.log(SQLERRM, l_script, 'Calculate maximum title size');
236  	   RAISE;
237    END max_size;
238  
239    FUNCTION left_deco( p_title_length IN INTEGER  DEFAULT 0
240  			 , p_min_fill	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
241  			 , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
242  			 , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
243  			 , p_border	  IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
244  			 )
245  	 RETURN VARCHAR2
246    IS
247  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.left_deco';
248  	 l_deco 	 VARCHAR2(1 CHAR);
249  	 l_layout	 VARCHAR2(1 CHAR);
250  	 l_border	 INTEGER;
251  	 l_pad_size	 INTEGER;
252  	 l_min_fill	 INTEGER;
253  	 l_line_size	 INTEGER;
254  	 l_title_length  INTEGER;
255  	 l_left_pad	 VARCHAR2(32767 CHAR);
256    BEGIN
257  	 l_min_fill	 := otap_string.check_line_size(p_min_fill);
258  	 l_deco 	 := otap_string.check_decoration(p_decoration);
259  	 l_border	 := otap_string.check_border(p_border);
260  	 l_layout	 := otap_string.check_layout(p_layout);
261  	 l_title_length  := otap_string.check_title_size(p_title_length, l_border);
262  	 l_line_size	 := otap_string.line_size(l_title_length, l_border, l_min_fill);
263  	 -- if defaults we should have now a line size between 80 and 4000, a border between 2 and 10, a valid deco and a valid layout.
264  	 l_pad_size := CASE
265  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
266  			 THEN l_border
267  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
268  			 THEN l_line_size - (l_title_length + l_border)
269  			 ELSE FLOOR((l_line_size - l_title_length) / 2)
270  		       END
271  	 ;
272  	 IF l_title_length = 0
273  	 THEN
274  	   l_left_pad := LPAD(l_deco, l_pad_size, l_deco);
275  	 ELSE
276  	   l_left_pad := LPAD(' ', l_pad_size, l_deco);
277  	 END IF;
278  	 RETURN l_left_pad;
279    EXCEPTION
280  	 WHEN OTHERS THEN
281  	   otap_log.log(SQLERRM, l_script, 'Build left decoration');
282  	   RAISE;
283    END left_deco;
284  
285    FUNCTION right_deco( p_title_length IN INTEGER  DEFAULT 0
286  			  , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
287  			  , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
288  			  , p_layout	   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
289  			  , p_border	   IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
290  			  )
291  	 RETURN VARCHAR2
292    IS
293  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.right_deco';
294  	 l_deco 	 VARCHAR2(1 CHAR);
295  	 l_layout	 VARCHAR2(1 CHAR);
296  	 l_border	 INTEGER;
297  	 l_pad_size	 INTEGER;
298  	 l_min_fill	 INTEGER;
299  	 l_line_size	 INTEGER;
300  	 l_title_length  INTEGER;
301  	 l_right_pad	 VARCHAR2(32767 CHAR);
302    BEGIN
303  	 l_min_fill	 := otap_string.check_line_size(p_min_fill);
304  	 l_deco 	 := otap_string.check_decoration(p_decoration);
305  	 l_border	 := otap_string.check_border(p_border);
306  	 l_layout	 := otap_string.check_layout(p_layout);
307  	 l_title_length  := otap_string.check_title_size(p_title_length, l_border);
308  	 l_line_size	 := otap_string.line_size(l_title_length, l_border, l_min_fill);
309  	 l_pad_size := CASE
310  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
311  			 THEN l_line_size - (l_title_length + l_border)
312  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
313  			 THEN l_border
314  			 ELSE FLOOR((l_line_size - l_title_length) / 2) + MOD((l_line_size - l_title_length), 2)
315  		       END
316  	 ;
317  	 IF l_title_length = 0
318  	 THEN
319  	   l_right_pad := RPAD(l_deco, l_pad_size, l_deco);
320  	 ELSE
321  	   l_right_pad := RPAD(' ', l_pad_size, l_deco);
322  	 END IF;
323  	 RETURN l_right_pad;
324    EXCEPTION
325  	 WHEN OTHERS THEN
326  	   otap_log.log(SQLERRM, l_script, 'Build right decoration');
327  	   RAISE;
328    END right_deco;
329  
330    FUNCTION decorate( p_title	IN VARCHAR2 DEFAULT NULL
331  			, p_decoration	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
332  			, p_min_length	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
333  			, p_layout	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
334  			, p_border	IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
335  			)
336  	 RETURN VARCHAR2
337    IS
338  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.decorate';
339  	 l_deco_length	 INTEGER;
340  	 l_pad_length	 INTEGER;
341  	 l_title_length  INTEGER;
342  	 l_min_length	 INTEGER;
343  	 l_line_size	 INTEGER;
344  	 l_add		 INTEGER;
345  	 l_padding	 INTEGER;
346  	 l_border	 INTEGER;
347  	 l_deco 	 VARCHAR2(1 CHAR);
348  	 l_layout	 VARCHAR2(1 CHAR);
349  	 l_deco_string	 VARCHAR2(32767 CHAR);
350  	 l_title	 VARCHAR2(32767 CHAR);
351    BEGIN
352  	 otap_log.log('Parameter p_title: ' || p_title || ' p_decoration: ' || p_decoration || ' p_min_length: ' || p_min_length || ' p_layout: ' || p_layout || ' p_border: ' || p_border, l_script, 'Call', 'OTAP_DEBUG');
353  	 -- check params, assign defaults
354  	 l_min_length := otap_string.check_line_size(p_min_length);
355  	 l_border     := otap_string.check_border(p_border);
356  	 l_layout     := otap_string.check_layout(p_layout);
357  	 l_deco       := otap_string.check_decoration(p_decoration);
358  	 otap_log.log('After param check l_min_length: ' || l_min_length || ' l_border: ' || l_border || ' l_layout: ' || l_layout || ' l_deco: ' || l_deco, l_script, 'param check section', 'OTAP_DEBUG');
359  	 l_title_length := otap_string.check_title_size(LENGTH(p_title), l_border);
360  	 l_line_size	:= otap_string.line_size(l_title_length, l_border, l_min_length);
361  	 l_title_length := otap_string.max_size(l_title_length, l_line_size, l_border);
362  	 l_title	:= otap_string.reduce(p_title, l_title_length);
363  	 otap_log.log('Current title: ' || l_title || ' calculated title length: ' || l_title_length || ' line size: ' || l_line_size, l_script, 'Calculate title and line size to use', 'OTAP_DEBUG');
364  	 -- build the string
365  	 l_deco_string := otap_string.left_deco(l_title_length, l_line_size, l_deco, l_layout) ||
366  			  l_title ||
367  			  otap_string.right_deco(l_title_length, l_line_size, l_deco, l_layout)
368  	 ;
369  	 RETURN l_deco_string;
370    EXCEPTION
371  	 WHEN OTHERS THEN
372  	   otap_log.log(SQLERRM, l_script, 'Decorate string');
373  	   RAISE;
374    END decorate;
375  
376    FUNCTION borderless( p_string	  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
377  			  , p_min_length  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
378  			  , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT
379  			  )
380  	 RETURN VARCHAR2
381    IS
382  	 l_script      VARCHAR2(256 CHAR) := 'otap_string.borderless';
383  	 l_layout      VARCHAR2(1 CHAR);
384  	 l_min_length  INTEGER;
385  	 l_line_size   INTEGER;
386  	 l_string      VARCHAR2(32767 CHAR);
387    BEGIN
388  	 l_min_length := otap_string.check_line_size(p_min_length);
389  	 l_layout     := otap_string.check_layout(p_layout);
390  	 IF l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
391  	 THEN
392  	   l_layout := otap_constants.OTAP_LAYOUT_LEFT;
393  	 END IF;
394  	 l_line_size   := GREATEST(l_min_length, otap_string.check_string_size(NVL(LENGTH(p_string), 0)));
395  	 l_string      := otap_string.reduce(p_string, l_line_size);
396  	 -- now pad the string for the right or left side
397  	 IF l_layout = otap_constants.OTAP_LAYOUT_RIGHT
398  	 THEN
399  	   l_string := LPAD(l_string, l_line_size, ' ');
400  	 ELSE
401  	   -- middle and left are treated equally
402  	   l_string := RPAD(l_string, l_line_size, ' ');
403  	 END IF;
404  	 RETURN l_string;
405    EXCEPTION
406  	 WHEN OTHERS THEN
407  	   otap_log.log(SQLERRM, l_script, 'Borderless layout');
408  	   RAISE;
409    END borderless;
410  
411    FUNCTION is_sys_object( p_string  IN VARCHAR2
412  			     , p_exclude IN NUMBER   DEFAULT 1
413  			     )
414  	 RETURN BOOLEAN
415    IS
416  	 l_script VARCHAR2(256 CHAR) := 'otap_string.is_sys_object';
417  	 l_return BOOLEAN;
418    BEGIN
419  	 l_return := FALSE;
420  	 IF NVL(p_exclude, 1) != 0
421  	 THEN
422  	   l_return := (UPPER(SUBSTR(TRIM(p_string), 1, 4)) = 'SYS_' OR INSTR(p_string, '$') > 0 OR INSTR(p_string, '#') > 0);
423  	 END IF;
424  	 RETURN l_return;
425    EXCEPTION
426  	 WHEN OTHERS THEN
427  	   otap_log.log(SQLERRM, l_script, 'Identify sys object');
428  	   RETURN FALSE;
429    END is_sys_object;
430  
431  END;
