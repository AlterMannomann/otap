SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_schema
  2  AS
  3  
  4    FUNCTION count_chk( p_count   IN      INTEGER
  5  			 , o_errors  IN OUT  VARCHAR2
  6  			 , p_caller  IN      VARCHAR2
  7  			 )
  8  	 RETURN INTEGER
  9    IS
 10  	 l_return INTEGER;
 11    BEGIN
 12  	   l_return := CASE p_count
 13  			 WHEN 0
 14  			 THEN otap_constants.OTAP_NUM_TEST_FAILED
 15  			 WHEN 1
 16  			 THEN otap_constants.OTAP_NUM_TEST_PASSED
 17  			 ELSE otap_constants.OTAP_NUM_TEST_UNDEFINED
 18  		       END
 19  	   ;
 20  	   IF p_count NOT IN (0, 1)
 21  	   THEN
 22  	     o_errors := otap_string.reduce('Abnormal count result from ' || p_caller || ' count: ' || p_count, 4000);
 23  	     otap_log.log(o_errors, p_caller, 'Abnormal count result. Expected 0 or 1');
 24  	   END IF;
 25  	   RETURN l_return;
 26    END count_chk;
 27    -- for description see header file
 28    FUNCTION has_table( p_table_name      IN     VARCHAR2
 29  			 , o_errors		OUT VARCHAR2
 30  			 , p_schema	     IN     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 31  			 , p_expected_result IN     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 32  			 )
 33  	 RETURN INTEGER
 34    IS
 35  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_schema.has_table';
 36  	 l_has_table	 INTEGER;
 37  	 l_test_passed	 INTEGER;
 38  	 l_expected	 INTEGER;
 39  	 l_schema_to_use VARCHAR2(128 CHAR);
 40  	 l_table_name	 VARCHAR2(128 CHAR);
 41  	 l_errors	 VARCHAR2(32767 CHAR);
 42    BEGIN
 43  	 l_errors      := NULL;
 44  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 45  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
 46  	 l_table_name  := otap_string.reduce(p_table_name, 128);
 47  	 IF	l_table_name	    IS NOT NULL
 48  	    AND LENGTH(l_table_name) > 0
 49  	 THEN
 50  	   -- check description
 51  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
 52  	   SELECT COUNT(*)
 53  	     INTO l_has_table
 54  	     FROM dba_tables
 55  	    WHERE table_name = l_table_name
 56  	      AND owner      = l_schema_to_use
 57  	   ;
 58  	   -- we should find one or zero entries
 59  	   l_test_passed := count_chk(l_has_table, l_errors, l_script);
 60  	 ELSE
 61  	   -- invalid table name
 62  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 63  	   l_errors	       := 'Missing: p_table_name(NULL)';
 64  	   otap_log.log(l_errors, l_script, 'NULL test on table name');
 65  	 END IF;
 66  	 -- now decide on the expected result the final state and if errors are returned
 67  	 IF l_test_passed != l_expected
 68  	 THEN
 69  	   o_errors := otap_string.reduce(l_errors, 4000);
 70  	 ELSE
 71  	   -- overwrite states from before, as we fulfill expected
 72  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
 73  	   -- overwrite errors expected
 74  	   o_errors := NULL;
 75  	 END IF;
 76  	 RETURN l_test_passed;
 77    EXCEPTION
 78  	 WHEN OTHERS THEN
 79  	   IF SQLCODE != -20099
 80  	   THEN
 81  	     -- log unhandled exceptions
 82  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 83  	   END IF;
 84  	   RAISE;
 85    END has_table;
 86  
 87    FUNCTION has_column( p_table_name      IN     VARCHAR2
 88  			  , p_column_name     IN     VARCHAR2
 89  			  , o_errors		 OUT VARCHAR2
 90  			  , p_schema	      IN     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 91  			  , p_data_type       IN     VARCHAR2 DEFAULT NULL
 92  			  , p_data_length     IN     NUMBER   DEFAULT NULL
 93  			  , p_data_precision  IN     NUMBER   DEFAULT NULL
 94  			  , p_data_scale      IN     NUMBER   DEFAULT NULL
 95  			  , p_nullable	      IN     VARCHAR2 DEFAULT NULL
 96  			  , p_data_default    IN     VARCHAR2 DEFAULT NULL
 97  			  , p_expected_result IN     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 98  			  )
 99  	 RETURN INTEGER
100    IS
101  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_schema.has_column';
102  	 l_has_column	 INTEGER;
103  	 l_test_passed	 INTEGER;
104  	 l_expected	 INTEGER;
105  	 l_schema_to_use VARCHAR2(128 CHAR);
106  	 l_table_name	 VARCHAR2(128 CHAR);
107  	 l_column_name	 VARCHAR2(128 CHAR);
108  	 l_errors	 VARCHAR2(32767 CHAR);
109    BEGIN
110  	 l_errors      := NULL;
111  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
112  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
113  	 l_table_name  := otap_string.reduce(p_table_name, 128);
114  	 l_column_name := otap_string.reduce(p_column_name, 128);
115  	 IF	l_table_name	     IS NOT NULL
116  	    AND LENGTH(l_table_name)  > 0
117  	    AND l_column_name	     IS NOT NULL
118  	    AND LENGTH(l_column_name) > 0
119  	 THEN
120  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
121  	   -- test column exists
122  	   SELECT COUNT(*)
123  	     INTO l_has_column
124  	     FROM dba_tab_columns
125  	    WHERE owner 			     = l_schema_to_use
126  	      AND table_name			     = l_table_name
127  	      AND column_name			     = l_column_name
128  	      AND data_type			     = UPPER(NVL(p_data_type, data_type))
129  	      AND data_length			     = NVL(p_data_length, data_length)
130  	      AND nullable			     = UPPER(NVL(p_nullable, nullable))
131  	      AND NVL(data_precision, -1)	     = NVL(p_data_precision, NVL(data_precision, -1))
132  	      AND NVL(data_scale, -1)		     = NVL(p_data_scale, NVL(data_scale, -1))
133  	      AND TRIM(NVL(data_default_vc, 'n/a'))  = TRIM(NVL(p_data_default, NVL(data_default_vc, 'n/a')))
134  	   ;
135  	   -- we should find one or zero entries
136  	   l_test_passed := count_chk(l_has_column, l_errors, l_script);
137  	 ELSE
138  	   -- invalid table name
139  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
140  	   l_errors	       := 'Missing: ' ||
141  				  CASE
142  				    WHEN l_table_name IS NULL OR LENGTH(l_table_name) = 0
143  				    THEN 'p_table_name(NULL) '
144  				  END ||
145  				  CASE
146  				    WHEN l_column_name IS NULL OR LENGTH(l_column_name) = 0
147  				    THEN 'p_column_name(NULL) '
148  				  END
149  	   ;
150  	   otap_log.log(l_errors, l_script, 'NULL test on table or column name');
151  	 END IF;
152  	 -- now decide on the expected result the final state and if errors are returned
153  	 IF l_test_passed != l_expected
154  	 THEN
155  	   o_errors := otap_string.reduce(l_errors, 4000);
156  	 ELSE
157  	   -- overwrite states from before, as we fulfill expected
158  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
159  	   -- overwrite errors expected
160  	   o_errors := NULL;
161  	 END IF;
162  	 RETURN l_test_passed;
163    EXCEPTION
164  	 WHEN OTHERS THEN
165  	   IF SQLCODE != -20099
166  	   THEN
167  	     -- log unhandled exceptions
168  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
169  	   END IF;
170  	   RAISE;
171    END has_column;
