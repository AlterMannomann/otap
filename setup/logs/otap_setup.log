SQL> CREATE OR REPLACE TRIGGER otap_results_ins_trg
  2    BEFORE INSERT ON otap_results
  3    FOR EACH ROW
  4  BEGIN
  5    :NEW.test_run_date   := SYSTIMESTAMP;
  6    :NEW.test_executor   := SYS_CONTEXT('USERENV', 'SESSION_USER');
  7    IF :NEW.to_delete = otap_constants.OTAP_NUM_TRUE
  8    THEN
  9  	 :NEW.deleted	 := SYSTIMESTAMP;
 10  	 :NEW.deleted_by := SYS_CONTEXT('USERENV', 'SESSION_USER');
 11    ELSE
 12  	 :NEW.deleted	 := NULL;
 13  	 :NEW.deleted_by := NULL;
 14    END IF;
 15  END;
