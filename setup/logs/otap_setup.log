 27    OTAP_CHAR_NA			CONSTANT CHAR(3)	:= 'N/A';
 28    OTAP_VAR_DELIMITER		CONSTANT CHAR(1)	:= '@';
 29  
 30    -- no get functions for the following constants
 31    -- internal otap constants only usable within PLSQL
 32    OTAP_LF				CONSTANT CHAR(1)	:= CHR(10);
 33    -- default fix name delimiter, $ and # are not recommended by Oracle and therefore not configurable
 34    OTAP_CFG_DEBUG_MODE		CONSTANT CHAR(10)	:= 'DEBUG_MODE';
 35    OTAP_CFG_DEFAULT_PREFIX		CONSTANT CHAR(14)	:= 'DEFAULT_PREFIX';
