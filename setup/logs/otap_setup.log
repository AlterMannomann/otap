483    PROCEDURE otap_session_add_test( p_test_passed  IN NUMBER
484  				      , o_otap_session IN OUT NOCOPY OTAP_SESSION
485  				      )
486    IS
487  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_add_test';
