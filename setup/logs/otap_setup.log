 40  			 , p_test_name		 IN	       VARCHAR2
 41  			 , p_prefix		 IN	       VARCHAR2
 42  			 , p_language_id	 IN	       VARCHAR2
 43  			 , p_name_precedence	 IN	       NUMBER
 44  			 , p_include_pkg	 IN	       NUMBER
 45  			 , p_persist		 IN	       NUMBER
 46  			 , p_schema		 IN	       VARCHAR2
 47  			 , p_user		 IN	       VARCHAR2
 48  			 , p_executor		 IN	       VARCHAR2
 49  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
 50  			 )
 51  	 RETURN VARCHAR2
 52    ;
 53  
 54    /** FUNCTION otap_api.finish_test
 55    * @see otap_plan.finish_test and otap_test.finish_test
