SQL> CREATE OR REPLACE PACKAGE BODY otap_string
  2  AS
  3    -- for description see header file
  4    FUNCTION reduce( p_string VARCHAR2 DEFAULT NULL
  5  		      , p_size	 INTEGER  DEFAULT 0
  6  		      )
  7  	 RETURN VARCHAR2
  8    IS
  9  	 l_script VARCHAR2(256 CHAR) := 'otap_string.reduce';
 10  	 l_string VARCHAR2(32767 CHAR);
 11    BEGIN
 12  	 l_string := CASE WHEN LENGTH(TRIM(p_string)) > p_size THEN TRIM(SUBSTR(TRIM(p_string), 1, p_size)) ELSE TRIM(p_string) END;
 13  	 RETURN l_string;
 14    EXCEPTION
 15  	 WHEN OTHERS THEN
 16  	   otap_log.log(SQLERRM, l_script, 'CASE WHEN LENGTH(TRIM(p_string)) > p_size THEN TRIM(SUBSTR(TRIM(p_string), 1, p_size)) ELSE TRIM(p_string) END');
 17  	   RAISE;
 18    END reduce;
 19  
 20    FUNCTION cut( p_string VARCHAR2 DEFAULT NULL
 21  		   , p_size   INTEGER  DEFAULT 0
 22  		   )
 23  	 RETURN VARCHAR2
 24    IS
 25  	 l_script VARCHAR2(256 CHAR) := 'otap_string.cut';
 26  	 l_string VARCHAR2(32767 CHAR);
 27    BEGIN
 28  	 l_string := CASE WHEN LENGTH(p_string) > p_size THEN SUBSTR(p_string, 1, p_size) ELSE p_string END;
 29  	 RETURN l_string;
 30    EXCEPTION
 31  	 WHEN OTHERS THEN
 32  	   otap_log.log(SQLERRM, l_script, 'CASE WHEN LENGTH(p_string) > p_size THEN SUBSTR(p_string, 1, p_size) ELSE p_string END');
 33  	   RAISE;
 34    END cut;
 35  
 36    FUNCTION flatten( p_string VARCHAR2 DEFAULT NULL
 37  		       , p_size   INTEGER  DEFAULT 0
 38  		       )
 39  	 RETURN VARCHAR2
 40    IS
 41  	 l_script VARCHAR2(256 CHAR) := 'otap_string.flatten';
 42  	 l_string VARCHAR2(32767 CHAR);
 43    BEGIN
 44  	 l_string := REGEXP_REPLACE(p_string, '\s{2,}', ' ');
 45  	 l_string := CASE WHEN LENGTH(l_string) > p_size THEN SUBSTR(l_string, 1, p_size) ELSE l_string END;
 46  	 RETURN l_string;
 47    EXCEPTION
 48  	 WHEN OTHERS THEN
 49  	   otap_log.log(SQLERRM, l_script, 'Flatten and cut the given string, remove useless white space chars');
 50  	   RAISE;
 51    END flatten;
 52  
 53    FUNCTION check_border(p_border IN INTEGER DEFAULT otap_constants.OTAP_FALLBACK_BORDER)
 54  	 RETURN NUMBER
 55    IS
 56  	 l_script VARCHAR2(256 CHAR) := 'otap_string.check_border';
 57  	 l_border INTEGER;
 58    BEGIN
 59  	 IF NVL(p_border, otap_constants.OTAP_FALLBACK_BORDER) NOT BETWEEN 2 AND 10
 60  	 THEN
 61  	   l_border := otap_constants.OTAP_FALLBACK_BORDER;
 62  	 ELSE
 63  	   l_border := NVL(p_border, otap_constants.OTAP_FALLBACK_BORDER);
 64  	 END IF;
 65  	 RETURN l_border;
 66    EXCEPTION
 67  	 WHEN OTHERS THEN
 68  	   otap_log.log(SQLERRM, l_script, 'Check border constraints');
 69  	   RAISE;
 70    END check_border;
 71  
 72    FUNCTION check_line_size(p_line_size IN INTEGER DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH)
 73  	 RETURN NUMBER
 74    IS
 75  	 l_script    VARCHAR2(256 CHAR) := 'otap_string.check_line_size';
 76  	 l_line_size INTEGER;
 77    BEGIN
 78  	 IF NVL(p_line_size, otap_constants.OTAP_NUM_MIN_FILL_LENGTH) NOT BETWEEN otap_constants.OTAP_NUM_MIN_FILL_LENGTH AND otap_constants.OTAP_NUM_MAX_FILL_LENGTH
 79  	 THEN
 80  	   IF p_line_size > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
 81  	   THEN
 82  	     l_line_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH;
 83  	   ELSE
 84  	     l_line_size := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
 85  	   END IF;
 86  	 ELSE
 87  	   l_line_size := NVL(p_line_size, otap_constants.OTAP_NUM_MIN_FILL_LENGTH);
 88  	 END IF;
 89  	 RETURN l_line_size;
 90    EXCEPTION
 91  	 WHEN OTHERS THEN
 92  	   otap_log.log(SQLERRM, l_script, 'Check line size constraints');
 93  	   RAISE;
 94    END check_line_size;
 95  
 96    FUNCTION check_title_size( p_title_length IN INTEGER DEFAULT 0
 97  				, p_border	 IN INTEGER DEFAULT otap_constants.OTAP_FALLBACK_BORDER
 98  				)
 99  	 RETURN NUMBER
100    IS
101  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.check_title_size';
102  	 l_title_size INTEGER;
103  	 l_border     INTEGER;
104    BEGIN
105  	 l_border := otap_string.check_border(p_border);
106  	 IF (NVL(p_title_length, 0) + (l_border * 2)) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
107  	 THEN
108  	   l_title_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH - (l_border * 2);
109  	 ELSE
110  	   l_title_size := GREATEST(NVL(p_title_length, 0), 0);
111  	 END IF;
112  	 RETURN l_title_size;
113    EXCEPTION
114  	 WHEN OTHERS THEN
115  	   otap_log.log(SQLERRM, l_script, 'Check title size constraints');
116  	   RAISE;
117    END check_title_size;
118  
119    FUNCTION check_string_size(p_string_length IN INTEGER DEFAULT 0)
120  	 RETURN NUMBER
121    IS
122  	 l_script      VARCHAR2(256 CHAR) := 'otap_string.check_string_size';
123  	 l_string_size INTEGER;
124    BEGIN
125  	 IF NVL(p_string_length, 0) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
126  	 THEN
127  	   l_string_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH;
128  	 ELSIF NVL(p_string_length, 0) < otap_constants.OTAP_NUM_MIN_FILL_LENGTH
129  	 THEN
130  	   l_string_size := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
131  	 ELSE
132  	   l_string_size := NVL(p_string_length, 0);
133  	 END IF;
134  	 RETURN l_string_size;
135    EXCEPTION
136  	 WHEN OTHERS THEN
137  	   otap_log.log(SQLERRM, l_script, 'Check string size constraints');
138  	   RAISE;
139    END check_string_size;
140  
141    FUNCTION check_layout(p_layout IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT)
142  	 RETURN VARCHAR2
143    IS
144  	 l_script VARCHAR2(256 CHAR) := 'otap_string.check_layout';
145  	 l_layout VARCHAR2(1 CHAR);
146    BEGIN
147  	 l_layout := CASE
148  		       WHEN p_layout IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
149  		       THEN p_layout
150  		       ELSE otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
151  		     END
152  	 ;
153  	 RETURN l_layout;
154    EXCEPTION
155  	 WHEN OTHERS THEN
156  	   otap_log.log(SQLERRM, l_script, 'Check layout constraints');
157  	   RAISE;
158    END check_layout;
159  
160    FUNCTION check_decoration(p_decoration IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR)
161  	 RETURN VARCHAR2
162    IS
163  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.check_decoration';
164  	 l_decoration VARCHAR2(1 CHAR);
165    BEGIN
166  	 l_decoration := SUBSTR(NVL(p_decoration, otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR), 1, 1);
167  	 RETURN l_decoration;
168    EXCEPTION
169  	 WHEN OTHERS THEN
170  	   otap_log.log(SQLERRM, l_script, 'SUBSTR(NVL(p_decoration, otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR), 1, 1)');
171  	   RAISE;
172    END check_decoration;
173  
174    FUNCTION line_size( p_title_length  IN INTEGER
175  			 , p_border	   IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
176  			 , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
177  			 )
178  	 RETURN INTEGER
179    IS
180  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.line_size';
181  	 l_length     INTEGER;
182  	 l_border     INTEGER;
183  	 l_line_size  INTEGER;
184  	 l_title_size INTEGER;
185  	 l_calc_size  INTEGER;
186    BEGIN
187  	 l_border     := otap_string.check_border(p_border);
188  	 l_line_size  := otap_string.check_line_size(p_min_fill);
189  	 IF NVL(p_title_length, 0) > (otap_constants.OTAP_NUM_MIN_FILL_LENGTH - (l_border * 2))
190  	 THEN
191  	   -- only calculate, if a title length exceeds min length
192  	   l_title_size := otap_string.check_title_size(p_title_length, l_border);
193  	   l_calc_size	:= l_title_size + (l_border * 2);
194  	   l_length	:= GREATEST(NVL(l_calc_size, 0), l_line_size);
195  	   IF l_length < otap_constants.OTAP_NUM_MIN_FILL_LENGTH
196  	   THEN
197  	     l_length := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
198  	   ELSIF l_length > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
199  	   THEN
200  	     l_length := otap_constants.OTAP_NUM_MAX_FILL_LENGTH;
201  	   END IF;
202  	 ELSE
203  	   -- respect min length
204  	   l_length := GREATEST(otap_constants.OTAP_NUM_MIN_FILL_LENGTH, NVL(p_min_fill, 0));
205  	 END IF;
206  	 RETURN l_length;
207    EXCEPTION
208  	 WHEN OTHERS THEN
209  	   otap_log.log(SQLERRM, l_script, 'Calculate decorated line size');
210  	   RAISE;
211    END line_size;
212  
213    FUNCTION max_size( p_title_length IN INTEGER
214  			, p_line_size	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
215  			, p_border	 IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
216  			)
217  	 RETURN INTEGER
218    IS
219  	 l_script VARCHAR2(256 CHAR) := 'otap_string.max_size';
220  	 l_title_length INTEGER;
221  	 l_line_size	INTEGER;
222  	 l_border	INTEGER;
223  	 l_max_size	INTEGER;
224    BEGIN
225  	 l_line_size	:= otap_string.check_line_size(p_line_size);
226  	 l_border	:= otap_string.check_border(p_border);
227  	 l_title_length := otap_string.check_title_size(p_title_length, l_border);
228  	 IF l_title_length <= 0
229  	 THEN
230  	   l_max_size := 0;
231  	 ELSE
232  	   IF (l_title_length + (l_border * 2)) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
233  	   THEN
234  	     l_max_size := otap_constants.OTAP_NUM_MAX_FILL_LENGTH - (l_border * 2);
235  	   ELSE
236  	     l_max_size := l_title_length;
237  	   END IF;
238  	 END IF;
239  	 RETURN l_max_size;
240    EXCEPTION
241  	 WHEN OTHERS THEN
242  	   otap_log.log(SQLERRM, l_script, 'Calculate maximum title size');
243  	   RAISE;
244    END max_size;
245  
246    FUNCTION left_deco( p_title_length IN INTEGER  DEFAULT 0
247  			 , p_min_fill	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
248  			 , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
249  			 , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
250  			 , p_border	  IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
251  			 )
252  	 RETURN VARCHAR2
253    IS
254  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.left_deco';
255  	 l_deco 	 VARCHAR2(1 CHAR);
256  	 l_layout	 VARCHAR2(1 CHAR);
257  	 l_border	 INTEGER;
258  	 l_pad_size	 INTEGER;
259  	 l_min_fill	 INTEGER;
260  	 l_line_size	 INTEGER;
261  	 l_title_length  INTEGER;
262  	 l_left_pad	 VARCHAR2(32767 CHAR);
263    BEGIN
264  	 l_min_fill	 := otap_string.check_line_size(p_min_fill);
265  	 l_deco 	 := otap_string.check_decoration(p_decoration);
266  	 l_border	 := otap_string.check_border(p_border);
267  	 l_layout	 := otap_string.check_layout(p_layout);
268  	 l_title_length  := otap_string.check_title_size(p_title_length, l_border);
269  	 l_line_size	 := otap_string.line_size(l_title_length, l_border, l_min_fill);
270  	 -- if defaults we should have now a line size between 80 and 4000, a border between 2 and 10, a valid deco and a valid layout.
271  	 l_pad_size := CASE
272  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
273  			 THEN l_border
274  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
275  			 THEN l_line_size - (l_title_length + l_border)
276  			 ELSE FLOOR((l_line_size - l_title_length) / 2)
277  		       END
278  	 ;
279  	 IF l_title_length = 0
280  	 THEN
281  	   l_left_pad := LPAD(l_deco, l_pad_size, l_deco);
282  	 ELSE
283  	   l_left_pad := LPAD(' ', l_pad_size, l_deco);
284  	 END IF;
285  	 RETURN l_left_pad;
286    EXCEPTION
287  	 WHEN OTHERS THEN
288  	   otap_log.log(SQLERRM, l_script, 'Build left decoration');
289  	   RAISE;
290    END left_deco;
291  
292    FUNCTION right_deco( p_title_length IN INTEGER  DEFAULT 0
293  			  , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
294  			  , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
295  			  , p_layout	   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
296  			  , p_border	   IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
297  			  )
298  	 RETURN VARCHAR2
299    IS
300  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.right_deco';
301  	 l_deco 	 VARCHAR2(1 CHAR);
302  	 l_layout	 VARCHAR2(1 CHAR);
303  	 l_border	 INTEGER;
304  	 l_pad_size	 INTEGER;
305  	 l_min_fill	 INTEGER;
306  	 l_line_size	 INTEGER;
307  	 l_title_length  INTEGER;
308  	 l_right_pad	 VARCHAR2(32767 CHAR);
309    BEGIN
310  	 l_min_fill	 := otap_string.check_line_size(p_min_fill);
311  	 l_deco 	 := otap_string.check_decoration(p_decoration);
312  	 l_border	 := otap_string.check_border(p_border);
313  	 l_layout	 := otap_string.check_layout(p_layout);
314  	 l_title_length  := otap_string.check_title_size(p_title_length, l_border);
315  	 l_line_size	 := otap_string.line_size(l_title_length, l_border, l_min_fill);
316  	 l_pad_size := CASE
317  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
318  			 THEN l_line_size - (l_title_length + l_border)
319  			 WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
320  			 THEN l_border
321  			 ELSE FLOOR((l_line_size - l_title_length) / 2) + MOD((l_line_size - l_title_length), 2)
322  		       END
323  	 ;
324  	 IF l_title_length = 0
325  	 THEN
326  	   l_right_pad := RPAD(l_deco, l_pad_size, l_deco);
327  	 ELSE
328  	   l_right_pad := RPAD(' ', l_pad_size, l_deco);
329  	 END IF;
330  	 RETURN l_right_pad;
331    EXCEPTION
332  	 WHEN OTHERS THEN
333  	   otap_log.log(SQLERRM, l_script, 'Build right decoration');
334  	   RAISE;
335    END right_deco;
336  
337    FUNCTION decorate( p_title	IN VARCHAR2 DEFAULT NULL
338  			, p_decoration	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
339  			, p_min_length	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
340  			, p_layout	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
341  			, p_border	IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
342  			)
343  	 RETURN VARCHAR2
344    IS
345  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.decorate';
346  	 l_deco_length	 INTEGER;
347  	 l_pad_length	 INTEGER;
348  	 l_title_length  INTEGER;
349  	 l_min_length	 INTEGER;
350  	 l_line_size	 INTEGER;
351  	 l_add		 INTEGER;
352  	 l_padding	 INTEGER;
353  	 l_border	 INTEGER;
354  	 l_deco 	 VARCHAR2(1 CHAR);
355  	 l_layout	 VARCHAR2(1 CHAR);
356  	 l_deco_string	 VARCHAR2(32767 CHAR);
357  	 l_title	 VARCHAR2(32767 CHAR);
358    BEGIN
359  	 otap_log.log('Parameter p_title: ' || p_title || ' p_decoration: ' || p_decoration || ' p_min_length: ' || p_min_length || ' p_layout: ' || p_layout || ' p_border: ' || p_border, l_script, 'Call', 'OTAP_DEBUG');
360  	 -- check params, assign defaults
361  	 l_min_length := otap_string.check_line_size(p_min_length);
362  	 l_border     := otap_string.check_border(p_border);
363  	 l_layout     := otap_string.check_layout(p_layout);
364  	 l_deco       := otap_string.check_decoration(p_decoration);
365  	 otap_log.log('After param check l_min_length: ' || l_min_length || ' l_border: ' || l_border || ' l_layout: ' || l_layout || ' l_deco: ' || l_deco, l_script, 'param check section', 'OTAP_DEBUG');
366  	 l_title_length := otap_string.check_title_size(LENGTH(p_title), l_border);
367  	 l_line_size	:= otap_string.line_size(l_title_length, l_border, l_min_length);
368  	 l_title_length := otap_string.max_size(l_title_length, l_line_size, l_border);
369  	 l_title	:= otap_string.reduce(p_title, l_title_length);
370  	 otap_log.log('Current title: ' || l_title || ' calculated title length: ' || l_title_length || ' line size: ' || l_line_size, l_script, 'Calculate title and line size to use', 'OTAP_DEBUG');
371  	 -- build the string
372  	 l_deco_string := otap_string.left_deco(l_title_length, l_line_size, l_deco, l_layout, l_border) ||
373  			  l_title ||
374  			  otap_string.right_deco(l_title_length, l_line_size, l_deco, l_layout, l_border)
375  	 ;
376  	 RETURN l_deco_string;
377    EXCEPTION
378  	 WHEN OTHERS THEN
379  	   otap_log.log(SQLERRM, l_script, 'Decorate string');
380  	   RAISE;
381    END decorate;
382  
383    FUNCTION decorate_blank( p_string      IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
384  			      , p_min_length  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
385  			      )
386  	 RETURN VARCHAR2
387    IS
388  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.decorate_blank';
389  	 l_title_length  INTEGER;
390  	 l_min_length	 INTEGER;
391  	 l_line_size	 INTEGER;
392  	 l_padding	 INTEGER;
393  	 l_deco 	 VARCHAR2(1 CHAR);
394  	 l_deco_string	 VARCHAR2(32767 CHAR);
395  	 l_title	 VARCHAR2(32767 CHAR);
396    BEGIN
397  	 -- check params, assign defaults
398  	 l_min_length	 := otap_string.check_line_size(p_min_length);
399  	 l_deco 	 := ' ';
400  	 l_title	 := NVL(p_string, otap_constants.OTAP_INTERNAL_ERROR);
401  	 l_title_length  := LENGTH(l_title);
402  	 l_line_size	 := GREATEST(l_min_length, l_title_length);
403  	 l_line_size	 := CASE WHEN l_line_size <= otap_constants.OTAP_NUM_MAX_FILL_LENGTH THEN l_line_size ELSE otap_constants.OTAP_NUM_MAX_FILL_LENGTH END;
404  	 l_line_size	 := CASE WHEN l_line_size >= otap_constants.OTAP_NUM_MIN_FILL_LENGTH THEN l_line_size ELSE otap_constants.OTAP_NUM_MIN_FILL_LENGTH END;
405  	 l_title	 := otap_string.reduce(l_title, l_line_size);
406  	 IF l_title_length < l_line_size
407  	 THEN
408  	   -- padding with middle layout
409  	   l_padding	 := FLOOR((l_line_size - l_title_length) / 2);
410  	   l_deco_string := LPAD(l_deco, l_padding, l_deco) || l_title;
411  	   l_deco_string := RPAD(l_deco_string, l_line_size, l_deco);
412  	 ELSE
413  	   -- no padding, fills the line
414  	   l_deco_string := l_title;
415  	 END IF;
416  	 RETURN l_deco_string;
417    EXCEPTION
418  	 WHEN OTHERS THEN
419  	   otap_log.log(SQLERRM, l_script, 'Decorate string with blank');
420  	   RAISE;
421    END decorate_blank;
422  
423    FUNCTION borderless( p_string	  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
424  			  , p_min_length  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
425  			  , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT
426  			  )
427  	 RETURN VARCHAR2
428    IS
429  	 l_script      VARCHAR2(256 CHAR) := 'otap_string.borderless';
430  	 l_layout      VARCHAR2(1 CHAR);
431  	 l_min_length  INTEGER;
432  	 l_line_size   INTEGER;
433  	 l_string      VARCHAR2(32767 CHAR);
434    BEGIN
435  	 l_min_length := otap_string.check_line_size(p_min_length);
436  	 l_layout     := otap_string.check_layout(p_layout);
437  	 IF l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
438  	 THEN
439  	   l_layout := otap_constants.OTAP_LAYOUT_LEFT;
440  	 END IF;
441  	 l_line_size   := GREATEST(l_min_length, otap_string.check_string_size(NVL(LENGTH(p_string), 0)));
442  	 l_string      := otap_string.reduce(p_string, l_line_size);
443  	 -- if null (e.g. p_string was a space char), no need to recheck linesize as min length is active in that case
444  	 l_string      := NVL(l_string, otap_constants.OTAP_INTERNAL_NA);
445  	 -- now pad the string for the right or left side
446  	 IF l_layout = otap_constants.OTAP_LAYOUT_RIGHT
447  	 THEN
448  	   l_string := LPAD(l_string, l_line_size, ' ');
449  	 ELSE
450  	   -- middle and left are treated equally
451  	   l_string := RPAD(l_string, l_line_size, ' ');
452  	 END IF;
453  	 RETURN l_string;
454    EXCEPTION
455  	 WHEN OTHERS THEN
456  	   otap_log.log(SQLERRM, l_script, 'Borderless layout');
457  	   RAISE;
458    END borderless;
459  
460    FUNCTION is_sys_object( p_string  IN VARCHAR2
461  			     , p_exclude IN NUMBER   DEFAULT 1
462  			     )
463  	 RETURN BOOLEAN
464    IS
465  	 l_script VARCHAR2(256 CHAR) := 'otap_string.is_sys_object';
466  	 l_return BOOLEAN;
467    BEGIN
468  	 l_return := FALSE;
469  	 IF NVL(p_exclude, 1) != 0
470  	 THEN
471  	   l_return := (UPPER(SUBSTR(TRIM(p_string), 1, 4)) = 'SYS_' OR INSTR(p_string, '$') > 0 OR INSTR(p_string, '#') > 0);
472  	 END IF;
473  	 RETURN l_return;
474    EXCEPTION
475  	 WHEN OTHERS THEN
476  	   otap_log.log(SQLERRM, l_script, 'Identify sys object');
477  	   RETURN FALSE;
478    END is_sys_object;
479  
480  END;
