509    FUNCTION constraint_type_to_label(p_constraint_type IN VARCHAR2 DEFAULT 'C')
510  	 RETURN VARCHAR2
511    IS
512  	 l_label VARCHAR2(128 CHAR);
513    BEGIN
514  	 l_label := CASE UPPER(p_constraint_type)
515  		      WHEN 'P'
516  		      THEN otap_util.CFG_LABEL_PRIMARY_KEY
517  		      WHEN 'U'
518  		      THEN otap_util.CFG_LABEL_UNIQUE_KEY
519  		      WHEN 'R'
520  		      THEN otap_util.CFG_LABEL_FOREIGN_KEY
521  		      WHEN 'V'
522  		      THEN otap_util.CFG_LABEL_VIEW_CHECK
523  		      WHEN 'O'
524  		      THEN otap_util.CFG_LABEL_VIEW_READONLY
525  		      WHEN 'F'
526  		      THEN otap_util.CFG_LABEL_REF_COLUMN
527  		      WHEN 'H'
528  		      THEN otap_util.CFG_LABEL_HASH
529  		      WHEN 'S'
530  		      THEN otap_util.CFG_LABEL_SUPPLEMENTAL_LOGGGING
531  		      WHEN 'C'
532  		      THEN otap_util.CFG_LABEL_CHECK
533  		      ELSE NULL
534  		    END
535  	 ;
536  	 IF l_label IS NULL
537  	 THEN
538  	   -- log error
539  	   otap_log.log('Invalid constraint type', 'otap_util.constraint_type_to_label', 'Given:' || NVL(p_constraint_type, 'NULL'));
540  	   l_label := otap_util.CFG_LABEL_INVALID_CONSTRAINT_TYPE;
541  	 END IF;
542  	 RETURN l_label;
543    EXCEPTION
544  	 WHEN OTHERS THEN
545  	   otap_log.log(SQLERRM, 'otap_util.constraint_type_to_label', 'Translate constraint type to label id');
546  	   RAISE;
547    END constraint_type_to_label;
