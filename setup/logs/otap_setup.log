426    /** FUNCTION otap_test.has_ref_constraint
427    * Checks if a given table has a reference constraint. You may also use has_constraint. But if you want to check the
428    * referenced owner, constraint, column and table, you have to use this function.
429    *
430    * @param p_table_name Mandatory. The table to be checked for the reference constraint, take as is. Case sensitive.
431    * @param p_constraint_type Mandatory. A valid ref constraint type. Not case sensitive. Only 'R' and 'F' allowed, 'R' on invalid or empty values.
432    * @param p_column_name Optional. The column that is part of the reference constraint. Case sensitive.
433    * @param p_constraint Optional. The name of the reference constraint. Case sensitive.
434    * @param p_schema A schema override of the current test session if needed, taken as is. If given the table and constraint must exist in this schema. Case sensitive.
435    * @param p_r_table_name Optional. The referenced table of the reference constraint, take as is. Case sensitive.
436    * @param p_r_column_name Optional. The referenced column that is part of the reference constraint. Case sensitive.
437    * @param p_r_constraint Optional. The name of the referenced constraint by the reference constraint. Case sensitive.
438    * @param p_r_schema Optional. The reference schema of the constraint. Case sensitive.
439    * @param p_description The test description if any. If not given, a description is generated, see template.
440    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
441    *
442    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
443    */
444    FUNCTION has_ref_constraint( p_table_name      IN VARCHAR2
445  				  , p_constraint_type IN VARCHAR2 DEFAULT 'R'
446  				  , p_column_name     IN VARCHAR2 DEFAULT NULL
447  				  , p_constraint      IN VARCHAR2 DEFAULT NULL
448  				  , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
449  				  , p_r_table_name    IN VARCHAR2 DEFAULT NULL
450  				  , p_r_column_name   IN VARCHAR2 DEFAULT NULL
451  				  , p_r_constraint    IN VARCHAR2 DEFAULT NULL
452  				  , p_r_schema	      IN VARCHAR2 DEFAULT NULL
453  				  , p_description     IN VARCHAR2 DEFAULT NULL
454  				  , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
455  				  )
456  	 RETURN VARCHAR2
457    ;
