2927  	FUNCTION get_dba_col_details( p_table_name  IN VARCHAR2
2928  				    , p_column_name IN VARCHAR2
2929  				    , p_msg_type    IN NUMBER	DEFAULT 0
2930  				    )
2931  	  RETURN VARCHAR2
2932  	IS
2933  	  PRAGMA AUTONOMOUS_TRANSACTION;
2934  	  l_count     INTEGER;
2935  	  l_data_type sys.dba_tab_columns.data_type%TYPE;
2936  	  l_nullable  sys.dba_tab_columns.nullable%TYPE;
2937  	  l_char_len  sys.dba_tab_columns.char_length%TYPE;
2938  	  l_statement VARCHAR2(32767 CHAR);
2939  	  l_return    VARCHAR2(4000 CHAR);
2940  	  l_dba_table VARCHAR2(128 CHAR);
2941  	  l_dba_col   VARCHAR2(128 CHAR);
2942  	BEGIN
2943  	  IF	 p_table_name  IS NOT NULL
2944  	     AND p_column_name IS NOT NULL
2945  	  THEN
2946  	    l_dba_table := otap_string.reduce(UPPER(p_table_name), 128);
2947  	    l_dba_col	:= otap_string.reduce(UPPER(p_column_name), 128);
2948  	    SELECT COUNT(*)
2949  	      INTO l_count
2950  	      FROM dba_tab_columns
2951  	     WHERE owner = 'SYS'
2952  	       AND table_name	= l_dba_table
2953  	       AND column_name	= l_dba_col
2954  	       AND data_type   IN ('VARCHAR2', 'DATE', 'NUMBER')
2955  	    ;
2956  	    IF l_count = 0
2957  	    THEN
2958  	      l_return := 'Invalid column or table name or datatype not supported';
2959  	    ELSE
2960  	      -- get column details
2961  	      SELECT data_type
2962  		   , nullable
2963  		   , char_length
2964  		INTO l_data_type
2965  		   , l_nullable
2966  		   , l_char_len
2967  		FROM dba_tab_columns
2968  	       WHERE owner = 'SYS'
2969  		 AND table_name   = l_dba_table
2970  		 AND column_name  = l_dba_col
2971  		 AND data_type	 IN ('VARCHAR2', 'DATE', 'NUMBER')
2972  	      ;
2973  	      IF NVL(p_msg_type, 0) = 0
2974  	      THEN
2975  		IF l_nullable = 'N'
2976  		THEN
2977  		  l_return := LOWER(l_dba_col) || ' -- not nullable';
2978  		  -- determine valid NULL substition
2979  		  IF l_data_type = 'VARCHAR2'
2980  		  THEN
2981  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = ''n/a'' AND ' || l_dba_col || ' IS NOT NULL';
2982  		    EXECUTE IMMEDIATE l_statement INTO l_count;
2983  		    l_return := l_return || CASE WHEN l_count = 0 THEN ' n/a valid substitute' ELSE ' n/a not working as substitute' END;
2984  		  ELSIF l_data_type = 'NUMBER'
2985  		  THEN
2986  		    -- verify -1 is usable
2987  		    l_statement := 'SELECT MIN(' || l_dba_col || ') FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' IS NOT NULL';
2988  		    EXECUTE IMMEDIATE l_statement INTO l_count;
2989  		    l_return := l_return || CASE WHEN l_count >= 0 THEN ' -1 valid substitute' ELSE ' -1 not working as substitute' END;
2990  		  ELSE
2991  		    -- verify 01.01.1900 is usable
2992  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') AND ' || l_dba_col || ' IS NOT NULL';
2993  		    EXECUTE IMMEDIATE l_statement INTO l_count;
2994  		    l_return := l_return || CASE WHEN l_count = 0 THEN ' TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') valid substitute' ELSE ' TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') not working as substitute' END;
2995  		  END IF;
2996  		ELSE
2997  		  -- determine valid NULL substition
2998  		  IF l_data_type = 'VARCHAR2'
2999  		  THEN
3000  		    -- verify n/a is not used in the given field for the given table and column
3001  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = ''n/a'' AND ' || l_dba_col || ' IS NOT NULL';
3002  		    EXECUTE IMMEDIATE l_statement INTO l_count;
3003  		    l_return := 'NVL(' || LOWER(l_dba_col) || ', ''n/a'')';
3004  		    IF l_count != 0
3005  		    THEN
3006  		      l_return := l_return || ' -- n/a not save, substitute the value by a value that is not contained in the column';
3007  		    END IF;
3008  		  ELSIF l_data_type = 'NUMBER'
3009  		  THEN
3010  		    -- verify -1 is usable
3011  		    l_statement := 'SELECT MIN(' || l_dba_col || ') FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' IS NOT NULL';
3012  		    EXECUTE IMMEDIATE l_statement INTO l_count;
3013  		    l_return := 'NVL(' || LOWER(l_dba_col) || ', -1)';
3014  		    IF l_count < 0
3015  		    THEN
3016  		      l_return := l_return || ' -- -1 not save, substitute the value by a value that is not contained in the column';
3017  		    END IF;
3018  		  ELSE
3019  		    -- verify 01.01.1900 is usable
3020  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') AND ' || l_dba_col || ' IS NOT NULL';
3021  		    EXECUTE IMMEDIATE l_statement INTO l_count;
3022  		    l_return := 'NVL(' || LOWER(l_dba_col) || ', TO_DATE(''01.01.1900'', ''DD.MM.YYYY''))';
3023  		    IF l_count != 0
3024  		    THEN
3025  		      l_return := l_return || ' -- 01.01.1900 not save, substitute the value by a value that is not contained in the column';
3026  		    END IF;
3027  		  END IF;
3028  		END IF;
3029  	      ELSE
3030  		-- variable declaration
3031  		l_return := 'l_' || LOWER(l_dba_col) || ' ' || l_data_type ||
3032  			    CASE WHEN l_data_type = 'VARCHAR2' THEN '(' || TRIM(TO_CHAR(l_char_len)) || ' CHAR)' END || ';'
3033  		;
3034  	      END IF;
3035  	    END IF;
3036  	  ELSE
3037  	    l_return := 'Try using NOT NULL values for both parameters';
3038  	  END IF;
3039  	  RETURN l_return;
3040  	END get_dba_col_details;
3041  
3042  END;
3043  /

