SQL> CREATE OR REPLACE TRIGGER otap_config_upd_trg
  2    BEFORE UPDATE ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  , 'FORMAT_HEADER_CHAR'
 13  				  , 'FORMAT_SET_CHAR'
 14  				  , 'FORMAT_GROUP_CHAR'
 15  				  , 'FORMAT_NAME_CHAR'
 16  				  , 'TEXT_TRUE'
 17  				  , 'TEXT_FALSE'
 18  				  , 'TEXT_TRUE_YES'
 19  				  , 'TEXT_FALSE_NO'
 20  				  , 'TEXT_TEST_PASSED'
 21  				  , 'TEXT_TEST_FAILED'
 22  				  , 'TEXT_TEST_UNDEFINED'
 23  				  , 'DEFAULT_PREFIX'
 24  				  , 'DEFAULT_TEST_SET'
 25  				  , 'DEFAULT_TEST_GROUP'
 26  				  , 'DEFAULT_TEST_NAME'
 27  				  , 'DEFAULT_LAYOUT'
 28  				  , 'DEFAULT_RESULT_LAYOUT'
 29  				  , 'DEFAULT_BORDER'
 30  				  , 'TEXT_REPORT_START'
 31  				  , 'TEXT_REPORT_END'
 32  				  , 'TEXT_RESULT_HEADER'
 33  				  , 'FORMAT_RESULT_HEADER'
 34  				  , 'TEXT_SUMMARY_SUCCESS'
 35  				  , 'TEXT_SUMMARY_ERROR'
 36  				  , 'SUMMARY_TEMPLATE'
 37  				  , 'ERRORS_TEMPLATE'
 38  				  , 'ERROR_DETAILS_TEMPLATE'
 39  				  , 'NO_DATA_TEMPLATE'
 40  				  , 'SESSION_ID_TEMPLATE'
 41  				  , 'SET_TEMPLATE'
 42  				  , 'GROUP_TEMPLATE'
 43  				  , 'TEST_NAME_TEMPLATE'
 44  				  , 'RESULT_LINE_TEMPLATE'
 45  				  , 'FN_HAS_TABLE_TEMPLATE'
 46  				  )
 47    THEN
 48  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 49    END IF;
 50    -- remove any leading and trailing blanks from config_value, do not accept NULLS, overwrite with OLD in this case
 51    :NEW.config_value := NVL(TRIM(:NEW.config_value), :OLD.config_value);
 52    -- ensure some values are not overwritten
 53    :NEW.created	   := :OLD.created;
 54    :NEW.created_by	   := :OLD.created_by;
 55    :NEW.created_by_os  := :OLD.created_by_os;
 56    -- check max length if defined
 57    IF :NEW.config_type = 'CHAR'
 58    THEN
 59  	 IF :NEW.config_max_length > 0
 60  	 THEN
 61  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 62  	   THEN
 63  	     RAISE_APPLICATION_ERROR(-20003, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 64  	   END IF;
 65  	 END IF;
 66    END IF;
 67    -- check number type
 68    IF :NEW.config_type = 'NUMBER'
 69    THEN
 70  	 l_ok := TRUE;
 71  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 72  	 BEGIN
 73  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 74  	 EXCEPTION
 75  	   WHEN OTHERS THEN
 76  	     l_ok := FALSE;
 77  	 END;
 78  	 IF NOT l_ok
 79  	 THEN
 80  	   RAISE_APPLICATION_ERROR(-20004, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 81  	 END IF;
 82    END IF;
 83    -- check range if value changed
 84    IF :NEW.config_value != :OLD.config_value
 85    THEN
 86  	 IF :NEW.config_name = 'PRESERVE_DAYS'
 87  	 THEN
 88  	   IF	 TO_NUMBER(:NEW.config_value) > 7
 89  	      OR TO_NUMBER(:NEW.config_value) < 1
 90  	   THEN
 91  	     :NEW.config_value := '1';
 92  	   END IF;
 93  	 END IF;
 94  	 IF :NEW.config_name = 'DELETE_DELAY'
 95  	 THEN
 96  	   IF	 TO_NUMBER(:NEW.config_value) > 600
 97  	      OR TO_NUMBER(:NEW.config_value) < 1
 98  	   THEN
 99  	     :NEW.config_value := '10';
100  	   END IF;
101  	 END IF;
102  	 IF :NEW.config_name = 'DELETE_BATCH_SIZE'
103  	 THEN
104  	   IF	 TO_NUMBER(:NEW.config_value) > 10000
105  	      OR TO_NUMBER(:NEW.config_value) < 100
106  	   THEN
107  	     :NEW.config_value := '1000';
108  	   END IF;
109  	 END IF;
110  	 IF :NEW.config_name = 'DEBUG_MODE'
111  	 THEN
112  	   IF TO_NUMBER(:NEW.config_value) NOT IN (0, 1)
113  	   THEN
114  	     :NEW.config_value := '0';
115  	   END IF;
116  	 END IF;
117  	 IF :NEW.config_name = 'DEFAULT_PREFIX'
118  	 THEN
119  	   IF INSTR(:NEW.config_value, '_') > 0
120  	   THEN
121  	     -- do not change if prefix contains invalid char
122  	     :NEW.config_value := :OLD.config_value;
123  	   END IF;
124  	 END IF;
125  	 -- check layout options
126  	 IF    :NEW.config_name = 'DEFAULT_LAYOUT'
127  	   AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
128  	 THEN
129  	   :NEW.config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
130  	 END IF;
131  	 IF	:NEW.config_name = 'DEFAULT_RESULT_LAYOUT'
132  	    AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
133  	 THEN
134  	   :NEW.config_value := otap_constants.OTAP_LAYOUT_LEFT;
135  	 END IF;
136  	 -- check border options
137  	  IF	 :NEW.config_name = 'DEFAULT_BORDER'
138  	     AND (   TO_NUMBER(:NEW.config_value) < 2
139  		  OR TO_NUMBER(:NEW.config_value) > 10
140  		 )
141  	 THEN
142  	   :NEW.config_value := otap_constants.OTAP_BORDER_DEFAULT;
143  	 END IF;
144    END IF;
145  END;
146  /

