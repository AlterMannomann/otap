 45    OTAP_LABEL_UPPER 		   CONSTANT CHAR(1)	   := 'U';
 46    OTAP_LABEL_LOWER 		   CONSTANT CHAR(1)	   := 'L';
 47    OTAP_LABEL_INIT_CAP		   CONSTANT CHAR(1)	   := 'I';
 48    OTAP_TYPE_VAR			   CONSTANT CHAR(6)	   := '@type@';
 49    OTAP_GEN_TYPE_SCRIPT		   CONSTANT CHAR(1)	   := 'S';
 50    OTAP_GEN_TYPE_FUNCTION		   CONSTANT CHAR(1)	   := 'F';
 51    OTAP_GEN_TYPE_PROCEDURE		   CONSTANT CHAR(1)	   := 'P';
 52    -- otap log needs to know the debug mode access name, therefore in otap_constants, other access identifiers are in otap_util
 53    OTAP_CFG_DEBUG_MODE		   CONSTANT CHAR(10)	   := 'DEBUG_MODE';
 54    -- fallback constants for access failure situations, defaults and checks
 55    OTAP_FALLBACK_BORDER		   CONSTANT INTEGER	   := 5;
 56    OTAP_FALLBACK_BORDER_MIN 	   CONSTANT INTEGER	   := 2;
 57    OTAP_FALLBACK_BORDER_MAX 	   CONSTANT INTEGER	   := 10;
 58    OTAP_FALLBACK_PRESERVE_DAYS	   CONSTANT INTEGER	   := 1;
 59    OTAP_FALLBACK_PRESERVE_DAYS_MIN	   CONSTANT INTEGER	   := 1;
 60    OTAP_FALLBACK_PRESERVE_DAYS_MAX	   CONSTANT INTEGER	   := 7;
 61    OTAP_FALLBACK_DELETE_DELAY	   CONSTANT INTEGER	   := 10;
 62    OTAP_FALLBACK_DELETE_DELAY_MIN	   CONSTANT INTEGER	   := 1;
 63    OTAP_FALLBACK_DELETE_DELAY_MAX	   CONSTANT INTEGER	   := 600;
 64    OTAP_FALLBACK_DELETE_BATCH_SIZE	   CONSTANT INTEGER	   := 1000;
 65    OTAP_FALLBACK_DELETE_BATCH_SIZE_MIN CONSTANT INTEGER	   := 100;
 66    OTAP_FALLBACK_DELETE_BATCH_SIZE_MAX CONSTANT INTEGER	   := 10000;
 67    OTAP_FALLBACK_FORMAT_HEADER_CHAR    CONSTANT CHAR(1)	   := '=';
 68    OTAP_FALLBACK_FORMAT_SET_CHAR	   CONSTANT CHAR(1)	   := '*';
 69    OTAP_FALLBACK_FORMAT_GROUP_CHAR	   CONSTANT CHAR(1)	   := '+';
 70    OTAP_FALLBACK_FORMAT_NAME_CHAR	   CONSTANT CHAR(1)	   := '-';
 71    OTAP_FALLBACK_TEXT_TRUE		   CONSTANT CHAR(4)	   := 'true';
 72    OTAP_FALLBACK_TEXT_FALSE 	   CONSTANT CHAR(5)	   := 'false';
 73    OTAP_FALLBACK_TEXT_TRUE_YES	   CONSTANT CHAR(3)	   := 'Yes';
 74    OTAP_FALLBACK_TEXT_FALSE_NO	   CONSTANT CHAR(2)	   := 'No';
 75    OTAP_FALLBACK_TEXT_TEST_PASSED	   CONSTANT CHAR(6)	   := 'Passed';
 76    OTAP_FALLBACK_TEXT_TEST_FAILED	   CONSTANT CHAR(6)	   := 'FAILED';
 77    OTAP_FALLBACK_TEXT_TEST_UNDEFINED   CONSTANT CHAR(9)	   := 'UNDEFINED';
 78    OTAP_FALLBACK_DEFAULT_PREFIX	   CONSTANT CHAR(4)	   := 'TEST';
 79    OTAP_FALLBACK_DEFAULT_TEST_SET	   CONSTANT CHAR(13)	   := 'OTAP test set';
 80    OTAP_FALLBACK_DEFAULT_TEST_GROUP    CONSTANT CHAR(15)	   := 'OTAP test group';
 81    OTAP_FALLBACK_DEFAULT_TEST_NAME	   CONSTANT CHAR(14)	   := 'OTAP test name';
 82    OTAP_FALLBACK_DEFAULT_LANGUAGE	   CONSTANT CHAR(3)	   := 'en';
 83    OTAP_FALLBACK_LAYOUT_DEFAULT	   CONSTANT CHAR(1)	   := 'M';
 84    OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT CONSTANT CHAR(1)	   := 'L';
 85    OTAP_FALLBACK_LABEL_DEFAULT	   CONSTANT CHAR(1)	   := 'L';
 86    /*====================================== end package constants used by otap ======================================*/
