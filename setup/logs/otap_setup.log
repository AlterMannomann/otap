SQL> CREATE OR REPLACE TRIGGER otap_results_upd_trg
  2    BEFORE UPDATE ON otap_results
  3    FOR EACH ROW
  4  BEGIN
  5    -- keep values already set
  6    IF :NEW.otap_test_date != :OLD.otap_test_date
  7    THEN
  8  	 :NEW.otap_test_date := :OLD.otap_test_date;
  9    END IF;
 10    IF :NEW.test_executor != :OLD.test_executor
 11    THEN
 12  	 :NEW.test_executor := :OLD.test_executor;
 13    END IF;
 14    IF :NEW.test_set != :OLD.test_set
 15    THEN
 16  	 :NEW.test_set := :OLD.test_set;
 17    END IF;
 18    IF :NEW.test_group != :OLD.test_group
 19    THEN
 20  	 :NEW.test_group := :OLD.test_group;
 21    END IF;
 22    IF     :NEW.to_delete != :OLD.to_delete
 23  	  AND :NEW.to_delete  = otap_constants.OTAP_NUM_TRUE
 24    THEN
 25  	 :NEW.deleted	 := SYSDATE;
 26  	 :NEW.deleted_by := SYS_CONTEXT('USERENV', 'SESSION_USER');
 27    END IF;
 28    IF     :OLD.test_name IS NOT NULL
 29  	  AND :NEW.test_name != :OLD.test_name
 30    THEN
 31  	 :NEW.test_name := :OLD.test_name;
 32    END IF;
 33    IF     :OLD.test_desc IS NOT NULL
 34  	  AND :NEW.test_desc != :OLD.test_desc
 35    THEN
 36  	 :NEW.test_desc := :OLD.test_desc;
 37    END IF;
 38  END;
 39  /

