SQL> CREATE OR REPLACE TRIGGER otap_config_ins_trg
  2    BEFORE INSERT ON otap_config
  3    FOR EACH ROW
  4  BEGIN
  5    -- only allow defined configuration names
  6    otap_util.validate_config_name(:NEW.config_name);
  7    -- validate config_value and raise
  8    :NEW.config_value := otap_util.validate_config_value( :NEW.config_name
  9  							   , :NEW.config_value
 10  							   , :NEW.config_type
 11  							   , :NEW.translatable
 12  							   , :NEW.config_max_length
 13  							   )
 14    ;
 15    -- check empty strings contained only spaces
 16    :NEW.created	   := SYSDATE;
 17    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 18    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 19  END;
 20  /

