130    FUNCTION get_summary( p_status	IN VARCHAR2 DEFAULT otap_constants.OTAP_TEXT_TEST_UNDEFINED
131  			   , p_runtime	IN VARCHAR2 DEFAULT otap_constants.OTAP_CHAR_NA
132  			   , p_runs	IN NUMBER   DEFAULT 0
133  			   , p_errors	IN NUMBER   DEFAULT 0
134  			   , p_issues	IN NUMBER   DEFAULT 0
135  			   , p_min_fill IN INTEGER  DEFAULT otap_constants.OTAP_REPORT_MIN_FILL_LENGTH
136  			   )
137  	 RETURN VARCHAR2
138    IS
139  	 l_return_text	 VARCHAR2(32767);
140  	 l_template_text VARCHAR2(32767);
141    BEGIN
142  	 -- fetch template
143  	 l_template_text := otap_config_util.get_summary_template;
144  	 -- replace variables
145  	 l_template_text := REPLACE(l_template_text, '@status@', NVL(p_status, otap_config_util.get_text_summary_error));
146  	 l_template_text := REPLACE(l_template_text, '@runtime@', NVL(p_runtime, otap_constants.OTAP_CHAR_NA));
147  	 l_template_text := REPLACE(l_template_text, '@runs@', NVL(TRIM(TO_CHAR(p_runs)), otap_constants.OTAP_CHAR_NA) );
148  	 l_template_text := REPLACE(l_template_text, '@errors@', NVL(TRIM(TO_CHAR(p_errors)), otap_constants.OTAP_CHAR_NA));
149  	 l_template_text := REPLACE(l_template_text, '@issues@', NVL(TRIM(TO_CHAR(p_issues)), otap_constants.OTAP_CHAR_NA));
150  	 -- get borderless
151  	 l_return_text := otap_report.borderless( l_template_text
152  						, GREATEST(NVL(p_min_fill, otap_constants.OTAP_REPORT_MIN_FILL_LENGTH), NVL(LENGTH(l_template_text), 0), otap_config_util.get_length_headers)
153  						)
154  	 ;
155  	 RETURN l_return_text;
156    EXCEPTION
157  	 WHEN OTHERS THEN
158  	   otap_log.log(SQLERRM, 'otap_report.get_summary', 'Summary template replacement');
159  	   RAISE;
160    END get_summary;
