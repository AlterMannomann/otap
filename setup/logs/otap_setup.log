142  			       , otap_util.CFG_TEMPLATE_REPORT_TOTAL
143  			       , otap_util.CFG_TEMPLATE_RESULT_LINE
144  			       , otap_util.CFG_TEMPLATE_SESSION_ID
145  			       , otap_util.CFG_TEMPLATE_SET
146  			       , otap_util.CFG_TEMPLATE_SUMMARY
147  			       , otap_util.CFG_TEMPLATE_TEST_NAME
148  			       , otap_util.CFG_TEXT_FALSE
149  			       , otap_util.CFG_TEXT_FALSE_NO
150  			       , otap_util.CFG_TEXT_REPORT_END
151  			       , otap_util.CFG_TEXT_REPORT_START
152  			       , otap_util.CFG_TEXT_REPORT_TOTAL
153  			       , otap_util.CFG_TEXT_RESULT_HEADER
154  			       , otap_util.CFG_TEXT_RESULT_LINE
155  			       , otap_util.CFG_TEXT_SUMMARY_HEADER
156  			       , otap_util.CFG_TEXT_TEST_SETUP_SET
157  			       , otap_util.CFG_TEXT_TEST_SETUP_GROUP
158  			       , otap_util.CFG_TEXT_TEST_SETUP_NAME
159  			       , otap_util.CFG_TEXT_TEST_FAILED
160  			       , otap_util.CFG_TEXT_TEST_PASSED
161  			       , otap_util.CFG_TEXT_TEST_UNDEFINED
162  			       , otap_util.CFG_TEXT_TRUE
163  			       , otap_util.CFG_TEXT_TRUE_YES
164  			       )
165  	   THEN
166  	     -- log the error
167  	     otap_log.log('-20006 The configuration name: ' || NVL(p_config_name, 'NULL') || ' cannot be deleted.', l_script);
168  	     -- only direct testing could call this currently as table has a NOT NULL constraint
169  	     RAISE_APPLICATION_ERROR(-20006, 'The configuration name: ' || NVL(p_config_name, 'NULL') || ' cannot be deleted.');
170  	   END IF;
171  	 END IF;
172    END validate_config_name;
173  
174    FUNCTION validate_config_value( p_config_name   IN	     VARCHAR2
175  				     , p_config_value  IN	     VARCHAR2
176  				     , p_config_type   IN	     VARCHAR2
177  				     , p_translatable  IN OUT NOCOPY NUMBER
178  				     , p_max_length    IN	     NUMBER
179  				     , p_raise	       IN	     BOOLEAN  DEFAULT TRUE
180  				     )
181  	 RETURN VARCHAR2
182    IS
183  	 l_script	VARCHAR2(1024 CHAR)  := 'otap_util.validate_config_value';
184  	 l_config_value VARCHAR2(32767 CHAR);
185  	 l_config_name	VARCHAR2(128 CHAR);
186  	 l_integer	INTEGER;
187    BEGIN
188  	 l_config_value := TRIM(p_config_value);
189  	 l_config_name	:= otap_string.reduce(p_config_name, 128);
190  	 -- we must check against NULL as we are in a before trigger
191  	 IF    l_config_value	     IS NULL
192  	    OR LENGTH(l_config_value) = 0
193  	 THEN
194  	   -- no defaults for NULL values, always raise
195  	   otap_log.log('-20002 The given config_value is not supported. Empty or only spaces.', l_script);
196  	   RAISE_APPLICATION_ERROR(-20002, 'The given config_value is not supported. Empty or only spaces.');
197  	 END IF;
198  	 -- check type also mandatory, no default
199  	 IF NVL(p_config_type, otap_constants.OTAP_INTERNAL_NA) NOT IN (otap_constants.OTAP_CONFIG_TYPE_CHAR, otap_constants.OTAP_CONFIG_TYPE_NUMBER)
200  	 THEN
201  	   otap_log.log('-20003 The given config_type: ' || NVL(p_config_type, 'NULL') || ' is not supported. Only CHAR or NUMBER supported.', l_script);
202  	   RAISE_APPLICATION_ERROR(-20003, 'The given config_type: ' || NVL(p_config_type, 'NULL') || ' is not supported. Only CHAR or NUMBER supported.');
203  	 END IF;
204  	 -- check length if given
205  	 IF	NVL(p_max_length, 0)   > 0
206  	    AND LENGTH(l_config_value) > NVL(p_max_length, 0)
207  	 THEN
208  	   -- we do not cut numbers, raise
209  	   IF	 p_config_type = 'NUMBER'
210  	      OR p_raise
211  	   THEN
212  	     otap_log.log('-20004 The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: ' || p_max_length || '.', l_script);
213  	     RAISE_APPLICATION_ERROR(-20004, 'The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: ' || p_max_length || '.');
214  	   ELSE
215  	     -- cut the string if not raise
216  	     l_config_value := otap_string.reduce(l_config_value, p_max_length);
217  	   END IF;
218  	 ELSIF LENGTH(l_config_value) > 4000
219  	 THEN
220  	   -- OTAP_CONFIG supports only 4000 chars
221  	   -- we do not cut numbers, raise
222  	   IF	 p_config_type = 'NUMBER'
223  	      OR p_raise
224  	   THEN
225  	     otap_log.log('-20004 The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: 4000.', l_script);
226  	     RAISE_APPLICATION_ERROR(-20004, 'The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: 4000.');
227  	   ELSE
228  	     -- cut the string if not raise
229  	     l_config_value := otap_string.reduce(l_config_value, 4000);
230  	   END IF;
231  	 END IF;
232  	 -- check number, always raise
233  	 IF	p_config_type = 'NUMBER'
234  	    AND NOT is_number(l_config_value)
235  	 THEN
236  	   otap_log.log('-20005 The given config_value: ' || l_config_value || ' cannot be converted to a number.', l_script);
237  	   RAISE_APPLICATION_ERROR(-20005, 'The given config_value: ' || l_config_value || ' cannot be converted to a number.');
238  	 END IF;
239  	 -- check translatable and correct it if needed
240  	 IF p_translatable NOT IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
241  	 THEN
242  	   otap_log.log('Invalid value for TRANSLATABLE: ' || p_translatable || ' use default.', l_script);
243  	   p_translatable := otap_constants.OTAP_NUM_FALSE;
244  	 END IF;
245  	 IF	(   p_config_type = 'NUMBER'
246  		 OR l_config_name IN (otap_util.CFG_DEFAULT_PREFIX, otap_util.CFG_DEFAULT_LAYOUT, otap_util.CFG_DEFAULT_RESULT_LAYOUT)
247  		)
248  	    AND p_translatable = otap_constants.OTAP_NUM_TRUE
249  	 THEN
250  	   otap_log.log('Invalid config_name: ' || l_config_name || ' for TRANSLATABLE: ' || p_translatable || ' use default.', l_script);
251  	   p_translatable := otap_constants.OTAP_NUM_FALSE;
252  	 END IF;
253  	 -- now check constraints on specific config values not managed by other constraints
254  	 IF l_config_name = otap_util.CFG_PRESERVE_DAYS
255  	 THEN
256  	   IF is_integer(l_config_value)
257  	   THEN
258  	     l_integer := TO_NUMBER(l_config_value);
259  	     -- check range
260  	     IF l_config_value NOT BETWEEN otap_constants.OTAP_FALLBACK_PRESERVE_DAYS_MIN AND otap_constants.OTAP_FALLBACK_PRESERVE_DAYS_MAX
261  	     THEN
262  		 otap_log.log('Invalid value for PRESERVE_DAYS: ' || l_config_value || ' use default.', l_script);
263  		 l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_PRESERVE_DAYS));
264  	     END IF;
265  	   ELSE
266  	     -- set default
267  	     otap_log.log('Invalid value for PRESERVE_DAYS: ' || l_config_value || ' use default.', l_script);
268  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_PRESERVE_DAYS));
269  	   END IF;
270  	 END IF;
271  	 IF l_config_name = otap_util.CFG_DELETE_DELAY
272  	 THEN
273  	   IF is_integer(l_config_value)
274  	   THEN
275  	     l_integer := TO_NUMBER(l_config_value);
276  	     -- check range
277  	     IF l_integer NOT BETWEEN otap_constants.OTAP_FALLBACK_DELETE_DELAY_MIN AND otap_constants.OTAP_FALLBACK_DELETE_DELAY_MAX
278  	     THEN
279  	       otap_log.log('Invalid value for DELETE_DELAY: ' || l_config_value || ' use default.', l_script);
280  	       l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_DELAY));
281  	     END IF;
282  	   ELSE
283  	     -- set default
284  	     otap_log.log('Invalid value for DELETE_DELAY: ' || l_config_value || ' use default.', l_script);
285  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_DELAY));
286  	   END IF;
287  	 END IF;
288  	 IF l_config_name = otap_util.CFG_DELETE_BATCH_SIZE
289  	 THEN
290  	   IF is_integer(l_config_value)
291  	   THEN
292  	     l_integer := TO_NUMBER(l_config_value);
293  	     -- check range
294  	     IF l_integer NOT BETWEEN otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE_MIN AND otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE_MAX
295  	     THEN
296  	       otap_log.log('Invalid value for DELETE_BATCH_SIZE: ' || l_config_value || ' use default.', l_script);
297  	       l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE));
298  	     END IF;
299  	   ELSE
300  	     -- set default
301  	     otap_log.log('Invalid value for DELETE_BATCH_SIZE: ' || l_config_value || ' use default.', l_script);
302  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE));
303  	   END IF;
304  	 END IF;
305  	 IF l_config_name = otap_util.CFG_DEFAULT_BORDER
306  	 THEN
307  	   IF is_integer(l_config_value)
308  	   THEN
309  	     l_integer := TO_NUMBER(l_config_value);
310  	     -- check range
311  	     IF l_integer NOT BETWEEN otap_constants.OTAP_FALLBACK_BORDER_MIN AND otap_constants.OTAP_FALLBACK_BORDER_MAX
312  	     THEN
313  	       otap_log.log('Invalid value for DEFAULT_BORDER: ' || l_config_value || ' use default.', l_script);
314  	       l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_BORDER));
315  	     END IF;
316  	   ELSE
317  	     -- set default
318  	     otap_log.log('Invalid value for DEFAULT_BORDER: ' || l_config_value || ' use default.', l_script);
319  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_BORDER));
320  	   END IF;
321  	 END IF;
322  	 IF l_config_name = otap_constants.OTAP_CFG_DEBUG_MODE
323  	 THEN
324  	   -- hardcoded minimal check, this is highly internal
325  	   IF l_config_value NOT IN ('0', '1')
326  	   THEN
327  	     otap_log.log('Invalid value for DEBUG_MODE: ' || l_config_value || ' use default.', l_script);
328  	     l_config_value := '0';
329  	   END IF;
330  	 END IF;
331  	 IF l_config_name = otap_util.CFG_DEFAULT_LAYOUT
332  	 THEN
333  	   IF l_config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
334  	   THEN
335  	     otap_log.log('Invalid value for DEFAULT_LAYOUT: ' || l_config_value || ' use default.', l_script);
336  	     l_config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
337  	   END IF;
338  	 END IF;
339  	 IF l_config_name = otap_util.CFG_DEFAULT_RESULT_LAYOUT
340  	 THEN
341  	   IF l_config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
342  	   THEN
343  	     otap_log.log('Invalid value for DEFAULT_RESULT_LAYOUT: ' || l_config_value || ' use default.', l_script);
344  	     l_config_value := otap_constants.OTAP_LAYOUT_LEFT;
345  	   END IF;
346  	 END IF;
347  	 IF l_config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
348  	 THEN
349  	   IF l_config_value NOT IN (otap_constants.OTAP_LABEL_LOWER, otap_constants.OTAP_LABEL_INIT_CAP, otap_constants.OTAP_LABEL_UPPER)
350  	   THEN
351  	     otap_log.log('Invalid value for DEFAULT_LABEL_LAYOUT: ' || l_config_value || ' use default.', l_script);
352  	     l_config_value := otap_constants.OTAP_LABEL_LOWER;
353  	   END IF;
354  	 END IF;
355  	 RETURN l_config_value;
356    END validate_config_value;
357  
358    PROCEDURE validate_translatable(p_otap_identifier IN VARCHAR2)
359    IS
360  	 l_script	   VARCHAR2(1024 CHAR) := 'otap_util.validate_translatable';
361  	 l_is_translatable INTEGER;
362  	 l_exists	   INTEGER;
363    BEGIN
364  	 SELECT COUNT(*)
365  	   INTO l_exists
366  	   FROM otap_config
367  	  WHERE config_name = TRIM(UPPER(p_otap_identifier))
368  	 ;
369  	 IF l_exists > 0
370  	 THEN
371  	   SELECT COUNT(*)
372  	     INTO l_is_translatable
373  	     FROM otap_config
374  	   WHERE config_name   = TRIM(UPPER(p_otap_identifier))
375  	     AND translatable  = otap_constants.OTAP_NUM_TRUE
376  	   ;
377  	   IF l_is_translatable = 0
378  	   THEN
379  	     -- log the error
380  	     otap_log.log('-20020 The given identifier: ' || NVL(p_otap_identifier, 'NULL') || ' cannot be translated. Ask your admin to adjust this configuration item if possible.', l_script);
381  	     -- only direct testing could call this currently as table has a NOT NULL constraint
382  	     RAISE_APPLICATION_ERROR(-20020, 'The given identifier: ' || NVL(p_otap_identifier, 'NULL') || ' cannot be translated. Ask your admin to adjust this configuration item if possible.');
383  	   END IF;
384  	 END IF;
385    END validate_translatable;
386  
387    PROCEDURE validate_translation( p_otap_identifier IN VARCHAR2
388  				     , p_label_text	 IN VARCHAR2
389  				     )
390    IS
391  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_util.validate_translatable';
392  	 l_is_config	 INTEGER;
393  	 l_length_limit  INTEGER;
394    BEGIN
395  	 SELECT COUNT(*)
396  	   INTO l_is_config
397  	   FROM otap_config
398  	  WHERE config_name	  = p_otap_identifier
399  	    AND translatable	  = otap_constants.OTAP_NUM_TRUE
400  	    AND config_max_length > 0
401  	 ;
402  	 IF l_is_config = 1
403  	 THEN
404  	   SELECT config_max_length
405  	     INTO l_length_limit
406  	     FROM otap_config
407  	    WHERE config_name = p_otap_identifier
408  	   ;
409  	   IF LENGTH(p_label_text) > l_length_limit
410  	   THEN
411  	     -- log the error
412  	     otap_log.log('-20021 The given translation: ' || p_label_text || ' exceeds the length limits (' || l_length_limit || ') for ' || p_otap_identifier, l_script);
413  	     -- only direct testing could call this currently as table has a NOT NULL constraint
414  	     RAISE_APPLICATION_ERROR(-20021, 'The given translation: ' || p_label_text || ' exceeds the length limits (' || l_length_limit || ') for ' || p_otap_identifier);
415  	   END IF;
416  	 END IF;
417    END validate_translation;
418  
419    FUNCTION get_config_value( p_config_name IN VARCHAR2
420  				, p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
421  				)
422  	 RETURN VARCHAR2
423    IS
424  	 l_script      VARCHAR2(1024 CHAR)	      := 'otap_util.get_config_value';
425  	 l_return      otap_config.config_value%TYPE;
426  	 l_has_config  INTEGER;
427  	 l_has_label   INTEGER;
428  	 l_label_col   VARCHAR2(1 CHAR);
429  	 l_language    VARCHAR2(3);
430    BEGIN
431  	 l_return := otap_constants.OTAP_INTERNAL_ERROR;
432  	 SELECT COUNT(*)
433  	   INTO l_has_config
434  	   FROM otap_identifiers_v
435  	  WHERE otap_identifier = UPPER(p_config_name)
436  	    AND language_id	= UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA))
437  	 ;
438  	 -- we need a fallback if given language does not match
439  	 IF l_has_config = 0
440  	 THEN
441  	   SELECT COUNT(*)
442  	     INTO l_has_config
443  	     FROM otap_identifiers_v
444  	   WHERE otap_identifier = UPPER(p_config_name)
445  	     AND language_id	 = otap_constants.OTAP_INTERNAL_NA
446  	   ;
447  	   l_language := otap_constants.OTAP_INTERNAL_NA;
448  	 ELSE
449  	   l_language := UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA));
450  	 END IF;
451  	 SELECT COUNT(*)
452  	   INTO l_has_label
453  	   FROM otap_config
454  	  WHERE config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
455  	 ;
456  	 IF l_has_label = 1
457  	 THEN
458  	   SELECT config_value
459  	     INTO l_label_col
460  	     FROM otap_config
461  	    WHERE config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
462  	   ;
463  	   l_label_col := NVL(l_label_col, otap_constants.OTAP_LABEL_LOWER);
464  	 ELSE
465  	   l_label_col := otap_constants.OTAP_LABEL_LOWER;
466  	 END IF;
467  	 IF l_has_config = 1
468  	 THEN
469  	   SELECT CASE l_label_col
470  		    WHEN otap_constants.OTAP_LABEL_LOWER
471  		    THEN label_text_lower
472  		    WHEN otap_constants.OTAP_LABEL_INIT_CAP
473  		    THEN label_text_cap
474  		    WHEN otap_constants.OTAP_LABEL_UPPER
475  		    THEN label_text_upper
476  		    ELSE label_text_lower
477  		  END
478  	     INTO l_return
479  	     FROM otap_identifiers_v
480  	    WHERE otap_identifier = UPPER(p_config_name)
481  	      AND language_id	  = l_language
482  	   ;
483  	 ELSE
484  	   l_return := otap_constants.OTAP_INTERNAL_ERROR;
485  	   otap_log.log('Invalid config_name: ' || UPPER(p_config_name) || ' return error identifier. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name)');
486  	 END IF;
487  	 RETURN l_return;
488    EXCEPTION
489  	 WHEN OTHERS THEN
490  	   otap_log.log(SQLERRM, l_script, 'SELECT config_value INTO l_return FROM otap_config WHERE config_name = UPPER(p_config_name) AND language_id = UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA))');
491  	   RAISE;
492    END get_config_value;
493  
494    PROCEDURE set_config_value( p_config_name  IN VARCHAR2
495  				 , p_config_value IN VARCHAR2
496  				 )
497    IS
498  	 PRAGMA AUTONOMOUS_TRANSACTION;
499  	 l_script      VARCHAR2(1024 CHAR)	      := 'otap_util.set_config_value';
500  	 l_exists      INTEGER;
501    BEGIN
502  	 SELECT COUNT(*)
503  	   INTO l_exists
504  	   FROM otap_config
505  	  WHERE config_name  = p_config_name
506  	    AND translatable = otap_constants.OTAP_NUM_FALSE
507  	 ;
508  	 IF l_exists = 1
509  	 THEN
510  	   UPDATE otap_config
511  	      SET config_value = p_config_value
512  	    WHERE config_name  = p_config_name
513  	   ;
514  	   COMMIT;
515  	 ELSE
516  	   otap_log.log('-20007 The given config_name ' || p_config_name || ' does not exist or is translatable.', l_script);
517  	   RAISE_APPLICATION_ERROR(-20007, 'The given config_name ' || p_config_name || ' does not exist or is translatable.');
518  	 END IF;
519    -- do not catch exceptions, pass them to caller as happening
520    END set_config_value;
521  
522    FUNCTION get_config_number(p_config_name IN VARCHAR2)
523  	 RETURN NUMBER
524    IS
525  	 l_script      VARCHAR2(1024 CHAR)	       := 'otap_util.get_config_number';
526  	 l_varchar     otap_config.config_value%TYPE;
527  	 l_return      INTEGER; -- only integer in configuration
528  	 l_has_config  INTEGER;
529    BEGIN
530  	 l_return := NULL;
531  	 SELECT COUNT(*)
532  	   INTO l_has_config
533  	   FROM otap_config
534  	  WHERE config_name = UPPER(p_config_name)
535  	    AND config_type = 'NUMBER'
536  	 ;
537  	 IF l_has_config = 1
538  	 THEN
539  	   l_varchar := otap_util.get_config_value(p_config_name);
540  	   IF otap_util.is_integer(l_varchar)
541  	   THEN
542  	     l_return := TO_NUMBER(l_varchar);
543  	   ELSE
544  	     l_return := NULL;
545  	     otap_log.log('Invalid numeric value for config_name: ' || UPPER(p_config_name) || ' return NULL. Value: ' || l_varchar, l_script, 'otap_util.is_integer(l_varchar)');
546  	   END IF;
547  	 ELSE
548  	   l_return := NULL;
549  	   otap_log.log('Invalid numeric config_name: ' || UPPER(p_config_name) || ' return NULL. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name) AND config_type = ''NUMBER''');
550  	 END IF;
551  	 RETURN l_return;
552    EXCEPTION
553  	 WHEN OTHERS THEN
554  	   otap_log.log(SQLERRM, l_script);
555  	   RAISE;
556    END get_config_number;
557  
558    FUNCTION get_label_id(p_object_type IN VARCHAR2)
559  	 RETURN VARCHAR2
560    IS
561  	 l_script VARCHAR2(1024 CHAR) := 'otap_util.get_label_id';
562  	 l_return VARCHAR2(256 CHAR);
563  	 l_count  INTEGER;
564    BEGIN
565  	 SELECT COUNT(*)
566  	   INTO l_count
567  	   FROM otap_labels_mv
568  	  WHERE otap_label_source = UPPER(p_object_type)
569  	 ;
570  	 IF l_count = 1
571  	 THEN
572  	   SELECT otap_string.reduce(otap_identifier, 256)
573  	     INTO l_return
574  	     FROM otap_labels_mv
575  	    WHERE otap_label_source = UPPER(p_object_type)
576  	   ;
577  	 ELSE
578  	   otap_log.log('Invalid object type: ' || p_object_type, l_script);
579  	   l_return := otap_util.CFG_LABEL_UNDEFINED;
580  	 END IF;
581  	 RETURN l_return;
582    EXCEPTION
583  	 WHEN OTHERS THEN
584  	   otap_log.log(SQLERRM, l_script);
585  	   RAISE;
586    END get_label_id;
587  
588    FUNCTION get_length_test_state(p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA)
589  	 RETURN NUMBER
590    IS
591  	 l_return INTEGER;
592    BEGIN
593  	 -- consider possible translations, fetch from otap_identifiers_v
594  	 -- length does not change on upper, lower or init capitals
595  	 SELECT MAX(LENGTH(label_text_lower))
596  	   INTO l_return
597  	   FROM otap_identifiers_v
598  	  WHERE otap_identifier IN ( otap_util.CFG_TEXT_TEST_UNDEFINED
599  				   , otap_util.CFG_TEXT_TEST_PASSED
600  				   , otap_util.CFG_TEXT_TEST_FAILED
601  				   )
602  				   -- language fallback included
603  	    AND language_id	IN (UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA)), otap_constants.OTAP_INTERNAL_NA)
604  	 ;
605  	 RETURN l_return;
606    EXCEPTION
607  	 WHEN OTHERS THEN
608  	   otap_log.log(SQLERRM, 'otap_util.get_length_test_state', 'Get MAX length for config values');
609  	   RAISE;
610    END get_length_test_state;
