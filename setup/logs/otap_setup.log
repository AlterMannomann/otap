549    FUNCTION build_msg( p_cfg_template  IN VARCHAR2
550  			 , p_type_label    IN VARCHAR2 DEFAULT NULL
551  			 , p_param1	   IN VARCHAR2 DEFAULT NULL
552  			 , p_param1_value  IN VARCHAR2 DEFAULT NULL
553  			 , p_param2	   IN VARCHAR2 DEFAULT NULL
554  			 , p_param2_value  IN VARCHAR2 DEFAULT NULL
555  			 , p_param3	   IN VARCHAR2 DEFAULT NULL
556  			 , p_param3_value  IN VARCHAR2 DEFAULT NULL
557  			 , p_param4	   IN VARCHAR2 DEFAULT NULL
558  			 , p_param4_value  IN VARCHAR2 DEFAULT NULL
559  			 , p_param5	   IN VARCHAR2 DEFAULT NULL
560  			 , p_param5_value  IN VARCHAR2 DEFAULT NULL
561  			 , p_param6n	   IN VARCHAR2 DEFAULT NULL
562  			 , p_param6n_value IN VARCHAR2 DEFAULT NULL
563  			 , p_description   IN VARCHAR2 DEFAULT NULL
564  			 )
565  	 RETURN VARCHAR2
566    IS
567  	 l_script	 VARCHAR2(256 CHAR) := 'otap_util.build_msg';
568  	 l_text_result	 VARCHAR2(4000 CHAR);
569  	 l_label	 VARCHAR2(256 CHAR);
570  	 l_var_count	 INTEGER;
571    BEGIN
572  	 IF p_description IS NOT NULL
573  	 THEN
574  	   l_text_result := otap_string.reduce(p_description, 4000);
575  	 ELSE
576  	   IF p_cfg_template IS NULL
577  	   THEN
578  	     l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' missing description and template identifier';
579  	     otap_log.log(l_text_result, l_script);
580  	   ELSE
581  	     l_text_result := otap_util.get_config_value(p_cfg_template);
582  	     IF l_text_result = otap_constants.OTAP_INTERNAL_ERROR
583  	     THEN
584  	       l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' invalid template identifier ' || p_cfg_template;
585  	       otap_log.log(l_text_result, l_script);
586  	     ELSE
587  	       -- check variables, only modify if present, otherwise text is delivered as is
588  	       l_var_count := REGEXP_COUNT(l_text_result, '@');
589  	       -- check also that @@ comes in pairs like valid variables
590  	       IF l_var_count != 0 AND MOD(l_var_count, 2) = 0
591  	       THEN
592  		 -- check type present
593  		 IF	p_type_label					  IS NOT NULL
594  		    AND INSTR(l_text_result, otap_constants.OTAP_TYPE_VAR) > 0
595  		 THEN
596  		   l_label := otap_util.get_config_value(p_type_label);
597  		   -- do nothing on errors
598  		   IF l_label != otap_constants.OTAP_INTERNAL_ERROR
599  		   THEN
600  		     -- replace if exists in template
601  		     l_text_result := REPLACE(l_text_result, otap_constants.OTAP_TYPE_VAR, l_label);
602  		   ELSE
603  		     otap_log.log('Type ignored, Invalid label used: ' || p_type_label, l_script);
604  		   END IF;
605  		 END IF;
606  		 -- check vars and replace if condition met
607  		 IF p_param1_value IS NOT NULL
608  		 THEN
609  		   IF	  p_param1		     IS NOT NULL
610  		      AND REGEXP_COUNT(p_param1, '@') = 2
611  		   THEN
612  		     -- replace, may work, may not
613  		     l_text_result := REPLACE(l_text_result, p_param1, p_param1_value);
614  		   ELSE
615  		     -- ignore, log error
616  		     otap_log.log('Value without variable name: ' || p_param1_value || ' or invalid parameter: ' || p_param1, l_script);
617  		   END IF;
618  		 END IF;
619  		 IF p_param2_value IS NOT NULL
620  		 THEN
621  		   IF	  p_param2		     IS NOT NULL
622  		      AND REGEXP_COUNT(p_param2, '@') = 2
623  		   THEN
624  		     -- replace, may work, may not
625  		     l_text_result := REPLACE(l_text_result, p_param2, p_param2_value);
626  		   ELSE
627  		     -- ignore, log error
628  		     otap_log.log('Value without variable name: ' || p_param2_value || ' or invalid parameter: ' || p_param2, l_script);
629  		   END IF;
630  		 END IF;
631  		 IF p_param3_value IS NOT NULL
632  		 THEN
633  		   IF	  p_param3		     IS NOT NULL
634  		      AND REGEXP_COUNT(p_param3, '@') = 2
635  		   THEN
636  		     -- replace, may work, may not
637  		     l_text_result := REPLACE(l_text_result, p_param3, p_param3_value);
638  		   ELSE
639  		     -- ignore, log error
640  		     otap_log.log('Value without variable name: ' || p_param3_value || ' or invalid parameter: ' || p_param3, l_script);
641  		   END IF;
642  		 END IF;
643  		 IF p_param4_value IS NOT NULL
644  		 THEN
645  		   IF	  p_param4		     IS NOT NULL
646  		      AND REGEXP_COUNT(p_param4, '@') = 2
647  		   THEN
648  		     -- replace, may work, may not
649  		     l_text_result := REPLACE(l_text_result, p_param4, p_param4_value);
650  		   ELSE
651  		     -- ignore, log error
652  		     otap_log.log('Value without variable name: ' || p_param4_value || ' or invalid parameter: ' || p_param4, l_script);
653  		   END IF;
654  		 END IF;
655  		 IF p_param5_value IS NOT NULL
656  		 THEN
657  		   IF	  p_param5		     IS NOT NULL
658  		      AND REGEXP_COUNT(p_param5, '@') = 2
659  		   THEN
660  		     -- replace, may work, may not
661  		     l_text_result := REPLACE(l_text_result, p_param5, p_param5_value);
662  		   ELSE
663  		     -- ignore, log error
664  		     otap_log.log('Value without variable name: ' || p_param5_value || ' or invalid parameter: ' || p_param5, l_script);
665  		   END IF;
666  		 END IF;
667  		 -- allow NULL value for replace
668  		 IF p_param6n IS NOT NULL
669  		 THEN
670  		   IF REGEXP_COUNT(p_param6n, '@') = 2
671  		   THEN
672  		     -- replace, may work, may not
673  		     l_text_result := REPLACE(l_text_result, p_param6n, p_param6n_value);
674  		   ELSE
675  		     -- ignore, log error
676  		     otap_log.log('Invalid parameter p_param6n: ' || p_param6n, l_script);
677  		   END IF;
678  		 END IF;
679  	       END IF;
680  	     END IF;
681  	   END IF;
682  	 END IF;
683  	 -- remove duplicate space chars
684  	 l_text_result := otap_string.flatten(l_text_result, 4000);
685  	 RETURN l_text_result;
686    EXCEPTION
687  	 WHEN OTHERS THEN
688  	   otap_log.log(SQLERRM, l_script, 'Prepare message from template');
689  	   RAISE;
690  	 RETURN l_text_result;
691    END build_msg;
