356    FUNCTION trigger_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
357  			     , p_like_trigger  IN VARCHAR2 DEFAULT '%'
358  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
359  			     , p_show_header   IN INTEGER  DEFAULT 1
360  			     , p_excl_sysgen   IN INTEGER  DEFAULT 1
361  			     )
362  	 RETURN otap_view_result_tbl PIPELINED
363    IS
364  	 l_statement   VARCHAR2(4000 CHAR);
365  	 l_schema      VARCHAR2(128 CHAR);
366  	 l_base_title  VARCHAR2(256 CHAR);
367  	 l_like        VARCHAR2(256 CHAR);
368  	 l_count       INTEGER;
369  	 l_test_count  INTEGER;
370  	 CURSOR cur_table_trigger( cp_schema IN VARCHAR2
371  				 , cp_like   IN VARCHAR2
372  				 , cp_excl   IN NUMBER
373  				 )
374  	 IS
375  	   SELECT table_name
376  	     FROM dba_triggers
377  	    WHERE owner 	  = cp_schema
378  	      AND table_name	 IS NOT NULL
379  	      AND trigger_name LIKE cp_like
380  	      AND NOT otap_string.is_sys_object(table_name, cp_excl)
381  	      AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
382  	    GROUP BY table_name
383  	    ORDER BY table_name
384  	 ;
385  	 CURSOR cur_trigger( cp_schema IN VARCHAR2
386  			   , cp_table  IN VARCHAR2
387  			   , cp_like   IN VARCHAR2
388  			   , cp_excl   IN NUMBER
389  			   )
390  	 IS
391  	   SELECT trigger_name
392  		, table_name
393  		, table_owner
394  		, owner
395  		, trigger_type
396  		, triggering_event
397  	     FROM dba_triggers
398  	    WHERE owner 	  = cp_schema
399  	      AND table_name	  = cp_table
400  	      AND trigger_name LIKE cp_like
401  	      AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
402  	    ORDER BY trigger_name
403  	 ;
404  	 CURSOR cur_other_trigger( cp_schema IN VARCHAR2
405  				 , cp_like   IN VARCHAR2
406  				 , cp_excl   IN NUMBER
407  				 )
408  	 IS
409  	   SELECT trigger_name
410  		, owner
411  		, trigger_type
412  		, triggering_event
413  	     FROM dba_triggers
414  	    WHERE owner 	  = cp_schema
415  	      AND table_name	 IS NULL
416  	      AND trigger_name LIKE cp_like
417  	      AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
418  	    ORDER BY trigger_name
419  	 ;
420    BEGIN
421  	 l_like       := NVL(p_like_trigger, '%');
422  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
423  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
424  	 IF NVL(p_show_header, 1) = 1
425  	 THEN
426  	   l_statement := '-- otap GENERATE trigger test scripts for schema ' || l_schema || ' scope: ' || l_like;
427  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
428  	   -- get test count
429  	   SELECT COUNT(*)
430  	     INTO l_test_count
431  	     FROM dba_triggers
432  	    WHERE owner 	  = l_schema
433  	      AND trigger_name LIKE l_like
434  	      AND NOT otap_string.is_sys_object(trigger_name, p_excl_sysgen)
435  	   ;
436  	   -- build init
437  	   l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
438  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
439  	 END IF;
440  	 -- build group row
441  	 l_statement := '-- set test group for trigger';
442  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
443  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' trigger'') FROM dual;';
444  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
445  	 -- organize trigger by table or not
446  	 -- trigger with table
447  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NOT NULL;
448  	 IF l_count > 0
449  	 THEN
450  	   FOR rec IN cur_table_trigger(l_schema, l_like, p_excl_sysgen)
451  	   LOOP
452  	     -- build name
453  	     l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' ' || rec.table_name || ' table trigger'') FROM dual;';
454  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
455  	     l_statement := '-- loop through triggers with names like ' || l_like;
456  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
457  	     FOR rectrg IN cur_trigger(l_schema, rec.table_name, l_like, p_excl_sysgen)
458  	     LOOP
459  	       l_statement := 'SELECT otap_test.has_trigger( p_trigger_name => ''' || rectrg.trigger_name || '''';
460  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
461  	       l_statement := ' 			   , p_schema => ''' || rectrg.owner || '''';
462  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
463  	       l_statement := ' 			   , p_trigger_type => ''' || TRIM(rectrg.trigger_type) || '''';
464  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
465  	       l_statement := ' 			   , p_trigger_event => ''' || TRIM(rectrg.triggering_event) || '''';
466  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
467  	       l_statement := ' 			   , p_table_owner => ''' || TRIM(rectrg.table_owner) || '''';
468  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
469  	       l_statement := ' 			   , p_table_name => ''' || TRIM(rectrg.table_name) || '''';
470  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
471  	       l_statement := ' 			   ) FROM dual;';
472  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
473  	     END LOOP;
474  	   END LOOP;
475  	 END IF;
476  	 -- trigger without table
477  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NULL;
478  	 IF l_count > 0
479  	 THEN
480  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' trigger without tables'') FROM dual;';
481  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
482  	   l_statement := '-- loop through triggers with names like ' || l_like;
483  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
484  	   FOR rec IN cur_other_trigger(l_schema, l_like, p_excl_sysgen)
485  	   LOOP
486  	     l_statement := 'SELECT otap_test.has_trigger( p_trigger_name => ''' || rec.trigger_name || '''';
487  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
488  	     l_statement := '				 , p_schema => ''' || rec.owner || '''';
489  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
490  	     l_statement := '				 , p_trigger_type => ''' || TRIM(rec.trigger_type) || '''';
491  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
492  	     l_statement := '				 , p_trigger_event => ''' || TRIM(rec.triggering_event) || '''';
493  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
494  	     l_statement := '				 ) FROM dual;';
495  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
496  	   END LOOP;
497  	 END IF;
498  	 IF NVL(p_show_header, 1) = 1
499  	 THEN
500  	   -- build finish
501  	   l_statement := '-- finish trigger tests for ' || l_like;
502  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
503  	   l_statement := '-- finish test session';
504  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
505  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
506  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
507  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
508  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
509  	   -- add AI and copyright
510  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
511  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
512  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
513  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
514  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
515  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
516  	 ELSE
517  	   l_statement := '-- finish trigger tests for ' || l_like;
518  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
519  	 END IF;
520  	 RETURN;
521    EXCEPTION
522  	 WHEN NO_DATA_NEEDED THEN
523  	   RAISE;
524    END trigger_tests;
525  
526    FUNCTION pkg_procedures( p_package_name	 IN VARCHAR
527  			      , p_like_procedure IN VARCHAR2 DEFAULT '%'
528  			      , p_schema	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
529  			      , p_title_prefix	 IN VARCHAR2 DEFAULT NULL
530  			      , p_show_header	 IN INTEGER  DEFAULT 1
531  			      , p_excl_sysgen	 IN INTEGER  DEFAULT 1
532  			      )
533  	 RETURN otap_view_result_tbl PIPELINED
534    IS
535  	 l_statement   VARCHAR2(4000 CHAR);
536  	 l_schema      VARCHAR2(128 CHAR);
537  	 l_base_title  VARCHAR2(256 CHAR);
538  	 l_like        VARCHAR2(256 CHAR);
539  	 l_package     VARCHAR2(128 CHAR);
540  	 l_test_count  INTEGER;
541  	 CURSOR cur_pkg_proc( cp_schema  IN VARCHAR2
542  			    , cp_package IN VARCHAR2
543  			    , cp_like	 IN VARCHAR2
544  			    , cp_excl	 IN NUMBER
545  			    )
546  	 IS
547  	     WITH prc AS
548  		  (SELECT dbo.owner
549  			, dbp.procedure_name
550  			, CASE
551  			    WHEN dbr.position	    = 0
552  			     AND dbr.argument_name IS NULL
553  			    THEN 'FUNCTION'
554  			    ELSE 'PROCEDURE'
555  			  END AS procedure_type
556  			, CASE
557  			    WHEN dbr.position	    = 0
558  			     AND dbr.argument_name IS NULL
559  			    THEN dbr.data_type
560  			    ELSE NULL
561  			  END AS return_type
562  			, dbo.status
563  			, dbo.object_name AS package_name
564  		     FROM dba_objects dbo
565  		     LEFT OUTER JOIN dba_procedures dbp
566  		       ON dbo.owner	  = dbp.owner
567  		      AND dbo.object_name = dbp.object_name
568  		      AND dbo.object_type = dbp.object_type
569  		     LEFT OUTER JOIN dba_arguments dbr
570  		       ON dbp.owner	    = dbr.owner
571  		      AND dbp.object_name   = dbr.package_name
572  		      AND dbp.procedure_name = dbr.object_name
573  		      AND dbp.object_id     = dbr.object_id
574  		      AND dbp.subprogram_id = dbr.subprogram_id
575  		      AND dbr.sequence	    = 1
576  		    WHERE dbo.owner	   = cp_schema
577  		      AND dbo.object_type  = 'PACKAGE'
578  			  -- exclude package itself
579  		      AND dbp.procedure_name IS NOT NULL
580  		      AND NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl)
581  		      AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
582  		    UNION ALL
583  		   SELECT dbo.owner
584  			, dbo.object_name AS procedure_name
585  			, dbo.object_type AS procedure_type
586  			, CASE
587  			    WHEN dbr.position	    = 0
588  			     AND dbr.argument_name IS NULL
589  			    THEN dbr.data_type
590  			    ELSE NULL
591  			  END AS return_type
592  			, dbo.status
593  			, NULL AS package_name
594  		     FROM dba_objects dbo
595  		     LEFT OUTER JOIN dba_procedures dbp
596  		       ON dbo.owner	  = dbp.owner
597  		      AND dbo.object_name = dbp.object_name
598  		      AND dbo.object_type = dbp.object_type
599  		     LEFT OUTER JOIN dba_arguments dbr
600  		       ON dbp.owner	    = dbr.owner
601  		      AND dbp.object_name   = dbr.object_name
602  		      AND dbp.object_id     = dbr.object_id
603  		      AND dbp.subprogram_id = dbr.subprogram_id
604  		      AND dbr.sequence	    = 1
605  		    WHERE dbo.owner	   = cp_schema
606  		      AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
607  		      AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
608  		  )
609  	   SELECT DISTINCT
610  		  owner
611  		, procedure_name
612  		, procedure_type
613  		, return_type
614  		, status
615  		, package_name
616  	     FROM prc
617  	    WHERE package_name	    = cp_package
618  	      AND procedure_name LIKE cp_like
619  	 ;
620    BEGIN
621  	 l_package := otap_string.reduce(p_package_name, 128);
622  	 IF l_package IS NOT NULL
623  	 THEN
624  	   l_like	:= NVL(p_like_procedure, '%');
625  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
626  	   l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
627  	   IF NVL(p_show_header, 1) = 1
628  	   THEN
629  	     l_statement := '-- otap GENERATE package function and procedure test scripts for package ' || l_schema || '.' || l_package || ' scope: ' || l_like;
630  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
631  	     -- get test count
632  		WITH base AS
633  		    (SELECT object_name
634  			  , object_type
635  			  , owner
636  		       FROM dba_objects
637  		      WHERE owner = l_schema
638  			    -- currently supported objects
639  			AND object_type = 'PACKAGE'
640  			    -- user like condition
641  			AND object_name = l_package
642  			    -- user exclude condition
643  			AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
644  		    )
645  		    -- depending procedures
646  		  , prc AS
647  		    (SELECT dbp.procedure_name
648  			  , dbp.object_name
649  			  , dbp.object_type
650  		       FROM dba_procedures dbp
651  		      INNER JOIN base
652  			 ON dbp.object_name = base.object_name
653  			AND dbp.object_type = base.object_type
654  			AND dbp.owner	    = base.owner
655  			    -- user like condition
656  		      WHERE dbp.procedure_name LIKE l_like
657  			    -- user exclude condition
658  			AND NOT otap_string.is_sys_object(dbp.procedure_name, p_excl_sysgen)
659  		    )
660  		  , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
661  	     SELECT expected_count INTO l_test_count FROM cnt_prc;
662  	     -- build init
663  	     l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
664  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
665  	   END IF;
666  	   l_statement := '-- loop through package functions and triggers with names like ' || l_like;
667  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
668  	   FOR rec IN cur_pkg_proc(l_schema, l_package, l_like, p_excl_sysgen)
669  	   LOOP
670  	     l_statement := 'SELECT otap_test.has_procedure( p_procedure_name => ''' || rec.procedure_name || '''';
671  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
672  	     l_statement := '				   , p_schema => ''' || l_schema || '''';
673  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
674  	     l_statement := '				   , p_procedure_type => ''' || rec.procedure_type || '''';
675  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
676  	     l_statement := '				   , p_package_name => ''' || rec.package_name || '''';
677  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
678  	     IF rec.procedure_type = 'FUNCTION'
679  	     THEN
680  	       l_statement := ' 			     , p_return_type => ''' || rec.return_type || '''';
681  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
682  	     END IF;
683  	     l_statement := '				   ) FROM dual;';
684  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
685  	   END LOOP;
686  	   IF NVL(p_show_header, 1) = 1
687  	   THEN
688  	     -- build finish
689  	     l_statement := '-- finish package function and procedure tests for ' || l_package;
690  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
691  	     l_statement := '-- finish test session';
692  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
693  	     l_statement := 'SELECT otap_test.finish_test FROM dual;';
694  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
695  	     l_statement := 'SELECT * FROM otap_latest_test_results_v;';
696  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
697  	     -- add AI and copyright
698  	     l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
699  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
700  	     l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
701  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
702  	     l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
703  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
704  	   ELSE
705  	     l_statement := '-- finish package function and procedure tests for ' || l_package;
706  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
707  	   END IF;
708  	 END IF;
709  	 RETURN;
710    EXCEPTION
711  	 WHEN NO_DATA_NEEDED THEN
712  	   RAISE;
713    END pkg_procedures;
714  
715    FUNCTION package_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
716  			     , p_like_package  IN VARCHAR2 DEFAULT '%'
717  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
718  			     , p_show_header   IN INTEGER  DEFAULT 1
719  			     , p_excl_sysgen   IN INTEGER  DEFAULT 1
720  			     )
721  	 RETURN otap_view_result_tbl PIPELINED
722    IS
723  	 l_statement   VARCHAR2(4000 CHAR);
724  	 l_schema      VARCHAR2(128 CHAR);
725  	 l_base_title  VARCHAR2(256 CHAR);
726  	 l_like        VARCHAR2(256 CHAR);
727  	 l_count       INTEGER;
728  	 l_test_count  INTEGER;
729  	 CURSOR cur_packages( cp_schema IN VARCHAR2
730  			    , cp_like	IN VARCHAR2
731  			    , cp_excl	IN NUMBER
732  			    )
733  	 IS
734  	   SELECT object_name AS package_name
735  		, COUNT(*)    AS package_objects
736  	     FROM dba_objects
737  	    WHERE owner 	 = cp_schema
738  	      AND object_type LIKE 'PACKAGE%'
739  	      AND object_name LIKE cp_like
740  	      AND NOT otap_string.is_sys_object(object_name, cp_excl)
741  	    GROUP BY object_name
742  	 ;
743  	 CURSOR cur_procedures( cp_schema  IN VARCHAR2
744  			      , cp_package IN VARCHAR2
745  			      , cp_like    IN VARCHAR2
746  			      , cp_prefix  IN VARCHAR2
747  			      , cp_excl    IN NUMBER
748  			      )
749  	 IS
750  	   SELECT result_text
751  	     FROM TABLE(otap_generate.pkg_procedures(cp_package, cp_like, cp_schema, cp_prefix, 0, cp_excl))
752  	 ;
753    BEGIN
754  	 l_like       := NVL(p_like_package, '%');
755  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
756  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
757  	 IF NVL(p_show_header, 1) = 1
758  	 THEN
759  	   l_statement := '-- otap GENERATE package test scripts for schema ' || l_schema || ' scope: ' || l_like;
760  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
761  	   -- get test count, simulate conditions of called test generators
762  	      WITH base AS
763  		  (SELECT object_name
764  			, object_type
765  			, owner
766  		     FROM dba_objects
767  		    WHERE owner = l_schema
768  			  -- currently supported objects
769  		      AND object_type LIKE 'PACKAGE%'
770  			  -- user like condition
771  		      AND object_name LIKE l_like
772  			  -- user exclude condition
773  		      AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
774  		  )
775  		  -- counter objects
776  		, cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
777  		  -- depending procedures
778  		, prc AS
779  		  (SELECT dbp.procedure_name
780  			, dbp.object_name
781  			, dbp.object_type
782  		     FROM dba_procedures dbp
783  		    INNER JOIN base
784  		       ON dbp.object_name = base.object_name
785  		      AND dbp.object_type = base.object_type
786  		      AND dbp.owner	  = base.owner
787  			  -- exclude pure functions and procedures, already counted by base
788  		      AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
789  			  -- user like condition
790  		    WHERE dbp.procedure_name LIKE l_like
791  			  -- user exclude condition
792  		      AND NOT otap_string.is_sys_object(dbp.procedure_name, p_excl_sysgen)
793  		  )
794  		, cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
795  		, cnt AS
796  		  (SELECT expected_count, 'BASE' AS info FROM cnt_base
797  		    UNION ALL
798  		   SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
799  		  )
800  	   SELECT SUM(expected_count) INTO l_test_count FROM cnt;
801  	   -- build init
802  	   l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
803  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
804  	 END IF;
805  	 -- build group row
806  	 l_statement := '-- set test group for package';
807  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
808  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' packages'') FROM dual;';
809  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
810  	 -- first loop through packages
811  	 FOR rec IN cur_packages(l_schema, l_like, p_excl_sysgen)
812  	 LOOP
813  	   l_statement := '-- set test name for package';
814  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
815  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' package ' || rec.package_name || ''') FROM dual;';
816  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
817  	   l_statement := 'SELECT otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
818  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
819  	   l_statement := '			       , p_schema => ''' || l_schema || '''';
820  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
821  	   l_statement := '			       ) FROM dual;';
822  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
823  	   IF rec.package_objects = 2
824  	   THEN
825  	     l_statement := 'SELECT otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
826  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
827  	     l_statement := '				 , p_schema => ''' || l_schema || '''';
828  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
829  	     l_statement := '				 , p_package_type => ''PACKAGE BODY''';
830  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
831  	     l_statement := '				 ) FROM dual;';
832  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
833  	   END IF;
834  	   -- now loop through the package procedures and functions
835  	   FOR recfn IN cur_procedures(l_schema, rec.package_name, l_like, p_title_prefix, p_excl_sysgen)
836  	   LOOP
837  	     PIPE ROW (otap_view_result_rec(recfn.result_text, NULL));
838  	   END LOOP;
839  	 END LOOP;
840  	 IF NVL(p_show_header, 1) = 1
841  	 THEN
842  	   -- build finish
843  	   l_statement := '-- finish package tests for ' || l_like;
844  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
845  	   l_statement := '-- finish test session';
846  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
847  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
848  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
849  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
850  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
851  	   -- add AI and copyright
852  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
853  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
854  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
855  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
856  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
857  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
858  	 ELSE
859  	   l_statement := '-- finish package tests for ' || l_like;
860  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
861  	 END IF;
862  	 RETURN;
863    EXCEPTION
864  	 WHEN NO_DATA_NEEDED THEN
865  	   RAISE;
866    END package_tests;
867  
868    FUNCTION view_tests( p_schema	    IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
869  			  , p_like_view     IN VARCHAR2 DEFAULT '%'
870  			  , p_title_prefix  IN VARCHAR2 DEFAULT NULL
871  			  , p_show_header   IN INTEGER	DEFAULT 1
872  			  , p_excl_sysgen   IN INTEGER	DEFAULT 1
873  			  )
874  	 RETURN otap_view_result_tbl PIPELINED
875    IS
876  	 l_statement   VARCHAR2(4000 CHAR);
877  	 l_schema      VARCHAR2(128 CHAR);
878  	 l_base_title  VARCHAR2(256 CHAR);
879  	 l_like        VARCHAR2(256 CHAR);
880  	 l_test_count  INTEGER;
881  	 CURSOR cur_views( cp_schema IN VARCHAR2
882  			 , cp_like   IN VARCHAR2
883  			 , cp_excl   IN NUMBER
884  			 )
885  	 IS
886  	   SELECT owner
887  		, object_name AS view_name
888  		, object_type
889  	     FROM dba_objects
890  	    WHERE owner 	 = cp_schema
891  	      AND object_type LIKE '%VIEW'
892  	      AND object_name LIKE cp_like
893  	      AND NOT otap_string.is_sys_object(object_name, cp_excl)
894  	    ORDER BY object_type DESC
895  		   , object_name
896  	 ;
897  	 CURSOR cur_columns( cp_schema IN VARCHAR2
898  			   , cp_table  IN VARCHAR2
899  			   , cp_like   IN VARCHAR2
900  			   , cp_prefix IN VARCHAR2
901  			   , cp_excl   IN NUMBER
902  			   )
903  	 IS
904  	   SELECT result_text
905  	     FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
906  	 ;
907    BEGIN
908  	 l_like       := NVL(p_like_view, '%');
909  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
910  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
911  	 IF NVL(p_show_header, 1) = 1
912  	 THEN
913  	   l_statement := '-- otap GENERATE view test scripts for schema ' || l_schema || ' scope: ' || l_like;
914  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
915  	   -- get test count, simulate conditions of called test generators
916  	      WITH base AS
917  		  (SELECT object_name
918  			, object_type
919  			, owner
920  		     FROM dba_objects
921  		    WHERE owner = l_schema
922  			  -- currently supported objects
923  		      AND object_type LIKE '%VIEW'
924  			  -- user like condition
925  		      AND object_name LIKE l_like
926  			  -- user exclude condition
927  		      AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
928  		  )
929  		  -- counter objects
930  		, cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
931  		, cols AS
932  		  (SELECT dbc.owner
933  			, dbc.table_name
934  			, dbc.column_name
935  		     FROM dba_tab_columns dbc
936  		    INNER JOIN base
937  		       ON dbc.owner	 = base.owner
938  		      AND dbc.table_name = base.object_name
939  			  -- user like condition
940  		    WHERE dbc.column_name LIKE l_like
941  			  -- user exclude condition
942  		      AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
943  		  )
944  		, cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
945  		, cnt AS
946  		  (SELECT expected_count, 'BASE' AS info FROM cnt_base
947  		    UNION ALL
948  		   SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
949  		  )
950  	   SELECT SUM(expected_count) INTO l_test_count FROM cnt;
951  	   -- build init
952  	   l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
953  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
954  	 END IF;
955  	 -- build group row
956  	 l_statement := '-- set test group for views';
957  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
958  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' views'') FROM dual;';
959  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
960  	 -- first loop through views
961  	 FOR rec IN cur_views(l_schema, l_like, p_excl_sysgen)
962  	 LOOP
963  	   l_statement := '-- set test name for view';
964  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
965  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' view ' || rec.view_name || ''') FROM dual;';
966  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
967  	   l_statement := 'SELECT otap_test.has_object( p_object_name => ''' || rec.view_name || '''';
968  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
969  	   l_statement := '			      , p_object_type => ''' || rec.object_type || '''';
970  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
971  	   l_statement := '			      , p_schema => ''' || l_schema || '''';
972  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
973  	   l_statement := '			      ) FROM dual;';
974  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
975  	   FOR colrec IN cur_columns(l_schema, rec.view_name, l_like, p_title_prefix, p_excl_sysgen)
976  	   LOOP
977  	     PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
978  	   END LOOP;
979  	 END LOOP;
980  	 IF NVL(p_show_header, 1) = 1
981  	 THEN
982  	   -- build finish
983  	   l_statement := '-- finish view tests for ' || l_like;
984  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
985  	   l_statement := '-- finish test session';
986  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
987  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
988  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
989  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
990  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
991  	   -- add AI and copyright
992  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
993  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
994  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
995  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
996  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
997  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
998  	 ELSE
999  	   l_statement := '-- finish view tests for ' || l_like;
1000  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1001  	  END IF;
1002  	  RETURN;
1003  	EXCEPTION
1004  	  WHEN NO_DATA_NEEDED THEN
1005  	    RAISE;
1006  	END view_tests;
1007  
1008  	FUNCTION schema_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1009  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
1010  			     , p_show_header   IN INTEGER  DEFAULT 1
1011  			     , p_excl_sysgen   IN INTEGER  DEFAULT 1
1012  			     )
1013  	  RETURN otap_view_result_tbl PIPELINED
1014  	IS
1015  	  l_statement	VARCHAR2(4000 CHAR);
1016  	  l_schema	VARCHAR2(128 CHAR);
1017  	  l_base_title	VARCHAR2(256 CHAR);
1018  	  l_like	VARCHAR2(1 CHAR);
1019  	  l_test_count	INTEGER;
1020  	  CURSOR cur_tables( cp_schema IN VARCHAR2
1021  			   , cp_like   IN VARCHAR2
1022  			   , cp_prefix IN VARCHAR2
1023  			   , cp_excl   IN NUMBER
1024  			   )
1025  	  IS
1026  	    SELECT result_text
1027  	      FROM TABLE(otap_generate.table_tests(cp_schema, cp_like, p_title_prefix, 0, cp_excl))
1028  	  ;
1029  	  CURSOR cur_trigger( cp_schema IN VARCHAR2
1030  			    , cp_like	IN VARCHAR2
1031  			    , cp_prefix IN VARCHAR2
1032  			    , cp_excl	IN NUMBER
1033  			    )
1034  	  IS
1035  	    SELECT result_text
1036  	      FROM TABLE(otap_generate.trigger_tests(cp_schema, cp_like, p_title_prefix, 0, cp_excl))
1037  	  ;
1038  	  CURSOR cur_packages( cp_schema IN VARCHAR2
1039  			     , cp_like	 IN VARCHAR2
1040  			     , cp_prefix IN VARCHAR2
1041  			     , cp_excl	 IN NUMBER
1042  			     )
1043  	  IS
1044  	    SELECT result_text
1045  	      FROM TABLE(otap_generate.package_tests(cp_schema, cp_like, p_title_prefix, 0, cp_excl))
1046  	  ;
1047  	  CURSOR cur_views( cp_schema IN VARCHAR2
1048  			  , cp_like   IN VARCHAR2
1049  			  , cp_prefix IN VARCHAR2
1050  			  , cp_excl   IN NUMBER
1051  			  )
1052  	  IS
1053  	    SELECT result_text
1054  	      FROM TABLE(otap_generate.view_tests(cp_schema, cp_like, p_title_prefix, 0, cp_excl))
1055  	  ;
1056  	BEGIN
1057  	  l_like       := '%';
1058  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1059  	  l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
1060  	  IF NVL(p_show_header, 1) = 1
1061  	  THEN
1062  	    l_statement := '-- otap GENERATE test scripts for schema ' || l_schema;
1063  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1064  	    -- get test count, simulate conditions of called test generators
1065  	       WITH base AS
1066  		   (SELECT object_name
1067  			 , object_type
1068  			 , owner
1069  		      FROM dba_objects
1070  		     WHERE owner = l_schema
1071  			   -- currently supported objects
1072  		       AND (   object_type   IN ('TABLE', 'FUNCTION', 'PROCEDURE')
1073  			    OR object_type LIKE '%VIEW'
1074  			    OR object_type LIKE 'PACKAGE%'
1075  			   )
1076  			   -- user like condition
1077  		       AND object_name LIKE l_like
1078  			   -- user exclude condition
1079  		       AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1080  		   )
1081  		   -- counter objects
1082  		 , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1083  		   -- depending procedures
1084  		 , prc AS
1085  		   (SELECT dbp.procedure_name
1086  			 , dbp.object_name
1087  			 , dbp.object_type
1088  		      FROM dba_procedures dbp
1089  		     INNER JOIN base
1090  			ON dbp.object_name = base.object_name
1091  		       AND dbp.object_type = base.object_type
1092  		       AND dbp.owner	   = base.owner
1093  			   -- exclude pure functions and procedures, already counted by base
1094  		       AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
1095  			   -- user like condition
1096  		     WHERE dbp.procedure_name LIKE l_like
1097  			   -- user exclude condition
1098  		       AND NOT otap_string.is_sys_object(dbp.procedure_name, p_excl_sysgen)
1099  		   )
1100  		 , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
1101  		 , cols AS
1102  		   (SELECT dbc.owner
1103  			 , dbc.table_name
1104  			 , dbc.column_name
1105  		      FROM dba_tab_columns dbc
1106  		     INNER JOIN base
1107  			ON dbc.owner	  = base.owner
1108  		       AND dbc.table_name = base.object_name
1109  			   -- user like condition
1110  		     WHERE dbc.column_name LIKE l_like
1111  			   -- user exclude condition
1112  		       AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
1113  		   )
1114  		 , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
1115  		   -- table triggers
1116  		 , trgt AS
1117  		   (SELECT dbt.owner
1118  			 , dbt.trigger_name
1119  			 , dbt.table_owner
1120  		      FROM dba_triggers dbt
1121  		     INNER JOIN base
1122  			ON dbt.table_owner	= base.owner
1123  		       AND dbt.table_name	= base.object_name
1124  		       AND dbt.base_object_type = base.object_type
1125  		     WHERE dbt.table_name     IS NOT NULL
1126  			   -- user like condition
1127  		       AND dbt.trigger_name LIKE l_like
1128  			   -- user exclude condition
1129  		       AND NOT otap_string.is_sys_object(dbt.trigger_name, p_excl_sysgen)
1130  		   )
1131  		 , cnt_trgt AS (SELECT COUNT(*) AS expected_count FROM trgt)
1132  		 , trgs AS
1133  		   (SELECT dbt.owner
1134  			 , dbt.trigger_name
1135  			 , dbt.table_owner
1136  		      FROM dba_triggers dbt
1137  		     INNER JOIN base
1138  			ON dbt.owner = base.owner
1139  		     WHERE dbt.table_name     IS NULL
1140  			   -- user like condition
1141  		       AND dbt.trigger_name LIKE l_like
1142  			   -- user exclude condition
1143  		       AND NOT otap_string.is_sys_object(dbt.trigger_name, p_excl_sysgen)
1144  		   )
1145  		 , cnt_trgs AS (SELECT COUNT(*) AS expected_count FROM trgs)
1146  		 , cnt AS
1147  		   (SELECT expected_count, 'BASE' AS info FROM cnt_base
1148  		     UNION ALL
1149  		    SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
1150  		     UNION ALL
1151  		    SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
1152  		     UNION ALL
1153  		    SELECT expected_count, 'TABLE TRIGGER' AS info FROM cnt_trgt
1154  		     UNION ALL
1155  		    SELECT expected_count, 'SCHEMA TRIGGER' AS info FROM cnt_trgs
1156  		   )
1157  	    SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1158  	    -- build init
1159  	    l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
1160  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1161  	  END IF;
1162  	  -- build set row
1163  	  l_statement := '-- set test set for schema';
1164  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1165  	  l_statement := 'SELECT otap_test.set_test_set(''' || l_base_title || ' schema'') FROM dual;';
1166  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1167  	  FOR rec IN cur_tables(l_schema, l_like, p_title_prefix, p_excl_sysgen)
1168  	  LOOP
1169  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1170  	  END LOOP;
1171  	  FOR rec IN cur_trigger(l_schema, l_like, p_title_prefix, p_excl_sysgen)
1172  	  LOOP
1173  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1174  	  END LOOP;
1175  	  FOR rec IN cur_packages(l_schema, l_like, p_title_prefix, p_excl_sysgen)
1176  	  LOOP
1177  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1178  	  END LOOP;
1179  	  FOR rec IN cur_views(l_schema, l_like, p_title_prefix, p_excl_sysgen)
1180  	  LOOP
1181  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1182  	  END LOOP;
1183  	  IF NVL(p_show_header, 1) = 1
1184  	  THEN
1185  	    -- build finish
1186  	    l_statement := '-- finish schema tests for ' || l_schema;
1187  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1188  	    l_statement := '-- finish test session';
1189  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1190  	    l_statement := 'SELECT otap_test.finish_test FROM dual;';
1191  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1192  	    -- build example spool
1193  	    l_statement := '-- example spool setup for test script generation';
1194  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1195  	    l_statement := 'SET ECHO OFF';
1196  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1197  	    l_statement := 'SET VERIFY OFF';
1198  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1199  	    l_statement := 'SET FEEDBACK OFF';
1200  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1201  	    l_statement := 'SET HEADING OFF';
1202  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1203  	    l_statement := 'SET TRIMSPOOL ON';
1204  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1205  	    l_statement := 'SET LINESIZE 9999';
1206  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1207  	    l_statement := 'SET NEWPAGE NONE';
1208  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1209  	    l_statement := 'SET PAGESIZE 9999';
1210  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1211  	    l_statement := 'SPOOL generated_schema_tests.sql';
1212  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1213  	    l_statement := 'SELECT * FROM otap_latest_test_results_v;';
1214  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1215  	    l_statement := 'SPOOL OFF';
1216  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1217  	    -- add AI and copyright
1218  	    l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
1219  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1220  	    l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
1221  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
