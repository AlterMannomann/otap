 43    PROCEDURE validate_config_name( p_config_name IN VARCHAR2
 44  				     , p_del_trigger IN BOOLEAN  DEFAULT FALSE
 45  				     )
 46    IS
 47  	 l_script VARCHAR2(1024 CHAR) := 'otap_util.validate_config_name';
 48    BEGIN
 49  
 50  	 IF NOT p_del_trigger
 51  	 THEN
 52  	   -- check name against a fixed list, disabled during development
 53  	   IF p_config_name IS NULL -- p_config_name NOT IN (...)
 54  	   THEN
 55  	     -- log the error
 56  	     otap_log.log('-20001 The configuration name: ' || NVL(p_config_name, 'NULL') || ' is not supported', l_script);
 57  	     -- only direct testing could call this currently as table has a NOT NULL constraint
 58  	     RAISE_APPLICATION_ERROR(-20001, 'The configuration name: ' || NVL(p_config_name, 'NULL') || ' is not supported.');
 59  	   END IF;
 60  	 ELSE
 61  	   -- check name against a fixed list, disabled during development
 62  	   IF p_config_name IS NOT NULL -- p_config_name IN (...)
 63  	   THEN
 64  	     -- log the error
 65  	     otap_log.log('-20006 The configuration name: ' || NVL(p_config_name, 'NULL') || ' cannot be deleted.', l_script);
 66  	     -- only direct testing could call this currently as table has a NOT NULL constraint
 67  	     RAISE_APPLICATION_ERROR(-20006, 'The configuration name: ' || NVL(p_config_name, 'NULL') || ' cannot be deleted.');
 68  	   END IF;
 69  	 END IF;
 70    END validate_config_name;
