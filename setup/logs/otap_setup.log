391    FUNCTION pkg_procedures( p_package_name	 IN VARCHAR
392  			      , p_like_procedure IN VARCHAR2 DEFAULT '%'
393  			      , p_schema	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
394  			      , p_title_prefix	 IN VARCHAR2 DEFAULT NULL
395  			      , p_show_header	 IN INTEGER  DEFAULT 1
396  			      )
397  	 RETURN otap_view_result_tbl PIPELINED
398    IS
399  	 l_statement   VARCHAR2(4000 CHAR);
400  	 l_schema      VARCHAR2(128 CHAR);
401  	 l_base_title  VARCHAR2(256 CHAR);
402  	 l_like        VARCHAR2(256 CHAR);
403  	 l_package     VARCHAR2(128 CHAR);
404  	 l_test_count  INTEGER;
405  	 CURSOR cur_pkg_proc( cp_schema  IN VARCHAR2
406  			    , cp_package IN VARCHAR2
407  			    , cp_like	 IN VARCHAR2
408  			    )
409  	 IS
410  	     WITH prc AS
411  		  (SELECT dbo.owner
412  			, dbp.procedure_name
413  			, CASE
414  			    WHEN dbr.position	    = 0
415  			     AND dbr.argument_name IS NULL
416  			    THEN 'FUNCTION'
417  			    ELSE 'PROCEDURE'
418  			  END AS procedure_type
419  			, CASE
420  			    WHEN dbr.position	    = 0
421  			     AND dbr.argument_name IS NULL
422  			    THEN dbr.data_type
423  			    ELSE NULL
424  			  END AS return_type
425  			, dbo.status
426  			, dbo.object_name AS package_name
427  		     FROM dba_objects dbo
428  		     LEFT OUTER JOIN dba_procedures dbp
429  		       ON dbo.owner	  = dbp.owner
430  		      AND dbo.object_name = dbp.object_name
431  		      AND dbo.object_type = dbp.object_type
432  		     LEFT OUTER JOIN dba_arguments dbr
433  		       ON dbp.owner	    = dbr.owner
434  		      AND dbp.object_name   = dbr.package_name
435  		      AND dbp.procedure_name = dbr.object_name
436  		      AND dbp.object_id     = dbr.object_id
437  		      AND dbp.subprogram_id = dbr.subprogram_id
438  		      AND dbr.sequence	    = 1
439  		    WHERE dbo.owner	   = cp_schema
440  		      AND dbo.object_type  = 'PACKAGE'
441  			  -- exclude package itself
442  		      AND dbp.procedure_name IS NOT NULL
443  		    UNION ALL
444  		   SELECT dbo.owner
445  			, dbo.object_name AS procedure_name
446  			, dbo.object_type AS procedure_type
447  			, CASE
448  			    WHEN dbr.position	    = 0
449  			     AND dbr.argument_name IS NULL
450  			    THEN dbr.data_type
451  			    ELSE NULL
452  			  END AS return_type
453  			, dbo.status
454  			, NULL AS package_name
455  		     FROM dba_objects dbo
456  		     LEFT OUTER JOIN dba_procedures dbp
457  		       ON dbo.owner	  = dbp.owner
458  		      AND dbo.object_name = dbp.object_name
459  		      AND dbo.object_type = dbp.object_type
460  		     LEFT OUTER JOIN dba_arguments dbr
461  		       ON dbp.owner	    = dbr.owner
462  		      AND dbp.object_name   = dbr.object_name
463  		      AND dbp.object_id     = dbr.object_id
464  		      AND dbp.subprogram_id = dbr.subprogram_id
465  		      AND dbr.sequence	    = 1
466  		    WHERE dbo.owner	   = cp_schema
467  		      AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
468  		  )
469  	   SELECT DISTINCT
470  		  owner
471  		, procedure_name
472  		, procedure_type
473  		, return_type
474  		, status
475  		, package_name
476  	     FROM prc
477  	    WHERE package_name	    = cp_package
478  	      AND procedure_name LIKE cp_like
479  	 ;
480    BEGIN
481  	 l_package := otap_string.reduce(p_package_name, 128);
482  	 IF l_package IS NOT NULL
483  	 THEN
484  	   l_like	:= NVL(p_like_procedure, '%');
485  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
486  	   l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
487  	   IF NVL(p_show_header, 1) = 1
488  	   THEN
489  	     l_statement := '-- otap GENERATE package function and procedure test scripts for package ' || l_schema || '.' || l_package || ' scope: ' || l_like;
490  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
491  	     -- get test count
492  	     SELECT SUM(expected_tests) + 1 -- add one for the test count test
493  	       INTO l_test_count
494  	       FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type IN ('PACKAGE', 'PACKAGE BODY')
495  		      UNION ALL
496  		     SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema AND procedure_name IS NOT NULL
497  		    )
498  	     ;
499  	     -- build init
500  	     l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
501  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
502  	   END IF;
503  	   l_statement := '-- loop through package functions and triggers with names like ' || l_like;
504  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
505  	   FOR rec IN cur_pkg_proc(l_schema, l_package, l_like)
506  	   LOOP
507  	     l_statement := 'SELECT otap_test.has_procedure( p_procedure_name => ''' || rec.procedure_name || '''';
508  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
509  	     l_statement := '				   , p_schema => ''' || l_schema || '''';
510  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
511  	     l_statement := '				   , p_procedure_type => ''' || rec.procedure_type || '''';
512  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
513  	     l_statement := '				   , p_package_name => ''' || rec.package_name || '''';
514  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
515  	     IF rec.procedure_type = 'FUNCTION'
516  	     THEN
517  	       l_statement := ' 			     , p_return_type => ''' || rec.return_type || '''';
518  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
519  	     END IF;
520  	     l_statement := '				   ) FROM dual;';
521  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
522  	   END LOOP;
523  	   IF NVL(p_show_header, 1) = 1
524  	   THEN
525  	     -- build finish
526  	     l_statement := '-- finish package function and procedure tests for ' || l_package;
527  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
528  	     l_statement := '-- finish test session';
529  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
530  	     l_statement := 'SELECT otap_test.finish_test FROM dual;';
531  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
532  	     l_statement := 'SELECT * FROM otap_latest_test_results_v;';
533  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
534  	     -- add AI and copyright
535  	     l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
536  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
537  	     l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
538  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
539  	     l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
540  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
541  	   ELSE
542  	     l_statement := '-- finish package function and procedure tests for ' || l_package;
543  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
544  	   END IF;
545  	 END IF;
546  	 RETURN;
547    EXCEPTION
548  	 WHEN NO_DATA_NEEDED THEN
549  	   RAISE;
550    END pkg_procedures;
551  
552    FUNCTION package_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
553  			     , p_like_package  IN VARCHAR2 DEFAULT '%'
554  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
555  			     , p_show_header   IN INTEGER  DEFAULT 1
556  			     )
557  	 RETURN otap_view_result_tbl PIPELINED
558    IS
559  	 l_statement   VARCHAR2(4000 CHAR);
560  	 l_schema      VARCHAR2(128 CHAR);
561  	 l_base_title  VARCHAR2(256 CHAR);
562  	 l_like        VARCHAR2(256 CHAR);
563  	 l_count       INTEGER;
564  	 l_test_count  INTEGER;
565  	 CURSOR cur_packages( cp_schema IN VARCHAR2
566  			    , cp_like	IN VARCHAR2
567  			    )
568  	 IS
569  	   SELECT object_name AS package_name
570  		, COUNT(*)    AS package_objects
571  	     FROM dba_objects
572  	    WHERE owner 	 = cp_schema
573  	      AND object_type LIKE 'PACKAGE%'
574  	      AND object_name LIKE cp_like
575  	    GROUP BY object_name
576  	 ;
577  	 CURSOR cur_procedures( cp_schema  IN VARCHAR2
578  			      , cp_package IN VARCHAR2
579  			      , cp_like    IN VARCHAR2
580  			      , cp_prefix  IN VARCHAR2
581  			      )
582  	 IS
583  	   SELECT result_text
584  	     FROM TABLE(otap_generate.pkg_procedures(cp_package, cp_like, cp_schema, cp_prefix, 0))
585  	 ;
586    BEGIN
587  	 l_like       := NVL(p_like_package, '%');
588  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
589  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
590  	 IF NVL(p_show_header, 1) = 1
591  	 THEN
592  	   l_statement := '-- otap GENERATE package test scripts for schema ' || l_schema || ' scope: ' || l_like;
593  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
594  	   -- get test count
595  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
596  	     INTO l_test_count
597  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type IN ('PACKAGE', 'PACKAGE BODY')
598  		    UNION ALL
599  		   SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema AND procedure_name IS NOT NULL
600  		  )
601  	   ;
602  	   -- build init
603  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
604  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
605  	 END IF;
606  	 -- build group row
607  	 l_statement := '-- set test group for package';
608  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
609  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' packages'') FROM dual;';
610  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
611  	 -- first loop through packages
612  	 FOR rec IN cur_packages(l_schema, l_like)
613  	 LOOP
614  	   l_statement := '-- set test name for package';
615  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
616  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' package ' || rec.package_name || ''') FROM dual;';
617  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
618  	   l_statement := 'SELECT otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
619  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
620  	   l_statement := '			       , p_schema => ''' || l_schema || '''';
621  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
622  	   l_statement := '			       ) FROM dual;';
623  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
624  	   IF rec.package_objects = 2
625  	   THEN
626  	     l_statement := 'SELECT otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
627  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
628  	     l_statement := '				 , p_schema => ''' || l_schema || '''';
629  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
630  	     l_statement := '				 , p_package_type => ''PACKAGE BODY''';
631  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
632  	     l_statement := '				 ) FROM dual;';
633  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
634  	   END IF;
635  	   -- now loop through the package procedures and functions
636  	   FOR recfn IN cur_procedures(l_schema, rec.package_name, l_like, p_title_prefix)
637  	   LOOP
638  	     PIPE ROW (otap_view_result_rec(recfn.result_text, NULL));
639  	   END LOOP;
640  	 END LOOP;
641  	 IF NVL(p_show_header, 1) = 1
642  	 THEN
643  	   -- build finish
644  	   l_statement := '-- finish package tests for ' || l_like;
645  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
646  	   l_statement := '-- finish test session';
647  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
648  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
649  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
650  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
651  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
652  	   -- add AI and copyright
653  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
654  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
655  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
656  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
657  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
658  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
659  	 ELSE
660  	   l_statement := '-- finish package tests for ' || l_like;
661  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
662  	 END IF;
663  	 RETURN;
664    EXCEPTION
665  	 WHEN NO_DATA_NEEDED THEN
666  	   RAISE;
667    END package_tests;
668  
669    FUNCTION view_tests( p_schema	    IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
670  			  , p_like_view     IN VARCHAR2 DEFAULT '%'
671  			  , p_title_prefix  IN VARCHAR2 DEFAULT NULL
672  			  , p_show_header   IN INTEGER	DEFAULT 1
673  			  )
674  	 RETURN otap_view_result_tbl PIPELINED
675    IS
676  	 l_statement   VARCHAR2(4000 CHAR);
677  	 l_schema      VARCHAR2(128 CHAR);
678  	 l_base_title  VARCHAR2(256 CHAR);
679  	 l_like        VARCHAR2(256 CHAR);
680  	 l_test_count  INTEGER;
681  	 CURSOR cur_views( cp_schema IN VARCHAR2
682  			 , cp_like   IN VARCHAR2
683  			 )
684  	 IS
685  	   SELECT owner
686  		, object_name AS view_name
687  		, object_type
688  	     FROM dba_objects
689  	    WHERE owner 	 = cp_schema
690  	      AND object_type LIKE '%VIEW'
691  	      AND object_name LIKE cp_like
692  	    ORDER BY object_type DESC
693  		   , object_name
694  	 ;
695  	 CURSOR cur_columns( cp_schema IN VARCHAR2
696  			   , cp_table  IN VARCHAR2
697  			   , cp_like   IN VARCHAR2
698  			   , cp_prefix IN VARCHAR2
699  			   )
700  	 IS
701  	   SELECT result_text
702  	     FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, '$', 0))
703  	 ;
704    BEGIN
705  	 l_like       := NVL(p_like_view, '%');
706  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
707  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
708  	 IF NVL(p_show_header, 1) = 1
709  	 THEN
710  	   l_statement := '-- otap GENERATE view test scripts for schema ' || l_schema || ' scope: ' || l_like;
711  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
712  	   -- get test count
713  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
714  	     INTO l_test_count
715  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type IN ('PACKAGE', 'PACKAGE BODY')
716  		    UNION ALL
717  		   SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema AND procedure_name IS NOT NULL
718  		  )
719  	   ;
720  	   -- build init
721  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
722  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
723  	 END IF;
724  	 -- build group row
725  	 l_statement := '-- set test group for views';
726  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
727  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' views'') FROM dual;';
728  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
729  	 -- first loop through views
730  	 FOR rec IN cur_views(l_schema, l_like)
731  	 LOOP
732  	   l_statement := '-- set test name for view';
733  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
734  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' view ' || rec.view_name || ''') FROM dual;';
735  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
736  	   l_statement := 'SELECT otap_test.has_object( p_object_name => ''' || rec.view_name || '''';
737  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
738  	   l_statement := '			      , p_object_type => ''' || rec.object_type || '''';
739  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
740  	   l_statement := '			      , p_schema => ''' || l_schema || '''';
741  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
742  	   l_statement := '			      ) FROM dual;';
743  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
744  	   FOR colrec IN cur_columns(l_schema, rec.view_name, '%', p_title_prefix)
745  	   LOOP
746  	     PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
747  	   END LOOP;
748  	 END LOOP;
749  	 IF NVL(p_show_header, 1) = 1
750  	 THEN
751  	   -- build finish
752  	   l_statement := '-- finish view tests for ' || l_like;
753  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
754  	   l_statement := '-- finish test session';
755  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
756  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
757  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
758  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
759  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
760  	   -- add AI and copyright
761  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
762  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
763  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
764  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
765  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
766  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
767  	 ELSE
768  	   l_statement := '-- finish view tests for ' || l_like;
769  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
770  	 END IF;
771  	 RETURN;
772    EXCEPTION
773  	 WHEN NO_DATA_NEEDED THEN
774  	   RAISE;
775    END view_tests;
776  
777    FUNCTION schema_tests( p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
778  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
779  			    , p_show_header   IN INTEGER  DEFAULT 1
780  			    )
781  	 RETURN otap_view_result_tbl PIPELINED
782    IS
783  	 l_statement   VARCHAR2(4000 CHAR);
784  	 l_schema      VARCHAR2(128 CHAR);
785  	 l_base_title  VARCHAR2(256 CHAR);
786  	 l_like        VARCHAR2(1 CHAR);
787  	 l_test_count  INTEGER;
788  	 CURSOR cur_tables( cp_schema IN VARCHAR2
789  			  , cp_like   IN VARCHAR2
790  			  , cp_prefix IN VARCHAR2
791  			  )
792  	 IS
793  	   SELECT result_text
794  	     FROM TABLE(otap_generate.table_tests(cp_schema, cp_like, p_title_prefix, 0))
795  	 ;
796  	 CURSOR cur_trigger( cp_schema IN VARCHAR2
797  			   , cp_like   IN VARCHAR2
798  			   , cp_prefix IN VARCHAR2
799  			   )
800  	 IS
801  	   SELECT result_text
802  	     FROM TABLE(otap_generate.trigger_tests(cp_schema, cp_like, p_title_prefix, 0))
803  	 ;
804  	 CURSOR cur_packages( cp_schema IN VARCHAR2
805  			    , cp_like	IN VARCHAR2
806  			    , cp_prefix IN VARCHAR2
807  			    )
808  	 IS
809  	   SELECT result_text
810  	     FROM TABLE(otap_generate.package_tests(cp_schema, cp_like, p_title_prefix, 0))
811  	 ;
812  	 CURSOR cur_views( cp_schema IN VARCHAR2
813  			 , cp_like   IN VARCHAR2
814  			 , cp_prefix IN VARCHAR2
815  			 )
816  	 IS
817  	   SELECT result_text
818  	     FROM TABLE(otap_generate.view_tests(cp_schema, cp_like, p_title_prefix, 0))
819  	 ;
820    BEGIN
821  	 l_like       := '%';
822  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
823  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
824  	 IF NVL(p_show_header, 1) = 1
825  	 THEN
826  	   l_statement := '-- otap GENERATE test scripts for schema ' || l_schema;
827  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
828  	   -- get test count
829  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
830  	     INTO l_test_count
831  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type = 'TABLE'
832  		    UNION ALL
833  		   SELECT COUNT(*) AS expected_tests FROM dba_tab_columns WHERE owner = l_schema
834  		    UNION ALL
835  		   SELECT COUNT(*) AS expected_tests FROM dba_triggers WHERE owner = l_schema
836  		    UNION ALL
837  		   SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type LIKE 'PACKAGE%'
838  		    UNION ALL
839  		   SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type LIKE 'PACKAGE%'
840  		    UNION ALL
841  		   SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema
842  		  )
843  	   ;
844  	   -- build init
845  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
846  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
847  	 END IF;
848  	 -- build set row
849  	 l_statement := '-- set test set for schema';
850  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
851  	 l_statement := 'SELECT otap_test.set_test_set(''' || l_base_title || ' schema'') FROM dual;';
852  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
853  	 FOR rec IN cur_tables(l_schema, l_like, p_title_prefix)
854  	 LOOP
855  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
856  	 END LOOP;
857  	 FOR rec IN cur_trigger(l_schema, l_like, p_title_prefix)
858  	 LOOP
859  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
860  	 END LOOP;
861  	 FOR rec IN cur_packages(l_schema, l_like, p_title_prefix)
862  	 LOOP
863  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
864  	 END LOOP;
865  	 FOR rec IN cur_views(l_schema, l_like, p_title_prefix)
866  	 LOOP
867  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
868  	 END LOOP;
869  	 IF NVL(p_show_header, 1) = 1
870  	 THEN
871  	   -- build finish
872  	   l_statement := '-- finish schema tests for ' || l_schema;
873  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
874  	   l_statement := '-- finish test session';
875  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
876  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
877  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
878  	   -- build example spool
879  	   l_statement := '-- example spool setup for test script generation';
880  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
881  	   l_statement := 'SET ECHO OFF';
882  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
883  	   l_statement := 'SET VERIFY OFF';
884  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
885  	   l_statement := 'SET FEEDBACK OFF';
886  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
887  	   l_statement := 'SET HEADING OFF';
888  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
889  	   l_statement := 'SET TRIMSPOOL ON';
890  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
891  	   l_statement := 'SET LINESIZE 9999';
892  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
893  	   l_statement := 'SET NEWPAGE NONE';
894  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
895  	   l_statement := 'SET PAGESIZE 9999';
896  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
897  	   l_statement := 'SPOOL generated_schema_tests.sql';
898  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
899  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
900  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
901  	   l_statement := 'SPOOL OFF';
902  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
903  	   -- add AI and copyright
904  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
905  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
906  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
907  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
908  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
909  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
910  	 ELSE
911  	   l_statement := '-- finish schema tests for ' || l_schema;
912  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
913  	 END IF;
914  	 RETURN;
915    EXCEPTION
916  	 WHEN NO_DATA_NEEDED THEN
917  	   RAISE;
918    END schema_tests;
919  
920  END;
921  /

