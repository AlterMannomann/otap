SQL> CREATE OR REPLACE TYPE otap_session
  2    AS OBJECT
  3  	  -- provides the current data from a test session as stored in OTAP_TEST
  4  	  -- values may change during the session
  5  	  ( test_executor    VARCHAR2(128 CHAR)
  6  	  , test_set	     VARCHAR2(256 CHAR)
  7  	  , test_group	     VARCHAR2(256 CHAR)
  8  	  , test_name	     VARCHAR2(256 CHAR)
  9  	  , db_user	     VARCHAR2(128 CHAR)
 10  	  , db_schema	     VARCHAR2(128 CHAR)
 11  	  , test_prefix      VARCHAR2(4 CHAR)
 12  	  , test_count	     INTEGER
 13  	  , intended_count   INTEGER
 14  	  , persist_test     BOOLEAN
 15  	  , name_precedence  BOOLEAN
 16  	  , include_packages BOOLEAN
 17  	  , session_start    DATE
 18  	  , session_id	     INTEGER
 19  	  , error_count      INTEGER
 20  	  , session_view_id  INTEGER
 21  	  )
 22  ;
