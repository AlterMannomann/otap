 86    FUNCTION result_view(p_session_id IN NUMBER)
 87  	 RETURN otap_view_result_tbl PIPELINED
 88    IS
 89  	 l_delim_updown VARCHAR2(1) := '=';
 90  	 l_delim_tests	VARCHAR2(1) := '-';
 91  	 l_text_column	VARCHAR2(4000);
 92  	 l_has_errors	INTEGER;
 93  	 l_has_records	INTEGER;
 94  	 l_report_size	INTEGER;
 95  	 CURSOR cur_test_sets(cp_session_id IN NUMBER)
 96  	 IS
 97  	   SELECT test_set
 98  		, COUNT(*) AS test_runs
 99  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
100  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
101  		, TRIM(TO_CHAR(((MAX(test_run_date) - MIN(test_run_date)) DAY TO SECOND))) AS run_time
102  	     FROM otap_results
103  	    WHERE test_session_id = cp_session_id
104  	    GROUP BY test_set
105  	    ORDER BY MIN(test_run_date)
106  	 ;
107  	 CURSOR cur_test_groups( cp_session_id IN NUMBER
108  			       , cp_test_set   IN VARCHAR2
109  			       )
110  	 IS
111  	   SELECT test_group
112  		, COUNT(*) AS test_runs
113  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
114  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
115  		, TRIM(TO_CHAR(((MAX(test_run_date) - MIN(test_run_date)) DAY TO SECOND))) AS run_time
116  	     FROM otap_results
117  	    WHERE test_session_id = cp_session_id
118  	      AND test_set	  = cp_test_set
119  	    GROUP BY test_group
120  	    ORDER BY MIN(test_run_date)
121  	 ;
122  	 CURSOR cur_test_names( cp_session_id IN NUMBER
123  			      , cp_test_set   IN VARCHAR2
124  			      , cp_test_group IN VARCHAR2
125  			      )
126  	 IS
127  	   SELECT test_name
128  		, COUNT(*) AS test_runs
129  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
130  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
131  		, TRIM(TO_CHAR(((MAX(test_run_date) - MIN(test_run_date)) DAY TO SECOND))) AS run_time
132  	     FROM otap_results
133  	    WHERE test_session_id = cp_session_id
134  	      AND test_set	  = cp_test_set
135  	      AND test_group	  = cp_test_group
136  	    GROUP BY test_name
137  	    ORDER BY MIN(test_run_date)
138  	 ;
139  	 CURSOR cur_tests( cp_session_id IN NUMBER
140  			 , cp_test_set	 IN VARCHAR2
141  			 , cp_test_group IN VARCHAR2
142  			 , cp_test_name  IN VARCHAR2
143  			 )
144  	 IS
145  	   SELECT test_desc
146  		, test_passed
147  		, otap_api.test_result_to_text(test_passed) AS test_state
148  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
149  		, test_errors
150  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
151  	     FROM otap_results
152  	    WHERE test_session_id = cp_session_id
153  	      AND test_set	  = cp_test_set
154  	      AND test_group	  = cp_test_group
155  	      AND test_name	  = cp_test_name
156  	    ORDER BY test_run_date
157  	 ;
158    BEGIN
159  	 l_report_size := otap_api.max_text_size(p_session_id);
160  	 -- header row
161  	 l_text_column := otap_api.get_report_header(l_report_size);
162  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
163  	 l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
164  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
165  	 -- check for records
166  	 SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
167  	 IF l_has_records > 0
168  	 THEN
169  	   -- loop through the set
170  	   FOR rec_set IN cur_test_sets(p_session_id)
171  	   LOOP
172  	     -- build test set column
173  	     l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size);
174  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
175  	     -- build test set summary
176  	     l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size);
177  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
178  	     -- loop through the group
179  	     FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set)
180  	     LOOP
181  	       l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size);
182  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
183  	       -- build test set summary
184  	       l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size);
185  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
186  	       -- loop through the names
187  	       FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group)
188  	       LOOP
189  		 l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size);
190  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
191  		 -- build test set summary
192  		 l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size);
193  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
194  		 -- build header
195  		 l_text_column := otap_api.get_result_header(l_report_size);
196  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
197  		 l_text_column := otap_api.get_result_underline(l_report_size);
198  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
199  		 -- loop through the tests
200  		 FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
201  		 LOOP
202  		   l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
203  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
204  		 END LOOP;
205  		 SELECT COUNT(*)
206  		   INTO l_has_errors
207  		   FROM otap_results
208  		  WHERE test_session_id = p_session_id
209  		    AND test_set	= rec_set.test_set
210  		    AND test_group	= rec_grp.test_group
211  		    AND test_name	= rec_nam.test_name
212  		    AND test_errors    IS NOT NULL
213  		 ;
214  		 IF l_has_errors > 0
215  		 THEN
216  		   -- build error delimiter for tests
217  		   l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size);
218  		   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
219  		   FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
220  		   LOOP
221  		     IF rec_tst.test_errors IS NOT NULL
222  		     THEN
223  		       l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_string.flatten(rec_tst.test_errors, 4000), l_report_size);
224  		       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
225  		     END IF;
226  		   END LOOP;
227  		 END IF;
228  	       END LOOP;
229  	     END LOOP;
230  	   END LOOP;
231  	 ELSE
232  	   l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size);
233  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
234  	 END IF;
235  	 -- footer row
236  	 l_text_column := otap_api.get_report_footer(l_report_size);
237  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
238  	 RETURN;
239    EXCEPTION
240  	 WHEN OTHERS THEN
241  	   IF SQLCODE != -20099
242  	   THEN
243  	     otap_log.log(SQLERRM, 'otap_test.result_view', 'Unhandled exception otap_test.result_view');
244  	   END IF;
245  	   RAISE;
246    END result_view;
