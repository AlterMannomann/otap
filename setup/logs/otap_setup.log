  4    /**
  5    * This package provides the internal available test functions for schema objects which
  6    * are used by OTAP_API. All functions use PLSQL variable types as they are behind OTAP_API.
  7    *
  8    * All functions return a numeric test result as defined in otap_constants.OTAP_NUM_TEST_PASSED,
  9    * otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED.
 10    *
 11    * Test functions never manage session variables, but they always provide an error output. Decisions
 12    * based on session objects, e.g. which schema to use, must be managed by OTAP_API.
 13    */
 14  
 15    /** FUNCTION otap_schema.has_table
 16    * Tests if a table exists and returns a numeric test result.
 17    *
 18    * @param p_table_name The name of the table, taken as is. Case sensitive.
 19    * @param o_error Error information, if any, on the test executed.
 20    * @param p_schema The schema to use. If NULL current schema is used. Case sensitive.
 21    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 22    *
 23    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 24    */
 25    FUNCTION has_table( p_table_name      IN 	   VARCHAR2
 26  			 , o_errors		OUT NOCOPY VARCHAR2
 27  			 , p_schema	     IN 	   VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 28  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 29  			 )
 30  	 RETURN INTEGER
 31    ;
 32  
 33    /** FUNCTION otap_schema.has_column
 34    * Tests basically if a table column exists. Additional tests on the column can be added by using the additional
 35    * parameters with default NULL. The expected values have to match the content of DBA_TAB_COLUMNS for the given table,
 36    * column and schema.
 37    *
 38    * If checking defaults, it is limited to defaults not longer than 4000 char, using the DATA_DEFAULT_VC column. Expressions
 39    * must match all chars in the default, like quotation. Use q-syntax where possible to define correct strings, e.g.
 40    * SELECT q'[SYS_CONTEXT('USERENV', 'OS_USER')]' FROM dual;
 41    *
 42    * @param p_table_name The name of the table, taken as is. Case sensitive.
 43    * @param p_column_name The column name of the table, taken as is. Case sensitive.
 44    * @param o_error Error information, if any, on the test executed.
 45    * @param p_schema The schema to use. If NULL current schema is used. Case sensitive.
 46    * @param p_data_type Optional check the datatype of the column. Ignored if NULL. NOT case sensitive.
 47    * @param p_data_length Optional check the data length of the column. Ignored if NULL.
 48    * @param p_data_precision Optional check the data precision of the column. Ignored if NULL. Results in test error if datatype is not NUMBER.
 49    * @param p_data_scale Optional check the data scale of the column. Ignored if NULL. Results in test error if datatype is not NUMBER or TIMESTAMP.
 50    * @param p_nullable Optional check if the column is nullable. Ignored if NULL. NOT case sensitive.
 51    * @param p_data_default Optional check the default for the column. Ignored if NULL. Must match all chars, including ' and ". Limited to defaults shorter than 4000 chars.
 52    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 53    *
 54    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 55    */
 56    FUNCTION has_column( p_table_name      IN	    VARCHAR2
 57  			  , p_column_name     IN	    VARCHAR2
 58  			  , o_errors		 OUT NOCOPY VARCHAR2
 59  			  , p_schema	      IN	    VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 60  			  , p_data_type       IN	    VARCHAR2 DEFAULT NULL
 61  			  , p_data_length     IN	    NUMBER   DEFAULT NULL
 62  			  , p_data_precision  IN	    NUMBER   DEFAULT NULL
 63  			  , p_data_scale      IN	    NUMBER   DEFAULT NULL
 64  			  , p_nullable	      IN	    VARCHAR2 DEFAULT NULL
 65  			  , p_data_default    IN	    VARCHAR2 DEFAULT NULL
 66  			  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 67  			  )
 68  	 RETURN INTEGER
 69    ;
 70  
 71    /** FUNCTION otap_schema.has_package
 72    * Checks if a given package exists. Check if header and body, if available, are valid by default.
 73    *
 74    * @param p_package_name The name of the package, take as is. Case sensitive.
 75    * @param o_error Error information, if any, on the test executed.
