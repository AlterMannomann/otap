647    FUNCTION has_object( p_object_name     IN     VARCHAR2
648  			  , p_object_type     IN     VARCHAR2
649  			  , p_schema	      IN     VARCHAR2 DEFAULT NULL
650  			  , p_description     IN     VARCHAR2 DEFAULT NULL
651  			  , p_expected_result IN     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
652  			  )
653  	 RETURN VARCHAR2
654    IS
655  	 l_message VARCHAR2(4000 CHAR);
656    BEGIN
657  	 otap_api.validate_otap;
658  	 l_message := otap_api.has_object( p_object_name
659  					 , p_object_type
660  					 , session_record
661  					 , p_schema
662  					 , p_description
663  					 , p_expected_result
664  					 )
665  	 ;
666  	 RETURN l_message;
667    EXCEPTION
668  	 WHEN OTHERS THEN
669  	   IF SQLCODE != -20099
670  	   THEN
671  	     otap_log.log(SQLERRM, 'otap_test.has_object', 'l_message := otap_api.has_object( p_object_name, p_object_type, ...');
672  	   END IF;
673  	   RAISE;
674    END has_object;
675  
676    -- debug function
677    FUNCTION get_session_var
678  	 RETURN OTAP_SESSION
679    IS
680    BEGIN
681  	 RETURN session_record;
682    END get_session_var;
683  
684  END;
