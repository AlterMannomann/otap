164    FUNCTION otap_session_show(p_otap_session IN OTAP_SESSION)
165  	 RETURN VARCHAR2
166    IS
167  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_show';
168  	 l_message VARCHAR2(4000 CHAR);
169    BEGIN
170  	 -- verify the current object
171  	 otap_objects.otap_session_verify(p_otap_session);
172  	 -- build the message
173  	 l_message := 'Current test settings' || otap_constants.OTAP_INTERNAL_LF ||
174  		      'Test session id: ' || p_otap_session.session_id || otap_constants.OTAP_INTERNAL_LF ||
175  		      'Test set: ' || p_otap_session.test_set || otap_constants.OTAP_INTERNAL_LF ||
176  		      'Test group: ' || p_otap_session.test_group || otap_constants.OTAP_INTERNAL_LF ||
177  		      'Test name: ' || p_otap_session.test_name || otap_constants.OTAP_INTERNAL_LF ||
178  		      'Executor: ' || p_otap_session.test_executor || otap_constants.OTAP_INTERNAL_LF ||
179  		      'DB user: ' || p_otap_session.db_user || otap_constants.OTAP_INTERNAL_LF ||
180  		      'DB schema: ' || p_otap_session.db_schema || otap_constants.OTAP_INTERNAL_LF ||
181  		      'Test identifier prefix: ' || p_otap_session.test_prefix || otap_constants.OTAP_INTERNAL_LF ||
182  		      'Current tests:' || p_otap_session.test_count || otap_constants.OTAP_INTERNAL_LF ||
183  		      'Expected tests: ' || CASE WHEN p_otap_session.intended_count > 0 THEN TO_CHAR(p_otap_session.intended_count) ELSE 'Not set' END || otap_constants.OTAP_INTERNAL_LF ||
184  		      'Name precedence: ' || CASE WHEN p_otap_session.name_precedence THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
185  		      'Include packages: ' || CASE WHEN p_otap_session.include_packages THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
186  		      'Persist: ' || CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
187  		      'Current view id: ' || CASE WHEN p_otap_session.session_view_id = 0 THEN 'Not set' ELSE TO_CHAR(p_otap_session.session_view_id) END || otap_constants.OTAP_INTERNAL_LF ||
188  		      'Test start: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
189  	 ;
190  	 l_message := otap_string.reduce(l_message, 4000);
191  	 RETURN l_message;
192    EXCEPTION
193  	 WHEN OTHERS THEN
194  	   IF SQLCODE != -20099
195  	   THEN
196  	     -- log unhandled exceptions
197  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
198  	   END IF;
199  	   RAISE;
200    END otap_session_show;
