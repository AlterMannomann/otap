SQL> CREATE OR REPLACE TRIGGER otap_results_del_trg
  2    BEFORE DELETE ON otap_results
  3    FOR EACH ROW
  4  BEGIN
  5    IF :OLD.to_delete != otap_constants.OTAP_NUM_TRUE
  6    THEN
  7  	 RAISE_APPLICATION_ERROR(-20010, 'Record must be marked with TO_DELETE = 1. Peristent records cannot be deleted. Set TO_DELETE for run id ' || :OLD.test_run_id || ' and timestamp ' || TO_CHAR(:OLD.test_run_date, 'YYYY-MM-DD HH24:MI:SS.FF9'));
  8    END IF;
  9  END;
