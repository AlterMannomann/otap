164    FUNCTION is_eq( p_have		 IN	       VARCHAR2
165  		     , p_want		 IN	       VARCHAR2
166  		     , o_errors 	    OUT NOCOPY VARCHAR2
167  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
168  		     )
169  	 RETURN INTEGER
170    IS
171  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.is_eq';
172  	 l_test_passed	 INTEGER;
173  	 l_result	 INTEGER;
174  	 l_expected	 INTEGER;
175    BEGIN
176  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
177  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
178  	 IF p_want IS NOT NULL
179  	 THEN
180  	   IF p_have IS NOT NULL
181  	   THEN
182  	     l_result := CASE WHEN p_have = p_want THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
183  	   ELSE
184  	     l_result := otap_constants.OTAP_NUM_TEST_FAILED;
185  	   END IF;
186  	 ELSE
187  	   -- compare against NULL, p_want already checked
188  	   l_result := CASE WHEN p_have IS NULL THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
189  	 END IF;
190  	 l_test_passed := CASE WHEN l_expected = l_result THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
191  	 -- we expect currently no usage error only raise
192  	 o_errors      := NULL;
193  	 RETURN l_test_passed;
194    EXCEPTION
195  	 WHEN OTHERS THEN
196  	   IF SQLCODE != -20099
197  	   THEN
198  	     -- log unhandled exceptions
199  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' varchar2 call');
200  	   END IF;
201  	   RAISE;
202    END is_eq; -- VARCHAR2
