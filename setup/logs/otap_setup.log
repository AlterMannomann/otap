 89    OTAP_TEXT_TRUE			CONSTANT CHAR(4)	:= 'true';
 90    OTAP_TEXT_FALSE			CONSTANT CHAR(5)	:= 'false';
 91    OTAP_TEXT_TRUE_YES		CONSTANT CHAR(3)	:= 'Yes';
 92    OTAP_TEXT_FALSE_NO		CONSTANT CHAR(2)	:= 'No';
 93    OTAP_TEXT_TEST_PASSED		CONSTANT CHAR(6)	:= 'Passed';
