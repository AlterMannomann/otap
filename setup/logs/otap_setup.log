210    /** FUNCTION otap_string.decorate
211    * Decorates a given title string with the decoration char to left and right padded and a space between title and
212    * decoration char. Title is placed as defined by layout. Title will be cutted if it is too long, see
213    * otap_constants.OTAP_REPORT_MAX_FILL_LENGTH.
214    *
215    * M (middle): Title is placed in the middle, decoration chars padded and extended equally on both sides up to calculated line size.
216    * L (left): Minimum border decoration placed at the left followed by the title, right padding border decoration up to calculated line size.
217    * R (right): Minimum border decoration placed at the right with leading title, left padding border decoration up to calculated line size.
218    *
219    * Examples
220    * decorate('test', '-', 20, 'M', 3): ------- test -------
221    * decorate('test', '-', 20, 'L', 3): -- test ------------
222    * decorate('test', '-', 20, 'R', 3): ------------ test --
223    *
224    * @param p_title The title to use in the decorated line. If NULL a decorated line is created without any text inside.
225    * @param p_decoration The decoration char that should pad the title to the left and right including a space between text and decoration.
226    * @param p_min_length The minimum size for a decorated report line.
227    * @param p_layout The decoration layout orientation for the title in the decoration.
228    * @param p_border The decoration border length including the space to separate text from decoration.
229    *
230    * @return The decorated string. Limited to 4000 chars as it is used in SQL columns.
231    */
232    FUNCTION decorate( p_title	IN VARCHAR2 DEFAULT NULL
233  			, p_decoration	IN VARCHAR2 DEFAULT otap_constants.OTAP_FORMAT_NAME_CHAR
234  			, p_min_length	IN INTEGER  DEFAULT otap_constants.OTAP_REPORT_MIN_FILL_LENGTH
235  			, p_layout	IN VARCHAR2 DEFAULT otap_constants.OTAP_LAYOUT_DEFAULT
236  			, p_border	IN INTEGER  DEFAULT otap_constants.OTAP_BORDER_DEFAULT
237  			)
238  	 RETURN VARCHAR2
239    ;
