SQL> -- trigger
SQL> CREATE OR REPLACE TRIGGER otap_config_ins_trg
  2    BEFORE INSERT ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  , 'FORMAT_HEADER_CHAR'
 13  				  , 'FORMAT_SET_CHAR'
 14  				  , 'FORMAT_GROUP_CHAR'
 15  				  , 'FORMAT_NAME_CHAR'
 16  				  , 'TEXT_TRUE'
 17  				  , 'TEXT_FALSE'
 18  				  , 'TEXT_TRUE_YES'
 19  				  , 'TEXT_FALSE_NO'
 20  				  , 'TEXT_TEST_PASSED'
 21  				  , 'TEXT_TEST_FAILED'
 22  				  , 'TEXT_TEST_UNDEFINED'
 23  				  , 'DEFAULT_PREFIX'
 24  				  , 'DEFAULT_TEST_SET'
 25  				  , 'DEFAULT_TEST_GROUP'
 26  				  , 'DEFAULT_TEST_NAME'
 27  				  , 'DEFAULT_LAYOUT'
 28  				  , 'DEFAULT_RESULT_LAYOUT'
 29  				  , 'DEFAULT_BORDER'
 30  				  , 'TEXT_REPORT_START'
 31  				  , 'TEXT_REPORT_TOTAL'
 32  				  , 'TEXT_REPORT_END'
 33  				  , 'TEXT_RESULT_HEADER'
 34  				  , 'FORMAT_RESULT_HEADER'
 35  				  , 'TEXT_TEST_COUNT_HEADER'
 36  				  , 'TEXT_TEST_COUNT_NAME'
 37  				  , 'TEXT_SUMMARY_SUCCESS'
 38  				  , 'TEXT_SUMMARY_ERROR'
 39  				  , 'SUMMARY_TEMPLATE'
 40  				  , 'ERRORS_TEMPLATE'
 41  				  , 'ERROR_DETAILS_TEMPLATE'
 42  				  , 'NO_DATA_TEMPLATE'
 43  				  , 'SESSION_ID_TEMPLATE'
 44  				  , 'SET_TEMPLATE'
 45  				  , 'GROUP_TEMPLATE'
 46  				  , 'TEST_NAME_TEMPLATE'
 47  				  , 'RESULT_LINE_TEMPLATE'
 48  				  , 'COUNT_DESC_TEMPLATE'
 49  				  , 'REPORT_TOTAL_TEMPLATE'
 50  				  , 'FN_HAS_TABLE_TEMPLATE'
 51  				  , 'FN_HAS_COLUMN_TEMPLATE'
 52  				  , 'FN_HAS_PACKAGE_TEMPLATE'
 53  				  , 'FN_HAS_PROCEDURE_TEMPLATE'
 54  				  , 'FN_HAS_TRIGGER_TEMPLATE'
 55  				  )
 56    THEN
 57  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 58    END IF;
 59    -- remove any leading and trailing blanks from config_value
 60    :NEW.config_value   := TRIM(:NEW.config_value);
 61    -- check empty strings contained only spaces
 62    IF :NEW.config_value IS NULL OR LENGTH(:NEW.config_value) = 0
 63    THEN
 64  	 RAISE_APPLICATION_ERROR(-20002, 'The given config_value is not supported. Empty or only spaces.');
 65    END IF;
 66    :NEW.created	   := SYSDATE;
 67    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 68    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 69    -- check max length if defined
 70    IF :NEW.config_type = 'CHAR'
 71    THEN
 72  	 IF :NEW.config_max_length > 0
 73  	 THEN
 74  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 75  	   THEN
 76  	     RAISE_APPLICATION_ERROR(-20003, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 77  	   END IF;
 78  	 END IF;
 79    END IF;
 80    -- check number type
 81    IF :NEW.config_type = 'NUMBER'
 82    THEN
 83  	 l_ok := TRUE;
 84  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 85  	 BEGIN
 86  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 87  	 EXCEPTION
 88  	   WHEN OTHERS THEN
 89  	     l_ok := FALSE;
 90  	 END;
 91  	 IF NOT l_ok
 92  	 THEN
 93  	   RAISE_APPLICATION_ERROR(-20004, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 94  	 END IF;
 95    END IF;
 96    -- handle NULLs
 97    IF :NEW.config_name = 'PRESERVE_DAYS'
 98    THEN
 99  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_PRESERVE_DAYS));
100    END IF;
101    IF :NEW.config_name = 'DELETE_DELAY'
102    THEN
103  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DELETE_DELAY));
104    END IF;
105    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
106    THEN
107  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DELETE_BATCH_SIZE));
108    END IF;
109    IF :NEW.config_name = 'DEBUG_MODE'
110    THEN
111  	 :NEW.config_value := NVL(:NEW.config_value, TO_CHAR(otap_constants.OTAP_DEBUG_MODE));
112    END IF;
113    -- check layout options
114    IF     :NEW.config_name = 'DEFAULT_LAYOUT'
115  	  AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
116    THEN
117  	 :NEW.config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
118    END IF;
119    IF     :NEW.config_name = 'DEFAULT_RESULT_LAYOUT'
120  	  AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
121    THEN
122  	 :NEW.config_value := otap_constants.OTAP_LAYOUT_LEFT;
123    END IF;
124    -- check border options
125    IF     :NEW.config_name = 'DEFAULT_BORDER'
126  	  AND (   TO_NUMBER(:NEW.config_value) < 2
127  	       OR TO_NUMBER(:NEW.config_value) > 10
128  	      )
129    THEN
130  	 :NEW.config_value := otap_constants.OTAP_BORDER_DEFAULT;
131    END IF;
132  END;
133  /

