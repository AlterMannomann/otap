SQL> CREATE OR REPLACE PACKAGE BODY otap_logic
  2  AS
  3    -- for description see header file
  4    FUNCTION ok( p_boolean	      IN	    BOOLEAN
  5  		  , o_errors		 OUT NOCOPY VARCHAR2
  6  		  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
  7  		  )
  8  	 RETURN INTEGER
  9    IS
 10  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.ok';
 11  	 l_test_passed	 INTEGER;
 12  	 l_expected	 INTEGER;
 13  	 l_errors	 VARCHAR2(32767 CHAR);
 14    BEGIN
 15  	 l_errors      := NULL;
 16  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 17  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
 18  	 IF p_boolean IS NOT NULL
 19  	 THEN
 20  	   l_test_passed := CASE WHEN p_boolean THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
 21  	 ELSE
 22  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 23  	   -- NULL is not a valid boolean
 24  	   l_errors := 'Not allowed: p_boolean(NULL)';
 25  	   otap_log.log(l_errors, l_script);
 26  	 END IF;
 27  	 -- now decide on the expected result the final state and if errors are returned
 28  	 IF l_test_passed != l_expected
 29  	 THEN
 30  	   o_errors := otap_string.reduce(l_errors, 4000);
 31  	 ELSE
 32  	   -- overwrite states from before, as we fulfill expected
 33  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
 34  	   -- overwrite errors expected
 35  	   o_errors := NULL;
 36  	 END IF;
 37  	 RETURN l_test_passed;
 38    EXCEPTION
 39  	 WHEN OTHERS THEN
 40  	   IF SQLCODE != -20099
 41  	   THEN
 42  	     -- log unhandled exceptions
 43  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 44  	   END IF;
 45  	   RAISE;
 46    END ok;
