SQL> CREATE OR REPLACE PACKAGE otap_objects
  2  AS
  3    /**
  4    * This package provides utility functions and procedures to handle OTAP_SESSION object.
  5    * Member functions do not work as expected and are far too limited.
  6    * This is no standalone package, it requires to be called by OTAP_TEST and other packages
  7    * which have a session_record from OTAP_TEST available.
  8    *
  9    * All procedures and functions verify the OTAP_SESSION object. No NULL allowed for any field.
 10    * They will throw the exception "-20099 Invalid OTAP_SESSION object" if the object is not valid.
 11    */
 12  
 13    /** PROCEDURE otap_objects.otap_session_verify
 14    * Verifies the OTAP_SESSION object and checks for NULL or 0 string length, no NULL values allowed.
 15    *
 16    * @param p_otap_session The OTAP_SESSION object to verify.
 17    *
 18    * @exception -20099 Internal error, invalid OTAP_SESSION object.
 19    */
 20    PROCEDURE otap_session_verify(p_otap_session IN OTAP_SESSION);
 21  
 22    /** FUNCTION otap_objects.otap_session_show
 23    * Return the current package variables of OTAP_TEST as LF delimited text.
 24    *
 25    * @param p_otap_session The otap_session object from package OTAP_TEST.
 26    *
 27    * @return A text message, LF delimited, listing current settings of OTAP_SESSION object.
 28    *
 29    * @exception -20099 Internal error, invalid OTAP_SESSION object.
 30    */
 31    FUNCTION otap_session_show(p_otap_session IN OTAP_SESSION)
 32  	 RETURN VARCHAR2
 33    ;
 34  
 35    /** FUNCTION otap_objects.otap_session_set
 36    * Sets the package session variables of a valid OTAP_SESSION object. Errors will get logged.
 37    *
 38    * @param p_test_count The amount of tests expected to be executed when called.
 39    * @param p_test_set The name of the test set applied if the name of the executed test procedure or function does not provide a test set name or name precendence is disabled.
 40    * @param p_test_group The name of the test group applied if the name of the executed test procedure or function does not provide a test group name or name precendence is disabled.
 41    * @param p_test_name The name of the test name applied if the name of the executed test procedure or function does not provide a test name or name precendence is disabled.
 42    * @param p_prefix The prefix to use for identifying test functions and procedures. Limited to 4 chars. Test functions and procedures must have a trailing delimiter _ after the prefix to be identified.
 43    * @param p_name_precedence Can disable the naming conventions for otap. If set to otap_constants.OTAP_NUM_FALSE, all tests will run under the defined test set and group, set by init_test.
 44    * @param p_include_pkg Can enable to search also packages and package procedures and functions that fit the naming convention with the given prefix, if set to otap_constants.OTAP_NUM_TRUE.
 45    * @param p_persist Can enable to persist the test results longer than the current default of PRESERVE_DAYS in OTAP_CONFIG, if set to otap_constants.OTAP_NUM_TRUE.
 46    * The following parameters are expected from OTAP_TEST package. Caller should not set this variables.
 47    * @param p_schema The current schema from caller environment as reported from otap_test.
 48    * @param p_user The current user from caller environment as reported from otap_test.
 49    * @param p_executor The session user from caller environment as reported from otap_test.
 50    * @param o_otap_session The OTAP_SESSION object to set.
 51    *
 52    * @return The current test session settings as text LF delimited.
 53    *
 54    * @exception -20099 ERROR otap_objects.otap_session_set. Invalid OTAP_SESSION initialization.
 55    */
 56    FUNCTION otap_session_set( p_test_count		IN	      NUMBER
 57  				, p_test_set		IN	      VARCHAR2
 58  				, p_test_group		IN	      VARCHAR2
 59  				, p_test_name		IN	      VARCHAR2
 60  				, p_prefix		IN	      VARCHAR2
 61  				, p_name_precedence	IN	      NUMBER
 62  				, p_include_pkg 	IN	      NUMBER
 63  				, p_persist		IN	      NUMBER
 64  				, p_schema		IN	      VARCHAR2
 65  				, p_user		IN	      VARCHAR2
 66  				, p_executor		IN	      VARCHAR2
 67  				, o_otap_session	IN OUT NOCOPY OTAP_SESSION
 68  				)
 69  	 RETURN VARCHAR2
 70    ;
 71  
 72    /** FUNCTION otap_objects.otap_session_copy
 73    * Create a copy of the OTAP_SESSION object.
 74    *
 75    * @param p_otap_session The otap_session object from package OTAP_TEST.
 76    *
 77    * @return A copy of the OTAP_SESSION object.
 78    *
 79    * @exception -20099 Internal error, invalid OTAP_SESSION object.
 80    */
 81    FUNCTION otap_session_copy(p_otap_session IN OTAP_SESSION)
 82  	 RETURN OTAP_SESSION
 83    ;
