SQL> CREATE OR REPLACE PACKAGE BODY otap_util
  2  AS
  3    -- for description see header file
  4    FUNCTION debug_active
  5  	 RETURN BOOLEAN
  6    IS
  7  	 l_debug_mode  VARCHAR2(1);
  8  	 l_return      BOOLEAN;
  9    BEGIN
 10  	 l_return := FALSE;
 11  	 SELECT config_value INTO l_debug_mode FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_DEBUG_MODE;
 12  	 IF l_debug_mode = '1'
 13  	 THEN
 14  	   l_return := TRUE;
 15  	 END IF;
 16  	 RETURN l_return;
 17    EXCEPTION
 18  	 WHEN OTHERS THEN
 19  	   RETURN FALSE;
 20    END debug_active;
 21  
 22    PROCEDURE log( p_log_message  IN VARCHAR2
 23  		    , p_script	     IN VARCHAR2 DEFAULT 'N/A'
 24  		    , p_statement    IN VARCHAR2 DEFAULT 'N/A'
 25  		    , p_identifier   IN VARCHAR2 DEFAULT 'OTAP_ERROR'
 26  		    )
 27    IS
 28  	 PRAGMA AUTONOMOUS_TRANSACTION;
 29  	 l_has_sperrorlog  NUMBER;
 30    BEGIN
 31  	 -- check which type of log
 32  	 IF    p_identifier = 'OTAP_ERROR'
 33  	    OR otap_util.debug_active
 34  	 THEN
 35  	   -- check if table exists
 36  	   SELECT COUNT(*) INTO l_has_sperrorlog FROM user_tables WHERE table_name = 'SPERRORLOG';
 37  	   IF l_has_sperrorlog = 1
 38  	   THEN
 39  	     INSERT INTO sperrorlog
 40  	       ( username
 41  	       , timestamp
 42  	       , script
 43  	       , identifier
 44  	       , message
 45  	       , statement
 46  	       )
 47  	       VALUES ( otap_constants.OTAP_SCHEMA
 48  		      , SYSTIMESTAMP
 49  		      , p_script
 50  		      , p_identifier
 51  		      , p_log_message
 52  		      , p_statement
 53  		      )
 54  	     ;
 55  	     COMMIT;
 56  	   ELSE
 57  	     -- give some output even if no one will notice it
 58  	     DBMS_OUTPUT.PUT_LINE('No logging possible, SPERRORLOG table does not exist');
 59  	   END IF;
 60  	 END IF;
 61    EXCEPTION
 62  	 WHEN OTHERS THEN
 63  	   -- explicitly do not care about log exceptions, application should fail otherwise
 64  	   -- logging is not critical for otap, only an option, usually not recommended to do
 65  	   -- it this way, give some output even if no one will notice it
 66  	   DBMS_OUTPUT.PUT_LINE(SQLERRM);
 67    END log;
 68  
 69    PROCEDURE set_debug(p_active IN BOOLEAN DEFAULT FALSE)
 70    IS
 71  	 PRAGMA AUTONOMOUS_TRANSACTION;
 72  	 l_debug_state VARCHAR2(1);
 73    BEGIN
 74  	 l_debug_state := CASE WHEN p_active THEN '1' ELSE '0' END;
 75  	 UPDATE otap_config
 76  	    SET config_value = l_debug_state
 77  	  WHERE config_name = otap_constants.OTAP_CFG_DEBUG_MODE
 78  	 ;
 79  	 COMMIT;
 80    EXCEPTION
 81  	 WHEN OTHERS THEN
 82  	   otap_util.log(SQLERRM, 'otap_util.set_debug', 'UPDATE otap_config DEBUG_MODE');
 83    END set_debug;
 84  
 85    FUNCTION preserve_days
 86  	 RETURN NUMBER
 87    IS
 88  	 l_return NUMBER;
 89    BEGIN
 90  	 l_return := 1;
 91  	 SELECT TO_NUMBER(config_value) INTO l_return FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_PRESERVE_DAYS;
 92  	 RETURN l_return;
 93    EXCEPTION
 94  	 WHEN OTHERS THEN
 95  	   otap_util.log(SQLERRM, 'otap_util.preserve_days', 'SELECT otap_config PRESERVE_DAYS');
 96  	   RETURN 1;
 97    END preserve_days;
 98  
 99    PROCEDURE set_preserve_days(p_preserve_days IN NUMBER DEFAULT 1)
100    IS
101  	 PRAGMA AUTONOMOUS_TRANSACTION;
102  	 l_preserve_days VARCHAR2(1);
103    BEGIN
104  	 IF	 p_preserve_days >= 1
105  	    AND  p_preserve_days <= 7
106  	 THEN
107  	   l_preserve_days := TRIM(TO_CHAR(p_preserve_days));
108  	   UPDATE otap_config
109  	     SET config_value = l_preserve_days
110  	   WHERE config_name = otap_constants.OTAP_CFG_PRESERVE_DAYS
111  	   ;
112  	   COMMIT;
113  	 ELSE
114  	   otap_util.log('Wrong amount of preserve days ' || p_preserve_days || ' only 1 - 7 allowed. Nothing changed.', 'otap_util.set_preserve_days', 'UPDATE otap_config PRESERVE_DAYS');
115  	 END IF;
116    EXCEPTION
117  	 WHEN OTHERS THEN
118  	   otap_util.log(SQLERRM, 'otap_util.set_preserve_days', 'UPDATE otap_config PRESERVE_DAYS');
119    END set_preserve_days;
120  
121    FUNCTION delete_delay
122  	 RETURN NUMBER
123    IS
124  	 l_return NUMBER;
125    BEGIN
126  	 l_return := 10;
127  	 SELECT TO_NUMBER(config_value) INTO l_return FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_DELETE_DELAY;
128  	 RETURN l_return;
129    EXCEPTION
130  	 WHEN OTHERS THEN
131  	   otap_util.log(SQLERRM, 'otap_util.delete_delay', 'SELECT otap_config DELETE_DELAY');
132  	   RETURN 10;
133    END delete_delay;
134  
135    PROCEDURE set_delete_delay(p_delete_delay IN NUMBER DEFAULT 10)
136    IS
137  	 PRAGMA AUTONOMOUS_TRANSACTION;
138  	 l_delete_delay VARCHAR2(3);
139    BEGIN
140  	 IF	 p_delete_delay >= 1
141  	    AND  p_delete_delay <= 600
142  	 THEN
143  	   l_delete_delay := TRIM(TO_CHAR(p_delete_delay));
144  	   UPDATE otap_config
145  	     SET config_value = l_delete_delay
146  	   WHERE config_name = otap_constants.OTAP_CFG_DELETE_DELAY
147  	   ;
148  	   COMMIT;
149  	 ELSE
150  	   otap_util.log('Wrong amount of delete delay seconds ' || p_delete_delay || ' only 1 - 600 allowed. Nothing changed.', 'otap_util.set_delete_delay', 'UPDATE otap_config DELETE_DAY');
151  	 END IF;
152    EXCEPTION
153  	 WHEN OTHERS THEN
154  	   otap_util.log(SQLERRM, 'otap_util.set_delete_delay', 'UPDATE otap_config DELETE_DELAY');
155    END set_delete_delay;
156  
157    FUNCTION delete_batch_size
158  	 RETURN NUMBER
159    IS
160  	 l_return NUMBER;
161    BEGIN
162  	 l_return := 1000;
163  	 SELECT TO_NUMBER(config_value) INTO l_return FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_DELETE_BATCH_SIZE;
164  	 RETURN l_return;
165    EXCEPTION
166  	 WHEN OTHERS THEN
167  	   otap_util.log(SQLERRM, 'otap_util.delete_batch_size', 'SELECT otap_config DELETE_BATCH_SIZE');
168  	   RETURN 1000;
169    END delete_batch_size;
170  
171    PROCEDURE set_delete_batch_size(p_delete_batch_size IN NUMBER DEFAULT 1000)
172    IS
173  	 PRAGMA AUTONOMOUS_TRANSACTION;
174  	 l_delete_batch_size VARCHAR2(5);
175    BEGIN
176  	 IF	 p_delete_batch_size >= 100
177  	    AND  p_delete_batch_size <= 10000
178  	 THEN
179  	   l_delete_batch_size := TRIM(TO_CHAR(p_delete_batch_size));
180  	   UPDATE otap_config
181  	     SET config_value = l_delete_batch_size
182  	   WHERE config_name = otap_constants.OTAP_CFG_DELETE_BATCH_SIZE
183  	   ;
184  	   COMMIT;
185  	 ELSE
186  	   otap_util.log('Wrong amount of delete batch size ' || p_delete_batch_size || ' only 100 - 10000 allowed. Nothing changed.', 'otap_util.set_delete_batch_size', 'UPDATE otap_config DELETE_BATCH_SIZE');
187  	 END IF;
188    EXCEPTION
189  	 WHEN OTHERS THEN
190  	   otap_util.log(SQLERRM, 'otap_util.set_delete_batch_size', 'UPDATE otap_config DELETE_BATCH_SIZE');
191    END set_delete_batch_size;
192  
193    PROCEDURE result_cleanup
194    IS
195  	 PRAGMA AUTONOMOUS_TRANSACTION;
196  	 l_delete_before     DATE;
197  	 l_delete_start      DATE;
198  	 l_delete_batch_size NUMBER;
199  	 l_delete_delay      NUMBER;
200  	 l_row_counter	     NUMBER;
201  	 l_processed	     NUMBER;
202  	 l_delete_msg	     VARCHAR2(32767);
203  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
204  	 IS
205  	   SELECT *
206  	     FROM otap_results
207  	    WHERE otap_test_date < cp_delete_before
208  	      AND to_delete	 = otap_constants.OTAP_NUM_TRUE
209  	 ;
210    BEGIN
211  	 -- read config values before starting, values will not change until finished
212  	 l_delete_start      := SYSDATE;
213  	 l_delete_before     := TRUNC(SYSDATE - otap_util.preserve_days);
214  	 l_delete_batch_size := otap_util.delete_batch_size;
215  	 l_delete_delay      := otap_util.delete_delay;
216  	 l_row_counter	     := 0;
217  	 l_processed	     := 0;
218  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
219  	 otap_util.log(l_delete_msg, 'otap_util.result_cleanup', 'Procedure start', 'OTAP_DEBUG');
220  	 FOR rec IN cur_delete_tests(l_delete_before)
221  	 LOOP
222  	   IF l_row_counter >= l_delete_batch_size
223  	   THEN
224  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
225  	     otap_util.log(l_delete_msg, 'otap_util.result_cleanup', 'Batch size reached and wait', 'OTAP_DEBUG');
226  	     -- commit the batch
227  	     COMMIT;
228  	     -- reset counter
229  	     l_row_counter := 0;
230  	     -- wait defined time
231  	     DBMS_SESSION.SLEEP(l_delete_delay);
232  	   END IF;
233  	   DELETE FROM otap_results WHERE otap_testrun_id = rec.otap_testrun_id AND otap_test_date = rec.otap_test_date;
234  	   l_row_counter := l_row_counter + 1;
235  	   l_processed	 := l_processed + 1;
236  	 END LOOP;
237  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
238  	 otap_util.log(l_delete_msg, 'otap_util.result_cleanup', 'Procedure end', 'OTAP_DEBUG');
239  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
240    EXCEPTION
241  	 WHEN OTHERS THEN
242  	   otap_util.log(SQLERRM, 'otap_util.result_cleanup', 'DELETE FROM otap_results');
243    END result_cleanup;
244  
245  END;
246  /

