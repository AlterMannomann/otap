SQL> @@../otap_ddl/views/otap_identifiers_v.sql
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> -- Internal view for all otap identifiers that provides translations available from OTAP_TRANSLATE.
SQL> CREATE OR REPLACE VIEW otap_identifiers_v
  2  AS
  3  	 WITH lbl AS
  4  	      (SELECT config_name		       AS otap_identifier
  5  		      -- leave configuration unchanged
  6  		    , config_value		       AS label_text_lower
  7  		    , config_value		       AS label_text_cap
  8  		    , config_value		       AS label_text_upper
  9  		    , config_value		       AS label_source
 10  		    , config_type		       AS label_type
 11  		    , translatable		       AS label_translatable
 12  		    , otap_constants.get_otap_num_true AS from_config
 13  		 FROM otap_config
 14  		UNION ALL
 15  	       SELECT otap_identifier
 16  		    , otap_label_lower			       AS label_text_lower
 17  		    , otap_label_cap			       AS label_text_cap
 18  		    , otap_label_upper			       AS label_text_upper
 19  		    , otap_label_source 		       AS label_source
 20  		    , otap_constants.get_otap_config_type_char AS label_type
 21  		    , otap_constants.get_otap_num_true	       AS label_translatable
 22  		    , otap_constants.get_otap_num_false        AS from_config
 23  		 FROM otap_labels_mv
 24  	      )
 25    SELECT lbl.otap_identifier
 26  	      -- leave translations unchanged
 27  	    , NVL(otr.label_text, lbl.label_text_lower) AS label_text_lower
 28  	    , NVL(otr.label_text, lbl.label_text_cap)	AS label_text_cap
 29  	    , NVL(otr.label_text, lbl.label_text_upper) AS label_text_upper
 30  	    , label_source
 31  	    , label_type
 32  	    , label_translatable
 33  	    , from_config
 34  	 FROM lbl
 35  	 LEFT OUTER JOIN otap_translate otr
 36  	   ON lbl.otap_identifier = otr.otap_identifier
 37  	  AND otr.language_id	  = otap_constants.get_otap_internal_na
 38  ;

