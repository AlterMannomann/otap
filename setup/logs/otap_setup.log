210    FUNCTION otap_session_set( p_test_count		IN	      NUMBER
211  				, p_test_set		IN	      VARCHAR2
212  				, p_test_group		IN	      VARCHAR2
213  				, p_test_name		IN	      VARCHAR2
214  				, p_prefix		IN	      VARCHAR2
215  				, p_language_id 	IN	      VARCHAR2
216  				, p_name_precedence	IN	      NUMBER
217  				, p_include_pkg 	IN	      NUMBER
218  				, p_persist		IN	      NUMBER
219  				, p_schema		IN	      VARCHAR2
220  				, p_user		IN	      VARCHAR2
221  				, p_executor		IN	      VARCHAR2
222  				, o_otap_session	IN OUT NOCOPY OTAP_SESSION
223  				)
224  	 RETURN VARCHAR2
225    IS
226  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_set';
227  	 l_message   VARCHAR2(32767 CHAR);
228  	 l_delimiter VARCHAR2(1 CHAR);
229    BEGIN
230  	 -- verify the current object
231  	 otap_objects.otap_session_verify(o_otap_session);
232  	 -- now verify the input
233  	 IF    p_schema    IS NULL
234  	    OR p_user	   IS NULL
235  	    OR p_executor  IS NULL
236  	 THEN
237  	   l_message := 'ERROR otap_objects.otap_session_set. Invalid OTAP_SESSION initialization. NULL errors: ';
238  	   l_delimiter := '';
239  	   IF p_schema IS NULL
240  	   THEN
241  	     l_message := l_message || l_delimiter || 'p_schema';
242  	     l_delimiter := ',';
243  	   END IF;
244  	   IF p_user IS NULL
245  	   THEN
246  	     l_message := l_message || l_delimiter || 'p_user';
247  	     l_delimiter := ',';
248  	   END IF;
249  	   IF p_executor IS NULL
250  	   THEN
251  	     l_message := l_message || l_delimiter || 'p_executor';
252  	   END IF;
253  	   l_message := l_message || ' The variable default should never be overwritten by users.';
254  	   otap_log.log('EXCEPTION -20099 ' || l_message, l_script, 'p_schema IS NULL OR p_user IS NULL OR p_executor IS NULL');
255  	   RAISE_APPLICATION_ERROR(-20099, l_message);
256  	 END IF;
257  	 -- check prefix length
258  	 IF    LENGTH(p_prefix) <= 4
259  	    OR LENGTH(p_prefix) > 0
260  	 THEN
261  	   -- no delimiter allowed
262  	   IF REGEXP_INSTR(p_prefix, '[_|$|#]') = 0
263  	   THEN
264  	     o_otap_session.test_prefix := UPPER(TRIM(p_prefix));
265  	   ELSE
266  	     o_otap_session.test_prefix := otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX;
267  	     otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' delimiters _, $, # not allowed', l_script, 'REGEXP_INSTR(p_prefix, ''[_|$|#]'') = 0');
268  	   END IF;
269  	 ELSE
270  	   -- leave prefix as defined, log error
271  	   o_otap_session.test_prefix := otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX;
272  	   otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' length, only length 1-4 allowed', l_script, 'LENGTH(p_prefix) <= 4 OR LENGTH(p_prefix) > 0');
273  	 END IF;
274  	 -- check bool values
275  	 IF NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
276  	 THEN
277  	   o_otap_session.name_precedence := (NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) = otap_constants.OTAP_NUM_TRUE);
278  	 END IF;
279  	 IF NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
280  	 THEN
281  	   o_otap_session.include_packages := (NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
282  	 END IF;
283  	 IF NVL(p_persist, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
284  	 THEN
285  	   o_otap_session.persist_test := (NVL(p_persist, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
286  	 END IF;
287  	 -- check language, must be a 3 char code
288  	 IF LENGTH(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA)) > 3
289  	 THEN
290  	   o_otap_session.session_language := otap_constants.OTAP_INTERNAL_NA;
291  	 ELSE
292  	   o_otap_session.session_language := UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA));
293  	 END IF;
294  	 -- now start setting the new values
295  	 o_otap_session.test_executor	:= p_executor;
296  	 o_otap_session.db_user 	:= p_user;
297  	 o_otap_session.db_schema	:= p_schema;
298  	 o_otap_session.intended_count	:= NVL(p_test_count, 0);
299  	 -- keep old values if not specified
300  	 o_otap_session.test_set	:= NVL(p_test_set, o_otap_session.test_set);
301  	 o_otap_session.test_group	:= NVL(p_test_group, o_otap_session.test_group);
302  	 o_otap_session.test_name	:= NVL(p_test_name, o_otap_session.test_name);
303  	 -- reset other session values
304  	 o_otap_session.test_count	:= 0;
305  	 o_otap_session.error_count	:= 0;
