712    /** FUNCTION otap_test.is_eq
713    * Checks given data of type VARCHAR2, NUMBER and DATE against a given value. As "IS" is a reserved word in Oracle
714    * this is the equivalent of is and isnt. isnt is achieved by setting expected result to otap_constants.OTAP_NUM_TEST_FAILED.
715    *
716    * Other types are more or less problematic, e.g. you can't declare in Oracle a function with date and timestamp parameter. If providing
717    * TIMESTAMP Oracle gets confused which function to use. Try to convert or cast the types to the base types. CAST will probably not
718    * preserve all information. TO_CHAR is almost always an option.
719    *
720    * Passing simply NULL, NULL without that datatypes are defined by columns, the function will fail with ORA-06553: Too much declarations
721    * of is_eq. To do a NULL test, use, according to p_have datatype, TO_CHAR(NULL), TO_NUMBER(NULL) or TO_DATE(NULL) so correct function
722    * signature is identified and function does not fail.
723    *
724    * @param p_have The data to check.
725    * @param p_want The expected data. Must have the same datatype as p_have.
726    * @param p_description The test description if any. If not given, a description is generated, see template.
727    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
728    * @param p_schema A schema override of the current test session if needed, taken as is. Compares are not clearly associated to a schema. Case sensitive.
729    *
730    * @return The test result as text.
731    */
732    FUNCTION is_eq( p_have		 IN VARCHAR2
733  		     , p_want		 IN VARCHAR2
734  		     , p_description	 IN VARCHAR2 DEFAULT NULL
735  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
736  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
737  		     )
738  	 RETURN VARCHAR2
739    ;
740    FUNCTION is_eq( p_have		 IN NUMBER
741  		     , p_want		 IN NUMBER
742  		     , p_description	 IN VARCHAR2 DEFAULT NULL
743  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
744  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
745  		     )
746  	 RETURN VARCHAR2
747    ;
748    FUNCTION is_eq( p_have		 IN DATE
749  		     , p_want		 IN DATE
750  		     , p_description	 IN VARCHAR2 DEFAULT NULL
