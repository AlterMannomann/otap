280    FUNCTION test_result_to_text(p_test_passed IN NUMBER)
281  	 RETURN VARCHAR
282    IS
283  	 l_translation otap_config.config_value%TYPE;
284    BEGIN
285  	 l_translation := CASE p_test_passed
286  			    WHEN otap_constants.OTAP_NUM_TEST_PASSED
287  			    THEN otap_config_util.get_text_test_passed
288  			    WHEN otap_constants.OTAP_NUM_TEST_FAILED
289  			    THEN otap_config_util.get_text_test_failed
290  			    WHEN otap_constants.OTAP_NUM_TEST_UNDEFINED
291  			    THEN otap_config_util.get_text_test_undefined
292  			    ELSE otap_constants.OTAP_ERROR_IDENTIFIER
293  			  END
294  	 ;
295  	 RETURN l_translation;
296    EXCEPTION
297  	 WHEN OTHERS THEN
298  	   otap_log.log(SQLERRM, 'otap_config_util.test_result_to_text', 'Translate test state to text');
299  	   RAISE;
300    END test_result_to_text;
