509    FUNCTION build_msg( p_cfg_template  IN VARCHAR2
510  			 , p_type_label    IN VARCHAR2 DEFAULT NULL
511  			 , p_param1	   IN VARCHAR2 DEFAULT NULL
512  			 , p_param1_value  IN VARCHAR2 DEFAULT NULL
513  			 , p_param2	   IN VARCHAR2 DEFAULT NULL
514  			 , p_param2_value  IN VARCHAR2 DEFAULT NULL
515  			 , p_param3	   IN VARCHAR2 DEFAULT NULL
516  			 , p_param3_value  IN VARCHAR2 DEFAULT NULL
517  			 , p_param4	   IN VARCHAR2 DEFAULT NULL
518  			 , p_param4_value  IN VARCHAR2 DEFAULT NULL
519  			 , p_param5	   IN VARCHAR2 DEFAULT NULL
520  			 , p_param5_value  IN VARCHAR2 DEFAULT NULL
521  			 , p_description   IN VARCHAR2 DEFAULT NULL
522  			 )
523  	 RETURN VARCHAR2
524    IS
525  	 l_script	 VARCHAR2(256 CHAR) := 'otap_util.build_msg';
526  	 l_text_result	 VARCHAR2(4000 CHAR);
527  	 l_label	 VARCHAR2(256 CHAR);
528  	 l_var_count	 INTEGER;
529    BEGIN
530  	 IF p_description IS NOT NULL
531  	 THEN
532  	   l_text_result := otap_string.reduce(p_description, 4000);
533  	 ELSE
534  	   IF p_cfg_template IS NULL
535  	   THEN
536  	     l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' missing description and template identifier';
537  	     otap_log.log(l_text_result, l_script);
538  	   ELSE
539  	     l_text_result := otap_util.get_config_value(p_cfg_template);
540  	     IF l_text_result = otap_constants.OTAP_INTERNAL_ERROR
541  	     THEN
542  	       l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' invalid template identifier ' || p_cfg_template;
543  	       otap_log.log(l_text_result, l_script);
544  	     ELSE
545  	       -- check variables, only modify if present, otherwise text is delivered as is
546  	       l_var_count := REGEXP_COUNT(l_text_result, '@');
547  	       -- check also that @@ comes in pairs like valid variables
548  	       IF l_var_count != 0 AND MOD(l_var_count, 2) = 0
549  	       THEN
550  		 -- check type present
551  		 IF	p_type_label					  IS NOT NULL
552  		    AND INSTR(l_text_result, otap_constants.OTAP_TYPE_VAR) > 0
553  		 THEN
554  		   l_label := otap_util.get_config_value(p_type_label);
555  		   -- do nothing on errors
556  		   IF l_label != otap_constants.OTAP_INTERNAL_ERROR
557  		   THEN
558  		     -- replace if exists in template
559  		     l_text_result := REPLACE(l_text_result, otap_constants.OTAP_TYPE_VAR, l_label);
560  		   ELSE
561  		     otap_log.log('Type ignored, Invalid label used: ' || p_type_label, l_script);
562  		   END IF;
563  		 END IF;
564  		 -- check vars and replace if condition met
565  		 IF p_param1_value IS NOT NULL
566  		 THEN
567  		   IF	  p_param1		     IS NOT NULL
568  		      AND REGEXP_COUNT(p_param1, '@') = 2
569  		   THEN
570  		     -- replace, may work, may not
571  		     l_text_result := REPLACE(l_text_result, p_param1, p_param1_value);
572  		   ELSE
573  		     -- ignore, log error
574  		     otap_log.log('Value without variable name: ' || p_param1_value || ' or invalid parameter: ' || p_param1, l_script);
575  		   END IF;
576  		 END IF;
577  		 IF p_param2_value IS NOT NULL
578  		 THEN
579  		   IF	  p_param2		     IS NOT NULL
580  		      AND REGEXP_COUNT(p_param2, '@') = 2
581  		   THEN
582  		     -- replace, may work, may not
583  		     l_text_result := REPLACE(l_text_result, p_param2, p_param2_value);
584  		   ELSE
585  		     -- ignore, log error
586  		     otap_log.log('Value without variable name: ' || p_param2_value || ' or invalid parameter: ' || p_param2, l_script);
587  		   END IF;
588  		 END IF;
589  		 IF p_param3_value IS NOT NULL
590  		 THEN
591  		   IF	  p_param3		     IS NOT NULL
592  		      AND REGEXP_COUNT(p_param3, '@') = 2
593  		   THEN
594  		     -- replace, may work, may not
595  		     l_text_result := REPLACE(l_text_result, p_param3, p_param3_value);
596  		   ELSE
597  		     -- ignore, log error
598  		     otap_log.log('Value without variable name: ' || p_param3_value || ' or invalid parameter: ' || p_param3, l_script);
599  		   END IF;
600  		 END IF;
601  		 IF p_param4_value IS NOT NULL
602  		 THEN
603  		   IF	  p_param4		     IS NOT NULL
604  		      AND REGEXP_COUNT(p_param4, '@') = 2
605  		   THEN
606  		     -- replace, may work, may not
607  		     l_text_result := REPLACE(l_text_result, p_param4, p_param4_value);
608  		   ELSE
609  		     -- ignore, log error
610  		     otap_log.log('Value without variable name: ' || p_param4_value || ' or invalid parameter: ' || p_param4, l_script);
611  		   END IF;
612  		 END IF;
613  		 IF p_param5_value IS NOT NULL
614  		 THEN
615  		   IF	  p_param5		     IS NOT NULL
616  		      AND REGEXP_COUNT(p_param5, '@') = 2
617  		   THEN
618  		     -- replace, may work, may not
619  		     l_text_result := REPLACE(l_text_result, p_param5, p_param5_value);
620  		   ELSE
621  		     -- ignore, log error
622  		     otap_log.log('Value without variable name: ' || p_param5_value || ' or invalid parameter: ' || p_param5, l_script);
623  		   END IF;
624  		 END IF;
625  	       END IF;
626  	     END IF;
627  	   END IF;
628  	 END IF;
629  	 RETURN l_text_result;
630    EXCEPTION
631  	 WHEN OTHERS THEN
632  	   otap_log.log(SQLERRM, l_script, 'Prepare message from template');
633  	   RAISE;
634  	 RETURN l_text_result;
635    END build_msg;
