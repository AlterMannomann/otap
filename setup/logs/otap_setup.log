693    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
694  				  , p_test_passed	IN NUMBER
695  				  , p_test_session_id	IN NUMBER
696  				  , p_test_executor	IN VARCHAR2
697  				  , p_test_set		IN VARCHAR2
698  				  , p_db_user		IN VARCHAR2
699  				  , p_db_schema 	IN VARCHAR2
700  				  , p_test_group	IN VARCHAR2
701  				  , p_test_start	IN TIMESTAMP
702  				  , p_test_end		IN TIMESTAMP
703  				  , p_test_name 	IN VARCHAR2
704  				  , p_test_desc 	IN VARCHAR2
705  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
706  				  )
707    IS
708  	 PRAGMA AUTONOMOUS_TRANSACTION;
709  	 l_script      VARCHAR2(256 CHAR) := 'otap_util.write_test_result';
710  	 l_to_delete   NUMBER;
711  	 l_test_passed NUMBER;
712  	 l_errors      otap_results.test_errors%TYPE;
713    BEGIN
714  	 l_to_delete   := CASE
715  			    WHEN p_to_delete IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
716  			    THEN p_to_delete
717  			    ELSE otap_constants.OTAP_NUM_TRUE
718  			  END
719  	 ;
720  	 -- this is an error and must be handled
721  	 IF p_test_passed NOT IN (otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
722  	 THEN
723  	   l_errors := otap_string.reduce('Invalid test result: ' || p_test_passed || ' ' || p_test_errors, 4000);
724  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
725  	 ELSE
726  	   l_test_passed := p_test_passed;
727  	   l_errors := p_test_errors;
728  	 END IF;
729  	 INSERT INTO otap_results
730  	   ( to_delete
731  	   , test_passed
732  	   , test_session_id
733  	   , test_executor
734  	   , test_set
735  	   , db_user
736  	   , db_schema
737  	   , test_group
738  	   , test_start
739  	   , test_end
740  	   , test_name
741  	   , test_desc
742  	   , test_errors
743  	   ) VALUES ( l_to_delete
744  		    , l_test_passed
745  		    , p_test_session_id
746  		    , p_test_executor
747  		    , p_test_set
748  		    , p_db_user
749  		    , p_db_schema
750  		    , p_test_group
751  		    , p_test_start
752  		    , p_test_end
753  		    , p_test_name
754  		    , p_test_desc
755  		    , l_errors
756  		    )
757  	 ;
758  	 COMMIT;
759    EXCEPTION
760  	 WHEN OTHERS THEN
761  	   otap_log.log(SQLERRM, l_script, 'INSERT into otap_results');
762  	   ROLLBACK;
763  	   RAISE;
764    END write_test_result;
765  
766    PROCEDURE result_cleanup
767    IS
768  	 PRAGMA AUTONOMOUS_TRANSACTION;
769  	 l_script	     VARCHAR2(256 CHAR) := 'otap_util.result_cleanup';
770  	 l_delete_before     DATE;
771  	 l_delete_start      DATE;
772  	 l_delete_batch_size NUMBER;
773  	 l_delete_delay      NUMBER;
774  	 l_row_counter	     NUMBER;
775  	 l_processed	     NUMBER;
776  	 l_delete_msg	     VARCHAR2(32767 CHAR);
777  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
778  	 IS
779  	   SELECT *
780  	     FROM otap_results
781  	    WHERE test_run_date < cp_delete_before
782  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
783  	 ;
784    BEGIN
785  	 -- read config values before starting, values will not change until finished
786  	 l_delete_start      := SYSDATE;
787  	 l_delete_before     := TRUNC(SYSDATE - otap_util.get_config_number(otap_util.CFG_PRESERVE_DAYS));
788  	 l_delete_batch_size := otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE);
789  	 l_delete_delay      := otap_util.get_config_number(otap_util.CFG_DELETE_DELAY);
790  	 l_row_counter	     := 0;
791  	 l_processed	     := 0;
792  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
793  	 otap_log.log(l_delete_msg, l_script, 'Procedure start', 'OTAP_DEBUG');
794  	 FOR rec IN cur_delete_tests(l_delete_before)
795  	 LOOP
796  	   IF l_row_counter >= l_delete_batch_size
797  	   THEN
798  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
799  	     otap_log.log(l_delete_msg, l_script, 'Batch size reached and wait', 'OTAP_DEBUG');
800  	     -- commit the batch
801  	     COMMIT;
802  	     -- reset counter
803  	     l_row_counter := 0;
804  	     -- wait defined time
805  	     DBMS_SESSION.SLEEP(l_delete_delay);
806  	   END IF;
807  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
808  	   l_row_counter := l_row_counter + 1;
809  	   l_processed	 := l_processed + 1;
810  	 END LOOP;
811  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
812  	 otap_log.log(l_delete_msg, l_script, 'Procedure end', 'OTAP_DEBUG');
813  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
814    EXCEPTION
815  	 WHEN OTHERS THEN
816  	   otap_log.log(SQLERRM, l_script, 'DELETE FROM otap_results');
817    END result_cleanup;
818  
819    FUNCTION max_text_size(p_session_id IN NUMBER)
820  	 RETURN NUMBER
821    IS
822  	 l_result NUMBER;
823    BEGIN
824  	 -- use UNION not GREATEST to get a result in any case
825  	 SELECT MAX(str_length) AS max_length
826  	   INTO l_result
827  	   FROM (SELECT otap_constants.get_otap_num_min_fill_length AS str_length FROM dual
828  		  UNION ALL
829  		 SELECT MAX(LENGTH(test_set)) FROM otap_results WHERE test_session_id = p_session_id
830  		  UNION ALL
831  		 SELECT MAX(LENGTH(test_group)) FROM otap_results WHERE test_session_id = p_session_id
832  		  UNION ALL
833  		 SELECT MAX(LENGTH(test_name)) FROM otap_results WHERE test_session_id = p_session_id
834  		  UNION ALL
835  		 SELECT MAX(LENGTH(test_desc)) FROM otap_results WHERE test_session_id = p_session_id
836  		)
837  	 ;
838  	 RETURN l_result;
839    EXCEPTION
840  	 WHEN OTHERS THEN
841  	   otap_log.log(SQLERRM, 'otap_util.max_text_size', 'Get max text size for a given session id');
842  	   RAISE;
843    END max_text_size;
844  
845  END;
846  /

