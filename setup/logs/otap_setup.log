SQL> CREATE OR REPLACE PACKAGE BODY otap_report
  2  AS
  3  
  4    -- for description see header file
  5    FUNCTION decorate( p_string     IN VARCHAR2
  6  			, p_min_fill   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
  7  			, p_decoration IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
  8  			)
  9  	 RETURN VARCHAR2
 10    IS
 11  	 l_border	    INTEGER;
 12  	 l_layout	    VARCHAR2(1 CHAR);
 13  	 l_decoration	    VARCHAR2(1 CHAR);
 14  	 l_string_size	    INTEGER;
 15  	 l_max_title_length INTEGER;
 16  	 l_min_fill	    INTEGER;
 17  	 l_min_length	    INTEGER;
 18  	 l_string	    VARCHAR2(32767 CHAR);
 19  	 l_return_text	    VARCHAR2(32767 CHAR);
 20    BEGIN
 21  	 l_border	    := otap_util.get_config_value(otap_util.CFG_DEFAULT_BORDER);
 22  	 l_layout	    := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT));
 23  	 l_decoration	    := otap_string.check_decoration(p_decoration);
 24  	 l_string_size	    := otap_string.check_string_size(NVL(LENGTH(p_string), 0));
 25  	 l_string	    := otap_string.reduce(p_string, l_string_size);
 26  	 l_max_title_length := otap_string.check_title_size(l_string_size, l_border);
 27  	 l_min_fill	    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_max_title_length);
 28  	 l_min_length	    := otap_string.line_size(l_max_title_length, l_border);
 29  	 l_return_text	    := otap_string.decorate(l_string, l_decoration, l_min_length, l_layout, l_border);
 30  	 RETURN l_return_text;
 31    EXCEPTION
 32  	 WHEN OTHERS THEN
 33  	   otap_log.log(SQLERRM, 'otap_report.decorate', 'Create decorated report line');
 34  	   RAISE;
 35    END decorate;
 36  
 37    FUNCTION borderless( p_string	 IN VARCHAR2
 38  			  , p_min_fill	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
 39  			  )
 40  	 RETURN VARCHAR2
 41    IS
 42  	 l_border      INTEGER;
 43  	 l_layout      VARCHAR2(1 CHAR);
 44  	 l_string_size INTEGER;
 45  	 l_min_fill    INTEGER;
 46  	 l_min_length  INTEGER;
 47  	 l_string      VARCHAR2(32767 CHAR);
 48  	 l_return_text VARCHAR2(32767 CHAR);
 49    BEGIN
 50  	 l_border      := otap_util.get_config_value(otap_util.CFG_DEFAULT_BORDER);
 51  	 l_layout      := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT));
 52  	 l_string_size := otap_string.check_string_size(NVL(LENGTH(p_string), 0));
 53  	 l_string      := otap_string.reduce(p_string, l_string_size);
 54  	 l_min_fill    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_string_size);
 55  	 l_min_length  := otap_string.line_size(l_string_size, l_border);
 56  	 l_return_text := otap_string.borderless(l_string, l_min_length, l_layout);
 57  	 RETURN l_return_text;
 58    EXCEPTION
 59  	 WHEN OTHERS THEN
 60  	   otap_log.log(SQLERRM, 'otap_report.borderless', 'Create borderless report line');
 61  	   RAISE;
 62    END borderless;
 63  
 64    FUNCTION get_report_header(p_min_fill IN INTEGER DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH)
 65  	 RETURN VARCHAR2
 66    IS
 67  	 l_return_text VARCHAR2(32767 CHAR);
 68    BEGIN
 69  	 l_return_text := otap_report.decorate( otap_util.get_config_value(otap_util.CFG_TEXT_REPORT_START)
 70  					      , GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), otap_util.get_length_headers)
 71  					      , otap_util.get_config_value(otap_util.CFG_FORMAT_HEADER_CHAR)
 72  					      )
 73  	 ;
 74  	 RETURN l_return_text;
 75    EXCEPTION
 76  	 WHEN OTHERS THEN
 77  	   otap_log.log(SQLERRM, 'otap_report.get_report_header', 'Create report header');
 78  	   RAISE;
 79    END get_report_header;
 80  
 81    FUNCTION get_report_total(p_min_fill IN INTEGER	DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH)
 82  	 RETURN VARCHAR2
 83    IS
 84  	 l_return_text VARCHAR2(32767 CHAR);
 85    BEGIN
 86  	 l_return_text := otap_report.decorate( otap_util.get_config_value(otap_util.CFG_TEXT_REPORT_TOTAL)
 87  					      , GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), otap_util.get_length_headers)
 88  					      , otap_util.get_config_value(otap_util.CFG_FORMAT_HEADER_CHAR)
 89  					      )
 90  	 ;
 91  	 RETURN l_return_text;
 92    EXCEPTION
 93  	 WHEN OTHERS THEN
 94  	   otap_log.log(SQLERRM, 'otap_report.get_report_total', 'Create report totals header');
 95  	   RAISE;
 96    END get_report_total;
 97  
 98    FUNCTION get_report_total_details( p_sets	 IN INTEGER  DEFAULT 0
 99  					, p_groups	 IN INTEGER  DEFAULT 0
100  					, p_names	 IN INTEGER  DEFAULT 0
101  					, p_descriptions IN INTEGER  DEFAULT 0
102  					, p_min_fill	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
103  					)
104  	 RETURN VARCHAR2
105    IS
106  	 l_return_text	 VARCHAR2(32767 CHAR);
107  	 l_template_text VARCHAR2(32767 CHAR);
108    BEGIN
109  	 -- fetch template: 'sets: @sets@ groups: @groups@ names: @names@ descriptions: @descs@'
110  	 l_template_text := otap_util.get_config_value(otap_util.CFG_TEMPLATE_REPORT_TOTAL);
111  	 -- replace variables
112  	 l_template_text := REPLACE(l_template_text, '@sets@', TRIM(TO_CHAR(NVL(p_sets, 0))));
113  	 l_template_text := REPLACE(l_template_text, '@groups@', TRIM(TO_CHAR(NVL(p_groups, 0))));
