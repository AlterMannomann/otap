464    FUNCTION has_object( p_object_name     IN     VARCHAR2
465  			  , p_object_type     IN     VARCHAR2
466  			  , o_errors		 OUT VARCHAR2
467  			  , p_schema	      IN     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
468  			  , p_expected_result IN     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
469  			  )
470  	 RETURN INTEGER
471    IS
472  	 l_script	  VARCHAR2(1024 CHAR)	 := 'otap_schema.has_object';
473  	 l_test_passed	  INTEGER;
474  	 l_expected	  INTEGER;
475  	 l_has_object	  INTEGER;
476  	 l_object_name	  VARCHAR2(128 CHAR);
477  	 l_object_type	  VARCHAR2(23 CHAR);
478  	 l_schema_to_use  VARCHAR2(128 CHAR);
479  	 l_errors	  VARCHAR2(32767 CHAR);
480    BEGIN
481  	 l_errors	   := NULL;
482  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
483  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
484  	 l_object_name	   := otap_string.reduce(p_object_name, 128);
485  	 l_object_type	   := otap_string.reduce(UPPER(p_object_type), 23);
486  	 IF	l_object_name	     IS NOT NULL
487  	    AND LENGTH(l_object_name) > 0
488  	    AND l_object_type	     IS NOT NULL
489  	    AND LENGTH(l_object_type) > 0
490  	 THEN
491  	   -- schema
492  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
493  	   -- check
494  	   SELECT COUNT(*)
495  	     INTO l_has_object
496  	     FROM dba_objects
497  	    WHERE owner       = l_schema_to_use
498  	      AND object_name = l_object_name
499  	      AND object_type = l_object_type
500  	   ;
501  	   -- we should find one or zero entries
502  	   l_test_passed := count_chk(l_has_object, l_errors, l_script);
503  	 ELSE
504  	   -- invalid package name, type or state
505  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
506  	   l_errors	       := 'Not allowed: ' || CASE
507  						       WHEN l_object_name IS NULL OR LENGTH(l_object_name) = 0
508  						       THEN 'p_object_name(NULL) '
509  						     END ||
510  						     CASE
511  						       WHEN l_object_type IS NULL OR LENGTH(l_object_type) = 0
512  						       THEN 'p_object_type(NULL)'
513  						     END
514  	   ;
515  	   otap_log.log(l_errors, l_script, 'Object name NULL or type NULL');
516  	 END IF;
517  	 -- now decide on the expected result the final state and if errors are returned
518  	 IF l_test_passed != l_expected
519  	 THEN
520  	   o_errors := otap_string.reduce(l_errors, 4000);
521  	 ELSE
522  	   -- overwrite states from before, as we fulfill expected
523  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
524  	   -- overwrite errors expected
525  	   o_errors := NULL;
526  	 END IF;
527  	 RETURN l_test_passed;
528    EXCEPTION
529  	 WHEN OTHERS THEN
530  	   IF SQLCODE != -20099
531  	   THEN
532  	     -- log unhandled exceptions
533  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
534  	   END IF;
535  	   RAISE;
536    END has_object;
537  
