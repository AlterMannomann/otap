SQL> CREATE OR REPLACE PACKAGE otap_generate
  2  AS
  3  
  4    /**
  5    * Provides view functions to generate test scripts from schema objects.
  6    * WARNING This records just the current state of the schema. This does not mean that it is the correct
  7    * or desired state. Control and adjust the generated test calls to your need. This is a helper for
  8    * a simple start with schema tests, NOT with functional tests.
  9    */
 10  
 11    /** FUNCTION otap_generate.column_tests
 12    * Generates the test scripts for the columns of a given table and schema with the current available
 13    * otap schema functions. Limited to line size 4000 but not to rows, like DBMS_OUTPUT. It is up to you how
 14    * you spool the content to files.
 15    *
 16    * @param p_table Mandatory. The table name to get column tests for. Case sensitive.
 17    * @param p_like_column The like experession for the columns to generate tests for. Can also be a specific column name. Case sensitive.
 18    * @param p_schema The schema to generate the column tests for. Default is current schema.
 19    * @param p_title_prefix An optional title prefix for group and test names. Limited to 10 chars.
 20    * @param p_show_header Used to surpress header comments, init, count and finish section. Default 1 will contain all sections, otherwise skipped.
 21    * @param p_excl_sysgen Used to ignore system generated objects identified by SYS_ or $. Default 1 will ignore system generated objects, otherwise included.
 22    *
 23    * @return An OTAP_VIEW_RESULT_REC object as table type OTAP_VIEW_RESULT_TBL.
 24    */
 25    FUNCTION column_tests( p_table	      IN VARCHAR2
 26  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
 27  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 28  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
 29  			    , p_show_header   IN INTEGER  DEFAULT 1
 30  			    , p_excl_sysgen   IN INTEGER  DEFAULT 1
 31  			    )
 32  	 RETURN otap_view_result_tbl PIPELINED
 33    ;
 34  
 35    /** FUNCTION otap_generate.table_tests
 36    * Generates the test scripts for the tables of the given schema with the current available
 37    * otap schema functions. Provides group (tables) and name (table name) management.
 38    * Limited to line size 4000 but not to rows, like DBMS_OUTPUT. It is up to you how
 39    * you spool the content to files.
 40    *
 41    * @param p_schema The schema to generate the table tests for. Default is current schema.
 42    * @param p_like_table The like experession for the tables to generate tests for. Can also be a specific table name. Case sensitive.
 43    * @param p_title_prefix An optional title prefix for group and test names. Limited to 10 chars.
 44    * @param p_show_header Used to surpress header comments, init, count and finish section. Default 1 will contain all sections, otherwise skipped.
 45    * @param p_excl_sysgen Used to ignore system generated objects identified by SYS_ or $. Default 1 will ignore system generated objects, otherwise included.
 46    *
 47    * @return An OTAP_VIEW_RESULT_REC object as table type OTAP_VIEW_RESULT_TBL.
 48    */
 49    FUNCTION table_tests( p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 50  			   , p_like_table    IN VARCHAR2 DEFAULT '%'
 51  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
 52  			   , p_show_header   IN INTEGER  DEFAULT 1
 53  			   , p_excl_sysgen   IN INTEGER  DEFAULT 1
 54  			   )
 55  	 RETURN otap_view_result_tbl PIPELINED
 56    ;
 57  
 58    /** FUNCTION otap_generate.trigger_tests
 59    * Generates the test scripts for the trigger of the given schema with the current available
 60    * otap schema functions. Provides group (trigger) and name (table trigger, non table trigger) management.
 61    * Limited to line size 4000 but not to rows, like DBMS_OUTPUT. It is up to you how
 62    * you spool the content to files.
 63    *
 64    * @param p_schema The schema to generate the trigger tests for. Default is current schema.
 65    * @param p_like_trigger The like experession for the trigger to generate tests for. Can also be a specific trigger name. Case sensitive.
 66    * @param p_title_prefix An optional title prefix for group and test names. Limited to 10 chars.
 67    * @param p_show_header Used to surpress header comments, init, count and finish section. Default 1 will contain all sections, otherwise skipped.
 68    * @param p_excl_sysgen Used to ignore system generated objects identified by SYS_ or $. Default 1 will ignore system generated objects, otherwise included.
 69    *
 70    * @return An OTAP_VIEW_RESULT_REC object as table type OTAP_VIEW_RESULT_TBL.
 71    */
 72    FUNCTION trigger_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
