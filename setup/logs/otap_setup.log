SQL> CREATE OR REPLACE TRIGGER otap_config_upd_trg
  2    BEFORE UPDATE ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  )
 13    THEN
 14  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 15    END IF;
 16    -- remove any leading and trailing blanks from config_value
 17    :NEW.config_value := TRIM(:NEW.config_value);
 18    -- ensure some values are not overwritten
 19    :NEW.created	   := :OLD.created;
 20    :NEW.created_by	   := :OLD.created_by;
 21    :NEW.created_by_os  := :OLD.created_by_os;
 22    -- check max length if defined
 23    IF :NEW.config_type = 'CHAR'
 24    THEN
 25  	 IF :NEW.config_max_length > 0
 26  	 THEN
 27  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 28  	   THEN
 29  	     RAISE_APPLICATION_ERROR(-20002, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 30  	   END IF;
 31  	 END IF;
 32    END IF;
 33    -- check number type
 34    IF :NEW.config_type = 'NUMBER'
 35    THEN
 36  	 l_ok := TRUE;
 37  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 38  	 BEGIN
 39  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 40  	 EXCEPTION
 41  	   WHEN OTHERS THEN
 42  	     l_ok := FALSE;
 43  	 END;
 44  	 IF NOT l_ok
 45  	 THEN
 46  	   RAISE_APPLICATION_ERROR(-20003, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 47  	 END IF;
 48    END IF;
 49    -- check range
 50    IF :NEW.config_name = 'PRESERVE_DAYS'
 51    THEN
 52  	 IF    TO_NUMBER(:NEW.config_value) > 7
 53  	    OR TO_NUMBER(:NEW.config_value) < 1
 54  	 THEN
 55  	   :NEW.config_value := '1';
 56  	 END IF;
 57    END IF;
 58    IF :NEW.config_name = 'DELETE_DELAY'
 59    THEN
 60  	 IF    TO_NUMBER(:NEW.config_value) > 600
 61  	    OR TO_NUMBER(:NEW.config_value) < 1
 62  	 THEN
 63  	   :NEW.config_value := '10';
 64  	 END IF;
 65    END IF;
 66    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
 67    THEN
 68  	 IF    TO_NUMBER(:NEW.config_value) > 10000
 69  	    OR TO_NUMBER(:NEW.config_value) < 100
 70  	 THEN
 71  	   :NEW.config_value := '1000';
 72  	 END IF;
 73    END IF;
 74    IF :NEW.config_name = 'DEBUG_MODE'
 75    THEN
 76  	 IF TO_NUMBER(:NEW.config_value) NOT IN (0, 1)
 77  	 THEN
 78  	   :NEW.config_value := '0';
 79  	 END IF;
 80    END IF;
 81  END;
 82  /

