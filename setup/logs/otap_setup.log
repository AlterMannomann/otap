SQL> -- generic exists template
SQL> -- @type@ represents the object type as defined in the database, see ALL_OBJECTS object_type.
SQL> -- @object@ represents the simple object name, package functions and procedures use GENERIC_SUB_TEMPLATE_EXISTS
SQL> -- @schema@ represents the schema of the object
SQL> INSERT INTO otap_config
  2    (config_name, config_value, config_type, config_max_length, translatable, config_description)
  3    VALUES
  4    ('TEMPLATE_EXISTS', '@type@ @object@ exists check (@schema@)', otap_constants.get_otap_config_type_char, 256, 1, 'Used as a template, all @variables@ will be replaced by corresponding values. The @variablename@ cannot be changed. Limited to 256 chars, recommended shorter than 80 chars.')
  5  ;

1 row created.

SQL> -- extended exists template
SQL> -- @type@ represents the object type as defined in the database, see ALL_OBJECTS object_type.
SQL> -- @object@ represents the leading object name like package or table name
SQL> -- @subobject@ represents the related subobject name like column or package function or procedure name
SQL> -- @schema@ represents the schema of the object
SQL> INSERT INTO otap_config
  2    (config_name, config_value, config_type, config_max_length, translatable, config_description)
  3    VALUES
  4    ('TEMPLATE_XEXISTS', '@type@ @object@.@subobject@ exists check (@schema@)', otap_constants.get_otap_config_type_char, 256, 1, 'Used as a template, all @variables@ will be replaced by corresponding values. The @variablename@ cannot be changed. Limited to 256 chars, recommended shorter than 80 chars.')
  5  ;

