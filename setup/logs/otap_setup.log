  2  AS
  3    -- for description see header file
  4    FUNCTION reduce( p_string VARCHAR2 DEFAULT NULL
  5  		      , p_size	 INTEGER  DEFAULT 0
  6  		      )
  7  	 RETURN VARCHAR2
  8    IS
  9  	 l_script VARCHAR2(256 CHAR) := 'otap_string.reduce';
 10  	 l_string VARCHAR2(32767 CHAR);
 11    BEGIN
 12  	 l_string := CASE WHEN LENGTH(TRIM(p_string)) > p_size THEN TRIM(SUBSTR(TRIM(p_string), 1, p_size)) ELSE TRIM(p_string) END;
 13  	 RETURN l_string;
 14    EXCEPTION
 15  	 WHEN OTHERS THEN
 16  	   otap_log.log(SQLERRM, l_script, 'CASE WHEN LENGTH(TRIM(p_string)) > p_size THEN TRIM(SUBSTR(TRIM(p_string), 1, p_size)) ELSE TRIM(p_string) END');
 17  	   RAISE;
 18    END reduce;
