325    PROCEDURE add_test(o_otap_session IN OUT NOCOPY OTAP_SESSION)
326    IS
327    BEGIN
328  	 o_otap_session.test_count := o_otap_session.test_count + 1;
329    EXCEPTION
330  	 WHEN OTHERS THEN
331  	   otap_util.log('EXCEPTION -20099 invalid OTAP_SESSION object. Internal error:' || SQLERRM, 'otap_plan.add_test', 'o_otap_session.test_count := o_otap_session.test_count + 1');
332  	   RAISE_APPLICATION_ERROR(-20099, 'ERROR otap_plan.add_test. Internal error: ' || SQLERRM);
333    END add_test;
334  
335    FUNCTION format_test_result( p_test_passed IN INTEGER
336  				  , p_description IN VARCHAR2
337  				  )
338  	 RETURN VARCHAR2
339    IS
340  	 l_test_result VARCHAR2(256);
341  	 l_statement   VARCHAR2(32767);
342    BEGIN
343  	 -- result column
344  	 l_test_result := RPAD(otap_constants.translate_test_result(p_test_passed), 10, ' ');
345  	 -- we still have 246 chars
346  	 l_test_result := l_test_result || TRIM(SUBSTR(p_description, 1, 246));
347  	 RETURN l_test_result;
348    EXCEPTION
349  	 WHEN OTHERS THEN
350  	   l_statement := q'[l_test_result := RPAD(otap_constants.translate_test_result(p_test_passed), 10, ' ');
351  l_test_result := l_test_result || TRIM(SUBSTR(p_description, 1, 246));]'
352  	   ;
353  	   otap_util.log('Unexpected exception. Internal error:' || SQLERRM, 'otap_plan.format_test_result', l_statement);
354  	   RAISE;
355    END format_test_result;
356  
357  END;
358  /

