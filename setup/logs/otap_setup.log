716    FUNCTION has_table( p_table_name      IN 	   VARCHAR2
717  			 , o_otap_session    IN OUT NOCOPY OTAP_SESSION
718  			 , p_schema	     IN 	   VARCHAR2	DEFAULT NULL
719  			 , p_description     IN 	   VARCHAR2	DEFAULT NULL
720  			 , p_expected_result IN 	   NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
721  			 )
722  	 RETURN VARCHAR2
723    IS
724  	 l_script	    VARCHAR2(1024 CHAR) 		 := 'otap_api.has_table';
725  	 l_start	    TIMESTAMP;
726  	 l_result	    INTEGER;
727  	 l_return	    VARCHAR2(4000 CHAR);
728  	 l_errors	    otap_results.test_errors%TYPE;
729  	 l_schema	    otap_results.db_schema%TYPE;
730  	 l_desc 	    otap_results.test_desc%TYPE;
731  	 l_tmp_otap_session OTAP_SESSION;
732    BEGIN
733  	 l_start  := SYSTIMESTAMP;
734  	 -- default return
735  	 l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED) || ' ' || otap_constants.OTAP_INTERNAL_NA;
736  	 -- own begin-end for the transaction after the function
737  	 BEGIN
738  	   -- own begin-end block for the function itself and prepare
739  	   BEGIN
740  	     l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
741  	     l_desc   := otap_string.reduce( otap_report.get_exists_msg( p_object_name => p_table_name
742  								       , p_schema_name => l_schema
743  								       , p_object_type => otap_util.CFG_LABEL_TABLE
744  								       , p_sub_object => NULL
745  								       , p_desc => p_description
746  								       )
747  					   , 256
748  					   )
749  	     ;
750  	     -- call function
751  	     l_result := otap_schema.has_table( p_table_name
752  					      , l_errors
753  					      , l_schema
754  					      , p_expected_result
755  					      )
756  	     ;
757  	   EXCEPTION
758  	     WHEN OTHERS THEN
759  	     -- consume error
760  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
761  	     l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
762  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
763  	   END;
764  	   -- write result
765  	   l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
766  	 EXCEPTION
767  	   WHEN OTHERS THEN
768  	     -- consume error
769  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
770  	     l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
771  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
772  	     -- try again
773  	     l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
774  	 END;
775  	 -- return result or let exception happen
776  	 RETURN l_return;
777    END has_table;
778  
779    FUNCTION has_column( p_table_name      IN	    VARCHAR2
780  			  , p_column_name     IN	    VARCHAR2
781  			  , o_otap_session    IN OUT NOCOPY OTAP_SESSION
782  			  , p_schema	      IN	    VARCHAR2	 DEFAULT NULL
783  			  , p_description     IN	    VARCHAR2	 DEFAULT NULL
784  			  , p_data_type       IN	    VARCHAR2	 DEFAULT NULL
785  			  , p_data_length     IN	    NUMBER	 DEFAULT NULL
786  			  , p_data_precision  IN	    NUMBER	 DEFAULT NULL
787  			  , p_data_scale      IN	    NUMBER	 DEFAULT NULL
788  			  , p_nullable	      IN	    VARCHAR2	 DEFAULT NULL
789  			  , p_data_default    IN	    VARCHAR2	 DEFAULT NULL
790  			  , p_expected_result IN	    NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
791  			  )
792  	 RETURN VARCHAR2
793    IS
794  	 l_script	    VARCHAR2(1024 CHAR) 		 := 'otap_api.has_column';
795  	 l_start	    TIMESTAMP;
796  	 l_result	    INTEGER;
797  	 l_return	    VARCHAR2(4000 CHAR);
798  	 l_errors	    otap_results.test_errors%TYPE;
799  	 l_schema	    otap_results.db_schema%TYPE;
800  	 l_desc 	    otap_results.test_desc%TYPE;
