526    FUNCTION throws_matches( p_statement	  IN		VARCHAR2
527  			      , p_regex_sqlerrm   IN		VARCHAR2
528  			      , o_errors	     OUT NOCOPY VARCHAR2
529  			      , p_param 	  IN		VARCHAR2 DEFAULT NULL
530  			      , p_header_def	  IN		VARCHAR2 DEFAULT NULL
531  			      , p_expected_result IN		NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
532  			      )
533  	 RETURN INTEGER
534    IS
535  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_matches';
536  	 l_test_passed	 INTEGER;
537  	 l_expected	 INTEGER;
538  	 l_count	 INTEGER;
539  	 l_errors	 VARCHAR2(32767 CHAR);
540  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
541  	 l_sqlcode	 NUMBER;
542    BEGIN
543  	 l_errors      := NULL;
544  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
545  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
546  	 IF p_param IS NOT NULL
547  	 THEN
548  	   -- check parameter
549  	   SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_param, '^[icmnx]*$');
550  	 ELSE
551  	   l_count := 1;
552  	 END IF;
553  	 IF l_count = 1
554  	 THEN
555  	   -- process the statement
556  	   IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
557  	   THEN
558  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(l_sqlerrm, p_regex_sqlerrm, p_param);
559  	     IF l_count = 1
560  	     THEN
561  	       l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
562  	     ELSE
563  	       -- decide which case happened
564  	       IF l_sqlcode = -20100
565  	       THEN
566  		 -- invalid header, l_errors should be set and logged already
567  		 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
568  	       ELSE
569  		 -- exception happened but does not match
570  		 l_errors      := l_errors || 'Given regular expression does not match with ' || l_sqlerrm;
571  		 l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
572  		 otap_log.log(l_errors, l_script);
573  	       END IF;
574  	     END IF;
575  	   ELSE
576  	     -- no exception raised, l_errors should be set and logged already
577  	     l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
578  	     otap_log.log(l_errors, l_script);
579  	   END IF;
580  	 ELSE
581  	   -- invalid parameter
582  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
583  	   l_errors	 := l_errors || 'Not allowed: p_param(' || p_param || ') only i, c, m, n or x supported. Case sensitive.';
584  	   -- log error
585  	   otap_log.log(l_errors, l_script);
586  	 END IF;
587  	 -- now decide on the expected result the final state and if errors are returned
588  	 IF l_test_passed != l_expected
589  	 THEN
590  	   o_errors := otap_string.reduce(l_errors, 4000);
591  	 ELSE
592  	   -- overwrite states from before, as we fulfill expected
593  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
594  	   -- overwrite errors expected
595  	   o_errors := NULL;
596  	 END IF;
597  	 RETURN l_test_passed;
598    EXCEPTION
599  	 WHEN OTHERS THEN
600  	   IF SQLCODE != -20099
601  	   THEN
602  	     -- log unhandled exceptions
603  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
604  	   END IF;
605  	   RAISE;
606    END throws_matches;
607  
608    FUNCTION throws_like( p_statement       IN	     VARCHAR2
609  			   , p_like_sqlerrm    IN	     VARCHAR2
610  			   , o_errors		  OUT NOCOPY VARCHAR2
611  			   , p_case_sensitive  IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_FALSE
612  			   , p_header_def      IN	     VARCHAR2 DEFAULT NULL
613  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
614  			   )
615  	 RETURN INTEGER
616    IS
617  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_like';
618  	 l_test_passed	 INTEGER;
619  	 l_expected	 INTEGER;
620  	 l_count	 INTEGER;
621  	 l_like 	 VARCHAR2(32767 CHAR);
622  	 l_have 	 VARCHAR2(32767 CHAR);
623  	 l_errors	 VARCHAR2(32767 CHAR);
624  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
625  	 l_sqlcode	 NUMBER;
626    BEGIN
627  	 l_errors      := NULL;
628  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
629  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
630  	 IF p_like_sqlerrm IS NOT NULL
631  	 THEN
632  	   -- process the statement
633  	   IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
634  	   THEN
635  	     l_like := CASE WHEN p_case_sensitive = otap_constants.OTAP_NUM_TRUE THEN p_like_sqlerrm ELSE UPPER(p_like_sqlerrm) END;
636  	     l_have := CASE WHEN p_case_sensitive = otap_constants.OTAP_NUM_TRUE THEN l_sqlerrm ELSE UPPER(l_sqlerrm) END;
637  	     SELECT COUNT(*) INTO l_count FROM dual WHERE l_have LIKE l_like;
638  	     IF l_count = 1
639  	     THEN
640  	       l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
641  	     ELSE
642  	       -- decide which case happened
643  	       IF l_sqlcode = -20100
644  	       THEN
645  		 -- invalid header, l_errors should be set and logged already
646  		 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
647  	       ELSE
648  		 -- exception happened but does not match
649  		 l_errors      := l_errors || 'Given like expression does not match with ' || l_sqlerrm;
650  		 l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
651  		 otap_log.log(l_errors, l_script);
652  	       END IF;
653  	     END IF;
654  	   ELSE
655  	     -- no exception raised, l_errors should be set and logged already
656  	     l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
657  	     otap_log.log(l_errors, l_script);
658  	   END IF;
659  	 ELSE
660  	   -- invalid like expression
661  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
662  	   l_errors	 := l_errors || 'Not allowed: p_like_sqlerrm(NULL)';
663  	   -- log error
664  	   otap_log.log(l_errors, l_script);
665  	 END IF;
666  	 -- now decide on the expected result the final state and if errors are returned
667  	 IF l_test_passed != l_expected
668  	 THEN
669  	   o_errors := otap_string.reduce(l_errors, 4000);
670  	 ELSE
671  	   -- overwrite states from before, as we fulfill expected
672  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
673  	   -- overwrite errors expected
674  	   o_errors := NULL;
675  	 END IF;
676  	 RETURN l_test_passed;
677    EXCEPTION
678  	 WHEN OTHERS THEN
679  	   IF SQLCODE != -20099
680  	   THEN
681  	     -- log unhandled exceptions
682  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
683  	   END IF;
684  	   RAISE;
685    END throws_like;
686  
687  END;
