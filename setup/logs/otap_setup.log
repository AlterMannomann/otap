224    FUNCTION build_procedure_header( p_title_prefix	IN VARCHAR2 DEFAULT NULL
225  				      , p_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
226  				      , p_object_type	IN VARCHAR2 DEFAULT NULL
227  				      , p_object	IN VARCHAR2 DEFAULT NULL
228  				      , p_scope 	IN VARCHAR2 DEFAULT '%'
229  				      , p_script_count	IN NUMBER   DEFAULT 0
230  				      , p_show_header	IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TRUE
231  				      )
232  	 RETURN otap_view_result_tbl PIPELINED
233    IS
234  	 l_statement   VARCHAR2(4000 CHAR);
