 99  	     END IF;
100  	     IF p_otap_session.test_prefix IS NULL OR LENGTH(TRIM(p_otap_session.test_prefix)) = 0
101  	     THEN
102  	       l_message := l_message || l_delimiter || 'test_prefix';
