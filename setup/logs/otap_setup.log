891  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
892  	     -- try again
893  	     l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
894  	 END;
895  	 -- return result or let exception happen
896  	 RETURN l_return;
897    END has_package;
