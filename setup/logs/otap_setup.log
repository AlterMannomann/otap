343    FUNCTION otap_session_set_test_set( p_test_set	  IN		VARCHAR2
344  					 , o_otap_session IN OUT NOCOPY OTAP_SESSION
345  					 )
346  	 RETURN VARCHAR2
347    IS
348  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_set_test_set';
349  	 l_message VARCHAR2(4000 CHAR);
350    BEGIN
351  	 otap_objects.otap_session_verify(o_otap_session);
352  	 IF LENGTH(p_test_set) > 256
353  	 THEN
354  	   o_otap_session.test_set := SUBSTR(p_test_set, 1, 256);
355  	   otap_log.log('ERROR test set name length exceed 256 chars. Test set ' || p_test_set || ' cutted to 256 chars.', l_script, 'LENGTH(p_test_set) > 256');
356  	 ELSE
357  	   o_otap_session.test_set := NVL(p_test_set, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET);
358  	 END IF;
359  	 l_message := otap_string.reduce('Current test set: ' || o_otap_session.test_set, 4000);
360  	 RETURN l_message;
361    EXCEPTION
362  	 WHEN OTHERS THEN
363  	   IF SQLCODE != -20099
364  	   THEN
365  	     -- log unhandled exceptions
366  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
367  	   END IF;
368  	   RAISE;
369    END otap_session_set_test_set;
