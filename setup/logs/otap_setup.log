483    PROCEDURE otap_session_add_test( p_test_passed  IN NUMBER
484  				      , o_otap_session IN OUT NOCOPY OTAP_SESSION
485  				      )
486    IS
487  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_add_test';
488    BEGIN
489  	 otap_objects.otap_session_verify(o_otap_session);
490  	 o_otap_session.test_count := o_otap_session.test_count + 1;
491  	 IF p_test_passed != otap_constants.OTAP_NUM_TEST_PASSED
492  	 THEN
493  	   o_otap_session.error_count := o_otap_session.error_count + 1;
494  	 END IF;
495    EXCEPTION
496  	 WHEN OTHERS THEN
497  	   IF SQLCODE != -20099
498  	   THEN
499  	     -- log unhandled exceptions
500  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
501  	   END IF;
502  	   RAISE;
503    END otap_session_add_test;
