140    FUNCTION build_script_header( p_title_prefix  IN VARCHAR2 DEFAULT NULL
141  				   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
142  				   , p_object_type   IN VARCHAR2 DEFAULT NULL
143  				   , p_object	     IN VARCHAR2 DEFAULT NULL
144  				   , p_scope	     IN VARCHAR2 DEFAULT '%'
145  				   , p_script_count  IN NUMBER	 DEFAULT 0
146  				   , p_show_header   IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_TRUE
147  				   )
148  	 RETURN otap_view_result_tbl PIPELINED
149    IS
150  	 l_statement   VARCHAR2(4000 CHAR);
151  	 l_set	       VARCHAR2(256 CHAR);
152  	 l_group       VARCHAR2(256 CHAR);
153  	 l_name        VARCHAR2(256 CHAR);
154    BEGIN
155  	 -- map objects
156  	 otap_generate.prepare(p_title_prefix, p_schema, p_object_type, p_object, l_set, l_group, l_name);
157  	 l_statement := TRIM('-- otap GENERATE test scripts ' || l_set || ' ' || l_group || ' ' || l_name);
158  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
159  	 IF p_scope IS NOT NULL
160  	 THEN
161  	   l_statement := '-- LIKE scope: ' || TRIM(p_scope);
162  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
163  	 END IF;
164  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
165  	 THEN
166  	   l_statement := PREFIX_SQL || 'otap_test.init_test(' || TRIM(TO_CHAR(NVL(p_script_count, 0))) || ')' || POSTFIX_SQL;
167  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
168  	 END IF;
169  	 RETURN;
170    EXCEPTION
171  	 WHEN NO_DATA_NEEDED THEN
172  	   RAISE;
173    END build_script_header;
174  
175    FUNCTION build_function_header( p_title_prefix  IN VARCHAR2 DEFAULT NULL
176  				     , p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
177  				     , p_object_type   IN VARCHAR2 DEFAULT NULL
178  				     , p_object        IN VARCHAR2 DEFAULT NULL
179  				     , p_scope	       IN VARCHAR2 DEFAULT '%'
180  				     , p_script_count  IN NUMBER   DEFAULT 0
181  				     , p_show_header   IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TRUE
182  				     )
183  	 RETURN otap_view_result_tbl PIPELINED
184    IS
185  	 l_statement   VARCHAR2(4000 CHAR);
186  	 l_set	       VARCHAR2(256 CHAR);
187  	 l_group       VARCHAR2(256 CHAR);
188  	 l_name        VARCHAR2(256 CHAR);
189  	 l_fn_name     VARCHAR2(128 CHAR);
190    BEGIN
191  	 l_fn_name := otap_generate.prepare(p_title_prefix, p_schema, p_object_type, p_object, l_set, l_group, l_name);
192  	 l_statement := otap_generate.get_code_pad || TRIM('-- otap GENERATE function test scripts ' || l_set || ' ' || l_group || ' ' || l_name);
193  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
194  	 IF p_scope IS NOT NULL
195  	 THEN
196  	   l_statement := otap_generate.get_code_pad || '-- LIKE scope: ' || TRIM(p_scope);
197  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
198  	 END IF;
199  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
200  	 THEN
201  	   l_statement := '-- otap GENERATE test function ' || l_fn_name;
202  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
203  	   l_statement := 'CREATE OR REPLACE FUNCTION ' || l_fn_name;
204  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
205  	   l_statement := otap_generate.get_code_pad || 'RETURN NUMBER';
206  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
207  	   l_statement := 'IS';
208  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
209  	   l_statement := otap_generate.get_code_pad || 'l_message VARCHAR2(4000);';
210  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
211  	   l_statement := otap_generate.get_code_pad || 'l_return  NUMBER;';
212  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
213  	   l_statement := 'BEGIN';
214  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
215  	   l_statement := PREFIX_PLSQL || 'otap_test.init_test(' || TRIM(TO_CHAR(NVL(p_script_count, 0))) || ')' || POSTFIX_PLSQL;
216  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
217  	 END IF;
218  	 RETURN;
219    EXCEPTION
220  	 WHEN NO_DATA_NEEDED THEN
221  	   RAISE;
222    END build_function_header;
