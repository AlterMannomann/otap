770    FUNCTION result_view(p_session_id IN NUMBER)
771  	 RETURN otap_view_result_tbl PIPELINED
772    IS
773  	 l_delim_updown VARCHAR2(1 CHAR) := '=';
774  	 l_delim_tests	VARCHAR2(1 CHAR) := '-';
775  	 l_text_column	VARCHAR2(4000 CHAR);
776  	 l_has_errors	INTEGER;
777  	 l_has_records	INTEGER;
778  	 l_report_size	INTEGER;
779  	 CURSOR cur_test_sets(cp_session_id IN NUMBER)
780  	 IS
781  	   SELECT test_set
782  		, COUNT(*) AS test_runs
783  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
784  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
785  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
786  	     FROM otap_results
787  	    WHERE test_session_id = cp_session_id
788  	      AND test_name	 != otap_api.get_text_test_count_name
789  	    GROUP BY test_set
790  	    ORDER BY MIN(test_run_date)
791  	 ;
792  	 CURSOR cur_test_groups( cp_session_id IN NUMBER
793  			       , cp_test_set   IN VARCHAR2
794  			       )
795  	 IS
796  	   SELECT test_group
797  		, COUNT(*) AS test_runs
798  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
799  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
800  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
801  	     FROM otap_results
802  	    WHERE test_session_id = cp_session_id
803  	      AND test_set	  = cp_test_set
804  	      AND test_name	 != otap_api.get_text_test_count_name
805  	    GROUP BY test_group
806  	    ORDER BY MIN(test_run_date)
807  	 ;
808  	 CURSOR cur_test_names( cp_session_id IN NUMBER
809  			      , cp_test_set   IN VARCHAR2
810  			      , cp_test_group IN VARCHAR2
811  			      )
812  	 IS
813  	   SELECT test_name
814  		, COUNT(*) AS test_runs
815  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
816  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
817  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
818  	     FROM otap_results
819  	    WHERE test_session_id = cp_session_id
820  	      AND test_set	  = cp_test_set
821  	      AND test_group	  = cp_test_group
822  	      AND test_name	 != otap_api.get_text_test_count_name
823  	    GROUP BY test_name
824  	    ORDER BY MIN(test_run_date)
825  	 ;
826  	 CURSOR cur_test_count(cp_session_id IN NUMBER)
827  	 IS
828  	   SELECT test_name
829  		, COUNT(*) AS test_runs
830  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
831  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
832  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
833  	     FROM otap_results
834  	    WHERE test_session_id = cp_session_id
835  	      AND test_name	  = otap_api.get_text_test_count_name
836  	    GROUP BY test_name
837  	    ORDER BY MIN(test_run_date)
838  	 ;
839  	 CURSOR cur_session_total(cp_session_id IN NUMBER)
840  	 IS
841  	   SELECT test_session_id
842  		, COUNT(DISTINCT test_set) AS test_sets
843  		, COUNT(DISTINCT test_group) AS test_groups
844  		, COUNT(DISTINCT test_name) AS test_names
845  		, COUNT(DISTINCT test_desc) AS test_descs
846  		, COUNT(*) AS test_runs
847  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
848  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
849  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
850  	     FROM otap_results
851  	    WHERE test_session_id = cp_session_id
852  		  -- exclude optional extra total count test
853  	      AND test_name	 != otap_api.get_text_test_count_name
854  	    GROUP BY test_session_id
855  	    ORDER BY MIN(test_run_date)
856  	 ;
857  	 CURSOR cur_tests( cp_session_id IN NUMBER
858  			 , cp_test_set	 IN VARCHAR2
859  			 , cp_test_group IN VARCHAR2
860  			 , cp_test_name  IN VARCHAR2
861  			 )
862  	 IS
863  	   SELECT test_desc
864  		, test_passed
865  		, otap_api.test_result_to_text(test_passed) AS test_state
866  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
867  		, test_errors
868  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
869  	     FROM otap_results
870  	    WHERE test_session_id = cp_session_id
871  	      AND test_set	  = cp_test_set
872  	      AND test_group	  = cp_test_group
873  	      AND test_name	  = cp_test_name
874  	    ORDER BY test_run_date
875  	 ;
876  	 CURSOR cur_count_tests( cp_session_id IN NUMBER
877  			       , cp_test_name  IN VARCHAR2
878  			       )
879  	 IS
880  	   SELECT test_desc
881  		, test_passed
882  		, otap_api.test_result_to_text(test_passed) AS test_state
883  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
884  		, test_errors
885  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
886  	     FROM otap_results
887  	    WHERE test_session_id = cp_session_id
888  	      AND test_name	  = cp_test_name
889  	    ORDER BY test_run_date
890  	 ;
891    BEGIN
892  	 l_report_size := otap_api.max_text_size(p_session_id);
893  	 -- header row
894  	 l_text_column := otap_api.get_report_header(l_report_size);
895  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
896  	 l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
897  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
898  	 -- check for records
899  	 SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
900  	 IF l_has_records > 0
901  	 THEN
902  	   -- loop through the set
903  	   FOR rec_set IN cur_test_sets(p_session_id)
904  	   LOOP
905  	     -- build test set column
906  	     l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size);
907  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
908  	     -- build test set summary
909  	     l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size);
910  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
911  	     -- loop through the group
912  	     FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set)
913  	     LOOP
914  	       l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size);
915  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
916  	       -- build test set summary
917  	       l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size);
918  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
919  	       -- loop through the names
920  	       FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group)
921  	       LOOP
922  		 l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size);
923  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
924  		 -- build test set summary
925  		 l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size);
926  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
927  		 -- build header
928  		 l_text_column := otap_api.get_result_header(l_report_size);
929  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
930  		 l_text_column := otap_api.get_result_underline(l_report_size);
931  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
932  		 -- loop through the tests
933  		 FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
934  		 LOOP
935  		   l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
936  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
937  		 END LOOP;
938  		 SELECT COUNT(*)
939  		   INTO l_has_errors
940  		   FROM otap_results
941  		  WHERE test_session_id = p_session_id
942  		    AND test_set	= rec_set.test_set
943  		    AND test_group	= rec_grp.test_group
944  		    AND test_name	= rec_nam.test_name
945  		    AND test_errors    IS NOT NULL
946  		 ;
947  		 IF l_has_errors > 0
948  		 THEN
949  		   -- build error delimiter for tests
950  		   l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size);
951  		   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
952  		   FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
953  		   LOOP
954  		     IF rec_tst.test_errors IS NOT NULL
955  		     THEN
956  		       l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
957  		       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
958  		     END IF;
959  		   END LOOP;
960  		 END IF;
961  	       END LOOP;
962  	     END LOOP;
963  	   END LOOP;
964  	   -- no loop through the test count if exists
965  	   FOR rec IN cur_test_count(p_session_id)
966  	   LOOP
967  	     -- build header
968  	     l_text_column := otap_api.get_test_count_header(l_report_size);
969  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
970  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
971  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
972  	     -- build header
973  	     l_text_column := otap_api.get_result_header(l_report_size);
974  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
975  	     l_text_column := otap_api.get_result_underline(l_report_size);
976  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
977  	     -- loop through the tests
978  	     FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
979  	     LOOP
980  	       l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
981  	       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
982  	     END LOOP;
983  	     SELECT COUNT(*)
984  	       INTO l_has_errors
985  	       FROM otap_results
986  	      WHERE test_session_id = p_session_id
987  		AND test_name	    = rec.test_name
988  		AND test_errors    IS NOT NULL
989  	     ;
990  	     IF l_has_errors > 0
991  	     THEN
992  	       -- build error delimiter for tests
993  	       l_text_column := otap_api.get_error_result_header(rec.test_name, l_report_size);
994  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
995  	       FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
996  	       LOOP
997  		 IF rec_tst.test_errors IS NOT NULL
998  		 THEN
999  		   l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
1000  		    PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1001  		  END IF;
1002  		END LOOP;
1003  	      END IF;
1004  	    END LOOP;
1005  	    -- eventually build the totals for the test session
1006  	    l_text_column := otap_api.get_report_total(l_report_size);
1007  	    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1008  	    FOR rec IN cur_session_total(p_session_id)
1009  	    LOOP
1010  	      l_text_column := otap_api.get_report_total_details(rec.test_sets, rec.test_groups, rec.test_names, rec.test_descs, l_report_size);
1011  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1012  	      l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
1013  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1014  	    END LOOP;
1015  	  ELSE
1016  	    l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size);
1017  	    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1018  	  END IF;
1019  	  -- footer row
1020  	  l_text_column := otap_api.get_report_footer(l_report_size);
1021  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1022  	  -- add AI and copyright
1023  	  l_text_column := LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
1024  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1025  	  l_text_column := LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
1026  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1027  	  l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT1;
1028  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1029  	  l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT2;
1030  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1031  	  l_text_column := otap_constants.OTAP_INTERNAL_COPYRIGHT3;
1032  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1033  	  RETURN;
1034  	EXCEPTION
1035  	  WHEN NO_DATA_NEEDED THEN
1036  	    RAISE;
1037  	  WHEN OTHERS THEN
1038  	    IF SQLCODE != -20099
1039  	    THEN
1040  	      otap_log.log(SQLERRM, 'otap_api.result_view', 'Unhandled exception otap_api.result_view');
1041  	    END IF;
1042  	    RAISE;
1043  	END result_view;
1044  
1045  	-- test functions
1046  
1047  	FUNCTION has_table( p_table_name      IN	    VARCHAR2
1048  			  , o_otap_session    IN OUT NOCOPY OTAP_SESSION
1049  			  , p_schema	      IN	    VARCHAR2	 DEFAULT NULL
1050  			  , p_description     IN	    VARCHAR2	 DEFAULT NULL
1051  			  , p_expected_result IN	    NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1052  			  )
1053  	  RETURN VARCHAR2
1054  	IS
1055  	  l_script	     VARCHAR2(1024 CHAR)		  := 'otap_api.has_table';
1056  	  l_start	     TIMESTAMP;
1057  	  l_result	     INTEGER;
1058  	  l_return	     VARCHAR2(4000 CHAR);
1059  	  l_errors	     otap_results.test_errors%TYPE;
1060  	  l_schema	     otap_results.db_schema%TYPE;
1061  	  l_desc	     otap_results.test_desc%TYPE;
1062  	BEGIN
1063  	  l_start  := SYSTIMESTAMP;
1064  	  -- default return
1065  	  l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED) || ' ' || otap_constants.OTAP_INTERNAL_NA;
1066  	  -- own begin-end for the transaction after the function
1067  	  BEGIN
1068  	    -- own begin-end block for the function itself and prepare
1069  	    BEGIN
1070  	      l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
1071  	      l_desc   := otap_string.reduce( otap_report.get_exists_msg( p_object_name => p_table_name
1072  									, p_schema_name => l_schema
1073  									, p_object_type => otap_util.CFG_LABEL_TABLE
1074  									, p_sub_object => NULL
1075  									, p_test_desc => p_description
1076  									)
1077  					    , 256
1078  					    )
1079  	      ;
1080  	      -- call function
1081  	      l_result := otap_schema.has_table( p_table_name
1082  					       , l_errors
1083  					       , l_schema
1084  					       , p_expected_result
1085  					       )
1086  	      ;
1087  	    EXCEPTION
1088  	      WHEN OTHERS THEN
1089  	      -- consume error
1090  	      l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1091  	      l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
1092  	      otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
1093  	    END;
1094  	    -- write result
1095  	    l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
1096  	  EXCEPTION
1097  	    WHEN OTHERS THEN
1098  	      -- consume error
1099  	      l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1100  	      l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
1101  	      otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
1102  	      -- try again
1103  	      l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
1104  	  END;
1105  	  -- return result or let exception happen
1106  	  RETURN l_return;
1107  	END has_table;
1108  
1109  	FUNCTION has_column( p_table_name      IN	     VARCHAR2
1110  			   , p_column_name     IN	     VARCHAR2
1111  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
1112  			   , p_schema	       IN	     VARCHAR2	  DEFAULT NULL
1113  			   , p_description     IN	     VARCHAR2	  DEFAULT NULL
1114  			   , p_data_type       IN	     VARCHAR2	  DEFAULT NULL
1115  			   , p_data_length     IN	     NUMBER	  DEFAULT NULL
1116  			   , p_data_precision  IN	     NUMBER	  DEFAULT NULL
1117  			   , p_data_scale      IN	     NUMBER	  DEFAULT NULL
1118  			   , p_nullable        IN	     VARCHAR2	  DEFAULT NULL
1119  			   , p_data_default    IN	     VARCHAR2	  DEFAULT NULL
1120  			   , p_expected_result IN	     NUMBER	  DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1121  			   )
1122  	  RETURN VARCHAR2
1123  	IS
1124  	  l_script	     VARCHAR2(1024 CHAR)		  := 'otap_api.has_column';
1125  	  l_start	     TIMESTAMP;
1126  	  l_result	     INTEGER;
1127  	  l_return	     VARCHAR2(4000 CHAR);
1128  	  l_errors	     otap_results.test_errors%TYPE;
1129  	  l_schema	     otap_results.db_schema%TYPE;
1130  	  l_desc	     otap_results.test_desc%TYPE;
1131  	BEGIN
1132  	  l_start  := SYSTIMESTAMP;
1133  	  -- default return
