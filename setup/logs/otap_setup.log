 35    OTAP_CONFIG_TYPE_NUMBER	CONSTANT CHAR(6)	     := 'NUMBER';
 36    OTAP_CONFIG_TYPE_CHAR	CONSTANT CHAR(4)	     := 'CHAR';
 37  
 38    -- no get functions for the following constants
 39    -- internal otap constants only usable within PLSQL
 40    OTAP_INTERNAL_LF 		   CONSTANT CHAR(1)	   := CHR(10);
 41    OTAP_NUM_PREFIX_MAX_SIZE 	   CONSTANT INTEGER	   := 4;
 42    OTAP_LAYOUT_RIGHT		   CONSTANT CHAR(1)	   := 'R';
