813  			 , p_tablespace_name IN 	   VARCHAR2 DEFAULT NULL
814  			 , p_partitioned     IN 	   VARCHAR2 DEFAULT NULL
815  			 , p_schema	     IN 	   VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
816  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
817  			 )
818  	 RETURN INTEGER
819    IS
820  	 l_script	   VARCHAR2(1024 CHAR)	  := 'otap_schema.has_index';
821  	 l_test_passed	   INTEGER;
822  	 l_expected	   INTEGER;
823  	 l_has_index	   INTEGER;
824  	 l_table_name	   VARCHAR2(128 CHAR);
825  	 l_column_name	   VARCHAR2(128 CHAR);
826  	 l_index_name	   VARCHAR2(128 CHAR);
827  	 l_index_type	   VARCHAR2(27 CHAR);
828  	 l_table_type	   VARCHAR2(11 CHAR);
829  	 l_uniqueness	   VARCHAR2(9 CHAR);
830  	 l_tablespace_name VARCHAR2(30 CHAR);
831  	 l_partitioned	   VARCHAR2(3 CHAR);
832  	 l_schema_to_use   VARCHAR2(128 CHAR);
833  	 l_errors	   VARCHAR2(32767 CHAR);
834    BEGIN
835  	 l_errors	   := NULL;
836  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
837  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
838  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
839  	 l_column_name	   := otap_string.reduce(p_column_name, 128);
840  	 l_index_name	   := otap_string.reduce(p_index_name, 128);
841  	 l_index_type	   := otap_string.reduce(UPPER(p_index_type), 27);
842  	 l_table_type	   := otap_string.reduce(UPPER(p_table_type), 11);
843  	 l_uniqueness	   := otap_string.reduce(UPPER(p_uniqueness), 9);
844  	 l_tablespace_name := otap_string.reduce(p_tablespace_name, 30);
845  	 l_partitioned	   := otap_string.reduce(UPPER(p_partitioned), 3);
846  	 IF    (    l_table_name	IS NOT NULL
847  		AND LENGTH(l_table_name) > 0
848  	       )
849  	    OR (    l_index_name	IS NOT NULL
850  		AND LENGTH(l_index_name) > 0
851  	       )
852  	 THEN
853  	   -- schema
854  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
855  	   -- check
856  	   SELECT COUNT(*)
857  	     INTO l_has_index
858  	     FROM dba_indexes dix
859  	     LEFT OUTER JOIN dba_ind_columns dic
860  	       ON dix.owner	  = dic.index_owner
861  	      AND dix.index_name  = dic.index_name
862  	      AND dix.table_owner = dic.table_owner
863  	      AND dix.table_name  = dic.table_name
864  	    WHERE dix.owner			  = l_schema_to_use
865  	      AND dix.index_name		  = NVL(l_index_name, dix.index_name)
866  	      AND dix.table_name		  = NVL(l_table_name, dix.table_name)
867  	      AND NVL(dic.column_name, 'n/a')	  = NVL(l_column_name, NVL(dic.column_name, 'n/a'))
868  	      AND NVL(dix.index_type, 'n/a')	  = NVL(l_index_type, NVL(dix.index_type, 'n/a'))
869  	      AND NVL(dix.table_type, 'n/a')	  = NVL(l_table_type, NVL(dix.table_type, 'n/a'))
870  	      AND NVL(dix.uniqueness, 'n/a')	  = NVL(l_uniqueness, NVL(dix.uniqueness, 'n/a'))
871  	      AND NVL(dix.tablespace_name, 'n/a') = NVL(l_tablespace_name, NVL(dix.tablespace_name, 'n/a'))
872  	      AND NVL(dix.partitioned, 'n/a')	  = NVL(l_partitioned, NVL(dix.partitioned, 'n/a'))
873  	   ;
874  	   -- we may find more than one entry for index columns
875  	   l_test_passed := CASE WHEN l_has_index = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
876  	 ELSE
877  	   -- table name or index name missing
878  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
879  	   l_errors	       := 'Not allowed: p_table_name AND p_index_name NULL';
880  	   otap_log.log(l_errors, l_script, 'Table name and index name NULL');
881  	 END IF;
882  	 -- now decide on the expected result the final state and if errors are returned
883  	 IF l_test_passed != l_expected
884  	 THEN
885  	   o_errors := otap_string.reduce(l_errors, 4000);
886  	 ELSE
887  	   -- overwrite states from before, as we fulfill expected
888  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
889  	   -- overwrite errors expected
890  	   o_errors := NULL;
891  	 END IF;
892  	 RETURN l_test_passed;
893    EXCEPTION
894  	 WHEN OTHERS THEN
895  	   IF SQLCODE != -20099
896  	   THEN
897  	     -- log unhandled exceptions
898  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
899  	   END IF;
900  	   RAISE;
901    END has_index;
