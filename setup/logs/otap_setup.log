1318  	FUNCTION has_trigger( p_trigger_name	IN	      VARCHAR2
1319  			    , o_otap_session	IN OUT NOCOPY OTAP_SESSION
1320  			    , p_schema		IN	      VARCHAR2	    DEFAULT NULL
1321  			    , p_description	IN	      VARCHAR2	    DEFAULT NULL
1322  			    , p_trigger_type	IN	      VARCHAR2	    DEFAULT NULL
1323  			    , p_trigger_event	IN	      VARCHAR2	    DEFAULT NULL
1324  			    , p_table_owner	IN	      VARCHAR2	    DEFAULT NULL
1325  			    , p_table_name	IN	      VARCHAR2	    DEFAULT NULL
1326  			    , p_expected_result IN	      NUMBER	    DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1327  			    )
1328  	  RETURN VARCHAR2
1329  	IS
