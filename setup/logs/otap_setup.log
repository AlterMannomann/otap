168    FUNCTION match_regex( p_have	       IN	     VARCHAR2
169  			   , p_regex	       IN	     VARCHAR2
170  			   , o_errors		  OUT NOCOPY VARCHAR2
171  			   , p_param	       IN	     VARCHAR2 DEFAULT NULL
172  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
173  			   )
174  	 RETURN INTEGER
175    IS
176  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.match_regex';
177  	 l_test_passed	 INTEGER;
178  	 l_count	 INTEGER;
179  	 l_expected	 INTEGER;
180  	 l_errors	 VARCHAR2(32767 CHAR);
181    BEGIN
182  	 l_errors      := NULL;
183  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
184  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
185  	 IF p_regex IS NOT NULL
186  	 THEN
187  	   IF p_param IS NOT NULL
188  	   THEN
189  	     -- check parameter
190  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_param, '^[icmnx]*$');
191  	     IF l_count = 1
192  	     THEN
193  	       SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_have, p_regex, p_param);
194  	       l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
195  	     ELSE
196  	       -- invalid parameter
197  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
198  	       l_errors      := 'Not allowed: p_param(' || p_param || ') only i, c, m, n or x supported. Case sensitive.';
199  	       -- log error
200  	       otap_log.log(l_errors, l_script);
201  	     END IF;
202  	   ELSE
203  	     -- leave fail on REGEXP_LIKE if p_have is NULL or params are wrong
204  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_have, p_regex);
205  	     l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
206  	   END IF;
207  	 ELSE
208  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
209  	   l_errors	 := 'Not allowed: p_regex(NULL)';
210  	   -- log error
211  	   otap_log.log(l_errors, l_script);
212  	 END IF;
213  	 -- now decide on the expected result the final state and if errors are returned
214  	 IF l_test_passed != l_expected
215  	 THEN
216  	   o_errors := otap_string.reduce(l_errors, 4000);
217  	 ELSE
218  	   -- overwrite states from before, as we fulfill expected
219  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
220  	   -- overwrite errors expected
221  	   o_errors := NULL;
222  	 END IF;
223  	 RETURN l_test_passed;
224    EXCEPTION
225  	 WHEN OTHERS THEN
226  	   IF SQLCODE != -20099
227  	   THEN
228  	     -- log unhandled exceptions
229  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
230  	   END IF;
231  	   RAISE;
232    END match_regex;
233  
234    FUNCTION match_like( p_have	      IN	    VARCHAR2
235  			  , p_like	      IN	    VARCHAR2
236  			  , o_errors		 OUT NOCOPY VARCHAR2
237  			  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
238  			  )
239  	 RETURN INTEGER
240    IS
241  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.match_like';
242  	 l_test_passed	 INTEGER;
243  	 l_count	 INTEGER;
244  	 l_expected	 INTEGER;
245  	 l_errors	 VARCHAR2(32767 CHAR);
246    BEGIN
247  	 l_errors      := NULL;
248  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
249  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
250  	 IF p_like IS NOT NULL
251  	 THEN
252  	   -- leave fail on LIKE if p_have is NULL
253  	   SELECT COUNT(*) INTO l_count FROM dual WHERE p_have LIKE p_like;
254  	   l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
255  	 ELSE
256  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
257  	   l_errors	 := 'Not allowed: p_like(NULL)';
258  	   -- log error
259  	   otap_log.log(l_errors, l_script);
260  	 END IF;
261  	 -- now decide on the expected result the final state and if errors are returned
262  	 IF l_test_passed != l_expected
263  	 THEN
264  	   o_errors := otap_string.reduce(l_errors, 4000);
265  	 ELSE
266  	   -- overwrite states from before, as we fulfill expected
267  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
268  	   -- overwrite errors expected
269  	   o_errors := NULL;
270  	 END IF;
271  	 RETURN l_test_passed;
272    EXCEPTION
273  	 WHEN OTHERS THEN
274  	   IF SQLCODE != -20099
275  	   THEN
276  	     -- log unhandled exceptions
277  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
278  	   END IF;
279  	   RAISE;
280    END match_like;
281  
282  END;
283  /

