SQL> CREATE OR REPLACE PACKAGE BODY otap_util
  2  AS
  3    -- for description see header file
  4    FUNCTION is_number(p_varchar_number IN VARCHAR2)
  5  	 RETURN BOOLEAN
  6    IS
  7  	 l_number NUMBER;
  8  	 l_char   VARCHAR2(128 CHAR);
  9    BEGIN
 10  	 -- try to convert the number, if it fails return FALSE
 11  	 l_number := TO_NUMBER(TRIM(p_varchar_number));
 12  	 l_char   := TRIM(TO_CHAR(l_number));
 13  	 IF l_char = TRIM(p_varchar_number)
 14  	 THEN
 15  	   RETURN TRUE;
 16  	 ELSE
 17  	   RETURN FALSE;
 18  	 END IF;
 19    EXCEPTION
 20  	 WHEN OTHERS THEN
 21  	   RETURN FALSE;
 22    END is_number;
 23  
 24    FUNCTION is_integer(p_varchar_number IN VARCHAR2)
 25  	 RETURN BOOLEAN
 26    IS
 27  	 l_number  NUMBER;
 28  	 l_floored NUMBER;
 29    BEGIN
 30  	 IF is_number(p_varchar_number)
 31  	 THEN
 32  	   l_number  := TO_NUMBER(p_varchar_number);
 33  	   l_floored := FLOOR(l_number);
 34  	   RETURN (l_number = l_floored);
 35  	 ELSE
 36  	   RETURN FALSE;
 37  	 END IF;
 38    EXCEPTION
 39  	 WHEN OTHERS THEN
 40  	   RETURN FALSE;
 41    END is_integer;
