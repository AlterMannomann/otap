SQL> @@../otap_ddl/views/otap_labels_mv.sql
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> -- Internal view for otap labels. Cast to 128 length as config names.
SQL> -- Materialized to improve performance, if object types change in the database, refresh the view manually.
SQL> CREATE MATERIALIZED VIEW otap_labels_mv
  2    REFRESH FORCE ON DEMAND WITH ROWID USING TRUSTED CONSTRAINTS
  3  AS
  4  	 WITH grp AS (SELECT CAST(TRIM(object_type) AS VARCHAR2(128 CHAR)) AS object_type FROM dba_objects GROUP BY object_type
  5  		       UNION ALL
  6  			     -- add reserved word missing
  7  		      SELECT CAST(TRIM(keyword) AS VARCHAR2(128 CHAR)) AS object_type FROM v$reserved_words WHERE keyword IN ( 'COLUMN'
  8  															     , 'USER'
  9  															     , 'ROLE'
 10  															     , 'CONSTRAINT'
 11  															     , 'VARCHAR2'
 12  															     , 'NUMBER'
 13  															     , 'BOOLEAN'
 14  															     , 'DATE'
 15  															     , 'NULL'
 16  															     , 'DATABASE'
 17  															     )
 18  		       UNION ALL
 19  			     -- add reserved words that are a combination of more than one word for constraint types
 20  		      SELECT CAST('PRIMARY KEY' AS VARCHAR2(128 CHAR)) AS object_type FROM dual  -- P
 21  		       UNION ALL
 22  		      SELECT CAST('UNIQUE KEY' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- U
 23  		       UNION ALL
 24  		      SELECT CAST('FOREIGN KEY' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- R
 25  		       UNION ALL
 26  		      SELECT CAST('CHECK' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- C generic
 27  		       UNION ALL
 28  		      SELECT CAST('NOT NULL' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- C special
 29  		       UNION ALL
 30  		      SELECT CAST('VIEW CHECK' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- V
 31  		       UNION ALL
 32  		      SELECT CAST('VIEW READONLY' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- O
 33  		       UNION ALL
 34  		      SELECT CAST('REF COLUMN' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- F
 35  		       UNION ALL
 36  		      SELECT CAST('HASH' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- H
 37  		       UNION ALL
 38  		      SELECT CAST('SUPPLEMENTAL LOGGGING' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- S
 39  		       UNION ALL
 40  		      SELECT CAST('INVALID CONSTRAINT TYPE' AS VARCHAR2(128 CHAR)) AS object_type FROM dual -- S
 41  			-- scheduler job to differentiate from database job
 42  		       UNION ALL
 43  		      SELECT CAST('SCHEDULER JOB' AS VARCHAR2(128 CHAR)) AS object_type FROM dual
 44  			-- exception for logic matches on exceptions
 45  		       UNION ALL
 46  		      SELECT CAST('EXCEPTION' AS VARCHAR2(128 CHAR)) AS object_type FROM dual
 47  		     )
 48    SELECT object_type							     AS oracle_type
 49  	    , CAST('LABEL_' || REPLACE(object_type, ' ', '_') AS VARCHAR2(128 CHAR)) AS otap_identifier
 50  	    , LOWER(object_type)						     AS otap_label_lower
 51  	    , INITCAP(object_type)						     AS otap_label_cap
 52  	    , UPPER(object_type)						     AS otap_label_upper
 53  	    , object_type							     AS otap_label_source
 54  	 FROM grp
 55  ;

Materialized view created.

SQL> @@../otap_ddl/views/otap_identifiers_v.sql
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> -- Internal view for all otap identifiers that provides translations available from OTAP_TRANSLATE.
SQL> CREATE OR REPLACE VIEW otap_identifiers_v
  2  AS
  3  	 WITH lbl AS
  4  	      (SELECT config_name		       AS otap_identifier
  5  		      -- leave configuration unchanged
  6  		    , config_value		       AS label_text_lower
  7  		    , config_value		       AS label_text_cap
  8  		    , config_value		       AS label_text_upper
  9  		    , config_value		       AS label_source
 10  		    , config_type		       AS label_type
 11  		    , translatable		       AS label_translatable
 12  		    , otap_constants.get_otap_num_true AS from_config
 13  		 FROM otap_config
 14  		UNION ALL
 15  	       SELECT otap_identifier
 16  		    , otap_label_lower			       AS label_text_lower
 17  		    , otap_label_cap			       AS label_text_cap
 18  		    , otap_label_upper			       AS label_text_upper
 19  		    , otap_label_source 		       AS label_source
 20  		    , otap_constants.get_otap_config_type_char AS label_type
 21  		    , otap_constants.get_otap_num_true	       AS label_translatable
 22  		    , otap_constants.get_otap_num_false        AS from_config
 23  		 FROM otap_labels_mv
 24  	      )
 25    SELECT lbl.otap_identifier
 26  	      -- leave translations unchanged
 27  	    , NVL(otr.label_text, lbl.label_text_lower) AS label_text_lower
 28  	    , NVL(otr.label_text, lbl.label_text_cap)	AS label_text_cap
 29  	    , NVL(otr.label_text, lbl.label_text_upper) AS label_text_upper
 30  	    , label_source
 31  	    , label_type
 32  	    , label_translatable
 33  	    , from_config
 34  	 FROM lbl
 35  	 LEFT OUTER JOIN otap_translate otr
 36  	   ON lbl.otap_identifier = otr.otap_identifier
 37  	  AND otr.language_id	  = otap_constants.get_otap_internal_na
 38  ;

