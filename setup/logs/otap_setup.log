899    FUNCTION has_procedure( p_procedure_name  IN	       VARCHAR2
900  			     , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
901  			     , p_schema 	 IN	       VARCHAR2      DEFAULT NULL
902  			     , p_description	 IN	       VARCHAR2      DEFAULT NULL
903  			     , p_procedure_type  IN	       VARCHAR2      DEFAULT 'FUNCTION'
904  			     , p_package_name	 IN	       VARCHAR2      DEFAULT NULL
905  			     , p_return_type	 IN	       VARCHAR2      DEFAULT NULL
906  			     , p_expected_result IN	       NUMBER	     DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
907  			     )
908  	 RETURN VARCHAR2
909    IS
910  	 l_script	    VARCHAR2(1024 CHAR) 		 := 'otap_api.has_procedure';
911  	 l_start	    TIMESTAMP;
912  	 l_result	    INTEGER;
913  	 l_return	    VARCHAR2(4000 CHAR);
914  	 l_errors	    otap_results.test_errors%TYPE;
915  	 l_schema	    otap_results.db_schema%TYPE;
916  	 l_desc 	    otap_results.test_desc%TYPE;
917  	 l_tmp_otap_session OTAP_SESSION;
918    BEGIN
919  	 l_start  := SYSTIMESTAMP;
920  	 -- default return
921  	 l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED) || ' ' || otap_constants.OTAP_INTERNAL_NA;
922  	 -- own begin-end for the transaction after the function
923  	 BEGIN
924  	   -- own begin-end block for the function itself and prepare
925  	   BEGIN
926  	     l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
927  	     -- TODO get_label in otap_util only labels compared with value, search always upper as stored in db
928  	     l_desc   := otap_string.reduce( otap_report.get_exists_msg( p_object_name => NVL(p_package_name, p_procedure_name)
929  								       , p_schema_name => l_schema
930  								       , p_object_type => otap_util.get_label_id(p_procedure_type)
931  								       , p_sub_object => CASE WHEN p_package_name IS NOT NULL THEN p_procedure_name ELSE NULL END
932  								       , p_desc => p_description
933  								       )
934  					   , 256
935  					   )
936  	     ;
937  	     -- call function
938  	     l_result := otap_schema.has_procedure( p_procedure_name
939  						  , l_errors
940  						  , l_schema
941  						  , p_procedure_type
942  						  , p_package_name
943  						  , p_return_type
944  						  , p_expected_result
945  						  )
946  	     ;
947  	   EXCEPTION
948  	     WHEN OTHERS THEN
949  	     -- consume error
950  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
951  	     l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
952  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
953  	   END;
954  	   -- write result
955  	   l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
956  	 EXCEPTION
957  	   WHEN OTHERS THEN
958  	     -- consume error
959  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
960  	     l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
961  	     otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
962  	     -- try again
963  	     l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
964  	 END;
965  	 -- return result or let exception happen
966  	 RETURN l_return;
967    END has_procedure;
