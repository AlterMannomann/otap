464  
465    FUNCTION otap_session_summary(p_otap_session IN OTAP_SESSION)
466  	 RETURN VARCHAR2
467    IS
468  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_summary';
469  	 l_message VARCHAR2(4000);
470    BEGIN
471  	 otap_objects.otap_session_verify(p_otap_session);
472  	 l_message := 'Summary id: ' || TRIM(TO_CHAR(p_otap_session.session_id)) ||
473  		      ' tests: ' || TRIM(TO_CHAR(p_otap_session.test_count)) ||
474  		      CASE WHEN p_otap_session.intended_count > 0 THEN ' from ' || TRIM(TO_CHAR(p_otap_session.intended_count)) END ||
475  		      ' errors: ' || TRIM(TO_CHAR(p_otap_session.error_count)) ||
476  		      ' run time: ' || TRIM(TO_CHAR(((SYSDATE - p_otap_session.session_start) DAY TO SECOND))) ||
477  		      ' started: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
478  	 ;
479  	 RETURN l_message;
480    EXCEPTION
481  	 WHEN OTHERS THEN
482  	   IF SQLCODE != -20099
483  	   THEN
484  	     -- log unhandled exceptions
485  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
486  	   END IF;
487  	   RAISE;
488    END otap_session_summary;
489  
490    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
491  	 RETURN VARCHAR2
492    IS
493  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_finish';
494  	 l_message VARCHAR2(4000);
495    BEGIN
496  	 -- object gets verified by summary for old session
497  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_LF;
498  	 -- reset values
499  	 o_otap_session.test_count     := 0;
500  	 o_otap_session.error_count    := 0;
501  	 o_otap_session.intended_count := 0;
502  	 o_otap_session.test_set       := otap_constants.OTAP_DEFAULT_TEST_SET;
503  	 o_otap_session.test_group     := otap_constants.OTAP_DEFAULT_TEST_GROUP;
504  	 o_otap_session.test_name      := otap_constants.OTAP_DEFAULT_TEST_NAME;
505  	 o_otap_session.session_start  := SYSDATE;
506  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
507  	 -- do not update the session_view_id so it will keep the old or any set value
508  	 -- every init will set the session_view_id to the current session id
509  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
510  	 RETURN l_message;
511    EXCEPTION
512  	 WHEN OTHERS THEN
513  	   IF SQLCODE != -20099
514  	   THEN
515  	     -- log unhandled exceptions
516  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
517  	   END IF;
518  	   RAISE;
519    END otap_session_finish;
520  
521  END;
522  /

