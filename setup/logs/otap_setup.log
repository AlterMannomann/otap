132  			       , otap_util.CFG_TEMPLATE_ERROR_DETAILS
133  			       , otap_util.CFG_TEMPLATE_EXISTS
134  			       , otap_util.CFG_TEMPLATE_EXISTSX
135  			       , otap_util.CFG_TEMPLATE_EXISTS_C
