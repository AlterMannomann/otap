285    FUNCTION get_config_value(p_config_name IN VARCHAR2)
286  	 RETURN VARCHAR2
287    IS
288  	 l_script      VARCHAR2(1024 CHAR)	      := 'otap_util.get_config_value';
289  	 l_return      otap_config.config_value%TYPE;
290  	 l_has_config  INTEGER;
291  	 l_has_label   INTEGER;
292  	 l_label_col   VARCHAR2(1 CHAR);
293    BEGIN
294  	 l_return := otap_constants.OTAP_INTERNAL_ERROR;
295  	 SELECT COUNT(*)
296  	   INTO l_has_config
297  	   FROM otap_identifiers_v
298  	  WHERE otap_identifier = UPPER(p_config_name)
299  	 ;
300  	 SELECT COUNT(*)
301  	   INTO l_has_label
302  	   FROM otap_config
303  	  WHERE config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
304  	 ;
305  	 IF l_has_label = 1
306  	 THEN
307  	   SELECT config_value
308  	     INTO l_label_col
309  	     FROM otap_config
310  	    WHERE config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
311  	   ;
312  	   l_label_col := NVL(l_label_col, otap_constants.OTAP_LABEL_LOWER);
313  	 ELSE
314  	   l_label_col := otap_constants.OTAP_LABEL_LOWER;
315  	 END IF;
316  	 IF l_has_config = 1
317  	 THEN
318  	   SELECT CASE l_label_col
319  		    WHEN otap_constants.OTAP_LABEL_LOWER
320  		    THEN label_text_lower
321  		    WHEN otap_constants.OTAP_LABEL_INIT_CAP
322  		    THEN label_text_cap
323  		    WHEN otap_constants.OTAP_LABEL_UPPER
324  		    THEN label_text_upper
325  		    ELSE label_text_lower
326  		  END
327  	     INTO l_return
328  	     FROM otap_identifiers_v
329  	   WHERE otap_identifier = UPPER(p_config_name)
330  	   ;
331  	 ELSE
332  	   l_return := otap_constants.OTAP_INTERNAL_ERROR;
333  	   otap_log.log('Invalid config_name: ' || UPPER(p_config_name) || ' return error identifier. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name)');
334  	 END IF;
335  	 RETURN l_return;
336    EXCEPTION
337  	 WHEN OTHERS THEN
338  	   otap_log.log(SQLERRM, l_script, 'SELECT config_value INTO l_return FROM otap_config WHERE config_name = UPPER(p_config_name)');
339  	   RAISE;
340    END get_config_value;
341  
342    FUNCTION get_config_number(p_config_name IN VARCHAR2)
343  	 RETURN NUMBER
344    IS
345  	 l_script      VARCHAR2(1024 CHAR)	       := 'otap_util.get_config_number';
346  	 l_varchar     otap_config.config_value%TYPE;
347  	 l_return      INTEGER; -- only integer in configuration
348  	 l_has_config  INTEGER;
349    BEGIN
350  	 l_return := NULL;
351  	 SELECT COUNT(*)
352  	   INTO l_has_config
353  	   FROM otap_config
354  	  WHERE config_name = UPPER(p_config_name)
355  	    AND config_type = 'NUMBER'
356  	 ;
357  	 IF l_has_config = 1
358  	 THEN
359  	   l_varchar := otap_util.get_config_value(p_config_name);
360  	   IF otap_util.is_integer(l_varchar)
361  	   THEN
362  	     l_return := TO_NUMBER(l_varchar);
363  	   ELSE
364  	     l_return := NULL;
365  	     otap_log.log('Invalid numeric value for config_name: ' || UPPER(p_config_name) || ' return NULL. Value: ' || l_varchar, l_script, 'otap_util.is_integer(l_varchar)');
366  	   END IF;
367  	 ELSE
368  	   l_return := NULL;
369  	   otap_log.log('Invalid numeric config_name: ' || UPPER(p_config_name) || ' return NULL. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name) AND config_type = ''NUMBER''');
370  	 END IF;
371  	 RETURN l_return;
372    EXCEPTION
373  	 WHEN OTHERS THEN
374  	   otap_log.log(SQLERRM, l_script);
375  	   RAISE;
376    END get_config_number;
