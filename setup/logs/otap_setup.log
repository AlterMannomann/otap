687    /** FUNCTION otap_test.is_eq
688    * Checks given data of type VARCHAR2, NUMBER and DATE against a given value. As "IS" is a reserved word in Oracle
689    * this is the equivalent of is and isnt. isnt is achieved by setting expected result to otap_constants.OTAP_NUM_TEST_FAILED.
690    *
691    * Other types are more or less problematic, e.g. you can't declare in Oracle a function with date and timestamp parameter. If providing
692    * TIMESTAMP Oracle gets confused which function to use. Try to convert or cast the types to the base types. CAST will probably not
693    * preserve all information. TO_CHAR is almost always an option.
694    *
695    * Passing simply NULL, NULL without that datatypes are defined by columns, the function will fail with ORA-06553: Too much declarations
696    * of is_eq. To do a NULL test, use, according to p_have datatype, TO_CHAR(NULL), TO_NUMBER(NULL) or TO_DATE(NULL) so correct function
697    * signature is identified and function does not fail.
698    *
699    * @param p_have The data to check.
700    * @param p_want The expected data. Must have the same datatype as p_have.
701    * @param p_description The test description if any. If not given, a description is generated, see template.
702    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
703    * @param p_schema A schema override of the current test session if needed, taken as is. Compares are not clearly associated to a schema. Case sensitive.
704    *
705    * @return The test result as text.
706    */
707    FUNCTION is_eq( p_have		 IN VARCHAR2
708  		     , p_want		 IN VARCHAR2
709  		     , p_description	 IN VARCHAR2 DEFAULT NULL
710  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
711  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
712  		     )
713  	 RETURN VARCHAR2
714    ;
715    FUNCTION is_eq( p_have		 IN NUMBER
716  		     , p_want		 IN NUMBER
717  		     , p_description	 IN VARCHAR2 DEFAULT NULL
718  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
719  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
720  		     )
721  	 RETURN VARCHAR2
722    ;
723    FUNCTION is_eq( p_have		 IN DATE
724  		     , p_want		 IN DATE
725  		     , p_description	 IN VARCHAR2 DEFAULT NULL
726  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
727  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
728  		     )
