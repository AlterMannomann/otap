  5    IF l_count = 0
  6    THEN
  7  	 -- install job
  8  	 DBMS_SCHEDULER.CREATE_JOB( job_name => 'OTAP_MAINTENANCE'
  9  				  , job_type => 'PLSQL_BLOCK'
 10  				  , job_action => 'otap_util.result_cleanup;'
 11  				  , repeat_interval => 'FREQ=WEEKLY;BYTIME=230000;BYDAY=MON,TUE,WED,THU,FRI'
 12  				  , enabled => FALSE
 13  				  , auto_drop => FALSE
 14  				  , comments => 'otap test result cleanup'
 15  				  )
 16  	 ;
 17  	 DBMS_SCHEDULER.SET_ATTRIBUTE( name => 'OTAP_MAINTENANCE'
 18  				     , attribute => 'store_output'
 19  				     , value => TRUE
 20  				     )
 21  	 ;
 22  	 DBMS_SCHEDULER.SET_ATTRIBUTE( name => 'OTAP_MAINTENANCE'
 23  				     , attribute => 'logging_level'
 24  				     , value => DBMS_SCHEDULER.LOGGING_FULL
 25  				     )
 26  	 ;
 27  	 DBMS_SCHEDULER.enable(name => 'OTAP_MAINTENANCE');
 28  	 DBMS_OUTPUT.PUT_LINE('Created and enabled job OTAP_MAINTENANCE');
 29    ELSE
 30  	 -- inform that job exists
 31  	 DBMS_OUTPUT.PUT_LINE('WARNING Job OTAP_MAINTENANCE already exists, do nothing');
