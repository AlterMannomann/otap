152    /** PROCEDURE otap_objects.otap_session_add_test
153    * Adds a test run to the OTAP_SESSION object. If the test is not passed, raises
154    * the error count for this test session.
155    *
156    * @param p_test_passed The test state as defined in otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED and otap_constants.OTAP_NUM_TEST_UNDEFINED.
157    * @param o_otap_session The current session_record from OTAP_TEST package.
158    *
159    * @exception -20099 Internal error, invalid OTAP_SESSION object.
160    */
161    PROCEDURE otap_session_add_test( p_test_passed  IN	     NUMBER
162  				      , o_otap_session IN OUT NOCOPY OTAP_SESSION
163  				      )
164    ;
