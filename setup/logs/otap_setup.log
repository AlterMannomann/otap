SQL> CREATE OR REPLACE PACKAGE otap_constants
  2  AS
  3    /**
  4    * This package contains all constants needed by otap. Every constant can be accessed via PL/SQL or as a get function.
  5    * This package is available to the otap user role defined in otap_setup_def.sql.
  6    */
  7  
  8    /*====================================== start package constants used by otap ======================================*/
  9    -- we do not know the size of the setup configuration variable, this can be used as a string size attack, package will
 10    -- fail being created. otap can't handle this, must rely on Oracle (hard to believe). Nevertheless names currently
 11    -- (until Oracle 23i) are limited to 128 chars, if not using special UTF chars.
 12    OTAP_USER_ROLE		   CONSTANT VARCHAR2(256)  := '&OTAP_ROLE';
 13    OTAP_SCHEMA		   CONSTANT VARCHAR2(256)  := '&OTAP_USER';
 14    OTAP_TABLESPACE		   CONSTANT VARCHAR2(256)  := '&OTAP_TABLESPACE';
 15    OTAP_NUM_TRUE		   CONSTANT INTEGER	   := 1;
 16    OTAP_NUM_FALSE		   CONSTANT INTEGER	   := 0;
 17    OTAP_CHAR_TRUE		   CONSTANT CHAR(4)	   := 'true';
 18    OTAP_CHAR_FALSE		   CONSTANT CHAR(5)	   := 'false';
 19    OTAP_CHAR_TRUE_YES	   CONSTANT CHAR(3)	   := 'Yes';
 20    OTAP_CHAR_FALSE_NO	   CONSTANT CHAR(2)	   := 'No';
 21    OTAP_NUM_TEST_PASSED	   CONSTANT INTEGER	   := 1;
 22    OTAP_NUM_TEST_FAILED	   CONSTANT INTEGER	   := -1;
 23    OTAP_NUM_TEST_UNDEFINED	   CONSTANT INTEGER	   := 0;
 24    OTAP_CHAR_TEST_PASSED	   CONSTANT CHAR(6)	   := 'Passed';
 25    OTAP_CHAR_TEST_FAILED	   CONSTANT CHAR(6)	   := 'Failed';
 26    OTAP_CHAR_TEST_UNDEFINED    CONSTANT CHAR(9)	   := 'Undefined';
 27    OTAP_LF			   CONSTANT CHAR(1)	   := CHR(10);
 28    OTAP_CFG_DEBUG_MODE	   CONSTANT CHAR(10)	   := 'DEBUG_MODE';
 29    OTAP_CFG_PRESERVE_DAYS	   CONSTANT CHAR(13)	   := 'PRESERVE_DAYS';
 30    OTAP_CFG_DELETE_DELAY	   CONSTANT CHAR(12)	   := 'DELETE_DELAY';
 31    OTAP_CFG_DELETE_BATCH_SIZE  CONSTANT CHAR(17)	   := 'DELETE_BATCH_SIZE';
 32    OTAP_DEFAULT_PREFIX	   CONSTANT CHAR(4)	   := 'TEST';
 33    -- default name delimiter, $ and # are not recommended by Oracle and therefore not used
 34    OTAP_DEFAULT_DELIMITER	   CONSTANT CHAR(1)	   := '_';
 35    OTAP_DEFAULT_TEST_SET	   CONSTANT CHAR(21)	   := 'otap GENERIC test set';
 36    OTAP_DEFAULT_TEST_GROUP	   CONSTANT CHAR(23)	   := 'otap DEFAULT test group';
 37    OTAP_DEFAULT_TEST_NAME	   CONSTANT CHAR(14)	   := 'Anonymous test';
 38    /*====================================== end package constants used by otap ======================================*/
