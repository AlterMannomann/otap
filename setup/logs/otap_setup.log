939    *
940    * @return Always an otap_constants.OTAP_NUM_TEST_UNDEFINED result message using the description given.
941    */
942    FUNCTION test_error( p_description IN VARCHAR2
943  			  , p_errors	  IN VARCHAR2
944  			  , p_schema	  IN VARCHAR2 DEFAULT NULL
945  			  )
946  	 RETURN VARCHAR2
947    ;
