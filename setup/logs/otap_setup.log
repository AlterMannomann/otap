SQL> CREATE OR REPLACE TRIGGER otap_config_upd_trg
  2    BEFORE UPDATE ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  , 'FORMAT_HEADER_CHAR'
 13  				  , 'FORMAT_SET_CHAR'
 14  				  , 'FORMAT_GROUP_CHAR'
 15  				  , 'FORMAT_NAME_CHAR'
 16  				  , 'TEXT_TRUE'
 17  				  , 'TEXT_FALSE'
 18  				  , 'TEXT_TRUE_YES'
 19  				  , 'TEXT_FALSE_NO'
 20  				  , 'TEXT_TEST_PASSED'
 21  				  , 'TEXT_TEST_FAILED'
 22  				  , 'TEXT_TEST_UNDEFINED'
 23  				  , 'DEFAULT_PREFIX'
 24  				  , 'DEFAULT_TEST_SET'
 25  				  , 'DEFAULT_TEST_GROUP'
 26  				  , 'DEFAULT_TEST_NAME'
 27  				  , 'DEFAULT_LAYOUT'
 28  				  , 'DEFAULT_RESULT_LAYOUT'
 29  				  , 'DEFAULT_BORDER'
 30  				  , 'TEXT_REPORT_START'
 31  				  , 'TEXT_REPORT_TOTAL'
 32  				  , 'TEXT_REPORT_END'
 33  				  , 'TEXT_RESULT_HEADER'
 34  				  , 'FORMAT_RESULT_HEADER'
 35  				  , 'TEXT_TEST_COUNT_HEADER'
 36  				  , 'TEXT_TEST_COUNT_NAME'
 37  				  , 'TEXT_SUMMARY_SUCCESS'
 38  				  , 'TEXT_SUMMARY_ERROR'
 39  				  , 'SUMMARY_TEMPLATE'
 40  				  , 'ERRORS_TEMPLATE'
 41  				  , 'ERROR_DETAILS_TEMPLATE'
 42  				  , 'NO_DATA_TEMPLATE'
 43  				  , 'SESSION_ID_TEMPLATE'
 44  				  , 'SET_TEMPLATE'
 45  				  , 'GROUP_TEMPLATE'
 46  				  , 'TEST_NAME_TEMPLATE'
 47  				  , 'RESULT_LINE_TEMPLATE'
 48  				  , 'COUNT_DESC_TEMPLATE'
 49  				  , 'REPORT_TOTAL_TEMPLATE'
 50  				  , 'FN_HAS_TABLE_TEMPLATE'
 51  				  , 'FN_HAS_COLUMN_TEMPLATE'
 52  				  , 'FN_HAS_PACKAGE_TEMPLATE'
 53  				  , 'FN_HAS_PROCEDURE_TEMPLATE'
 54  				  , 'FN_HAS_TRIGGER_TEMPLATE'
 55  				  )
 56    THEN
 57  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 58    END IF;
 59    -- remove any leading and trailing blanks from config_value, do not accept NULLS, overwrite with OLD in this case
 60    :NEW.config_value := NVL(TRIM(:NEW.config_value), :OLD.config_value);
 61    -- ensure some values are not overwritten
 62    :NEW.created	   := :OLD.created;
 63    :NEW.created_by	   := :OLD.created_by;
 64    :NEW.created_by_os  := :OLD.created_by_os;
 65    -- check max length if defined
 66    IF :NEW.config_type = 'CHAR'
 67    THEN
 68  	 IF :NEW.config_max_length > 0
 69  	 THEN
 70  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 71  	   THEN
 72  	     RAISE_APPLICATION_ERROR(-20003, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 73  	   END IF;
 74  	 END IF;
 75    END IF;
 76    -- check number type
 77    IF :NEW.config_type = 'NUMBER'
 78    THEN
 79  	 l_ok := TRUE;
 80  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 81  	 BEGIN
 82  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 83  	 EXCEPTION
 84  	   WHEN OTHERS THEN
 85  	     l_ok := FALSE;
 86  	 END;
 87  	 IF NOT l_ok
 88  	 THEN
 89  	   RAISE_APPLICATION_ERROR(-20004, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 90  	 END IF;
 91    END IF;
 92    -- check range if value changed
 93    IF :NEW.config_value != :OLD.config_value
 94    THEN
 95  	 IF :NEW.config_name = 'PRESERVE_DAYS'
 96  	 THEN
 97  	   IF	 TO_NUMBER(:NEW.config_value) > 7
 98  	      OR TO_NUMBER(:NEW.config_value) < 1
 99  	   THEN
100  	     :NEW.config_value := '1';
101  	   END IF;
102  	 END IF;
103  	 IF :NEW.config_name = 'DELETE_DELAY'
104  	 THEN
105  	   IF	 TO_NUMBER(:NEW.config_value) > 600
106  	      OR TO_NUMBER(:NEW.config_value) < 1
107  	   THEN
108  	     :NEW.config_value := '10';
109  	   END IF;
110  	 END IF;
111  	 IF :NEW.config_name = 'DELETE_BATCH_SIZE'
112  	 THEN
113  	   IF	 TO_NUMBER(:NEW.config_value) > 10000
114  	      OR TO_NUMBER(:NEW.config_value) < 100
115  	   THEN
116  	     :NEW.config_value := '1000';
117  	   END IF;
118  	 END IF;
119  	 IF :NEW.config_name = 'DEBUG_MODE'
120  	 THEN
121  	   IF TO_NUMBER(:NEW.config_value) NOT IN (0, 1)
122  	   THEN
123  	     :NEW.config_value := '0';
124  	   END IF;
125  	 END IF;
126  	 IF :NEW.config_name = 'DEFAULT_PREFIX'
127  	 THEN
128  	   IF INSTR(:NEW.config_value, '_') > 0
129  	   THEN
130  	     -- do not change if prefix contains invalid char
131  	     :NEW.config_value := :OLD.config_value;
132  	   END IF;
133  	 END IF;
134  	 -- check layout options
135  	 IF    :NEW.config_name = 'DEFAULT_LAYOUT'
136  	   AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
137  	 THEN
138  	   :NEW.config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
139  	 END IF;
140  	 IF	:NEW.config_name = 'DEFAULT_RESULT_LAYOUT'
141  	    AND :NEW.config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
142  	 THEN
143  	   :NEW.config_value := otap_constants.OTAP_LAYOUT_LEFT;
144  	 END IF;
145  	 -- check border options
146  	  IF	 :NEW.config_name = 'DEFAULT_BORDER'
147  	     AND (   TO_NUMBER(:NEW.config_value) < 2
148  		  OR TO_NUMBER(:NEW.config_value) > 10
149  		 )
150  	 THEN
151  	   :NEW.config_value := otap_constants.OTAP_BORDER_DEFAULT;
152  	 END IF;
153    END IF;
154  END;
155  /

