113    * @exception -20099 Internal error, invalid OTAP_SESSION object.
114    */
115    FUNCTION otap_session_set_test_group( p_test_group   IN		  VARCHAR2
116  					   , o_otap_session IN OUT NOCOPY OTAP_SESSION
117  					   )
118  	 RETURN VARCHAR2
