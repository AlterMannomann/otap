SQL> @@../otap_ddl/packages/otap_results_util.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_results_util
  2  AS
  3    -- for description see header file
  4  
  5    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
  6  				  , p_test_passed	IN NUMBER
  7  				  , p_test_session_id	IN NUMBER
  8  				  , p_test_executor	IN VARCHAR2
  9  				  , p_test_set		IN VARCHAR2
 10  				  , p_db_user		IN VARCHAR2
 11  				  , p_db_schema 	IN VARCHAR2
 12  				  , p_test_group	IN VARCHAR2
 13  				  , p_test_start	IN TIMESTAMP
 14  				  , p_test_end		IN TIMESTAMP
 15  				  , p_test_name 	IN VARCHAR2
 16  				  , p_test_desc 	IN VARCHAR2
 17  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
 18  				  )
 19    IS
 20  	 PRAGMA AUTONOMOUS_TRANSACTION;
 21  	 l_script      VARCHAR2(256) := 'otap_results_util.write_test_result';
 22  	 l_to_delete   NUMBER;
 23  	 l_test_passed NUMBER;
 24    BEGIN
 25  	 l_to_delete   := CASE
 26  			    WHEN p_to_delete IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
 27  			    THEN p_to_delete
 28  			    ELSE otap_constants.OTAP_NUM_TRUE
 29  			  END
 30  	 ;
 31  	 l_test_passed := CASE
 32  			    WHEN p_test_passed IN (otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 33  			    THEN p_test_passed
 34  			    ELSE otap_constants.OTAP_NUM_TEST_UNDEFINED
 35  			  END
 36  	 ;
 37  	 INSERT INTO otap_results
 38  	   ( to_delete
 39  	   , test_passed
 40  	   , test_session_id
 41  	   , test_executor
 42  	   , test_set
 43  	   , db_user
 44  	   , db_schema
 45  	   , test_group
 46  	   , test_start
 47  	   , test_end
 48  	   , test_name
 49  	   , test_desc
 50  	   , test_errors
 51  	   ) VALUES ( l_to_delete
 52  		    , l_test_passed
 53  		    , p_test_session_id
 54  		    , p_test_executor
 55  		    , p_test_set
 56  		    , p_db_user
 57  		    , p_db_schema
 58  		    , p_test_group
 59  		    , p_test_start
 60  		    , p_test_end
 61  		    , p_test_name
 62  		    , p_test_desc
 63  		    , p_test_errors
 64  		    )
 65  	 ;
 66  	 COMMIT;
 67    EXCEPTION
 68  	 WHEN OTHERS THEN
 69  	   otap_log.log(SQLERRM, l_script, 'INSERT into otap_results');
 70  	   RAISE;
 71    END write_test_result;
 72  
 73    PROCEDURE result_cleanup
 74    IS
 75  	 PRAGMA AUTONOMOUS_TRANSACTION;
 76  	 l_script	     VARCHAR2(256) := 'otap_results_util.result_cleanup';
 77  	 l_delete_before     DATE;
 78  	 l_delete_start      DATE;
 79  	 l_delete_batch_size NUMBER;
 80  	 l_delete_delay      NUMBER;
 81  	 l_row_counter	     NUMBER;
 82  	 l_processed	     NUMBER;
 83  	 l_delete_msg	     VARCHAR2(32767);
 84  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
 85  	 IS
 86  	   SELECT *
 87  	     FROM otap_results
 88  	    WHERE test_run_date < cp_delete_before
 89  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
 90  	 ;
 91    BEGIN
 92  	 -- read config values before starting, values will not change until finished
 93  	 l_delete_start      := SYSDATE;
 94  	 l_delete_before     := TRUNC(SYSDATE - otap_config_util.preserve_days);
 95  	 l_delete_batch_size := otap_config_util.delete_batch_size;
 96  	 l_delete_delay      := otap_config_util.delete_delay;
 97  	 l_row_counter	     := 0;
 98  	 l_processed	     := 0;
 99  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
100  	 otap_log.log(l_delete_msg, l_script, 'Procedure start', 'OTAP_DEBUG');
101  	 FOR rec IN cur_delete_tests(l_delete_before)
102  	 LOOP
103  	   IF l_row_counter >= l_delete_batch_size
104  	   THEN
105  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
106  	     otap_log.log(l_delete_msg, l_script, 'Batch size reached and wait', 'OTAP_DEBUG');
107  	     -- commit the batch
108  	     COMMIT;
109  	     -- reset counter
110  	     l_row_counter := 0;
111  	     -- wait defined time
112  	     DBMS_SESSION.SLEEP(l_delete_delay);
113  	   END IF;
114  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
115  	   l_row_counter := l_row_counter + 1;
116  	   l_processed	 := l_processed + 1;
117  	 END LOOP;
118  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
119  	 otap_log.log(l_delete_msg, l_script, 'Procedure end', 'OTAP_DEBUG');
120  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
121    EXCEPTION
122  	 WHEN OTHERS THEN
123  	   otap_log.log(SQLERRM, l_script, 'DELETE FROM otap_results');
124    END result_cleanup;
125  
126    FUNCTION max_text_size(p_session_id IN NUMBER)
127  	 RETURN NUMBER
128    IS
129  	 l_result NUMBER;
130    BEGIN
131  	 -- use UNION not GREATEST to get a result in any case
132  	 SELECT MAX(str_length) AS max_length
133  	   INTO l_result
134  	   FROM (SELECT otap_constants.get_otap_report_min_fill_length AS str_length FROM dual
135  		  UNION ALL
136  		 SELECT MAX(LENGTH(test_set)) FROM otap_results WHERE test_session_id = 1
137  		  UNION ALL
138  		 SELECT MAX(LENGTH(test_group)) FROM otap_results WHERE test_session_id = 1
139  		  UNION ALL
140  		 SELECT MAX(LENGTH(test_name)) FROM otap_results WHERE test_session_id = 1
141  		  UNION ALL
142  		 SELECT MAX(LENGTH(test_desc)) FROM otap_results WHERE test_session_id = 1
143  		)
144  	 ;
145  	 RETURN l_result;
146    EXCEPTION
147  	 WHEN OTHERS THEN
148  	   otap_log.log(SQLERRM, 'otap_results_util.max_text_size', 'Get max text size for a given session id');
149  	   RAISE;
150    END max_text_size;
151  
152  END;
153  /

