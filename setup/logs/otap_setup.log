160    FUNCTION check_decoration(p_decoration IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR)
161  	 RETURN VARCHAR2
162    IS
163  	 l_script     VARCHAR2(256 CHAR) := 'otap_string.check_decoration';
164  	 l_decoration VARCHAR2(1 CHAR);
165    BEGIN
166  	 l_decoration := SUBSTR(NVL(p_decoration, otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR), 1, 1);
167  	 RETURN l_decoration;
168    EXCEPTION
