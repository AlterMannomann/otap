684    FUNCTION constraint_type_to_label(p_constraint_type IN VARCHAR2 DEFAULT 'C')
685  	 RETURN VARCHAR2
686    IS
687  	 l_label VARCHAR2(128 CHAR);
688    BEGIN
689  	 l_label := CASE UPPER(p_constraint_type)
690  		      WHEN 'P'
691  		      THEN otap_util.CFG_LABEL_PRIMARY_KEY
692  		      WHEN 'U'
693  		      THEN otap_util.CFG_LABEL_UNIQUE_KEY
694  		      WHEN 'R'
695  		      THEN otap_util.CFG_LABEL_FOREIGN_KEY
696  		      WHEN 'V'
697  		      THEN otap_util.CFG_LABEL_VIEW_CHECK
698  		      WHEN 'O'
699  		      THEN otap_util.CFG_LABEL_VIEW_READONLY
700  		      WHEN 'F'
701  		      THEN otap_util.CFG_LABEL_REF_COLUMN
702  		      WHEN 'H'
703  		      THEN otap_util.CFG_LABEL_HASH
704  		      WHEN 'S'
705  		      THEN otap_util.CFG_LABEL_SUPPLEMENTAL_LOGGGING
706  		      WHEN 'C'
707  		      THEN otap_util.CFG_LABEL_CHECK
708  		      ELSE NULL
709  		    END
710  	 ;
711  	 IF l_label IS NULL
712  	 THEN
713  	   -- log error
714  	   otap_log.log('Invalid constraint type: ' || NVL(p_constraint_type, 'NULL'), 'otap_util.constraint_type_to_label');
715  	   l_label := otap_util.CFG_LABEL_INVALID_CONSTRAINT_TYPE;
716  	 END IF;
717  	 RETURN l_label;
718    EXCEPTION
719  	 WHEN OTHERS THEN
720  	   otap_log.log(SQLERRM, 'otap_util.constraint_type_to_label', 'Translate constraint type to label id');
721  	   RAISE;
722    END constraint_type_to_label;
