SQL> DEFINE OTAP_USER="OTAP"
SQL> DEFINE OTAP_TABLESPACE="OTAP_TABLESPACE"
SQL> DEFINE OTAP_ROLE="OTAP_USER"
SQL> DEFINE ROLE_CREATOR="SYS"
SQL> 
SQL> CREATE OR REPLACE PACKAGE otap_constants
  2  AS
  3    /**
  4    * This package contains all application wide constants needed by otap. Every constant can be accessed via PL/SQL.
  5    * Some constants provide a get function for use in SQL statements.
  6    * This package is available to the otap user role defined in otap_setup_def.sql.
  7    */
  8  
  9    /*====================================== start package constants used by otap ======================================*/
 10  
 11    -- the following constants have get functions that can be used in SQL selects
 12    OTAP_INTERNAL_VERSION_NR CONSTANT CHAR(13)	     := 'v1.0.0-beta.1';
 13    OTAP_INTERNAL_NAME	CONSTANT CHAR(38)	     := 'otap - Oracle Test Automation Protocol';
 14    OTAP_INTERNAL_COPYRIGHT1 CONSTANT CHAR(80)	     := '(C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
 15    OTAP_INTERNAL_COPYRIGHT2 CONSTANT CHAR(54)	     := 'and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
 16    OTAP_INTERNAL_COPYRIGHT3 CONSTANT CHAR(76)	     := 'Not allowed to be used as AI training material without explicite permission.';
 17    -- we do not know the size of the setup configuration variable, this can be used as a string size attack, package will
 18    -- fail being created. otap can't handle this, must rely on Oracle (hard to believe). Nevertheless names currently
 19    -- (until Oracle 23i) are limited to 128 chars.
 20    OTAP_INTERNAL_USER_ROLE	CONSTANT VARCHAR2(128 CHAR)  := '&OTAP_ROLE';
 21    OTAP_INTERNAL_SCHEMA	CONSTANT VARCHAR2(128 CHAR)  := '&OTAP_USER';
 22    OTAP_INTERNAL_TABLESPACE CONSTANT VARCHAR2(128 CHAR)  := '&OTAP_TABLESPACE';
 23    OTAP_NUM_TRUE		CONSTANT INTEGER	     := 1;
 24    OTAP_NUM_FALSE		CONSTANT INTEGER	     := 0;
 25    OTAP_NUM_TEST_PASSED	CONSTANT INTEGER	     := 1;
 26    OTAP_NUM_TEST_FAILED	CONSTANT INTEGER	     := -1;
 27    OTAP_NUM_TEST_UNDEFINED	CONSTANT INTEGER	     := 0;
 28    OTAP_NUM_MIN_FILL_LENGTH CONSTANT INTEGER	     := 80;
 29    OTAP_NUM_MAX_FILL_LENGTH CONSTANT INTEGER	     := 4000;
 30    -- default fix name delimiter, $ and # are not recommended by Oracle and therefore not configurable
 31    OTAP_INTERNAL_DELIMITER	CONSTANT CHAR(1)	     := '_';
 32    OTAP_INTERNAL_ERROR	CONSTANT CHAR(10)	     := 'OTAP_ERROR';
 33    OTAP_INTERNAL_WARNING	CONSTANT CHAR(12)	     := 'OTAP_WARNING';
 34    OTAP_INTERNAL_NA 	CONSTANT CHAR(3)	     := 'N/A';
 35    OTAP_INTERNAL_VAR	CONSTANT CHAR(1)	     := '@';
 36    OTAP_CONFIG_TYPE_NUMBER	CONSTANT CHAR(6)	     := 'NUMBER';
 37    OTAP_CONFIG_TYPE_CHAR	CONSTANT CHAR(4)	     := 'CHAR';
 38    -- no get functions for the following constants
 39    -- internal otap constants only usable within PLSQL
 40    OTAP_INTERNAL_LF 		   CONSTANT CHAR(1)	   := CHR(10);
 41    OTAP_TEST_LANGUAGE_ID		   CONSTANT CHAR(3)	   := 'T$O';
 42    OTAP_NUM_PREFIX_MAX_SIZE 	   CONSTANT INTEGER	   := 4;
 43    OTAP_LAYOUT_RIGHT		   CONSTANT CHAR(1)	   := 'R';
 44    OTAP_LAYOUT_MIDDLE		   CONSTANT CHAR(1)	   := 'M';
 45    OTAP_LAYOUT_LEFT 		   CONSTANT CHAR(1)	   := 'L';
 46    OTAP_LABEL_UPPER 		   CONSTANT CHAR(1)	   := 'U';
 47    OTAP_LABEL_LOWER 		   CONSTANT CHAR(1)	   := 'L';
 48    OTAP_LABEL_INIT_CAP		   CONSTANT CHAR(1)	   := 'I';
 49    OTAP_TYPE_VAR			   CONSTANT CHAR(6)	   := '@type@';
 50    OTAP_GEN_TYPE_SCRIPT		   CONSTANT CHAR(1)	   := 'S';
 51    OTAP_GEN_TYPE_FUNCTION		   CONSTANT CHAR(1)	   := 'F';
 52    OTAP_GEN_TYPE_PROCEDURE		   CONSTANT CHAR(1)	   := 'P';
 53    -- predefined language id only for testing
 54  
 55    -- otap log needs to know the debug mode access name, therefore in otap_constants, other access identifiers are in otap_util
 56    OTAP_CFG_DEBUG_MODE		   CONSTANT CHAR(10)	   := 'DEBUG_MODE';
 57    -- fallback constants for access failure situations, defaults and checks
 58    OTAP_FALLBACK_BORDER		   CONSTANT INTEGER	   := 5;
 59    OTAP_FALLBACK_BORDER_MIN 	   CONSTANT INTEGER	   := 2;
 60    OTAP_FALLBACK_BORDER_MAX 	   CONSTANT INTEGER	   := 10;
 61    OTAP_FALLBACK_PRESERVE_DAYS	   CONSTANT INTEGER	   := 1;
 62    OTAP_FALLBACK_PRESERVE_DAYS_MIN	   CONSTANT INTEGER	   := 1;
 63    OTAP_FALLBACK_PRESERVE_DAYS_MAX	   CONSTANT INTEGER	   := 7;
 64    OTAP_FALLBACK_DELETE_DELAY	   CONSTANT INTEGER	   := 10;
 65    OTAP_FALLBACK_DELETE_DELAY_MIN	   CONSTANT INTEGER	   := 1;
 66    OTAP_FALLBACK_DELETE_DELAY_MAX	   CONSTANT INTEGER	   := 600;
 67    OTAP_FALLBACK_DELETE_BATCH_SIZE	   CONSTANT INTEGER	   := 1000;
 68    OTAP_FALLBACK_DELETE_BATCH_SIZE_MIN CONSTANT INTEGER	   := 100;
 69    OTAP_FALLBACK_DELETE_BATCH_SIZE_MAX CONSTANT INTEGER	   := 10000;
 70    OTAP_FALLBACK_FORMAT_HEADER_CHAR    CONSTANT CHAR(1)	   := '=';
 71    OTAP_FALLBACK_FORMAT_SET_CHAR	   CONSTANT CHAR(1)	   := '*';
 72    OTAP_FALLBACK_FORMAT_GROUP_CHAR	   CONSTANT CHAR(1)	   := '+';
 73    OTAP_FALLBACK_FORMAT_NAME_CHAR	   CONSTANT CHAR(1)	   := '-';
 74    OTAP_FALLBACK_TEXT_TRUE		   CONSTANT CHAR(4)	   := 'true';
 75    OTAP_FALLBACK_TEXT_FALSE 	   CONSTANT CHAR(5)	   := 'false';
 76    OTAP_FALLBACK_TEXT_TRUE_YES	   CONSTANT CHAR(3)	   := 'Yes';
 77    OTAP_FALLBACK_TEXT_FALSE_NO	   CONSTANT CHAR(2)	   := 'No';
 78    OTAP_FALLBACK_TEXT_TEST_PASSED	   CONSTANT CHAR(6)	   := 'Passed';
 79    OTAP_FALLBACK_TEXT_TEST_FAILED	   CONSTANT CHAR(6)	   := 'FAILED';
 80    OTAP_FALLBACK_TEXT_TEST_UNDEFINED   CONSTANT CHAR(9)	   := 'UNDEFINED';
 81    OTAP_FALLBACK_DEFAULT_PREFIX	   CONSTANT CHAR(4)	   := 'TEST';
 82    OTAP_FALLBACK_DEFAULT_TEST_SET	   CONSTANT CHAR(13)	   := 'OTAP test set';
 83    OTAP_FALLBACK_DEFAULT_TEST_GROUP    CONSTANT CHAR(15)	   := 'OTAP test group';
 84    OTAP_FALLBACK_DEFAULT_TEST_NAME	   CONSTANT CHAR(14)	   := 'OTAP test name';
 85    OTAP_FALLBACK_DEFAULT_LANGUAGE	   CONSTANT CHAR(3)	   := 'N/A';
 86    OTAP_FALLBACK_LAYOUT_DEFAULT	   CONSTANT CHAR(1)	   := 'M';
 87    OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT CONSTANT CHAR(1)	   := 'L';
 88    OTAP_FALLBACK_LABEL_DEFAULT	   CONSTANT CHAR(1)	   := 'L';
 89    /*====================================== end package constants used by otap ======================================*/
 90  
