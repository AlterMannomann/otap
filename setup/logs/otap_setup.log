281    FUNCTION test_result_to_text(p_test_passed IN NUMBER)
282  	 RETURN VARCHAR
283    IS
284  	 l_translation otap_config.config_value%TYPE;
285    BEGIN
286  	 l_translation := CASE p_test_passed
287  			    WHEN otap_constants.OTAP_NUM_TEST_PASSED
288  			    THEN otap_config_util.get_text_test_passed
289  			    WHEN otap_constants.OTAP_NUM_TEST_FAILED
290  			    THEN otap_config_util.get_text_test_failed
291  			    WHEN otap_constants.OTAP_NUM_TEST_UNDEFINED
292  			    THEN otap_config_util.get_text_test_undefined
293  			    ELSE otap_constants.OTAP_ERROR_IDENTIFIER
294  			  END
295  	 ;
296  	 RETURN l_translation;
297    EXCEPTION
298  	 WHEN OTHERS THEN
299  	   otap_log.log(SQLERRM, 'otap_config_util.test_result_to_text', 'Translate test state to text');
300  	   RAISE;
301    END test_result_to_text;
