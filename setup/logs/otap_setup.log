 89    OTAP_TEXT_FALSE			CONSTANT CHAR(5)	:= 'false';
 90    OTAP_TEXT_TRUE_YES		CONSTANT CHAR(3)	:= 'Yes';
 91    OTAP_TEXT_FALSE_NO		CONSTANT CHAR(2)	:= 'No';
 92    OTAP_TEXT_TEST_PASSED		CONSTANT CHAR(6)	:= 'Passed';
 93    OTAP_TEXT_TEST_FAILED		CONSTANT CHAR(6)	:= 'Failed';
 94    OTAP_TEXT_TEST_UNDEFINED 	CONSTANT CHAR(9)	:= 'Undefined';
