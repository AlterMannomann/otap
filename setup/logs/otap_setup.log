503    /** FUNCTION otap_test.is_eq
504    * Checks given data of type VARCHAR2, NUMBER and DATE against a given value. As "IS" is a reserved word in Oracle
505    * this is the equivalent of is and isnt. isnt is achieved by setting expected result to otap_constants.OTAP_NUM_TEST_FAILED.
506    *
507    * Other types are more or less problematic, e.g. you can't declare in Oracle a function with date and timestamp parameter. If providing
508    * TIMESTAMP Oracle gets confused which function to use. Try to convert or cast the types to the base types. CAST will probably not
509    * preserve all information. TO_CHAR is almost always an option.
510    *
511    * Passing simply NULL, NULL without that datatypes are defined by columns, the function will fail with ORA-06553: Too much declarations
512    * of is_eq. To do a NULL test, use, according to p_have datatype, TO_CHAR(NULL), TO_NUMBER(NULL) or TO_DATE(NULL) so correct function
513    * signature is identified and function does not fail.
514    *
515    * @param p_have The data to check.
516    * @param p_want The expected data. Must have the same datatype as p_have.
517    * @param p_description The test description if any. If not given, a description is generated, see template.
518    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
519    *
520    * @return The test result as text.
521    */
522    FUNCTION is_eq( p_have		 IN	VARCHAR2
523  		     , p_want		 IN	VARCHAR2
524  		     , p_description	 IN	VARCHAR2 DEFAULT NULL
525  		     , p_expected_result IN	NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
526  		     )
527  	 RETURN VARCHAR2
528    ;
529    FUNCTION is_eq( p_have		 IN	NUMBER
530  		     , p_want		 IN	NUMBER
531  		     , p_description	 IN	VARCHAR2 DEFAULT NULL
532  		     , p_expected_result IN	NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
533  		     )
534  	 RETURN VARCHAR2
535    ;
536    FUNCTION is_eq( p_have		 IN	DATE
537  		     , p_want		 IN	DATE
538  		     , p_description	 IN	VARCHAR2 DEFAULT NULL
539  		     , p_expected_result IN	NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
540  		     )
541  	 RETURN VARCHAR2
542    ;
