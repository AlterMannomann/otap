 31    FUNCTION build_function_header( p_title_prefix  IN VARCHAR2 DEFAULT NULL
 32  				     , p_set	       IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 33  				     , p_group	       IN VARCHAR2 DEFAULT NULL
 34  				     , p_name	       IN VARCHAR2 DEFAULT NULL
 35  				     )
 36  	 RETURN otap_view_result_tbl PIPELINED
 37    IS
 38  	 l_statement   VARCHAR2(4000 CHAR);
 39  	 l_set	       VARCHAR2(128 CHAR);
 40  	 l_group       VARCHAR2(128 CHAR);
 41  	 l_name        VARCHAR2(128 CHAR);
 42  	 l_fn_name     VARCHAR2(128 CHAR);
 43  	 l_prefix      VARCHAR2(10 CHAR);
 44    BEGIN
 45  	 l_fn_name := 'test_';
 46  	 -- set, group and nem should not contain underscore
 47  	 l_set	   := CASE
 48  			WHEN p_title_prefix IS NOT NULL
 49  			-- add prefix limited to 10 chars
 50  			THEN SUBSTR(TRIM(p_title_prefix), 1, 10) || NVL(TRIM(p_set), SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))
 51  			ELSE NVL(TRIM(p_set), SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))
 52  		      END
 53  	 ;
 54  	 l_set	   := otap_string.reduce(REGEXP_REPLACE(l_set, '[^[:alnum:]]'), 40);
 55  	 l_fn_name := l_fn_name || l_set;
 56  	 -- if group is not defined, name is not considered
 57  	 IF p_group IS NOT NULL
 58  	 THEN
 59  	   l_group := otap_string.reduce(REGEXP_REPLACE(p_group, '[^[:alnum:]]'), 30);
 60  	   l_fn_name := l_fn_name || '_' || l_group;
 61  	   IF p_name IS NOT NULL
 62  	   THEN
 63  	     -- for names we do not care about underscores
 64  	     l_name := otap_string.reduce(REGEXP_REPLACE(p_name, '[^[:alnum:]_]'), 128);
 65  	     l_fn_name := l_fn_name || '_' || l_name;
 66  	   END IF;
 67  	 END IF;
 68  	 -- remove blanks and not allowed/recommended chars if still any and reduce
 69  	 l_fn_name  := otap_string.reduce(REGEXP_REPLACE(l_fn_name, '[^[:alnum:]_]'), 128);
 70  	 l_statement := '-- otap GENERATE test function ' || UPPER(l_fn_name);
 71  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 72  	 l_statement := 'CREATE OR REPLACE FUNCTION ' || l_fn_name;
 73  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 74  	 l_statement := ' RETURN NUMBER';
 75  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 76  	 l_statement := 'IS';
 77  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 78  	 l_statement := '  l_message VARCHAR2(4000);';
 79  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 80  	 l_statement := '  l_return  NUMBER;';
 81  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 82  	 l_statement := 'BEGIN';
 83  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 84  	 RETURN;
 85    EXCEPTION
 86  	 WHEN NO_DATA_NEEDED THEN
 87  	   RAISE;
 88    END build_function_header;
