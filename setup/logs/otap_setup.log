389    FUNCTION has_trigger( p_trigger_name    IN	     VARCHAR2
390  			   , o_errors		  OUT NOCOPY VARCHAR2
391  			   , p_schema	       IN	     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
392  			   , p_trigger_type    IN	     VARCHAR2 DEFAULT NULL
393  			   , p_trigger_event   IN	     VARCHAR2 DEFAULT NULL
394  			   , p_table_owner     IN	     VARCHAR2 DEFAULT NULL
395  			   , p_table_name      IN	     VARCHAR2 DEFAULT NULL
396  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
397  			   )
398  	 RETURN INTEGER
399    IS
400  	 l_script	  VARCHAR2(1024 CHAR)	 := 'otap_schema.has_trigger';
401  	 l_test_passed	  INTEGER;
402  	 l_expected	  INTEGER;
403  	 l_has_trigger	  INTEGER;
404  	 l_trigger_name   VARCHAR2(128 CHAR);
405  	 l_trigger_type   VARCHAR2(16 CHAR);
406  	 l_trigger_event  VARCHAR2(246 CHAR);
407  	 l_table_owner	  VARCHAR2(128 CHAR);
408  	 l_table_name	  VARCHAR2(128 CHAR);
409  	 l_schema_to_use  VARCHAR2(128 CHAR);
410  	 l_errors	  VARCHAR2(32767 CHAR);
411    BEGIN
412  	 l_errors	   := NULL;
413  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
414  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
415  	 l_trigger_name    := otap_string.reduce(p_trigger_name, 128);
416  	 l_trigger_type    := otap_string.reduce(UPPER(p_trigger_type), 16);
417  	 l_trigger_event   := otap_string.reduce(UPPER(p_trigger_event), 246);
418  	 l_table_owner	   := otap_string.reduce(p_table_owner, 128);
419  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
420  	 IF	l_trigger_name	      IS NOT NULL
421  	    AND LENGTH(l_trigger_name) > 0
422  	 THEN
423  	   -- schema
424  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
425  	   -- check
426  	   SELECT COUNT(*)
427  	     INTO l_has_trigger
428  	     FROM dba_triggers
429  	    WHERE owner 		       = l_schema_to_use
430  	      AND trigger_name		       = l_trigger_name
431  	      AND NVL(trigger_type, 'n/a')     = NVL(l_trigger_type, NVL(trigger_type, 'n/a'))
432  	      AND NVL(triggering_event, 'n/a') = NVL(l_trigger_event, NVL(triggering_event, 'n/a'))
433  	      AND NVL(table_owner, 'n/a')      = NVL(l_table_owner, NVL(table_owner, 'n/a'))
434  	      AND NVL(table_name, 'n/a')       = NVL(l_table_name, NVL(table_name, 'n/a'))
435  	   ;
436  	   -- we should find one or zero entries
437  	   l_test_passed := count_chk(l_has_trigger, l_errors, l_script);
438  	 ELSE
439  	   -- invalid package name, type or state
440  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
441  	   l_errors	       := 'Not allowed: p_trigger_name(NULL)';
442  	   otap_log.log(l_errors, l_script, 'Trigger name NULL');
443  	 END IF;
444  	 -- now decide on the expected result the final state and if errors are returned
445  	 IF l_test_passed != l_expected
446  	 THEN
447  	   o_errors := otap_string.reduce(l_errors, 4000);
448  	 ELSE
449  	   -- overwrite states from before, as we fulfill expected
450  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
451  	   -- overwrite errors expected
452  	   o_errors := NULL;
453  	 END IF;
454  	 RETURN l_test_passed;
455    EXCEPTION
456  	 WHEN OTHERS THEN
457  	   IF SQLCODE != -20099
458  	   THEN
459  	     -- log unhandled exceptions
460  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
461  	   END IF;
462  	   RAISE;
463    END has_trigger;
