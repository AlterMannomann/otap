  4    /**
  5    * Provides view functions to generate test scripts from schema objects.
  6    * WARNING This records just the current state of the schema. This does not mean that it is the correct
  7    * or desired state. Control and adjust the generated test calls to your need. This is a helper for
  8    * a simple start with schema tests, NOT with functional tests.
  9    */
 10  
 11    /** FUNCTION otap_generate.column_tests
 12    * Generates the test scripts for the columns of a given table and schema with the current available
 13    * otap schema functions. Limited to line size 4000 but not to rows, like DBMS_OUTPUT. It is up to you how
 14    * you spool the content to files.
 15    *
 16    * @param p_table Mandatory. The table name to get column tests for. Case sensitive.
 17    * @param p_like_column The like expression for the columns to generate tests for. Can also be a specific column name. Case sensitive.
 18    * @param p_schema The schema to generate the column tests for. Default is current schema.
 19    * @param p_title_prefix An optional title prefix for group and test names. Limited to 10 chars.
 20    * @param p_show_header Used to surpress header comments, init, count and finish section. Default 1 will contain all sections, otherwise skipped.
 21    * @param p_excl_sysgen Used to ignore system generated objects identified by SYS_ or $. Default 1 will ignore system generated objects, otherwise included.
 22    *
 23    * @return An OTAP_VIEW_RESULT_REC object as table type OTAP_VIEW_RESULT_TBL.
 24    */
 25    FUNCTION column_tests( p_table	      IN VARCHAR2
 26  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
 27  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 28  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
 29  			    , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
 30  			    , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
 31  			    )
 32  	 RETURN otap_view_result_tbl PIPELINED
 33    ;
