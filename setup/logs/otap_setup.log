104    * Sets the current active test group. If test group name is longer than 256 chars
105    * it is cutted to 256 chars. If NULL is given than, otap_constants.OTAP_DEFAULT_TEST_GROUP
106    * is used.
107    *
108    * @param p_test_group The test group name to use for the next tests.
109    * @param o_otap_session The current session_record from OTAP_TEST package.
110    *
111    * @return The test group currently active as text message.
112    *
113    * @exception -20099 Internal error, invalid OTAP_SESSION object.
114    */
115    FUNCTION otap_session_set_test_group( p_test_group   IN		  VARCHAR2
116  					   , o_otap_session IN OUT NOCOPY OTAP_SESSION
117  					   )
118  	 RETURN VARCHAR2
119    ;
120  
121    /** FUNCTION otap_objects.otap_session_set_test_name
122    * Sets the current active test. If test name is longer than 256 chars
123    * it is cutted to 256 chars. If NULL is given than, otap_constants.OTAP_DEFAULT_TEST_NAME
124    * is used.
125    *
126    * @param p_test_name The test name to use for the next tests.
127    * @param o_otap_session The current session_record from OTAP_TEST package.
128    *
129    * @return The test name currently active as text message.
130    *
131    * @exception -20099 Internal error, invalid OTAP_SESSION object.
132    */
133    FUNCTION otap_session_set_test_name( p_test_name    IN		 VARCHAR2
134  					  , o_otap_session IN OUT NOCOPY OTAP_SESSION
135  					  )
136  	 RETURN VARCHAR2
137    ;
138  
139    /** FUNCTION otap_objects.otap_session_get_test_id
140    * Gets the current active test session id from OTAP_SESSION object.
141    *
142    * @param p_otap_session The current session_record from OTAP_TEST package.
143    *
144    * @return The current active test session id.
145    *
146    * @exception -20099 Internal error, invalid OTAP_SESSION object.
147    */
148    FUNCTION otap_session_get_test_id(p_otap_session IN OTAP_SESSION)
149  	 RETURN NUMBER
150    ;
