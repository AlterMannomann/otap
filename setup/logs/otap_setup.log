SQL> @@../otap_ddl/packages/otap_schema.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_schema
  2  AS
  3    -- for description see header file
  4    FUNCTION has_table( p_table_name   IN		VARCHAR2
  5  			 , o_otap_session IN OUT NOCOPY OTAP_SESSION
  6  			 , p_schema	  IN		VARCHAR2     DEFAULT NULL
  7  			 , p_description  IN		VARCHAR2     DEFAULT NULL
  8  			 )
  9  	 RETURN VARCHAR2
 10    IS
 11  	 l_script	     VARCHAR2(1024) := 'otap_schema.has_table';
 12  	 l_default_message   VARCHAR2(256)  := 'Test table exists: ';
 13  	 l_has_table	     INTEGER;
 14  	 l_test_passed	     INTEGER;
 15  	 l_schema_to_use     VARCHAR2(130);
 16  	 l_table_name	     VARCHAR2(130);
 17  	 l_test_result	     VARCHAR2(256);
 18  	 l_test_description  VARCHAR2(256);
 19  	 l_errors	     VARCHAR2(4000);
 20  	 l_statement	     VARCHAR2(32767);
 21  	 l_start	     TIMESTAMP;
 22  	 l_end		     TIMESTAMP;
 23  	 l_tmp_otap_session  OTAP_SESSION;
 24    BEGIN
 25  	 l_start := SYSTIMESTAMP;
 26  	 -- verify OTAP_SESSION object
 27  	 otap_objects.otap_session_verify(o_otap_session);
 28  	 l_errors     := NULL;
 29  	 l_table_name := TRIM(p_table_name);
 30  	 IF	l_table_name	    IS NOT NULL
 31  	    AND LENGTH(l_table_name) > 0
 32  	 THEN
 33  	   -- check description
 34  	   l_schema_to_use := TRIM(NVL(p_schema, o_otap_session.db_schema));
 35  	   l_test_description := NVL(p_description, l_default_message || l_schema_to_use || '.' || l_table_name);
 36  	   SELECT COUNT(*)
 37  	     INTO l_has_table
 38  	     FROM dba_tables
 39  	    WHERE table_name = l_table_name
 40  	      AND owner      = l_schema_to_use
 41  	   ;
 42  	   -- we should find one or zero entries
 43  	   l_test_passed := CASE l_has_table
 44  			      WHEN 0
 45  			      THEN otap_constants.OTAP_NUM_TEST_FAILED
 46  			      WHEN 1
 47  			      THEN otap_constants.OTAP_NUM_TEST_PASSED
 48  			      ELSE otap_constants.OTAP_NUM_TEST_UNDEFINED
 49  			    END
 50  	   ;
 51  	   -- report abnormal results and store them in errors
 52  	   IF l_has_table NOT IN (0, 1)
 53  	   THEN
 54  	     l_statement := q'[SELECT COUNT(*)
 55   INTO l_has_table
 56   FROM dba_tables
 57  WHERE table_name = '"' || l_table_name || '"'
 58    AND owner      = '"' || l_schema_to_use || '"']'
 59  	     ;
 60  	     l_errors := 'Check table ' || l_table_name || ' with schema ' || l_schema_to_use || ' results in count ' || l_has_table;
 61  	     otap_util.log(l_errors, l_script, l_statement);
 62  	   END IF;
 63  	 ELSE
 64  	   -- invalid table name
 65  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 66  	   l_statement	       := 'l_table_name IS NOT NULL AND LENGTH(l_table_name) > 0';
 67  	   l_errors	       := 'Missing table name';
 68  	   l_test_description  := l_default_message || 'ERROR name missing';
 69  	   l_schema_to_use     := NVL(p_schema, o_otap_session.db_schema);
 70  	   otap_util.log(l_errors, l_script, l_statement);
 71  	 END IF;
 72  	 -- due to a possible schema override prepare a temporary object with the schema used
 73  	 l_tmp_otap_session	       := otap_objects.otap_session_copy(o_otap_session);
 74  	 l_tmp_otap_session.db_schema  := l_schema_to_use;
 75  	 l_end			       := SYSTIMESTAMP;
 76  	 otap_plan.write_test_result(l_test_description, l_tmp_otap_session, l_test_passed, l_start, l_end, l_errors);
 77  	 -- now update the session record with new test done
 78  	 otap_objects.otap_session_add_test(l_test_passed, o_otap_session);
 79  	 l_test_result := otap_util.format_test_result(l_test_passed, l_test_description);
 80  	 RETURN l_test_result;
 81    EXCEPTION
 82  	 WHEN OTHERS THEN
 83  	   IF SQLCODE != -20099
 84  	   THEN
 85  	     -- log unhandled exceptions
 86  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 87  	   END IF;
 88  	   RAISE;
 89    END has_table;
 90  
 91  END;
 92  /

