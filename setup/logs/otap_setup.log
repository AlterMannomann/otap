641    * @param p_password_versions Optional. The password versions if any defined of the database user to check. Case sensitive.
642    * @param p_authentication_type Optional. The authentication type of the database user to check. Not case sensitive.
643    * @param p_proxy_only_connect Optional. The proxy only connect indicator of the database user to check. Not case sensitive.
644    * @param p_protected Optional. The protected state indicator of the database user to check. Not case sensitive.
645    * @param p_read_only Optional. The read only state indicator of the database user to check. Not case sensitive.
646    * @param p_description The test description if any. If not given, a description is generated, see template.
647    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
648    *
649    * @return The test result as text.
650    */
651    FUNCTION has_user( p_username		  IN VARCHAR2
652  			, p_account_status	  IN VARCHAR2 DEFAULT NULL
653  			, p_default_tablespace	  IN VARCHAR2 DEFAULT NULL
654  			, p_temporary_tablespace  IN VARCHAR2 DEFAULT NULL
655  			, p_local_temp_tablespace IN VARCHAR2 DEFAULT NULL
656  			, p_profile		  IN VARCHAR2 DEFAULT NULL
657  			, p_password_versions	  IN VARCHAR2 DEFAULT NULL
