SQL> CREATE OR REPLACE PACKAGE BODY otap_objects
  2  AS
  3    -- for description see header file
  4    PROCEDURE otap_session_verify(p_otap_session IN OTAP_SESSION)
  5    IS
  6  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_verify';
  7  	 l_statement VARCHAR2(32767 CHAR);
  8  	 l_message   VARCHAR2(32767 CHAR);
  9  	 l_delimiter VARCHAR2(1 CHAR);
 10    BEGIN
 11  	 -- we expect all fields to be NOT NULL including empty strings
 12  	 IF    p_otap_session				  IS NULL
 13  	    OR p_otap_session.test_executor		  IS NULL
 14  	    OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
 15  	    OR p_otap_session.test_set			  IS NULL
 16  	    OR LENGTH(TRIM(p_otap_session.test_set))	   = 0
 17  	    OR p_otap_session.test_group		  IS NULL
 18  	    OR LENGTH(TRIM(p_otap_session.test_group))	   = 0
 19  	    OR p_otap_session.test_name 		  IS NULL
 20  	    OR LENGTH(TRIM(p_otap_session.test_name))	   = 0
 21  	    OR p_otap_session.db_user			  IS NULL
 22  	    OR LENGTH(TRIM(p_otap_session.db_user))	   = 0
 23  	    OR p_otap_session.db_schema 		  IS NULL
 24  	    OR LENGTH(TRIM(p_otap_session.db_schema))	   = 0
 25  	    OR p_otap_session.test_prefix		  IS NULL
 26  	    OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
 27  	    OR p_otap_session.test_count		  IS NULL
 28  	    OR p_otap_session.intended_count		  IS NULL
 29  	    OR p_otap_session.persist_test		  IS NULL
 30  	    OR p_otap_session.name_precedence		  IS NULL
 31  	    OR p_otap_session.include_packages		  IS NULL
 32  	    OR p_otap_session.session_start		  IS NULL
 33  	    OR p_otap_session.session_id		  IS NULL
 34  	    OR p_otap_session.error_count		  IS NULL
 35  	    OR p_otap_session.session_view_id		  IS NULL
 36  	 THEN
 37  	   l_delimiter := '';
 38  	   l_statement := q'[p_otap_session				IS NULL
 39  OR p_otap_session.test_executor		   IS NULL
 40  OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
 41  OR p_otap_session.test_set 		   IS NULL
 42  OR LENGTH(TRIM(p_otap_session.test_set))	    = 0
 43  OR p_otap_session.test_group		   IS NULL
 44  OR LENGTH(TRIM(p_otap_session.test_group))     = 0
 45  OR p_otap_session.test_name		   IS NULL
 46  OR LENGTH(TRIM(p_otap_session.test_name))	    = 0
 47  OR p_otap_session.db_user			   IS NULL
 48  OR LENGTH(TRIM(p_otap_session.db_user))	    = 0
 49  OR p_otap_session.db_schema		   IS NULL
 50  OR LENGTH(TRIM(p_otap_session.db_schema))	    = 0
 51  OR p_otap_session.test_prefix		   IS NULL
 52  OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
 53  OR p_otap_session.test_count		   IS NULL
 54  OR p_otap_session.intended_count		   IS NULL
 55  OR p_otap_session.persist_test		   IS NULL
 56  OR p_otap_session.name_precedence		   IS NULL
 57  OR p_otap_session.include_packages 	   IS NULL
 58  OR p_otap_session.session_start		   IS NULL
 59  OR p_otap_session.session_id		   IS NULL
 60  OR p_otap_session.error_count		   IS NULL
 61  OR p_otap_session.session_view_id		   IS NULL]'
 62  	   ;
