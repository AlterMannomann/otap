395  	    WHERE otap_label_source = UPPER(p_object_type)
396  	   ;
397  	 ELSE
398  	   otap_log.log('Invalid object type: ' || p_object_type, l_script);
399  	   l_return := otap_util.CFG_LABEL_UNDEFINED;
400  	 END IF;
401  	 RETURN l_return;
