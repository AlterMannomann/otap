SQL> @@../otap_ddl/packages/otap_log.pks
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> -- Basic package that provides utility functions and procedures for table OTAP_CONFIG.
SQL> CREATE OR REPLACE PACKAGE otap_log
  2  AS
  3    /**
  4    * Provides logging functionality. Dependency on OTAP_CONFIG table for DEBUG_MODE. Other
  5    * functionality of OTAP_CONFIG table is provided in otap_util. Provided as internal
  6    * function not exposed to package header. Fail save implementation. Will do nothing apart
  7    * from DBMS_OUTPUT on exceptions and errors. Logging is not critical for otap.
  8    *
  9    * It is a simple and very reduced log using SPERRORLOG which should have been created by setup.
 10    */
 11  
 12    /** PROCEDURE otap_util.log
 13    * Writes a log message to SPERRORLOG which should be already available by setup. If the identifier
 14    * is not otap_constants.OTAP_INTERNAL_ERROR the log output will only be stored, if OTAP_CONFIG
 15    * DEBUG_MODE is set to 1. User and timestamp are set by the procedure. Runs as autonomous transaction.
 16    * If SPERRORLOG does not exist, will do nothing apart from DBMS_OUTPUT the exception.
 17    *
 18    * @param p_log_message The message to log in SPERRORLOG.
 19    * @param p_script The script, package or function that caused the message.
 20    * @param p_statement The statement that caused the message.
 21    * @param p_identifier The identifier in SPERRORLOG. If not otap_constants.OTAP_INTERNAL_ERROR, message is logged only if debug mode is set.
 22    */
 23    PROCEDURE log( p_log_message  IN VARCHAR2
 24  		    , p_script	     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 25  		    , p_statement    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 26  		    , p_identifier   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_ERROR
 27  		    )
 28    ;
 29  
 30  END;
 31  /

Package created.

SQL> @@../otap_ddl/packages/otap_log.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_log
  2  AS
  3  
  4    /** internal FUNCTION otap_log.debug_active
  5    * Returns the debug state, defined in OTAP_CONFIG. Can't log errors as log depends on
  6    * this function. Fail save.
  7    *
  8    * @return TRUE if DEBUG_MODE is set to 1 in OTAP_CONFIG, otherwise or on errors FALSE.
  9    */
 10    FUNCTION debug_active
 11  	 RETURN BOOLEAN
 12    IS
 13  	 l_debug_mode  VARCHAR2(1 CHAR);
 14  	 l_return      BOOLEAN;
 15    BEGIN
 16  	 l_return := FALSE;
 17  	 SELECT config_value INTO l_debug_mode FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_DEBUG_MODE;
 18  	 IF l_debug_mode = '1'
 19  	 THEN
 20  	   l_return := TRUE;
 21  	 END IF;
 22  	 RETURN l_return;
 23    EXCEPTION
 24  	 WHEN OTHERS THEN
 25  	   RETURN FALSE;
 26    END debug_active;
 27  
 28    -- for description see header file
 29    PROCEDURE log( p_log_message  IN VARCHAR2
 30  		    , p_script	     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 31  		    , p_statement    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 32  		    , p_identifier   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_ERROR
 33  		    )
 34    IS
 35  	 PRAGMA AUTONOMOUS_TRANSACTION;
 36  	 l_has_sperrorlog  NUMBER;
 37    BEGIN
 38  	 -- check which type of log
 39  	 IF    p_identifier = otap_constants.OTAP_INTERNAL_ERROR
 40  	    OR otap_log.debug_active
 41  	 THEN
 42  	   -- check if table exists
 43  	   SELECT COUNT(*) INTO l_has_sperrorlog FROM user_tables WHERE table_name = 'SPERRORLOG';
 44  	   IF l_has_sperrorlog = 1
 45  	   THEN
 46  	     INSERT INTO sperrorlog
 47  	       ( username
 48  	       , timestamp
 49  	       , script
 50  	       , identifier
 51  	       , message
 52  	       , statement
 53  	       )
 54  	       VALUES ( otap_constants.OTAP_INTERNAL_SCHEMA
 55  		      , SYSTIMESTAMP
 56  		      , p_script
 57  		      , TRIM(SUBSTR(TRIM(p_identifier), 1, 256))
 58  		      , p_log_message
 59  		      , p_statement
 60  		      )
 61  	     ;
 62  	     COMMIT;
 63  	   ELSE
 64  	     -- give some output even if no one will notice it
 65  	     DBMS_OUTPUT.PUT_LINE('No logging possible, SPERRORLOG table does not exist');
 66  	   END IF;
 67  	 END IF;
 68    EXCEPTION
 69  	 WHEN OTHERS THEN
 70  	   -- explicitly do not care about log exceptions, application should fail otherwise
 71  	   -- logging is not critical for otap, only an option, usually not recommended to do
 72  	   -- it this way, give some output even if no one will notice it
 73  	   DBMS_OUTPUT.PUT_LINE(SQLERRM);
 74    END log;
 75  
 76  END;
 77  /

Package body created.

