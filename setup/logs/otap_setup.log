363  	   IF SQLCODE != -20099
364  	   THEN
365  	     -- log unhandled exceptions
366  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
367  	   END IF;
368  	   RAISE;
