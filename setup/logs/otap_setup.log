100    OTAP_TEXT_REPORT_END		CONSTANT CHAR(33)	:= 'OTAP test summary report finished';
101    OTAP_TEXT_RESULT_HEADER		CONSTANT CHAR(44)	:= 'Result    Setup	Runtime 	    Test';
102    OTAP_FORMAT_RESULT_HEADER	CONSTANT CHAR(80)	:= '--------- --------- ------------------- ----------------------------------------';
103    OTAP_TEXT_SUMMARY_SUCCESS	CONSTANT CHAR(7)	:= 'SUCCESS';
104    OTAP_TEXT_SUMMARY_ERROR		CONSTANT CHAR(5)	:= 'ERROR';
105    OTAP_SUMMARY_TEMPLATE		CONSTANT CHAR(76)	:= '@status@ runtime: @runtime@ (runs: @runs@ errors: @errors@ issues: @issues@)';
106    OTAP_ERRORS_TEMPLATE		CONSTANT CHAR(24)	:= '@testname@ error details';
107    OTAP_ERROR_DETAILS_TEMPLATE	CONSTANT CHAR(24)	:= '@testdesc@: @errorinfo@';
