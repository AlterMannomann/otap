 25    FUNCTION init_test( p_test_count      IN NUMBER	 DEFAULT 0
 26  			 , p_test_set	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET
 27  			 , p_test_group      IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP
 28  			 , p_test_name	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME
 29  			 , p_prefix	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX
 30  			 , p_name_precedence IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_TRUE
 31  			 , p_include_pkg     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 32  			 , p_persist	     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 33  			 -- internal variables from caller environment DO NOT SET them explicitely
 34  			 -- you may want to set p_schema, which is the default schema used for object searches
 35  			 -- but schema test functions provide a schema override, so in general there is no need
 36  			 -- for overwritting this value
 37  			 -- currently no save way exists to get the correct values from inside a procedure of function
 38  			 , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 39  			 , p_user	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_USER')
 40  			 , p_executor	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'SESSION_USER')
 41  			 )
 42  	 RETURN VARCHAR2
 43    IS
 44  	 l_message VARCHAR2(4000 CHAR);
 45    BEGIN
 46  	 otap_api.validate_otap;
 47  	 l_message := otap_api.init_test( NVL(p_test_count, 0)
 48  					, NVL(p_test_set, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET)
 49  					, NVL(p_test_group, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP)
 50  					, NVL(p_test_name, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME)
 51  					, NVL(p_prefix, otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX)
 52  					, NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE)
 53  					, NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE)
 54  					, NVL(p_persist, otap_constants.OTAP_NUM_FALSE)
 55  					, p_schema
 56  					, p_user
 57  					, p_executor
 58  					, session_record
 59  					)
 60  	 ;
 61  	 RETURN l_message;
 62    EXCEPTION
 63  	 WHEN OTHERS THEN
 64  	   IF SQLCODE != -20099
 65  	   THEN
 66  	     otap_log.log(SQLERRM, 'otap_test.init_test', 'l_message := otap_api.init_test( p_test_count ...');
 67  	   END IF;
 68  	   RAISE;
 69    END init_test;
 70  
 71    FUNCTION finish_test(p_write_count_rec IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
 72  	 RETURN VARCHAR2
 73    IS
 74  	 l_message VARCHAR2(4000 CHAR);
 75    BEGIN
 76  	 otap_api.validate_otap;
 77  	 l_message := otap_api.finish_test(p_write_count_rec, session_record);
 78  	 RETURN l_message;
 79    EXCEPTION
 80  	 WHEN OTHERS THEN
 81  	   IF SQLCODE != -20099
 82  	   THEN
 83  	     otap_log.log(SQLERRM, 'otap_test.finish_test', 'l_message := otap_api.finish_test(p_write_count_rec, session_record)');
 84  	   END IF;
 85  	   RAISE;
 86    END finish_test;
 87  
 88    FUNCTION finish_test_with_exit_code(p_write_count_rec IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
 89  	 RETURN NUMBER
 90    IS
 91  	 l_return INTEGER;
 92    BEGIN
 93  	 otap_api.validate_otap;
 94  	 l_return := otap_api.finish_test_with_exit_code(p_write_count_rec, session_record);
 95  	 RETURN l_return;
 96    EXCEPTION
 97  	 WHEN OTHERS THEN
 98  	   IF SQLCODE != -20099
 99  	   THEN
100  	     otap_log.log(SQLERRM, 'otap_test.finish_test_with_exit_code', 'l_message := otap_api.finish_test_with_exit_code(p_write_count_rec, session_record)');
101  	   END IF;
102  	   RAISE;
103    END finish_test_with_exit_code;
