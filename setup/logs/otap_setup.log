271    FUNCTION max_text_size(p_session_id IN NUMBER)
272  	 RETURN NUMBER
273    IS
274  	 l_script    VARCHAR2(1024 CHAR) := 'otap_api.otap_session_get_test_id';
275  	 l_return    NUMBER;
276  	 l_interval  NUMBER;
277    BEGIN
278  	 l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
279  	 -- execute the wrapped function in an extra block
280  	 BEGIN
281  	   l_return := otap_util.max_text_size(p_session_id);
282  	   -- now add the extra columns on the result line
283  	   SELECT LENGTH(((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval FROM dual;
284  	   l_return := l_return + l_interval + (2 * otap_util.get_length_test_state) + 3;
285  	 EXCEPTION
286  	   WHEN OTHERS THEN
287  	     -- consume error
288  	     otap_log.log(SQLERRM, l_script, 'Calling otap_util.max_text_size');
289  	     l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
290  	 END;
291  	 -- return or let exception happen
292  	 RETURN l_return;
293    END max_text_size;
