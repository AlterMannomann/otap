SQL> CREATE OR REPLACE PACKAGE BODY otap_logic
  2  AS
  3    -- for description see header file
  4    FUNCTION check_header( p_header_def IN		 VARCHAR2
  5  			    , o_errors	   IN OUT NOCOPY VARCHAR2
  6  			    )
  7  	 RETURN BOOLEAN
  8    IS
  9  	 l_script  VARCHAR2(1024 CHAR) := 'otap_logic.check_header';
 10  	 l_block   VARCHAR2(32767);
 11  	 l_return  BOOLEAN;
 12    BEGIN
 13  	 l_return := FALSE;
 14  	 l_block := 'DECLARE ' || p_header_def || ' BEGIN NULL; END;';
 15  	 -- check header
 16  	 BEGIN
 17  	   EXECUTE IMMEDIATE l_block;
 18  	   l_return := TRUE;
 19  	 EXCEPTION
 20  	   WHEN OTHERS THEN
 21  	     -- log error
 22  	     otap_log.log(SQLERRM, l_script, 'Header block not valid: ' || p_header_def);
 23  	     o_errors := o_errors || ' exception: ' || SQLERRM;
 24  	     l_return := FALSE;
 25  	 END;
 26  	 RETURN l_return;
 27    EXCEPTION
 28  	 WHEN OTHERS THEN
 29  	   IF SQLCODE != -20099
 30  	   THEN
 31  	     -- log unhandled exceptions
 32  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 33  	   END IF;
 34  	   RAISE;
 35    END check_header;
 36  
 37    FUNCTION get_test_block( p_statement  IN VARCHAR2
 38  			      , p_header_def IN VARCHAR2 DEFAULT NULL
 39  			      )
 40  	 RETURN VARCHAR2
 41    IS
 42  	l_block VARCHAR2(32767);
 43    BEGIN
 44  	 IF SUBSTR(UPPER(p_statement), 1, 6) = 'SELECT'
 45  	 THEN
 46  	   l_block := TRIM(p_statement);
 47  	   IF (SUBSTR(l_block, LENGTH(l_block)-1, 1) = ';')
 48  	   THEN
 49  	     l_block := SUBSTR(l_block, 1, LENGTH(l_block)-1);
 50  	   END IF;
 51  	   -- to get exceptions from SELECT statements without knowing the columns we use a FOR IN loop
 52  	   l_block := 'DECLARE BEGIN FOR rec IN (' || l_block || ') LOOP NULL; END LOOP; END;';
 53  	   RETURN l_block;
 54  	 ELSE
 55  	   RETURN 'DECLARE ' || p_header_def || ' BEGIN ' || p_statement || ' END;';
 56  	 END IF;
 57    EXCEPTION
 58  	 WHEN OTHERS THEN
 59  	   IF SQLCODE != -20099
 60  	   THEN
 61  	     -- log unhandled exceptions
 62  	     otap_log.log(SQLERRM, 'otap_logic.get_test_block', 'Unhandled exception otap_logic.get_test_block call');
 63  	   END IF;
 64  	   RAISE;
 65    END get_test_block;
 66  
 67    FUNCTION has_exception( p_statement	 IN	       VARCHAR2
 68  			     , o_errors 	 IN OUT NOCOPY VARCHAR2
 69  			     , o_sqlcode	    OUT NOCOPY NUMBER
 70  			     , o_sqlerrm	    OUT NOCOPY VARCHAR2
 71  			     , p_header_def	 IN	       VARCHAR2 DEFAULT NULL
 72  			     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 73  			     )
 74  	 RETURN BOOLEAN
 75    IS
 76  	 l_script  VARCHAR2(1024 CHAR) := 'otap_logic.has_exception';
 77  	 l_block   VARCHAR2(32767);
 78  	 l_return  BOOLEAN;
 79    BEGIN
 80  	 l_return := FALSE;
 81  	 IF otap_logic.check_header(p_header_def, o_errors)
 82  	 THEN
 83  	   -- header valid, check statement
 84  	   l_block := otap_logic.get_test_block(p_statement, p_header_def);
 85  	   BEGIN
 86  	     EXECUTE IMMEDIATE l_block;
 87  	     l_return := FALSE;
 88  	     IF p_expected_result = otap_constants.OTAP_NUM_TEST_PASSED
 89  	     THEN
 90  	       o_errors  := o_errors || 'Expected exception missing for ' || l_block || ' ';
 91  	       o_sqlcode := NULL;
 92  	       o_sqlerrm := NULL;
 93  	     END IF;
 94  	   EXCEPTION
 95  	     WHEN OTHERS THEN
 96  	       o_sqlcode := SQLCODE;
 97  	       o_sqlerrm := SQLERRM;
 98  	       l_return  := TRUE;
 99  	   END;
100  	 ELSE
101  	   -- header not valid, o_errors should be set, return TRUE but user error
102  	   otap_log.log('-20100 invalid header', l_script, 'User error invalid header ' || p_header_def);
103  	   o_sqlcode := -20100;
104  	   o_sqlerrm := 'User error invalid header ' || p_header_def;
105  	   o_errors  := o_errors || 'User error invalid header ' || p_header_def || ' ';
106  	   l_return  := TRUE;
107  	 END IF;
108  	 RETURN l_return;
109    EXCEPTION
110  	 WHEN OTHERS THEN
111  	   IF SQLCODE != -20099
112  	   THEN
113  	     -- log unhandled exceptions
114  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
115  	   END IF;
116  	   RAISE;
117    END has_exception;
118  
119    FUNCTION ok( p_boolean	      IN	    BOOLEAN
120  		  , o_errors		 OUT NOCOPY VARCHAR2
121  		  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
122  		  )
123  	 RETURN INTEGER
124    IS
125  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.ok';
126  	 l_test_passed	 INTEGER;
127  	 l_expected	 INTEGER;
128  	 l_errors	 VARCHAR2(32767 CHAR);
129    BEGIN
130  	 l_errors      := NULL;
131  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
132  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
133  	 IF p_boolean IS NOT NULL
134  	 THEN
135  	   l_test_passed := CASE WHEN p_boolean THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
136  	 ELSE
137  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
138  	   -- NULL is not a valid boolean
139  	   l_errors := 'Not allowed: p_boolean(NULL)';
140  	   otap_log.log(l_errors, l_script);
141  	 END IF;
142  	 -- now decide on the expected result the final state and if errors are returned
143  	 IF l_test_passed != l_expected
144  	 THEN
145  	   o_errors := otap_string.reduce(l_errors, 4000);
146  	 ELSE
147  	   -- overwrite states from before, as we fulfill expected
148  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
149  	   -- overwrite errors expected
150  	   o_errors := NULL;
151  	 END IF;
152  	 RETURN l_test_passed;
153    EXCEPTION
154  	 WHEN OTHERS THEN
155  	   IF SQLCODE != -20099
156  	   THEN
157  	     -- log unhandled exceptions
158  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
159  	   END IF;
160  	   RAISE;
161    END ok;
