903    FUNCTION has_type( p_type_name	    IN		  VARCHAR2
904  			, o_errors	       OUT NOCOPY VARCHAR2
905  			, p_typecode	    IN		  VARCHAR2 DEFAULT NULL
906  			, p_attributes	    IN		  NUMBER   DEFAULT NULL
907  			, p_methods	    IN		  NUMBER   DEFAULT NULL
908  			, p_predefined	    IN		  VARCHAR2 DEFAULT NULL
909  			, p_incomplete	    IN		  VARCHAR2 DEFAULT NULL
910  			, p_final	    IN		  VARCHAR2 DEFAULT NULL
911  			, p_persistable     IN		  VARCHAR2 DEFAULT NULL
912  			, p_schema	    IN		  VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
913  			, p_expected_result IN		  NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
914  			)
915  	 RETURN INTEGER
916    IS
917  	 l_script	   VARCHAR2(1024 CHAR)	  := 'otap_schema.has_type';
918  	 l_test_passed	   INTEGER;
919  	 l_expected	   INTEGER;
920  	 l_has_type	   INTEGER;
921  	 l_type_name	   VARCHAR2(128 CHAR);
922  	 l_typecode	   VARCHAR2(128 CHAR);
923  	 l_predefined	   VARCHAR2(3 CHAR);
924  	 l_incomplete	   VARCHAR2(3 CHAR);
925  	 l_final	   VARCHAR2(3 CHAR);
926  	 l_persistable	   VARCHAR2(3 CHAR);
927  	 l_schema_to_use   VARCHAR2(128 CHAR);
928  	 l_errors	   VARCHAR2(32767 CHAR);
929    BEGIN
930  	 l_errors	   := NULL;
931  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
932  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
933  	 l_type_name	   := otap_string.reduce(p_type_name, 128);
934  	 l_typecode	   := otap_string.reduce(UPPER(p_typecode), 128);
935  	 l_predefined	   := otap_string.reduce(UPPER(p_predefined), 3);
936  	 l_incomplete	   := otap_string.reduce(UPPER(p_incomplete), 3);
937  	 l_final	   := otap_string.reduce(UPPER(p_final), 3);
938  	 l_persistable	   := otap_string.reduce(UPPER(p_persistable), 3);
939  	 IF	l_type_name	   IS NOT NULL
940  	    AND LENGTH(l_type_name) > 0
941  	 THEN
942  	   -- schema
943  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
944  	   -- check
945  	   SELECT COUNT(*)
946  	     INTO l_has_type
947  	     FROM dba_types
948  	    WHERE owner 		  = l_schema_to_use
949  	      AND type_name		  = l_type_name
950  	      AND NVL(typecode, 'n/a')	  = NVL(l_typecode, NVL(typecode, 'n/a'))
951  	      AND NVL(attributes, -1)	  = NVL(p_attributes, NVL(attributes, -1))
952  	      AND NVL(methods, -1)	  = NVL(p_methods, NVL(methods, -1))
953  	      AND NVL(predefined, 'n/a')  = NVL(l_predefined, NVL(predefined, 'n/a'))
954  	      AND NVL(incomplete, 'n/a')  = NVL(l_incomplete, NVL(incomplete, 'n/a'))
955  	      AND NVL(final, 'n/a')	  = NVL(l_final, NVL(final, 'n/a'))
956  	      AND NVL(persistable, 'n/a') = NVL(l_persistable, NVL(persistable, 'n/a'))
957  	   ;
958  	   -- we should find one or zero entries
959  	   l_test_passed := count_chk(l_has_type, l_errors, l_script);
960  	 ELSE
961  	   -- type name missing
962  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
963  	   l_errors	       := 'Not allowed: p_type_name(NULL)';
964  	   otap_log.log(l_errors, l_script, 'Type name NULL');
965  	 END IF;
966  	 -- now decide on the expected result the final state and if errors are returned
967  	 IF l_test_passed != l_expected
968  	 THEN
969  	   o_errors := otap_string.reduce(l_errors, 4000);
970  	 ELSE
971  	   -- overwrite states from before, as we fulfill expected
972  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
973  	   -- overwrite errors expected
974  	   o_errors := NULL;
975  	 END IF;
976  	 RETURN l_test_passed;
977    EXCEPTION
978  	 WHEN OTHERS THEN
979  	   IF SQLCODE != -20099
980  	   THEN
981  	     -- log unhandled exceptions
982  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
983  	   END IF;
984  	   RAISE;
985    END has_type;
