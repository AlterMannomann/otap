SQL> CREATE OR REPLACE TRIGGER otap_results_upd_trg
  2    BEFORE UPDATE ON otap_results
  3    FOR EACH ROW
  4  BEGIN
  5    -- keep values already set
  6    IF :NEW.test_run_date != :OLD.test_run_date
  7    THEN
  8  	 :NEW.test_run_date := :OLD.test_run_date;
  9    END IF;
 10    IF     :OLD.test_session_id != 0
 11  	  AND :NEW.test_session_id != :OLD.test_session_id
 12    THEN
 13  	 :NEW.test_session_id := :OLD.test_session_id;
 14    END IF;
 15    IF :NEW.test_executor != :OLD.test_executor
 16    THEN
 17  	 :NEW.test_executor := :OLD.test_executor;
 18    END IF;
 19    IF :NEW.test_set != :OLD.test_set
 20    THEN
 21  	 :NEW.test_set := :OLD.test_set;
 22    END IF;
 23    IF :NEW.test_group != :OLD.test_group
 24    THEN
 25  	 :NEW.test_group := :OLD.test_group;
 26    END IF;
 27    IF     :NEW.to_delete != :OLD.to_delete
 28  	  AND :NEW.to_delete  = otap_constants.OTAP_NUM_TRUE
 29    THEN
 30  	 :NEW.deleted	 := SYSTIMESTAMP;
 31  	 :NEW.deleted_by := SYS_CONTEXT('USERENV', 'SESSION_USER');
 32    END IF;
 33    IF     :OLD.test_name IS NOT NULL
 34  	  AND :NEW.test_name != :OLD.test_name
 35    THEN
 36  	 :NEW.test_name := :OLD.test_name;
 37    END IF;
 38    IF     :OLD.test_desc IS NOT NULL
 39  	  AND :NEW.test_desc != :OLD.test_desc
 40    THEN
 41  	 :NEW.test_desc := :OLD.test_desc;
 42    END IF;
 43    IF     :OLD.test_start IS NOT NULL
 44  	  AND :NEW.test_start != :OLD.test_start
 45    THEN
 46  	 :NEW.test_start := :OLD.test_start;
 47    END IF;
 48    IF     :OLD.test_end IS NOT NULL
 49  	  AND :NEW.test_end != :OLD.test_end
 50    THEN
 51  	 :NEW.test_end := :OLD.test_end;
 52    END IF;
 53  
 54  END;
 55  /

