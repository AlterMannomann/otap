  5    FUNCTION get_config_value(p_config_name IN VARCHAR2)
  6  	 RETURN VARCHAR2
  7    IS
  8  	 l_return otap_config.config_value%TYPE;
  9    BEGIN
 10  	 SELECT config_value
 11  	   INTO l_return
 12  	   FROM otap_config
 13  	  WHERE config_name = UPPER(p_config_name)
 14  	 ;
 15  	 RETURN l_return;
 16    EXCEPTION
 17  	 WHEN OTHERS THEN
 18  	   otap_log.log(SQLERRM, 'otap_config_util.get_config_value', 'SELECT config_value INTO l_return FROM otap_config WHERE config_name = UPPER(p_config_name)');
 19  	   RAISE;
 20    END get_config_value;
 21  
 22    PROCEDURE set_config_value( p_config_name  IN VARCHAR2
 23  				 , p_config_value IN VARCHAR2
 24  				 )
 25    IS
 26  	 PRAGMA AUTONOMOUS_TRANSACTION;
 27    BEGIN
 28  	 UPDATE otap_config
 29  	    SET config_value = p_config_value
 30  	  WHERE config_name = UPPER(p_config_name)
 31  	 ;
 32  	 COMMIT;
 33    EXCEPTION
 34  	 WHEN OTHERS THEN
 35  	   otap_log.log(SQLERRM, 'otap_config_util.set_config_value', 'UPDATE otap_config SET config_value = p_config_value WHERE config_name = UPPER(p_config_name)');
 36  	   RAISE;
 37    END set_config_value;
