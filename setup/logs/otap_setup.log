 39    FUNCTION get_debug
 40  	 RETURN NUMBER
 41    IS
 42    BEGIN
 43  	 RETURN TO_NUMBER(get_config_value(otap_constants.OTAP_CFG_DEBUG_MODE));
 44    END get_debug;
