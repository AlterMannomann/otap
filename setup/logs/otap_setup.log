SQL> CREATE OR REPLACE PACKAGE otap_plan
  2  AS
  3  
  4    /**
  5    * This package provides the functions used by the wrapper package otap_test for test
  6    * setup, name definitions and test maintenance.
  7    *
  8    * It is a main for package otap_test or packages which have an OTAP_SESSION object
  9    * from otap_test. Otherwise won't work as expected. Exceptions are raised, if not handled.
 10    *
 11    * -20099 Internal error, OTAP_SESSION object not valid. Details see specific error message.
 12    */
 13  
 14    /** FUNCTION otap_plan.write_test_result
 15    * Writes the result of a test to OTAP_RESULTS. If OTAP_SESSION persist_test is set to FALSE
 16    * the TO_DELETE flag is set on insert. Will retrieve most of the details from the current
 17    * session_record given by OTAP_TEST package or the test function using this procedure.
 18    * Will fail the test, if p_test_passed is not valid. Adds a new test to the session variable
 19    * and returns the result as VARCHAR2 message. Defines the test end by being called.
 20    *
 21    * @param p_test_description The test description for a specific test. If missing, will generate Unspecified test x where x is a SCN number.
 22    * @param o_otap_session A valid OTAP_SESSION object to be used for update and the insert with details on the test category and scope.
 23    * @param p_used_schema The schema used for the test. May differ from session object.
 24    * @param p_test_passed A valid test passed ID, allowed values are otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED and otap_constants.OTAP_NUM_TEST_UNDEFINED.
 25    * @param p_test_start The timestamp of the test start, must be provided by test functions.
 26    * @param p_test_end The timestamp of the test end, must be provided by test functions.
 27    * @param p_test_errors Test error information limited to 4000 chars.
 28    *
 29    * @return The result as message to display, limited to 4000 char.
 30    */
 31    FUNCTION write_test_result( p_test_description IN	    VARCHAR2
 32  				 , o_otap_session     IN OUT NOCOPY OTAP_SESSION
 33  				 , p_schema_used      IN	    VARCHAR2
 34  				 , p_test_passed      IN	    NUMBER
 35  				 , p_test_start       IN	    TIMESTAMP
 36  				 , p_test_errors      IN	    VARCHAR2
 37  				 )
 38  	 RETURN VARCHAR2
 39    ;
 40  
 41    /** PROCEDURE otap_plan.write_count_result
 42    * Checks if intended_count is set and writes a final test record about expected and executed tests.
 43    * Does nothing if OTAP_SESSION intended_count less or equal to 0. This test is not counted within
 44    * the test count.
 45    *
 46    * @param o_otap_session A valid OTAP_SESSION object to be used for test result insert.
 47    */
 48    PROCEDURE write_count_result(o_otap_session IN OUT NOCOPY OTAP_SESSION);
 49  
 50    /** FUNCTION otap_plan.init_test
 51    * Provides the init_test functionality needed by otap_test and setting the package session variables.
 52    * Errors will get logged.
 53    *
 54    * @param p_test_count The amount of tests expected to be executed when called.
 55    * @param p_test_set The name of the test set applied if the name of the executed test procedure or function does not provide a test set name or name precendence is disabled.
 56    * @param p_test_group The name of the test group applied if the name of the executed test procedure or function does not provide a test group name or name precendence is disabled.
 57    * @param p_test_name The name of the test name applied if the name of the executed test procedure or function does not provide a test name or name precendence is disabled.
 58    * @param p_prefix The prefix to use for identifying test functions and procedures. Limited to 4 chars. Test functions and procedures must have a trailing delimiter _ after the prefix to be identified.
 59    * @param p_language_id The session language id to use for test reports and results. Limited to 3 chars. If language has no translation, default is used.
 60    * @param p_name_precedence Can disable the naming conventions for otap. If set to otap_constants.OTAP_NUM_FALSE, all tests will run under the defined test set and group, set by init_test.
 61    * @param p_include_pkg Can enable to search also packages and package procedures and functions that fit the naming convention with the given prefix, if set to otap_constants.OTAP_NUM_TRUE.
 62    * @param p_persist Can enable to persist the test results longer than the current default of PRESERVE_DAYS in OTAP_CONFIG, if set to otap_constants.OTAP_NUM_TRUE.
 63    * The following parameters are expected from OTAP_TEST package. Caller should not set this variables.
 64    * @param p_schema The current schema from caller environment as reported from otap_test.
 65    * @param p_user The current user from caller environment as reported from otap_test.
 66    * @param p_executor The session user from caller environment as reported from otap_test.
 67    * @param o_otap_session The OTAP_SESSION object to set.
 68    *
 69    * @return The current test session settings as text LF delimited.
 70    */
 71    FUNCTION init_test( p_test_count 	 IN	       NUMBER
 72  			 , p_test_set		 IN	       VARCHAR2
 73  			 , p_test_group 	 IN	       VARCHAR2
 74  			 , p_test_name		 IN	       VARCHAR2
 75  			 , p_prefix		 IN	       VARCHAR2
 76  			 , p_language_id	 IN	       VARCHAR2
 77  			 , p_name_precedence	 IN	       NUMBER
 78  			 , p_include_pkg	 IN	       NUMBER
 79  			 , p_persist		 IN	       NUMBER
 80  			 , p_schema		 IN	       VARCHAR2
 81  			 , p_user		 IN	       VARCHAR2
 82  			 , p_executor		 IN	       VARCHAR2
 83  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
 84  			 )
 85  	 RETURN VARCHAR2
 86    ;
 87  
 88    /** FUNCTION otap_plan.run_tests
 89    * Identifies and runs test procedures. Test procedures are identified by a prefix with maximum 4 char length.
 90    * The prefix can be modified using otap_test.init_test. The delimiter for name components is always underline _.
 91    * The escape char used is backslash \. If name precedence is disabled, test set, group and test names are used
 92    * from the session record otherwise it tries to extract set, group and test name from the procedure name using
 93    * the session record entries as fallback name.
 94    *
 95    * The like expression is applied AFTER the prefix, complete search expression example with defaults: TEST\_%.
 96    *
 97    * As test procedure may manipulate the session record with test_init or test_finished, the resulting session
 98    * record is not reliable in sense of representing all tests. It represents only the last test run.
 99    *
100    * Recommended usage: First run init_test, then call run_tests. In test procedures ensure that NO init_test or finish_test
101    * occurs unless you persist the old test view results before executing finish_test or init_test. You may use the set functions
102    * for test set, group or name within the procedure. After run_tests finished, inspect the test views and persist your test
103    * results before executing init_test and run_tests again.
104    *
105    * @param p_like_expression The like expression (no regex) to limit further the procedures to run.
106    * @param p_schema_overwrite The alternate schema to use for finding test procedures. Will replace the current session value if NOT NULL.
107    * @param p_otap_session A valid OTAP_SESSION object to be used for test runs.
108    *
109    * @return A summary of the executed test procedures and session id at start of execution. Test summary can be found in the test views.
110    *
111    * @exception -20099 Internal error, invalid OTAP_SESSION object.
112    */
113    FUNCTION run_tests( p_like_expression   IN VARCHAR2 DEFAULT '%'
114  			 , p_schema_overwrite  IN VARCHAR2 DEFAULT NULL
115  			 , p_otap_session      IN OTAP_SESSION
116  			 )
117  	 RETURN VARCHAR2
118    ;
119  
120    /** FUNCTION otap_plan.finish_test
121    * Resets the OTAP_SESSION object. Will set a new session id, reset the counters and the names
122    * for test set, group and name. When a test session is finished, the test session view will not
123    * longer show the tests from the old session. If intended count is set, a test record about
124    * executed and expected tests is written.
125    *
126    * @param p_write_count_rec The indicator, if record count test should be done and written. Either otap_constants.OTAP_NUM_TRUE or otap_constants.OTAP_NUM_FALSE.
127    * @param o_otap_session The current session_record from OTAP_TEST package.
128    *
129    * @return A summary of the old session and details of the new session as text message LF delimited.
130    *
131    * @exception -20099 Internal error, invalid OTAP_SESSION object.
132    */
133    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
134  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
135  			   )
136  	 RETURN VARCHAR2
137    ;
