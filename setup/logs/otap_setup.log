203    FUNCTION otap_session_set( p_test_count		IN	      NUMBER
204  				, p_test_set		IN	      VARCHAR2
205  				, p_test_group		IN	      VARCHAR2
206  				, p_test_name		IN	      VARCHAR2
207  				, p_prefix		IN	      VARCHAR2
208  				, p_name_precedence	IN	      NUMBER
209  				, p_include_pkg 	IN	      NUMBER
210  				, p_persist		IN	      NUMBER
211  				, p_schema		IN	      VARCHAR2
212  				, p_user		IN	      VARCHAR2
213  				, p_executor		IN	      VARCHAR2
214  				, o_otap_session	IN OUT NOCOPY OTAP_SESSION
215  				)
216  	 RETURN VARCHAR2
217    IS
218  	 l_script    VARCHAR2(1024) := 'otap_objects.otap_session_set';
219  	 l_message   VARCHAR2(32767);
220  	 l_delimiter VARCHAR2(1);
221    BEGIN
222  	 -- verify the current object
223  	 otap_objects.otap_session_verify(o_otap_session);
224  	 -- now verify the input
225  	 IF    p_schema    IS NULL
226  	    OR p_user	   IS NULL
227  	    OR p_executor  IS NULL
228  	 THEN
229  	   l_message := 'ERROR otap_objects.otap_session_set. Invalid OTAP_SESSION initialization. NULL errors: ';
230  	   l_delimiter := '';
231  	   IF p_schema IS NULL
232  	   THEN
233  	     l_message := l_message || l_delimiter || 'p_schema';
234  	     l_delimiter := ',';
235  	   END IF;
236  	   IF p_user IS NULL
237  	   THEN
238  	     l_message := l_message || l_delimiter || 'p_user';
239  	     l_delimiter := ',';
240  	   END IF;
241  	   IF p_executor IS NULL
242  	   THEN
243  	     l_message := l_message || l_delimiter || 'p_executor';
244  	   END IF;
245  	   l_message := l_message || ' The variable default should never be overwritten by users.';
246  	   otap_log.log('EXCEPTION -20099 ' || l_message, l_script, 'p_schema IS NULL OR p_user IS NULL OR p_executor IS NULL');
247  	   RAISE_APPLICATION_ERROR(-20099, l_message);
248  	 END IF;
249  	 -- check prefix length
250  	 IF    LENGTH(p_prefix) <= 4
251  	    OR LENGTH(p_prefix) > 0
252  	 THEN
253  	   -- no delimiter allowed
254  	   IF REGEXP_INSTR(p_prefix, '[_|$|#]') = 0
255  	   THEN
256  	     o_otap_session.test_prefix := UPPER(TRIM(p_prefix));
257  	   ELSE
258  	     o_otap_session.test_prefix := otap_constants.OTAP_DEFAULT_PREFIX;
259  	     otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' delimiters _, $, # not allowed', l_script, 'REGEXP_INSTR(p_prefix, ''[_|$|#]'') = 0');
260  	   END IF;
261  	 ELSE
262  	   -- leave prefix as defined, log error
263  	   o_otap_session.test_prefix := otap_constants.OTAP_DEFAULT_PREFIX;
264  	   otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' length, only length 1-4 allowed', l_script, 'LENGTH(p_prefix) <= 4 OR LENGTH(p_prefix) > 0');
265  	 END IF;
266  	 -- check bool values
267  	 IF NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
268  	 THEN
269  	   o_otap_session.name_precedence := (NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) = otap_constants.OTAP_NUM_TRUE);
270  	 END IF;
271  	 IF NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
272  	 THEN
273  	   o_otap_session.include_packages := (NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
274  	 END IF;
275  	 IF NVL(p_persist, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
276  	 THEN
277  	   o_otap_session.persist_test := (NVL(p_persist, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
278  	 END IF;
279  	 -- now start setting the new values
280  	 o_otap_session.test_executor	:= p_executor;
281  	 o_otap_session.db_user 	:= p_user;
282  	 o_otap_session.db_schema	:= p_schema;
283  	 o_otap_session.intended_count	:= NVL(p_test_count, 0);
284  	 -- keep old values if not specified
285  	 o_otap_session.test_set	:= NVL(p_test_set, o_otap_session.test_set);
286  	 o_otap_session.test_group	:= NVL(p_test_group, o_otap_session.test_group);
287  	 o_otap_session.test_name	:= NVL(p_test_name, o_otap_session.test_name);
288  	 -- reset other session values
289  	 o_otap_session.test_count	:= 0;
290  	 o_otap_session.error_count	:= 0;
291  	 o_otap_session.session_start	:= SYSDATE;
292  	 o_otap_session.session_id	:= otap_test_session_seq.NEXTVAL;
293  	 -- set view id equal to session id
294  	 o_otap_session.session_view_id := o_otap_session.session_id;
295  	 l_message := otap_objects.otap_session_show(o_otap_session);
296  	 RETURN l_message;
297    EXCEPTION
298  	 WHEN OTHERS THEN
299  	   IF SQLCODE != -20099
300  	   THEN
301  	     -- log unhandled exceptions
302  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
303  	   END IF;
304  	   RAISE;
305    END otap_session_set;
