 98    FUNCTION get_report_total_details( p_sets	 IN INTEGER  DEFAULT 0
 99  					, p_groups	 IN INTEGER  DEFAULT 0
100  					, p_names	 IN INTEGER  DEFAULT 0
101  					, p_descriptions IN INTEGER  DEFAULT 0
102  					, p_min_fill	 IN INTEGER  DEFAULT otap_constants.OTAP_REPORT_MIN_FILL_LENGTH
103  					)
104  	 RETURN VARCHAR2
105    IS
106  	 l_return_text	 VARCHAR2(32767 CHAR);
107  	 l_template_text VARCHAR2(32767 CHAR);
108    BEGIN
109  	 -- fetch template: 'sets: @sets@ groups: @groups@ names: @names@ descriptions: @descs@'
110  	 l_template_text := otap_config_util.get_report_total_template;
111  	 -- replace variables
112  	 l_template_text := REPLACE(l_template_text, '@sets@', TRIM(TO_CHAR(NVL(p_sets, 0))));
113  	 l_template_text := REPLACE(l_template_text, '@groups@', TRIM(TO_CHAR(NVL(p_groups, 0))));
114  	 l_template_text := REPLACE(l_template_text, '@names@', TRIM(TO_CHAR(NVL(p_names, 0))));
115  	 l_template_text := REPLACE(l_template_text, '@descs@', TRIM(TO_CHAR(NVL(p_descriptions, 0))));
116  	 -- get borderless
117  	 l_return_text := otap_report.borderless( l_template_text
118  						, GREATEST(NVL(p_min_fill, otap_constants.OTAP_REPORT_MIN_FILL_LENGTH), NVL(LENGTH(l_template_text), 0), otap_config_util.get_length_headers)
119  						)
120  	 ;
121  	 RETURN l_return_text;
122    EXCEPTION
123  	 WHEN OTHERS THEN
124  	   otap_log.log(SQLERRM, 'otap_report.get_report_total_details', 'Report totals template replacement');
125  	   RAISE;
126    END get_report_total_details;
