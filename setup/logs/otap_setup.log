249    FUNCTION max_text_size(p_session_id IN NUMBER)
250  	 RETURN NUMBER
251    IS
252  	 l_script    VARCHAR2(1024 CHAR) := 'otap_api.otap_session_get_test_id';
253  	 l_return    NUMBER;
254  	 l_interval  NUMBER;
255    BEGIN
256  	 l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
257  	 -- execute the wrapped function in an extra block
258  	 BEGIN
259  	   l_return := otap_util.max_text_size(p_session_id);
260  	   -- now add the extra columns on the result line
261  	   SELECT LENGTH(((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval FROM dual;
262  	   l_return := l_return + l_interval + (2 * otap_util.get_length_test_state) + 3;
263  	 EXCEPTION
264  	   WHEN OTHERS THEN
265  	     -- consume error
266  	     otap_log.log(SQLERRM, l_script, 'Calling otap_util.max_text_size');
267  	     l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
268  	 END;
269  	 -- return or let exception happen
270  	 RETURN l_return;
271    END max_text_size;
