 54    FUNCTION init_test( p_test_count 	 IN	       NUMBER
 55  			 , p_test_set		 IN	       VARCHAR2
 56  			 , p_test_group 	 IN	       VARCHAR2
 57  			 , p_test_name		 IN	       VARCHAR2
 58  			 , p_prefix		 IN	       VARCHAR2
 59  			 , p_name_precedence	 IN	       NUMBER
 60  			 , p_include_pkg	 IN	       NUMBER
 61  			 , p_persist		 IN	       NUMBER
 62  			 , p_schema		 IN	       VARCHAR2
 63  			 , p_user		 IN	       VARCHAR2
 64  			 , p_executor		 IN	       VARCHAR2
 65  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
 66  			 )
 67  	 RETURN VARCHAR2
 68    IS
 69  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.init_test';
 70  	 l_message VARCHAR2(4000 CHAR);
 71    BEGIN
 72  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
 73  	 -- execute the wrapped function in an extra block
 74  	 BEGIN
 75  	   l_message := otap_plan.init_test(p_test_count, p_test_set, p_test_group, p_test_name, p_prefix, p_name_precedence, p_include_pkg, p_persist, p_schema, p_user, p_executor, o_otap_session);
 76  	 EXCEPTION
