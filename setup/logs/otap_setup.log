SQL> @@../otap_ddl/packages/otap_schema.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_schema
  2  AS
  3    -- for description see header file
  4    FUNCTION has_table( p_table_name   IN	 VARCHAR2
  5  			 , o_errors	     OUT VARCHAR2
  6  			 , p_schema	  IN	 VARCHAR2 DEFAULT NULL
  7  			 )
  8  	 RETURN INTEGER
  9    IS
 10  	 l_script	     VARCHAR2(1024) := 'otap_schema.has_table';
 11  	 l_has_table	     INTEGER;
 12  	 l_test_passed	     INTEGER;
 13  	 l_schema_to_use     VARCHAR2(128);
 14  	 l_table_name	     VARCHAR2(128);
 15  	 l_errors	     VARCHAR2(32767);
 16    BEGIN
 17  	 l_errors     := NULL;
 18  	 l_table_name := otap_string.reduce(p_table_name, 128);
 19  	 IF	l_table_name	    IS NOT NULL
 20  	    AND LENGTH(l_table_name) > 0
 21  	 THEN
 22  	   -- check description
 23  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
 24  	   SELECT COUNT(*)
 25  	     INTO l_has_table
 26  	     FROM dba_tables
 27  	    WHERE table_name = l_table_name
 28  	      AND owner      = l_schema_to_use
 29  	   ;
 30  	   -- we should find one or zero entries
 31  	   l_test_passed := CASE l_has_table
 32  			      WHEN 0
 33  			      THEN otap_constants.OTAP_NUM_TEST_FAILED
 34  			      WHEN 1
 35  			      THEN otap_constants.OTAP_NUM_TEST_PASSED
 36  			      ELSE otap_constants.OTAP_NUM_TEST_UNDEFINED
 37  			    END
 38  	   ;
 39  	   -- report abnormal results and store them in errors
 40  	   IF l_has_table NOT IN (0, 1)
 41  	   THEN
 42  	     l_errors := otap_string.reduce('Check table ' || l_table_name || ' with schema ' || l_schema_to_use || ' results in count ' || l_has_table, 4000);
 43  	     otap_log.log(l_errors, l_script, 'Table name or search condition not unique');
 44  	   END IF;
 45  	 ELSE
 46  	   -- invalid table name
 47  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 48  	   l_errors	       := 'Missing table name';
 49  	   otap_log.log(l_errors, l_script, 'NULL test on table name');
 50  	 END IF;
 51  	 o_errors := otap_string.reduce(l_errors, 4000);
 52  	 RETURN l_test_passed;
 53    EXCEPTION
 54  	 WHEN OTHERS THEN
 55  	   IF SQLCODE != -20099
 56  	   THEN
 57  	     -- log unhandled exceptions
 58  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 59  	   END IF;
 60  	   RAISE;
 61    END has_table;
 62  
 63  END;
 64  /

