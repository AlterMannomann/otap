260  	   l_statement := 'BEGIN';
261  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
262  	   l_statement := PREFIX_PLSQL || 'otap_test.init_test(' || TRIM(TO_CHAR(NVL(p_script_count, 0))) || ')' || POSTFIX_PLSQL;
263  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
