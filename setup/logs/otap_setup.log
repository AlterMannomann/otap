SQL> CREATE OR REPLACE PACKAGE otap_logic
  2  AS
  3    /**
  4    * Packages provides mainly functions to compare inputs against given values.
  5    * Functions are basically simple, only chance for errors are exceptions. No error return.
  6    */
  7  
  8    /** FUNCTION otap_logic.ok
  9    * Checks if a boolean expression result is TRUE. To test for FALSE just set expected result to otap_constants.OTAP_NUM_TEST_FAILED.
 10    *
 11    * @param p_boolean The result of a boolean expression to check.
 12    * @param o_error Error information, if any, on the test executed.
 13    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 14    *
 15    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 16    */
 17    FUNCTION ok( p_boolean	      IN	    BOOLEAN
 18  		  , o_errors		 OUT NOCOPY VARCHAR2
 19  		  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 20  		  )
 21  	 RETURN INTEGER
 22    ;
 23  
 24    /** FUNCTION otap_logic.is_eq
 25    * Checks given data of type VARCHAR2, NUMBER and DATE against a given value. As IS is a reserved word in Oracle
 26    * this is the equivalent of is and isnt. isnt is achieved by setting expected result to otap_constants.OTAP_NUM_TEST_FAILED.
 27    *
 28    * Other types are more or less problematic, e.g. you can't declare in Oracle a function with date and timestamp parameter. If providing
 29    * TIMESTAMP Oracle gets confused which function to use. Try to convert or cast the types to the base types. CAST will probably not
 30    * preserve all information. TO_CHAR is almost always an option.
 31    *
 32    * @param p_have The data to check.
 33    * @param p_want The expected data. Must have the same datatype as p_have.
 34    * @param o_error Error information, if any, on the test executed.
 35    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 36    *
 37    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 38    */
 39    FUNCTION is_eq( p_have		 IN	       VARCHAR2
 40  		     , p_want		 IN	       VARCHAR2
 41  		     , o_errors 	    OUT NOCOPY VARCHAR2
 42  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 43  		     )
 44  	 RETURN INTEGER
 45    ;
 46    FUNCTION is_eq( p_have		 IN	       NUMBER
 47  		     , p_want		 IN	       NUMBER
 48  		     , o_errors 	    OUT NOCOPY VARCHAR2
 49  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 50  		     )
 51  	 RETURN INTEGER
 52    ;
 53    FUNCTION is_eq( p_have		 IN	       DATE
 54  		     , p_want		 IN	       DATE
 55  		     , o_errors 	    OUT NOCOPY VARCHAR2
 56  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 57  		     )
 58  	 RETURN INTEGER
 59    ;
 60  
 61    /** FUNCTION otap_logic.match_regex
 62    * Checks given data of type VARCHAR2 against an Oracle REGEX expression. Uses REGEXP_LIKE.
 63    * ATTENTION Oracle REGEX implementation is not standard. Unix regex which work like charm take hours to implement in
 64    * Oracle REGEX to work as desired. Test your expression well with Oracle before using it. Keep it simple to get it work.
 65    *
 66    * Easiest way to check is SELECT COUNT(*) FROM dual WHERE regexp_like('your string', 'your regex', 'regex param');
 67    * Should result in 1 if successful checked. You may want to prepare a with block with different string to pass them
 68    * through the regular expression.
 69    *
 70    * @param p_have The data to check.
 71    * @param p_regex A valid Oracle regular expression that p_have must match. Mandatory.
 72    * @param o_error Error information, if any, on the test executed.
 73    * @param p_param Optional valid parameter for REGEXP_LIKE. 'i' means case insensitive. Parameters are case sensitive. See Oracle documentation for details, https://docs.oracle.com/en/database/oracle/oracle-database/21/sqlrf/Pattern-matching-Conditions.html#GUID-D2124F3A-C6E4-4CCA-A40E-2FFCABFD8E19.
 74    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 75    *
 76    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 77    */
 78    FUNCTION match_regex( p_have	       IN	     VARCHAR2
 79  			   , p_regex	       IN	     VARCHAR2
 80  			   , o_errors		  OUT NOCOPY VARCHAR2
 81  			   , p_param	       IN	     VARCHAR2 DEFAULT NULL
 82  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 83  			   )
 84  	 RETURN INTEGER
 85    ;
 86  
 87    /** FUNCTION otap_logic.match_like
 88    * Checks given data of type VARCHAR2 against an Oracle LIKE expression. LIKE is currently more reliable and easier
 89    * to use than Oracle REGEX implementation. But also much more limited.
 90    *
 91    * @param p_have The data to check.
 92    * @param p_like A valid Oracle like expression that p_have must match. Mandatory.
 93    * @param o_error Error information, if any, on the test executed.
 94    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 95    *
 96    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 97    */
 98    FUNCTION match_like( p_have	      IN	    VARCHAR2
 99  			  , p_like	      IN	    VARCHAR2
100  			  , o_errors		 OUT NOCOPY VARCHAR2
101  			  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
102  			  )
103  	 RETURN INTEGER
104    ;
105  
106  END;
