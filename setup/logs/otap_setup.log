649    FUNCTION has_table( p_table_name      IN 	   VARCHAR2
650  			 , o_otap_session    IN OUT NOCOPY OTAP_SESSION
651  			 , p_schema	     IN 	   VARCHAR2	DEFAULT NULL
652  			 , p_description     IN 	   VARCHAR2	DEFAULT NULL
653  			 , p_expected_result IN 	   NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
654  			 )
655  	 RETURN VARCHAR2
656    IS
657  	 l_script	    VARCHAR2(1024 CHAR) 		 := 'otap_api.has_table';
658  	 l_start	    TIMESTAMP;
659  	 l_end		    TIMESTAMP;
660  	 l_result	    INTEGER;
661  	 l_return	    VARCHAR2(4000 CHAR);
662  	 l_errors	    otap_results.test_errors%TYPE;
663  	 l_schema	    otap_results.db_schema%TYPE;
664  	 l_desc 	    otap_results.test_desc%TYPE;
665  	 l_tmp_otap_session OTAP_SESSION;
666    BEGIN
667  	 l_start  := SYSTIMESTAMP;
668  	 -- default return
669  	 l_return := otap_config_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED) || ' ' || otap_constants.OTAP_CHAR_NA;
670  	 -- own begin-end for the transaction after the function
671  	 BEGIN
672  	   -- own begin-end block for the function itself and prepare
673  	   BEGIN
674  	     l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
675  	     l_desc   := otap_string.reduce(NVL(p_description, otap_report.get_has_table_msg(p_table_name, l_schema)), 256);
676  	     -- call function
677  	     l_result := otap_schema.has_table( p_table_name
678  					      , l_errors
679  					      , l_schema
680  					      , p_expected_result
681  					      )
682  	     ;
683  	   EXCEPTION
684  	     WHEN OTHERS THEN
685  	     -- consume error
686  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
687  	     l_errors := otap_string.reduce('Internal error has_table: ' || SQLERRM, 4000);
688  	     otap_log.log(SQLERRM, l_script, 'Execute has_table function');
689  	   END;
690  	   l_end := SYSTIMESTAMP;
691  	   -- set session variable according current value, a part where otap could fail
692  	   l_tmp_otap_session		 := otap_objects.otap_session_copy(o_otap_session);
693  	   l_tmp_otap_session.db_schema  := l_schema;
694  	   -- try to write the test record
695  	   otap_plan.write_test_result(l_desc, l_tmp_otap_session, l_result, l_start, l_end, l_errors);
696  	   otap_objects.otap_session_add_test(l_result, o_otap_session);
697  	   l_return := otap_config_util.test_result_to_text(l_result) || ' ' || l_desc;
698  	 EXCEPTION
699  	   WHEN OTHERS THEN
700  	     -- consume error
701  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
702  	     l_errors := otap_string.reduce('Internal error has_table: ' || SQLERRM, 4000);
703  	     otap_log.log(SQLERRM, l_script, 'Execute has_table function');
704  	     -- try again to write a record with the new informations, which may again raise an exception
705  	     l_tmp_otap_session 	   := otap_objects.otap_session_copy(o_otap_session);
706  	     l_tmp_otap_session.db_schema  := l_schema;
707  	     l_end := SYSTIMESTAMP;
708  	     otap_plan.write_test_result(l_desc, l_tmp_otap_session, l_result, l_start, l_end, l_errors);
709  	     l_desc   := otap_string.reduce(NVL(p_description, otap_report.get_has_table_msg(p_table_name, l_schema)), 256);
710  	     l_return := otap_config_util.test_result_to_text(l_result) || ' ' || l_desc;
711  	 END;
712  	 -- return result or let exception happen
713  	 RETURN l_return;
714    END has_table;
715  
