 25    FUNCTION init_test( p_test_count      IN NUMBER	 DEFAULT 0
 26  			 , p_test_set	     IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_TEST_SET
 27  			 , p_test_group      IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_TEST_GROUP
 28  			 , p_test_name	     IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_TEST_NAME
 29  			 , p_prefix	     IN VARCHAR2 DEFAULT otap_constants.OTAP_DEFAULT_PREFIX
 30  			 , p_name_precedence IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_TRUE
 31  			 , p_include_pkg     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 32  			 , p_persist	     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 33  			 -- internal variables from caller environment DO NOT SET them explicitely
 34  			 -- you may want to set p_schema, which is the default schema used for object searches
 35  			 -- but schema test functions provide a schema override, so in general there is no need
 36  			 -- for overwritting this value
 37  			 -- currently no save way exists to get the correct values from inside a procedure of function
 38  			 , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 39  			 , p_user	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_USER')
 40  			 , p_executor	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'SESSION_USER')
 41  			 )
 42  	 RETURN VARCHAR2
 43    IS
 44  	 l_message VARCHAR2(4000);
 45    BEGIN
 46  	 l_message := otap_plan.init_test( NVL(p_test_count, 0)
 47  					 , NVL(p_test_set, otap_constants.OTAP_DEFAULT_TEST_SET)
 48  					 , NVL(p_test_group, otap_constants.OTAP_DEFAULT_TEST_GROUP)
 49  					 , NVL(p_test_name, otap_constants.OTAP_DEFAULT_TEST_NAME)
 50  					 , NVL(p_prefix, otap_constants.OTAP_DEFAULT_PREFIX)
 51  					 , NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE)
 52  					 , NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE)
 53  					 , NVL(p_persist, otap_constants.OTAP_NUM_FALSE)
 54  					 , p_schema
 55  					 , p_user
 56  					 , p_executor
 57  					 , session_record
 58  					 )
 59  	 ;
 60  	 RETURN l_message;
 61    EXCEPTION
 62  	 WHEN OTHERS THEN
 63  	   IF SQLCODE != -20099
 64  	   THEN
 65  	     otap_util.log(SQLERRM, 'otap_test.init_test', 'l_message := otap_plan.init_test( p_test_count ...');
 66  	   END IF;
 67  	   RAISE;
 68    END init_test;
 69  
 70    FUNCTION finish_test(p_write_count_rec IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
 71  	 RETURN VARCHAR2
 72    IS
 73  	 l_message VARCHAR2(4000);
 74    BEGIN
 75  	 l_message := otap_plan.finish_test(p_write_count_rec, session_record);
 76  	 RETURN l_message;
 77    EXCEPTION
 78  	 WHEN OTHERS THEN
 79  	   IF SQLCODE != -20099
 80  	   THEN
 81  	     otap_util.log(SQLERRM, 'otap_test.finish_test', 'l_message := otap_plan.finish_test(p_write_count_rec, session_record)');
 82  	   END IF;
 83  	   RAISE;
 84    END finish_test;
 85  
 86    FUNCTION result_view(p_session_id IN NUMBER)
 87  	 RETURN otap_view_result_tbl PIPELINED
 88    IS
 89  	 l_delim_updown VARCHAR2(1) := '=';
 90  	 l_delim_tests	VARCHAR2(1) := '-';
 91  	 l_text_column	VARCHAR2(4000);
 92  	 l_has_errors	INTEGER;
 93  	 l_has_records	INTEGER;
 94  	 CURSOR cur_test_sets(cp_session_id IN NUMBER)
 95  	 IS
 96  	   SELECT test_set
 97  		, COUNT(*) AS test_runs
 98  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
 99  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
100  		, TRIM(TO_CHAR(((MAX(test_run_date) - MIN(test_run_date)) DAY TO SECOND))) AS run_time
101  	     FROM otap_results
102  	    WHERE test_session_id = cp_session_id
103  	    GROUP BY test_set
104  	    ORDER BY MIN(test_run_date)
105  	 ;
106  	 CURSOR cur_test_groups( cp_session_id IN NUMBER
107  			       , cp_test_set   IN VARCHAR2
108  			       )
109  	 IS
110  	   SELECT test_group
111  		, COUNT(*) AS test_runs
112  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
113  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
114  		, TRIM(TO_CHAR(((MAX(test_run_date) - MIN(test_run_date)) DAY TO SECOND))) AS run_time
115  	     FROM otap_results
116  	    WHERE test_session_id = cp_session_id
117  	      AND test_set	  = cp_test_set
118  	    GROUP BY test_group
119  	    ORDER BY MIN(test_run_date)
120  	 ;
121  	 CURSOR cur_test_names( cp_session_id IN NUMBER
122  			      , cp_test_set   IN VARCHAR2
123  			      , cp_test_group IN VARCHAR2
124  			      )
125  	 IS
126  	   SELECT test_name
127  		, COUNT(*) AS test_runs
128  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
129  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
130  		, TRIM(TO_CHAR(((MAX(test_run_date) - MIN(test_run_date)) DAY TO SECOND))) AS run_time
131  	     FROM otap_results
132  	    WHERE test_session_id = cp_session_id
133  	      AND test_set	  = cp_test_set
134  	      AND test_group	  = cp_test_group
135  	    GROUP BY test_name
136  	    ORDER BY MIN(test_run_date)
137  	 ;
138  	 CURSOR cur_tests( cp_session_id IN NUMBER
139  			 , cp_test_set	 IN VARCHAR2
140  			 , cp_test_group IN VARCHAR2
141  			 , cp_test_name  IN VARCHAR2
142  			 )
143  	 IS
144  	   SELECT test_desc
145  		, test_passed
146  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
147  		, test_errors
148  	     FROM otap_results
149  	    WHERE test_session_id = cp_session_id
150  	      AND test_set	  = cp_test_set
151  	      AND test_group	  = cp_test_group
152  	      AND test_name	  = cp_test_name
153  	    ORDER BY test_run_date
154  	 ;
155    BEGIN
156  	 -- header row
157  	 l_text_column := RPAD(l_delim_updown, 27, l_delim_updown) || ' OTAP test summary start ' || RPAD(l_delim_updown, 28, l_delim_updown);
158  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
159  	 l_text_column := 'Test session id: ' || p_session_id;
160  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
161  	 -- check for records
162  	 SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
163  	 IF l_has_records > 0
164  	 THEN
165  	   -- loop through the set
166  	   FOR rec_set IN cur_test_sets(p_session_id)
167  	   LOOP
168  	     -- build the set
169  	     l_text_column := rec_set.test_set || ' ' ||
170  			      'run time: ' || rec_set.run_time || ' (' ||
171  			      'runs: ' || TRIM(TO_CHAR(rec_set.test_runs)) || ' ' ||
172  			      'errors: ' || TRIM(TO_CHAR(rec_set.test_errors)) || ' ' ||
173  			      'issues: ' || TRIM(TO_CHAR(rec_set.setup_errors)) || ')'
174  	     ;
175  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
176  	     -- loop through the group
177  	     FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set)
178  	     LOOP
179  	       -- build the group
180  	       l_text_column := ' - ' || rec_grp.test_group || ' ' ||
181  				'run time: ' || rec_grp.run_time || ' (' ||
182  				'runs: ' || TRIM(TO_CHAR(rec_grp.test_runs)) || ' ' ||
183  				'errors: ' || TRIM(TO_CHAR(rec_grp.test_errors)) || ' ' ||
184  				'issues: ' || TRIM(TO_CHAR(rec_grp.setup_errors)) || ')'
185  	       ;
186  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
187  	       -- loop through the names
188  	       FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group)
189  	       LOOP
190  		 -- build the name
191  		 l_text_column := '  - ' || rec_nam.test_name || ' ' ||
192  				  'run time: ' || rec_nam.run_time || ' (' ||
193  				  'runs: ' || TRIM(TO_CHAR(rec_nam.test_runs)) || ' ' ||
194  				  'errors: ' || TRIM(TO_CHAR(rec_nam.test_errors)) || ' ' ||
195  				  'issues: ' || TRIM(TO_CHAR(rec_nam.setup_errors)) || ')'
196  		 ;
197  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
198  		 -- build delimiter for tests
199  		 l_text_column := RPAD(l_delim_tests, 20, l_delim_tests) || ' ' || rec_nam.test_name || ' test results ' || RPAD(l_delim_tests, 20, l_delim_tests);
200  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
201  		 -- build header
202  		 l_text_column := 'Result    Setup     Runtime		   Test';
203  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
204  		 l_text_column := '--------- --------- ------------------- ----------------------------------------';
205  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
206  		 -- loop through the tests
207  		 FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
208  		 LOOP
209  		   l_text_column := RPAD(otap_constants.translate_test_result(rec_tst.test_passed), 10) ||
210  				    RPAD(CASE WHEN rec_tst.test_errors IS NULL THEN otap_constants.OTAP_CHAR_TEST_PASSED ELSE otap_constants.OTAP_CHAR_TEST_FAILED END, 10) ||
211  				    rec_tst.run_time || ' ' ||
212  				    TRIM(rec_tst.test_desc)
213  		   ;
214  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
215  		 END LOOP;
216  		 SELECT COUNT(*)
217  		   INTO l_has_errors
218  		   FROM otap_results
219  		  WHERE test_session_id = p_session_id
220  		    AND test_set	= rec_set.test_set
221  		    AND test_group	= rec_grp.test_group
222  		    AND test_name	= rec_nam.test_name
223  		    AND test_errors    IS NOT NULL
224  		 ;
225  		 IF l_has_errors > 0
226  		 THEN
227  		   -- build error delimiter for tests
228  		   l_text_column := RPAD(l_delim_tests, 20, l_delim_tests) || ' ' || rec_nam.test_name || ' test errors ' || RPAD(l_delim_tests, 20, l_delim_tests);
229  		   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
230  		   FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
231  		   LOOP
232  		     IF rec_tst.test_errors IS NOT NULL
233  		     THEN
234  		       l_text_column := '- ' || TRIM(rec_tst.test_desc) || ': ' || REGEXP_REPLACE(rec_tst.test_errors, '\s{2,}', ' ');
235  		       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
236  		     END IF;
237  		   END LOOP;
238  		 END IF;
239  		 -- build end delimiter for tests
240  		 l_text_column := RPAD(l_delim_tests, 20, l_delim_tests) || ' ' || rec_nam.test_name || ' test done ' || RPAD(l_delim_tests, 20, l_delim_tests);
241  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
242  	       END LOOP;
243  	     END LOOP;
244  	   END LOOP;
245  	 ELSE
246  	   l_text_column := 'NO_DATA - no tests found for test session id ' || p_session_id;
247  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
248  	 END IF;
249  	 -- footer row
250  	 l_text_column := RPAD(l_delim_updown, 28, l_delim_updown) || ' OTAP test summary end ' || RPAD(l_delim_updown, 29, l_delim_updown);
251  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
252  	 RETURN;
253    EXCEPTION
254  	 WHEN OTHERS THEN
255  	   IF SQLCODE != -20099
256  	   THEN
257  	     otap_util.log(SQLERRM, 'otap_test.result_view', 'Unhandled exception otap_test.result_view');
258  	   END IF;
259  	   RAISE;
260    END result_view;
