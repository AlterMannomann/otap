 86    FUNCTION result_view(p_session_id IN NUMBER)
 87  	 RETURN otap_view_result_tbl PIPELINED
 88    IS
 89  	 l_delim_updown VARCHAR2(1 CHAR) := '=';
 90  	 l_delim_tests	VARCHAR2(1 CHAR) := '-';
 91  	 l_text_column	VARCHAR2(4000 CHAR);
 92  	 l_has_errors	INTEGER;
 93  	 l_has_records	INTEGER;
 94  	 l_report_size	INTEGER;
 95  	 CURSOR cur_test_sets(cp_session_id IN NUMBER)
 96  	 IS
 97  	   SELECT test_set
 98  		, COUNT(*) AS test_runs
 99  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
100  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
101  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
102  	     FROM otap_results
103  	    WHERE test_session_id = cp_session_id
104  	      AND test_name	 != otap_api.get_text_test_count_name
105  	    GROUP BY test_set
106  	    ORDER BY MIN(test_run_date)
107  	 ;
108  	 CURSOR cur_test_groups( cp_session_id IN NUMBER
109  			       , cp_test_set   IN VARCHAR2
110  			       )
111  	 IS
112  	   SELECT test_group
113  		, COUNT(*) AS test_runs
114  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
115  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
116  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
117  	     FROM otap_results
118  	    WHERE test_session_id = cp_session_id
119  	      AND test_set	  = cp_test_set
120  	      AND test_name	 != otap_api.get_text_test_count_name
121  	    GROUP BY test_group
122  	    ORDER BY MIN(test_run_date)
123  	 ;
124  	 CURSOR cur_test_names( cp_session_id IN NUMBER
125  			      , cp_test_set   IN VARCHAR2
126  			      , cp_test_group IN VARCHAR2
127  			      )
128  	 IS
129  	   SELECT test_name
130  		, COUNT(*) AS test_runs
131  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
132  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
133  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
134  	     FROM otap_results
135  	    WHERE test_session_id = cp_session_id
136  	      AND test_set	  = cp_test_set
137  	      AND test_group	  = cp_test_group
138  	      AND test_name	 != otap_api.get_text_test_count_name
139  	    GROUP BY test_name
140  	    ORDER BY MIN(test_run_date)
141  	 ;
142  	 CURSOR cur_test_count(cp_session_id IN NUMBER)
143  	 IS
144  	   SELECT test_name
145  		, COUNT(*) AS test_runs
146  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
147  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
148  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
149  	     FROM otap_results
150  	    WHERE test_session_id = cp_session_id
151  	      AND test_name	  = otap_api.get_text_test_count_name
152  	    GROUP BY test_name
153  	    ORDER BY MIN(test_run_date)
154  	 ;
155  	 CURSOR cur_session_total(cp_session_id IN NUMBER)
156  	 IS
157  	   SELECT test_session_id
158  		, COUNT(DISTINCT test_set) AS test_sets
159  		, COUNT(DISTINCT test_group) AS test_groups
160  		, COUNT(DISTINCT test_name) AS test_names
161  		, COUNT(DISTINCT test_desc) AS test_descs
162  		, COUNT(*) AS test_runs
163  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
164  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
165  		, TRIM((MAX(test_end) - MIN(test_start)) DAY TO SECOND) AS run_time
166  	     FROM otap_results
167  	    WHERE test_session_id = cp_session_id
168  		  -- exclude optional extra total count test
169  	      AND test_name	 != otap_api.get_text_test_count_name
170  	    GROUP BY test_session_id
171  	    ORDER BY MIN(test_run_date)
172  	 ;
173  	 CURSOR cur_tests( cp_session_id IN NUMBER
174  			 , cp_test_set	 IN VARCHAR2
175  			 , cp_test_group IN VARCHAR2
176  			 , cp_test_name  IN VARCHAR2
177  			 )
178  	 IS
179  	   SELECT test_desc
180  		, test_passed
181  		, otap_api.test_result_to_text(test_passed) AS test_state
182  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
183  		, test_errors
184  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
185  	     FROM otap_results
186  	    WHERE test_session_id = cp_session_id
187  	      AND test_set	  = cp_test_set
188  	      AND test_group	  = cp_test_group
189  	      AND test_name	  = cp_test_name
190  	    ORDER BY test_run_date
191  	 ;
192  	 CURSOR cur_count_tests( cp_session_id IN NUMBER
193  			       , cp_test_name  IN VARCHAR2
194  			       )
195  	 IS
196  	   SELECT test_desc
197  		, test_passed
198  		, otap_api.test_result_to_text(test_passed) AS test_state
199  		, TRIM(TO_CHAR(((test_end - test_start) DAY TO SECOND))) AS run_time
200  		, test_errors
201  		, otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END) AS issue_state
202  	     FROM otap_results
203  	    WHERE test_session_id = cp_session_id
204  	      AND test_name	  = cp_test_name
205  	    ORDER BY test_run_date
206  	 ;
207    BEGIN
208  	 l_report_size := otap_api.max_text_size(p_session_id);
209  	 -- header row
210  	 l_text_column := otap_api.get_report_header(l_report_size);
211  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
212  	 l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
213  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
214  	 -- check for records
215  	 SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
216  	 IF l_has_records > 0
217  	 THEN
218  	   -- loop through the set
219  	   FOR rec_set IN cur_test_sets(p_session_id)
220  	   LOOP
221  	     -- build test set column
222  	     l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size);
223  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
224  	     -- build test set summary
225  	     l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size);
226  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
227  	     -- loop through the group
228  	     FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set)
229  	     LOOP
230  	       l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size);
231  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
232  	       -- build test set summary
233  	       l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size);
234  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
235  	       -- loop through the names
236  	       FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group)
237  	       LOOP
238  		 l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size);
239  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
240  		 -- build test set summary
241  		 l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size);
242  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
243  		 -- build header
244  		 l_text_column := otap_api.get_result_header(l_report_size);
245  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
246  		 l_text_column := otap_api.get_result_underline(l_report_size);
247  		 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
248  		 -- loop through the tests
249  		 FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
250  		 LOOP
251  		   l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
252  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
253  		 END LOOP;
254  		 SELECT COUNT(*)
255  		   INTO l_has_errors
256  		   FROM otap_results
257  		  WHERE test_session_id = p_session_id
258  		    AND test_set	= rec_set.test_set
259  		    AND test_group	= rec_grp.test_group
260  		    AND test_name	= rec_nam.test_name
261  		    AND test_errors    IS NOT NULL
262  		 ;
263  		 IF l_has_errors > 0
264  		 THEN
265  		   -- build error delimiter for tests
266  		   l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size);
267  		   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
268  		   FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name)
269  		   LOOP
270  		     IF rec_tst.test_errors IS NOT NULL
271  		     THEN
272  		       l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
273  		       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
274  		     END IF;
275  		   END LOOP;
276  		 END IF;
277  	       END LOOP;
278  	     END LOOP;
279  	   END LOOP;
280  	   -- no loop through the test count if exists
281  	   FOR rec IN cur_test_count(p_session_id)
282  	   LOOP
283  	     -- build header
284  	     l_text_column := otap_api.get_test_count_header(l_report_size);
285  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
286  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
287  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
288  	     -- build header
289  	     l_text_column := otap_api.get_result_header(l_report_size);
290  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
291  	     l_text_column := otap_api.get_result_underline(l_report_size);
292  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
293  	     -- loop through the tests
294  	     FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
295  	     LOOP
296  	       l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size);
297  	       PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
298  	     END LOOP;
299  	     SELECT COUNT(*)
300  	       INTO l_has_errors
301  	       FROM otap_results
302  	      WHERE test_session_id = p_session_id
303  		AND test_name	    = rec.test_name
304  		AND test_errors    IS NOT NULL
305  	     ;
306  	     IF l_has_errors > 0
307  	     THEN
308  	       -- build error delimiter for tests
309  	       l_text_column := otap_api.get_error_result_header(rec.test_name, l_report_size);
310  	       PIPE ROW (otap_view_result_rec(l_text_column, NULL));
311  	       FOR rec_tst IN cur_count_tests(p_session_id, rec.test_name)
312  	       LOOP
313  		 IF rec_tst.test_errors IS NOT NULL
314  		 THEN
315  		   l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size);
316  		   PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
317  		 END IF;
318  	       END LOOP;
319  	     END IF;
320  	   END LOOP;
321  	   -- eventually build the totals for the test session
322  	   l_text_column := otap_api.get_report_total(l_report_size);
323  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
324  	   FOR rec IN cur_session_total(p_session_id)
325  	   LOOP
326  	     l_text_column := otap_api.get_report_total_details(rec.test_sets, rec.test_groups, rec.test_names, rec.test_descs, l_report_size);
327  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
328  	     l_text_column := otap_api.get_summary(rec.run_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size);
329  	     PIPE ROW (otap_view_result_rec(l_text_column, NULL));
330  	   END LOOP;
331  	 ELSE
332  	   l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size);
333  	   PIPE ROW (otap_view_result_rec(l_text_column, NULL));
334  	 END IF;
335  	 -- footer row
336  	 l_text_column := otap_api.get_report_footer(l_report_size);
337  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
338  	 -- add AI and copyrigth
339  	 l_text_column := '(C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
340  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
341  	 l_text_column := 'and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
342  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
343  	 l_text_column := 'Not allowed to be used as AI training material without explicite permission.';
344  	 PIPE ROW (otap_view_result_rec(l_text_column, NULL));
345  	 RETURN;
346    EXCEPTION
347  	 WHEN NO_DATA_NEEDED THEN
348  	   RAISE;
349  	 WHEN OTHERS THEN
350  	   IF SQLCODE != -20099
351  	   THEN
352  	     otap_log.log(SQLERRM, 'otap_test.result_view', 'Unhandled exception otap_test.result_view');
353  	   END IF;
354  	   RAISE;
355    END result_view;
