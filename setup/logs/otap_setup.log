612    FUNCTION get_length_headers(p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA)
613  	 RETURN NUMBER
614    IS
615  	 l_return INTEGER;
616    BEGIN
617  	 -- consider possible translations, fetch from otap_identifiers_v
618  	 -- length does not change on upper, lower or init capitals
619  	 SELECT MAX(LENGTH(label_text_lower))
620  	   INTO l_return
621  	   FROM otap_identifiers_v
622  	  WHERE otap_identifier IN ( otap_util.CFG_TEXT_REPORT_START
623  				   , otap_util.CFG_TEXT_REPORT_END
624  				   , otap_util.CFG_TEXT_REPORT_TOTAL
625  				   )
626  				   -- language fallback included
627  	    AND language_id	IN (UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA)), otap_constants.OTAP_INTERNAL_NA)
628  	 ;
629  	 RETURN l_return;
630    EXCEPTION
631  	 WHEN OTHERS THEN
632  	   otap_log.log(SQLERRM, 'otap_util.get_length_headers', 'Get MAX length for config values');
633  	   RAISE;
634    END get_length_headers;
