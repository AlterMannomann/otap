403    FUNCTION throws_ok( p_statement	     IN 	   VARCHAR2
404  			 , p_sqlerrm	     IN 	   VARCHAR2
405  			 , o_errors		OUT NOCOPY VARCHAR2
406  			 , p_header_def      IN 	   VARCHAR2 DEFAULT NULL
407  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
408  			 )
409  	 RETURN INTEGER
410    IS
411  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_ok';
412  	 l_test_passed	 INTEGER;
413  	 l_expected	 INTEGER;
414  	 l_errors	 VARCHAR2(32767 CHAR);
415  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
416  	 l_sqlcode	 NUMBER;
417    BEGIN
418  	 l_errors      := NULL;
419  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
420  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
421  	 IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
422  	 THEN
423  	   IF l_sqlerrm = p_sqlerrm
424  	   THEN
425  	     l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
426  	   ELSE
427  	     -- decide which case happened
428  	     IF l_sqlcode = -20100
429  	     THEN
430  	       -- invalid header, l_errors should be set and logged already
431  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
432  	     ELSE
433  	       -- exception happened but does not match
434  	       l_errors      := l_errors || 'Given error message does not match with ' || l_sqlerrm;
435  	       l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
436  	       otap_log.log(l_errors, l_script);
437  	     END IF;
438  	   END IF;
439  	 ELSE
440  	   -- no exception raised, l_errors should be set and logged already
441  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
442  	   otap_log.log(l_errors, l_script);
443  	 END IF;
444  	 -- now decide on the expected result the final state and if errors are returned
445  	 IF l_test_passed != l_expected
446  	 THEN
447  	   o_errors := otap_string.reduce(l_errors, 4000);
448  	 ELSE
449  	   -- overwrite states from before, as we fulfill expected
450  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
451  	   -- overwrite errors expected
452  	   o_errors := NULL;
453  	 END IF;
454  	 RETURN l_test_passed;
455    EXCEPTION
456  	 WHEN OTHERS THEN
457  	   IF SQLCODE != -20099
458  	   THEN
459  	     -- log unhandled exceptions
460  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
461  	   END IF;
462  	   RAISE;
463    END throws_ok;
