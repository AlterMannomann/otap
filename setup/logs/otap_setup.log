494    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
495  	 RETURN VARCHAR2
496    IS
497  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_finish';
498  	 l_message VARCHAR2(4000);
499    BEGIN
500  	 -- object gets verified by summary for old session
501  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_LF;
502  	 -- reset values
503  	 o_otap_session.test_count     := 0;
504  	 o_otap_session.error_count    := 0;
505  	 o_otap_session.intended_count := 0;
506  	 o_otap_session.test_set       := otap_constants.OTAP_DEFAULT_TEST_SET;
507  	 o_otap_session.test_group     := otap_constants.OTAP_DEFAULT_TEST_GROUP;
508  	 o_otap_session.test_name      := otap_constants.OTAP_DEFAULT_TEST_NAME;
509  	 o_otap_session.session_start  := SYSDATE;
510  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
511  	 -- do not update the session_view_id so it will keep the old or any set value
512  	 -- every init will set the session_view_id to the current session id
513  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
514  	 RETURN l_message;
515    EXCEPTION
516  	 WHEN OTHERS THEN
517  	   IF SQLCODE != -20099
518  	   THEN
519  	     -- log unhandled exceptions
520  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
521  	   END IF;
522  	   RAISE;
523    END otap_session_finish;
524  
525  END;
526  /

