SQL> CREATE OR REPLACE PACKAGE BODY otap_api
  2  AS
  3    -- for description see header file
  4    PROCEDURE validate_otap(o_otap_session IN OUT NOCOPY OTAP_SESSION)
  5    IS
  6  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.validate_otap';
  7  	 l_errors  INTEGER;
  8    BEGIN
  9  	 SELECT COUNT(*)
 10  	   INTO l_errors
 11  	   FROM dba_objects
 12  	  WHERE owner = otap_constants.get_otap_schema
 13  	    AND status != 'VALID'
 14  	 ;
 15  	 IF l_errors > 0
 16  	 THEN
 17  	   -- log the error
 18  	   otap_log.log('-20099 The otap system is not valid. INVALID objects exist. Ask your admin to fix the system before testing.', l_script);
 19  	   -- only direct testing could call this currently as table has a NOT NULL constraint
 20  	   RAISE_APPLICATION_ERROR(-20099, 'The otap system is not valid. INVALID objects exist. Ask your admin to fix the system before testing.');
 21  	 END IF;
 22  	 SELECT COUNT(*)
 23  	   INTO l_errors
 24  	   FROM dba_triggers
 25  	  WHERE owner = otap_constants.get_otap_schema
 26  	    AND status != 'ENABLED'
 27  	 ;
 28  	 IF l_errors > 0
 29  	 THEN
 30  	   -- log the error
 31  	   otap_log.log('-20099 The otap system is not valid. Triggers are not enabled. Ask your admin to fix the system before testing.', l_script);
 32  	   -- only direct testing could call this currently as table has a NOT NULL constraint
 33  	   RAISE_APPLICATION_ERROR(-20099, 'The otap system is not valid. Triggers are not enabled. Ask your admin to fix the system before testing.');
 34  	 END IF;
 35  	 SELECT COUNT(*)
 36  	   INTO l_errors
 37  	   FROM otap_translate
 38  	  WHERE TRIM(UPPER(otap_identifier)) IN (SELECT config_name FROM otap_config WHERE translatable = otap_constants.get_otap_num_false)
 39  	 ;
 40  	 IF l_errors > 0
 41  	 THEN
 42  	   -- log the error
 43  	   otap_log.log('-20099 The otap system is not valid. OTAP_TRANSLATE contains invalid entries. Ask your admin to fix the system before testing.', l_script);
 44  	   -- only direct testing could call this currently as table has a NOT NULL constraint
 45  	   RAISE_APPLICATION_ERROR(-20099, 'The otap system is not valid. OTAP_TRANSLATE contains invalid entries. Ask your admin to fix the system before testing.');
 46  	 END IF;
 47  	 -- if all passed, check the session id, if not set, fetch sequence next val for new user
 48  	 IF o_otap_session.session_id = 0
 49  	 THEN
 50  	   o_otap_session.session_id := otap_test_session_seq.NEXTVAL;
 51  	 END IF;
 52    END validate_otap;
 53  
 54    FUNCTION init_test( p_test_count 	 IN	       NUMBER
 55  			 , p_test_set		 IN	       VARCHAR2
 56  			 , p_test_group 	 IN	       VARCHAR2
 57  			 , p_test_name		 IN	       VARCHAR2
 58  			 , p_prefix		 IN	       VARCHAR2
 59  			 , p_name_precedence	 IN	       NUMBER
 60  			 , p_include_pkg	 IN	       NUMBER
 61  			 , p_persist		 IN	       NUMBER
 62  			 , p_schema		 IN	       VARCHAR2
 63  			 , p_user		 IN	       VARCHAR2
 64  			 , p_executor		 IN	       VARCHAR2
 65  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
 66  			 )
 67  	 RETURN VARCHAR2
 68    IS
 69  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.init_test';
 70  	 l_message VARCHAR2(4000 CHAR);
 71    BEGIN
 72  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
 73  	 -- execute the wrapped function in an extra block
 74  	 BEGIN
 75  	   l_message := otap_plan.init_test(p_test_count, p_test_set, p_test_group, p_test_name, p_prefix, p_name_precedence, p_include_pkg, p_persist, p_schema, p_user, p_executor, o_otap_session);
 76  	 EXCEPTION
 77  	   WHEN OTHERS THEN
 78  	     -- consume error
 79  	     otap_log.log(SQLERRM, l_script, 'Calling otap_plan.init_test');
 80  	     l_message := otap_string.reduce('Internal otap error init session variable: ' || SQLERRM, 4000);
 81  	 END;
 82  	 -- return or let exception happen
 83  	 RETURN l_message;
 84    END init_test;
