 61    /** FUNCTION otap_logic.match_regex
 62    * Checks given data of type VARCHAR2 against an Oracle REGEX expression. Uses REGEXP_LIKE. As MATCHES is a reserved word
 63    * this is the equivalent of matches, imatches, doesnt_match and doesnt_imatch.
 64    * ATTENTION Oracle REGEX implementation is not standard. Unix regex which work like charm take hours to implement in
 65    * Oracle REGEX to work as desired. Test your expression well with Oracle before using it. Keep it simple to get it work.
 66    *
 67    * Easiest way to check is SELECT COUNT(*) FROM dual WHERE regexp_like('your string', 'your regex', 'regex param');
 68    * Should result in 1 if successful checked. You may want to prepare a with block with different string to pass them
 69    * through the regular expression.
 70    *
 71    * @param p_have The data to check.
 72    * @param p_regex A valid Oracle regular expression that p_have must match. Mandatory.
 73    * @param o_error Error information, if any, on the test executed.
 74    * @param p_param Optional valid parameter for REGEXP_LIKE. 'i' means case insensitive. Parameters are case sensitive. See Oracle documentation for details, https://docs.oracle.com/en/database/oracle/oracle-database/21/sqlrf/Pattern-matching-Conditions.html#GUID-D2124F3A-C6E4-4CCA-A40E-2FFCABFD8E19.
 75    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 76    *
 77    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 78    */
 79    FUNCTION match_regex( p_have	       IN	     VARCHAR2
 80  			   , p_regex	       IN	     VARCHAR2
 81  			   , o_errors		  OUT NOCOPY VARCHAR2
 82  			   , p_param	       IN	     VARCHAR2 DEFAULT NULL
 83  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 84  			   )
 85  	 RETURN INTEGER
 86    ;
 87  
 88    /** FUNCTION otap_logic.alike
 89    * Checks given data of type VARCHAR2 against an Oracle LIKE expression. LIKE is currently more reliable and easier
 90    * to use than Oracle REGEX implementation. But also much more limited.
 91    *
 92    * @param p_have The data to check.
 93    * @param p_like A valid Oracle like expression that p_have must match. Mandatory.
 94    * @param o_error Error information, if any, on the test executed.
 95    * @param p_case_sensitive Optional defines that the compared result is handled as case sensitive, if set to otap_constants.OTAP_NUM_TRUE.
 96    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
 97    *
 98    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
 99    */
100    FUNCTION alike( p_have		 IN	       VARCHAR2
101  		     , p_like		 IN	       VARCHAR2
102  		     , o_errors 	    OUT NOCOPY VARCHAR2
103  		     , p_case_sensitive  IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_FALSE
104  		     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
105  		     )
106  	 RETURN INTEGER
107    ;
108  
109    /** FUNCTION otap_logic.throws_ok
110    * Checks if a given statement or code block throws the expected error message. The expected error message must match
111    * the SQLERRM returned from exception thrown. Use throws_match or throws_like if only parts of the error message must
112    * match. If the statement starts with SELECT it is executed as is, without caring for returned columns or rows and ignoring
113    * any given header definition. The header definition is a code block for the declare section defining variables that may be
114    * needed by called functions or procedures. It is only used if the statement does not start with SELECT and if the declaration
115    * block can be executed with a NULL procedure without throwing exceptions.
116    *
117    * Function comes in two flavors, comparing SQLERRM as VARCHAR2 or the error code SQLCODE as number. It can also be used to check
118    * if a statement does not cause any exception by switching the expected result to otap_constants.OTAP_NUM_TEST_FAILED.
119    *
120    * SQL statements (SELECT, UPDATE, DELETE) MUST NOT have a trailing semicolon. otap will try to detect and remove it, but may fail.
121    * Semicolon in dynamically executed SQL statements will cause an unexpected exception.
122    *
123    * Functions and procedures MUST have a trailing semicolon, especially if more than one command is executed in the block.
124    *
125    * Syntax errors will most likely cause a different exception as the expected one and fail the test. This is especially important if
126    * you switch the expected test result. otap expects in this case, that the statement could be executed without any exception.
127    *
128    * @param p_statement Mandatory. The statement as string to execute. Can be a select statement or function/procedure call. No need to proovide a begin end block. Syntax should be checked or will cause unexpected exceptions.
129    * @param p_sqlerrm Mandatory. The exact case sensitive expected error message as returned by SQLERRM after a provoked exception.
130    * @param o_error Error information, if any, on the test executed.
131    * @param p_header_def Optional valid header definition (test result is undefined if header is not valid) for function or procedure tests to support OUT and return variables.
132    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
133    *
134    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
135    */
136    FUNCTION throws_ok( p_statement	     IN 	   VARCHAR2
137  			 , p_sqlerrm	     IN 	   VARCHAR2
138  			 , o_errors		OUT NOCOPY VARCHAR2
139  			 , p_header_def      IN 	   VARCHAR2 DEFAULT NULL
140  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
141  			 )
142  	 RETURN INTEGER
143    ;
144  
145    /** FUNCTION otap_logic.throws_ok
146    * Flavor error code SQLCODE as number. Same behavior as flavor error message. Be aware that some Oracle error codes are group error codes where
147    * the error message differs depending on the exact error cause.
148    *
149    * @param p_statement Mandatory. The statement as string to execute. Can be a select statement or function/procedure call. No need to proovide a begin end block. Syntax should be checked or will cause unexpected exceptions.
150    * @param p_sqlcode Mandatory. The exact expected error code as returned by SQLCODE after a provoked exception.
151    * @param o_error Error information, if any, on the test executed.
152    * @param p_header_def Optional valid header definition (test result is undefined if header is not valid) for function or procedure tests to support OUT and return variables.
153    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
154    *
155    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
156    */
157    FUNCTION throws_ok( p_statement	     IN 	   VARCHAR2
158  			 , p_sqlcode	     IN 	   NUMBER
159  			 , o_errors		OUT NOCOPY VARCHAR2
160  			 , p_header_def      IN 	   VARCHAR2 DEFAULT NULL
161  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
162  			 )
163  	 RETURN INTEGER
164    ;
165  
166    /** FUNCTION otap_logic.throws_matches
167    * Same as otap_logic.throws_ok apart from using Oracle REGEXP to identify the error message.
168    *
169    * @param p_statement Mandatory. The statement as string to execute. Can be a select statement or function/procedure call. No need to proovide a begin end block. Syntax should be checked or will cause unexpected exceptions.
170    * @param p_regex_sqlerrm Mandatory. The regular expression to match the expected error message as returned by SQLERRM after a provoked exception.
171    * @param o_error Error information, if any, on the test executed.
172    * @param p_param Optional valid parameter for REGEXP_LIKE. 'i' means case insensitive. Parameters are case sensitive. See Oracle documentation for details, https://docs.oracle.com/en/database/oracle/oracle-database/21/sqlrf/Pattern-matching-Conditions.html#GUID-D2124F3A-C6E4-4CCA-A40E-2FFCABFD8E19.
173    * @param p_header_def Optional valid header definition (test result is undefined if header is not valid) for function or procedure tests to support OUT and return variables.
174    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
175    *
176    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
177    */
178    FUNCTION throws_matches( p_statement	  IN		VARCHAR2
179  			      , p_regex_sqlerrm   IN		VARCHAR2
180  			      , o_errors	     OUT NOCOPY VARCHAR2
181  			      , p_param 	  IN		VARCHAR2 DEFAULT NULL
182  			      , p_header_def	  IN		VARCHAR2 DEFAULT NULL
183  			      , p_expected_result IN		NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
184  			      )
185  	 RETURN INTEGER
186    ;
187  
188    /** FUNCTION otap_logic.throws_like
189    * Same as otap_logic.throws_ok apart from using Oracle LIKE to identify the error message.
190    *
191    * @param p_statement Mandatory. The statement as string to execute. Can be a select statement or function/procedure call. No need to proovide a begin end block. Syntax should be checked or will cause unexpected exceptions.
192    * @param p_like_sqlerrm Mandatory. The LIKE expression to match the expected error message as returned by SQLERRM after a provoked exception.
193    * @param o_error Error information, if any, on the test executed.
194    * @param p_case_sensitive Optional defines that the compared result is handled as case sensitive, if set to otap_constants.OTAP_NUM_TRUE.
195    * @param p_header_def Optional valid header definition (test result is undefined if header is not valid) for function or procedure tests to support OUT and return variables.
196    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
197    *
198    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
199    */
200    FUNCTION throws_like( p_statement       IN	     VARCHAR2
201  			   , p_like_sqlerrm    IN	     VARCHAR2
202  			   , o_errors		  OUT NOCOPY VARCHAR2
203  			   , p_case_sensitive  IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_FALSE
204  			   , p_header_def      IN	     VARCHAR2 DEFAULT NULL
205  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
206  			   )
207  	 RETURN INTEGER
208    ;
209  
210    --=== internal functions exposed for testing
211    /** FUNCTION otap_logic.check_header
212    * Checks a header construct defining variables and defaults with a declare-begin-end block, if a header definition is
213    * given. If the header definition is NULL, will always return TRUE.
214    */
215    FUNCTION check_header( p_header_def IN		 VARCHAR2
216  			    , o_errors	   IN OUT NOCOPY VARCHAR2
217  			    )
218  	 RETURN BOOLEAN
219    ;
220    /** FUNCTION otap_logic.get_test_block
221    * Creates a declare-begin-end block to execute, that contains the header and the given statement in the body.
222    * The statement is used as given, leading comments are NOT checked for determination of script type (SQL or PLSQL)
223    * If the statement starts with SELECT (case ignored), the block is just the SQL SELECT statement checked and
224    * cleaned from ending with a semicolon.
225    */
226    FUNCTION get_test_block( p_statement  IN VARCHAR2
227  			      , p_header_def IN VARCHAR2 DEFAULT NULL
228  			      )
229  	 RETURN VARCHAR2
230    ;
231    /** FUNCTION otap_logic.has_exception
232    * Checks if a given statement and optional header cause an exception. Will return TRUE if an exception is raised, otherwise FALSE.
233    * Returns the error code and message as provided by SQLCODE and SQLERRM as out variables.
234    */
235    FUNCTION has_exception( p_statement	 IN	       VARCHAR2
236  			     , o_errors 	 IN OUT NOCOPY VARCHAR2
237  			     , o_sqlcode	    OUT NOCOPY NUMBER
238  			     , o_sqlerrm	    OUT NOCOPY VARCHAR2
239  			     , p_header_def	 IN	       VARCHAR2 DEFAULT NULL
240  			     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
241  			     )
242  	 RETURN BOOLEAN
243    ;
244  
245  END;
