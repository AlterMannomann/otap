594    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
595  	 RETURN VARCHAR2
596    IS
597  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_finish';
598  	 l_message VARCHAR2(4000 CHAR);
599    BEGIN
600  	 -- object gets verified by summary for old session
601  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_INTERNAL_LF;
602  	 -- reset values
603  	 o_otap_session.test_count     := 0;
604  	 o_otap_session.error_count    := 0;
605  	 o_otap_session.intended_count := 0;
606  	 o_otap_session.test_set       := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET;
607  	 o_otap_session.test_group     := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP;
608  	 o_otap_session.test_name      := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME;
609  	 o_otap_session.session_start  := SYSDATE;
610  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
611  	 -- do not update the session_view_id so it will keep the old or any set value
612  	 -- every init will set the session_view_id to the current session id
613  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
614  	 RETURN l_message;
615    EXCEPTION
616  	 WHEN OTHERS THEN
617  	   IF SQLCODE != -20099
618  	   THEN
619  	     -- log unhandled exceptions
620  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
621  	   END IF;
622  	   RAISE;
623    END otap_session_finish;
