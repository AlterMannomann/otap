 26    FUNCTION init_test( p_test_count      IN NUMBER	 DEFAULT 0
 27  			 , p_test_set	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET
 28  			 , p_test_group      IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP
 29  			 , p_test_name	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME
 30  			 , p_prefix	     IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX
 31  			 , p_language_id     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 32  			 , p_name_precedence IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_TRUE
 33  			 , p_include_pkg     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 34  			 , p_persist	     IN NUMBER	 DEFAULT otap_constants.OTAP_NUM_FALSE
 35  			 , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 36  			 , p_user	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_USER')
 37  			 , p_executor	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'SESSION_USER')
 38  			 )
 39  	 RETURN VARCHAR2
 40    IS
 41  	 l_message VARCHAR2(4000 CHAR);
 42    BEGIN
 43  	 otap_api.validate_otap(session_record);
 44  	 l_message := otap_api.init_test( NVL(p_test_count, 0)
 45  					, NVL(p_test_set, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET)
 46  					, NVL(p_test_group, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP)
 47  					, NVL(p_test_name, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME)
 48  					, NVL(p_prefix, otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX)
 49  					, NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA)
 50  					, NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE)
 51  					, NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE)
 52  					, NVL(p_persist, otap_constants.OTAP_NUM_FALSE)
 53  					, p_schema
 54  					, p_user
 55  					, p_executor
 56  					, session_record
 57  					)
 58  	 ;
 59  	 RETURN l_message;
 60    EXCEPTION
 61  	 WHEN OTHERS THEN
 62  	   IF SQLCODE != -20099
 63  	   THEN
 64  	     otap_log.log(SQLERRM, 'otap_test.init_test', 'l_message := otap_api.init_test( p_test_count ...');
 65  	   END IF;
 66  	   RAISE;
 67    END init_test;
