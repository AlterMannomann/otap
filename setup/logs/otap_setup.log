1117  	  l_has_job	    INTEGER;
1118  	  l_job_name	    VARCHAR2(128 CHAR);
1119  	  l_job_style	    VARCHAR2(17 CHAR);
1120  	  l_job_type	    VARCHAR2(16 CHAR);
1121  	  l_job_action	    VARCHAR2(4000 CHAR);
1122  	  l_schedule_type   VARCHAR2(12 CHAR);
1123  	  l_repeat_interval VARCHAR2(4000 CHAR);
1124  	  l_job_class	    VARCHAR2(128 CHAR);
1125  	  l_logging_level   VARCHAR2(11 CHAR);
1126  	  l_store_output    VARCHAR2(5 CHAR);
1127  	  l_schema_to_use   VARCHAR2(128 CHAR);
