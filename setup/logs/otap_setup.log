484    FUNCTION get_summary( p_runtime	   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
485  			   , p_exectime    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
486  			   , p_runs	   IN NUMBER   DEFAULT 0
487  			   , p_errors	   IN NUMBER   DEFAULT 0
488  			   , p_issues	   IN NUMBER   DEFAULT 0
489  			   , p_min_fill    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
490  			   , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
491  			   )
492  	 RETURN VARCHAR2
493    IS
494  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.get_summary';
495  	 l_message VARCHAR2(4000 CHAR);
496  	 l_status  VARCHAR2(4000 CHAR);
497    BEGIN
498  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
499  	 -- execute the wrapped function in an extra block
500  	 BEGIN
501  	   l_status := CASE
502  			 WHEN p_issues > 0
503  			 THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_UNDEFINED, p_language_id)
504  			 WHEN p_errors > 0 AND p_issues <= 0
505  			 THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_FAILED, p_language_id)
506  			 ELSE otap_util.get_config_value(otap_util.CFG_TEXT_TEST_PASSED, p_language_id)
507  		       END
508  	   ;
509  	   l_message := otap_report.get_summary(l_status, p_runtime, p_exectime, p_runs, p_errors, p_issues, p_min_fill, p_language_id);
510  	 EXCEPTION
511  	   WHEN OTHERS THEN
512  	     -- consume error
513  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_summary');
514  	     l_message := otap_string.reduce('Internal otap error get report summary: ' || SQLERRM, 4000);
515  	 END;
516  	 -- return or let exception happen
517  	 RETURN l_message;
518    END get_summary;
