232    /** FUNCTION otap_test.has_column
233    * Tests if a table column exists. Additional tests on the column can be added by using the additional
234    * parameters with default NULL. The expected values have to match the content of DBA_TAB_COLUMNS for the given table,
235    * column and schema.
236    *
237    * If checking defaults, it is limited to defaults not longer than 4000 char, using the DATA_DEFAULT_VC column. Expressions
238    * must match all chars in the default, like quotation. Use q-syntax where possible to define correct strings, e.g.
239    * SELECT q'[SYS_CONTEXT('USERENV', 'OS_USER')]' FROM dual;
240    *
241    * @param p_table_name The name of the table, taken as is. Case sensitive.
242    * @param p_column_name The column name of the table, taken as is. Case sensitive.
243    * @param p_schema A schema override of the current test session if needed, taken as is. If given the table and column must exist in this schema. Case sensitive.
244    * @param p_description The test description if any. If not given, a description is generated, see template.
245    * @param p_data_type Optional check the datatype of the column. Ignored if NULL. NOT case sensitive.
246    * @param p_data_length Optional check the data length of the column. Ignored if NULL.
247    * @param p_data_precision Optional check the data precision of the column. Ignored if NULL. Results in test error if datatype is not NUMBER.
248    * @param p_data_scale Optional check the data scale of the column. Ignored if NULL. Results in test error if datatype is not NUMBER or TIMESTAMP.
249    * @param p_nullable Optional check if the column is nullable. Ignored if NULL. NOT case sensitive.
250    * @param p_data_default Optional check the default for the column. Ignored if NULL. Must match all chars, including ' and ". Limited to defaults shorter than 4000 chars.
251    * @param p_expected_result The expected test result, 1 (Passed), -1 (FAILED), 0 (UNDEFINED). Default is 1 (Passed).
252    *
253    * @return The test result as text.
254    */
255    FUNCTION has_column( p_table_name      IN VARCHAR2
256  			  , p_column_name     IN VARCHAR2
257  			  , p_schema	      IN VARCHAR2 DEFAULT NULL
258  			  , p_description     IN VARCHAR2 DEFAULT NULL
259  			  , p_data_type       IN VARCHAR2 DEFAULT NULL
260  			  , p_data_length     IN NUMBER   DEFAULT NULL
261  			  , p_data_precision  IN NUMBER   DEFAULT NULL
262  			  , p_data_scale      IN NUMBER   DEFAULT NULL
263  			  , p_nullable	      IN VARCHAR2 DEFAULT NULL
264  			  , p_data_default    IN VARCHAR2 DEFAULT NULL
265  			  , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
266  			  )
