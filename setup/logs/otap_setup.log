SQL> -- Basic package that provides utility functions and procedures for table OTAP_RESULTS.
SQL> CREATE OR REPLACE PACKAGE otap_results_util
  2  AS
  3    /**
  4    * Provides internal functions and procedures for OTAP_RESULTS.
  5    *
  6    * Package is not fail safe. Exceptions are raised after trying to log them.
  7    */
  8  
  9    /** PROCEDURE otap_results_util.write_test_result
 10    * Just persist the given values. Minimal handling of input. Invalid TO_DELETE
 11    * and TEST_PASSED will be set to the default. NULL values neither checked nor allowed
 12    * for parameters without default. May throw exceptions.
 13    *
 14    * @param p_to_delete A valid to delete value, either 0 or 1.
 15    * @param p_test_passed A valid test passed, either 0, -1 or 1.
 16    * @param p_test_session_id A valid current test session id.
 17    * @param p_test_executor A valid executor / session user name.
 18    * @param p_test_set The test set defined for the current test.
 19    * @param p_db_user The database user for this test.
 20    * @param p_db_schema The schema used for this test.
 21    * @param p_test_group The test group defined for the current test.
 22    * @param p_test_start The start of the test.
 23    * @param p_test_end The end of the test.
 24    * @param p_test_name The test name defined for the current test.
 25    * @param p_test_desc The test description of the current test.
 26    * @param p_test_errors Any errors during test execution, if any.
 27    */
 28    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
 29  				  , p_test_passed	IN NUMBER
 30  				  , p_test_session_id	IN NUMBER
 31  				  , p_test_executor	IN VARCHAR2
 32  				  , p_test_set		IN VARCHAR2
 33  				  , p_db_user		IN VARCHAR2
 34  				  , p_db_schema 	IN VARCHAR2
 35  				  , p_test_group	IN VARCHAR2
 36  				  , p_test_start	IN TIMESTAMP
 37  				  , p_test_end		IN TIMESTAMP
 38  				  , p_test_name 	IN VARCHAR2
 39  				  , p_test_desc 	IN VARCHAR2
 40  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
 41  				  )
 42    ;
 43  
 44    /** PROCEDURE otap_results_util.result_cleanup
 45    * Used for cleanup of the test results. Will run under scheduler job OTAP_MAINTENANCE every
 46    * day. Will use the current otap configuration in OTAP_CONFIG, where PRESERVE_DAYS defines
 47    * the days to keep test results, the DELETE_BATCH_SIZE defines the amount of rows to delete
 48    * before committing them and DELETE_DELAY the seconds to wait after a commit before deleting
 49    * more rows. Records must be marked for deletion. Provides debug logging if debug mode is
 50    * activated in OTAP_CONFIG.
 51    */
 52    PROCEDURE result_cleanup;
 53  
 54  END;
 55  /

