SQL> @@../otap_ddl/packages/otap_generate.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_generate
  2  AS
  3    -- for description see header file
  4    FUNCTION column_tests( p_table	      IN VARCHAR2
  5  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
  6  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
  7  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
  8  			    , p_excl_default  IN VARCHAR2 DEFAULT '$'
  9  			    , p_show_header   IN INTEGER  DEFAULT 1
 10  			    )
 11  	 RETURN otap_view_result_tbl PIPELINED
 12    IS
 13  	 l_statement   VARCHAR2(4000 CHAR);
 14  	 l_schema      VARCHAR2(128 CHAR);
 15  	 l_table       VARCHAR2(128 CHAR);
 16  	 l_base_title  VARCHAR2(256 CHAR);
 17  	 l_like        VARCHAR2(256 CHAR);
 18  	 l_test_count  INTEGER;
 19  	 CURSOR cur_columns( cp_schema IN VARCHAR2
 20  			   , cp_table  IN VARCHAR2
 21  			   , cp_like   IN VARCHAR2
 22  			   )
 23  	 IS
 24  	   SELECT *
 25  	     FROM dba_tab_columns
 26  	    WHERE owner 	 = cp_schema
 27  	      AND table_name	 = cp_table
 28  	      AND column_name LIKE cp_like
 29  	    ORDER BY column_id
 30  	 ;
 31    BEGIN
 32  	 IF p_table IS NOT NULL
 33  	 THEN
 34  	   l_table	:= otap_string.reduce(p_table, 128);
 35  	   l_like	:= NVL(p_like_column, '%');
 36  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
 37  	   l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
 38  	   IF NVL(p_show_header, 1) = 1
 39  	   THEN
 40  	     l_statement := '-- otap GENERATE column test scripts for table ' || l_schema || '.' || l_table || ' scope: ' || l_like;
 41  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 42  	     -- get test count
 43  	     SELECT SUM(expected_tests) + 1 -- add one for the test count test
 44  	       INTO l_test_count
 45  	       FROM (SELECT COUNT(*) AS expected_tests FROM dba_tab_columns WHERE owner = l_schema AND table_name = l_table)
 46  	     ;
 47  	     -- build init
 48  	     l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
 49  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 50  	   END IF;
 51  	   l_statement := '-- loop through columns with names like ' || l_like;
 52  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
 53  	   FOR rec IN cur_columns(l_schema, l_table, l_like)
 54  	   LOOP
 55  	     l_statement := 'SELECT otap_test.has_column( p_table_name => ''' || rec.table_name || '''';
 56  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 57  	     l_statement := '				, p_column_name => ''' || rec.column_name || '''';
 58  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 59  	     l_statement := '				, p_schema => ''' || rec.owner || '''';
 60  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 61  	     l_statement := '				, p_data_type => ''' || rec.data_type || '''';
 62  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 63  	     l_statement := '				, p_data_length => ' || TRIM(TO_CHAR(rec.data_length));
 64  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 65  	     IF rec.data_precision IS NOT NULL
 66  	     THEN
 67  	       l_statement := ' 			  , p_data_precision => ' || TRIM(TO_CHAR(rec.data_precision));
 68  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
 69  	     END IF;
 70  	     IF rec.data_scale IS NOT NULL
 71  	     THEN
 72  	       l_statement := ' 			  , p_data_scale => ' || TRIM(TO_CHAR(rec.data_scale));
 73  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
 74  	     END IF;
 75  	     l_statement := '				, p_nullable => ''' || rec.nullable || '''';
 76  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 77  	     IF     rec.data_default_vc 			      IS NOT NULL
 78  		AND NVL(INSTR(rec.data_default_vc, p_excl_default), 0) = 0
 79  	     THEN
 80  	       IF INSTR(rec.data_default_vc, '''') > 0
 81  	       THEN
 82  		 l_statement := '			    , p_data_default => q''[' || TRIM(rec.data_default_vc) || ']''';
 83  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 84  	       ELSE
 85  		 l_statement := '			    , p_data_default => ''' || TRIM(rec.data_default_vc) || '''';
 86  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
 87  	       END IF;
 88  	     END IF;
 89  	     l_statement := '				) FROM dual;';
 90  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 91  	   END LOOP;
 92  	   IF NVL(p_show_header, 1) = 1
 93  	   THEN
 94  	     -- build finish
 95  	     l_statement := '-- finish column tests for ' || l_table;
 96  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 97  	     l_statement := '-- finish test session';
 98  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
 99  	     l_statement := 'SELECT otap_test.finish_test FROM dual;';
100  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
101  	     l_statement := 'SELECT * FROM otap_latest_test_results_v;';
102  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
103  	     -- add AI and copyright
104  	     l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
105  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
106  	     l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
107  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
108  	     l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
109  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
110  	   ELSE
111  	     l_statement := '-- finish column tests for ' || l_table;
112  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
113  	   END IF;
114  	 END IF;
115  	 RETURN;
116    EXCEPTION
117  	 WHEN NO_DATA_NEEDED THEN
118  	   RAISE;
119    END column_tests;
120  
121    FUNCTION table_tests( p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
122  			   , p_like_table    IN VARCHAR2 DEFAULT '%'
123  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
124  			   , p_show_header   IN INTEGER  DEFAULT 1
125  			   )
126  	 RETURN otap_view_result_tbl PIPELINED
127    IS
128  	 l_statement   VARCHAR2(4000 CHAR);
129  	 l_schema      VARCHAR2(128 CHAR);
130  	 l_base_title  VARCHAR2(256 CHAR);
131  	 l_like        VARCHAR2(256 CHAR);
132  	 l_test_count  INTEGER;
133  	 CURSOR cur_tables( cp_schema IN VARCHAR2
134  			  , cp_like   IN VARCHAR2
135  			  )
136  	 IS
137  	   SELECT object_name AS table_name
138  	     FROM dba_objects
139  	    WHERE owner 	 = cp_schema
140  	      AND object_type	 = 'TABLE'
141  	      AND object_name LIKE cp_like
142  	 ;
143  	 CURSOR cur_columns( cp_schema IN VARCHAR2
144  			   , cp_table  IN VARCHAR2
145  			   , cp_like   IN VARCHAR2
146  			   , cp_prefix IN VARCHAR2
147  			   )
148  	 IS
149  	   SELECT result_text
150  	     FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, '$', 0))
151  	 ;
152    BEGIN
153  	 l_like       := NVL(p_like_table, '%');
154  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
155  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
156  	 IF NVL(p_show_header, 1) = 1
157  	 THEN
158  	   l_statement := '-- otap GENERATE table test scripts for schema ' || l_schema || ' scope: ' || l_like;
159  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
160  	   -- get test count
161  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
162  	     INTO l_test_count
163  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type = 'TABLE'
164  		    UNION ALL
165  		   SELECT COUNT(*) AS expected_tests FROM dba_tab_columns WHERE owner = l_schema
166  		  )
167  	   ;
168  	   -- build init
169  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
170  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
171  	 END IF;
172  	 -- build group row
173  	 l_statement := '-- set test group for tables';
174  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
175  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' tables'') FROM dual;';
176  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
177  	 l_statement := '-- loop through tables with names like ' || l_like;
178  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
179  	 FOR rec IN cur_tables(l_schema, l_like)
180  	 LOOP
181  	   l_statement := '-- set test name for table';
182  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
183  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' table ' || rec.table_name || ''') FROM dual;';
184  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
185  	   l_statement := 'SELECT otap_test.has_table( p_table_name => ''' || rec.table_name || '''';
186  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
187  	   l_statement := '			     , p_schema => ''' || l_schema || '''';
188  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
189  	   l_statement := '			     ) FROM dual;';
190  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
191  	   FOR colrec IN cur_columns(l_schema, rec.table_name, '%', p_title_prefix)
192  	   LOOP
193  	     PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
194  	   END LOOP;
195  	 END LOOP;
196  	 IF NVL(p_show_header, 1) = 1
197  	 THEN
198  	   -- build finish
199  	   l_statement := '-- finish table tests for ' || l_like;
200  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
201  	   l_statement := '-- finish test session';
202  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
203  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
204  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
205  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
206  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
207  	   -- add AI and copyright
208  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
209  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
210  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
211  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
212  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
213  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
214  	 ELSE
215  	   l_statement := '-- finish table tests for ' || l_like;
216  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
217  	 END IF;
218  	 RETURN;
219    EXCEPTION
220  	 WHEN NO_DATA_NEEDED THEN
221  	   RAISE;
222    END table_tests;
223  
224    FUNCTION trigger_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
225  			     , p_like_trigger  IN VARCHAR2 DEFAULT '%'
226  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
227  			     , p_show_header   IN INTEGER  DEFAULT 1
228  			     )
229  	 RETURN otap_view_result_tbl PIPELINED
230    IS
231  	 l_statement   VARCHAR2(4000 CHAR);
232  	 l_schema      VARCHAR2(128 CHAR);
233  	 l_base_title  VARCHAR2(256 CHAR);
234  	 l_like        VARCHAR2(256 CHAR);
235  	 l_count       INTEGER;
236  	 l_test_count  INTEGER;
237  	 CURSOR cur_table_trigger( cp_schema IN VARCHAR2
238  				 , cp_like   IN VARCHAR2
239  				 )
240  	 IS
241  	   SELECT table_name
242  	     FROM dba_triggers
243  	    WHERE owner 	  = cp_schema
244  	      AND table_name	 IS NOT NULL
245  	      AND trigger_name LIKE cp_like
246  	    GROUP BY table_name
247  	    ORDER BY table_name
248  	 ;
249  	 CURSOR cur_trigger( cp_schema IN VARCHAR2
250  			   , cp_table  IN VARCHAR2
251  			   , cp_like   IN VARCHAR2
252  			   )
253  	 IS
254  	   SELECT *
255  	     FROM dba_triggers
256  	    WHERE owner 	  = cp_schema
257  	      AND table_name	  = cp_table
258  	      AND trigger_name LIKE cp_like
259  	    ORDER BY trigger_name
260  	 ;
261  	 CURSOR cur_other_trigger( cp_schema IN VARCHAR2
262  				 , cp_like   IN VARCHAR2
263  				 )
264  	 IS
265  	   SELECT *
266  	     FROM dba_triggers
267  	    WHERE owner 	  = cp_schema
268  	      AND table_name	 IS NULL
269  	      AND trigger_name LIKE cp_like
270  	    ORDER BY trigger_name
271  	 ;
272    BEGIN
273  	 l_like       := NVL(p_like_trigger, '%');
274  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
275  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
276  	 IF NVL(p_show_header, 1) = 1
277  	 THEN
278  	   l_statement := '-- otap GENERATE trigger test scripts for schema ' || l_schema || ' scope: ' || l_like;
279  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
280  	   -- get test count
281  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
282  	     INTO l_test_count
283  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_triggers WHERE owner = l_schema)
284  	   ;
285  	   -- build init
286  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
287  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
288  	 END IF;
289  	 -- build group row
290  	 l_statement := '-- set test group for trigger';
291  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
292  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' trigger'') FROM dual;';
293  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
294  	 -- organize trigger by table or not
295  	 -- trigger with table
296  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NOT NULL;
297  	 IF l_count > 0
298  	 THEN
299  	   FOR rec IN cur_table_trigger(l_schema, l_like)
300  	   LOOP
301  	     -- build name
302  	     l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' ' || rec.table_name || ' table trigger'') FROM dual;';
303  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
304  	     l_statement := '-- loop through triggers with names like ' || l_like;
305  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
306  	     FOR rectrg IN cur_trigger(l_schema, rec.table_name, l_like)
307  	     LOOP
308  	       l_statement := 'SELECT otap_test.has_trigger( p_trigger_name => ''' || rectrg.trigger_name || '''';
309  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
310  	       l_statement := ' 			   , p_schema => ''' || rectrg.owner || '''';
311  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
312  	       l_statement := ' 			   , p_trigger_type => ''' || TRIM(rectrg.trigger_type) || '''';
313  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
314  	       l_statement := ' 			   , p_trigger_event => ''' || TRIM(rectrg.triggering_event) || '''';
315  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
316  	       l_statement := ' 			   , p_table_owner => ''' || TRIM(rectrg.table_owner) || '''';
317  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
318  	       l_statement := ' 			   , p_table_name => ''' || TRIM(rectrg.table_name) || '''';
319  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
320  	       l_statement := ' 			   ) FROM dual;';
321  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
322  	     END LOOP;
323  	   END LOOP;
324  	 END IF;
325  	 -- trigger without table
326  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NULL;
327  	 IF l_count > 0
328  	 THEN
329  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' trigger without tables'') FROM dual;';
330  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
331  	   l_statement := '-- loop through triggers with names like ' || l_like;
332  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
333  	   FOR rec IN cur_other_trigger(l_schema, l_like)
334  	   LOOP
335  	     l_statement := 'SELECT otap_test.has_trigger( p_trigger_name => ''' || rec.trigger_name || '''';
336  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
337  	     l_statement := '				 , p_schema => ''' || rec.owner || '''';
338  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
339  	     l_statement := '				 , p_trigger_type => ''' || TRIM(rec.trigger_type) || '''';
340  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
341  	     l_statement := '				 , p_trigger_event => ''' || TRIM(rec.triggering_event) || '''';
342  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
343  	     l_statement := '				 ) FROM dual;';
344  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
345  	   END LOOP;
346  	 END IF;
347  	 IF NVL(p_show_header, 1) = 1
348  	 THEN
349  	   -- build finish
350  	   l_statement := '-- finish trigger tests for ' || l_like;
351  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
352  	   l_statement := '-- finish test session';
353  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
354  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
355  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
356  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
357  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
358  	   -- add AI and copyright
359  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
360  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
361  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
362  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
363  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
364  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
365  	 ELSE
366  	   l_statement := '-- finish trigger tests for ' || l_like;
367  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
368  	 END IF;
369  	 RETURN;
370    EXCEPTION
371  	 WHEN NO_DATA_NEEDED THEN
372  	   RAISE;
373    END trigger_tests;
374  
375    FUNCTION pkg_procedures( p_package_name	 IN VARCHAR
376  			      , p_like_procedure IN VARCHAR2 DEFAULT '%'
377  			      , p_schema	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
378  			      , p_title_prefix	 IN VARCHAR2 DEFAULT NULL
379  			      , p_show_header	 IN INTEGER  DEFAULT 1
380  			      )
381  	 RETURN otap_view_result_tbl PIPELINED
382    IS
383  	 l_statement   VARCHAR2(4000 CHAR);
384  	 l_schema      VARCHAR2(128 CHAR);
385  	 l_base_title  VARCHAR2(256 CHAR);
386  	 l_like        VARCHAR2(256 CHAR);
387  	 l_package     VARCHAR2(128 CHAR);
388  	 l_test_count  INTEGER;
389  	 CURSOR cur_pkg_proc( cp_schema  IN VARCHAR2
390  			    , cp_package IN VARCHAR2
391  			    , cp_like	 IN VARCHAR2
392  			    )
393  	 IS
394  	     WITH prc AS
395  		  (SELECT dbo.owner
396  			, dbp.procedure_name
397  			, CASE
398  			    WHEN dbr.position	    = 0
399  			     AND dbr.argument_name IS NULL
400  			    THEN 'FUNCTION'
401  			    ELSE 'PROCEDURE'
402  			  END AS procedure_type
403  			, CASE
404  			    WHEN dbr.position	    = 0
405  			     AND dbr.argument_name IS NULL
406  			    THEN dbr.data_type
407  			    ELSE NULL
408  			  END AS return_type
409  			, dbo.status
410  			, dbo.object_name AS package_name
411  		     FROM dba_objects dbo
412  		     LEFT OUTER JOIN dba_procedures dbp
413  		       ON dbo.owner	  = dbp.owner
414  		      AND dbo.object_name = dbp.object_name
415  		      AND dbo.object_type = dbp.object_type
416  		     LEFT OUTER JOIN dba_arguments dbr
417  		       ON dbp.owner	    = dbr.owner
418  		      AND dbp.object_name   = dbr.package_name
419  		      AND dbp.procedure_name = dbr.object_name
420  		      AND dbp.object_id     = dbr.object_id
421  		      AND dbp.subprogram_id = dbr.subprogram_id
422  		      AND dbr.sequence	    = 1
423  		    WHERE dbo.owner	   = cp_schema
424  		      AND dbo.object_type  = 'PACKAGE'
425  			  -- exclude package itself
426  		      AND dbp.procedure_name IS NOT NULL
427  		    UNION ALL
428  		   SELECT dbo.owner
429  			, dbo.object_name AS procedure_name
430  			, dbo.object_type AS procedure_type
431  			, CASE
432  			    WHEN dbr.position	    = 0
433  			     AND dbr.argument_name IS NULL
434  			    THEN dbr.data_type
435  			    ELSE NULL
436  			  END AS return_type
437  			, dbo.status
438  			, NULL AS package_name
439  		     FROM dba_objects dbo
440  		     LEFT OUTER JOIN dba_procedures dbp
441  		       ON dbo.owner	  = dbp.owner
442  		      AND dbo.object_name = dbp.object_name
443  		      AND dbo.object_type = dbp.object_type
444  		     LEFT OUTER JOIN dba_arguments dbr
445  		       ON dbp.owner	    = dbr.owner
446  		      AND dbp.object_name   = dbr.object_name
447  		      AND dbp.object_id     = dbr.object_id
448  		      AND dbp.subprogram_id = dbr.subprogram_id
449  		      AND dbr.sequence	    = 1
450  		    WHERE dbo.owner	   = cp_schema
451  		      AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
452  		  )
453  	   SELECT DISTINCT
454  		  owner
455  		, procedure_name
456  		, procedure_type
457  		, return_type
458  		, status
459  		, package_name
460  	     FROM prc
461  	    WHERE package_name	    = cp_package
462  	      AND procedure_name LIKE cp_like
463  	 ;
464    BEGIN
465  	 l_package := otap_string.reduce(p_package_name, 128);
466  	 IF l_package IS NOT NULL
467  	 THEN
468  	   l_like	:= NVL(p_like_procedure, '%');
469  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
470  	   l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
471  	   IF NVL(p_show_header, 1) = 1
472  	   THEN
473  	     l_statement := '-- otap GENERATE package function and procedure test scripts for package ' || l_schema || '.' || l_package || ' scope: ' || l_like;
474  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
475  	     -- get test count
476  	     SELECT SUM(expected_tests) + 1 -- add one for the test count test
477  	       INTO l_test_count
478  	       FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type IN ('PACKAGE', 'PACKAGE BODY')
479  		      UNION ALL
480  		     SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema AND procedure_name IS NOT NULL
481  		    )
482  	     ;
483  	     -- build init
484  	     l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
485  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
486  	   END IF;
487  	   l_statement := '-- loop through package functions and triggers with names like ' || l_like;
488  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
489  	   FOR rec IN cur_pkg_proc(l_schema, l_package, l_like)
490  	   LOOP
491  	     l_statement := 'SELECT otap_test.has_procedure( p_procedure_name => ''' || rec.procedure_name || '''';
492  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
493  	     l_statement := '				   , p_schema => ''' || l_schema || '''';
494  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
495  	     l_statement := '				   , p_procedure_type => ''' || rec.procedure_type || '''';
496  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
497  	     l_statement := '				   , p_package_name => ''' || rec.package_name || '''';
498  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
499  	     IF rec.procedure_type = 'FUNCTION'
500  	     THEN
501  	       l_statement := ' 			     , p_return_type => ''' || rec.return_type || '''';
502  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
503  	     END IF;
504  	     l_statement := '				   ) FROM dual;';
505  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
506  	   END LOOP;
507  	   IF NVL(p_show_header, 1) = 1
508  	   THEN
509  	     -- build finish
510  	     l_statement := '-- finish package function and procedure tests for ' || l_package;
511  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
512  	     l_statement := '-- finish test session';
513  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
514  	     l_statement := 'SELECT otap_test.finish_test FROM dual;';
515  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
516  	     l_statement := 'SELECT * FROM otap_latest_test_results_v;';
517  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
518  	     -- add AI and copyright
519  	     l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
520  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
521  	     l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
522  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
523  	     l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
524  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
525  	   ELSE
526  	     l_statement := '-- finish package function and procedure tests for ' || l_package;
527  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
528  	   END IF;
529  	 END IF;
530  	 RETURN;
531    EXCEPTION
532  	 WHEN NO_DATA_NEEDED THEN
533  	   RAISE;
534    END pkg_procedures;
535  
536    FUNCTION package_tests( p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
537  			     , p_like_package  IN VARCHAR2 DEFAULT '%'
538  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
539  			     , p_show_header   IN INTEGER  DEFAULT 1
540  			     )
541  	 RETURN otap_view_result_tbl PIPELINED
542    IS
543  	 l_statement   VARCHAR2(4000 CHAR);
544  	 l_schema      VARCHAR2(128 CHAR);
545  	 l_base_title  VARCHAR2(256 CHAR);
546  	 l_like        VARCHAR2(256 CHAR);
547  	 l_count       INTEGER;
548  	 l_test_count  INTEGER;
549  	 CURSOR cur_packages( cp_schema IN VARCHAR2
550  			    , cp_like	IN VARCHAR2
551  			    )
552  	 IS
553  	   SELECT object_name AS package_name
554  		, COUNT(*)    AS package_objects
555  	     FROM dba_objects
556  	    WHERE owner 	 = cp_schema
557  	      AND object_type LIKE 'PACKAGE%'
558  	      AND object_name LIKE cp_like
559  	    GROUP BY object_name
560  	 ;
561  	 CURSOR cur_procedures( cp_schema  IN VARCHAR2
562  			      , cp_package IN VARCHAR2
563  			      , cp_like    IN VARCHAR2
564  			      , cp_prefix  IN VARCHAR2
565  			      )
566  	 IS
567  	   SELECT result_text
568  	     FROM TABLE(otap_generate.pkg_procedures(cp_package, cp_like, cp_schema, cp_prefix, 0))
569  	 ;
570    BEGIN
571  	 l_like       := NVL(p_like_package, '%');
572  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
573  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
574  	 IF NVL(p_show_header, 1) = 1
575  	 THEN
576  	   l_statement := '-- otap GENERATE package test scripts for schema ' || l_schema || ' scope: ' || l_like;
577  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
578  	   -- get test count
579  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
580  	     INTO l_test_count
581  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type IN ('PACKAGE', 'PACKAGE BODY')
582  		    UNION ALL
583  		   SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema AND procedure_name IS NOT NULL
584  		  )
585  	   ;
586  	   -- build init
587  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
588  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
589  	 END IF;
590  	 -- build group row
591  	 l_statement := '-- set test group for package';
592  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
593  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' packages'') FROM dual;';
594  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
595  	 -- first loop through packages
596  	 FOR rec IN cur_packages(l_schema, l_like)
597  	 LOOP
598  	   l_statement := '-- set test name for package';
599  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
600  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' package ' || rec.package_name || ''') FROM dual;';
601  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
602  	   l_statement := 'SELECT otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
603  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
604  	   l_statement := '			       , p_schema => ''' || l_schema || '''';
605  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
606  	   l_statement := '			       ) FROM dual;';
607  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
608  	   IF rec.package_objects = 2
609  	   THEN
610  	     l_statement := 'SELECT otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
611  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
612  	     l_statement := '				 , p_schema => ''' || l_schema || '''';
613  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
614  	     l_statement := '				 , p_package_type => ''PACKAGE BODY''';
615  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
616  	     l_statement := '				 ) FROM dual;';
617  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
618  	   END IF;
619  	   -- now loop through the package procedures and functions
620  	   FOR recfn IN cur_procedures(l_schema, rec.package_name, l_like, p_title_prefix)
621  	   LOOP
622  	     PIPE ROW (otap_view_result_rec(recfn.result_text, NULL));
623  	   END LOOP;
624  	 END LOOP;
625  	 IF NVL(p_show_header, 1) = 1
626  	 THEN
627  	   -- build finish
628  	   l_statement := '-- finish package tests for ' || l_like;
629  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
630  	   l_statement := '-- finish test session';
631  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
632  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
633  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
634  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
635  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
636  	   -- add AI and copyright
637  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
638  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
639  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
640  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
641  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
642  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
643  	 ELSE
644  	   l_statement := '-- finish package tests for ' || l_like;
645  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
646  	 END IF;
647  	 RETURN;
648    EXCEPTION
649  	 WHEN NO_DATA_NEEDED THEN
650  	   RAISE;
651    END package_tests;
652  
653  
654    FUNCTION schema_tests( p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
655  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
656  			    , p_show_header   IN INTEGER  DEFAULT 1
657  			    )
658  	 RETURN otap_view_result_tbl PIPELINED
659    IS
660  	 l_statement   VARCHAR2(4000 CHAR);
661  	 l_schema      VARCHAR2(128 CHAR);
662  	 l_base_title  VARCHAR2(256 CHAR);
663  	 l_like        VARCHAR2(1 CHAR);
664  	 l_test_count  INTEGER;
665  	 CURSOR cur_tables( cp_schema IN VARCHAR2
666  			  , cp_like   IN VARCHAR2
667  			  , cp_prefix IN VARCHAR2
668  			  )
669  	 IS
670  	   SELECT result_text
671  	     FROM TABLE(otap_generate.table_tests(cp_schema, cp_like, p_title_prefix, 0))
672  	 ;
673  	 CURSOR cur_trigger( cp_schema IN VARCHAR2
674  			   , cp_like   IN VARCHAR2
675  			   , cp_prefix IN VARCHAR2
676  			   )
677  	 IS
678  	   SELECT result_text
679  	     FROM TABLE(otap_generate.trigger_tests(cp_schema, cp_like, p_title_prefix, 0))
680  	 ;
681  	 CURSOR cur_packages( cp_schema IN VARCHAR2
682  			    , cp_like	IN VARCHAR2
683  			    , cp_prefix IN VARCHAR2
684  			    )
685  	 IS
686  	   SELECT result_text
687  	     FROM TABLE(otap_generate.package_tests(cp_schema, cp_like, p_title_prefix, 0))
688  	 ;
689    BEGIN
690  	 l_like       := '%';
691  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
692  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
693  	 IF NVL(p_show_header, 1) = 1
694  	 THEN
695  	   l_statement := '-- otap GENERATE test scripts for schema ' || l_schema;
696  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
697  	   -- get test count
698  	   SELECT SUM(expected_tests) + 1 -- add one for the test count test
699  	     INTO l_test_count
700  	     FROM (SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type = 'TABLE'
701  		    UNION ALL
702  		   SELECT COUNT(*) AS expected_tests FROM dba_tab_columns WHERE owner = l_schema
703  		    UNION ALL
704  		   SELECT COUNT(*) AS expected_tests FROM dba_triggers WHERE owner = l_schema
705  		    UNION ALL
706  		   SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type LIKE 'PACKAGE%'
707  		    UNION ALL
708  		   SELECT COUNT(*) AS expected_tests FROM dba_objects WHERE owner = l_schema AND object_type LIKE 'PACKAGE%'
709  		    UNION ALL
710  		   SELECT COUNT(*) AS expected_tests FROM dba_procedures WHERE owner = l_schema
711  		  )
712  	   ;
713  	   -- build init
714  	   l_statement := 'SELECT otap_test.init(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
715  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
716  	 END IF;
717  	 -- build set row
718  	 l_statement := '-- set test set for schema';
719  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
720  	 l_statement := 'SELECT otap_test.set_test_set(''' || l_base_title || ' schema'') FROM dual;';
721  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
722  	 FOR rec IN cur_tables(l_schema, l_like, p_title_prefix)
723  	 LOOP
724  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
725  	 END LOOP;
726  	 FOR rec IN cur_trigger(l_schema, l_like, p_title_prefix)
727  	 LOOP
728  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
729  	 END LOOP;
730  	 FOR rec IN cur_packages(l_schema, l_like, p_title_prefix)
731  	 LOOP
732  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
733  	 END LOOP;
734  	 IF NVL(p_show_header, 1) = 1
735  	 THEN
736  	   -- build finish
737  	   l_statement := '-- finish schema tests for ' || l_schema;
738  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
739  	   l_statement := '-- finish test session';
740  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
741  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
742  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
743  	   -- build example spool
744  	   l_statement := '-- example spool setup for test script generation';
745  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
746  	   l_statement := 'SET ECHO OFF';
747  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
748  	   l_statement := 'SET VERIFY OFF';
749  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
750  	   l_statement := 'SET FEEDBACK OFF';
751  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
752  	   l_statement := 'SET HEADING OFF';
753  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
754  	   l_statement := 'SET TRIMSPOOL ON';
755  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
756  	   l_statement := 'SET LINESIZE 9999';
757  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
758  	   l_statement := 'SET NEWPAGE NONE';
759  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
760  	   l_statement := 'SET PAGESIZE 9999';
761  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
762  	   l_statement := 'SPOOL generated_schema_tests.sql';
763  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
764  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
765  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
766  	   l_statement := 'SPOOL OFF';
767  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
768  	   -- add AI and copyright
769  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
770  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
771  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
772  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
773  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
774  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
775  	 ELSE
776  	   l_statement := '-- finish schema tests for ' || l_schema;
777  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
778  	 END IF;
779  	 RETURN;
780    EXCEPTION
781  	 WHEN NO_DATA_NEEDED THEN
782  	   RAISE;
783    END schema_tests;
784  
785  END;
786  /

