325    FUNCTION max_text_size(p_session_id IN NUMBER)
326  	 RETURN NUMBER
327    IS
328  	 l_script    VARCHAR2(1024 CHAR) := 'otap_api.otap_session_get_test_id';
329  	 l_return    NUMBER;
330  	 l_interval  NUMBER;
331    BEGIN
332  	 l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
333  	 -- execute the wrapped function in an extra block
334  	 BEGIN
335  	   l_return := otap_util.max_text_size(p_session_id);
336  	   -- now add the extra columns on the result line
337  	   SELECT LENGTH(((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval FROM dual;
338  	   l_return := l_return + l_interval + (2 * otap_util.get_length_test_state) + 3;
339  	 EXCEPTION
340  	   WHEN OTHERS THEN
341  	     -- consume error
342  	     otap_log.log(SQLERRM, l_script, 'Calling otap_util.max_text_size');
343  	     l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
344  	 END;
345  	 -- return or let exception happen
346  	 RETURN l_return;
347    END max_text_size;
