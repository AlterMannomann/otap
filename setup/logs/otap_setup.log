 30    EXCEPTION
 31  	 WHEN OTHERS THEN
 32  	   otap_log.log(SQLERRM, l_script, 'CASE WHEN LENGTH(p_string) > p_size THEN SUBSTR(p_string, 1, p_size) ELSE p_string END');
 33  	   RAISE;
