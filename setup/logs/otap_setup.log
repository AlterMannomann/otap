SQL> CREATE OR REPLACE PACKAGE BODY otap_report
  2  AS
  3  
  4    -- for description see header file
  5    FUNCTION decorate( p_string	IN VARCHAR2
  6  			, p_min_fill	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
  7  			, p_decoration	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
  8  			, p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
  9  			)
 10  	 RETURN VARCHAR2
 11    IS
 12  	 l_border	    INTEGER;
 13  	 l_layout	    VARCHAR2(1 CHAR);
 14  	 l_decoration	    VARCHAR2(1 CHAR);
 15  	 l_string_size	    INTEGER;
 16  	 l_max_title_length INTEGER;
 17  	 l_min_fill	    INTEGER;
 18  	 l_min_length	    INTEGER;
 19  	 l_string	    VARCHAR2(32767 CHAR);
 20  	 l_return_text	    VARCHAR2(32767 CHAR);
 21    BEGIN
 22  	 l_border	    := otap_util.get_config_number(otap_util.CFG_DEFAULT_BORDER);
 23  	 l_layout	    := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT, p_language_id));
 24  	 l_decoration	    := otap_string.check_decoration(p_decoration);
 25  	 l_string_size	    := otap_string.check_string_size(NVL(LENGTH(p_string), 0));
 26  	 -- limit the string if necessary
 27  	 l_string	    := otap_string.reduce(p_string, l_string_size);
 28  	 -- get final title length
 29  	 l_string_size	    := NVL(LENGTH(l_string), 0);
 30  	 l_max_title_length := otap_string.check_title_size(l_string_size, l_border);
 31  	 l_min_fill	    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_max_title_length);
 32  	 l_min_length	    := GREATEST(otap_string.line_size(l_max_title_length, l_border), l_min_fill);
 33  	 l_return_text	    := otap_string.decorate(l_string, l_decoration, l_min_length, l_layout, l_border);
 34  	 RETURN l_return_text;
 35    EXCEPTION
 36  	 WHEN OTHERS THEN
 37  	   otap_log.log(SQLERRM, 'otap_report.decorate', 'Create decorated report line');
 38  	   RAISE;
 39    END decorate;
 40  
 41    FUNCTION borderless( p_string	  IN VARCHAR2
 42  			  , p_min_fill	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
 43  			  , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 44  			  )
 45  	 RETURN VARCHAR2
 46    IS
 47  	 l_border      INTEGER;
 48  	 l_layout      VARCHAR2(1 CHAR);
 49  	 l_string_size INTEGER;
 50  	 l_min_fill    INTEGER;
 51  	 l_string      VARCHAR2(32767 CHAR);
 52  	 l_return_text VARCHAR2(32767 CHAR);
 53    BEGIN
 54  	 l_border      := otap_util.get_config_number(otap_util.CFG_DEFAULT_BORDER);
 55  	 l_layout      := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT, p_language_id));
 56  	 l_string      := NVL(p_string, ' ');
 57  	 l_string_size := otap_string.check_string_size(LENGTH(l_string));
 58  	 -- limit the string if necessary
 59  	 l_string      := otap_string.reduce(l_string, l_string_size);
 60  	 -- get final title length
 61  	 l_string_size := NVL(LENGTH(l_string), 0);
 62  	 l_min_fill    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_string_size);
 63  	 l_return_text := otap_string.borderless(l_string, l_min_fill, l_layout);
 64  	 RETURN l_return_text;
