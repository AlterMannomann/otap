 72    FUNCTION validate_config_value( p_config_name   IN	     VARCHAR2
 73  				     , p_config_value  IN	     VARCHAR2
 74  				     , p_config_type   IN	     VARCHAR2
 75  				     , p_translatable  IN OUT NOCOPY NUMBER
 76  				     , p_max_length    IN	     NUMBER
 77  				     , p_raise	       IN	     BOOLEAN  DEFAULT TRUE
 78  				     )
 79  	 RETURN VARCHAR2
 80    IS
 81  	 l_script	VARCHAR2(1024 CHAR)  := 'otap_util.validate_config_value';
 82  	 l_config_value VARCHAR2(32767 CHAR);
 83  	 l_config_name	VARCHAR2(128 CHAR);
 84  	 l_integer	INTEGER;
 85    BEGIN
 86  	 l_config_value := TRIM(p_config_value);
 87  	 l_config_name	:= otap_string.reduce(p_config_name, 128);
 88  	 -- we must check against NULL as we are in a before trigger
 89  	 IF    l_config_value	     IS NULL
 90  	    OR LENGTH(l_config_value) = 0
 91  	 THEN
 92  	   -- no defaults for NULL values, always raise
 93  	   otap_log.log('-20002 The given config_value is not supported. Empty or only spaces.', l_script);
 94  	   RAISE_APPLICATION_ERROR(-20002, 'The given config_value is not supported. Empty or only spaces.');
 95  	 END IF;
 96  	 -- check type also mandatory, no default
 97  	 IF NVL(p_config_type, otap_constants.OTAP_INTERNAL_NA) NOT IN (otap_constants.OTAP_CONFIG_TYPE_CHAR, otap_constants.OTAP_CONFIG_TYPE_NUMBER)
 98  	 THEN
 99  	   otap_log.log('-20003 The given config_type: ' || NVL(p_config_type, 'NULL') || ' is not supported. Only CHAR or NUMBER supported.', l_script);
100  	   RAISE_APPLICATION_ERROR(-20003, 'The given config_type: ' || NVL(p_config_type, 'NULL') || ' is not supported. Only CHAR or NUMBER supported.');
101  	 END IF;
102  	 -- check length if given
103  	 IF	NVL(p_max_length, 0)   > 0
104  	    AND LENGTH(l_config_value) > NVL(p_max_length, 0)
105  	 THEN
106  	   -- we do not cut numbers, raise
107  	   IF	 p_config_type = 'NUMBER'
108  	      OR p_raise
109  	   THEN
110  	     otap_log.log('-20004 The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: ' || p_max_length || '.', l_script);
111  	     RAISE_APPLICATION_ERROR(-20004, 'The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: ' || p_max_length || '.');
112  	   ELSE
113  	     -- cut the string if not raise
114  	     l_config_value := otap_string.reduce(l_config_value, p_max_length);
115  	   END IF;
116  	 ELSIF LENGTH(l_config_value) > 4000
117  	 THEN
118  	   -- OTAP_CONFIG supports only 4000 chars
119  	   -- we do not cut numbers, raise
120  	   IF	 p_config_type = 'NUMBER'
121  	      OR p_raise
122  	   THEN
123  	     otap_log.log('-20004 The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: 4000.', l_script);
124  	     RAISE_APPLICATION_ERROR(-20004, 'The given config_value: ' || l_config_value || ' exceeds the maximum length allowed: 4000.');
125  	   ELSE
126  	     -- cut the string if not raise
127  	     l_config_value := otap_string.reduce(l_config_value, 4000);
128  	   END IF;
129  	 END IF;
130  	 -- check number, always raise
131  	 IF	p_config_type = 'NUMBER'
132  	    AND NOT is_number(l_config_value)
133  	 THEN
134  	   otap_log.log('-20005 The given config_value: ' || l_config_value || ' cannot be converted to a number.', l_script);
135  	   RAISE_APPLICATION_ERROR(-20005, 'The given config_value: ' || l_config_value || ' cannot be converted to a number.');
136  	 END IF;
137  	 -- check translatable and correct it if needed
138  	 IF p_translatable NOT IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
139  	 THEN
140  	   otap_log.log('Invalid value for TRANSLATABLE: ' || p_translatable || ' use default.', l_script);
141  	   p_translatable := otap_constants.OTAP_NUM_FALSE;
142  	 END IF;
143  	 IF	(   p_config_type = 'NUMBER'
144  		 OR l_config_name IN (otap_util.CFG_DEFAULT_PREFIX, otap_util.CFG_DEFAULT_LAYOUT, otap_util.CFG_DEFAULT_RESULT_LAYOUT)
145  		)
146  	    AND p_translatable = TRIM(TO_CHAR(otap_constants.OTAP_NUM_TRUE))
147  	 THEN
148  	   otap_log.log('Invalid config_name: ' || l_config_name || ' for TRANSLATABLE: ' || p_translatable || ' use default.', l_script);
149  	   p_translatable := otap_constants.OTAP_NUM_FALSE;
150  	 END IF;
151  	 -- now check constraints on specific config values not managed by other constraints
152  	 IF l_config_name = otap_util.CFG_PRESERVE_DAYS
153  	 THEN
154  	   IF is_integer(l_config_value)
155  	   THEN
156  	     l_integer := TO_NUMBER(l_config_value);
157  	     -- check range
158  	     IF l_config_value NOT BETWEEN otap_constants.OTAP_FALLBACK_PRESERVE_DAYS_MIN AND otap_constants.OTAP_FALLBACK_PRESERVE_DAYS_MAX
159  	     THEN
160  		 otap_log.log('Invalid value for PRESERVE_DAYS: ' || l_config_value || ' use default.', l_script);
161  		 l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_PRESERVE_DAYS));
162  	     END IF;
163  	   ELSE
164  	     -- set default
165  	     otap_log.log('Invalid value for PRESERVE_DAYS: ' || l_config_value || ' use default.', l_script);
166  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_PRESERVE_DAYS));
167  	   END IF;
168  	 END IF;
169  	 IF l_config_name = otap_util.CFG_DELETE_DELAY
170  	 THEN
171  	   IF is_integer(l_config_value)
172  	   THEN
173  	     l_integer := TO_NUMBER(l_config_value);
174  	     -- check range
175  	     IF l_integer NOT BETWEEN otap_constants.OTAP_FALLBACK_DELETE_DELAY_MIN AND otap_constants.OTAP_FALLBACK_DELETE_DELAY_MAX
176  	     THEN
177  	       otap_log.log('Invalid value for DELETE_DELAY: ' || l_config_value || ' use default.', l_script);
178  	       l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_DELAY));
179  	     END IF;
180  	   ELSE
181  	     -- set default
182  	     otap_log.log('Invalid value for DELETE_DELAY: ' || l_config_value || ' use default.', l_script);
183  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_DELAY));
184  	   END IF;
185  	 END IF;
186  	 IF l_config_name = otap_util.CFG_DELETE_BATCH_SIZE
187  	 THEN
188  	   IF is_integer(l_config_value)
189  	   THEN
190  	     l_integer := TO_NUMBER(l_config_value);
191  	     -- check range
192  	     IF l_integer NOT BETWEEN otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE_MIN AND otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE_MAX
193  	     THEN
194  	       otap_log.log('Invalid value for DELETE_BATCH_SIZE: ' || l_config_value || ' use default.', l_script);
195  	       l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE));
196  	     END IF;
197  	   ELSE
198  	     -- set default
199  	     otap_log.log('Invalid value for DELETE_BATCH_SIZE: ' || l_config_value || ' use default.', l_script);
200  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_DELETE_BATCH_SIZE));
201  	   END IF;
202  	 END IF;
203  	 IF l_config_name = otap_util.CFG_DEFAULT_BORDER
204  	 THEN
205  	   IF is_integer(l_config_value)
206  	   THEN
207  	     l_integer := TO_NUMBER(l_config_value);
208  	     -- check range
209  	     IF l_integer NOT BETWEEN otap_constants.OTAP_FALLBACK_BORDER_MIN AND otap_constants.OTAP_FALLBACK_BORDER_MAX
210  	     THEN
211  	       otap_log.log('Invalid value for DEFAULT_BORDER: ' || l_config_value || ' use default.', l_script);
212  	       l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_BORDER));
213  	     END IF;
214  	   ELSE
215  	     -- set default
216  	     otap_log.log('Invalid value for DEFAULT_BORDER: ' || l_config_value || ' use default.', l_script);
217  	     l_config_value := TRIM(TO_CHAR(otap_constants.OTAP_FALLBACK_BORDER));
218  	   END IF;
219  	 END IF;
220  	 IF l_config_name = otap_constants.OTAP_CFG_DEBUG_MODE
221  	 THEN
222  	   -- hardcoded minimal check, this is highly internal
223  	   IF l_config_value NOT IN ('0', '1')
224  	   THEN
225  	     otap_log.log('Invalid value for DEBUG_MODE: ' || l_config_value || ' use default.', l_script);
226  	     l_config_value := '0';
227  	   END IF;
228  	 END IF;
229  	 IF l_config_name = otap_util.CFG_DEFAULT_LAYOUT
230  	 THEN
231  	   IF l_config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
232  	   THEN
233  	     otap_log.log('Invalid value for DEFAULT_LAYOUT: ' || l_config_value || ' use default.', l_script);
234  	     l_config_value := otap_constants.OTAP_LAYOUT_MIDDLE;
235  	   END IF;
236  	 END IF;
237  	 IF l_config_name = otap_util.CFG_DEFAULT_RESULT_LAYOUT
238  	 THEN
239  	   IF l_config_value NOT IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)
240  	   THEN
241  	     otap_log.log('Invalid value for DEFAULT_RESULT_LAYOUT: ' || l_config_value || ' use default.', l_script);
242  	     l_config_value := otap_constants.OTAP_LAYOUT_LEFT;
243  	   END IF;
244  	 END IF;
245  	 IF l_config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
246  	 THEN
247  	   IF l_config_value NOT IN (otap_constants.OTAP_LABEL_LOWER, otap_constants.OTAP_LABEL_INIT_CAP, otap_constants.OTAP_LABEL_UPPER)
248  	   THEN
249  	     otap_log.log('Invalid value for DEFAULT_LABEL_LAYOUT: ' || l_config_value || ' use default.', l_script);
250  	     l_config_value := otap_constants.OTAP_LAYOUT_LEFT;
251  	   END IF;
252  	 END IF;
253  	 RETURN l_config_value;
254    END validate_config_value;
