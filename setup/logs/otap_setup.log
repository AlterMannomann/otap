512  	 l_message := otap_string.reduce( 'Summary id: ' || TRIM(TO_CHAR(p_otap_session.session_id)) ||
513  					  ' tests: ' || TRIM(TO_CHAR(p_otap_session.test_count)) ||
514  					  CASE WHEN p_otap_session.intended_count > 0 THEN ' from ' || TRIM(TO_CHAR(p_otap_session.intended_count)) END ||
515  					  ' errors: ' || TRIM(TO_CHAR(p_otap_session.error_count)) ||
516  					  ' run time: ' || TRIM(TO_CHAR(((SYSDATE - p_otap_session.session_start) DAY TO SECOND))) ||
517  					  ' started: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
518  					, 4000
519  					)
520  	 ;
521  	 RETURN l_message;
522    EXCEPTION
523  	 WHEN OTHERS THEN
524  	   IF SQLCODE != -20099
525  	   THEN
526  	     -- log unhandled exceptions
527  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
528  	   END IF;
529  	   RAISE;
530    END otap_session_summary;
531  
532    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
533  	 RETURN VARCHAR2
534    IS
535  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_finish';
536  	 l_message VARCHAR2(4000 CHAR);
537    BEGIN
538  	 -- object gets verified by summary for old session
539  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_INTERNAL_LF;
540  	 -- reset values
541  	 o_otap_session.test_count     := 0;
542  	 o_otap_session.error_count    := 0;
543  	 o_otap_session.intended_count := 0;
544  	 o_otap_session.test_set       := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET;
545  	 o_otap_session.test_group     := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP;
546  	 o_otap_session.test_name      := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME;
547  	 o_otap_session.session_start  := SYSDATE;
548  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
549  	 -- do not update the session_view_id so it will keep the old or any set value
550  	 -- every init will set the session_view_id to the current session id
551  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
552  	 RETURN l_message;
553    EXCEPTION
554  	 WHEN OTHERS THEN
555  	   IF SQLCODE != -20099
556  	   THEN
557  	     -- log unhandled exceptions
558  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
559  	   END IF;
560  	   RAISE;
561    END otap_session_finish;
562  
563  END;
564  /

