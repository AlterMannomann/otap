262    /** FUNCTION otap_test.has_column
263    * Tests if a table column exists. Additional tests on the column can be added by using the additional
264    * parameters with default NULL. The expected values have to match the content of DBA_TAB_COLUMNS for the given table,
265    * column and schema.
266    *
267    * If checking defaults, it is limited to defaults not longer than 4000 char, using the DATA_DEFAULT_VC column. Expressions
268    * must match all chars in the default, like quotation. Use q-syntax where possible to define correct strings, e.g.
269    * SELECT q'[SYS_CONTEXT('USERENV', 'OS_USER')]' FROM dual;
270    *
271    * @param p_table_name The name of the table, taken as is. Case sensitive.
272    * @param p_column_name The column name of the table, taken as is. Case sensitive.
273    * @param p_schema A schema override of the current test session if needed, taken as is. If given the table and column must exist in this schema. Case sensitive.
274    * @param p_description The test description if any. If not given, a description is generated, see template.
275    * @param p_data_type Optional check the datatype of the column. Ignored if NULL. NOT case sensitive.
276    * @param p_data_length Optional check the data length of the column. Ignored if NULL.
277    * @param p_data_precision Optional check the data precision of the column. Ignored if NULL. Results in test error if datatype is not NUMBER.
278    * @param p_data_scale Optional check the data scale of the column. Ignored if NULL. Results in test error if datatype is not NUMBER or TIMESTAMP.
279    * @param p_nullable Optional check if the column is nullable. Ignored if NULL. NOT case sensitive.
280    * @param p_data_default Optional check the default for the column. Ignored if NULL. Must match all chars, including ' and ". Limited to defaults shorter than 4000 chars.
281    * @param p_expected_result The expected test result, 1 (Passed), -1 (FAILED), 0 (UNDEFINED). Default is 1 (Passed).
282    *
283    * @return The test result as text.
284    */
285    FUNCTION has_column( p_table_name      IN VARCHAR2
286  			  , p_column_name     IN VARCHAR2
287  			  , p_schema	      IN VARCHAR2 DEFAULT NULL
288  			  , p_description     IN VARCHAR2 DEFAULT NULL
289  			  , p_data_type       IN VARCHAR2 DEFAULT NULL
290  			  , p_data_length     IN NUMBER   DEFAULT NULL
291  			  , p_data_precision  IN NUMBER   DEFAULT NULL
292  			  , p_data_scale      IN NUMBER   DEFAULT NULL
293  			  , p_nullable	      IN VARCHAR2 DEFAULT NULL
294  			  , p_data_default    IN VARCHAR2 DEFAULT NULL
295  			  , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
296  			  )
297  	 RETURN VARCHAR2
298    ;
