SQL> -- Basic package that provides utility functions and procedures for otap.
SQL> CREATE OR REPLACE PACKAGE otap_util
  2  AS
  3    /**
  4    * Provides internal functions and procedures for otap like logging, interface to OTAP_CONFIG and
  5    * others without a clear category. You need the schema owner to use this functions.
  6    */
  7  
  8    /** FUNCTION otap_util.debug_active
  9    * Returns the debug state, defined in OTAP_CONFIG. Can't log errors as log depends on
 10    * this function.
 11    *
 12    * @return TRUE if DEBUG_MODE is set to 1 in OTAP_CONFIG, otherwise or on errors FALSE.
 13    */
 14    FUNCTION debug_active
 15  	 RETURN BOOLEAN
 16    ;
 17  
 18    /** PROCEDURE otap_util.log
 19    * Writes a log message to SPERRORLOG which should be already available by setup. If the identifier
 20    * is not OTAP_ERROR the log output will only be stored, if OTAP_CONFIG DEBUG_MODE is set to 1.
 21    * User and timestamp are set by the procedure. Runs as autonomous transaction. If SPERRORLOG does
 22    * not exist, will do nothing. Do nothing on exceptions, just consume them.
 23    *
 24    * @param p_log_message The message to log in SPERRORLOG.
 25    * @param p_script The script, package or function that caused the message.
 26    * @param p_statement The statement that caused the message.
 27    * @param p_identifier The identifier in SPERRORLOG. If not OTAP_ERROR, message is logged only if debug mode is set.
 28    */
 29    PROCEDURE log( p_log_message  IN VARCHAR2
 30  		    , p_script	     IN VARCHAR2 DEFAULT 'N/A'
 31  		    , p_statement    IN VARCHAR2 DEFAULT 'N/A'
 32  		    , p_identifier   IN VARCHAR2 DEFAULT 'OTAP_ERROR'
 33  		    )
 34    ;
 35  
 36    /** PROCEDURE otap_util.set_debug
 37    * Sets the debug state in OTAP_CONFIG. On errors debug state will be deactivated or
 38    * left unchanged.
 39    *
 40    * @param p_active The active (TRUE) or inactive debug state.
 41    */
 42    PROCEDURE set_debug(p_active IN BOOLEAN DEFAULT FALSE);
 43  
 44    /** FUNCTION otap_util.preserve_days
 45    * Returns the setting for PRESERVE_DAYS, defined in OTAP_CONFIG.
 46    *
 47    * @return The setting of PRESERVE_DAYS in OTAP_CONFIG or default 1 on errors.
 48    */
 49    FUNCTION preserve_days
 50  	 RETURN NUMBER
 51    ;
 52  
 53    /** PROCEDURE otap_util.set_preserve_days
 54    * Sets preserve days in OTAP_CONFIG. On errors preserve days will be set to default or
 55    * left unchanged. Allowed are values between 1 and 7 days.
 56    *
 57    * @param p_preserve_days The amount of days to preserve test results.
 58    */
 59    PROCEDURE set_preserve_days(p_preserve_days IN NUMBER DEFAULT 1);
 60  
 61    /** FUNCTION otap_util.delete_delay
 62    * Returns the setting for DELETE_DELAY, defined in OTAP_CONFIG.
 63    *
 64    * @return The setting of DELETE_DELAY in OTAP_CONFIG or default 10 on errors.
 65    */
 66    FUNCTION delete_delay
 67  	 RETURN NUMBER
 68    ;
 69  
 70    /** PROCEDURE otap_util.set_delete_delay
 71    * Sets delete delay seconds in OTAP_CONFIG. On errors delete delay will be set to default or
 72    * left unchanged. Allowed are values between 1 and 600 seconds.
 73    *
 74    * @param p_delete_delay The amount of seconds to wait between batch size deletes.
 75    */
 76    PROCEDURE set_delete_delay(p_delete_delay IN NUMBER DEFAULT 10);
 77  
 78    /** FUNCTION otap_util.delete_batch_size
 79    * Returns the setting for DELETE_BATCH_SIZE, defined in OTAP_CONFIG.
 80    *
 81    * @return The setting of DELETE_BATCH_SIZE in OTAP_CONFIG or default 1000 on errors.
 82    */
 83    FUNCTION delete_batch_size
 84  	 RETURN NUMBER
 85    ;
 86  
 87    /** PROCEDURE otap_util.set_delete_batch_size
 88    * Sets delete batch size in OTAP_CONFIG. On errors delete batch size will be set to default or
 89    * left unchanged. Allowed are values between 100 and 10000 rows to delete before commit.
 90    *
 91    * @param p_delete_batch_size The amount of rows to delete as batch before commit.
 92    */
 93    PROCEDURE set_delete_batch_size(p_delete_batch_size IN NUMBER DEFAULT 1000);
 94  
 95    /** PROCEDURE otap_util.result_cleanup
 96    * Used for cleanup of the test results. Will run under scheduler job OTAP_MAINTENANCE every
 97    * day. Will use the current otap configuration in OTAP_CONFIG, where PRESERVE_DAYS defines
 98    * the days to keep test results, the DELETE_BATCH_SIZE defines the amount of rows to delete
 99    * before committing them and DELETE_DELAY the seconds to wait after a commit before deleting
100    * more rows. Records must be marked for deletion. Provides debug logging if debug mode is
101    * activated in OTAP_CONFIG.
102    */
103    PROCEDURE result_cleanup;
104  
105  END;
106  /

