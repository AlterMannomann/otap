1185  	FUNCTION generate_schema_tests( p_like_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1186  				      , p_required_user IN VARCHAR2 DEFAULT NULL
1187  				      , p_title_prefix	IN VARCHAR2 DEFAULT NULL
1188  				      , p_show_header	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1189  				      , p_excl_sysgen	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1190  				      )
1191  	  RETURN otap_view_result_tbl PIPELINED
1192  	IS
1193  	  CURSOR cur_tests( cp_like   IN VARCHAR2
1194  			  , cp_users  IN VARCHAR2
1195  			  , cp_prefix IN VARCHAR2
1196  			  , cp_show   IN NUMBER
1197  			  , cp_excl   IN NUMBER
1198  			  )
1199  	  IS
1200  	    SELECT result_text
1201  	      FROM TABLE(otap_generate.schema_tests(cp_like, cp_users, cp_prefix, cp_show, cp_excl))
1202  	  ;
1203  	BEGIN
1204  	  FOR rec IN cur_tests(p_like_schema, p_required_user, p_title_prefix, p_show_header, p_excl_sysgen)
1205  	  LOOP
1206  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1207  	  END LOOP;
1208  	  RETURN;
1209  	EXCEPTION
1210  	  WHEN NO_DATA_NEEDED THEN
1211  	    RAISE;
1212  	END generate_schema_tests;
