247  	 END IF;
248  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
249  	 THEN
250  	   l_statement := '-- otap GENERATE test procedure ' || l_fn_name;
251  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
252  	   l_statement := 'CREATE OR REPLACE PROCEDURE ' || l_fn_name;
253  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
254  	   l_statement := 'IS';
255  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
256  	   l_statement := otap_generate.get_code_pad || 'l_message VARCHAR2(4000);';
257  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
