1099  	FUNCTION has_scheduler_job( p_job_name	      IN	    VARCHAR2
1100  				  , o_errors		 OUT NOCOPY VARCHAR2
1101  				  , p_job_style       IN	    VARCHAR2 DEFAULT NULL
1102  				  , p_job_type	      IN	    VARCHAR2 DEFAULT NULL
1103  				  , p_job_action      IN	    VARCHAR2 DEFAULT NULL
1104  				  , p_schedule_type   IN	    VARCHAR2 DEFAULT NULL
1105  				  , p_repeat_interval IN	    VARCHAR2 DEFAULT NULL
1106  				  , p_job_class       IN	    VARCHAR2 DEFAULT NULL
1107  				  , p_logging_level   IN	    VARCHAR2 DEFAULT NULL
1108  				  , p_store_output    IN	    VARCHAR2 DEFAULT NULL
1109  				  , p_schema	      IN	    VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1110  				  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1111  				  )
1112  	  RETURN INTEGER
1113  	IS
1114  	  l_script	    VARCHAR2(1024 CHAR)    := 'otap_schema.has_scheduler_job';
1115  	  l_test_passed     INTEGER;
1116  	  l_expected	    INTEGER;
1117  	  l_has_job	    INTEGER;
1118  	  l_job_name	    VARCHAR2(128 CHAR);
1119  	  l_job_style	    VARCHAR2(17 CHAR);
1120  	  l_job_type	    VARCHAR2(16 CHAR);
1121  	  l_job_action	    VARCHAR2(4000 CHAR);
1122  	  l_schedule_type   VARCHAR2(12 CHAR);
1123  	  l_repeat_interval VARCHAR2(4000 CHAR);
1124  	  l_job_class	    VARCHAR2(128 CHAR);
1125  	  l_logging_level   VARCHAR2(11 CHAR);
1126  	  l_store_output    VARCHAR2(5 CHAR);
1127  	  l_schema_to_use   VARCHAR2(128 CHAR);
1128  	  l_errors	    VARCHAR2(32767 CHAR);
1129  	BEGIN
1130  	  l_errors	    := NULL;
1131  	  l_test_passed     := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1132  	  l_expected	    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
1133  	  l_job_name	    := otap_string.reduce(p_job_name, 128);
1134  	  l_job_style	    := otap_string.reduce(UPPER(p_job_style), 17);
1135  	  l_job_type	    := otap_string.reduce(UPPER(p_job_type), 16);
1136  	  l_job_action	    := otap_string.reduce(otap_string.flatten(UPPER(p_job_action), 4000), 4000);
1137  	  l_schedule_type   := otap_string.reduce(UPPER(p_schedule_type), 12);
1138  	  l_repeat_interval := otap_string.reduce(UPPER(p_repeat_interval), 4000);
1139  	  l_job_class	    := otap_string.reduce(UPPER(p_job_class), 128);
1140  	  l_logging_level   := otap_string.reduce(UPPER(p_logging_level), 11);
1141  	  l_store_output    := otap_string.reduce(UPPER(p_store_output), 5);
1142  	  IF	 l_job_name	   IS NOT NULL
1143  	     AND LENGTH(l_job_name) > 0
1144  	  THEN
1145  	    -- schema
1146  	    l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
1147  	    -- check
1148  	    SELECT COUNT(*)
1149  	      INTO l_has_job
1150  	      FROM dba_scheduler_jobs
1151  	     WHERE owner				    = l_schema_to_use
1152  	       AND job_name				    = l_job_name
1153  	       AND NVL(job_style, 'n/a')		    = NVL(l_job_style, NVL(job_style, 'n/a'))
1154  	       AND NVL(job_type, 'n/a') 		    = NVL(l_job_type, NVL(job_type, 'n/a'))
1155  	       AND NVL( otap_string.reduce( otap_string.flatten( UPPER(job_action)
1156  							       , 4000
1157  							       )
1158  					  , 4000
1159  					  )
1160  		      , 'n/a'
1161  		      ) 				    = NVL(l_job_action, NVL(otap_string.reduce(otap_string.flatten(UPPER(job_action), 4000), 4000), 'n/a'))
1162  	       AND NVL(schedule_type, 'n/a')		    = NVL(l_schedule_type, NVL(schedule_type, 'n/a'))
1163  	       AND NVL(TRIM(UPPER(repeat_interval)), 'n/a') = NVL(l_repeat_interval, NVL(TRIM(UPPER(repeat_interval)), 'n/a'))
1164  	       AND NVL(job_class, 'n/a')		    = NVL(l_job_class, NVL(job_class, 'n/a'))
1165  	       AND NVL(logging_level, 'n/a')		    = NVL(l_logging_level, NVL(logging_level, 'n/a'))
1166  	       AND NVL(store_output, 'n/a')		    = NVL(l_store_output, NVL(store_output, 'n/a'))
1167  	    ;
1168  	    -- we should find one or zero entries
1169  	    l_test_passed := count_chk(l_has_job, l_errors, l_script);
1170  	  ELSE
1171  	    -- job name must be set
1172  	    l_test_passed	:= otap_constants.OTAP_NUM_TEST_UNDEFINED;
1173  	    l_errors		:= 'Not allowed: p_job_name(NULL)';
1174  	    otap_log.log(l_errors, l_script, 'Scheduler job name is NULL');
1175  	  END IF;
1176  	  -- now decide on the expected result the final state and if errors are returned
1177  	  IF l_test_passed != l_expected
1178  	  THEN
1179  	    o_errors := otap_string.reduce(l_errors, 4000);
1180  	  ELSE
1181  	    -- overwrite states from before, as we fulfill expected
1182  	    l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
1183  	    -- overwrite errors expected
1184  	    o_errors := NULL;
1185  	  END IF;
1186  	  RETURN l_test_passed;
1187  	EXCEPTION
1188  	  WHEN OTHERS THEN
1189  	    IF SQLCODE != -20099
1190  	    THEN
1191  	      -- log unhandled exceptions
1192  	      otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
1193  	    END IF;
1194  	    RAISE;
1195  	END has_scheduler_job;
1196  
1197  	FUNCTION has_user( p_username		   IN		 VARCHAR2
1198  			 , o_errors		      OUT NOCOPY VARCHAR2
1199  			 , p_account_status	   IN		 VARCHAR2 DEFAULT NULL
1200  			 , p_default_tablespace    IN		 VARCHAR2 DEFAULT NULL
1201  			 , p_temporary_tablespace  IN		 VARCHAR2 DEFAULT NULL
1202  			 , p_local_temp_tablespace IN		 VARCHAR2 DEFAULT NULL
1203  			 , p_profile		   IN		 VARCHAR2 DEFAULT NULL
1204  			 , p_password_versions	   IN		 VARCHAR2 DEFAULT NULL
1205  			 , p_authentication_type   IN		 VARCHAR2 DEFAULT NULL
1206  			 , p_proxy_only_connect    IN		 VARCHAR2 DEFAULT NULL
1207  			 , p_protected		   IN		 VARCHAR2 DEFAULT NULL
1208  			 , p_read_only		   IN		 VARCHAR2 DEFAULT NULL
1209  			 , p_expected_result	   IN		 NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1210  			 )
1211  	  RETURN INTEGER
1212  	IS
1213  	  l_script		  VARCHAR2(1024 CHAR)	 := 'otap_schema.has_user';
1214  	  l_test_passed 	  INTEGER;
1215  	  l_expected		  INTEGER;
1216  	  l_has_user		  INTEGER;
1217  	  l_username		  VARCHAR2(128 CHAR);
1218  	  l_account_status	  VARCHAR2(32 CHAR);
1219  	  l_default_tablespace	  VARCHAR2(30 CHAR);
1220  	  l_temporary_tablespace  VARCHAR2(30 CHAR);
1221  	  l_local_temp_tablespace VARCHAR2(30 CHAR);
1222  	  l_profile		  VARCHAR2(128 CHAR);
1223  	  l_password_versions	  VARCHAR2(17 CHAR);
1224  	  l_authentication_type   VARCHAR2(8 CHAR);
1225  	  l_proxy_only_connect	  VARCHAR2(1 CHAR);
1226  	  l_protected		  VARCHAR2(3 CHAR);
1227  	  l_read_only		  VARCHAR2(3 CHAR);
1228  	  l_errors		  VARCHAR2(32767 CHAR);
1229  	BEGIN
1230  	  l_errors		  := NULL;
1231  	  l_test_passed 	  := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1232  	  l_expected		  := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
1233  	  l_username		  := otap_string.reduce(p_username, 128);
1234  	  l_account_status	  := otap_string.reduce(UPPER(p_account_status), 32);
1235  	  l_default_tablespace	  := otap_string.reduce(p_default_tablespace, 30);
1236  	  l_temporary_tablespace  := otap_string.reduce(p_temporary_tablespace, 30);
1237  	  l_local_temp_tablespace := otap_string.reduce(p_local_temp_tablespace, 30);
1238  	  l_profile		  := otap_string.reduce(UPPER(p_profile), 128);
1239  	  l_password_versions	  := otap_string.reduce(p_password_versions, 17);
1240  	  l_authentication_type   := otap_string.reduce(UPPER(p_authentication_type), 8);
1241  	  l_proxy_only_connect	  := otap_string.reduce(UPPER(p_proxy_only_connect), 1);
1242  	  l_protected		  := otap_string.reduce(UPPER(p_protected), 3);
1243  	  l_read_only		  := otap_string.reduce(UPPER(p_read_only), 3);
1244  	  IF	 p_username	   IS NOT NULL
1245  	     AND LENGTH(p_username) > 0
1246  	  THEN
1247  	    -- check
1248  	    SELECT COUNT(*)
1249  	      INTO l_has_user
1250  	      FROM dba_users
1251  	     WHERE username			       = l_username
1252  	       AND account_status		       = NVL(l_account_status, account_status)
1253  	       AND default_tablespace		       = NVL(l_default_tablespace, default_tablespace)
1254  	       AND temporary_tablespace 	       = NVL(l_temporary_tablespace, temporary_tablespace)
1255  	       AND NVL(local_temp_tablespace, 'n/a')   = NVL(l_local_temp_tablespace, NVL(local_temp_tablespace, 'n/a'))
1256  	       AND profile			       = NVL(l_profile, profile)
1257  	       AND TRIM(NVL(password_versions, 'n/a')) = NVL(l_password_versions, TRIM(NVL(password_versions, 'n/a')))
1258  	       AND NVL(authentication_type, 'n/a')     = NVL(l_authentication_type, NVL(authentication_type, 'n/a'))
1259  	       AND NVL(proxy_only_connect, 'n/a')      = NVL(l_proxy_only_connect, NVL(proxy_only_connect, 'n/a'))
1260  	       AND NVL(protected, 'n/a')	       = NVL(l_protected, NVL(protected, 'n/a'))
1261  	       AND NVL(read_only, 'n/a')	       = NVL(l_read_only, NVL(read_only, 'n/a'))
1262  	    ;
1263  	    -- we should find one or zero entries
1264  	    l_test_passed := count_chk(l_has_user, l_errors, l_script);
1265  	  ELSE
1266  	    -- job name must be set
1267  	    l_test_passed	:= otap_constants.OTAP_NUM_TEST_UNDEFINED;
1268  	    l_errors		:= 'Not allowed: p_username(NULL)';
1269  	    otap_log.log(l_errors, l_script, 'User name is NULL');
1270  	  END IF;
1271  	  -- now decide on the expected result the final state and if errors are returned
1272  	  IF l_test_passed != l_expected
1273  	  THEN
1274  	    o_errors := otap_string.reduce(l_errors, 4000);
1275  	  ELSE
1276  	    -- overwrite states from before, as we fulfill expected
1277  	    l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
1278  	    -- overwrite errors expected
1279  	    o_errors := NULL;
1280  	  END IF;
1281  	  RETURN l_test_passed;
1282  	EXCEPTION
1283  	  WHEN OTHERS THEN
1284  	    IF SQLCODE != -20099
1285  	    THEN
1286  	      -- log unhandled exceptions
1287  	      otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
1288  	    END IF;
1289  	    RAISE;
1290  	END has_user;
1291  
1292  END;
1293  /

