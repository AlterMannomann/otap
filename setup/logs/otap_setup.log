518    FUNCTION has_table( p_table_name   IN		VARCHAR2
519  			 , o_otap_session IN OUT NOCOPY OTAP_SESSION
520  			 , p_schema	  IN		VARCHAR2     DEFAULT NULL
521  			 , p_description  IN		VARCHAR2     DEFAULT NULL
522  			 )
523  	 RETURN VARCHAR2
524    IS
525  	 l_script	    VARCHAR2(1024)		    := 'otap_api.has_table';
526  	 l_start	    TIMESTAMP;
527  	 l_end		    TIMESTAMP;
528  	 l_result	    INTEGER;
529  	 l_return	    VARCHAR2(4000);
530  	 l_errors	    otap_results.test_errors%TYPE;
531  	 l_schema	    otap_results.db_schema%TYPE;
532  	 l_desc 	    otap_results.test_desc%TYPE;
533  	 l_tmp_otap_session OTAP_SESSION;
534    BEGIN
535  	 l_start  := SYSTIMESTAMP;
536  	 -- default return
537  	 l_return := otap_config_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED) || ' ' || otap_constants.OTAP_CHAR_NA;
538  	 -- own begin-end for the transaction after the function
539  	 BEGIN
540  	   -- own begin-end block for the function itself and prepare
541  	   BEGIN
542  	     l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
543  	     l_desc   := otap_string.reduce(NVL(p_description, otap_report.get_has_table_msg(p_table_name, l_schema)), 256);
544  	     -- call function
545  	     l_result := otap_schema.has_table( p_table_name
546  					      , l_errors
547  					      , l_schema
548  					      )
549  	     ;
550  	   EXCEPTION
551  	     WHEN OTHERS THEN
552  	     -- consume error
553  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
554  	     l_errors := otap_string.reduce('Internal error has_table: ' || SQLERRM, 4000);
555  	     otap_log.log(SQLERRM, l_script, 'Execute has_table function');
556  	   END;
557  	   l_end := SYSTIMESTAMP;
558  	   -- set session variable according current value, a part where otap could fail
559  	   l_tmp_otap_session		 := otap_objects.otap_session_copy(o_otap_session);
560  	   l_tmp_otap_session.db_schema  := l_schema;
561  	   -- try to write the test record
562  	   otap_plan.write_test_result(l_desc, l_tmp_otap_session, l_result, l_start, l_end, l_errors);
563  	   otap_objects.otap_session_add_test(l_result, o_otap_session);
564  	   l_return := otap_config_util.test_result_to_text(l_result) || ' ' || l_desc;
565  	 EXCEPTION
566  	   WHEN OTHERS THEN
567  	     -- consume error
568  	     l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
569  	     l_errors := otap_string.reduce('Internal error has_table: ' || SQLERRM, 4000);
570  	     otap_log.log(SQLERRM, l_script, 'Execute has_table function');
571  	     -- try again to write a record with the new informations, which may again raise an exception
572  	     l_tmp_otap_session 	   := otap_objects.otap_session_copy(o_otap_session);
573  	     l_tmp_otap_session.db_schema  := l_schema;
574  	     l_end := SYSTIMESTAMP;
575  	     otap_plan.write_test_result(l_desc, l_tmp_otap_session, l_result, l_start, l_end, l_errors);
576  	     l_desc   := otap_string.reduce(NVL(p_description, otap_report.get_has_table_msg(p_table_name, l_schema)), 256);
577  	     l_return := otap_config_util.test_result_to_text(l_result) || ' ' || l_desc;
578  	 END;
579  	 -- return result or let exception happen
580  	 RETURN l_return;
581    END has_table;
582  
583  END;
584  /

