394  	   END IF;
395  	   RAISE;
396    END otap_session_set_test_group;
397  
398    FUNCTION otap_session_set_test_name( p_test_name    IN		 VARCHAR2
399  					  , o_otap_session IN OUT NOCOPY OTAP_SESSION
400  					  )
401  	 RETURN VARCHAR2
402    IS
403  	 l_script  VARCHAR2(1024) := 'otap_objects.otap_session_set_test_name';
404  	 l_message VARCHAR2(4000);
405    BEGIN
406  	 otap_objects.otap_session_verify(o_otap_session);
407  	 IF LENGTH(p_test_name) > 256
408  	 THEN
409  	   o_otap_session.test_name := SUBSTR(p_test_name, 1, 256);
410  	   otap_util.log('ERROR test name length exceed 256 chars. Test name ' || p_test_name || ' cutted to 256 chars.', l_script, 'LENGTH(p_test_name) > 256');
411  	 ELSE
412  	   o_otap_session.test_name := NVL(p_test_name, otap_constants.OTAP_DEFAULT_TEST_NAME);
413  	 END IF;
414  	 l_message := 'Current test: ' || o_otap_session.test_name;
415  	 RETURN l_message;
416    EXCEPTION
417  	 WHEN OTHERS THEN
418  	   IF SQLCODE != -20099
419  	   THEN
420  	     -- log unhandled exceptions
421  	     otap_util.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
422  	   END IF;
423  	   RAISE;
424    END otap_session_set_test_name;
