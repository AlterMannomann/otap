537    FUNCTION get_count_desc( p_tests_run	  IN INTEGER  DEFAULT 0
538  			      , p_tests_expected  IN INTEGER  DEFAULT 0
539  			      , p_language_id	  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
540  			      )
541  	 RETURN VARCHAR2
542    IS
543  	 l_return_text	 VARCHAR2(32767 CHAR);
544    BEGIN
