122  	 l_script      VARCHAR2(256 CHAR) := 'otap_string.check_string_size';
123  	 l_string_size INTEGER;
124    BEGIN
125  	 IF NVL(p_string_length, 0) > otap_constants.OTAP_NUM_MAX_FILL_LENGTH
