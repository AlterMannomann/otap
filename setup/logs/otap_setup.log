470  
471    FUNCTION get_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
472  	 RETURN otap_view_result_tbl PIPELINED
473    IS
474  	 CURSOR cur_fn_footer(cp_show IN NUMBER)
475  	 IS
476  	   SELECT result_text
477  	     FROM TABLE(otap_generate.build_function_footer(cp_show))
478  	 ;
479  	 CURSOR cur_prc_footer(cp_show IN NUMBER)
480  	 IS
481  	   SELECT result_text
482  	     FROM TABLE(otap_generate.build_procedure_footer(cp_show))
483  	 ;
484  	 CURSOR cur_scr_footer(cp_show IN NUMBER)
485  	 IS
486  	   SELECT result_text
487  	     FROM TABLE(otap_generate.build_script_footer(cp_show))
488  	 ;
489    BEGIN
490  	 IF generation_type = otap_constants.OTAP_GEN_TYPE_FUNCTION
491  	 THEN
492  	   FOR rec IN cur_fn_footer(p_show_header)
493  	   LOOP
494  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
495  	   END LOOP;
496  	 ELSIF generation_type = otap_constants.OTAP_GEN_TYPE_PROCEDURE
497  	 THEN
498  	   FOR rec IN cur_prc_footer(p_show_header)
499  	   LOOP
500  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
501  	   END LOOP;
502  	 ELSE
503  	   -- all other cases script
504  	   FOR rec IN cur_scr_footer(p_show_header)
505  	   LOOP
506  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
507  	   END LOOP;
508  	 END IF;
509  	 RETURN;
510    EXCEPTION
511  	 WHEN NO_DATA_NEEDED THEN
512  	   RAISE;
513    END get_footer;
514  
515    FUNCTION column_tests( p_table	      IN VARCHAR2
516  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
517  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
518  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
519  			    , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
520  			    , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
521  			    )
522  	 RETURN otap_view_result_tbl PIPELINED
523    IS
524  	 l_statement   VARCHAR2(4000 CHAR);
525  	 l_schema      VARCHAR2(128 CHAR);
526  	 l_table       VARCHAR2(128 CHAR);
527  	 l_like        VARCHAR2(256 CHAR);
528  	 l_test_count  INTEGER;
529  	 l_pad_par     INTEGER;
530  	 CURSOR cur_columns( cp_schema IN VARCHAR2
531  			   , cp_table  IN VARCHAR2
532  			   , cp_like   IN VARCHAR2
533  			   , cp_excl   IN NUMBER
534  			   )
535  	 IS
536  	   SELECT table_name
537  		, column_name
538  		, owner
539  		, data_type
540  		, data_precision
541  		, data_length
542  		, data_scale
543  		, nullable
544  		, data_default_vc
545  	     FROM dba_tab_columns
546  	    WHERE owner 	 = cp_schema
547  	      AND table_name	 = cp_table
548  	      AND column_name LIKE cp_like ESCAPE '\'
549  	      AND NOT otap_string.is_sys_object(column_name, cp_excl)
550  	    ORDER BY column_id
551  	 ;
552  	 CURSOR cur_header( cp_prefix IN VARCHAR2
553  			  , cp_schema IN VARCHAR2
554  			  , cp_type   IN VARCHAR2
555  			  , cp_object IN VARCHAR2
556  			  , cp_scope  IN VARCHAR2
557  			  , cp_count  IN NUMBER
558  			  , cp_show   IN NUMBER
559  			  )
560  	 IS
561  	   SELECT result_text
562  	     FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
563  	 ;
564  	 CURSOR cur_footer(cp_show IN NUMBER)
565  	 IS
566  	   SELECT result_text
567  	     FROM TABLE(otap_generate.get_footer(cp_show))
568  	 ;
569    BEGIN
570  	 IF p_table IS NOT NULL
571  	 THEN
572  	   l_table	:= otap_string.reduce(p_table, 128);
573  	   l_like	:= NVL(p_like_column, '%');
574  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
575  	   -- get test count
576  	   SELECT COUNT(*)
577  	     INTO l_test_count
578  	     FROM dba_tab_columns
579  	    WHERE owner 	 = l_schema
580  	      AND table_name	 = l_table
581  	      AND column_name LIKE l_like ESCAPE '\'
582  	      AND NOT otap_string.is_sys_object(column_name, p_excl_sysgen)
583  	   ;
584  	   -- get header
585  	   FOR rec IN cur_header(p_title_prefix, l_schema, 'columns', l_table, l_like, l_test_count, p_show_header)
586  	   LOOP
587  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
588  	   END LOOP;
589  	   l_pad_par := otap_generate.get_code_prefix_len + 20;
590  	   FOR rec IN cur_columns(l_schema, l_table, l_like, p_excl_sysgen)
591  	   LOOP
592  	     l_statement := otap_generate.get_code_prefix || 'otap_test.has_column( p_table_name => ''' || rec.table_name || '''';
593  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
594  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
595  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
596  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
597  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
598  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_type => ''' || rec.data_type || '''';
599  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
600  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_length => ' || TRIM(TO_CHAR(rec.data_length));
601  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
602  	     IF rec.data_precision IS NOT NULL
603  	     THEN
604  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_precision => ' || TRIM(TO_CHAR(rec.data_precision));
605  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
606  	     END IF;
607  	     IF rec.data_scale IS NOT NULL
608  	     THEN
609  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_scale => ' || TRIM(TO_CHAR(rec.data_scale));
610  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
611  	     END IF;
612  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_nullable => ''' || rec.nullable || '''';
613  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
614  	     IF     rec.data_default_vc IS NOT NULL
615  		AND NOT otap_string.is_sys_object(rec.data_default_vc, p_excl_sysgen)
616  	     THEN
617  	       IF INSTR(rec.data_default_vc, '''') > 0
618  	       THEN
619  		 l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_default => q''[' || TRIM(rec.data_default_vc) || ']''';
620  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
621  	       ELSE
622  		 l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_default => ''' || TRIM(rec.data_default_vc) || '''';
623  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
624  	       END IF;
625  	     END IF;
626  	     l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
627  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
628  	   END LOOP;
629  	   FOR rec IN cur_footer(p_show_header)
630  	   LOOP
631  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
632  	   END LOOP;
633  	 END IF;
634  	 RETURN;
635    EXCEPTION
636  	 WHEN NO_DATA_NEEDED THEN
637  	   RAISE;
638    END column_tests;
639  
640    FUNCTION table_tests( p_like_table    IN VARCHAR2 DEFAULT '%'
641  			   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
642  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
643  			   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
644  			   , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
645  			   )
646  	 RETURN otap_view_result_tbl PIPELINED
647    IS
648  	 l_statement   VARCHAR2(4000 CHAR);
649  	 l_schema      VARCHAR2(128 CHAR);
650  	 l_like        VARCHAR2(256 CHAR);
651  	 l_test_count  INTEGER;
652  	 l_pad_par     INTEGER;
653  	 CURSOR cur_tables( cp_schema IN VARCHAR2
654  			  , cp_like   IN VARCHAR2
655  			  , cp_excl   IN NUMBER
656  			  )
657  	 IS
658  	   SELECT object_name AS table_name
659  	     FROM dba_objects
660  	    WHERE owner 	 = cp_schema
661  	      AND object_type	 = 'TABLE'
662  	      AND object_name LIKE cp_like ESCAPE '\'
663  	      AND NOT otap_string.is_sys_object(object_name, cp_excl)
664  	 ;
665  	 CURSOR cur_columns( cp_schema IN VARCHAR2
666  			   , cp_table  IN VARCHAR2
667  			   , cp_like   IN VARCHAR2
668  			   , cp_prefix IN VARCHAR2
669  			   , cp_excl   IN NUMBER
670  			   )
671  	 IS
672  	   SELECT result_text
673  	     FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
674  	 ;
675  	 CURSOR cur_header( cp_prefix IN VARCHAR2
676  			  , cp_schema IN VARCHAR2
677  			  , cp_type   IN VARCHAR2
678  			  , cp_object IN VARCHAR2
679  			  , cp_scope  IN VARCHAR2
680  			  , cp_count  IN NUMBER
681  			  , cp_show   IN NUMBER
682  			  )
683  	 IS
684  	   SELECT result_text
685  	     FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
686  	 ;
687  	 CURSOR cur_footer(cp_show IN NUMBER)
688  	 IS
689  	   SELECT result_text
690  	     FROM TABLE(otap_generate.get_footer(cp_show))
691  	 ;
692    BEGIN
693  	 l_like       := NVL(p_like_table, '%');
694  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
695  	 -- get test count, simulate conditions of called test generators
696  	    WITH base AS
697  		(SELECT object_name
698  		      , object_type
699  		      , owner
700  		   FROM dba_objects
701  		  WHERE owner = l_schema
702  			-- currently supported objects
703  		    AND object_type    = 'TABLE'
704  			-- user like condition
705  		    AND object_name LIKE l_like ESCAPE '\'
706  			-- user exclude condition
707  		    AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
708  		)
709  		-- counter objects
710  	      , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
711  	      , cols AS
712  		(SELECT dbc.owner
713  		      , dbc.table_name
714  		      , dbc.column_name
715  		   FROM dba_tab_columns dbc
716  		  INNER JOIN base
717  		     ON dbc.owner      = base.owner
718  		    AND dbc.table_name = base.object_name
719  			-- user like condition
720  		  WHERE dbc.column_name LIKE '%' ESCAPE '\'
721  			-- user exclude condition
722  		    AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
723  		)
724  	      , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
725  	      , cnt AS
726  		(SELECT expected_count, 'BASE' AS info FROM cnt_base
727  		  UNION ALL
728  		 SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
729  		)
730  	 SELECT SUM(expected_count) INTO l_test_count FROM cnt;
731  	 -- get header
732  	 FOR rec IN cur_header(p_title_prefix, l_schema, 'tables', NULL, l_like, l_test_count, p_show_header)
733  	 LOOP
734  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
735  	 END LOOP;
736  	 l_pad_par := otap_generate.get_code_prefix_len + 19;
737  	 -- build group row
738  	 l_statement := otap_generate.get_code_pad || '-- set test group for tables';
739  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
740  	 l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''tables'')' || otap_generate.get_code_postfix;
741  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
742  	 FOR rec IN cur_tables(l_schema, l_like, p_excl_sysgen)
743  	 LOOP
744  	   l_statement := otap_generate.get_code_pad || '-- set test name for table';
745  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
746  	   l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''table ' || rec.table_name || ''')' || otap_generate.get_code_postfix;
747  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
748  	   l_statement := otap_generate.get_code_prefix || 'otap_test.has_table( p_table_name => ''' || rec.table_name || '''';
749  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
750  	   l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
751  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
752  	   l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
753  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
754  	   FOR colrec IN cur_columns(l_schema, rec.table_name, '%', p_title_prefix, p_excl_sysgen)
755  	   LOOP
756  	     PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
757  	   END LOOP;
758  	 END LOOP;
759  	 FOR rec IN cur_footer(p_show_header)
760  	 LOOP
761  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
762  	 END LOOP;
763  	 RETURN;
764    EXCEPTION
765  	 WHEN NO_DATA_NEEDED THEN
766  	   RAISE;
767    END table_tests;
768  
769    FUNCTION trigger_tests( p_like_trigger  IN VARCHAR2 DEFAULT '%'
770  			     , p_schema        IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
771  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
772  			     , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
773  			     , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
774  			     )
775  	 RETURN otap_view_result_tbl PIPELINED
776    IS
777  	 l_statement   VARCHAR2(4000 CHAR);
778  	 l_schema      VARCHAR2(128 CHAR);
779  	 l_like        VARCHAR2(256 CHAR);
780  	 l_count       INTEGER;
781  	 l_test_count  INTEGER;
782  	 l_pad_par     INTEGER;
783  	 CURSOR cur_table_trigger( cp_schema IN VARCHAR2
784  				 , cp_like   IN VARCHAR2
785  				 , cp_excl   IN NUMBER
786  				 )
787  	 IS
788  	   SELECT table_name
789  	     FROM dba_triggers
790  	    WHERE owner 	  = cp_schema
791  	      AND table_name	 IS NOT NULL
792  	      AND trigger_name LIKE cp_like ESCAPE '\'
793  	      AND NOT otap_string.is_sys_object(table_name, cp_excl)
794  	      AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
795  	    GROUP BY table_name
796  	    ORDER BY table_name
797  	 ;
798  	 CURSOR cur_trigger( cp_schema IN VARCHAR2
799  			   , cp_table  IN VARCHAR2
800  			   , cp_like   IN VARCHAR2
801  			   , cp_excl   IN NUMBER
802  			   )
803  	 IS
804  	   SELECT trigger_name
805  		, table_name
806  		, table_owner
807  		, owner
808  		, trigger_type
809  		, triggering_event
810  	     FROM dba_triggers
811  	    WHERE owner 	  = cp_schema
812  	      AND table_name	  = cp_table
813  	      AND trigger_name LIKE cp_like ESCAPE '\'
814  	      AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
815  	    ORDER BY trigger_name
816  	 ;
817  	 CURSOR cur_other_trigger( cp_schema IN VARCHAR2
818  				 , cp_like   IN VARCHAR2
819  				 , cp_excl   IN NUMBER
820  				 )
821  	 IS
822  	   SELECT trigger_name
823  		, owner
824  		, trigger_type
825  		, triggering_event
826  	     FROM dba_triggers
827  	    WHERE owner 	  = cp_schema
828  	      AND table_name	 IS NULL
829  	      AND trigger_name LIKE cp_like ESCAPE '\'
830  	      AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
831  	    ORDER BY trigger_name
832  	 ;
833  	 CURSOR cur_header( cp_prefix IN VARCHAR2
834  			  , cp_schema IN VARCHAR2
835  			  , cp_type   IN VARCHAR2
836  			  , cp_object IN VARCHAR2
837  			  , cp_scope  IN VARCHAR2
838  			  , cp_count  IN NUMBER
839  			  , cp_show   IN NUMBER
840  			  )
841  	 IS
842  	   SELECT result_text
843  	     FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
844  	 ;
845  	 CURSOR cur_footer(cp_show IN NUMBER)
846  	 IS
847  	   SELECT result_text
848  	     FROM TABLE(otap_generate.get_footer(cp_show))
849  	 ;
850    BEGIN
851  	 l_like       := NVL(p_like_trigger, '%');
852  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
853  	 -- get test count
854  	 SELECT COUNT(*)
855  	   INTO l_test_count
856  	   FROM dba_triggers
857  	  WHERE owner		= l_schema
858  	    AND trigger_name LIKE l_like ESCAPE '\'
859  	    AND NOT otap_string.is_sys_object(trigger_name, p_excl_sysgen)
860  	 ;
861  	 -- get header
862  	 FOR rec IN cur_header(p_title_prefix, l_schema, 'trigger', NULL, l_like, l_test_count, p_show_header)
863  	 LOOP
864  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
865  	 END LOOP;
866  	 l_pad_par := otap_generate.get_code_prefix_len + 21;
867  	 l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_group_name(''trigger'')' || otap_generate.get_code_postfix;
868  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
869  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NOT NULL;
870  	 IF l_count > 0
871  	 THEN
872  	   FOR rec IN cur_table_trigger(l_schema, l_like, p_excl_sysgen)
873  	   LOOP
874  	     -- build name
875  	     l_statement := otap_generate.get_code_pad || '-- set test name for table trigger';
876  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
877  	     l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_name(''table trigger ' || rec.table_name || ''')' || otap_generate.get_code_postfix;
878  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
879  	     FOR rectrg IN cur_trigger(l_schema, rec.table_name, '%', p_excl_sysgen)
880  	     LOOP
881  	       l_statement := otap_generate.get_code_prefix || 'otap_test.has_trigger( p_trigger_name => ''' || rectrg.trigger_name || '''';
882  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
883  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rectrg.owner || '''';
884  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
885  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_type => ''' || TRIM(rectrg.trigger_type) || '''';
886  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
887  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_event => ''' || TRIM(rectrg.triggering_event) || '''';
888  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
889  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_owner => ''' || TRIM(rectrg.table_owner) || '''';
890  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
891  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_name => ''' || TRIM(rectrg.table_name) || '''';
892  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
893  	       l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
894  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
895  	     END LOOP;
896  	   END LOOP;
897  	 END IF;
898  	 -- trigger without table
899  	 SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NULL;
900  	 IF l_count > 0
901  	 THEN
902  	   l_statement := otap_generate.get_code_pad || '-- set test name for non table trigger';
903  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
904  	   l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_name(''trigger without table'')' || otap_generate.get_code_postfix;
905  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
906  	   FOR rec IN cur_other_trigger(l_schema, l_like, p_excl_sysgen)
907  	   LOOP
908  	     l_statement := otap_generate.get_code_prefix || 'otap_test.has_trigger( p_trigger_name => ''' || rec.trigger_name || '''';
909  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
910  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
911  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
912  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_type => ''' || TRIM(rec.trigger_type) || '''';
913  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
914  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_event => ''' || TRIM(rec.triggering_event) || '''';
915  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
916  	     l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
917  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
918  	   END LOOP;
919  	 END IF;
920  	 FOR rec IN cur_footer(p_show_header)
921  	 LOOP
922  	   PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
923  	 END LOOP;
924  	 RETURN;
925    EXCEPTION
926  	 WHEN NO_DATA_NEEDED THEN
927  	   RAISE;
928    END trigger_tests;
929  
930    FUNCTION procedure_tests( p_like_procedure IN VARCHAR2 DEFAULT '%'
931  			       , p_package_name   IN VARCHAR  DEFAULT NULL
932  			       , p_schema	  IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
933  			       , p_title_prefix   IN VARCHAR2 DEFAULT NULL
934  			       , p_show_header	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
935  			       , p_excl_sysgen	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
936  			       )
937  	 RETURN otap_view_result_tbl PIPELINED
938    IS
939  	 l_statement   VARCHAR2(4000 CHAR);
940  	 l_schema      VARCHAR2(128 CHAR);
941  	 l_like        VARCHAR2(256 CHAR);
942  	 l_package     VARCHAR2(128 CHAR);
943  	 l_test_count  INTEGER;
944  	 l_pad_par     INTEGER;
945  	 CURSOR cur_procedures( cp_schema  IN VARCHAR2
946  			      , cp_package IN VARCHAR2
947  			      , cp_like    IN VARCHAR2
948  			      , cp_excl    IN NUMBER
949  			      )
950  	 IS
951  	     WITH prc AS
952  		  (SELECT dbo.owner
953  			, dbp.procedure_name
954  			, CASE
955  			    WHEN dbr.position	    = 0
956  			     AND dbr.argument_name IS NULL
957  			    THEN 'FUNCTION'
958  			    ELSE 'PROCEDURE'
959  			  END AS procedure_type
960  			, CASE
961  			    WHEN dbr.position	    = 0
962  			     AND dbr.argument_name IS NULL
963  			    THEN dbr.data_type
964  			    ELSE NULL
965  			  END AS return_type
966  			, dbo.status
967  			, dbo.object_name AS package_name
968  		     FROM dba_objects dbo
969  		     LEFT OUTER JOIN dba_procedures dbp
970  		       ON dbo.owner	  = dbp.owner
971  		      AND dbo.object_name = dbp.object_name
972  		      AND dbo.object_type = dbp.object_type
973  		     LEFT OUTER JOIN dba_arguments dbr
974  		       ON dbp.owner	    = dbr.owner
975  		      AND dbp.object_name   = dbr.package_name
976  		      AND dbp.procedure_name = dbr.object_name
977  		      AND dbp.object_id     = dbr.object_id
978  		      AND dbp.subprogram_id = dbr.subprogram_id
979  		      AND dbr.sequence	    = 1
980  		    WHERE dbo.owner	   = cp_schema
981  		      AND dbo.object_type  = 'PACKAGE'
982  			  -- exclude package itself
983  		      AND dbp.procedure_name IS NOT NULL
984  		      AND NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl)
985  		      AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
986  		    UNION ALL
987  		   SELECT dbo.owner
988  			, dbo.object_name AS procedure_name
989  			, dbo.object_type AS procedure_type
990  			, CASE
991  			    WHEN dbr.position	    = 0
992  			     AND dbr.argument_name IS NULL
993  			    THEN dbr.data_type
994  			    ELSE NULL
995  			  END AS return_type
996  			, dbo.status
997  			, NULL AS package_name
998  		     FROM dba_objects dbo
999  		     LEFT OUTER JOIN dba_procedures dbp
1000  			ON dbo.owner	   = dbp.owner
1001  		       AND dbo.object_name = dbp.object_name
1002  		       AND dbo.object_type = dbp.object_type
1003  		      LEFT OUTER JOIN dba_arguments dbr
1004  			ON dbp.owner	     = dbr.owner
1005  		       AND dbp.object_name   = dbr.object_name
1006  		       AND dbp.object_id     = dbr.object_id
1007  		       AND dbp.subprogram_id = dbr.subprogram_id
1008  		       AND dbr.sequence      = 1
1009  		     WHERE dbo.owner	    = cp_schema
1010  		       AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
1011  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1012  		   )
1013  	    SELECT DISTINCT
1014  		   owner
1015  		 , procedure_name
1016  		 , procedure_type
1017  		 , return_type
1018  		 , status
1019  		 , package_name
1020  	      FROM prc
1021  	     WHERE NVL(package_name, 'N/A') = NVL(cp_package, 'N/A')
1022  	       AND procedure_name	 LIKE cp_like ESCAPE '\'
1023  	  ;
1024  	  CURSOR cur_count( cp_schema  IN VARCHAR2
1025  			  , cp_package IN VARCHAR2
1026  			  , cp_like    IN VARCHAR2
1027  			  , cp_excl    IN NUMBER
1028  			  )
1029  	  IS
1030  	      WITH prc AS
1031  		   (SELECT dbo.owner
1032  			 , dbp.procedure_name
1033  			 , CASE
1034  			     WHEN dbr.position	     = 0
1035  			      AND dbr.argument_name IS NULL
1036  			     THEN 'FUNCTION'
1037  			     ELSE 'PROCEDURE'
1038  			   END AS procedure_type
1039  			 , CASE
1040  			     WHEN dbr.position	     = 0
1041  			      AND dbr.argument_name IS NULL
1042  			     THEN dbr.data_type
1043  			     ELSE NULL
1044  			   END AS return_type
1045  			 , dbo.status
1046  			 , dbo.object_name AS package_name
1047  		      FROM dba_objects dbo
1048  		      LEFT OUTER JOIN dba_procedures dbp
1049  			ON dbo.owner	   = dbp.owner
1050  		       AND dbo.object_name = dbp.object_name
1051  		       AND dbo.object_type = dbp.object_type
1052  		      LEFT OUTER JOIN dba_arguments dbr
1053  			ON dbp.owner	     = dbr.owner
1054  		       AND dbp.object_name   = dbr.package_name
1055  		       AND dbp.procedure_name = dbr.object_name
1056  		       AND dbp.object_id     = dbr.object_id
1057  		       AND dbp.subprogram_id = dbr.subprogram_id
1058  		       AND dbr.sequence      = 1
1059  		     WHERE dbo.owner	    = cp_schema
1060  		       AND dbo.object_type  = 'PACKAGE'
1061  			   -- exclude package itself
1062  		       AND dbp.procedure_name IS NOT NULL
1063  		       AND NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl)
1064  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1065  		     UNION ALL
1066  		    SELECT dbo.owner
1067  			 , dbo.object_name AS procedure_name
1068  			 , dbo.object_type AS procedure_type
1069  			 , CASE
1070  			     WHEN dbr.position	     = 0
1071  			      AND dbr.argument_name IS NULL
1072  			     THEN dbr.data_type
1073  			     ELSE NULL
1074  			   END AS return_type
1075  			 , dbo.status
1076  			 , NULL AS package_name
1077  		      FROM dba_objects dbo
1078  		      LEFT OUTER JOIN dba_procedures dbp
1079  			ON dbo.owner	   = dbp.owner
1080  		       AND dbo.object_name = dbp.object_name
1081  		       AND dbo.object_type = dbp.object_type
1082  		      LEFT OUTER JOIN dba_arguments dbr
1083  			ON dbp.owner	     = dbr.owner
1084  		       AND dbp.object_name   = dbr.object_name
1085  		       AND dbp.object_id     = dbr.object_id
1086  		       AND dbp.subprogram_id = dbr.subprogram_id
1087  		       AND dbr.sequence      = 1
1088  		     WHERE dbo.owner	    = cp_schema
1089  		       AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
1090  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1091  		   )
1092  		 , res AS
1093  		   (SELECT DISTINCT
1094  			   owner
1095  			 , procedure_name
1096  			 , procedure_type
1097  			 , return_type
1098  			 , status
1099  			 , package_name
1100  		      FROM prc
1101  		     WHERE NVL(package_name, 'N/A') = NVL(cp_package, 'N/A')
1102  		       AND procedure_name	 LIKE cp_like ESCAPE '\'
1103  		   )
1104  	  SELECT COUNT(*) AS test_count FROM res;
1105  
1106  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1107  			   , cp_schema IN VARCHAR2
1108  			   , cp_type   IN VARCHAR2
1109  			   , cp_object IN VARCHAR2
1110  			   , cp_scope  IN VARCHAR2
1111  			   , cp_count  IN NUMBER
1112  			   , cp_show   IN NUMBER
1113  			   )
1114  	  IS
1115  	    SELECT result_text
1116  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1117  	  ;
1118  	  CURSOR cur_footer(cp_show IN NUMBER)
1119  	  IS
1120  	    SELECT result_text
1121  	      FROM TABLE(otap_generate.get_footer(cp_show))
1122  	  ;
1123  	BEGIN
1124  	  l_like       := NVL(p_like_procedure, '%');
1125  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1126  	  OPEN cur_count(l_schema, p_package_name, l_like, p_excl_sysgen);
1127  	  FETCH cur_count INTO l_test_count;
1128  	  CLOSE cur_count;
1129  	  -- get header
1130  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'procedures', NULL, l_like, l_test_count, p_show_header)
1131  	  LOOP
1132  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1133  	  END LOOP;
1134  	  l_pad_par := otap_generate.get_code_prefix_len + 23;
1135  	  FOR rec IN cur_procedures(l_schema, p_package_name, l_like, p_excl_sysgen)
1136  	  LOOP
1137  	    IF p_package_name IS NULL
1138  	    THEN
1139  	      -- set name if not package, otherwise name is already set
1140  	      l_statement := otap_generate.get_code_pad || '-- set test name for not package procedures and functions';
1141  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1142  	      l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_name(''' || rec.procedure_type || ' ' || rec.procedure_name || ''')' || otap_generate.get_code_postfix;
1143  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1144  	    END IF;
1145  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_procedure( p_procedure_name => ''' || rec.procedure_name || '''';
1146  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1147  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1148  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1149  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_procedure_type => ''' || rec.procedure_type || '''';
1150  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1151  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_package_name => ''' || rec.package_name || '''';
1152  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1153  	    IF rec.procedure_type = 'FUNCTION'
1154  	    THEN
1155  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_return_type => ''' || rec.return_type || '''';
1156  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1157  	    END IF;
1158  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1159  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1160  	  END LOOP;
1161  	  FOR rec IN cur_footer(p_show_header)
1162  	  LOOP
1163  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1164  	  END LOOP;
1165  	  RETURN;
1166  	EXCEPTION
1167  	  WHEN NO_DATA_NEEDED THEN
1168  	    RAISE;
1169  	END procedure_tests;
1170  
1171  	FUNCTION package_tests( p_like_package	IN VARCHAR2 DEFAULT '%'
1172  			      , p_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1173  			      , p_title_prefix	IN VARCHAR2 DEFAULT NULL
1174  			      , p_show_header	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1175  			      , p_excl_sysgen	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1176  			      )
1177  	  RETURN otap_view_result_tbl PIPELINED
1178  	IS
1179  	  l_statement	VARCHAR2(4000 CHAR);
1180  	  l_schema	VARCHAR2(128 CHAR);
1181  	  l_like	VARCHAR2(256 CHAR);
1182  	  l_count	INTEGER;
1183  	  l_test_count	INTEGER;
1184  	  l_pad_par	INTEGER;
1185  	  CURSOR cur_packages( cp_schema IN VARCHAR2
1186  			     , cp_like	 IN VARCHAR2
1187  			     , cp_excl	 IN NUMBER
1188  			     )
1189  	  IS
1190  	    SELECT object_name AS package_name
1191  		 , COUNT(*)    AS package_objects
1192  	      FROM dba_objects
1193  	     WHERE owner	  = cp_schema
1194  	       AND object_type LIKE 'PACKAGE%'
1195  	       AND object_name LIKE cp_like ESCAPE '\'
1196  	       AND NOT otap_string.is_sys_object(object_name, cp_excl)
1197  	     GROUP BY object_name
1198  	  ;
1199  	  CURSOR cur_procedures( cp_schema  IN VARCHAR2
1200  			       , cp_package IN VARCHAR2
1201  			       , cp_like    IN VARCHAR2
1202  			       , cp_prefix  IN VARCHAR2
1203  			       , cp_excl    IN NUMBER
1204  			       )
1205  	  IS
1206  	    SELECT result_text
1207  	      FROM TABLE(otap_generate.procedure_tests(cp_like, cp_package, cp_schema, cp_prefix, 0, cp_excl))
1208  	  ;
1209  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1210  			   , cp_schema IN VARCHAR2
1211  			   , cp_type   IN VARCHAR2
1212  			   , cp_object IN VARCHAR2
1213  			   , cp_scope  IN VARCHAR2
1214  			   , cp_count  IN NUMBER
1215  			   , cp_show   IN NUMBER
1216  			   )
1217  	  IS
1218  	    SELECT result_text
1219  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1220  	  ;
1221  	  CURSOR cur_footer(cp_show IN NUMBER)
1222  	  IS
1223  	    SELECT result_text
1224  	      FROM TABLE(otap_generate.get_footer(cp_show))
1225  	  ;
1226  	BEGIN
1227  	  l_like       := NVL(p_like_package, '%');
1228  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1229  	  -- get test count, simulate conditions of called test generators
1230  	     WITH base AS
1231  		 (SELECT object_name
1232  		       , object_type
1233  		       , owner
1234  		    FROM dba_objects
1235  		   WHERE owner = l_schema
1236  			 -- currently supported objects
1237  		     AND object_type LIKE 'PACKAGE%'
1238  			 -- user like condition
1239  		     AND object_name LIKE l_like ESCAPE '\'
1240  			 -- user exclude condition
1241  		     AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1242  		 )
1243  		 -- counter objects
1244  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1245  		 -- depending procedures
1246  	       , prc AS
1247  		 (SELECT dbp.procedure_name
1248  		       , dbp.object_name
1249  		       , dbp.object_type
1250  		    FROM dba_procedures dbp
1251  		   INNER JOIN base
1252  		      ON dbp.object_name = base.object_name
1253  		     AND dbp.object_type = base.object_type
1254  		     AND dbp.owner	 = base.owner
1255  			 -- exclude pure functions and procedures, already counted by base
1256  		     AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
1257  			 -- user exclude condition
1258  		   WHERE NOT otap_string.is_sys_object(dbp.procedure_name, p_excl_sysgen)
1259  		 )
1260  	       , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
1261  	       , cnt AS
1262  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
1263  		   UNION ALL
1264  		  SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
1265  		 )
1266  	  SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1267  	  -- get header
1268  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'packages', NULL, l_like, l_test_count, p_show_header)
1269  	  LOOP
1270  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1271  	  END LOOP;
1272  	  l_pad_par := otap_generate.get_code_prefix_len + 21;
1273  	  -- build group row
1274  	  l_statement := otap_generate.get_code_pad || '-- set test group for package';
1275  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1276  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''packages'')' || otap_generate.get_code_postfix;
1277  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1278  	  -- first loop through packages
1279  	  FOR rec IN cur_packages(l_schema, l_like, p_excl_sysgen)
1280  	  LOOP
1281  	    l_statement := otap_generate.get_code_pad || '-- set test name for package';
1282  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1283  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''package ' || rec.package_name || ''')' || otap_generate.get_code_postfix;
1284  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1285  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
1286  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1287  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1288  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1289  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1290  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1291  	    IF rec.package_objects = 2
1292  	    THEN
1293  	      l_statement := otap_generate.get_code_prefix || 'otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
1294  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1295  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1296  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1297  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_package_type => ''PACKAGE BODY''';
1298  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1299  	      l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1300  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1301  	    END IF;
1302  	    -- now loop through the package procedures and functions
1303  	    FOR recfn IN cur_procedures(l_schema, rec.package_name, '%', p_title_prefix, p_excl_sysgen)
1304  	    LOOP
1305  	      PIPE ROW (otap_view_result_rec(recfn.result_text, NULL));
1306  	    END LOOP;
1307  	  END LOOP;
1308  	  FOR rec IN cur_footer(p_show_header)
1309  	  LOOP
1310  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1311  	  END LOOP;
1312  	  RETURN;
1313  	EXCEPTION
1314  	  WHEN NO_DATA_NEEDED THEN
1315  	    RAISE;
1316  	END package_tests;
