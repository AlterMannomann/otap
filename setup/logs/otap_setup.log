1454  	FUNCTION schema_tests( p_like_schema   IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1455  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
1456  			     , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1457  			     , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1458  			     )
1459  	  RETURN otap_view_result_tbl PIPELINED
1460  	IS
1461  	  l_statement	VARCHAR2(4000 CHAR);
1462  	  l_schema	VARCHAR2(128 CHAR);
1463  	  l_like	VARCHAR2(256 CHAR);
1464  	  l_test_count	INTEGER;
1465  	  l_pad_par	INTEGER;
1466  	  CURSOR cur_schemas( cp_like IN VARCHAR2
1467  			    , cp_excl IN NUMBER
1468  			    )
1469  	  IS
1470  	    SELECT username
1471  	      FROM dba_users
1472  	     WHERE username LIKE cp_like ESCAPE '\'
1473  	       AND NOT otap_string.is_sys_object(username, cp_excl)
1474  	  ;
1475  	  CURSOR cur_tables( cp_like   IN VARCHAR2
1476  			   , cp_schema IN VARCHAR2
1477  			   , cp_prefix IN VARCHAR2
1478  			   , cp_excl   IN NUMBER
1479  			   )
1480  	  IS
1481  	    SELECT result_text
1482  	      FROM TABLE(otap_generate.table_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
1483  	  ;
1484  	  CURSOR cur_trigger( cp_like	IN VARCHAR2
1485  			    , cp_schema IN VARCHAR2
1486  			    , cp_prefix IN VARCHAR2
1487  			    , cp_excl	IN NUMBER
1488  			    )
1489  	  IS
1490  	    SELECT result_text
1491  	      FROM TABLE(otap_generate.trigger_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
1492  	  ;
1493  	  CURSOR cur_packages( cp_like	 IN VARCHAR2
1494  			     , cp_schema IN VARCHAR2
1495  			     , cp_prefix IN VARCHAR2
1496  			     , cp_excl	 IN NUMBER
1497  			     )
1498  	  IS
1499  	    SELECT result_text
1500  	      FROM TABLE(otap_generate.package_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
1501  	  ;
1502  	  CURSOR cur_views( cp_like   IN VARCHAR2
1503  			  , cp_schema IN VARCHAR2
1504  			  , cp_prefix IN VARCHAR2
1505  			  , cp_excl   IN NUMBER
1506  			  )
1507  	  IS
1508  	    SELECT result_text
1509  	      FROM TABLE(otap_generate.view_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
1510  	  ;
1511  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1512  			   , cp_schema IN VARCHAR2
1513  			   , cp_type   IN VARCHAR2
1514  			   , cp_object IN VARCHAR2
1515  			   , cp_scope  IN VARCHAR2
1516  			   , cp_count  IN NUMBER
1517  			   , cp_show   IN NUMBER
1518  			   )
1519  	  IS
1520  	    SELECT result_text
1521  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1522  	  ;
1523  	  CURSOR cur_footer(cp_show IN NUMBER)
1524  	  IS
1525  	    SELECT result_text
1526  	      FROM TABLE(otap_generate.get_footer(cp_show))
1527  	  ;
1528  	BEGIN
1529  	  l_like       := NVL(p_like_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'));
1530  	  l_schema     := otap_string.reduce(SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'), 128);
1531  	  -- get test count, simulate conditions of called test generators
1532  	     WITH base AS
1533  		 (SELECT object_name
1534  		       , object_type
1535  		       , owner
1536  		    FROM dba_objects
1537  			 -- user like condition
1538  		   WHERE owner LIKE l_like ESCAPE '\'
1539  			 -- currently supported objects
1540  		     AND (   object_type   IN ('TABLE', 'FUNCTION', 'PROCEDURE')
1541  			  OR object_type LIKE '%VIEW'
1542  			  OR object_type LIKE 'PACKAGE%'
1543  			 )
1544  			 -- user exclude condition
1545  		     AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1546  		 )
1547  		 -- counter objects
1548  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1549  		 -- depending procedures
1550  	       , prc AS
1551  		 (SELECT dbp.procedure_name
1552  		       , dbp.object_name
1553  		       , dbp.object_type
1554  		    FROM dba_procedures dbp
1555  		   INNER JOIN base
1556  		      ON dbp.object_name = base.object_name
1557  		     AND dbp.object_type = base.object_type
1558  		     AND dbp.owner	 = base.owner
1559  			 -- exclude pure functions and procedures, already counted by base
1560  		     AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
1561  			 -- user exclude condition
1562  		   WHERE NOT otap_string.is_sys_object(dbp.procedure_name, p_excl_sysgen)
1563  		 )
1564  	       , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
1565  	       , cols AS
1566  		 (SELECT dbc.owner
1567  		       , dbc.table_name
1568  		       , dbc.column_name
1569  		    FROM dba_tab_columns dbc
1570  		   INNER JOIN base
1571  		      ON dbc.owner	= base.owner
1572  		     AND dbc.table_name = base.object_name
1573  			 -- user exclude condition
1574  		   WHERE NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
1575  		 )
1576  	       , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
1577  		 -- table triggers
1578  	       , trgt AS
1579  		 (SELECT dbt.owner
1580  		       , dbt.trigger_name
1581  		       , dbt.table_owner
1582  		    FROM dba_triggers dbt
1583  		   INNER JOIN base
1584  		      ON dbt.table_owner      = base.owner
1585  		     AND dbt.table_name       = base.object_name
1586  		     AND dbt.base_object_type = base.object_type
1587  		   WHERE dbt.table_name     IS NOT NULL
1588  			 -- user exclude condition
1589  		     AND NOT otap_string.is_sys_object(dbt.trigger_name, p_excl_sysgen)
1590  		 )
1591  	       , cnt_trgt AS (SELECT COUNT(*) AS expected_count FROM trgt)
1592  	       , trgs AS
1593  		 (SELECT dbt.owner
1594  		       , dbt.trigger_name
1595  		       , dbt.table_owner
1596  		    FROM dba_triggers dbt
1597  		   INNER JOIN base
1598  		      ON dbt.owner = base.owner
1599  		   WHERE dbt.table_name     IS NULL
1600  			 -- user exclude condition
1601  		     AND NOT otap_string.is_sys_object(dbt.trigger_name, p_excl_sysgen)
1602  		 )
1603  	       , cnt_trgs AS (SELECT COUNT(*) AS expected_count FROM trgs)
1604  	       , cnt AS
1605  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
1606  		   UNION ALL
1607  		  SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
1608  		   UNION ALL
1609  		  SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
1610  		   UNION ALL
1611  		  SELECT expected_count, 'TABLE TRIGGER' AS info FROM cnt_trgt
1612  		   UNION ALL
1613  		  SELECT expected_count, 'SCHEMA TRIGGER' AS info FROM cnt_trgs
1614  		 )
1615  	  SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1616  	  -- get header
1617  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'schemas', NULL, l_like, l_test_count, p_show_header)
1618  	  LOOP
1619  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1620  	  END LOOP;
1621  	  l_pad_par := otap_generate.get_code_prefix_len + 20;
1622  	  -- get schemas to process
1623  	  FOR recset IN cur_schemas(l_like, p_excl_sysgen)
1624  	  LOOP
1625  	    -- build set row
1626  	    l_statement := otap_generate.get_code_pad || '-- set test set for schema';
1627  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1628  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_set(''schema ' || recset.username || ''')' || otap_generate.get_code_postfix;
1629  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1630  	    FOR rec IN cur_tables('%', recset.username, p_title_prefix, p_excl_sysgen)
1631  	    LOOP
1632  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1633  	    END LOOP;
1634  	    FOR rec IN cur_trigger('%', recset.username, p_title_prefix, p_excl_sysgen)
1635  	    LOOP
1636  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1637  	    END LOOP;
1638  	    FOR rec IN cur_packages('%', recset.username, p_title_prefix, p_excl_sysgen)
1639  	    LOOP
1640  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1641  	    END LOOP;
1642  	    FOR rec IN cur_views('%', recset.username, p_title_prefix, p_excl_sysgen)
1643  	    LOOP
1644  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1645  	    END LOOP;
1646  	  END LOOP;
1647  	  FOR rec IN cur_footer(p_show_header)
1648  	  LOOP
1649  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1650  	  END LOOP;
1651  	  RETURN;
1652  	EXCEPTION
1653  	  WHEN NO_DATA_NEEDED THEN
1654  	    RAISE;
1655  	END schema_tests;
1656  
1657  END;
1658  /

