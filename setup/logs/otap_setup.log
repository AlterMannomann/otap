SQL> CREATE OR REPLACE PACKAGE otap_plan
  2  AS
  3  
  4    /**
  5    * This package provides the functions used by the wrapper package otap_test for test
  6    * setup, name definitions and test maintenance.
  7    *
  8    * It is a main for package otap_test or packages which have an OTAP_SESSION object
  9    * from otap_test. Otherwise won't work as expected. Exceptions are raised, if not handled.
 10    *
 11    * -20099 Internal error, OTAP_SESSION object not valid. Details see specific error message.
 12    */
 13  
 14    /** PROCEDURE otap_plan.write_test_result
 15    * Writes the result of a test to OTAP_RESULTS. If OTAP_SESSION persist_test is set to FALSE
 16    * the TO_DELETE flag is set on insert. Will retrieve most of the details from the current
 17    * session_record given by OTAP_TEST package or the test function using this procedure.
 18    * Will fail the test, if p_test_passed is not valid.
 19    *
 20    * @param p_test_description The test description for a specific test. If missing, will generate Unspecified test x where x is a SCN number.
 21    * @param p_otap_session A valid OTAP_SESSION object to be used for the insert with details on the test category and scope.
 22    * @param p_test_passed A valid test passed ID, allowed values are otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED and otap_constants.OTAP_NUM_TEST_UNDEFINED.
 23    * @param p_test_start The timestamp of the test start, must be provided by test functions.
 24    * @param p_test_end The timestamp of the test end, must be provided by test functions.
 25    * @param p_test_errors Test error information limited to 4000 chars.
 26    */
 27    PROCEDURE write_test_result( p_test_description IN VARCHAR2
 28  				  , p_otap_session     IN OTAP_SESSION
 29  				  , p_test_passed      IN NUMBER
 30  				  , p_test_start       IN TIMESTAMP
 31  				  , p_test_end	       IN TIMESTAMP
 32  				  , p_test_errors      IN VARCHAR2
 33  				  )
 34    ;
 35  
 36    /** PROCEDURE otap_plan.write_count_result
 37    * Checks if intended_count is set and writes a final test record about expected and executed tests.
 38    * Does nothing if OTAP_SESSION intended_count less or equal to 0.
 39    *
 40    * @param p_otap_session A valid OTAP_SESSION object to be used for test result insert.
 41    */
 42    PROCEDURE write_count_result(p_otap_session IN OTAP_SESSION);
 43  
 44    /** FUNCTION otap_plan.init_test
 45    * Provides the init_test functionality needed by otap_test and setting the package session variables.
 46    * Errors will get logged.
 47    *
 48    * @param p_test_count The amount of tests expected to be executed when called.
 49    * @param p_test_set The name of the test set applied if the name of the executed test procedure or function does not provide a test set name or name precendence is disabled.
 50    * @param p_test_group The name of the test group applied if the name of the executed test procedure or function does not provide a test group name or name precendence is disabled.
 51    * @param p_test_name The name of the test name applied if the name of the executed test procedure or function does not provide a test name or name precendence is disabled.
 52    * @param p_prefix The prefix to use for identifying test functions and procedures. Limited to 4 chars. Test functions and procedures must have a trailing delimiter _ after the prefix to be identified.
 53    * @param p_name_precedence Can disable the naming conventions for otap. If set to otap_constants.OTAP_NUM_FALSE, all tests will run under the defined test set and group, set by init_test.
 54    * @param p_include_pkg Can enable to search also packages and package procedures and functions that fit the naming convention with the given prefix, if set to otap_constants.OTAP_NUM_TRUE.
 55    * @param p_persist Can enable to persist the test results longer than the current default of PRESERVE_DAYS in OTAP_CONFIG, if set to otap_constants.OTAP_NUM_TRUE.
 56    * The following parameters are expected from OTAP_TEST package. Caller should not set this variables.
 57    * @param p_schema The current schema from caller environment as reported from otap_test.
 58    * @param p_user The current user from caller environment as reported from otap_test.
 59    * @param p_executor The session user from caller environment as reported from otap_test.
 60    * @param o_otap_session The OTAP_SESSION object to set.
 61    *
 62    * @return The current test session settings as text LF delimited.
 63    */
 64    FUNCTION init_test( p_test_count 	 IN	       NUMBER
 65  			 , p_test_set		 IN	       VARCHAR2
 66  			 , p_test_group 	 IN	       VARCHAR2
 67  			 , p_test_name		 IN	       VARCHAR2
 68  			 , p_prefix		 IN	       VARCHAR2
 69  			 , p_name_precedence	 IN	       NUMBER
 70  			 , p_include_pkg	 IN	       NUMBER
 71  			 , p_persist		 IN	       NUMBER
 72  			 , p_schema		 IN	       VARCHAR2
 73  			 , p_user		 IN	       VARCHAR2
 74  			 , p_executor		 IN	       VARCHAR2
 75  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
 76  			 )
 77  	 RETURN VARCHAR2
 78    ;
 79  
 80    /** FUNCTION otap_plan.run_tests
 81    * Identifies and runs test procedures. Test procedures are identified by a prefix with maximum 4 char length.
 82    * The prefix can be modified using otap_test.init_test. The delimiter for name components is always underline _.
 83    * The escape char used is backslash \. If name precedence is disabled, test set, group and test names are used
 84    * from the session record otherwise it tries to extract set, group and test name from the procedure name using
 85    * the session record entries as fallback name.
 86    *
 87    * The like expression is applied AFTER the prefix, complete search expression example with defaults: TEST\_%.
 88    *
 89    * As test procedure may manipulate the session record with test_init or test_finished, the resulting session
 90    * record is not reliable in sense of representing all tests. It represents only the last test run.
 91    *
 92    * Recommended usage: First run init_test, then call run_tests. In test procedures ensure that NO init_test or finish_test
 93    * occurs unless you persist the old test view results before executing finish_test or init_test. You may use the set functions
 94    * for test set, group or name within the procedure. After run_tests finished, inspect the test views and persist your test
 95    * results before executing init_test and run_tests again.
 96    *
 97    * @param p_like_expression The like expression (no regex) to limit further the procedures to run.
 98    * @param p_schema_overwrite The alternate schema to use for finding test procedures. Will replace the current session value if NOT NULL.
 99    * @param p_otap_session A valid OTAP_SESSION object to be used for test runs.
100    *
101    * @return A summary of the executed test procedures and session id at start of execution. Test summary can be found in the test views.
102    *
103    * @exception -20099 Internal error, invalid OTAP_SESSION object.
104    */
105    FUNCTION run_tests( p_like_expression   IN VARCHAR2 DEFAULT '%'
106  			 , p_schema_overwrite  IN VARCHAR2 DEFAULT NULL
107  			 , p_otap_session      IN OTAP_SESSION
108  			 )
109  	 RETURN VARCHAR2
110    ;
111  
112    /** FUNCTION otap_plan.finish_test
113    * Resets the OTAP_SESSION object. Will set a new session id, reset the counters and the names
114    * for test set, group and name. When a test session is finished, the test session view will not
115    * longer show the tests from the old session. If intended count is set, a test record about
116    * executed and expected tests is written.
117    *
118    * @param p_write_count_rec The indicator, if record count test should be done and written. Either otap_constants.OTAP_NUM_TRUE or otap_constants.OTAP_NUM_FALSE.
119    * @param o_otap_session The current session_record from OTAP_TEST package.
120    *
121    * @return A summary of the old session and details of the new session as text message LF delimited.
122    *
123    * @exception -20099 Internal error, invalid OTAP_SESSION object.
124    */
125    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
126  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
127  			   )
128  	 RETURN VARCHAR2
129    ;
130  
131  END;
132  /

