 90    FUNCTION column_tests( p_table	      IN VARCHAR2
 91  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
 92  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 93  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
 94  			    , p_show_header   IN INTEGER  DEFAULT 1
 95  			    , p_excl_sysgen   IN INTEGER  DEFAULT 1
 96  			    )
 97  	 RETURN otap_view_result_tbl PIPELINED
 98    IS
 99  	 l_statement   VARCHAR2(4000 CHAR);
100  	 l_schema      VARCHAR2(128 CHAR);
101  	 l_table       VARCHAR2(128 CHAR);
102  	 l_base_title  VARCHAR2(256 CHAR);
103  	 l_like        VARCHAR2(256 CHAR);
104  	 l_test_count  INTEGER;
105  	 CURSOR cur_columns( cp_schema IN VARCHAR2
106  			   , cp_table  IN VARCHAR2
107  			   , cp_like   IN VARCHAR2
108  			   , cp_excl   IN NUMBER
109  			   )
110  	 IS
111  	   SELECT table_name
112  		, column_name
113  		, owner
114  		, data_type
115  		, data_precision
116  		, data_length
117  		, data_scale
118  		, nullable
119  		, data_default_vc
120  	     FROM dba_tab_columns
121  	    WHERE owner 	 = cp_schema
122  	      AND table_name	 = cp_table
123  	      AND column_name LIKE cp_like
124  	      AND NOT otap_string.is_sys_object(column_name, cp_excl)
125  	    ORDER BY column_id
126  	 ;
127    BEGIN
128  	 IF p_table IS NOT NULL
129  	 THEN
130  	   l_table	:= otap_string.reduce(p_table, 128);
131  	   l_like	:= NVL(p_like_column, '%');
132  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
133  	   l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
134  	   IF NVL(p_show_header, 1) = 1
135  	   THEN
136  	     l_statement := '-- otap GENERATE column test scripts for table ' || l_schema || '.' || l_table || ' scope: ' || l_like;
137  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
138  	     -- get test count
139  	     SELECT COUNT(*)
140  	       INTO l_test_count
141  	       FROM dba_tab_columns
142  	      WHERE owner	   = l_schema
143  		AND table_name	   = l_table
144  		AND column_name LIKE l_like
145  		AND NOT otap_string.is_sys_object(column_name, p_excl_sysgen)
146  	     ;
147  	     -- build init
148  	     l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
149  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
150  	   END IF;
151  	   l_statement := '-- loop through columns with names like ' || l_like;
152  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
153  	   FOR rec IN cur_columns(l_schema, l_table, l_like, p_excl_sysgen)
154  	   LOOP
155  	     l_statement := 'SELECT otap_test.has_column( p_table_name => ''' || rec.table_name || '''';
156  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
157  	     l_statement := '				, p_column_name => ''' || rec.column_name || '''';
158  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
159  	     l_statement := '				, p_schema => ''' || rec.owner || '''';
160  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
161  	     l_statement := '				, p_data_type => ''' || rec.data_type || '''';
162  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
163  	     l_statement := '				, p_data_length => ' || TRIM(TO_CHAR(rec.data_length));
164  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
165  	     IF rec.data_precision IS NOT NULL
166  	     THEN
167  	       l_statement := ' 			  , p_data_precision => ' || TRIM(TO_CHAR(rec.data_precision));
168  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
169  	     END IF;
170  	     IF rec.data_scale IS NOT NULL
171  	     THEN
172  	       l_statement := ' 			  , p_data_scale => ' || TRIM(TO_CHAR(rec.data_scale));
173  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
174  	     END IF;
175  	     l_statement := '				, p_nullable => ''' || rec.nullable || '''';
176  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
177  	     IF     rec.data_default_vc IS NOT NULL
178  		AND NOT otap_string.is_sys_object(rec.data_default_vc, p_excl_sysgen)
179  	     THEN
180  	       IF INSTR(rec.data_default_vc, '''') > 0
181  	       THEN
182  		 l_statement := '			    , p_data_default => q''[' || TRIM(rec.data_default_vc) || ']''';
183  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
184  	       ELSE
185  		 l_statement := '			    , p_data_default => ''' || TRIM(rec.data_default_vc) || '''';
186  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
187  	       END IF;
188  	     END IF;
189  	     l_statement := '				) FROM dual;';
190  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
191  	   END LOOP;
192  	   IF NVL(p_show_header, 1) = 1
193  	   THEN
194  	     -- build finish
195  	     l_statement := '-- finish column tests for ' || l_table;
196  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
197  	     l_statement := '-- finish test session';
198  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
199  	     l_statement := 'SELECT otap_test.finish_test FROM dual;';
200  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
201  	     l_statement := 'SELECT * FROM otap_latest_test_results_v;';
202  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
203  	     -- add AI and copyright
204  	     l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
205  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
206  	     l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
207  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
208  	     l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
209  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
210  	   ELSE
211  	     l_statement := '-- finish column tests for ' || l_table;
212  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
213  	   END IF;
214  	 END IF;
215  	 RETURN;
216    EXCEPTION
217  	 WHEN NO_DATA_NEEDED THEN
218  	   RAISE;
219    END column_tests;
220  
221    FUNCTION table_tests( p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
222  			   , p_like_table    IN VARCHAR2 DEFAULT '%'
223  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
224  			   , p_show_header   IN INTEGER  DEFAULT 1
225  			   , p_excl_sysgen   IN INTEGER  DEFAULT 1
226  			   )
227  	 RETURN otap_view_result_tbl PIPELINED
228    IS
229  	 l_statement   VARCHAR2(4000 CHAR);
230  	 l_schema      VARCHAR2(128 CHAR);
231  	 l_base_title  VARCHAR2(256 CHAR);
232  	 l_like        VARCHAR2(256 CHAR);
233  	 l_test_count  INTEGER;
234  	 CURSOR cur_tables( cp_schema IN VARCHAR2
235  			  , cp_like   IN VARCHAR2
236  			  , cp_excl   IN NUMBER
237  			  )
238  	 IS
239  	   SELECT object_name AS table_name
240  	     FROM dba_objects
241  	    WHERE owner 	 = cp_schema
242  	      AND object_type	 = 'TABLE'
243  	      AND object_name LIKE cp_like
244  	      AND NOT otap_string.is_sys_object(object_name, cp_excl)
245  	 ;
246  	 CURSOR cur_columns( cp_schema IN VARCHAR2
247  			   , cp_table  IN VARCHAR2
248  			   , cp_like   IN VARCHAR2
249  			   , cp_prefix IN VARCHAR2
250  			   , cp_excl   IN NUMBER
251  			   )
252  	 IS
253  	   SELECT result_text
254  	     FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
255  	 ;
256    BEGIN
257  	 l_like       := NVL(p_like_table, '%');
258  	 l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
259  	 l_base_title := CASE WHEN p_title_prefix IS NULL THEN l_schema ELSE otap_string.reduce(p_title_prefix, 10) || ' - ' || l_schema END;
260  	 IF NVL(p_show_header, 1) = 1
261  	 THEN
262  	   l_statement := '-- otap GENERATE table test scripts for schema ' || l_schema || ' scope: ' || l_like;
263  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
264  	   -- get test count, simulate conditions of called test generators
265  	      WITH base AS
266  		  (SELECT object_name
267  			, object_type
268  			, owner
269  		     FROM dba_objects
270  		    WHERE owner = l_schema
271  			  -- currently supported objects
272  		      AND object_type	 = 'TABLE'
273  			  -- user like condition
274  		      AND object_name LIKE l_like
275  			  -- user exclude condition
276  		      AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
277  		  )
278  		  -- counter objects
279  		, cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
280  		, cols AS
281  		  (SELECT dbc.owner
282  			, dbc.table_name
283  			, dbc.column_name
284  		     FROM dba_tab_columns dbc
285  		    INNER JOIN base
286  		       ON dbc.owner	 = base.owner
287  		      AND dbc.table_name = base.object_name
288  			  -- user like condition
289  		    WHERE dbc.column_name LIKE l_like
290  			  -- user exclude condition
291  		      AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
292  		  )
293  		, cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
294  		, cnt AS
295  		  (SELECT expected_count, 'BASE' AS info FROM cnt_base
296  		    UNION ALL
297  		   SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
298  		  )
299  	   SELECT SUM(expected_count) INTO l_test_count FROM cnt;
300  	   -- build init
301  	   l_statement := 'SELECT otap_test.init_test(' || TRIM(TO_CHAR(l_test_count)) || ') FROM dual;';
302  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
303  	 END IF;
304  	 -- build group row
305  	 l_statement := '-- set test group for tables';
306  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
307  	 l_statement := 'SELECT otap_test.set_test_group(''' || l_base_title || ' tables'') FROM dual;';
308  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
309  	 l_statement := '-- loop through tables with names like ' || l_like;
310  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
311  	 FOR rec IN cur_tables(l_schema, l_like, p_excl_sysgen)
312  	 LOOP
313  	   l_statement := '-- set test name for table';
314  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
315  	   l_statement := 'SELECT otap_test.set_test_name(''' || l_base_title || ' table ' || rec.table_name || ''') FROM dual;';
316  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
317  	   l_statement := 'SELECT otap_test.has_table( p_table_name => ''' || rec.table_name || '''';
318  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
319  	   l_statement := '			     , p_schema => ''' || l_schema || '''';
320  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
321  	   l_statement := '			     ) FROM dual;';
322  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
323  	   FOR colrec IN cur_columns(l_schema, rec.table_name, l_like, p_title_prefix, p_excl_sysgen)
324  	   LOOP
325  	     PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
326  	   END LOOP;
327  	 END LOOP;
328  	 IF NVL(p_show_header, 1) = 1
329  	 THEN
330  	   -- build finish
331  	   l_statement := '-- finish table tests for ' || l_like;
332  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
333  	   l_statement := '-- finish test session';
334  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
335  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
336  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
337  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
338  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
339  	   -- add AI and copyright
340  	   l_statement := '-- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt';
341  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
342  	   l_statement := '-- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1';
343  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
344  	   l_statement := '-- Not allowed to be used as AI training material without explicite permission.';
345  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
346  	 ELSE
347  	   l_statement := '-- finish table tests for ' || l_like;
348  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
349  	 END IF;
350  	 RETURN;
351    EXCEPTION
352  	 WHEN NO_DATA_NEEDED THEN
353  	   RAISE;
354    END table_tests;
