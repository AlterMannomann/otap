444    FUNCTION otap_session_get_report_id(p_otap_session IN OTAP_SESSION)
445  	 RETURN NUMBER
446    IS
447  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_get_report_id';
448  	 l_view_id NUMBER;
449    BEGIN
450  	 otap_objects.otap_session_verify(p_otap_session);
451  	 l_view_id := CASE WHEN p_otap_session.session_view_id != 0 THEN p_otap_session.session_view_id ELSE p_otap_session.session_id END;
452  	 RETURN l_view_id;
453    EXCEPTION
454  	 WHEN OTHERS THEN
455  	   IF SQLCODE != -20099
456  	   THEN
457  	     -- log unhandled exceptions
458  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
459  	   END IF;
460  	   RAISE;
461    END otap_session_get_report_id;
462  
463    PROCEDURE otap_session_add_test( p_test_passed  IN NUMBER
464  				      , o_otap_session IN OUT NOCOPY OTAP_SESSION
465  				      )
466    IS
467  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_add_test';
468    BEGIN
469  	 otap_objects.otap_session_verify(o_otap_session);
470  	 o_otap_session.test_count := o_otap_session.test_count + 1;
471  	 IF p_test_passed != otap_constants.OTAP_NUM_TEST_PASSED
472  	 THEN
473  	   o_otap_session.error_count := o_otap_session.error_count + 1;
474  	 END IF;
475    EXCEPTION
476  	 WHEN OTHERS THEN
477  	   IF SQLCODE != -20099
478  	   THEN
479  	     -- log unhandled exceptions
480  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
481  	   END IF;
482  	   RAISE;
483    END otap_session_add_test;
484  
485    FUNCTION otap_session_summary(p_otap_session IN OTAP_SESSION)
486  	 RETURN VARCHAR2
487    IS
488  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_summary';
489  	 l_message VARCHAR2(4000 CHAR);
490    BEGIN
491  	 otap_objects.otap_session_verify(p_otap_session);
492  	 l_message := otap_string.reduce( 'Summary id: ' || TRIM(TO_CHAR(p_otap_session.session_id)) ||
493  					  ' tests: ' || TRIM(TO_CHAR(p_otap_session.test_count)) ||
494  					  CASE WHEN p_otap_session.intended_count > 0 THEN ' from ' || TRIM(TO_CHAR(p_otap_session.intended_count)) END ||
495  					  ' errors: ' || TRIM(TO_CHAR(p_otap_session.error_count)) ||
496  					  ' run time: ' || TRIM(TO_CHAR(((SYSDATE - p_otap_session.session_start) DAY TO SECOND))) ||
497  					  ' started: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
498  					, 4000
499  					)
500  	 ;
501  	 RETURN l_message;
502    EXCEPTION
503  	 WHEN OTHERS THEN
504  	   IF SQLCODE != -20099
505  	   THEN
506  	     -- log unhandled exceptions
507  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
508  	   END IF;
509  	   RAISE;
510    END otap_session_summary;
511  
512    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
513  	 RETURN VARCHAR2
514    IS
515  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_finish';
516  	 l_message VARCHAR2(4000 CHAR);
517    BEGIN
518  	 -- object gets verified by summary for old session
519  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_INTERNAL_LF;
520  	 -- reset values
521  	 o_otap_session.test_count     := 0;
522  	 o_otap_session.error_count    := 0;
523  	 o_otap_session.intended_count := 0;
524  	 o_otap_session.test_set       := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET;
525  	 o_otap_session.test_group     := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP;
526  	 o_otap_session.test_name      := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME;
527  	 o_otap_session.session_start  := SYSDATE;
528  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
529  	 -- do not update the session_view_id so it will keep the old or any set value
530  	 -- every init will set the session_view_id to the current session id
531  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
532  	 RETURN l_message;
533    EXCEPTION
534  	 WHEN OTHERS THEN
535  	   IF SQLCODE != -20099
536  	   THEN
537  	     -- log unhandled exceptions
538  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
539  	   END IF;
540  	   RAISE;
541    END otap_session_finish;
542  
543  END;
544  /

