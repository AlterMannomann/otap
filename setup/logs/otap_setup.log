252  	 l_test_passed	 INTEGER;
253  	 l_result	 INTEGER;
254  	 l_expected	 INTEGER;
255    BEGIN
256  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
257  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
258  	 IF p_want IS NOT NULL
259  	 THEN
260  	   IF p_have IS NOT NULL
261  	   THEN
262  	     l_result := CASE WHEN p_have = p_want THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
263  	   ELSE
264  	     l_result := otap_constants.OTAP_NUM_TEST_FAILED;
265  	   END IF;
266  	 ELSE
267  	   -- compare against NULL, p_want already checked
268  	   l_result := CASE WHEN p_have IS NULL THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
269  	 END IF;
270  	 l_test_passed := CASE WHEN l_expected = l_result THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
271  	 -- we expect currently no usage error only raise
272  	 o_errors      := NULL;
273  	 RETURN l_test_passed;
274    EXCEPTION
275  	 WHEN OTHERS THEN
276  	   IF SQLCODE != -20099
277  	   THEN
278  	     -- log unhandled exceptions
279  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' date call');
280  	   END IF;
281  	   RAISE;
282    END is_eq; -- DATE
