  4    PROCEDURE otap_session_verify(p_otap_session IN OTAP_SESSION)
  5    IS
  6  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_verify';
  7  	 l_statement VARCHAR2(32767 CHAR);
  8  	 l_message   VARCHAR2(32767 CHAR);
  9  	 l_delimiter VARCHAR2(1 CHAR);
 10    BEGIN
 11  	 -- we expect all fields to be NOT NULL including empty strings
 12  	 IF    p_otap_session				  IS NULL
 13  	    OR p_otap_session.test_executor		  IS NULL
 14  	    OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
 15  	    OR p_otap_session.test_set			  IS NULL
 16  	    OR LENGTH(TRIM(p_otap_session.test_set))	   = 0
 17  	    OR p_otap_session.test_group		  IS NULL
 18  	    OR LENGTH(TRIM(p_otap_session.test_group))	   = 0
 19  	    OR p_otap_session.test_name 		  IS NULL
 20  	    OR LENGTH(TRIM(p_otap_session.test_name))	   = 0
 21  	    OR p_otap_session.db_user			  IS NULL
 22  	    OR LENGTH(TRIM(p_otap_session.db_user))	   = 0
 23  	    OR p_otap_session.db_schema 		  IS NULL
 24  	    OR LENGTH(TRIM(p_otap_session.db_schema))	   = 0
 25  	    OR p_otap_session.test_prefix		  IS NULL
 26  	    OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
 27  	    OR p_otap_session.test_count		  IS NULL
 28  	    OR p_otap_session.intended_count		  IS NULL
 29  	    OR p_otap_session.persist_test		  IS NULL
 30  	    OR p_otap_session.name_precedence		  IS NULL
 31  	    OR p_otap_session.include_packages		  IS NULL
 32  	    OR p_otap_session.session_start		  IS NULL
 33  	    OR p_otap_session.session_id		  IS NULL
 34  	    OR p_otap_session.error_count		  IS NULL
 35  	    OR p_otap_session.session_view_id		  IS NULL
 36  	 THEN
 37  	   l_delimiter := '';
 38  	   l_statement := q'[p_otap_session				IS NULL
 39  OR p_otap_session.test_executor		   IS NULL
 40  OR LENGTH(TRIM(p_otap_session.test_executor))  = 0
 41  OR p_otap_session.test_set 		   IS NULL
 42  OR LENGTH(TRIM(p_otap_session.test_set))	    = 0
 43  OR p_otap_session.test_group		   IS NULL
 44  OR LENGTH(TRIM(p_otap_session.test_group))     = 0
 45  OR p_otap_session.test_name		   IS NULL
 46  OR LENGTH(TRIM(p_otap_session.test_name))	    = 0
 47  OR p_otap_session.db_user			   IS NULL
 48  OR LENGTH(TRIM(p_otap_session.db_user))	    = 0
 49  OR p_otap_session.db_schema		   IS NULL
 50  OR LENGTH(TRIM(p_otap_session.db_schema))	    = 0
 51  OR p_otap_session.test_prefix		   IS NULL
 52  OR LENGTH(TRIM(p_otap_session.test_prefix))    = 0
 53  OR p_otap_session.test_count		   IS NULL
 54  OR p_otap_session.intended_count		   IS NULL
 55  OR p_otap_session.persist_test		   IS NULL
 56  OR p_otap_session.name_precedence		   IS NULL
 57  OR p_otap_session.include_packages 	   IS NULL
 58  OR p_otap_session.session_start		   IS NULL
 59  OR p_otap_session.session_id		   IS NULL
 60  OR p_otap_session.error_count		   IS NULL
 61  OR p_otap_session.session_view_id		   IS NULL]'
 62  	   ;
 63  	   -- if we fail, find out the columns that are NULL
 64  	   l_message := 'ERROR otap_objects.otap_session_verify. Invalid OTAP_SESSION object. NULL errors: ';
 65  	   IF p_otap_session IS NULL
 66  	   THEN
 67  	     l_message := l_message || 'Complete OTAP_SESSION object NULL';
 68  	   ELSE
 69  	     -- check the fields
 70  	     IF p_otap_session.test_executor IS NULL OR LENGTH(TRIM(p_otap_session.test_executor)) = 0
 71  	     THEN
 72  	       l_message := l_message || l_delimiter || 'test_executor';
 73  	       l_delimiter := ',';
 74  	     END IF;
 75  	     IF p_otap_session.test_set IS NULL OR LENGTH(TRIM(p_otap_session.test_set)) = 0
 76  	     THEN
 77  	       l_message := l_message || l_delimiter || 'test_set';
 78  	       l_delimiter := ',';
 79  	     END IF;
 80  	     IF p_otap_session.test_group IS NULL OR LENGTH(TRIM(p_otap_session.test_group)) = 0
 81  	     THEN
 82  	       l_message := l_message || l_delimiter || 'test_group';
 83  	       l_delimiter := ',';
 84  	     END IF;
 85  	     IF p_otap_session.test_name IS NULL OR LENGTH(TRIM(p_otap_session.test_name)) = 0
 86  	     THEN
 87  	       l_message := l_message || l_delimiter || 'test_name';
 88  	       l_delimiter := ',';
 89  	     END IF;
 90  	     IF p_otap_session.db_user IS NULL OR LENGTH(TRIM(p_otap_session.db_user)) = 0
 91  	     THEN
 92  	       l_message := l_message || l_delimiter || 'db_user';
 93  	       l_delimiter := ',';
 94  	     END IF;
 95  	     IF p_otap_session.db_schema IS NULL OR LENGTH(TRIM(p_otap_session.db_schema)) = 0
 96  	     THEN
 97  	       l_message := l_message || l_delimiter || 'db_schema';
 98  	       l_delimiter := ',';
 99  	     END IF;
100  	     IF p_otap_session.test_prefix IS NULL OR LENGTH(TRIM(p_otap_session.test_prefix)) = 0
101  	     THEN
102  	       l_message := l_message || l_delimiter || 'test_prefix';
103  	       l_delimiter := ',';
104  	     END IF;
105  	     IF p_otap_session.test_count IS NULL
106  	     THEN
107  	       l_message := l_message || l_delimiter || 'test_count';
108  	       l_delimiter := ',';
109  	     END IF;
110  	     IF p_otap_session.intended_count IS NULL
111  	     THEN
112  	       l_message := l_message || l_delimiter || 'intended_count';
113  	       l_delimiter := ',';
114  	     END IF;
115  	     IF p_otap_session.persist_test IS NULL
116  	     THEN
117  	       l_message := l_message || l_delimiter || 'persist_test';
118  	       l_delimiter := ',';
119  	     END IF;
120  	     IF p_otap_session.name_precedence IS NULL
121  	     THEN
122  	       l_message := l_message || l_delimiter || 'name_precedence';
123  	       l_delimiter := ',';
124  	     END IF;
125  	     IF p_otap_session.include_packages IS NULL
126  	     THEN
127  	       l_message := l_message || l_delimiter || 'include_packages';
128  	       l_delimiter := ',';
129  	     END IF;
130  	     IF p_otap_session.session_start IS NULL
131  	     THEN
132  	       l_message := l_message || l_delimiter || 'session_start';
133  	       l_delimiter := ',';
134  	     END IF;
135  	     IF p_otap_session.session_id IS NULL
136  	     THEN
137  	       l_message := l_message || l_delimiter || 'session_id';
138  	       l_delimiter := ',';
139  	     END IF;
140  	     IF p_otap_session.error_count IS NULL
141  	     THEN
142  	       l_message := l_message || l_delimiter || 'error_count';
143  	       l_delimiter := ',';
144  	     END IF;
145  	     IF p_otap_session.session_view_id IS NULL
146  	     THEN
147  	       l_message := l_message || l_delimiter || 'session_view_id';
148  	       l_delimiter := ',';
149  	     END IF;
150  	   END IF;
151  	   otap_log.log('EXCEPTION -20099 ' || l_message, 'otap_objects.otap_session_verify', l_statement);
152  	   RAISE_APPLICATION_ERROR(-20099, l_message);
153  	 END IF;
154    EXCEPTION
155  	 WHEN OTHERS THEN
156  	   IF SQLCODE != -20099
157  	   THEN
158  	     -- log unhandled exceptions
159  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
160  	   END IF;
161  	   RAISE;
162    END otap_session_verify;
