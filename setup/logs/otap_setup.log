125  			       , otap_util.CFG_FORMAT_GROUP_CHAR
126  			       , otap_util.CFG_FORMAT_HEADER_CHAR
127  			       , otap_util.CFG_FORMAT_NAME_CHAR
128  			       , otap_util.CFG_FORMAT_SET_CHAR
129  			       , otap_util.CFG_PRESERVE_DAYS
130  			       , otap_util.CFG_TEMPLATE_COUNT_DESC
