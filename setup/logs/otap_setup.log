SQL> CREATE OR REPLACE PACKAGE BODY otap_test
  2  AS
  3    -- for description see header file
  4    --========= package session variables =========--
  5    -- define private package sesstion variables and set defaults
  6    session_record OTAP_SESSION := otap_session( SYS_CONTEXT('USERENV', 'SESSION_USER')
  7  						  , otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET
  8  						  , otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP
  9  						  , otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME
 10  						  , SYS_CONTEXT('USERENV', 'CURRENT_USER')
 11  						  , SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
 12  						  , otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX
 13  						  , 0
 14  						  , 0
 15  						  , FALSE
 16  						  , TRUE
 17  						  , FALSE
 18  						  , SYSDATE
 19  						  , 0
 20  						  , 0
 21  						  , 0
 22  						  )
