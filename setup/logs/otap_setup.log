803  	 -- execute the wrapped function in an extra block
804  	 BEGIN
805  	   l_message := otap_report.get_test_count_header(p_min_fill, p_language_id);
806  	 EXCEPTION
807  	   WHEN OTHERS THEN
808  	     -- consume error
809  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_test_count_header');
810  	     l_message := otap_string.reduce('Internal otap error get test count header: ' || SQLERRM, 4000);
811  	 END;
812  	 -- return or let exception happen
813  	 RETURN l_message;
814    END get_test_count_header;
