SQL> -- trigger
SQL> CREATE OR REPLACE TRIGGER otap_config_ins_trg
  2    BEFORE INSERT ON otap_config
  3    FOR EACH ROW
  4  DECLARE
  5    l_ok		   BOOLEAN;
  6  BEGIN
  7    -- only allow defined configuration names
  8    IF :NEW.config_name NOT IN ( 'PRESERVE_DAYS'
  9  				  , 'DELETE_DELAY'
 10  				  , 'DELETE_BATCH_SIZE'
 11  				  , 'DEBUG_MODE'
 12  				  )
 13    THEN
 14  	 RAISE_APPLICATION_ERROR(-20001, 'The configuration name ' || :NEW.config_name || ' is not supported.');
 15    END IF;
 16    -- remove any leading and trailing blanks from config_value
 17    :NEW.config_value   := TRIM(:NEW.config_value);
 18    :NEW.created	   := SYSDATE;
 19    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
 20    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
 21    -- check max length if defined
 22    IF :NEW.config_type = 'CHAR'
 23    THEN
 24  	 IF :NEW.config_max_length > 0
 25  	 THEN
 26  	   IF LENGTH(:NEW.config_value) > :NEW.config_max_length
 27  	   THEN
 28  	     RAISE_APPLICATION_ERROR(-20002, 'The config_value exceeds the defined config_max_length. Current length: ' || LENGTH(:NEW.config_value));
 29  	   END IF;
 30  	 END IF;
 31    END IF;
 32    -- check number type
 33    IF :NEW.config_type = 'NUMBER'
 34    THEN
 35  	 l_ok := TRUE;
 36  	 -- compare TO_NUMBER with implicite conversion, if it fails the config_value cannot be interpreted correctly
 37  	 BEGIN
 38  	   l_ok := (TO_NUMBER(:NEW.config_value) = :NEW.config_value);
 39  	 EXCEPTION
 40  	   WHEN OTHERS THEN
 41  	     l_ok := FALSE;
 42  	 END;
 43  	 IF NOT l_ok
 44  	 THEN
 45  	   RAISE_APPLICATION_ERROR(-20003, 'The given config_value "' || NVL(:NEW.config_value, 'NULL') || '" could not be converted successfully to a number.');
 46  	 END IF;
 47    END IF;
 48    -- handle NULLs
 49    IF :NEW.config_name = 'PRESERVE_DAYS'
 50    THEN
 51  	 :NEW.config_value := NVL(:NEW.config_value, '1');
 52    END IF;
 53    IF :NEW.config_name = 'DELETE_DELAY'
 54    THEN
 55  	 :NEW.config_value := NVL(:NEW.config_value, '10');
 56    END IF;
 57    IF :NEW.config_name = 'DELETE_BATCH_SIZE'
 58    THEN
 59  	 :NEW.config_value := NVL(:NEW.config_value, '1000');
 60    END IF;
 61    IF :NEW.config_name = 'DEBUG_MODE'
 62    THEN
 63  	 :NEW.config_value := NVL(:NEW.config_value, '0');
 64    END IF;
 65  END;
 66  /

