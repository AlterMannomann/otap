793    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
794    * @param p_schema A schema override of the current test session if needed, taken as is. Compares are not clearly associated to a schema. Case sensitive.
795    *
796    * @return The test result as text.
797    */
798    FUNCTION alike( p_have		 IN VARCHAR2
799  		     , p_like		 IN VARCHAR2
800  		     , p_case_sensitive  IN NUMBER   DEFAULT otap_constants.OTAP_NUM_FALSE
801  		     , p_description	 IN VARCHAR2 DEFAULT NULL
802  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
803  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
804  		     )
805  	 RETURN VARCHAR2
