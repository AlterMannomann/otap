388    FUNCTION has_trigger( p_trigger_name    IN	     VARCHAR2
389  			   , o_errors		  OUT NOCOPY VARCHAR2
390  			   , p_schema	       IN	     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
391  			   , p_trigger_type    IN	     VARCHAR2 DEFAULT NULL
392  			   , p_trigger_event   IN	     VARCHAR2 DEFAULT NULL
393  			   , p_table_owner     IN	     VARCHAR2 DEFAULT NULL
394  			   , p_table_name      IN	     VARCHAR2 DEFAULT NULL
395  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
396  			   )
397  	 RETURN INTEGER
398    IS
399  	 l_script	  VARCHAR2(1024 CHAR)	 := 'otap_schema.has_trigger';
400  	 l_test_passed	  INTEGER;
401  	 l_expected	  INTEGER;
402  	 l_has_trigger	  INTEGER;
403  	 l_trigger_name   VARCHAR2(128 CHAR);
404  	 l_trigger_type   VARCHAR2(16 CHAR);
405  	 l_trigger_event  VARCHAR2(246 CHAR);
406  	 l_table_owner	  VARCHAR2(128 CHAR);
407  	 l_table_name	  VARCHAR2(128 CHAR);
408  	 l_schema_to_use  VARCHAR2(128 CHAR);
409  	 l_errors	  VARCHAR2(32767 CHAR);
410    BEGIN
411  	 l_errors	   := NULL;
412  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
413  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
414  	 l_trigger_name    := otap_string.reduce(p_trigger_name, 128);
415  	 l_trigger_type    := otap_string.reduce(UPPER(p_trigger_type), 16);
416  	 l_trigger_event   := otap_string.reduce(UPPER(p_trigger_event), 246);
417  	 l_table_owner	   := otap_string.reduce(p_table_owner, 128);
418  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
419  	 IF	l_trigger_name	      IS NOT NULL
420  	    AND LENGTH(l_trigger_name) > 0
421  	 THEN
422  	   -- schema
423  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
424  	   -- check
425  	   SELECT COUNT(*)
426  	     INTO l_has_trigger
427  	     FROM dba_triggers
428  	    WHERE owner 		 = l_schema_to_use
429  	      AND trigger_name		 = l_trigger_name
430  	      AND trigger_type		 = NVL(l_trigger_type, trigger_type)
431  	      AND triggering_event	 = NVL(l_trigger_event, triggering_event)
432  	      AND table_owner		 = NVL(l_table_owner, table_owner)
433  	      AND NVL(table_name, 'n/a') = NVL(l_table_name, NVL(table_name, 'n/a'))
434  	   ;
435  	   -- we should find one or zero entries
436  	   l_test_passed := count_chk(l_has_trigger, l_errors, l_script);
437  	 ELSE
438  	   -- invalid package name, type or state
439  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
440  	   l_errors	       := 'Not allowed: p_trigger_name(NULL)';
441  	   otap_log.log(l_errors, l_script, 'Trigger name NULL');
442  	 END IF;
443  	 -- now decide on the expected result the final state and if errors are returned
444  	 IF l_test_passed != l_expected
445  	 THEN
446  	   o_errors := otap_string.reduce(l_errors, 4000);
447  	 ELSE
448  	   -- overwrite states from before, as we fulfill expected
449  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
450  	   -- overwrite errors expected
451  	   o_errors := NULL;
452  	 END IF;
453  	 RETURN l_test_passed;
454    EXCEPTION
455  	 WHEN OTHERS THEN
456  	   IF SQLCODE != -20099
457  	   THEN
458  	     -- log unhandled exceptions
459  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
460  	   END IF;
461  	   RAISE;
462    END has_trigger;
