SQL> CREATE OR REPLACE PACKAGE BODY otap_config_util
  2  AS
  3    -- for description see header file
  4  
  5    FUNCTION get_config_value(p_config_name IN VARCHAR2)
  6  	 RETURN VARCHAR2
  7    IS
  8  	 l_return otap_config.config_value%TYPE;
  9    BEGIN
 10  	 SELECT config_value
 11  	   INTO l_return
 12  	   FROM otap_config
 13  	  WHERE config_name = UPPER(p_config_name)
 14  	 ;
 15  	 RETURN l_return;
 16    EXCEPTION
 17  	 WHEN OTHERS THEN
 18  	   otap_log.log(SQLERRM, 'otap_config_util.get_config_value', 'SELECT config_value INTO l_return FROM otap_config WHERE config_name = UPPER(p_config_name)');
 19  	   RAISE;
 20    END get_config_value;
 21  
 22    PROCEDURE set_config_value( p_config_name  IN VARCHAR2
 23  				 , p_config_value IN VARCHAR2
 24  				 )
 25    IS
 26  	 PRAGMA AUTONOMOUS_TRANSACTION;
 27    BEGIN
 28  	 UPDATE otap_config
 29  	    SET config_value = p_config_value
 30  	  WHERE config_name = UPPER(p_config_name)
 31  	 ;
 32  	 COMMIT;
 33    EXCEPTION
 34  	 WHEN OTHERS THEN
 35  	   otap_log.log(SQLERRM, 'otap_config_util.set_config_value', 'UPDATE otap_config SET config_value = p_config_value WHERE config_name = UPPER(p_config_name)');
 36  	   RAISE;
 37    END set_config_value;
 38  
 39    FUNCTION get_debug
 40  	 RETURN NUMBER
 41    IS
 42    BEGIN
 43  	 RETURN TO_NUMBER(get_config_value(otap_constants.OTAP_CFG_DEBUG_MODE));
 44    END get_debug;
 45  
 46    PROCEDURE set_debug(p_active IN NUMBER DEFAULT otap_constants.OTAP_NUM_FALSE)
 47    IS
 48  	 l_debug_mode otap_config.config_value%TYPE;
 49    BEGIN
 50  	 l_debug_mode := CASE
 51  			   WHEN p_active = otap_constants.OTAP_NUM_TRUE
 52  			   THEN TRIM(TO_CHAR(otap_constants.OTAP_NUM_TRUE))
 53  			   ELSE TRIM(TO_CHAR(otap_constants.OTAP_NUM_FALSE))
 54  			 END
 55  	 ;
 56  	 set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, l_debug_mode);
 57    END set_debug;
 58  
 59    FUNCTION preserve_days
 60  	 RETURN NUMBER
 61    IS
 62    BEGIN
 63  	 RETURN TO_NUMBER(get_config_value(otap_constants.OTAP_CFG_PRESERVE_DAYS));
 64    END preserve_days;
 65  
 66    PROCEDURE set_preserve_days(p_preserve_days IN NUMBER DEFAULT otap_constants.OTAP_PRESERVE_DAYS)
 67    IS
 68  	 l_preserve otap_config.config_value%TYPE;
 69    BEGIN
 70  	 l_preserve := CASE
 71  			 WHEN p_preserve_days BETWEEN otap_constants.OTAP_PRESERVE_DAYS_MIN
 72  						  AND otap_constants.OTAP_PRESERVE_DAYS_MAX
 73  			 THEN TRIM(TO_CHAR(p_preserve_days))
 74  			 ELSE TRIM(TO_CHAR(otap_constants.OTAP_PRESERVE_DAYS))
 75  		       END
 76  	 ;
 77  	 set_config_value(otap_constants.OTAP_CFG_PRESERVE_DAYS, l_preserve);
 78    END set_preserve_days;
