368    FUNCTION max_text_size( p_session_id  IN NUMBER
369  			     , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
370  			     )
371  	 RETURN NUMBER
372    IS
373  	 l_script    VARCHAR2(1024 CHAR) := 'otap_api.otap_session_get_test_id';
374  	 l_return    NUMBER;
375  	 l_interval  NUMBER;
376    BEGIN
377  	 l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
378  	 -- execute the wrapped function in an extra block
379  	 BEGIN
380  	   l_return := otap_util.max_text_size(p_session_id);
381  	   -- now add the extra columns on the result line
382  	   SELECT LENGTH(((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval FROM dual;
383  	   l_return := l_return + l_interval + (2 * otap_util.get_length_test_state(p_language_id)) + 3;
384  	 EXCEPTION
385  	   WHEN OTHERS THEN
386  	     -- consume error
387  	     otap_log.log(SQLERRM, l_script, 'Calling otap_util.max_text_size');
388  	     l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
389  	 END;
390  	 -- return or let exception happen
391  	 RETURN l_return;
392    END max_text_size;
