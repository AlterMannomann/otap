487    FUNCTION test_result_to_text(p_test_passed IN NUMBER)
488  	 RETURN VARCHAR
489    IS
490  	 l_translation otap_config.config_value%TYPE;
491    BEGIN
492  	 l_translation := CASE p_test_passed
493  			    WHEN otap_constants.OTAP_NUM_TEST_PASSED
494  			    THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_PASSED)
495  			    WHEN otap_constants.OTAP_NUM_TEST_FAILED
496  			    THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_FAILED)
497  			    WHEN otap_constants.OTAP_NUM_TEST_UNDEFINED
498  			    THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_UNDEFINED)
499  			    ELSE otap_constants.OTAP_INTERNAL_ERROR
500  			  END
501  	 ;
502  	 RETURN l_translation;
503    EXCEPTION
504  	 WHEN OTHERS THEN
505  	   otap_log.log(SQLERRM, 'otap_util.test_result_to_text', 'Translate test state to text');
506  	   RAISE;
507    END test_result_to_text;
