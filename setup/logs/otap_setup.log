SQL> CREATE OR REPLACE PACKAGE BODY otap_generate
  2  AS
  3    -- package constants and variables
  4    GEN_TYPE_SCRIPT	   CONSTANT CHAR(1)  := 'S';
  5    GEN_TYPE_FUNCTION   CONSTANT CHAR(1)  := 'F';
  6    GEN_TYPE_PROCEDURE  CONSTANT CHAR(1)  := 'P';
  7    PREFIX_SQL	   CONSTANT CHAR(7)  := 'SELECT ';
  8    PREFIX_PLSQL	   CONSTANT CHAR(15) := '  l_message := ';
  9    POSTFIX_SQL	   CONSTANT CHAR(11) := ' FROM daul;';
 10    POSTFIX_PLSQL	   CONSTANT CHAR(1)  := ';';
 11  
 12    generation_type VARCHAR2(1) := 'S';
 13  
 14    -- for description see header file
 15    PROCEDURE set_gen_type(p_gen_type IN VARCHAR2)
 16    IS
 17    BEGIN
 18  	 IF TRIM(p_gen_type) IN (GEN_TYPE_SCRIPT, GEN_TYPE_FUNCTION, GEN_TYPE_PROCEDURE)
 19  	 THEN
 20  	   generation_type := TRIM(p_gen_type);
 21  	 END IF;
 22    END set_gen_type;
