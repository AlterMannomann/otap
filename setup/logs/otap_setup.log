141    FUNCTION check_layout(p_layout IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT)
142  	 RETURN VARCHAR2
143    IS
144  	 l_script VARCHAR2(256 CHAR) := 'otap_string.check_layout';
145  	 l_layout VARCHAR2(1 CHAR);
146    BEGIN
147  	 l_layout := CASE
148  		       WHEN p_layout IN (otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_RIGHT)
149  		       THEN p_layout
150  		       ELSE otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
151  		     END
152  	 ;
153  	 RETURN l_layout;
154    EXCEPTION
155  	 WHEN OTHERS THEN
156  	   otap_log.log(SQLERRM, l_script, 'Check layout constraints');
157  	   RAISE;
