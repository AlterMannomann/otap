SQL> -- Basic package that provides utility functions and procedures for string handling in otap.
SQL> CREATE OR REPLACE PACKAGE otap_string
  2  AS
  3    /**
  4    * Provides functions to limit and verify strings
  5    */
  6  
  7    /** FUNCTION otap_string.reduce
  8    * Basic string trimming and cutting to a given size. Trims the result.
  9    * Limited to PLSQL string size. On using defaults return a NULL string. Can be used in PLSQL to guarantee string
 10    * length for a used variable size and avoid exceptions on oversized strings. Limited to 32767 chars.
 11    *
 12    * @param p_string The string to trim and cut to the given size.
 13    * @param p_size The maximum length for the result string.
 14    *
 15    * @return The trimmed result string with the given size, probably cutted.
 16    */
 17    FUNCTION reduce( p_string VARCHAR2 DEFAULT NULL
 18  		      , p_size	 INTEGER  DEFAULT 0
 19  		      )
 20  	 RETURN VARCHAR2
 21    ;
 22  
 23    /** FUNCTION otap_string.cut
 24    * Basic string cutting to a given size. Does not trim the result.
 25    * Limited to PLSQL string size. On using defaults return a NULL string. Can be used in PLSQL to guarantee string
 26    * length for a used variable size and avoid exceptions on oversized strings. Limited to 32767 chars.
 27    *
 28    * @param p_string The string to cut to the given size.
 29    * @param p_size The maximum length for the result string.
 30    *
 31    * @return The result string with the given size, probably cutted.
 32    */
 33    FUNCTION cut( p_string VARCHAR2 DEFAULT NULL
 34  		   , p_size   INTEGER  DEFAULT 0
 35  		   )
 36  	 RETURN VARCHAR2
 37    ;
 38  
 39    /** FUNCTION otap_string.flatten
 40    * Basic string flattening and cutting to a given size. Does not trim the result.
 41    * Limited to PLSQL string size. On using defaults return a NULL string. Can be used
 42    * to remove white space chars like more than one space, tab, line feed and others and
 43    * replace them with a single space. Limited to 32767 chars.
 44    *
 45    * @param p_string The string to flatten and cut to the given size.
 46    * @param p_size The maximum length for the result string.
 47    *
 48    * @return The result string with the given size, probably cutted.
 49    */
 50    FUNCTION flatten( p_string VARCHAR2 DEFAULT NULL
 51  		       , p_size   INTEGER  DEFAULT 0
 52  		       )
 53  	 RETURN VARCHAR2
 54    ;
 55  
 56    /** FUNCTION otap_string.check_border
 57    * Constraints the border to a value between 2 and 10. Invalid border will be set to otap_constants.OTAP_FALLBACK_BORDER.
 58    *
 59    * @param p_border The minimum border length to verify.
 60    *
 61    * @return The given border or a valid border length.
