2457  	FUNCTION sched_job_tests( p_like_job	  IN VARCHAR2 DEFAULT '%'
2458  				, p_schema	  IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2459  				, p_title_prefix  IN VARCHAR2 DEFAULT NULL
2460  				, p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2461  				, p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2462  				)
2463  	  RETURN otap_view_result_tbl PIPELINED
2464  	IS
2465  	  l_statement	VARCHAR2(4000 CHAR);
2466  	  l_schema	VARCHAR2(128 CHAR);
2467  	  l_like	VARCHAR2(256 CHAR);
2468  	  l_test_count	INTEGER;
2469  	  l_pad_par	INTEGER;
2470  	  CURSOR cur_jobs( cp_schema IN VARCHAR2
2471  			 , cp_like   IN VARCHAR2
2472  			 , cp_excl   IN NUMBER
2473  			 )
2474  	  IS
2475  	    SELECT owner
2476  		 , job_name
2477  		 , job_style
2478  		 , job_type
2479  		 , job_action
2480  		 , schedule_type
2481  		 , repeat_interval
2482  		 , job_class
2483  		 , logging_level
2484  		 , store_output
2485  	      FROM dba_scheduler_jobs
2486  	     WHERE owner       = cp_schema
2487  	       AND job_name LIKE cp_like ESCAPE '\'
2488  	       AND NOT otap_string.is_sys_object(job_name, cp_excl)
2489  	  ;
2490  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2491  			   , cp_schema IN VARCHAR2
2492  			   , cp_type   IN VARCHAR2
2493  			   , cp_object IN VARCHAR2
2494  			   , cp_scope  IN VARCHAR2
2495  			   , cp_count  IN NUMBER
2496  			   , cp_show   IN NUMBER
2497  			   )
2498  	  IS
2499  	    SELECT result_text
2500  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2501  	  ;
2502  	  CURSOR cur_footer(cp_show IN NUMBER)
2503  	  IS
2504  	    SELECT result_text
2505  	      FROM TABLE(otap_generate.get_footer(cp_show))
2506  	  ;
2507  	BEGIN
2508  	  l_like       := NVL(p_like_job, '%');
2509  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
2510  	  -- get count
2511  	  SELECT COUNT(*)
2512  	    INTO l_test_count
2513  	    FROM dba_scheduler_jobs
2514  	   WHERE owner	     = l_schema
2515  	     AND job_name LIKE l_like ESCAPE '\'
2516  	     AND NOT otap_string.is_sys_object(job_name, p_excl_sysgen)
2517  	  ;
2518  	  -- get header
2519  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'scheduler jobs', NULL, l_like, l_test_count, p_show_header)
2520  	  LOOP
2521  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2522  	  END LOOP;
2523  	  l_pad_par := otap_generate.get_code_prefix_len + 27;
2524  	  -- build name row
2525  	  l_statement := otap_generate.get_code_pad || '-- set test name for scheduler jobs';
2526  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2527  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''scheduler jobs'')' || otap_generate.get_code_postfix;
2528  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2529  	  FOR rec IN cur_jobs(l_schema, l_like, p_excl_sysgen)
2530  	  LOOP
2531  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_scheduler_job( p_job_name => ''' || rec.job_name || '''';
2532  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2533  	    IF rec.job_style IS NOT NULL
2534  	    THEN
2535  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_style => ''' || rec.job_style || '''';
2536  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2537  	    END IF;
2538  	    IF rec.job_type IS NOT NULL
2539  	    THEN
2540  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_type => ''' || rec.job_type || '''';
2541  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2542  	    END IF;
2543  	    IF rec.job_action IS NOT NULL
2544  	    THEN
2545  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_action => ''' || rec.job_action || '''';
2546  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2547  	    END IF;
2548  	    IF rec.schedule_type IS NOT NULL
2549  	    THEN
2550  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schedule_type => ''' || rec.schedule_type || '''';
2551  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2552  	    END IF;
2553  	    IF rec.repeat_interval IS NOT NULL
2554  	    THEN
2555  	      -- check if we have ' in the string
2556  	      IF INSTR(rec.repeat_interval, '''') > 0
2557  	      THEN
2558  		-- q syntax
2559  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_repeat_interval => q''[' || TRIM(rec.repeat_interval) || ']''';
2560  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2561  	      ELSE
2562  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_repeat_interval => ''' || TRIM(rec.repeat_interval) || '''';
2563  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2564  	      END IF;
2565  	    END IF;
2566  	    IF rec.job_class IS NOT NULL
2567  	    THEN
2568  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_class => ''' || rec.job_class || '''';
2569  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2570  	    END IF;
2571  	    IF rec.logging_level IS NOT NULL
2572  	    THEN
2573  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_logging_level => ''' || rec.logging_level || '''';
2574  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2575  	    END IF;
2576  	    IF rec.store_output IS NOT NULL
2577  	    THEN
2578  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_store_output => ''' || rec.store_output || '''';
2579  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2580  	    END IF;
2581  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2582  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2583  	  END LOOP;
2584  	  FOR rec IN cur_footer(p_show_header)
2585  	  LOOP
2586  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2587  	  END LOOP;
2588  	  RETURN;
2589  	EXCEPTION
2590  	  WHEN NO_DATA_NEEDED THEN
2591  	    RAISE;
2592  	END sched_job_tests;
2593  
2594  	FUNCTION schema_tests( p_like_schema   IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2595  			     , p_required_user IN VARCHAR2 DEFAULT NULL
2596  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
2597  			     , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2598  			     , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2599  			     )
2600  	  RETURN otap_view_result_tbl PIPELINED
2601  	IS
2602  	  l_statement	VARCHAR2(4000 CHAR);
2603  	  l_schema	VARCHAR2(128 CHAR);
2604  	  l_like	VARCHAR2(256 CHAR);
2605  	  l_test_count	INTEGER;
2606  	  l_user_count	INTEGER;
2607  	  l_pad_par	INTEGER;
2608  	  CURSOR cur_user_cnt(cp_user_list IN VARCHAR2)
2609  	  IS
2610  	      WITH usr_list AS
2611  		   (SELECT TRIM(REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL)) AS username
2612  		      FROM dual
2613  		   CONNECT BY REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL) IS NOT NULL
2614  		   )
2615  	    SELECT COUNT(*) AS user_cnt
2616  	      FROM usr_list
2617  	     WHERE username IS NOT NULL
2618  	  ;
2619  	  CURSOR cur_schemas( cp_like IN VARCHAR2
2620  			    , cp_excl IN NUMBER
2621  			    )
2622  	  IS
2623  	    SELECT username
2624  	      FROM dba_users
2625  	     WHERE username LIKE cp_like ESCAPE '\'
2626  	       AND NOT otap_string.is_sys_object(username, cp_excl)
2627  	  ;
2628  	  CURSOR cur_related_users( cp_user_list IN VARCHAR2
2629  				  , cp_prefix	 IN VARCHAR2
2630  				  )
2631  	  IS
2632  	    SELECT result_text
2633  	      FROM TABLE(otap_generate.related_user_tests(cp_user_list, cp_prefix, 0))
2634  	  ;
2635  	  CURSOR cur_schema_user( cp_schema IN VARCHAR2
2636  				, cp_prefix IN VARCHAR2
2637  				)
2638  	  IS
2639  	    SELECT result_text
2640  	      FROM TABLE(otap_generate.schema_user_test(cp_schema, cp_prefix, 0))
2641  	  ;
2642  	  CURSOR cur_tables( cp_like   IN VARCHAR2
2643  			   , cp_schema IN VARCHAR2
2644  			   , cp_prefix IN VARCHAR2
2645  			   , cp_excl   IN NUMBER
2646  			   )
2647  	  IS
2648  	    SELECT result_text
2649  	      FROM TABLE(otap_generate.table_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2650  	  ;
2651  	  CURSOR cur_trigger( cp_like	IN VARCHAR2
2652  			    , cp_schema IN VARCHAR2
2653  			    , cp_prefix IN VARCHAR2
2654  			    , cp_excl	IN NUMBER
2655  			    )
2656  	  IS
2657  	    SELECT result_text
2658  	      FROM TABLE(otap_generate.trigger_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2659  	  ;
2660  	  CURSOR cur_packages( cp_like	 IN VARCHAR2
2661  			     , cp_schema IN VARCHAR2
2662  			     , cp_prefix IN VARCHAR2
2663  			     , cp_excl	 IN NUMBER
2664  			     )
2665  	  IS
2666  	    SELECT result_text
2667  	      FROM TABLE(otap_generate.package_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2668  	  ;
2669  	  CURSOR cur_views( cp_like   IN VARCHAR2
2670  			  , cp_schema IN VARCHAR2
2671  			  , cp_prefix IN VARCHAR2
2672  			  , cp_excl   IN NUMBER
2673  			  )
2674  	  IS
2675  	    SELECT result_text
2676  	      FROM TABLE(otap_generate.view_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2677  	  ;
2678  	  CURSOR cur_types( cp_like   IN VARCHAR2
2679  			  , cp_schema IN VARCHAR2
2680  			  , cp_prefix IN VARCHAR2
2681  			  , cp_excl   IN NUMBER
2682  			  )
2683  	  IS
2684  	    SELECT result_text
2685  	      FROM TABLE(otap_generate.type_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2686  	  ;
2687  	  CURSOR cur_sequences( cp_like   IN VARCHAR2
2688  			      , cp_schema IN VARCHAR2
2689  			      , cp_prefix IN VARCHAR2
2690  			      , cp_excl   IN NUMBER
2691  			      )
2692  	  IS
2693  	    SELECT result_text
2694  	      FROM TABLE(otap_generate.sequence_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2695  	  ;
2696  	  CURSOR cur_jobs( cp_like   IN VARCHAR2
2697  			 , cp_schema IN VARCHAR2
2698  			 , cp_prefix IN VARCHAR2
2699  			 , cp_excl   IN NUMBER
2700  			 )
2701  	  IS
2702  	    SELECT result_text
2703  	      FROM TABLE(otap_generate.sched_job_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2704  	  ;
2705  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2706  			   , cp_schema IN VARCHAR2
2707  			   , cp_type   IN VARCHAR2
2708  			   , cp_object IN VARCHAR2
2709  			   , cp_scope  IN VARCHAR2
2710  			   , cp_count  IN NUMBER
2711  			   , cp_show   IN NUMBER
2712  			   )
2713  	  IS
2714  	    SELECT result_text
2715  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2716  	  ;
2717  	  CURSOR cur_footer(cp_show IN NUMBER)
2718  	  IS
2719  	    SELECT result_text
2720  	      FROM TABLE(otap_generate.get_footer(cp_show))
2721  	  ;
2722  	  CURSOR cur_test_count( cp_excl_sysgen IN NUMBER
2723  			       , cp_like	IN VARCHAR2
2724  			       , cp_usr_cnt	IN NUMBER
2725  			       )
2726  	  IS
2727  	     WITH base AS
2728  		 (SELECT object_name
2729  		       , object_type
2730  		       , owner
2731  		    FROM dba_objects
2732  			 -- user like condition
2733  		   WHERE owner LIKE cp_like ESCAPE '\'
2734  			 -- currently supported objects
2735  		     AND (   object_type   IN ('TABLE', 'FUNCTION', 'PROCEDURE')
2736  			  OR object_type LIKE '%VIEW'
2737  			  OR object_type LIKE 'PACKAGE%'
2738  			 )
2739  			 -- user exclude condition
2740  		     AND NOT otap_string.is_sys_object(object_name, cp_excl_sysgen)
2741  		 )
2742  		 -- counter objects
2743  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
2744  		 -- depending procedures
2745  	       , prc AS
2746  		 (SELECT dbp.procedure_name
2747  		       , dbp.object_name
2748  		       , dbp.object_type
2749  		    FROM dba_procedures dbp
2750  		   INNER JOIN base
2751  		      ON dbp.object_name = base.object_name
2752  		     AND dbp.object_type = base.object_type
2753  		     AND dbp.owner	 = base.owner
2754  			 -- exclude pure functions and procedures, already counted by base
2755  		     AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
2756  			 -- user exclude condition
2757  		   WHERE NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl_sysgen)
2758  		 )
2759  	       , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
2760  	       , cols AS
2761  		 (SELECT dbc.owner
2762  		       , dbc.table_name
2763  		       , dbc.column_name
2764  		    FROM dba_tab_columns dbc
2765  		   INNER JOIN base
2766  		      ON dbc.owner	= base.owner
2767  		     AND dbc.table_name = base.object_name
2768  			 -- user exclude condition
2769  		   WHERE NOT otap_string.is_sys_object(dbc.column_name, cp_excl_sysgen)
2770  		 )
2771  	       , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
2772  		 -- table triggers
2773  	       , trgt AS
2774  		 (SELECT dbt.owner
2775  		       , dbt.trigger_name
2776  		       , dbt.table_owner
2777  		    FROM dba_triggers dbt
2778  		   INNER JOIN base
2779  		      ON dbt.table_owner      = base.owner
2780  		     AND dbt.table_name       = base.object_name
2781  		     AND dbt.base_object_type = base.object_type
2782  		   WHERE dbt.table_name     IS NOT NULL
2783  			 -- user exclude condition
2784  		     AND NOT otap_string.is_sys_object(dbt.trigger_name, cp_excl_sysgen)
2785  		 )
2786  	       , cnt_trgt AS (SELECT COUNT(*) AS expected_count FROM trgt)
2787  	       , trgs AS
2788  		 (SELECT dbt.owner
2789  		       , dbt.trigger_name
2790  		       , dbt.table_owner
2791  		    FROM dba_triggers dbt
2792  		   INNER JOIN base
2793  		      ON dbt.owner = base.owner
2794  		   WHERE dbt.table_name     IS NULL
2795  			 -- user exclude condition
2796  		     AND NOT otap_string.is_sys_object(dbt.trigger_name, cp_excl_sysgen)
2797  		 )
2798  	       , cnt_trgs AS (SELECT COUNT(*) AS expected_count FROM trgs)
2799  	       , cnt_schemas AS (SELECT COUNT(*) AS expected_count FROM dba_users WHERE username LIKE cp_like ESCAPE '\')
2800  	       , cnt_types AS (SELECT COUNT(*) AS expected_count
2801  				 FROM dba_objects dbo
2802  				 LEFT OUTER JOIN dba_types dbt
2803  				   ON dbo.owner = dbt.owner
2804  				  AND dbo.object_name = dbt.type_name
2805  				WHERE dbo.owner       LIKE cp_like ESCAPE '\'
2806  				  AND dbo.object_type	 = 'TYPE'
2807  				  AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl_sysgen)
2808  			      )
2809  	       , cnt_sequences AS (SELECT COUNT(*) AS expected_count
2810  				     FROM dba_sequences dbs
2811  				     LEFT OUTER JOIN dba_tab_identity_cols dti
2812  				       ON dbs.sequence_name  = dti.sequence_name
2813  				    WHERE dbs.sequence_owner LIKE cp_like ESCAPE '\'
2814  				  )
2815  	       , cnt_sched_jobs AS (SELECT COUNT(*) AS expected_count
2816  				      FROM dba_scheduler_jobs
2817  				     WHERE owner    LIKE cp_like ESCAPE '\'
2818  				       AND NOT otap_string.is_sys_object(job_name, cp_excl_sysgen)
2819  				   )
2820  	       , cnt AS
2821  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
2822  		   UNION ALL
2823  		  SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
2824  		   UNION ALL
2825  		  SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
2826  		   UNION ALL
2827  		  SELECT expected_count, 'TABLE TRIGGER' AS info FROM cnt_trgt
2828  		   UNION ALL
2829  		  SELECT expected_count, 'SCHEMA TRIGGER' AS info FROM cnt_trgs
2830  		   UNION ALL
2831  		  SELECT expected_count, 'SCHEMAS' AS info FROM cnt_schemas
2832  		   UNION ALL
2833  		  SELECT expected_count, 'TYPES' AS info FROM cnt_types
2834  		   UNION ALL
2835  		  SELECT expected_count, 'SEQUENCES' AS info FROM cnt_sequences
2836  		   UNION ALL
2837  		  SELECT expected_count, 'SCHEDULER JOBS' AS info FROM cnt_sched_jobs
2838  		   UNION ALL
2839  		  SELECT cp_usr_cnt AS expected_count, 'USER TESTS' AS info FROM dual
2840  		 )
2841  	  SELECT SUM(expected_count) AS test_count
2842  	  FROM cnt
2843  	  ;
2844  	BEGIN
2845  	  l_like       := NVL(p_like_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'));
2846  	  l_schema     := otap_string.reduce(SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'), 128);
2847  	  -- get test count, simulate conditions of called test generators
2848  	  OPEN cur_user_cnt(p_required_user);
2849  	  FETCH cur_user_cnt INTO l_user_count;
2850  	  CLOSE cur_user_cnt;
2851  	  OPEN cur_test_count(p_excl_sysgen, p_like_schema, l_user_count);
2852  	  FETCH cur_test_count INTO l_test_count;
2853  	  CLOSE cur_test_count;
2854  	  -- get header
2855  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'schemas', NULL, l_like, l_test_count, p_show_header)
2856  	  LOOP
2857  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2858  	  END LOOP;
2859  	  -- get related users if any
2860  	  IF l_user_count > 0
2861  	  THEN
2862  	    -- build test set
2863  	    l_statement := otap_generate.get_code_pad || '-- set test set for schema';
2864  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2865  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_set(''Required users'')' || otap_generate.get_code_postfix;
2866  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2867  	    FOR rec IN cur_related_users(p_required_user, p_title_prefix)
2868  	    LOOP
2869  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2870  	    END LOOP;
2871  	  END IF;
2872  	  -- get schemas to process
2873  	  l_pad_par := otap_generate.get_code_prefix_len + 20;
2874  	  FOR recset IN cur_schemas(l_like, p_excl_sysgen)
2875  	  LOOP
2876  	    -- build set row
2877  	    l_statement := otap_generate.get_code_pad || '-- set test set for schema';
2878  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2879  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_set(''schema ' || recset.username || ''')' || otap_generate.get_code_postfix;
2880  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2881  	    -- first get the schema check
2882  	    FOR rec IN cur_schema_user(recset.username, p_title_prefix)
2883  	    LOOP
2884  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2885  	    END LOOP;
2886  	    -- now get the schema objects
2887  	    FOR rec IN cur_tables('%', recset.username, p_title_prefix, p_excl_sysgen)
2888  	    LOOP
2889  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2890  	    END LOOP;
2891  	    FOR rec IN cur_trigger('%', recset.username, p_title_prefix, p_excl_sysgen)
2892  	    LOOP
2893  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2894  	    END LOOP;
2895  	    FOR rec IN cur_packages('%', recset.username, p_title_prefix, p_excl_sysgen)
2896  	    LOOP
2897  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2898  	    END LOOP;
2899  	    FOR rec IN cur_views('%', recset.username, p_title_prefix, p_excl_sysgen)
2900  	    LOOP
2901  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2902  	    END LOOP;
2903  	    -- set group name for types and other not specialy treated objects
2904  	    l_statement := otap_generate.get_code_pad || '-- set test group for remaining object';
2905  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2906  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''other objects'')' || otap_generate.get_code_postfix;
2907  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2908  	    FOR rec IN cur_types('%', recset.username, p_title_prefix, p_excl_sysgen)
2909  	    LOOP
2910  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2911  	    END LOOP;
2912  	    FOR rec IN cur_sequences('%', recset.username, p_title_prefix, p_excl_sysgen)
2913  	    LOOP
2914  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2915  	    END LOOP;
2916  	    FOR rec IN cur_jobs('%', recset.username, p_title_prefix, p_excl_sysgen)
2917  	    LOOP
2918  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2919  	    END LOOP;
2920  	  END LOOP;
2921  	  FOR rec IN cur_footer(p_show_header)
2922  	  LOOP
2923  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2924  	  END LOOP;
2925  	  RETURN;
2926  	EXCEPTION
2927  	  WHEN NO_DATA_NEEDED THEN
2928  	    RAISE;
2929  	END schema_tests;
2930  
2931  	FUNCTION get_dba_col_details( p_table_name  IN VARCHAR2
2932  				    , p_column_name IN VARCHAR2
2933  				    , p_msg_type    IN NUMBER	DEFAULT 0
2934  				    )
2935  	  RETURN VARCHAR2
2936  	IS
2937  	  PRAGMA AUTONOMOUS_TRANSACTION;
2938  	  l_count     INTEGER;
2939  	  l_data_type sys.dba_tab_columns.data_type%TYPE;
2940  	  l_nullable  sys.dba_tab_columns.nullable%TYPE;
2941  	  l_char_len  sys.dba_tab_columns.char_length%TYPE;
2942  	  l_statement VARCHAR2(32767 CHAR);
2943  	  l_return    VARCHAR2(4000 CHAR);
2944  	  l_dba_table VARCHAR2(128 CHAR);
2945  	  l_dba_col   VARCHAR2(128 CHAR);
2946  	BEGIN
2947  	  IF	 p_table_name  IS NOT NULL
2948  	     AND p_column_name IS NOT NULL
2949  	  THEN
2950  	    l_dba_table := otap_string.reduce(UPPER(p_table_name), 128);
2951  	    l_dba_col	:= otap_string.reduce(UPPER(p_column_name), 128);
2952  	    SELECT COUNT(*)
2953  	      INTO l_count
2954  	      FROM dba_tab_columns
2955  	     WHERE owner = 'SYS'
2956  	       AND table_name	= l_dba_table
2957  	       AND column_name	= l_dba_col
2958  	       AND data_type   IN ('VARCHAR2', 'DATE', 'NUMBER')
2959  	    ;
2960  	    IF l_count = 0
2961  	    THEN
2962  	      l_return := 'Invalid column or table name or datatype not supported';
2963  	    ELSE
2964  	      -- get column details
2965  	      SELECT data_type
2966  		   , nullable
2967  		   , char_length
2968  		INTO l_data_type
2969  		   , l_nullable
2970  		   , l_char_len
2971  		FROM dba_tab_columns
2972  	       WHERE owner = 'SYS'
2973  		 AND table_name   = l_dba_table
2974  		 AND column_name  = l_dba_col
2975  		 AND data_type	 IN ('VARCHAR2', 'DATE', 'NUMBER')
2976  	      ;
2977  	      IF NVL(p_msg_type, 0) = 0
2978  	      THEN
2979  		IF l_nullable = 'N'
2980  		THEN
2981  		  l_return := LOWER(l_dba_col) || ' -- not nullable';
2982  		  -- determine valid NULL substition
2983  		  IF l_data_type = 'VARCHAR2'
2984  		  THEN
2985  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = ''n/a'' AND ' || l_dba_col || ' IS NOT NULL';
2986  		    EXECUTE IMMEDIATE l_statement INTO l_count;
2987  		    l_return := l_return || CASE WHEN l_count = 0 THEN ' n/a valid substitute' ELSE ' n/a not working as substitute' END;
2988  		  ELSIF l_data_type = 'NUMBER'
2989  		  THEN
2990  		    -- verify -1 is usable
2991  		    l_statement := 'SELECT MIN(' || l_dba_col || ') FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' IS NOT NULL';
2992  		    EXECUTE IMMEDIATE l_statement INTO l_count;
2993  		    l_return := l_return || CASE WHEN l_count >= 0 THEN ' -1 valid substitute' ELSE ' -1 not working as substitute' END;
2994  		  ELSE
2995  		    -- verify 01.01.1900 is usable
2996  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') AND ' || l_dba_col || ' IS NOT NULL';
2997  		    EXECUTE IMMEDIATE l_statement INTO l_count;
2998  		    l_return := l_return || CASE WHEN l_count = 0 THEN ' TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') valid substitute' ELSE ' TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') not working as substitute' END;
2999  		  END IF;
3000  		ELSE
3001  		  -- determine valid NULL substition
3002  		  IF l_data_type = 'VARCHAR2'
3003  		  THEN
3004  		    -- verify n/a is not used in the given field for the given table and column
3005  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = ''n/a'' AND ' || l_dba_col || ' IS NOT NULL';
3006  		    EXECUTE IMMEDIATE l_statement INTO l_count;
3007  		    l_return := 'NVL(' || LOWER(l_dba_col) || ', ''n/a'')';
3008  		    IF l_count != 0
3009  		    THEN
3010  		      l_return := l_return || ' -- n/a not save, substitute the value by a value that is not contained in the column';
3011  		    END IF;
3012  		  ELSIF l_data_type = 'NUMBER'
3013  		  THEN
3014  		    -- verify -1 is usable
3015  		    l_statement := 'SELECT MIN(' || l_dba_col || ') FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' IS NOT NULL';
3016  		    EXECUTE IMMEDIATE l_statement INTO l_count;
3017  		    l_return := 'NVL(' || LOWER(l_dba_col) || ', -1)';
3018  		    IF l_count < 0
3019  		    THEN
3020  		      l_return := l_return || ' -- -1 not save, substitute the value by a value that is not contained in the column';
3021  		    END IF;
3022  		  ELSE
3023  		    -- verify 01.01.1900 is usable
3024  		    l_statement := 'SELECT COUNT(*) FROM ' || l_dba_table || ' WHERE ' || l_dba_col || ' = TO_DATE(''01.01.1900'', ''DD.MM.YYYY'') AND ' || l_dba_col || ' IS NOT NULL';
3025  		    EXECUTE IMMEDIATE l_statement INTO l_count;
3026  		    l_return := 'NVL(' || LOWER(l_dba_col) || ', TO_DATE(''01.01.1900'', ''DD.MM.YYYY''))';
3027  		    IF l_count != 0
3028  		    THEN
3029  		      l_return := l_return || ' -- 01.01.1900 not save, substitute the value by a value that is not contained in the column';
3030  		    END IF;
3031  		  END IF;
3032  		END IF;
3033  	      ELSE
3034  		-- variable declaration
3035  		l_return := 'l_' || LOWER(l_dba_col) || ' ' || l_data_type ||
3036  			    CASE WHEN l_data_type = 'VARCHAR2' THEN '(' || TRIM(TO_CHAR(l_char_len)) || ' CHAR)' END || ';'
3037  		;
3038  	      END IF;
3039  	    END IF;
3040  	  ELSE
3041  	    l_return := 'Try using NOT NULL values for both parameters';
3042  	  END IF;
3043  	  RETURN l_return;
3044  	END get_dba_col_details;
3045  
3046  END;
3047  /

