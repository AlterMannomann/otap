SQL> @@../otap_ddl/packages/otap_schema.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_schema
  2  AS
  3    -- for description see header file
  4    FUNCTION has_table( p_table_name   IN		VARCHAR2
  5  			 , o_otap_session IN OUT NOCOPY OTAP_SESSION
  6  			 , p_schema	  IN		VARCHAR2     DEFAULT NULL
  7  			 , p_description  IN		VARCHAR2     DEFAULT NULL
  8  			 )
  9  	 RETURN VARCHAR2
 10    IS
 11  	 l_script	     VARCHAR2(1024) := 'otap_schema.has_table';
 12  	 l_has_table	     INTEGER;
 13  	 l_test_passed	     INTEGER;
 14  	 l_schema_to_use     VARCHAR2(130);
 15  	 l_table_name	     VARCHAR2(130);
 16  	 l_test_result	     VARCHAR2(256);
 17  	 l_test_description  VARCHAR2(256);
 18  	 l_errors	     VARCHAR2(4000);
 19  	 l_statement	     VARCHAR2(32767);
 20  	 l_tmp_otap_session  OTAP_SESSION;
 21    BEGIN
 22  	 l_errors := NULL;
 23  	 IF	p_table_name		  IS NOT NULL
 24  	    AND LENGTH(TRIM(p_table_name)) > 0
 25  	 THEN
 26  	   -- check description
 27  	   l_test_description := NVL(p_description, 'Test table ' || p_table_name || ' exists');
 28  	   l_schema_to_use := NVL(p_schema, o_otap_session.db_schema);
 29  	   SELECT COUNT(*)
 30  	     INTO l_has_table
 31  	     FROM dba_tables
 32  	    WHERE table_name = p_table_name
 33  	      AND owner      = l_schema_to_use
 34  	   ;
 35  	   -- we should find one or zero entries
 36  	   l_test_passed := CASE l_has_table
 37  			      WHEN 0
 38  			      THEN otap_constants.OTAP_NUM_TEST_FAILED
 39  			      WHEN 1
 40  			      THEN otap_constants.OTAP_NUM_TEST_PASSED
 41  			      ELSE otap_constants.OTAP_NUM_TEST_UNDEFINED
 42  			    END
 43  	   ;
 44  	   -- report abnormal results and store them in errors
 45  	   IF l_has_table NOT IN (0, 1)
 46  	   THEN
 47  	     l_statement := q'[SELECT COUNT(*)
 48   INTO l_has_table
 49   FROM dba_tables
 50  WHERE table_name = '"' || p_table_name || '"'
 51    AND owner      = '"' || l_schema_to_use || '"']'
 52  	     ;
 53  	     l_errors := 'Check table ' || l_table_name || ' with schema ' || l_schema_to_use || ' results in count ' || l_has_table;
 54  	     otap_util.log(l_errors, l_script, l_statement);
 55  	   END IF;
 56  	 ELSE
 57  	   -- invalid table name
 58  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
 59  	   l_statement	       := 'p_table_name IS NOT NULL AND LENGTH(TRIM(p_table_name)) > 0';
 60  	   l_errors	       := 'Missing table name';
 61  	   l_test_description  := 'Test table ? exists';
 62  	   l_schema_to_use     := NVL(p_schema, o_otap_session.db_schema);
 63  	   otap_util.log(l_errors, l_script, l_statement);
 64  	 END IF;
 65  	 -- due to a possible schema override prepare a temporary object with the schema used
 66  	 l_tmp_otap_session := OTAP_SESSION( o_otap_session.test_executor
 67  					   , o_otap_session.test_set
 68  					   , o_otap_session.test_group
 69  					   , o_otap_session.test_name
 70  					   , o_otap_session.db_user
 71  					   , l_schema_to_use
 72  					   , o_otap_session.test_prefix
 73  					   , o_otap_session.test_count
 74  					   , o_otap_session.intended_count
 75  					   , o_otap_session.persist_test
 76  					   , o_otap_session.name_precedence
 77  					   , o_otap_session.include_packages
 78  					   )
 79  	 ;
 80  	 otap_plan.write_test_result(l_test_description, l_tmp_otap_session, l_test_passed, l_errors);
 81  	 -- now update the session record with new test done
 82  	 otap_plan.add_test(o_otap_session);
 83  	 l_test_result := otap_plan.format_test_result(l_test_passed, l_test_description);
 84  	 RETURN l_test_result;
 85    EXCEPTION
 86  	 WHEN OTHERS THEN
 87  	   otap_util.log('Unexpected exception. Internal error:' || SQLERRM, 'otap_schema.has_table', 'otap_schema.has_table call');
 88  	   RAISE;
 89    END has_table;
 90  
 91  END;
 92  /

