SQL> -- Basic package that provides utility functions and procedures for otap.
SQL> CREATE OR REPLACE PACKAGE otap_util
  2  AS
  3    /**
  4    * Provides internal functions and procedures for otap like logging, interface to OTAP_CONFIG and
  5    * others without a clear category. You need the schema owner to use this functions.
  6    */
  7  
  8    /** FUNCTION otap_util.debug_active
  9    * Returns the debug state, defined in OTAP_CONFIG. Can't log errors as log depends on
 10    * this function.
 11    *
 12    * @return TRUE if DEBUG_MODE is set to 1 in OTAP_CONFIG, otherwise or on errors FALSE.
 13    */
 14    FUNCTION debug_active
 15  	 RETURN BOOLEAN
 16    ;
