637    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
638  				  , p_test_passed	IN NUMBER
639  				  , p_test_session_id	IN NUMBER
640  				  , p_test_executor	IN VARCHAR2
641  				  , p_test_set		IN VARCHAR2
642  				  , p_db_user		IN VARCHAR2
643  				  , p_db_schema 	IN VARCHAR2
644  				  , p_test_group	IN VARCHAR2
645  				  , p_test_start	IN TIMESTAMP
646  				  , p_test_end		IN TIMESTAMP
647  				  , p_test_name 	IN VARCHAR2
648  				  , p_test_desc 	IN VARCHAR2
649  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
650  				  )
651    IS
652  	 PRAGMA AUTONOMOUS_TRANSACTION;
653  	 l_script      VARCHAR2(256 CHAR) := 'otap_util.write_test_result';
654  	 l_to_delete   NUMBER;
655  	 l_test_passed NUMBER;
656  	 l_errors      otap_results.test_errors%TYPE;
657    BEGIN
658  	 l_to_delete   := CASE
659  			    WHEN p_to_delete IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
660  			    THEN p_to_delete
661  			    ELSE otap_constants.OTAP_NUM_TRUE
662  			  END
663  	 ;
664  	 -- this is an error and must be handled
665  	 IF p_test_passed NOT IN (otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
666  	 THEN
667  	   l_errors := otap_string.reduce('Invalid test result: ' || p_test_passed || ' ' || p_test_errors, 4000);
668  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
669  	 ELSE
670  	   l_test_passed := p_test_passed;
671  	   l_errors := p_test_errors;
672  	 END IF;
673  	 INSERT INTO otap_results
674  	   ( to_delete
675  	   , test_passed
676  	   , test_session_id
677  	   , test_executor
678  	   , test_set
679  	   , db_user
680  	   , db_schema
681  	   , test_group
682  	   , test_start
683  	   , test_end
684  	   , test_name
685  	   , test_desc
686  	   , test_errors
687  	   ) VALUES ( l_to_delete
688  		    , l_test_passed
689  		    , p_test_session_id
690  		    , p_test_executor
691  		    , p_test_set
692  		    , p_db_user
693  		    , p_db_schema
694  		    , p_test_group
695  		    , p_test_start
696  		    , p_test_end
697  		    , p_test_name
698  		    , p_test_desc
699  		    , l_errors
700  		    )
701  	 ;
702  	 COMMIT;
703    EXCEPTION
704  	 WHEN OTHERS THEN
705  	   otap_log.log(SQLERRM, l_script, 'INSERT into otap_results');
706  	   ROLLBACK;
707  	   RAISE;
708    END write_test_result;
