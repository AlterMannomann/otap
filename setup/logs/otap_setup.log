332    /** FUNCTION otap_generate.prepare
333    * Maps the schema, object type and object to set, group and name, including the prefix, which prefixes the
334    * set without delimiter and returns the function/procedure name for this mapping.
335    *
336    * If p_object_type is empty, p_object is not used at all and o_name is set to NULL. Only NOT NULL values included.
337    *
338    * The prefix gets cutted to max. 10 chars. Set, group and name are reduced to max. 30 chars. Delimiters are removed.
339    *
340    * @param p_title_prefix An optional title prefix. For function names cutted to 10 chars.
341    * @param p_schema The schema to use for set. For function names cutted to 30 chars.
342    * @param p_object_type The object type to use for group like tables, trigger and so on. For function names cutted to 30 chars.
343    * @param p_object The object name to use for name. For function names cutted to 30 chars.
344    * @param o_set The test set from schema and prefix. Limited to 256 chars.
345    * @param o_group The test group from object type. Limited to 256 chars.
346    * @param o_name The test name from object name. Limited to 256 chars.
347    *
348    * @return A valid function/procedure name of pattern test_(p_title_prefix)<o_set>(_<o_group>(_<o_name>)) with maximum length 128.
349    */
350    FUNCTION prepare( p_title_prefix IN	       VARCHAR2
351  		       , p_schema	IN	       VARCHAR2
352  		       , p_object_type	IN	       VARCHAR2
353  		       , p_object	IN	       VARCHAR2
354  		       , o_set		   OUT NOCOPY  VARCHAR2
355  		       , o_group	   OUT NOCOPY  VARCHAR2
356  		       , o_name 	   OUT NOCOPY  VARCHAR2
357  		       )
358  	 RETURN VARCHAR2
359    ;
