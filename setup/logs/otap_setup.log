268    FUNCTION get_summary( p_runtime	IN VARCHAR2 DEFAULT otap_constants.OTAP_CHAR_NA
269  			   , p_runs	IN NUMBER   DEFAULT 0
270  			   , p_errors	IN NUMBER   DEFAULT 0
271  			   , p_issues	IN NUMBER   DEFAULT 0
