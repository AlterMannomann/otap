179  		      'DB user: ' || p_otap_session.db_user || otap_constants.OTAP_LF ||
180  		      'DB schema: ' || p_otap_session.db_schema || otap_constants.OTAP_LF ||
181  		      'Test identifier prefix: ' || p_otap_session.test_prefix || otap_constants.OTAP_LF ||
182  		      'Current tests:' || p_otap_session.test_count || otap_constants.OTAP_LF ||
183  		      'Expected tests: ' || CASE WHEN p_otap_session.intended_count > 0 THEN TO_CHAR(p_otap_session.intended_count) ELSE 'Not set' END || otap_constants.OTAP_LF ||
184  		      'Name precedence: ' || CASE WHEN p_otap_session.name_precedence THEN otap_constants.OTAP_CHAR_TRUE_YES ELSE otap_constants.OTAP_CHAR_FALSE_NO END || otap_constants.OTAP_LF ||
185  		      'Include packages: ' || CASE WHEN p_otap_session.include_packages THEN otap_constants.OTAP_CHAR_TRUE_YES ELSE otap_constants.OTAP_CHAR_FALSE_NO END || otap_constants.OTAP_LF ||
186  		      'Persist: ' || CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_CHAR_TRUE_YES ELSE otap_constants.OTAP_CHAR_FALSE_NO END || otap_constants.OTAP_LF ||
187  		      'Current view id: ' || CASE WHEN p_otap_session.session_view_id = 0 THEN 'Not set' ELSE p_otap_session.session_view_id END || otap_constants.OTAP_LF ||
188  		      'Test start: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
189  	 ;
