337    FUNCTION get_summary( p_runtime	IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
338  			   , p_runs	IN NUMBER   DEFAULT 0
339  			   , p_errors	IN NUMBER   DEFAULT 0
340  			   , p_issues	IN NUMBER   DEFAULT 0
341  			   , p_min_fill IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
342  			   )
343  	 RETURN VARCHAR2
344    IS
345  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.get_summary';
346  	 l_message VARCHAR2(4000 CHAR);
347  	 l_status  VARCHAR2(4000 CHAR);
348    BEGIN
349  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
350  	 -- execute the wrapped function in an extra block
351  	 BEGIN
352  	   l_status := CASE
353  			 WHEN p_issues > 0
354  			 THEN otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
355  			 WHEN p_errors > 0 AND p_issues <= 0
356  			 THEN otap_constants.OTAP_FALLBACK_TEXT_TEST_FAILED
357  			 ELSE otap_constants.OTAP_FALLBACK_TEXT_TEST_PASSED
358  		       END
359  	   ;
360  	   l_message := otap_report.get_summary(l_status, p_runtime, p_runs, p_errors, p_issues, p_min_fill);
361  	 EXCEPTION
362  	   WHEN OTHERS THEN
363  	     -- consume error
364  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_summary');
365  	     l_message := otap_string.reduce('Internal otap error get report summary: ' || SQLERRM, 4000);
366  	 END;
367  	 -- return or let exception happen
368  	 RETURN l_message;
369    END get_summary;
