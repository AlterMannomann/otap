SQL> CREATE OR REPLACE PACKAGE BODY otap_plan
  2  AS
  3    -- for description see header file
  4    PROCEDURE write_test_result( p_test_description IN VARCHAR2
  5  				  , p_otap_session     IN OTAP_SESSION
  6  				  , p_test_passed      IN NUMBER
  7  				  , p_test_errors      IN VARCHAR2     DEFAULT NULL
  8  				  )
  9    IS
 10  	 PRAGMA AUTONOMOUS_TRANSACTION;
 11  	 l_script	     VARCHAR2(1024) := 'otap_plan.write_test_result';
 12  	 l_test_passed	     INTEGER;
 13  	 l_test_description  VARCHAR2(256);
 14  	 l_errors	     VARCHAR2(4000);
 15  	 l_to_delete	     INTEGER;
 16    BEGIN
 17  	 IF LENGTH(TRIM(l_errors)) > 4000
 18  	 THEN
 19  	   l_errors := SUBSTR(TRIM(p_test_errors), 1, 4000);
 20  	 ELSE
 21  	   l_errors := TRIM(p_test_errors);
 22  	 END IF;
 23  	 IF p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 24  	 THEN
 25  	   l_test_passed := p_test_passed;
 26  	 ELSE
 27  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
 28  	   l_errors	 := SUBSTR('Invalid test passed value: ' || p_test_passed || otap_constants.OTAP_LF || l_errors, 1, 4000);
 29  	   otap_util.log('ERROR The given value for test passed ' || p_test_passed || ' for test description ' || p_test_description || ' is not valid.', l_script, 'p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)');
 30  	 END IF;
 31  	 IF p_test_description IS NULL
 32  	 THEN
 33  	   l_test_description := 'Unspecified test ' || TIMESTAMP_TO_SCN(SYSTIMESTAMP);
 34  	   l_errors	      := SUBSTR('Missing test description' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 35  	 ELSE
 36  	   IF LENGTH(p_test_description) > 256
 37  	   THEN
 38  	     l_test_description := SUBSTR(TRIM(p_test_description), 1, 256);
 39  	     l_errors		:= SUBSTR('Test description too long, cutted' || otap_constants.OTAP_LF || l_errors, 1, 4000);
 40  	   ELSE
 41  	     l_test_description := TRIM(p_test_description);
 42  	   END IF;
 43  	 END IF;
 44  	 -- set delete flag as stored
 45  	 l_to_delete := CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_NUM_FALSE ELSE otap_constants.OTAP_NUM_TRUE END;
 46  	 -- ready to insert
 47  	 INSERT INTO otap_results
 48  	   ( to_delete
 49  	   , test_passed
 50  	   , test_executor
 51  	   , test_set
 52  	   , test_group
 53  	   , test_name
 54  	   , test_desc
 55  	   , db_user
 56  	   , db_schema
 57  	   , test_errors
 58  	   ) VALUES ( l_to_delete
 59  		    , l_test_passed
 60  		    , p_otap_session.test_executor
 61  		    , p_otap_session.test_set
 62  		    , p_otap_session.test_group
 63  		    , p_otap_session.test_name
 64  		    , l_test_description
 65  		    , p_otap_session.db_user
 66  		    , p_otap_session.db_schema
 67  		    , l_errors
 68  		    )
 69  	 ;
 70  	 COMMIT;
 71    EXCEPTION
 72  	 WHEN OTHERS THEN
 73  	   otap_util.log(SQLERRM, l_script, 'otap_plan.write_test_result call');
 74  	   RAISE;
 75    END write_test_result;
 76  
 77    PROCEDURE write_count_result(p_otap_session IN OTAP_SESSION)
 78    IS
 79  	 l_script	     VARCHAR2(1024) := 'otap_plan.write_count_result';
 80  	 l_test_passed	     INTEGER;
 81  	 l_test_description  VARCHAR2(256);
 82  	 l_errors	     VARCHAR2(4000);
 83    BEGIN
 84  	 -- only write a record, if intended count is set, do nothing otherwise
 85  	 IF p_otap_session.intended_count > 0
 86  	 THEN
 87  	   l_test_passed      := CASE WHEN p_otap_session.test_count = p_otap_session.intended_count THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
 88  	   l_test_description := 'Expected test count result';
 89  	   l_errors	      := NULL;
 90  	   write_test_result(l_test_description, p_otap_session, l_test_passed, l_errors);
 91  	 END IF;
 92    EXCEPTION
 93  	 WHEN OTHERS THEN
 94  	   otap_util.log(SQLERRM, l_script, 'otap_plan.write_count_result call');
 95  	   RAISE;
 96    END write_count_result;
 97  
 98    FUNCTION current_test_setting(p_otap_session IN OTAP_SESSION)
 99  	 RETURN VARCHAR2
100    IS
101  	 l_message VARCHAR2(4000);
102    BEGIN
103  	 l_message := 'Current test settings' || otap_constants.OTAP_LF ||
104  		      'Test set: ' || p_otap_session.test_set || otap_constants.OTAP_LF ||
105  		      'Test group: ' || p_otap_session.test_group || otap_constants.OTAP_LF ||
106  		      'Test name: ' || p_otap_session.test_name || otap_constants.OTAP_LF ||
107  		      'Executor: ' || p_otap_session.test_executor || otap_constants.OTAP_LF ||
108  		      'DB user: ' || p_otap_session.db_user || otap_constants.OTAP_LF ||
109  		      'DB schema: ' || p_otap_session.db_schema || otap_constants.OTAP_LF ||
110  		      'Test identifier prefix: ' || p_otap_session.test_prefix || otap_constants.OTAP_LF ||
111  		      'Current tests:' || p_otap_session.test_count || otap_constants.OTAP_LF ||
112  		      'Expected tests: ' || CASE WHEN p_otap_session.intended_count > 0 THEN TO_CHAR(p_otap_session.intended_count) ELSE 'Not set' END || otap_constants.OTAP_LF ||
113  		      'Name precedence: ' || CASE WHEN p_otap_session.name_precedence THEN otap_constants.OTAP_CHAR_TRUE_YES ELSE otap_constants.OTAP_CHAR_FALSE_NO END || otap_constants.OTAP_LF ||
114  		      'Include packages: ' || CASE WHEN p_otap_session.include_packages THEN otap_constants.OTAP_CHAR_TRUE_YES ELSE otap_constants.OTAP_CHAR_FALSE_NO END || otap_constants.OTAP_LF ||
115  		      'Persist: ' || CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_CHAR_TRUE_YES ELSE otap_constants.OTAP_CHAR_FALSE_NO END
116  	 ;
117  	 RETURN SUBSTR(l_message, 1, 4000);
118    EXCEPTION
119  	 WHEN OTHERS THEN
120  	   otap_util.log(SQLERRM, 'otap_plan.current_test_setting', 'otap_plan.current_test_setting call');
121  	   RAISE;
122    END current_test_setting;
