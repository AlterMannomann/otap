330    FUNCTION decorate( p_title	IN VARCHAR2 DEFAULT NULL
331  			, p_decoration	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
332  			, p_min_length	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
333  			, p_layout	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
334  			, p_border	IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
335  			)
336  	 RETURN VARCHAR2
337    IS
338  	 l_script	 VARCHAR2(256 CHAR) := 'otap_string.decorate';
339  	 l_deco_length	 INTEGER;
340  	 l_pad_length	 INTEGER;
341  	 l_title_length  INTEGER;
342  	 l_min_length	 INTEGER;
343  	 l_line_size	 INTEGER;
344  	 l_add		 INTEGER;
345  	 l_padding	 INTEGER;
346  	 l_border	 INTEGER;
347  	 l_deco 	 VARCHAR2(1 CHAR);
348  	 l_layout	 VARCHAR2(1 CHAR);
349  	 l_deco_string	 VARCHAR2(32767 CHAR);
350  	 l_title	 VARCHAR2(32767 CHAR);
351    BEGIN
352  	 otap_log.log('Parameter p_title: ' || p_title || ' p_decoration: ' || p_decoration || ' p_min_length: ' || p_min_length || ' p_layout: ' || p_layout || ' p_border: ' || p_border, l_script, 'Call', 'OTAP_DEBUG');
353  	 -- check params, assign defaults
354  	 l_min_length := otap_string.check_line_size(p_min_length);
355  	 l_border     := otap_string.check_border(p_border);
356  	 l_layout     := otap_string.check_layout(p_layout);
357  	 l_deco       := otap_string.check_decoration(p_decoration);
358  	 otap_log.log('After param check l_min_length: ' || l_min_length || ' l_border: ' || l_border || ' l_layout: ' || l_layout || ' l_deco: ' || l_deco, l_script, 'param check section', 'OTAP_DEBUG');
359  	 l_title_length := otap_string.check_title_size(LENGTH(p_title), l_border);
360  	 l_line_size	:= otap_string.line_size(l_title_length, l_border, l_min_length);
361  	 l_title_length := otap_string.max_size(l_title_length, l_line_size, l_border);
362  	 l_title	:= otap_string.reduce(p_title, l_title_length);
363  	 otap_log.log('Current title: ' || l_title || ' calculated title length: ' || l_title_length || ' line size: ' || l_line_size, l_script, 'Calculate title and line size to use', 'OTAP_DEBUG');
364  	 -- build the string
365  	 l_deco_string := otap_string.left_deco(l_title_length, l_line_size, l_deco, l_layout) ||
366  			  l_title ||
367  			  otap_string.right_deco(l_title_length, l_line_size, l_deco, l_layout)
368  	 ;
369  	 RETURN l_deco_string;
370    EXCEPTION
371  	 WHEN OTHERS THEN
372  	   otap_log.log(SQLERRM, l_script, 'Decorate string');
373  	   RAISE;
374    END decorate;
375  
376    FUNCTION borderless( p_string	  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
377  			  , p_min_length  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
378  			  , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT
379  			  )
380  	 RETURN VARCHAR2
381    IS
382  	 l_script      VARCHAR2(256 CHAR) := 'otap_string.borderless';
383  	 l_layout      VARCHAR2(1 CHAR);
384  	 l_min_length  INTEGER;
385  	 l_line_size   INTEGER;
386  	 l_string      VARCHAR2(32767 CHAR);
387    BEGIN
388  	 l_min_length := otap_string.check_line_size(p_min_length);
389  	 l_layout     := otap_string.check_layout(p_layout);
390  	 IF l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
391  	 THEN
392  	   l_layout := otap_constants.OTAP_LAYOUT_LEFT;
393  	 END IF;
394  	 l_line_size   := GREATEST(l_min_length, otap_string.check_string_size(NVL(LENGTH(p_string), 0)));
395  	 l_string      := otap_string.reduce(p_string, l_line_size);
396  	 -- now pad the string for the right or left side
397  	 IF l_layout = otap_constants.OTAP_LAYOUT_RIGHT
398  	 THEN
399  	   l_string := LPAD(l_string, l_line_size, ' ');
400  	 ELSE
401  	   -- middle and left are treated equally
402  	   l_string := RPAD(l_string, l_line_size, ' ');
403  	 END IF;
404  	 RETURN l_string;
405    EXCEPTION
406  	 WHEN OTHERS THEN
407  	   otap_log.log(SQLERRM, l_script, 'Borderless layout');
408  	   RAISE;
409    END borderless;
410  
411    FUNCTION is_sys_object( p_string  IN VARCHAR2
412  			     , p_exclude IN NUMBER   DEFAULT 1
413  			     )
414  	 RETURN BOOLEAN
415    IS
416  	 l_script VARCHAR2(256 CHAR) := 'otap_string.is_sys_object';
417  	 l_return BOOLEAN;
418    BEGIN
419  	 l_return := FALSE;
420  	 IF NVL(p_exclude, 1) != 0
421  	 THEN
422  	   l_return := (UPPER(SUBSTR(TRIM(p_string), 1, 4)) = 'SYS_' OR INSTR(p_string, '$') > 0 OR INSTR(p_string, '#') > 0);
423  	 END IF;
424  	 RETURN l_return;
425    EXCEPTION
426  	 WHEN OTHERS THEN
427  	   otap_log.log(SQLERRM, l_script, 'Identify sys object');
428  	   RETURN FALSE;
429    END is_sys_object;
430  
431  END;
