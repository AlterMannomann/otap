210  	   FROM otap_config
211  	  WHERE config_name IN ( otap_constants.OTAP_CFG_TEXT_TEST_FAILED
212  			       , otap_constants.OTAP_CFG_TEXT_TEST_PASSED
213  			       , otap_constants.OTAP_CFG_TEXT_TEST_UNDEFINED
214  			       )
215  	 ;
216  	 RETURN l_return;
217    EXCEPTION
218  	 WHEN OTHERS THEN
219  	   otap_log.log(SQLERRM, 'otap_config_util.get_length_test_state', 'Get MAX length for config values');
220  	   RAISE;
