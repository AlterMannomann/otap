1318  	FUNCTION view_tests( p_like_view     IN VARCHAR2 DEFAULT '%'
1319  			   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1320  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
1321  			   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1322  			   , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1323  			   )
1324  	  RETURN otap_view_result_tbl PIPELINED
1325  	IS
1326  	  l_statement	VARCHAR2(4000 CHAR);
1327  	  l_schema	VARCHAR2(128 CHAR);
1328  	  l_like	VARCHAR2(256 CHAR);
1329  	  l_test_count	INTEGER;
1330  	  l_pad_par	INTEGER;
1331  	  CURSOR cur_views( cp_schema IN VARCHAR2
1332  			  , cp_like   IN VARCHAR2
1333  			  , cp_excl   IN NUMBER
1334  			  )
1335  	  IS
1336  	    SELECT owner
1337  		 , object_name AS view_name
1338  		 , object_type
1339  	      FROM dba_objects
1340  	     WHERE owner	  = cp_schema
1341  	       AND object_type LIKE '%VIEW'
1342  	       AND object_name LIKE cp_like ESCAPE '\'
1343  	       AND NOT otap_string.is_sys_object(object_name, cp_excl)
1344  	     ORDER BY object_type DESC
1345  		    , object_name
1346  	  ;
1347  	  CURSOR cur_columns( cp_schema IN VARCHAR2
1348  			    , cp_table	IN VARCHAR2
1349  			    , cp_like	IN VARCHAR2
1350  			    , cp_prefix IN VARCHAR2
1351  			    , cp_excl	IN NUMBER
1352  			    )
1353  	  IS
1354  	    SELECT result_text
1355  	      FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
1356  	  ;
1357  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1358  			   , cp_schema IN VARCHAR2
1359  			   , cp_type   IN VARCHAR2
1360  			   , cp_object IN VARCHAR2
1361  			   , cp_scope  IN VARCHAR2
1362  			   , cp_count  IN NUMBER
1363  			   , cp_show   IN NUMBER
1364  			   )
1365  	  IS
1366  	    SELECT result_text
1367  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1368  	  ;
1369  	  CURSOR cur_footer(cp_show IN NUMBER)
1370  	  IS
1371  	    SELECT result_text
1372  	      FROM TABLE(otap_generate.get_footer(cp_show))
1373  	  ;
1374  	BEGIN
1375  	  l_like       := NVL(p_like_view, '%');
1376  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1377  	  -- get test count, simulate conditions of called test generators
1378  	     WITH base AS
1379  		 (SELECT object_name
1380  		       , object_type
1381  		       , owner
1382  		    FROM dba_objects
1383  		   WHERE owner = l_schema
1384  			 -- currently supported objects
1385  		     AND object_type LIKE '%VIEW'
1386  			 -- user like condition
1387  		     AND object_name LIKE l_like ESCAPE '\'
1388  			 -- user exclude condition
1389  		     AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1390  		 )
1391  		 -- counter objects
1392  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1393  	       , cols AS
1394  		 (SELECT dbc.owner
1395  		       , dbc.table_name
1396  		       , dbc.column_name
1397  		    FROM dba_tab_columns dbc
1398  		   INNER JOIN base
1399  		      ON dbc.owner	= base.owner
1400  		     AND dbc.table_name = base.object_name
1401  			 -- user like condition
1402  		   WHERE dbc.column_name LIKE '%' ESCAPE '\'
1403  			 -- user exclude condition
1404  		     AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
1405  		 )
1406  	       , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
1407  	       , cnt AS
1408  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
1409  		   UNION ALL
1410  		  SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
1411  		 )
1412  	  SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1413  	  -- get header
1414  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'views', NULL, l_like, l_test_count, p_show_header)
1415  	  LOOP
1416  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1417  	  END LOOP;
1418  	  l_pad_par := otap_generate.get_code_prefix_len + 20;
1419  	  -- build group row
1420  	  l_statement := otap_generate.get_code_pad || '-- set test group for views';
1421  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1422  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''views'')' || otap_generate.get_code_postfix;
1423  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1424  	  -- first loop through views
1425  	  FOR rec IN cur_views(l_schema, l_like, p_excl_sysgen)
1426  	  LOOP
1427  	    l_statement := otap_generate.get_code_pad || '-- set test name for view';
1428  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1429  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''view ' || rec.view_name || ''')' || otap_generate.get_code_postfix;
1430  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1431  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_object( p_object_name => ''' || rec.view_name || '''';
1432  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1433  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_object_type => ''' || rec.object_type || '''';
1434  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1435  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1436  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1437  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1438  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1439  	    FOR colrec IN cur_columns(l_schema, rec.view_name, '%', p_title_prefix, p_excl_sysgen)
1440  	    LOOP
1441  	      PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
1442  	    END LOOP;
1443  	  END LOOP;
1444  	  FOR rec IN cur_footer(p_show_header)
1445  	  LOOP
1446  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1447  	  END LOOP;
1448  	  RETURN;
1449  	EXCEPTION
1450  	  WHEN NO_DATA_NEEDED THEN
1451  	    RAISE;
1452  	END view_tests;
