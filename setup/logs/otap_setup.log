1099  	FUNCTION generate_schema_tests( p_like_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1100  				      , p_required_user IN VARCHAR2 DEFAULT NULL
1101  				      , p_title_prefix	IN VARCHAR2 DEFAULT NULL
1102  				      , p_show_header	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1103  				      , p_excl_sysgen	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1104  				      )
1105  	  RETURN otap_view_result_tbl PIPELINED
1106  	IS
1107  	  CURSOR cur_tests( cp_like   IN VARCHAR2
1108  			  , cp_users  IN VARCHAR2
1109  			  , cp_prefix IN VARCHAR2
1110  			  , cp_show   IN NUMBER
1111  			  , cp_excl   IN NUMBER
1112  			  )
1113  	  IS
1114  	    SELECT result_text
1115  	      FROM TABLE(otap_generate.schema_tests(cp_like, cp_users, cp_prefix, cp_show, cp_excl))
1116  	  ;
1117  	BEGIN
1118  	  FOR rec IN cur_tests(p_like_schema, p_required_user, p_title_prefix, p_show_header, p_excl_sysgen)
1119  	  LOOP
1120  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1121  	  END LOOP;
1122  	  RETURN;
1123  	EXCEPTION
1124  	  WHEN NO_DATA_NEEDED THEN
1125  	    RAISE;
1126  	END generate_schema_tests;
