476  					  CASE WHEN p_otap_session.intended_count > 0 THEN ' from ' || TRIM(TO_CHAR(p_otap_session.intended_count)) END ||
477  					  ' errors: ' || TRIM(TO_CHAR(p_otap_session.error_count)) ||
