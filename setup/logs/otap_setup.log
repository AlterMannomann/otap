367  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.get_summary';
368  	 l_message VARCHAR2(4000 CHAR);
369  	 l_status  VARCHAR2(4000 CHAR);
370    BEGIN
371  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
372  	 -- execute the wrapped function in an extra block
373  	 BEGIN
374  	   l_status := CASE
375  			 WHEN p_issues > 0
376  			 THEN otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
377  			 WHEN p_errors > 0 AND p_issues <= 0
378  			 THEN otap_constants.OTAP_FALLBACK_TEXT_TEST_FAILED
379  			 ELSE otap_constants.OTAP_FALLBACK_TEXT_TEST_PASSED
380  		       END
381  	   ;
382  	   l_message := otap_report.get_summary(l_status, p_runtime, p_runs, p_errors, p_issues, p_min_fill);
383  	 EXCEPTION
384  	   WHEN OTHERS THEN
385  	     -- consume error
386  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_summary');
387  	     l_message := otap_string.reduce('Internal otap error get report summary: ' || SQLERRM, 4000);
388  	 END;
389  	 -- return or let exception happen
390  	 RETURN l_message;
391    END get_summary;
