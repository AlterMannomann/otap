660    FUNCTION test_result_to_text( p_test_passed IN NUMBER
661  				   , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
662  				   )
663  	 RETURN VARCHAR
664    IS
665  	 l_translation otap_config.config_value%TYPE;
666    BEGIN
667  	 l_translation := CASE p_test_passed
668  			    WHEN otap_constants.OTAP_NUM_TEST_PASSED
669  			    THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_PASSED, p_language_id)
670  			    WHEN otap_constants.OTAP_NUM_TEST_FAILED
671  			    THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_FAILED, p_language_id)
672  			    WHEN otap_constants.OTAP_NUM_TEST_UNDEFINED
673  			    THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_UNDEFINED, p_language_id)
674  			    ELSE otap_constants.OTAP_INTERNAL_ERROR
675  			  END
676  	 ;
677  	 RETURN l_translation;
678    EXCEPTION
679  	 WHEN OTHERS THEN
680  	   otap_log.log(SQLERRM, 'otap_util.test_result_to_text', 'Translate test state to text');
681  	   RAISE;
682    END test_result_to_text;
