SQL> DEFINE OTAP_USER="OTAP"
SQL> DEFINE OTAP_TABLESPACE="OTAP_TABLESPACE"
SQL> DEFINE OTAP_ROLE="OTAP_USER"
SQL> DEFINE ROLE_CREATOR="SYS"
SQL> 
SQL> /** PROCEDURE run_tests
SQL> * Runs test procedures and package procedures identified by the defined prefix of the current otap session record in the
SQL> * schema given by the current otap session record.
SQL> *
SQL> * Recommended usage:
SQL> * - Run otap.otap_test.init_test to set your preferences
SQL> * - Store the session id
SQL> * - Run otap.run_tests with the user and schema desired
SQL> * - Run otap.otap_test.finish_test_with_exit_code
SQL> * - Access the test result with the stored session id and do actions depending on the exit code
SQL> * Do not run init or finish within the test procedures. Also not forbidden, managing different session ids could get difficult.
SQL> *
SQL> * The following rules are applied:
SQL> * - test procedures must start with the defined prefix
SQL> * - the only allowed delimiter is underscore _
SQL> * - test procedures must NOT have any parameter, not even with default values
SQL> * - only valid test procedures are considered
SQL> * - test packages are identified by matching package procedures, if include packages is configured in the otap session record
SQL> * - the executor must have the necessary rights on the objects to test
SQL> * - if name precedence is set (default), the names of the procedures must match the naming rule
SQL> *
SQL> * Naming rules for test procedures:
SQL> * - general
SQL> *	 - name starts with the defined prefix with added _ and another name part, pattern is <prefix>_<name>, e.g. TEST_MYTEST
SQL> * - name precedence is set
SQL> *	 - pattern is <prefix>_<optional sort number>_<set name>_<group name>_<test name>, e.g. TEST_001_SET_GROUP_MYTEST
SQL> *	   or <prefix>_<set name>_<group name>_<test name>, e.g. TEST_SET_GROUP_MYTEST
SQL> *	   - optional sort number: only digits 0-9 allowed to be considered as optional sort number, otherwise interpreted as test set
SQL> *
SQL> * If name parts could not be identified, the current settings from the otap session record will be used. Everything after the
SQL> * fourth underscore _ is considered as test name. The procedure will set the names identified by procedure names using otap_test.
SQL> * As this can be overwritten by test procedures, no guarantee is given, that names match the expectation. The optional sort number
SQL> * can be used for ordering the test procedures, used order is procedure name ASC
SQL> *
SQL> * @param p_like The like expression for procedures and packages to execute. The like expression is applied after the prefix,
SQL> * e.g. using defaults results to pattern TEST\_%, where TEST is the prefix and escape char is \.
SQL> *
SQL> * @exception -20099 unhandled otap exception, procedure call exceptions will result in test errors.
SQL> */
SQL> 
SQL> create or replace PROCEDURE run_tests(p_like IN VARCHAR2 DEFAULT '%')
  2  IS
  3    l_script  VARCHAR2(1024 CHAR) := 'run_tests';
  4    l_schema  VARCHAR2(128 CHAR);
  5    l_like	 VARCHAR2(256 CHAR);
  6    l_set	 VARCHAR2(256 CHAR);
  7    l_group	 VARCHAR2(256 CHAR);
  8    l_name	 VARCHAR2(256 CHAR);
  9    l_header  VARCHAR2(10 CHAR);
 10    l_footer  VARCHAR2(10 CHAR);
 11    l_block	 VARCHAR2(4000 CHAR);
 12    l_chunk	 VARCHAR2(256 CHAR);
 13    l_return  VARCHAR2(4000 CHAR);
 14    l_chunks  NUMBER;
 15    l_start	 NUMBER;
 16    l_end	 NUMBER;
 17    l_pos	 NUMBER;
 18    l_len	 NUMBER;
 19    -- build call name (package prefix if needed and include_packages)
 20    CURSOR cur_tests_to_run( cp_schema IN VARCHAR2
 21  			      , cp_like   IN VARCHAR2
 22  			      )
 23    IS
 24  	   WITH base AS
 25  	      (SELECT dbo.owner
 26  		    , dbo.object_name
 27  		    , dbo.object_type
 28  		    , dbo.status
 29  		    , NVL(dbp.procedure_name, dbp.object_name) AS procedure_name
 30  		 FROM dba_objects dbo
 31  		 LEFT OUTER JOIN dba_procedures dbp
 32  		   ON dbp.owner        = dbo.owner
 33  		  AND dbp.object_name  = dbo.object_name
 34  		  AND dbp.object_type  = dbo.object_type
 35  		  AND dbp.is_procedure = 'YES'
 36  		WHERE dbo.owner 		= cp_schema
 37  		  AND dbo.status		= 'VALID'
 38  		  AND dbo.object_type	       IN ('PROCEDURE', 'PACKAGE')
 39  	      )
 40  	 SELECT base.owner
 41  	      , base.object_name
 42  	      , base.object_type
 43  	      , base.status
 44  	      , base.procedure_name
 45  	      , REGEXP_COUNT(base.procedure_name, '[_].') AS chunks
 46  	      , CASE
 47  		  WHEN base.object_type = 'PACKAGE'
 48  		  THEN base.owner || '.' || base.object_name || '.' || base.procedure_name
 49  		  ELSE base.owner || '.' || base.procedure_name
 50  		END AS qualified_name
 51  	   FROM base
 52  		-- ensure no parameter specified
 53  	  WHERE NOT EXISTS (SELECT 1
 54  			      FROM dba_arguments ar
 55  			     WHERE ar.position	  > 0
 56  			       AND ar.owner	  = base.owner
 57  			       AND ar.object_name = base.procedure_name
 58  			   )
 59  	    AND UPPER(base.procedure_name) LIKE cp_like ESCAPE '\'
 60  	  ORDER BY base.procedure_name ASC
 61    ;
 62  BEGIN
 63    l_schema := otap_test.get_schema;
 64    l_like	:= otap_test.get_prefix || '\' || otap_constants.OTAP_INTERNAL_DELIMITER || NVL(p_like, '%');
 65    -- build header and footer for statement block
 66    l_header := 'BEGIN' || otap_constants.OTAP_INTERNAL_LF;
 67    l_footer := otap_constants.OTAP_INTERNAL_LF || 'END;';
 68    -- loop over records found
 69    FOR rec IN cur_tests_to_run(l_schema, l_like)
 70    LOOP
 71  	 -- extract names
 72  	 IF otap_test.name_precedence
 73  	 THEN
 74  	   -- get first element, add one to start after delimiter
 75  	   l_start := INSTR(rec.procedure_name, otap_constants.OTAP_INTERNAL_DELIMITER) + 1;
 76  	   l_pos   := 1;
 77  	   -- only process max. 4 chunks
 78  	   l_chunks := LEAST(4, rec.chunks);
 79  	   FOR i IN 1..l_chunks
 80  	   LOOP
 81  	     --DBMS_OUTPUT.PUT_LINE('--------Loop Start--------');
 82  	     IF i = l_chunks
 83  	     THEN
 84  	       -- end reached
 85  	       l_end := 256;
 86  	     ELSE
 87  	       l_end := INSTR(rec.procedure_name, otap_constants.OTAP_INTERNAL_DELIMITER, l_start);
 88  	       l_len := l_end - l_start;
 89  	     END IF;
 90  	     -- get current chunk
 91  	     l_chunk := NVL(SUBSTR(rec.procedure_name, l_start, l_len), 'Undefined');
 92  	     --DBMS_OUTPUT.PUT_LINE('Chunk: ' || l_chunk);
 93  	     --DBMS_OUTPUT.PUT_LINE('Start POS: ' || l_start);
 94  	     --DBMS_OUTPUT.PUT_LINE('End POS: ' || l_end);
 95  	     --DBMS_OUTPUT.PUT_LINE('Length: ' || l_len);
 96  	     --DBMS_OUTPUT.PUT_LINE('Relative POS: ' || l_pos);
 97  	     --DBMS_OUTPUT.PUT_LINE('Iteration: ' || i);
 98  	     --DBMS_OUTPUT.PUT_LINE('Max Iteration: ' || l_chunks);
 99  	     IF i = 1 AND REGEXP_INSTR(l_chunk, '[^0123456789]') = 0
100  	     THEN
101  	       -- ignore optional order number, relative position stays 1
102  	       l_start := l_end + 1;
103  	     ELSE
104  	       -- process chunk
105  	       IF l_pos = 1
106  	       THEN
107  		 --DBMS_OUTPUT.PUT_LINE('Would execute set test set: ' || l_chunk);
108  		 l_return := otap_test.set_test_set(l_chunk);
109  	       ELSIF l_pos = 2
110  	       THEN
111  		 --DBMS_OUTPUT.PUT_LINE('Would execute set test group: ' || l_chunk);
112  		 l_return := otap_test.set_test_group(l_chunk);
113  	       ELSE
114  		 --DBMS_OUTPUT.PUT_LINE('Would execute set test name: ' || l_chunk);
115  		 l_return := otap_test.set_test_name(l_chunk);
116  	       END IF;
117  	       l_pos   := l_pos + 1;
118  	       l_start := l_end + 1;
119  	     END IF;
120  	     --DBMS_OUTPUT.PUT_LINE('--------Loop End--------');
121  	   END LOOP;
122  	 END IF;
123  	 -- decide if to consider, ignore otherwise
124  	 IF (	rec.object_type = 'PROCEDURE'
125  	     OR (    rec.object_type = 'PACKAGE'
126  		 AND otap_test.include_packages
127  		)
128  	    )
129  	 THEN
130  	   l_block := l_header || rec.qualified_name || ';' || l_footer;
131  	   -- do extra block for exception handling
132  	   BEGIN
133  	     --DBMS_OUTPUT.PUT_LINE('Would execute: ' || l_block);
134  	     EXECUTE IMMEDIATE l_block;
135  	   EXCEPTION
136  	     WHEN OTHERS THEN
137  	       l_return := otap_test.test_error('Procedure ' || rec.qualified_name || ' failed', SQLERRM);
138  	   END;
139  	 END IF;
140    END LOOP;
141  EXCEPTION
142    WHEN OTHERS THEN
143  	 IF SQLCODE != -20099
144  	 THEN
145  	   otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
146  	 END IF;
147  	 RAISE;
148  END run_tests;
149  /

