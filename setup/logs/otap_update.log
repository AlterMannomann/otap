987    FUNCTION has_sequence( p_sequence_name	IN	      VARCHAR2
988  			    , o_errors		   OUT NOCOPY VARCHAR2
989  			    , p_table_name	IN	      VARCHAR2 DEFAULT NULL
990  			    , p_column_name	IN	      VARCHAR2 DEFAULT NULL
991  			    , p_min_value	IN	      NUMBER   DEFAULT NULL
992  			    , p_max_value	IN	      NUMBER   DEFAULT NULL
993  			    , p_increment_by	IN	      NUMBER   DEFAULT NULL
994  			    , p_cycle_flag	IN	      VARCHAR2 DEFAULT NULL
995  			    , p_order_flag	IN	      VARCHAR2 DEFAULT NULL
996  			    , p_cache_size	IN	      NUMBER   DEFAULT NULL
997  			    , p_scale_flag	IN	      VARCHAR2 DEFAULT NULL
998  			    , p_extend_flag	IN	      VARCHAR2 DEFAULT NULL
999  			    , p_sharded_flag	IN	      VARCHAR2 DEFAULT NULL
1000  			     , p_session_flag	 IN	       VARCHAR2 DEFAULT NULL
1001  			     , p_keep_value	 IN	       VARCHAR2 DEFAULT NULL
1002  			     , p_table_owner	 IN	       VARCHAR2 DEFAULT NULL
1003  			     , p_schema 	 IN	       VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1004  			     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1005  			     )
1006  	  RETURN INTEGER
1007  	IS
1008  	  l_script	    VARCHAR2(1024 CHAR)    := 'otap_schema.has_sequence';
1009  	  l_test_passed     INTEGER;
1010  	  l_expected	    INTEGER;
1011  	  l_has_sequence    INTEGER;
1012  	  l_sequence_name   VARCHAR2(128 CHAR);
1013  	  l_table_name	    VARCHAR2(128 CHAR);
1014  	  l_column_name     VARCHAR2(128 CHAR);
1015  	  l_table_owner     VARCHAR2(128 CHAR);
1016  	  l_cycle_flag	    VARCHAR2(1 CHAR);
1017  	  l_order_flag	    VARCHAR2(1 CHAR);
1018  	  l_scale_flag	    VARCHAR2(1 CHAR);
1019  	  l_extend_flag     VARCHAR2(1 CHAR);
1020  	  l_sharded_flag    VARCHAR2(1 CHAR);
1021  	  l_session_flag    VARCHAR2(1 CHAR);
1022  	  l_keep_value	    VARCHAR2(1 CHAR);
1023  	  l_schema_to_use   VARCHAR2(128 CHAR);
1024  	  l_errors	    VARCHAR2(32767 CHAR);
1025  	BEGIN
1026  	  l_errors	    := NULL;
1027  	  l_test_passed     := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1028  	  l_expected	    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
1029  	  l_sequence_name   := otap_string.reduce(p_sequence_name, 128);
1030  	  l_table_name	    := otap_string.reduce(p_table_name, 128);
1031  	  l_column_name     := otap_string.reduce(p_column_name, 128);
1032  	  l_table_owner     := otap_string.reduce(p_table_owner, 128);
1033  	  l_cycle_flag	    := otap_string.reduce(UPPER(p_cycle_flag), 1);
1034  	  l_order_flag	    := otap_string.reduce(UPPER(p_order_flag), 1);
1035  	  l_scale_flag	    := otap_string.reduce(UPPER(p_scale_flag), 1);
1036  	  l_extend_flag     := otap_string.reduce(UPPER(p_extend_flag), 1);
1037  	  l_sharded_flag    := otap_string.reduce(UPPER(p_sharded_flag), 1);
1038  	  l_session_flag    := otap_string.reduce(UPPER(p_session_flag), 1);
1039  	  l_keep_value	    := otap_string.reduce(UPPER(p_keep_value), 1);
1040  	  IF	(    l_sequence_name	    IS NOT NULL
1041  		 AND LENGTH(l_sequence_name) > 0
1042  		)
1043  	     OR (    l_table_name	  IS NOT NULL
1044  		 AND LENGTH(l_table_name)  > 0
1045  		 AND l_column_name	  IS NOT NULL
1046  		 AND LENGTH(l_column_name) > 0
1047  		)
1048  	  THEN
1049  	    -- schema
1050  	    l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
1051  	    -- check
1052  	    SELECT COUNT(*)
1053  	      INTO l_has_sequence
1054  	      FROM dba_sequences dbs
1055  	      LEFT OUTER JOIN dba_tab_identity_cols dti
1056  		ON dbs.sequence_name  = dti.sequence_name
1057  	       AND dti.owner = NVL(l_table_owner, l_schema_to_use)
1058  	     WHERE dbs.sequence_owner = l_schema_to_use
1059  	       AND dbs.sequence_name  = NVL(l_sequence_name, dbs.sequence_name)
1060  	       AND NVL(dti.table_name, 'n/a')	= NVL(l_table_name, NVL(dti.table_name, 'n/a'))
1061  	       AND NVL(dti.column_name, 'n/a')	= NVL(l_column_name, NVL(dti.column_name, 'n/a'))
1062  	       AND NVL(cycle_flag, 'n/a')	= NVL(l_cycle_flag, NVL(cycle_flag, 'n/a'))
1063  	       AND NVL(order_flag, 'n/a')	= NVL(l_order_flag, NVL(order_flag, 'n/a'))
1064  	       AND NVL(scale_flag, 'n/a')	= NVL(l_scale_flag, NVL(scale_flag, 'n/a'))
1065  	       AND NVL(extend_flag, 'n/a')	= NVL(l_extend_flag, NVL(extend_flag, 'n/a'))
1066  	       AND NVL(sharded_flag, 'n/a')	= NVL(l_sharded_flag, NVL(sharded_flag, 'n/a'))
1067  	       AND NVL(session_flag, 'n/a')	= NVL(l_session_flag, NVL(session_flag, 'n/a'))
1068  	       AND NVL(keep_value, 'n/a')	= NVL(l_keep_value, NVL(keep_value, 'n/a'))
1069  	    ;
1070  	    -- we should find one or zero entries
1071  	    l_test_passed := count_chk(l_has_sequence, l_errors, l_script);
1072  	  ELSE
1073  	    -- either sequence name or table and column name must be
1074  	    l_test_passed	:= otap_constants.OTAP_NUM_TEST_UNDEFINED;
1075  	    l_errors		:= 'Not allowed: p_sequence_name and (p_table_name or p_column_name) NULL';
1076  	    otap_log.log(l_errors, l_script, 'Sequence name and table or column name is NULL');
1077  	  END IF;
1078  	  -- now decide on the expected result the final state and if errors are returned
1079  	  IF l_test_passed != l_expected
1080  	  THEN
1081  	    o_errors := otap_string.reduce(l_errors, 4000);
1082  	  ELSE
1083  	    -- overwrite states from before, as we fulfill expected
1084  	    l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
1085  	    -- overwrite errors expected
1086  	    o_errors := NULL;
1087  	  END IF;
1088  	  RETURN l_test_passed;
1089  	EXCEPTION
1090  	  WHEN OTHERS THEN
1091  	    IF SQLCODE != -20099
1092  	    THEN
1093  	      -- log unhandled exceptions
1094  	      otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
1095  	    END IF;
1096  	    RAISE;
1097  	END has_sequence;
