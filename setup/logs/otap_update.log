1235  	  l_default_tablespace	  := otap_string.reduce(p_default_tablespace, 30);
1236  	  l_temporary_tablespace  := otap_string.reduce(p_temporary_tablespace, 30);
1237  	  l_local_temp_tablespace := otap_string.reduce(p_local_temp_tablespace, 30);
