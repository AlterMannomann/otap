1118  	  l_job_name	    VARCHAR2(128 CHAR);
1119  	  l_job_style	    VARCHAR2(17 CHAR);
1120  	  l_job_type	    VARCHAR2(16 CHAR);
1121  	  l_job_action	    VARCHAR2(4000 CHAR);
1122  	  l_schedule_type   VARCHAR2(12 CHAR);
1123  	  l_repeat_interval VARCHAR2(4000 CHAR);
1124  	  l_job_class	    VARCHAR2(128 CHAR);
1125  	  l_logging_level   VARCHAR2(11 CHAR);
1126  	  l_store_output    VARCHAR2(5 CHAR);
1127  	  l_schema_to_use   VARCHAR2(128 CHAR);
1128  	  l_errors	    VARCHAR2(32767 CHAR);
1129  	BEGIN
1130  	  l_errors	    := NULL;
1131  	  l_test_passed     := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1132  	  l_expected	    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
1133  	  l_job_name	    := otap_string.reduce(p_job_name, 128);
1134  	  l_job_style	    := otap_string.reduce(UPPER(p_job_style), 17);
1135  	  l_job_type	    := otap_string.reduce(UPPER(p_job_type), 16);
1136  	  l_job_action	    := otap_string.reduce(otap_string.flatten(UPPER(p_job_action), 4000), 4000);
1137  	  l_schedule_type   := otap_string.reduce(UPPER(p_schedule_type), 12);
1138  	  l_repeat_interval := otap_string.reduce(UPPER(p_repeat_interval), 4000);
1139  	  l_job_class	    := otap_string.reduce(UPPER(p_job_class), 128);
1140  	  l_logging_level   := otap_string.reduce(UPPER(p_logging_level), 11);
1141  	  l_store_output    := otap_string.reduce(UPPER(p_store_output), 5);
1142  	  IF	 l_job_name	   IS NOT NULL
1143  	     AND LENGTH(l_job_name) > 0
1144  	  THEN
1145  	    -- schema
1146  	    l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
1147  	    -- check
1148  	    SELECT COUNT(*)
1149  	      INTO l_has_job
1150  	      FROM dba_scheduler_jobs
1151  	     WHERE owner				    = l_schema_to_use
1152  	       AND job_name				    = l_job_name
1153  	       AND NVL(job_style, 'n/a')		    = NVL(l_job_style, NVL(job_style, 'n/a'))
1154  	       AND NVL(job_type, 'n/a') 		    = NVL(l_job_type, NVL(job_type, 'n/a'))
1155  	       AND NVL( otap_string.reduce( otap_string.flatten( UPPER(job_action)
1156  							       , 4000
1157  							       )
1158  					  , 4000
1159  					  )
1160  		      , 'n/a'
1161  		      ) 				    = NVL(l_job_action, NVL(otap_string.reduce(otap_string.flatten(UPPER(job_action), 4000), 4000), 'n/a'))
1162  	       AND NVL(schedule_type, 'n/a')		    = NVL(l_schedule_type, NVL(schedule_type, 'n/a'))
1163  	       AND NVL(TRIM(UPPER(repeat_interval)), 'n/a') = NVL(l_repeat_interval, NVL(TRIM(UPPER(repeat_interval)), 'n/a'))
1164  	       AND NVL(job_class, 'n/a')		    = NVL(l_job_class, NVL(job_class, 'n/a'))
1165  	       AND NVL(logging_level, 'n/a')		    = NVL(l_logging_level, NVL(logging_level, 'n/a'))
1166  	       AND NVL(store_output, 'n/a')		    = NVL(l_store_output, NVL(store_output, 'n/a'))
1167  	    ;
1168  	    -- we should find one or zero entries
1169  	    l_test_passed := count_chk(l_has_job, l_errors, l_script);
1170  	  ELSE
1171  	    -- job name must be set
1172  	    l_test_passed	:= otap_constants.OTAP_NUM_TEST_UNDEFINED;
1173  	    l_errors		:= 'Not allowed: p_job_name(NULL)';
1174  	    otap_log.log(l_errors, l_script, 'Scheduler job name is NULL');
1175  	  END IF;
1176  	  -- now decide on the expected result the final state and if errors are returned
1177  	  IF l_test_passed != l_expected
1178  	  THEN
1179  	    o_errors := otap_string.reduce(l_errors, 4000);
1180  	  ELSE
1181  	    -- overwrite states from before, as we fulfill expected
1182  	    l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
1183  	    -- overwrite errors expected
1184  	    o_errors := NULL;
1185  	  END IF;
1186  	  RETURN l_test_passed;
1187  	EXCEPTION
1188  	  WHEN OTHERS THEN
1189  	    IF SQLCODE != -20099
1190  	    THEN
1191  	      -- log unhandled exceptions
1192  	      otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
1193  	    END IF;
1194  	    RAISE;
1195  	END has_scheduler_job;
