327    /** FUNCTION otap_test.has_column
328    * Tests if a table column exists. Additional tests on the column can be added by using the additional
329    * parameters with default NULL. The expected values have to match the content of DBA_TAB_COLUMNS for the given table,
330    * column and schema.
331    *
332    * If checking defaults, it is limited to defaults not longer than 4000 char, using the DATA_DEFAULT_VC column. Expressions
333    * must match all chars in the default, like quotation. Use q-syntax where possible to define correct strings, e.g.
334    * SELECT q'[SYS_CONTEXT('USERENV', 'OS_USER')]' FROM dual;
335    *
336    * @param p_table_name The name of the table, taken as is. Case sensitive.
337    * @param p_column_name The column name of the table, taken as is. Case sensitive.
338    * @param p_schema A schema override of the current test session if needed, taken as is. If given the table and column must exist in this schema. Case sensitive.
339    * @param p_description The test description if any. If not given, a description is generated, see template.
340    * @param p_data_type Optional check the datatype of the column. Ignored if NULL. NOT case sensitive.
341    * @param p_data_length Optional check the data length of the column. Ignored if NULL.
342    * @param p_data_precision Optional check the data precision of the column. Ignored if NULL. Results in test error if datatype is not NUMBER.
343    * @param p_data_scale Optional check the data scale of the column. Ignored if NULL. Results in test error if datatype is not NUMBER or TIMESTAMP.
344    * @param p_nullable Optional check if the column is nullable. Ignored if NULL. NOT case sensitive.
345    * @param p_data_default Optional check the default for the column. Ignored if NULL. Must match all chars, including ' and ". Limited to defaults shorter than 4000 chars.
346    * @param p_expected_result The expected test result, 1 (Passed), -1 (FAILED), 0 (UNDEFINED). Default is 1 (Passed).
347    *
348    * @return The test result as text.
349    */
350    FUNCTION has_column( p_table_name      IN VARCHAR2
351  			  , p_column_name     IN VARCHAR2
352  			  , p_schema	      IN VARCHAR2 DEFAULT NULL
353  			  , p_description     IN VARCHAR2 DEFAULT NULL
354  			  , p_data_type       IN VARCHAR2 DEFAULT NULL
355  			  , p_data_length     IN NUMBER   DEFAULT NULL
356  			  , p_data_precision  IN NUMBER   DEFAULT NULL
357  			  , p_data_scale      IN NUMBER   DEFAULT NULL
358  			  , p_nullable	      IN VARCHAR2 DEFAULT NULL
359  			  , p_data_default    IN VARCHAR2 DEFAULT NULL
360  			  , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
361  			  )
362  	 RETURN VARCHAR2
363    ;
