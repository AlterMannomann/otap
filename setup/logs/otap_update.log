2652  			    , cp_schema IN VARCHAR2
2653  			    , cp_prefix IN VARCHAR2
2654  			    , cp_excl	IN NUMBER
2655  			    )
2656  	  IS
2657  	    SELECT result_text
2658  	      FROM TABLE(otap_generate.trigger_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2659  	  ;
2660  	  CURSOR cur_packages( cp_like	 IN VARCHAR2
2661  			     , cp_schema IN VARCHAR2
2662  			     , cp_prefix IN VARCHAR2
2663  			     , cp_excl	 IN NUMBER
2664  			     )
2665  	  IS
2666  	    SELECT result_text
2667  	      FROM TABLE(otap_generate.package_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2668  	  ;
2669  	  CURSOR cur_views( cp_like   IN VARCHAR2
2670  			  , cp_schema IN VARCHAR2
2671  			  , cp_prefix IN VARCHAR2
2672  			  , cp_excl   IN NUMBER
2673  			  )
2674  	  IS
2675  	    SELECT result_text
2676  	      FROM TABLE(otap_generate.view_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2677  	  ;
2678  	  CURSOR cur_types( cp_like   IN VARCHAR2
2679  			  , cp_schema IN VARCHAR2
2680  			  , cp_prefix IN VARCHAR2
2681  			  , cp_excl   IN NUMBER
2682  			  )
2683  	  IS
2684  	    SELECT result_text
2685  	      FROM TABLE(otap_generate.type_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2686  	  ;
2687  	  CURSOR cur_sequences( cp_like   IN VARCHAR2
2688  			      , cp_schema IN VARCHAR2
2689  			      , cp_prefix IN VARCHAR2
2690  			      , cp_excl   IN NUMBER
2691  			      )
2692  	  IS
2693  	    SELECT result_text
2694  	      FROM TABLE(otap_generate.sequence_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2695  	  ;
2696  	  CURSOR cur_jobs( cp_like   IN VARCHAR2
2697  			 , cp_schema IN VARCHAR2
2698  			 , cp_prefix IN VARCHAR2
2699  			 , cp_excl   IN NUMBER
2700  			 )
2701  	  IS
2702  	    SELECT result_text
2703  	      FROM TABLE(otap_generate.sched_job_tests(cp_like, cp_schema, p_title_prefix, 0, cp_excl))
2704  	  ;
2705  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2706  			   , cp_schema IN VARCHAR2
2707  			   , cp_type   IN VARCHAR2
2708  			   , cp_object IN VARCHAR2
2709  			   , cp_scope  IN VARCHAR2
2710  			   , cp_count  IN NUMBER
2711  			   , cp_show   IN NUMBER
2712  			   )
2713  	  IS
2714  	    SELECT result_text
2715  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2716  	  ;
2717  	  CURSOR cur_footer(cp_show IN NUMBER)
2718  	  IS
2719  	    SELECT result_text
2720  	      FROM TABLE(otap_generate.get_footer(cp_show))
2721  	  ;
2722  	  CURSOR cur_test_count( cp_excl_sysgen IN NUMBER
2723  			       , cp_like	IN VARCHAR2
2724  			       , cp_usr_cnt	IN NUMBER
2725  			       )
2726  	  IS
2727  	     WITH base AS
2728  		 (SELECT object_name
2729  		       , object_type
2730  		       , owner
2731  		    FROM dba_objects
2732  			 -- user like condition
2733  		   WHERE owner LIKE cp_like ESCAPE '\'
2734  			 -- currently supported objects
2735  		     AND (   object_type   IN ('TABLE', 'FUNCTION', 'PROCEDURE')
2736  			  OR object_type LIKE '%VIEW'
2737  			  OR object_type LIKE 'PACKAGE%'
2738  			 )
2739  			 -- user exclude condition
2740  		     AND NOT otap_string.is_sys_object(object_name, cp_excl_sysgen)
2741  		 )
2742  		 -- counter objects
2743  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
2744  		 -- depending procedures
2745  	       , prc AS
2746  		 (SELECT dbp.procedure_name
2747  		       , dbp.object_name
2748  		       , dbp.object_type
2749  		    FROM dba_procedures dbp
2750  		   INNER JOIN base
2751  		      ON dbp.object_name = base.object_name
2752  		     AND dbp.object_type = base.object_type
2753  		     AND dbp.owner	 = base.owner
2754  			 -- exclude pure functions and procedures, already counted by base
2755  		     AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
2756  			 -- user exclude condition
2757  		   WHERE NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl_sysgen)
2758  		 )
2759  	       , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
2760  	       , cols AS
2761  		 (SELECT dbc.owner
2762  		       , dbc.table_name
2763  		       , dbc.column_name
2764  		    FROM dba_tab_columns dbc
2765  		   INNER JOIN base
2766  		      ON dbc.owner	= base.owner
2767  		     AND dbc.table_name = base.object_name
2768  			 -- user exclude condition
2769  		   WHERE NOT otap_string.is_sys_object(dbc.column_name, cp_excl_sysgen)
2770  		 )
2771  	       , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
2772  		 -- table triggers
2773  	       , trgt AS
2774  		 (SELECT dbt.owner
2775  		       , dbt.trigger_name
2776  		       , dbt.table_owner
2777  		    FROM dba_triggers dbt
2778  		   INNER JOIN base
2779  		      ON dbt.table_owner      = base.owner
2780  		     AND dbt.table_name       = base.object_name
2781  		     AND dbt.base_object_type = base.object_type
2782  		   WHERE dbt.table_name     IS NOT NULL
2783  			 -- user exclude condition
2784  		     AND NOT otap_string.is_sys_object(dbt.trigger_name, cp_excl_sysgen)
2785  		 )
2786  	       , cnt_trgt AS (SELECT COUNT(*) AS expected_count FROM trgt)
2787  	       , trgs AS
2788  		 (SELECT dbt.owner
2789  		       , dbt.trigger_name
2790  		       , dbt.table_owner
2791  		    FROM dba_triggers dbt
2792  		   INNER JOIN base
2793  		      ON dbt.owner = base.owner
2794  		   WHERE dbt.table_name     IS NULL
2795  			 -- user exclude condition
2796  		     AND NOT otap_string.is_sys_object(dbt.trigger_name, cp_excl_sysgen)
2797  		 )
2798  	       , cnt_trgs AS (SELECT COUNT(*) AS expected_count FROM trgs)
2799  	       , cnt_schemas AS (SELECT COUNT(*) AS expected_count FROM dba_users WHERE username LIKE cp_like ESCAPE '\')
2800  	       , cnt_types AS (SELECT COUNT(*) AS expected_count
2801  				 FROM dba_objects dbo
2802  				 LEFT OUTER JOIN dba_types dbt
2803  				   ON dbo.owner = dbt.owner
2804  				  AND dbo.object_name = dbt.type_name
2805  				WHERE dbo.owner       LIKE cp_like ESCAPE '\'
2806  				  AND dbo.object_type	 = 'TYPE'
2807  				  AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl_sysgen)
2808  			      )
2809  	       , cnt_sequences AS (SELECT COUNT(*) AS expected_count
2810  				     FROM dba_sequences dbs
2811  				     LEFT OUTER JOIN dba_tab_identity_cols dti
2812  				       ON dbs.sequence_name  = dti.sequence_name
2813  				    WHERE dbs.sequence_owner LIKE cp_like ESCAPE '\'
2814  				  )
2815  	       , cnt_sched_jobs AS (SELECT COUNT(*) AS expected_count
2816  				      FROM dba_scheduler_jobs
2817  				     WHERE owner    LIKE cp_like ESCAPE '\'
2818  				       AND NOT otap_string.is_sys_object(job_name, cp_excl_sysgen)
2819  				   )
2820  	       , cnt AS
2821  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
2822  		   UNION ALL
2823  		  SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
2824  		   UNION ALL
2825  		  SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
2826  		   UNION ALL
2827  		  SELECT expected_count, 'TABLE TRIGGER' AS info FROM cnt_trgt
2828  		   UNION ALL
2829  		  SELECT expected_count, 'SCHEMA TRIGGER' AS info FROM cnt_trgs
2830  		   UNION ALL
2831  		  SELECT expected_count, 'SCHEMAS' AS info FROM cnt_schemas
2832  		   UNION ALL
2833  		  SELECT expected_count, 'TYPES' AS info FROM cnt_types
2834  		   UNION ALL
2835  		  SELECT expected_count, 'SEQUENCES' AS info FROM cnt_sequences
2836  		   UNION ALL
2837  		  SELECT expected_count, 'SCHEDULER JOBS' AS info FROM cnt_sched_jobs
2838  		   UNION ALL
2839  		  SELECT cp_usr_cnt AS expected_count, 'USER TESTS' AS info FROM dual
2840  		 )
2841  	  SELECT SUM(expected_count) AS test_count
2842  	  FROM cnt
2843  	  ;
2844  	BEGIN
2845  	  l_like       := NVL(p_like_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'));
2846  	  l_schema     := otap_string.reduce(SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'), 128);
2847  	  -- get test count, simulate conditions of called test generators
2848  	  OPEN cur_user_cnt(p_required_user);
2849  	  FETCH cur_user_cnt INTO l_user_count;
2850  	  CLOSE cur_user_cnt;
2851  	  OPEN cur_test_count(p_excl_sysgen, p_like_schema, l_user_count);
2852  	  FETCH cur_test_count INTO l_test_count;
2853  	  CLOSE cur_test_count;
2854  	  -- get header
2855  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'schemas', NULL, l_like, l_test_count, p_show_header)
2856  	  LOOP
2857  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2858  	  END LOOP;
2859  	  -- get related users if any
2860  	  IF l_user_count > 0
2861  	  THEN
2862  	    -- build test set
2863  	    l_statement := otap_generate.get_code_pad || '-- set test set for schema';
2864  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2865  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_set(''Required users'')' || otap_generate.get_code_postfix;
2866  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2867  	    FOR rec IN cur_related_users(p_required_user, p_title_prefix)
2868  	    LOOP
2869  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2870  	    END LOOP;
2871  	  END IF;
2872  	  -- get schemas to process
2873  	  l_pad_par := otap_generate.get_code_prefix_len + 20;
2874  	  FOR recset IN cur_schemas(l_like, p_excl_sysgen)
2875  	  LOOP
2876  	    -- build set row
2877  	    l_statement := otap_generate.get_code_pad || '-- set test set for schema';
2878  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2879  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_set(''schema ' || recset.username || ''')' || otap_generate.get_code_postfix;
2880  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2881  	    -- first get the schema check
2882  	    FOR rec IN cur_schema_user(recset.username, p_title_prefix)
2883  	    LOOP
2884  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2885  	    END LOOP;
2886  	    -- now get the schema objects
2887  	    FOR rec IN cur_tables('%', recset.username, p_title_prefix, p_excl_sysgen)
2888  	    LOOP
2889  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2890  	    END LOOP;
2891  	    FOR rec IN cur_trigger('%', recset.username, p_title_prefix, p_excl_sysgen)
2892  	    LOOP
2893  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2894  	    END LOOP;
2895  	    FOR rec IN cur_packages('%', recset.username, p_title_prefix, p_excl_sysgen)
2896  	    LOOP
2897  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2898  	    END LOOP;
2899  	    FOR rec IN cur_views('%', recset.username, p_title_prefix, p_excl_sysgen)
2900  	    LOOP
2901  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2902  	    END LOOP;
2903  	    -- set group name for types and other not specialy treated objects
2904  	    l_statement := otap_generate.get_code_pad || '-- set test group for remaining object';
2905  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2906  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''other objects'')' || otap_generate.get_code_postfix;
2907  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2908  	    FOR rec IN cur_types('%', recset.username, p_title_prefix, p_excl_sysgen)
2909  	    LOOP
2910  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2911  	    END LOOP;
2912  	    FOR rec IN cur_sequences('%', recset.username, p_title_prefix, p_excl_sysgen)
2913  	    LOOP
2914  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2915  	    END LOOP;
2916  	    FOR rec IN cur_jobs('%', recset.username, p_title_prefix, p_excl_sysgen)
2917  	    LOOP
2918  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2919  	    END LOOP;
2920  	  END LOOP;
2921  	  FOR rec IN cur_footer(p_show_header)
2922  	  LOOP
2923  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2924  	  END LOOP;
2925  	  RETURN;
2926  	EXCEPTION
2927  	  WHEN NO_DATA_NEEDED THEN
2928  	    RAISE;
2929  	END schema_tests;
