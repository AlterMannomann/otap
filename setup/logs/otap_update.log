121    *
122    * @param p_decoration A single decoration char. Only the first char is considered if string length > 1.
123    *
124    * @return The given decoration char or the default value.
125    */
126    FUNCTION check_decoration(p_decoration IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR)
127  	 RETURN VARCHAR2
