419    FUNCTION get_config_value( p_config_name IN VARCHAR2
420  				, p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
421  				)
422  	 RETURN VARCHAR2
423    IS
424  	 l_script      VARCHAR2(1024 CHAR)	      := 'otap_util.get_config_value';
425  	 l_return      otap_config.config_value%TYPE;
426  	 l_has_config  INTEGER;
427  	 l_has_label   INTEGER;
428  	 l_label_col   VARCHAR2(1 CHAR);
429  	 l_language    VARCHAR2(3);
430    BEGIN
431  	 l_return := otap_constants.OTAP_INTERNAL_ERROR;
432  	 SELECT COUNT(*)
433  	   INTO l_has_config
434  	   FROM otap_identifiers_v
435  	  WHERE otap_identifier = UPPER(p_config_name)
436  	    AND language_id	= UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA))
437  	 ;
438  	 -- we need a fallback if given language does not match
439  	 IF l_has_config = 0
440  	 THEN
441  	   SELECT COUNT(*)
442  	     INTO l_has_config
443  	     FROM otap_identifiers_v
444  	   WHERE otap_identifier = UPPER(p_config_name)
445  	     AND language_id	 = otap_constants.OTAP_INTERNAL_NA
446  	   ;
447  	   l_language := otap_constants.OTAP_INTERNAL_NA;
448  	 ELSE
449  	   l_language := UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA));
450  	 END IF;
451  	 SELECT COUNT(*)
452  	   INTO l_has_label
453  	   FROM otap_config
454  	  WHERE config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
455  	 ;
456  	 IF l_has_label = 1
457  	 THEN
458  	   SELECT config_value
459  	     INTO l_label_col
460  	     FROM otap_config
461  	    WHERE config_name = otap_util.CFG_DEFAULT_LABEL_COLUMN
462  	   ;
463  	   l_label_col := NVL(l_label_col, otap_constants.OTAP_LABEL_LOWER);
464  	 ELSE
465  	   l_label_col := otap_constants.OTAP_LABEL_LOWER;
466  	 END IF;
467  	 IF l_has_config = 1
468  	 THEN
469  	   SELECT CASE l_label_col
470  		    WHEN otap_constants.OTAP_LABEL_LOWER
471  		    THEN label_text_lower
472  		    WHEN otap_constants.OTAP_LABEL_INIT_CAP
473  		    THEN label_text_cap
474  		    WHEN otap_constants.OTAP_LABEL_UPPER
475  		    THEN label_text_upper
476  		    ELSE label_text_lower
477  		  END
478  	     INTO l_return
479  	     FROM otap_identifiers_v
480  	    WHERE otap_identifier = UPPER(p_config_name)
481  	      AND language_id	  = l_language
482  	   ;
483  	 ELSE
484  	   l_return := otap_constants.OTAP_INTERNAL_ERROR;
485  	   otap_log.log('Invalid config_name: ' || UPPER(p_config_name) || ' return error identifier. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name)');
486  	 END IF;
487  	 RETURN l_return;
488    EXCEPTION
489  	 WHEN OTHERS THEN
490  	   otap_log.log(SQLERRM, l_script, 'SELECT config_value INTO l_return FROM otap_config WHERE config_name = UPPER(p_config_name) AND language_id = UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA))');
491  	   RAISE;
492    END get_config_value;
493  
494    PROCEDURE set_config_value( p_config_name  IN VARCHAR2
495  				 , p_config_value IN VARCHAR2
496  				 )
497    IS
498  	 PRAGMA AUTONOMOUS_TRANSACTION;
499  	 l_script      VARCHAR2(1024 CHAR)	      := 'otap_util.set_config_value';
500  	 l_exists      INTEGER;
501    BEGIN
502  	 SELECT COUNT(*)
503  	   INTO l_exists
504  	   FROM otap_config
505  	  WHERE config_name  = p_config_name
506  	    AND translatable = otap_constants.OTAP_NUM_FALSE
507  	 ;
508  	 IF l_exists = 1
509  	 THEN
510  	   UPDATE otap_config
511  	      SET config_value = p_config_value
512  	    WHERE config_name  = p_config_name
513  	   ;
514  	   COMMIT;
515  	 ELSE
516  	   otap_log.log('-20007 The given config_name ' || p_config_name || ' does not exist or is translatable.', l_script);
517  	   RAISE_APPLICATION_ERROR(-20007, 'The given config_name ' || p_config_name || ' does not exist or is translatable.');
518  	 END IF;
519    -- do not catch exceptions, pass them to caller as happening
520    END set_config_value;
521  
522    FUNCTION get_config_number(p_config_name IN VARCHAR2)
523  	 RETURN NUMBER
524    IS
525  	 l_script      VARCHAR2(1024 CHAR)	       := 'otap_util.get_config_number';
526  	 l_varchar     otap_config.config_value%TYPE;
527  	 l_return      INTEGER; -- only integer in configuration
528  	 l_has_config  INTEGER;
529    BEGIN
530  	 l_return := NULL;
531  	 SELECT COUNT(*)
532  	   INTO l_has_config
533  	   FROM otap_config
534  	  WHERE config_name = UPPER(p_config_name)
535  	    AND config_type = 'NUMBER'
536  	 ;
537  	 IF l_has_config = 1
538  	 THEN
539  	   l_varchar := otap_util.get_config_value(p_config_name);
540  	   IF otap_util.is_integer(l_varchar)
541  	   THEN
542  	     l_return := TO_NUMBER(l_varchar);
543  	   ELSE
544  	     l_return := NULL;
545  	     otap_log.log('Invalid numeric value for config_name: ' || UPPER(p_config_name) || ' return NULL. Value: ' || l_varchar, l_script, 'otap_util.is_integer(l_varchar)');
546  	   END IF;
547  	 ELSE
548  	   l_return := NULL;
549  	   otap_log.log('Invalid numeric config_name: ' || UPPER(p_config_name) || ' return NULL. Count result: ' || l_has_config, l_script, 'SELECT COUNT(*) INTO l_has_config FROM otap_config WHERE config_name = UPPER(p_config_name) AND config_type = ''NUMBER''');
550  	 END IF;
551  	 RETURN l_return;
552    EXCEPTION
553  	 WHEN OTHERS THEN
554  	   otap_log.log(SQLERRM, l_script);
555  	   RAISE;
556    END get_config_number;
