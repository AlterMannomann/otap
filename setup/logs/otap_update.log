669    FUNCTION otap_session_finish(o_otap_session IN OUT NOCOPY OTAP_SESSION)
670  	 RETURN VARCHAR2
671    IS
672  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_finish';
673  	 l_message VARCHAR2(4000 CHAR);
674    BEGIN
675  	 -- object gets verified by summary for old session
676  	 l_message := otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_INTERNAL_LF;
677  	 -- reset values
678  	 o_otap_session.test_count     := 0;
679  	 o_otap_session.error_count    := 0;
680  	 o_otap_session.intended_count := 0;
681  	 o_otap_session.test_set       := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET;
682  	 o_otap_session.test_group     := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP;
683  	 o_otap_session.test_name      := otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME;
684  	 o_otap_session.session_start  := SYSDATE;
685  	 o_otap_session.session_id     := otap_test_session_seq.NEXTVAL;
686  	 -- do not update the session_view_id so it will keep the old or any set value
687  	 -- every init will set the session_view_id to the current session id
688  	 l_message := l_message || otap_objects.otap_session_show(o_otap_session);
689  	 RETURN l_message;
690    EXCEPTION
691  	 WHEN OTHERS THEN
692  	   IF SQLCODE != -20099
693  	   THEN
694  	     -- log unhandled exceptions
695  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
696  	   END IF;
697  	   RAISE;
698    END otap_session_finish;
