558    FUNCTION get_label_id(p_object_type IN VARCHAR2)
559  	 RETURN VARCHAR2
560    IS
561  	 l_script VARCHAR2(1024 CHAR) := 'otap_util.get_label_id';
562  	 l_return VARCHAR2(256 CHAR);
563  	 l_count  INTEGER;
564    BEGIN
565  	 SELECT COUNT(*)
566  	   INTO l_count
567  	   FROM otap_labels_mv
568  	  WHERE otap_label_source = UPPER(p_object_type)
569  	 ;
570  	 IF l_count = 1
571  	 THEN
572  	   SELECT otap_string.reduce(otap_identifier, 256)
573  	     INTO l_return
574  	     FROM otap_labels_mv
575  	    WHERE otap_label_source = UPPER(p_object_type)
576  	   ;
577  	 ELSE
578  	   otap_log.log('Invalid object type: ' || p_object_type, l_script);
579  	   l_return := otap_util.CFG_LABEL_UNDEFINED;
580  	 END IF;
581  	 RETURN l_return;
582    EXCEPTION
583  	 WHEN OTHERS THEN
584  	   otap_log.log(SQLERRM, l_script);
585  	   RAISE;
586    END get_label_id;
