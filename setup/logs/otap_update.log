111    FUNCTION get_report_total_details( p_sets	 IN INTEGER  DEFAULT 0
112  					, p_groups	 IN INTEGER  DEFAULT 0
113  					, p_names	 IN INTEGER  DEFAULT 0
114  					, p_descriptions IN INTEGER  DEFAULT 0
115  					, p_min_fill	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
116  					, p_language_id  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
117  					)
118  	 RETURN VARCHAR2
119    IS
120  	 l_return_text	 VARCHAR2(32767 CHAR);
121  	 l_template_text VARCHAR2(32767 CHAR);
122    BEGIN
123  	 -- fetch template: 'sets: @sets@ groups: @groups@ names: @names@ descriptions: @descs@'
124  	 l_template_text := otap_util.get_config_value(otap_util.CFG_TEMPLATE_REPORT_TOTAL);
125  	 -- replace variables
126  	 l_template_text := REPLACE(l_template_text, '@sets@', TRIM(TO_CHAR(NVL(p_sets, 0))));
127  	 l_template_text := REPLACE(l_template_text, '@groups@', TRIM(TO_CHAR(NVL(p_groups, 0))));
128  	 l_template_text := REPLACE(l_template_text, '@names@', TRIM(TO_CHAR(NVL(p_names, 0))));
129  	 l_template_text := REPLACE(l_template_text, '@descs@', TRIM(TO_CHAR(NVL(p_descriptions, 0))));
130  	 -- get borderless
131  	 l_return_text := otap_report.borderless( l_template_text
132  						, GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), NVL(LENGTH(l_template_text), 0), otap_util.get_length_headers(p_language_id))
133  						, p_language_id
134  						)
135  	 ;
136  	 RETURN l_return_text;
137    EXCEPTION
138  	 WHEN OTHERS THEN
139  	   otap_log.log(SQLERRM, 'otap_report.get_report_total_details', 'Report totals template replacement');
140  	   RAISE;
141    END get_report_total_details;
