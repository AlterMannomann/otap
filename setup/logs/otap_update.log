173    FUNCTION has_package( p_package_name    IN	     VARCHAR2
174  			   , o_errors		  OUT NOCOPY VARCHAR2
175  			   , p_schema	       IN	     VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
176  			   , p_package_type    IN	     VARCHAR2 DEFAULT 'PACKAGE'
177  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
178  			   )
179  	 RETURN INTEGER
180    IS
181  	 l_script	 VARCHAR2(1024 CHAR)	:= 'otap_schema.has_package';
182  	 l_ignore	 VARCHAR2(6 CHAR)	:= 'IGNORE';
183  	 l_header	 VARCHAR2(7 CHAR)	:= 'PACKAGE';
184  	 l_body 	 VARCHAR2(12 CHAR)	:= 'PACKAGE BODY';
185  	 l_has_package	 INTEGER;
186  	 l_test_passed	 INTEGER;
187  	 l_expected	 INTEGER;
188  	 l_schema_to_use VARCHAR2(128 CHAR);
189  	 l_package_name  VARCHAR2(128 CHAR);
190  	 l_package_type  VARCHAR2(12 CHAR);
191  	 l_errors	 VARCHAR2(32767 CHAR);
192    BEGIN
193  	 l_errors	 := NULL;
194  	 l_test_passed	 := otap_constants.OTAP_NUM_TEST_UNDEFINED;
195  	 l_expected	 := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
196  	 l_package_name  := otap_string.reduce(p_package_name, 128);
197  	 l_package_type  := otap_string.reduce(UPPER(p_package_type), 12);
198  	 IF	l_package_name	       IS NOT NULL
199  	    AND LENGTH(l_package_name)	> 0
200  	    AND l_package_type	       IN (l_header, l_body)
201  	 THEN
202  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
203  	   SELECT COUNT(*)
204  	     INTO l_has_package
205  	     FROM dba_objects
206  		  -- surprisingly nullable columns
207  	    WHERE owner       = l_schema_to_use
208  	      AND object_name = l_package_name
209  	      AND object_type = l_package_type
210  	   ;
211  	   -- we should find one or zero entries
212  	   l_test_passed := count_chk(l_has_package, l_errors, l_script);
213  	 ELSE
214  	   -- invalid package name or type
215  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
216  	   l_errors	       := 'Not allowed: ' || CASE
217  						       WHEN l_package_name IS NULL OR LENGTH(l_package_name) = 0
218  						       THEN 'p_package_name(NULL) '
219  						     END ||
220  						     CASE
221  						       WHEN l_package_type NOT IN (l_header, l_body)
222  						       THEN 'p_package_type(' || l_package_type || ') '
223  						     END
224  	   ;
225  	   otap_log.log(l_errors, l_script, 'Package name NULL or type invalid');
226  	 END IF;
227  	 -- now decide on the expected result the final state and if errors are returned
228  	 IF l_test_passed != l_expected
229  	 THEN
230  	   o_errors := otap_string.reduce(l_errors, 4000);
231  	 ELSE
232  	   -- overwrite states from before, as we fulfill expected
233  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
234  	   -- overwrite errors expected
235  	   o_errors := NULL;
236  	 END IF;
237  	 RETURN l_test_passed;
238    EXCEPTION
239  	 WHEN OTHERS THEN
240  	   IF SQLCODE != -20099
241  	   THEN
242  	     -- log unhandled exceptions
243  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
244  	   END IF;
245  	   RAISE;
246    END has_package;
