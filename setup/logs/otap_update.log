214    FUNCTION otap_session_set( p_test_count		IN	      NUMBER
215  				, p_test_set		IN	      VARCHAR2
216  				, p_test_group		IN	      VARCHAR2
217  				, p_test_name		IN	      VARCHAR2
218  				, p_prefix		IN	      VARCHAR2
219  				, p_language_id 	IN	      VARCHAR2
220  				, p_name_precedence	IN	      NUMBER
221  				, p_include_pkg 	IN	      NUMBER
222  				, p_persist		IN	      NUMBER
223  				, p_schema		IN	      VARCHAR2
224  				, p_user		IN	      VARCHAR2
225  				, p_executor		IN	      VARCHAR2
226  				, o_otap_session	IN OUT NOCOPY OTAP_SESSION
227  				)
228  	 RETURN VARCHAR2
229    IS
230  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_set';
231  	 l_message   VARCHAR2(32767 CHAR);
232  	 l_delimiter VARCHAR2(1 CHAR);
233    BEGIN
234  	 -- verify the current object
235  	 otap_objects.otap_session_verify(o_otap_session);
236  	 -- now verify the input
237  	 IF    p_schema    IS NULL
238  	    OR p_user	   IS NULL
239  	    OR p_executor  IS NULL
240  	 THEN
241  	   l_message := 'ERROR otap_objects.otap_session_set. Invalid OTAP_SESSION initialization. NULL errors: ';
242  	   l_delimiter := '';
243  	   IF p_schema IS NULL
244  	   THEN
245  	     l_message := l_message || l_delimiter || 'p_schema';
246  	     l_delimiter := ',';
247  	   END IF;
248  	   IF p_user IS NULL
249  	   THEN
250  	     l_message := l_message || l_delimiter || 'p_user';
251  	     l_delimiter := ',';
252  	   END IF;
253  	   IF p_executor IS NULL
254  	   THEN
255  	     l_message := l_message || l_delimiter || 'p_executor';
256  	   END IF;
257  	   l_message := l_message || ' The variable default should never be overwritten by users.';
258  	   otap_log.log('EXCEPTION -20099 ' || l_message, l_script, 'p_schema IS NULL OR p_user IS NULL OR p_executor IS NULL');
259  	   RAISE_APPLICATION_ERROR(-20099, l_message);
260  	 END IF;
261  	 -- check prefix length
262  	 IF	NVL(LENGTH(p_prefix), 0) <= 4
263  	    AND NVL(LENGTH(p_prefix), 0) > 0
264  	 THEN
265  	   -- no delimiter allowed
266  	   IF REGEXP_INSTR(p_prefix, '[_|$|#]') = 0
267  	   THEN
268  	     o_otap_session.test_prefix := UPPER(TRIM(p_prefix));
269  	   ELSE
270  	     o_otap_session.test_prefix := otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX;
271  	     otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' delimiters _, $, # not allowed', l_script, 'REGEXP_INSTR(p_prefix, ''[_|$|#]'') = 0');
272  	   END IF;
273  	 ELSE
274  	   -- leave prefix as defined, log error
275  	   o_otap_session.test_prefix := otap_constants.OTAP_FALLBACK_DEFAULT_PREFIX;
276  	   otap_log.log('ERROR checking otap test prefix ' || p_prefix || ' length, only length 1-4 allowed', l_script, 'LENGTH(p_prefix) <= 4 OR LENGTH(p_prefix) > 0');
277  	 END IF;
278  	 -- check bool values
279  	 IF NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
280  	 THEN
281  	   o_otap_session.name_precedence := (NVL(p_name_precedence, otap_constants.OTAP_NUM_TRUE) = otap_constants.OTAP_NUM_TRUE);
282  	 END IF;
283  	 IF NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
284  	 THEN
285  	   o_otap_session.include_packages := (NVL(p_include_pkg, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
286  	 END IF;
287  	 IF NVL(p_persist, otap_constants.OTAP_NUM_FALSE) IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
288  	 THEN
289  	   o_otap_session.persist_test := (NVL(p_persist, otap_constants.OTAP_NUM_FALSE) = otap_constants.OTAP_NUM_TRUE);
290  	 END IF;
291  	 -- check language, must be a 3 char code
292  	 IF LENGTH(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA)) > 3
293  	 THEN
294  	   o_otap_session.session_language := otap_constants.OTAP_INTERNAL_NA;
295  	 ELSE
296  	   o_otap_session.session_language := UPPER(NVL(p_language_id, otap_constants.OTAP_INTERNAL_NA));
297  	 END IF;
298  	 -- now start setting the new values
299  	 o_otap_session.test_executor	:= p_executor;
300  	 o_otap_session.db_user 	:= p_user;
301  	 o_otap_session.db_schema	:= p_schema;
302  	 IF NVL(p_test_count, 0) > 0
303  	 THEN
304  	   o_otap_session.intended_count  := p_test_count;
305  	 END IF;
306  	 -- keep old values if not specified
307  	 o_otap_session.test_set	:= NVL(p_test_set, o_otap_session.test_set);
308  	 o_otap_session.test_group	:= NVL(p_test_group, o_otap_session.test_group);
309  	 o_otap_session.test_name	:= NVL(p_test_name, o_otap_session.test_name);
310  	 -- reset other session values
311  	 o_otap_session.test_count	:= 0;
312  	 o_otap_session.error_count	:= 0;
313  	 o_otap_session.session_start	:= SYSDATE;
314  	 o_otap_session.session_id	:= otap_test_session_seq.NEXTVAL;
315  	 -- set view id equal to session id
316  	 o_otap_session.session_view_id := o_otap_session.session_id;
317  	 l_message := otap_objects.otap_session_show(o_otap_session);
318  	 RETURN l_message;
319    EXCEPTION
320  	 WHEN OTHERS THEN
321  	   IF SQLCODE != -20099
322  	   THEN
323  	     -- log unhandled exceptions
324  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
325  	   END IF;
326  	   RAISE;
327    END otap_session_set;
