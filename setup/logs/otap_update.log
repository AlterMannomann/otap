271  	 l_errors	   := NULL;
272  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
273  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
274  	 l_procedure_name  := otap_string.reduce(p_procedure_name, 128);
275  	 l_package_name    := otap_string.reduce(p_package_name, 128);
276  	 l_procedure_type  := otap_string.reduce(UPPER(p_procedure_type), 9);
277  	 l_return_type	   := otap_string.reduce(UPPER(p_return_type), 128);
278  	 IF	l_procedure_name	IS NOT NULL
279  	    AND LENGTH(l_procedure_name) > 0
280  	    AND l_procedure_type	IN (l_procedure, l_function)
281  	 THEN
282  	   -- schema
283  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
284  	   -- check
285  	     WITH prc AS
286  		  (SELECT dbo.owner
287  			, dbp.procedure_name
288  			, CASE
289  			    WHEN dbr.position	    = 0
290  			     AND dbr.argument_name IS NULL
291  			    THEN 'FUNCTION'
292  			    ELSE 'PROCEDURE'
293  			  END AS procedure_type
294  			, CASE
295  			    WHEN dbr.position	    = 0
296  			     AND dbr.argument_name IS NULL
297  			    THEN dbr.data_type
298  			    ELSE NULL
299  			  END AS return_type
300  			, dbo.status
301  			, dbo.object_name AS package_name
302  		     FROM dba_objects dbo
303  		     LEFT OUTER JOIN dba_procedures dbp
304  		       ON dbo.owner	  = dbp.owner
305  		      AND dbo.object_name = dbp.object_name
306  		      AND dbo.object_type = dbp.object_type
307  		     LEFT OUTER JOIN dba_arguments dbr
308  		       ON dbp.owner	     = dbr.owner
309  		      AND dbp.object_name    = dbr.package_name
310  		      AND dbp.procedure_name = dbr.object_name
311  		      AND dbp.object_id      = dbr.object_id
312  		      AND dbp.subprogram_id  = dbr.subprogram_id
313  		      AND dbr.sequence	     = 1
314  		    WHERE dbo.owner	   = l_schema_to_use
315  		      AND dbo.object_type  = 'PACKAGE'
316  			  -- exclude package itself
317  		      AND dbp.procedure_name IS NOT NULL
318  		    UNION ALL
319  		   SELECT dbo.owner
320  			, dbo.object_name AS procedure_name
321  			, dbo.object_type AS procedure_type
322  			, CASE
323  			    WHEN dbr.position	    = 0
324  			     AND dbr.argument_name IS NULL
325  			    THEN dbr.data_type
326  			    ELSE NULL
327  			  END AS return_type
328  			, dbo.status
329  			, NULL AS package_name
330  		     FROM dba_objects dbo
331  		     LEFT OUTER JOIN dba_procedures dbp
332  		       ON dbo.owner	  = dbp.owner
333  		      AND dbo.object_name = dbp.object_name
334  		      AND dbo.object_type = dbp.object_type
335  		     LEFT OUTER JOIN dba_arguments dbr
336  		       ON dbp.owner	    = dbr.owner
337  		      AND dbp.object_name   = dbr.object_name
338  		      AND dbp.object_id     = dbr.object_id
339  		      AND dbp.subprogram_id = dbr.subprogram_id
340  		      AND dbr.sequence	    = 1
341  		    WHERE dbo.owner	   = l_schema_to_use
342  		      AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
343  		  )
344  	   SELECT COUNT(*)
345  	     INTO l_has_procedure
346  	     FROM prc
347  	    WHERE procedure_name	     = l_procedure_name
348  	      AND procedure_type	     = l_procedure_type
349  	      AND NVL(return_type, 'n/a')    = NVL(l_return_type, NVL(return_type, 'n/a'))
350  	      AND NVL(package_name, 'n/a')   = NVL(l_package_name, NVL(package_name, 'n/a'))
351  	   ;
352  	   -- we may find more than 1 entry, if function or procedure has same name but different signature
353  	   l_test_passed := CASE WHEN l_has_procedure = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
354  	 ELSE
355  	   -- invalid package name, type or state
356  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
357  	   l_errors	       := 'Not allowed: ' || CASE
358  						       WHEN l_procedure_name IS NULL OR LENGTH(l_procedure_name) = 0
359  						       THEN 'p_procedure_name(NULL) '
360  						     END ||
361  						     CASE
362  						       WHEN l_procedure_type NOT IN (l_procedure, l_function)
363  						       THEN 'p_procedure_type(' || l_procedure_type || ') '
364  						     END
365  	   ;
366  	   otap_log.log(l_errors, l_script, 'Package name NULL or type invalid');
367  	 END IF;
368  	 -- now decide on the expected result the final state and if errors are returned
369  	 IF l_test_passed != l_expected
370  	 THEN
371  	   o_errors := otap_string.reduce(l_errors, 4000);
372  	 ELSE
373  	   -- overwrite states from before, as we fulfill expected
374  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
375  	   -- overwrite errors expected
376  	   o_errors := NULL;
377  	 END IF;
378  	 RETURN l_test_passed;
379    EXCEPTION
380  	 WHEN OTHERS THEN
381  	   IF SQLCODE != -20099
382  	   THEN
383  	     -- log unhandled exceptions
384  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
385  	   END IF;
386  	   RAISE;
387    END has_procedure;
