103  	       l_message := l_message || l_delimiter || 'db_schema';
104  	       l_delimiter := ',';
105  	     END IF;
106  	     IF p_otap_session.test_prefix IS NULL OR NVL(LENGTH(TRIM(p_otap_session.test_prefix)), 0) = 0
107  	     THEN
108  	       l_message := l_message || l_delimiter || 'test_prefix';
109  	       l_delimiter := ',';
