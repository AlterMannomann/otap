263    * @param p_index_type Optional. The index type of the index to check. Not case sensitive.
264    * @param p_table_type Optional. The table type of the index to check. Not case sensitive.
265    * @param p_uniqueness Optional. The uniqueness of the index to check. Not case sensitive.
266    * @param p_tablespace_name Optional. The tablespace name used by the index to check. Case sensitive.
267    * @param p_partitioned Optional. The partitioned state of the index to check. Not case sensitive.
268    * @param p_schema The schema to use. If NULL current schema is used. Case sensitive.
269    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
270    *
271    * @return The test result as number, either otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED or otap_constants.OTAP_NUM_TEST_UNDEFINED.
272    */
273    FUNCTION has_index( p_table_name      IN 	   VARCHAR2
274  			 , o_errors		OUT NOCOPY VARCHAR2
275  			 , p_column_name     IN 	   VARCHAR2 DEFAULT NULL
276  			 , p_index_name      IN 	   VARCHAR2 DEFAULT NULL
277  			 , p_index_type      IN 	   VARCHAR2 DEFAULT NULL
278  			 , p_table_type      IN 	   VARCHAR2 DEFAULT NULL
