399    FUNCTION set_active_report_id( p_report_id    IN 	   NUMBER
400  				    , o_otap_session IN OUT NOCOPY OTAP_SESSION
401  				    )
402  	 RETURN VARCHAR2
403    IS
404  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.set_active_report_id';
405  	 l_message VARCHAR2(4000);
406  	 l_return  NUMBER;
407  	 l_old_id  NUMBER;
408  	 l_count   NUMBER;
409    BEGIN
410  	 l_return  := 0;
411  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
412  	 -- execute the wrapped function in an extra block
413  	 BEGIN
414  	   -- save the old id for compare
415  	   l_old_id := otap_objects.otap_session_get_report_id(o_otap_session);
416  	   IF l_old_id = p_report_id
417  	   THEN
418  	     -- nothing to do
419  	     l_message := 'The report id ' || p_report_id || ' is currently active. No change.';
420  	   ELSE
421  	     -- check given id
422  	     SELECT COUNT(*) INTO l_count FROM otap_results WHERE test_session_id = p_report_id;
423  	     IF l_count > 0
424  	     THEN
425  	       l_return := otap_objects.otap_session_set_session_view_id(p_report_id, o_otap_session);
426  	     ELSE
427  	       otap_log.log('Invalid report id ' || p_report_id || ' does not exist in OTAP_RESULTS', l_script);
428  	       l_return  := l_old_id;
429  	       l_message := 'Report id ' || p_report_id || ' not found';
430  	     END IF;
431  	     IF l_return != l_old_id
432  	     THEN
433  	       l_message := 'New report id ' || l_return;
434  	     ELSE
435  	       l_message := 'ERROR report id ' || l_return || ' not changed. ' || l_message;
436  	     END IF;
437  	   END IF;
438  	 EXCEPTION
439  	   WHEN OTHERS THEN
440  	     -- consume error
441  	     otap_log.log(SQLERRM, l_script, 'Checking and calling otap_objects.otap_session_set_session_view_id');
442  	     l_message := otap_string.reduce('ERROR ' || l_script || ': ' || SQLERRM, 4000);
443  	 END;
444  	 -- return or let exception happen
445  	 RETURN l_message;
446    END set_active_report_id;
