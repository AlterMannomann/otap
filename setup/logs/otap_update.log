175    FUNCTION otap_session_show(p_otap_session IN OTAP_SESSION)
176  	 RETURN VARCHAR2
177    IS
178  	 l_script  VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_show';
179  	 l_message VARCHAR2(4000 CHAR);
180    BEGIN
181  	 -- verify the current object
182  	 otap_objects.otap_session_verify(p_otap_session);
183  	 -- build the message
184  	 l_message := 'Current test settings' || otap_constants.OTAP_INTERNAL_LF ||
185  		      'Test session id: ' || p_otap_session.session_id || otap_constants.OTAP_INTERNAL_LF ||
186  		      'Test set: ' || p_otap_session.test_set || otap_constants.OTAP_INTERNAL_LF ||
187  		      'Test group: ' || p_otap_session.test_group || otap_constants.OTAP_INTERNAL_LF ||
188  		      'Test name: ' || p_otap_session.test_name || otap_constants.OTAP_INTERNAL_LF ||
189  		      'Executor: ' || p_otap_session.test_executor || otap_constants.OTAP_INTERNAL_LF ||
190  		      'DB user: ' || p_otap_session.db_user || otap_constants.OTAP_INTERNAL_LF ||
191  		      'DB schema: ' || p_otap_session.db_schema || otap_constants.OTAP_INTERNAL_LF ||
192  		      'Test identifier prefix: ' || p_otap_session.test_prefix || otap_constants.OTAP_INTERNAL_LF ||
193  		      'Session language: ' || p_otap_session.session_language || otap_constants.OTAP_INTERNAL_LF ||
194  		      'Current tests:' || p_otap_session.test_count || otap_constants.OTAP_INTERNAL_LF ||
195  		      'Expected tests: ' || CASE WHEN p_otap_session.intended_count > 0 THEN TO_CHAR(p_otap_session.intended_count) ELSE 'Not set' END || otap_constants.OTAP_INTERNAL_LF ||
196  		      'Name precedence: ' || CASE WHEN p_otap_session.name_precedence THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
197  		      'Include packages: ' || CASE WHEN p_otap_session.include_packages THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
198  		      'Persist: ' || CASE WHEN p_otap_session.persist_test THEN otap_constants.OTAP_FALLBACK_TEXT_TRUE_YES ELSE otap_constants.OTAP_FALLBACK_TEXT_FALSE_NO END || otap_constants.OTAP_INTERNAL_LF ||
199  		      'Current view id: ' || CASE WHEN p_otap_session.session_view_id = 0 THEN 'Not set' ELSE TO_CHAR(p_otap_session.session_view_id) END || otap_constants.OTAP_INTERNAL_LF ||
200  		      'Test start: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
201  	 ;
202  	 l_message := otap_string.reduce(l_message, 4000);
203  	 RETURN l_message;
204    EXCEPTION
205  	 WHEN OTHERS THEN
206  	   IF SQLCODE != -20099
207  	   THEN
208  	     -- log unhandled exceptions
209  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
210  	   END IF;
211  	   RAISE;
212    END otap_session_show;
