SQL> CREATE OR REPLACE PACKAGE BODY otap_objects
  2  AS
  3    -- for description see header file
  4    PROCEDURE otap_session_verify(p_otap_session IN OTAP_SESSION)
  5    IS
  6  	 l_script    VARCHAR2(1024 CHAR) := 'otap_objects.otap_session_verify';
  7  	 l_statement VARCHAR2(32767 CHAR);
  8  	 l_message   VARCHAR2(32767 CHAR);
  9  	 l_delimiter VARCHAR2(1 CHAR);
 10    BEGIN
 11  	 -- we expect all fields to be NOT NULL including empty strings
 12  	 -- the NVL(LENGTH(TRIM)) construct exists for compatibility with older versions
 13  	 -- in current 23ai version TRIM(x) IS NULL would be enough
 14  	 IF    p_otap_session					    IS NULL
 15  	    OR p_otap_session.test_executor			    IS NULL
 16  	    OR NVL(LENGTH(TRIM(p_otap_session.test_executor)), 0)    = 0
 17  	    OR p_otap_session.test_set				    IS NULL
 18  	    OR NVL(LENGTH(TRIM(p_otap_session.test_set)), 0)	     = 0
 19  	    OR p_otap_session.test_group			    IS NULL
 20  	    OR NVL(LENGTH(TRIM(p_otap_session.test_group)), 0)	     = 0
 21  	    OR p_otap_session.test_name 			    IS NULL
 22  	    OR NVL(LENGTH(TRIM(p_otap_session.test_name)), 0)	     = 0
 23  	    OR p_otap_session.db_user				    IS NULL
 24  	    OR NVL(LENGTH(TRIM(p_otap_session.db_user)), 0)	     = 0
 25  	    OR p_otap_session.db_schema 			    IS NULL
 26  	    OR NVL(LENGTH(TRIM(p_otap_session.db_schema)), 0)	     = 0
 27  	    OR p_otap_session.test_prefix			    IS NULL
 28  	    OR NVL(LENGTH(TRIM(p_otap_session.test_prefix)), 0)      = 0
 29  	    OR p_otap_session.session_language			    IS NULL
 30  	    OR NVL(LENGTH(TRIM(p_otap_session.session_language)), 0) = 0
 31  	    OR p_otap_session.test_count			    IS NULL
 32  	    OR p_otap_session.intended_count			    IS NULL
 33  	    OR p_otap_session.persist_test			    IS NULL
 34  	    OR p_otap_session.name_precedence			    IS NULL
 35  	    OR p_otap_session.include_packages			    IS NULL
 36  	    OR p_otap_session.session_start			    IS NULL
 37  	    OR p_otap_session.session_id			    IS NULL
 38  	    OR p_otap_session.error_count			    IS NULL
 39  	    OR p_otap_session.session_view_id			    IS NULL
 40  	 THEN
 41  	   l_delimiter := '';
 42  	   l_statement := q'[p_otap_session					  IS NULL
 43  OR p_otap_session.test_executor			     IS NULL
 44  OR NVL(LENGTH(TRIM(p_otap_session.test_executor)), 0)    = 0
 45  OR p_otap_session.test_set 			     IS NULL
 46  OR NVL(LENGTH(TRIM(p_otap_session.test_set)), 0)	      = 0
 47  OR p_otap_session.test_group			     IS NULL
 48  OR NVL(LENGTH(TRIM(p_otap_session.test_group)), 0)       = 0
 49  OR p_otap_session.test_name			     IS NULL
 50  OR NVL(LENGTH(TRIM(p_otap_session.test_name)), 0)	      = 0
 51  OR p_otap_session.db_user				     IS NULL
 52  OR NVL(LENGTH(TRIM(p_otap_session.db_user)), 0)	      = 0
 53  OR p_otap_session.db_schema			     IS NULL
 54  OR NVL(LENGTH(TRIM(p_otap_session.db_schema)), 0)	      = 0
 55  OR p_otap_session.test_prefix			     IS NULL
 56  OR NVL(LENGTH(TRIM(p_otap_session.test_prefix)), 0)      = 0
 57  OR p_otap_session.session_language 		     IS NULL
 58  OR NVL(LENGTH(TRIM(p_otap_session.session_language)), 0) = 0
 59  OR p_otap_session.test_count			     IS NULL
 60  OR p_otap_session.intended_count			     IS NULL
 61  OR p_otap_session.persist_test			     IS NULL
 62  OR p_otap_session.name_precedence			     IS NULL
 63  OR p_otap_session.include_packages 		     IS NULL
 64  OR p_otap_session.session_start			     IS NULL
