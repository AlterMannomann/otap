227  				      , p_object	IN VARCHAR2 DEFAULT NULL
228  				      , p_scope 	IN VARCHAR2 DEFAULT '%'
229  				      , p_script_count	IN NUMBER   DEFAULT 0
230  				      , p_show_header	IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TRUE
