 74    * @return The given line size or the matching min/max line size.
 75    */
 76    FUNCTION check_line_size(p_line_size IN INTEGER DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH)
 77  	 RETURN NUMBER
