609    FUNCTION throws_like( p_statement       IN	     VARCHAR2
610  			   , p_like_sqlerrm    IN	     VARCHAR2
611  			   , o_errors		  OUT NOCOPY VARCHAR2
612  			   , p_case_sensitive  IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_FALSE
613  			   , p_header_def      IN	     VARCHAR2 DEFAULT NULL
614  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
615  			   )
616  	 RETURN INTEGER
617    IS
618  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_like';
619  	 l_test_passed	 INTEGER;
620  	 l_expected	 INTEGER;
621  	 l_count	 INTEGER;
622  	 l_like 	 VARCHAR2(32767 CHAR);
623  	 l_have 	 VARCHAR2(32767 CHAR);
624  	 l_errors	 VARCHAR2(32767 CHAR);
625  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
626  	 l_sqlcode	 NUMBER;
627    BEGIN
628  	 l_errors      := NULL;
629  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
630  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
631  	 IF p_like_sqlerrm IS NOT NULL
632  	 THEN
633  	   -- process the statement
634  	   IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
635  	   THEN
636  	     l_like := CASE WHEN p_case_sensitive = otap_constants.OTAP_NUM_TRUE THEN p_like_sqlerrm ELSE UPPER(p_like_sqlerrm) END;
637  	     l_have := CASE WHEN p_case_sensitive = otap_constants.OTAP_NUM_TRUE THEN l_sqlerrm ELSE UPPER(l_sqlerrm) END;
638  	     SELECT COUNT(*) INTO l_count FROM dual WHERE l_have LIKE l_like;
639  	     IF l_count = 1
640  	     THEN
641  	       l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
642  	     ELSE
643  	       -- decide which case happened
644  	       IF l_sqlcode = -20100
645  	       THEN
646  		 -- invalid header, l_errors should be set and logged already
647  		 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
648  	       ELSE
649  		 -- exception happened but does not match
650  		 l_errors      := l_errors || 'Given like expression does not match with ' || l_sqlerrm;
651  		 l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
652  		 otap_log.log(l_errors, l_script);
653  	       END IF;
654  	     END IF;
655  	   ELSE
656  	     -- no exception raised, l_errors should be set and logged already
657  	     l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
658  	     otap_log.log(l_errors, l_script);
659  	   END IF;
660  	 ELSE
661  	   -- invalid like expression
662  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
663  	   l_errors	 := l_errors || 'Not allowed: p_like_sqlerrm(NULL)';
664  	   -- log error
665  	   otap_log.log(l_errors, l_script);
666  	 END IF;
667  	 -- now decide on the expected result the final state and if errors are returned
668  	 IF l_test_passed != l_expected
669  	 THEN
670  	   o_errors := otap_string.reduce(l_errors, 4000);
671  	 ELSE
672  	   -- overwrite states from before, as we fulfill expected
673  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
674  	   -- overwrite errors expected
675  	   o_errors := NULL;
676  	 END IF;
677  	 RETURN l_test_passed;
678    EXCEPTION
679  	 WHEN OTHERS THEN
680  	   IF SQLCODE != -20099
681  	   THEN
682  	     -- log unhandled exceptions
683  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
684  	   END IF;
685  	   RAISE;
686    END throws_like;
687  
688  END;
