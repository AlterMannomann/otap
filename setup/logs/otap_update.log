539    FUNCTION has_constraint( p_table_name	  IN		VARCHAR2
540  			      , o_errors	     OUT NOCOPY VARCHAR2
541  			      , p_constraint_type IN		VARCHAR2 DEFAULT 'C'
542  			      , p_column_name	  IN		VARCHAR2 DEFAULT NULL
543  			      , p_constraint	  IN		VARCHAR2 DEFAULT NULL
544  			      , p_schema	  IN		VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
545  			      , p_expected_result IN		NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
546  			      )
547  	 RETURN INTEGER
548    IS
549  	 l_script	   VARCHAR2(1024 CHAR)	  := 'otap_schema.has_constraint';
550  	 l_test_passed	   INTEGER;
551  	 l_expected	   INTEGER;
552  	 l_has_constraint  INTEGER;
553  	 l_constraint_type CHAR(1 CHAR);
554  	 l_table_name	   VARCHAR2(128 CHAR);
555  	 l_column_name	   VARCHAR2(128 CHAR);
556  	 l_constraint_name VARCHAR2(128 CHAR);
557  	 l_schema_to_use   VARCHAR2(128 CHAR);
558  	 l_errors	   VARCHAR2(32767 CHAR);
559    BEGIN
560  	 l_errors	   := NULL;
561  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
562  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
563  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
564  	 l_column_name	   := otap_string.reduce(p_column_name, 128);
565  	 l_constraint_name := otap_string.reduce(p_constraint, 128);
566  	 l_constraint_type := otap_string.reduce(UPPER(p_constraint_type), 1);
567  	 IF	l_table_name	    IS NOT NULL
568  	    AND LENGTH(l_table_name) > 0
569  	    AND l_constraint_type   IN ('P', 'U', 'R', 'C', 'F', 'O', 'V', 'H')
570  	 THEN
571  	   -- schema
572  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
573  	   -- check
574  	   SELECT COUNT(*)
575  	     INTO l_has_constraint
576  	     FROM dba_constraints dco
577  	     LEFT OUTER JOIN dba_cons_columns dcc
578  	       ON dco.owner			   = dcc.owner
579  	      AND dco.constraint_name		   = dcc.constraint_name
580  	      AND dco.table_name		   = dcc.table_name
581  	    WHERE dco.owner			   = l_schema_to_use
582  	      AND dco.table_name		   = l_table_name
583  	      AND NVL(dcc.column_name, 'n/a')	   = NVL(l_column_name, NVL(dcc.column_name, 'n/a'))
584  	      AND dco.constraint_name		   = NVL(l_constraint_name, dco.constraint_name)
585  	      AND dco.constraint_type		   = l_constraint_type
586  	   ;
587  	   -- we may find more than one entry for combined primary keys
588  	   l_test_passed := CASE WHEN l_has_constraint = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
589  	 ELSE
590  	   -- missing mandatory table name
591  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
592  	   l_errors	       := 'Not allowed: ' || CASE WHEN l_table_name IS NULL THEN 'p_table_name(NULL) ' END ||
593  						     CASE
594  						       WHEN l_constraint_type NOT IN ('P', 'U', 'R', 'C', 'F', 'O', 'V', 'H')
595  						       THEN 'p_constraint_type(' || NVL(p_constraint_type, 'NULL') || ') '
596  						     END
597  	   ;
598  	   otap_log.log(l_errors, l_script, 'Table name NULL or invalid constraint type');
599  	 END IF;
600  	 -- now decide on the expected result the final state and if errors are returned
601  	 IF l_test_passed != l_expected
602  	 THEN
603  	   o_errors := otap_string.reduce(l_errors, 4000);
604  	 ELSE
605  	   -- overwrite states from before, as we fulfill expected
606  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
607  	   -- overwrite errors expected
608  	   o_errors := NULL;
609  	 END IF;
610  	 RETURN l_test_passed;
611    EXCEPTION
612  	 WHEN OTHERS THEN
613  	   IF SQLCODE != -20099
614  	   THEN
615  	     -- log unhandled exceptions
616  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
617  	   END IF;
618  	   RAISE;
619    END has_constraint;
