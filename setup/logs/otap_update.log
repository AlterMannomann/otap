709  	 l_copy    OTAP_SESSION;
710    BEGIN
711  	 l_copy 	   := otap_objects.otap_session_copy(p_otap_session);
712  	 l_copy.test_set   := otap_string.reduce(NVL(p_set_name, 'Test setup'), 256);
713  	 l_copy.test_group := otap_string.reduce(NVL(p_group_name, 'Session test setup'), 256);
714  	 l_copy.test_name  := otap_string.reduce(NVL(p_test_name, 'Session test setup checks'), 256);
715  	 RETURN l_copy;
716    EXCEPTION
717  	 WHEN OTHERS THEN
718  	   IF SQLCODE != -20099
719  	   THEN
720  	     -- log unhandled exceptions
721  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
722  	   END IF;
723  	   RAISE;
724    END otap_session_test_setup;
