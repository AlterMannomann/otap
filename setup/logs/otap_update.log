448    FUNCTION max_text_size( p_session_id  IN NUMBER
449  			     , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
450  			     )
451  	 RETURN NUMBER
452    IS
453  	 l_script    VARCHAR2(1024 CHAR) := 'otap_api.otap_session_get_test_id';
454  	 l_return    NUMBER;
455  	 l_interval  NUMBER;
456    BEGIN
457  	 l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
458  	 -- execute the wrapped function in an extra block
459  	 BEGIN
460  	   l_return := otap_util.max_text_size(p_session_id);
461  	   -- now add the extra columns on the result line
462  	   SELECT LENGTH(((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval FROM dual;
463  	   l_return := l_return + l_interval + (2 * otap_util.get_length_test_state(p_language_id)) + 3;
464  	 EXCEPTION
465  	   WHEN OTHERS THEN
466  	     -- consume error
467  	     otap_log.log(SQLERRM, l_script, 'Calling otap_util.max_text_size');
468  	     l_return := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
469  	 END;
470  	 -- return or let exception happen
471  	 RETURN l_return;
472    END max_text_size;
