 41    FUNCTION borderless( p_string	  IN VARCHAR2
 42  			  , p_min_fill	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
 43  			  , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 44  			  )
 45  	 RETURN VARCHAR2
 46    IS
 47  	 l_border      INTEGER;
 48  	 l_layout      VARCHAR2(1 CHAR);
 49  	 l_string_size INTEGER;
 50  	 l_min_fill    INTEGER;
 51  	 l_string      VARCHAR2(32767 CHAR);
 52  	 l_return_text VARCHAR2(32767 CHAR);
 53    BEGIN
 54  	 l_border      := otap_util.get_config_number(otap_util.CFG_DEFAULT_BORDER);
 55  	 l_layout      := otap_string.check_layout(otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT, p_language_id));
 56  	 l_string      := NVL(p_string, ' ');
 57  	 l_string_size := otap_string.check_string_size(LENGTH(l_string));
 58  	 -- limit the string if necessary
 59  	 l_string      := otap_string.reduce(l_string, l_string_size);
 60  	 -- get final title length
 61  	 l_string_size := NVL(LENGTH(l_string), 0);
 62  	 l_min_fill    := GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), l_string_size);
 63  	 l_return_text := otap_string.borderless(l_string, l_min_fill, l_layout);
 64  	 RETURN l_return_text;
 65    EXCEPTION
 66  	 WHEN OTHERS THEN
 67  	   otap_log.log(SQLERRM, 'otap_report.borderless', 'Create borderless report line');
 68  	   RAISE;
 69    END borderless;
