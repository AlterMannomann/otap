255  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
256  	   l_statement := otap_generate.get_code_pad || 'l_message VARCHAR2(4000);';
257  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
258  	   l_statement := otap_generate.get_code_pad || 'l_return  NUMBER;';
259  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
260  	   l_statement := 'BEGIN';
261  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
262  	   l_statement := PREFIX_PLSQL || 'otap_test.init_test(' || TRIM(TO_CHAR(NVL(p_script_count, 0))) || ')' || POSTFIX_PLSQL;
263  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
