650  					  ' tests: ' || TRIM(TO_CHAR(p_otap_session.test_count)) ||
651  					  CASE WHEN p_otap_session.intended_count > 0 THEN ' from ' || TRIM(TO_CHAR(p_otap_session.intended_count)) END ||
652  					  ' errors: ' || TRIM(TO_CHAR(p_otap_session.error_count)) ||
653  					  ' run time: ' || TRIM(TO_CHAR(((SYSDATE - p_otap_session.session_start) DAY TO SECOND))) ||
654  					  ' started: ' || TO_CHAR(p_otap_session.session_start, 'YYYY-MM-DD HH24:MI:SS')
655  					, 4000
656  					)
657  	 ;
