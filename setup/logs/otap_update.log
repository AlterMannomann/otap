284    FUNCTION match_regex( p_have	       IN	     VARCHAR2
285  			   , p_regex	       IN	     VARCHAR2
286  			   , o_errors		  OUT NOCOPY VARCHAR2
287  			   , p_param	       IN	     VARCHAR2 DEFAULT NULL
288  			   , p_expected_result IN	     NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
289  			   )
290  	 RETURN INTEGER
291    IS
292  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.match_regex';
293  	 l_test_passed	 INTEGER;
294  	 l_count	 INTEGER;
295  	 l_expected	 INTEGER;
296  	 l_errors	 VARCHAR2(32767 CHAR);
297    BEGIN
298  	 l_errors      := NULL;
299  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
300  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
301  	 IF p_regex IS NOT NULL
302  	 THEN
303  	   IF p_param IS NOT NULL
304  	   THEN
305  	     -- check parameter
306  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_param, '^[icmnx]*$');
307  	     IF l_count = 1
308  	     THEN
309  	       SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_have, p_regex, p_param);
310  	       l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
311  	     ELSE
312  	       -- invalid parameter
313  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
314  	       l_errors      := 'Not allowed: p_param(' || p_param || ') only i, c, m, n or x supported. Case sensitive.';
315  	       -- log error
316  	       otap_log.log(l_errors, l_script);
317  	     END IF;
318  	   ELSE
319  	     -- leave fail on REGEXP_LIKE if p_have is NULL or params are wrong
320  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_have, p_regex);
321  	     l_test_passed := CASE WHEN l_count = 1 THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
322  	   END IF;
323  	 ELSE
324  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
325  	   l_errors	 := 'Not allowed: p_regex(NULL)';
326  	   -- log error
327  	   otap_log.log(l_errors, l_script);
328  	 END IF;
329  	 -- now decide on the expected result the final state and if errors are returned
330  	 IF l_test_passed != l_expected
331  	 THEN
332  	   o_errors := otap_string.reduce(l_errors, 4000);
333  	 ELSE
334  	   -- overwrite states from before, as we fulfill expected
335  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
336  	   -- overwrite errors expected
337  	   o_errors := NULL;
338  	 END IF;
339  	 RETURN l_test_passed;
340    EXCEPTION
341  	 WHEN OTHERS THEN
342  	   IF SQLCODE != -20099
343  	   THEN
344  	     -- log unhandled exceptions
345  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
346  	   END IF;
347  	   RAISE;
348    END match_regex;
