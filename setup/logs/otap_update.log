621    FUNCTION has_ref_constraint( p_table_name      IN	    VARCHAR2
622  				  , o_errors		 OUT NOCOPY VARCHAR2
623  				  , p_constraint_type IN	    VARCHAR2 DEFAULT 'R'
624  				  , p_column_name     IN	    VARCHAR2 DEFAULT NULL
625  				  , p_constraint      IN	    VARCHAR2 DEFAULT NULL
626  				  , p_schema	      IN	    VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
627  				  , p_r_table_name    IN	    VARCHAR2 DEFAULT NULL
628  				  , p_r_column_name   IN	    VARCHAR2 DEFAULT NULL
629  				  , p_r_constraint    IN	    VARCHAR2 DEFAULT NULL
630  				  , p_r_schema	      IN	    VARCHAR2 DEFAULT NULL
631  				  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
632  				  )
633  	 RETURN INTEGER
634    IS
635  	 l_script	     VARCHAR2(1024 CHAR)    := 'otap_schema.has_ref_constraint';
636  	 l_test_passed	     INTEGER;
637  	 l_expected	     INTEGER;
638  	 l_has_constraint    INTEGER;
639  	 l_constraint_type   CHAR(1 CHAR);
640  	 l_table_name	     VARCHAR2(128 CHAR);
641  	 l_column_name	     VARCHAR2(128 CHAR);
642  	 l_constraint_name   VARCHAR2(128 CHAR);
643  	 l_schema_to_use     VARCHAR2(128 CHAR);
644  	 l_r_table_name      VARCHAR2(128 CHAR);
645  	 l_r_column_name     VARCHAR2(128 CHAR);
646  	 l_r_constraint_name VARCHAR2(128 CHAR);
647  	 l_r_schema	     VARCHAR2(128 CHAR);
648  	 l_errors	     VARCHAR2(32767 CHAR);
649    BEGIN
650  	 l_errors	     := NULL;
651  	 l_test_passed	     := otap_constants.OTAP_NUM_TEST_UNDEFINED;
652  	 l_expected	     := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
653  	 l_table_name	     := otap_string.reduce(p_table_name, 128);
654  	 l_column_name	     := otap_string.reduce(p_column_name, 128);
655  	 l_constraint_name   := otap_string.reduce(p_constraint, 128);
656  	 l_r_table_name      := otap_string.reduce(p_r_table_name, 128);
657  	 l_r_column_name     := otap_string.reduce(p_r_column_name, 128);
658  	 l_r_constraint_name := otap_string.reduce(p_r_constraint, 128);
659  	 l_r_schema	     := otap_string.reduce(p_r_schema, 128);
660  	 l_constraint_type   := otap_string.reduce(UPPER(p_constraint_type), 1);
661  	 IF	l_table_name	    IS NOT NULL
662  	    AND LENGTH(l_table_name) > 0
663  	    AND l_constraint_type   IN ('R', 'F')
664  	 THEN
665  	   -- schema
666  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
667  	   -- check
668  	   SELECT COUNT(*)
669  	     INTO l_has_constraint
