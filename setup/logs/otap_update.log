129  
130  
131    /** FUNCTION otap_string.line_size
132    * Calculates the minimum length to use for a formatted string based on title size. Limited to SQL
133    * column size. See otap_constants.OTAP_NUM_MAX_FILL_LENGTH.
134    *
135    * @param p_title_length The length of the title to use for formatted output.
136    * @param p_border The minimum border length to consider for decoration.
137    * @param p_min_fill The minimum size for a decorated report line.
138    *
139    * @return The minimum length of a decorated string with given title size and border fill, limited to otap_constants.OTAP_NUM_MAX_FILL_LENGTH size.
140    */
141    FUNCTION line_size( p_title_length  IN INTEGER
142  			 , p_border	   IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
143  			 , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
144  			 )
145  	 RETURN INTEGER
146    ;
147  
148    /** FUNCTION otap_string.max_size
149    * Calculates the maximum length for a given title size considering line size and borders. Limited to SQL
150    * column size. See otap_constants.OTAP_NUM_MAX_FILL_LENGTH.
151    *
152    * @param p_title_length The intended title string size.
153    * @param p_line_size The intended line size to use in reports.
154    * @param p_border The minimum border length to consider for decoration.
155    *
156    * @return The maximum allowed title length for current line size and borders. May result in 0 if border or line size dimensions are wrong.
157    */
158    FUNCTION max_size( p_title_length IN INTEGER
159  			, p_line_size	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
160  			, p_border	 IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
161  			)
162  	 RETURN INTEGER
163    ;
164  
165    /** FUNCTION otap_string.left_deco
166    * Builds the left decoration for a given title length and line size. If title length is 0, no space
167    * is added to the decoration. Given layout orientation is considered. If R(right) extra chars are padded to the
168    * left. For all other layout orientations, extra chars are padded to the right. Extra char occurs if line size
169    * is uneven.
170    *
171    * @param p_title_length The title string size.
172    * @param p_min_fill The intended line size to use in reports.
173    * @param p_decoration The decoration char that should pad the title to the left including a space if title length > 0.
174    * @param p_layout The decoration layout orientation for the title in the decoration.
175    * @param p_border The minimum border length to consider for decoration.
176    *
177    * @return The decoration string for the left side. Includes a space if title length > 0.
178    */
179    FUNCTION left_deco( p_title_length IN INTEGER  DEFAULT 0
180  			 , p_min_fill	  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
181  			 , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
182  			 , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
183  			 , p_border	  IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
184  			 )
185  	 RETURN VARCHAR2
186    ;
187  
188    /** FUNCTION otap_string.right_deco
189    * Builds the right decoration for a given title length and line size. If title length is 0, no space
190    * is added to the decoration. Given layout orientation is considered. If R(right) extra chars are padded to the
191    * left. For all other layout orientations, extra chars are padded to the right. Extra char occurs if line size
192    * is uneven.
193    *
194    * @param p_title_length The title string size.
195    * @param p_min_fill The intended line size to use in reports.
196    * @param p_decoration The decoration char that should pad the title to the right including a space if title length > 0.
197    * @param p_layout The decoration layout orientation for the title in the decoration.
198    * @param p_border The minimum border length to consider for decoration.
199    *
200    * @return The decoration string for the right side. Includes a space if title length > 0.
201    */
202    FUNCTION right_deco( p_title_length IN INTEGER  DEFAULT 0
203  			  , p_min_fill	   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
204  			  , p_decoration   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
205  			  , p_layout	   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
206  			  , p_border	   IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
207  			  )
208  	 RETURN VARCHAR2
209    ;
210  
211    /** FUNCTION otap_string.decorate
212    * Decorates a given title string with the decoration char to left and right padded and a space between title and
213    * decoration char. Title is placed as defined by layout. Title will be cutted if it is too long, see
214    * otap_constants.OTAP_NUM_MAX_FILL_LENGTH. Cutting string is always on the right.
215    *
216    * M (middle): Title is placed in the middle, decoration chars padded and extended equally on both sides up to calculated line size.
217    * L (left): Minimum border decoration placed at the left followed by the title, right padding border decoration up to calculated line size.
218    * R (right): Minimum border decoration placed at the right with leading title, left padding border decoration up to calculated line size.
219    *
220    * Examples
221    * decorate('test', '-', 80, 'M', 3): ------------------------------------- test -------------------------------------
222    * decorate('test', '-', 80, 'L', 3): -- test ------------------------------------------------------------------------
223    * decorate('test', '-', 80, 'R', 3): ------------------------------------------------------------------------ test --
224    *
225    * @param p_title The title to use in the decorated line. If NULL a decorated line is created without any text inside.
226    * @param p_decoration The decoration char that should pad the title to the left and right including a space between text and decoration.
227    * @param p_min_length The minimum size for a decorated report line. Limited by otap_constants.OTAP_NUM_MIN_FILL_LENGTH. Lower values translate to minimum fill length.
228    * @param p_layout The decoration layout orientation for the title in the decoration.
229    * @param p_border The decoration border length including the space to separate text from decoration.
230    *
231    * @return The decorated string. Limited to 4000 chars as it is used in SQL columns.
232    */
233    FUNCTION decorate( p_title	IN VARCHAR2 DEFAULT NULL
234  			, p_decoration	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_FORMAT_NAME_CHAR
235  			, p_min_length	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
236  			, p_layout	IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT
237  			, p_border	IN INTEGER  DEFAULT otap_constants.OTAP_FALLBACK_BORDER
238  			)
239  	 RETURN VARCHAR2
240    ;
