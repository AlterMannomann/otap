580    FUNCTION get_exists_msg( p_object_name IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
581  			      , p_schema_name IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
582  			      , p_object_type IN VARCHAR2 DEFAULT NULL
583  			      , p_sub_object  IN VARCHAR2 DEFAULT NULL
584  			      , p_test_desc   IN VARCHAR2 DEFAULT NULL
585  			      , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
586  			      )
587  	 RETURN VARCHAR2
588    IS
589  	 l_template_text VARCHAR2(32767 CHAR); -- '@type@ @object@ exists check (@schema@)'
590    BEGIN
591  	 IF p_sub_object IS NOT NULL
592  	 THEN
593  	   l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_EXISTSX
594  						 , p_type_label => p_object_type
595  						 , p_param1 => '@object@'
596  						 , p_param1_value => p_object_name
597  						 , p_param2 => '@schema@'
598  						 , p_param2_value => p_schema_name
599  						 , p_param3 => '@subobject@'
600  						 , p_param3_value => p_sub_object
601  						 , p_description => p_test_desc
602  						 , p_language_id => p_language_id
603  						 )
604  	   ;
605  	 ELSE
606  	   l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_EXISTS
607  						 , p_type_label => p_object_type
608  						 , p_param1 => '@object@'
609  						 , p_param1_value => p_object_name
610  						 , p_param2 => '@schema@'
611  						 , p_param2_value => p_schema_name
612  						 , p_description => p_test_desc
613  						 , p_language_id => p_language_id
614  						 )
615  	   ;
616  	 END IF;
617  	 RETURN l_template_text;
618    EXCEPTION
619  	 WHEN OTHERS THEN
620  	   otap_log.log(SQLERRM, 'otap_report.get_exists_msg', 'Build exists result message');
621  	   RAISE;
622    END get_exists_msg;
