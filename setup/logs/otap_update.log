 37    FUNCTION get_test_block( p_statement  IN VARCHAR2
 38  			      , p_header_def IN VARCHAR2 DEFAULT NULL
 39  			      )
 40  	 RETURN VARCHAR2
 41    IS
 42  	l_block VARCHAR2(32767);
 43    BEGIN
 44  	 IF SUBSTR(UPPER(p_statement), 1, 6) = 'SELECT'
 45  	 THEN
 46  	   l_block := TRIM(p_statement);
 47  	   IF (SUBSTR(l_block, LENGTH(l_block)-1, 1) = ';')
 48  	   THEN
 49  	     l_block := SUBSTR(l_block, 1, LENGTH(l_block)-1);
 50  	   END IF;
 51  	   -- to get exceptions from SELECT statements without knowing the columns we use a FOR IN loop
 52  	   l_block := 'DECLARE BEGIN FOR rec IN (' || l_block || ') LOOP NULL; END LOOP; END;';
 53  	   RETURN l_block;
 54  	 ELSE
 55  	   RETURN 'DECLARE ' || p_header_def || ' BEGIN ' || p_statement || ' END;';
 56  	 END IF;
 57    EXCEPTION
 58  	 WHEN OTHERS THEN
 59  	   IF SQLCODE != -20099
 60  	   THEN
 61  	     -- log unhandled exceptions
 62  	     otap_log.log(SQLERRM, 'otap_logic.get_test_block', 'Unhandled exception otap_logic.get_test_block call');
 63  	   END IF;
 64  	   RAISE;
 65    END get_test_block;
 66  
 67    FUNCTION has_exception( p_statement	 IN	       VARCHAR2
 68  			     , o_errors 	 IN OUT NOCOPY VARCHAR2
 69  			     , o_sqlcode	    OUT NOCOPY NUMBER
 70  			     , o_sqlerrm	    OUT NOCOPY VARCHAR2
 71  			     , p_header_def	 IN	       VARCHAR2 DEFAULT NULL
 72  			     , p_expected_result IN	       NUMBER	DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
 73  			     )
 74  	 RETURN BOOLEAN
 75    IS
 76  	 l_script  VARCHAR2(1024 CHAR) := 'otap_logic.has_exception';
 77  	 l_block   VARCHAR2(32767);
 78  	 l_return  BOOLEAN;
 79    BEGIN
 80  	 l_return := FALSE;
 81  	 IF otap_logic.check_header(p_header_def, o_errors)
 82  	 THEN
 83  	   -- header valid, check statement
 84  	   l_block := otap_logic.get_test_block(p_statement, p_header_def);
 85  	   otap_log.log('Dynamic execution of unverified code', l_script, l_block, otap_constants.OTAP_INTERNAL_WARNING);
 86  	   BEGIN
 87  	     EXECUTE IMMEDIATE l_block;
 88  	     l_return := FALSE;
 89  	     IF p_expected_result = otap_constants.OTAP_NUM_TEST_PASSED
 90  	     THEN
 91  	       o_errors  := o_errors || 'Expected exception missing for ' || l_block || ' ';
 92  	       o_sqlcode := NULL;
 93  	       o_sqlerrm := NULL;
 94  	     END IF;
 95  	   EXCEPTION
 96  	     WHEN OTHERS THEN
 97  	       o_sqlcode := SQLCODE;
 98  	       o_sqlerrm := SQLERRM;
 99  	       l_return  := TRUE;
100  	   END;
101  	 ELSE
102  	   -- header not valid, o_errors should be set, return TRUE but user error
103  	   otap_log.log('-20100 invalid header', l_script, 'User error invalid header ' || p_header_def);
104  	   o_sqlcode := -20100;
105  	   o_sqlerrm := 'User error invalid header ' || p_header_def;
106  	   o_errors  := o_errors || 'User error invalid header ' || p_header_def || ' ';
107  	   l_return  := TRUE;
108  	 END IF;
109  	 RETURN l_return;
110    EXCEPTION
111  	 WHEN OTHERS THEN
112  	   IF SQLCODE != -20099
113  	   THEN
114  	     -- log unhandled exceptions
115  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
116  	   END IF;
117  	   RAISE;
118    END has_exception;
