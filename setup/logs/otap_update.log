545  				       , p_description	   IN VARCHAR2 DEFAULT NULL
546  				       , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
547  				       )
548  	 RETURN VARCHAR2
549    ;
