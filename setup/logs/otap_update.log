564    FUNCTION get_summary( p_runtime	   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
565  			   , p_exectime    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
566  			   , p_runs	   IN NUMBER   DEFAULT 0
567  			   , p_errors	   IN NUMBER   DEFAULT 0
568  			   , p_issues	   IN NUMBER   DEFAULT 0
569  			   , p_min_fill    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
570  			   , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
571  			   )
572  	 RETURN VARCHAR2
573    IS
574  	 l_script  VARCHAR2(1024 CHAR) := 'otap_api.get_summary';
575  	 l_message VARCHAR2(4000 CHAR);
576  	 l_status  VARCHAR2(4000 CHAR);
577    BEGIN
578  	 l_message := otap_constants.OTAP_INTERNAL_ERROR;
579  	 -- execute the wrapped function in an extra block
580  	 BEGIN
581  	   l_status := CASE
582  			 WHEN p_issues > 0
583  			 THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_UNDEFINED, p_language_id)
584  			 WHEN p_errors > 0 AND p_issues <= 0
585  			 THEN otap_util.get_config_value(otap_util.CFG_TEXT_TEST_FAILED, p_language_id)
586  			 ELSE otap_util.get_config_value(otap_util.CFG_TEXT_TEST_PASSED, p_language_id)
587  		       END
588  	   ;
589  	   l_message := otap_report.get_summary(l_status, p_runtime, p_exectime, p_runs, p_errors, p_issues, p_min_fill, p_language_id);
590  	 EXCEPTION
591  	   WHEN OTHERS THEN
592  	     -- consume error
593  	     otap_log.log(SQLERRM, l_script, 'Calling otap_report.get_summary');
594  	     l_message := otap_string.reduce('Internal otap error get report summary: ' || SQLERRM, 4000);
595  	 END;
596  	 -- return or let exception happen
597  	 RETURN l_message;
598    END get_summary;
