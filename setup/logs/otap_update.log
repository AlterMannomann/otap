724    FUNCTION build_msg( p_cfg_template  IN VARCHAR2
725  			 , p_type_label    IN VARCHAR2 DEFAULT NULL
726  			 , p_param1	   IN VARCHAR2 DEFAULT NULL
727  			 , p_param1_value  IN VARCHAR2 DEFAULT NULL
728  			 , p_param2	   IN VARCHAR2 DEFAULT NULL
729  			 , p_param2_value  IN VARCHAR2 DEFAULT NULL
730  			 , p_param3	   IN VARCHAR2 DEFAULT NULL
731  			 , p_param3_value  IN VARCHAR2 DEFAULT NULL
732  			 , p_param4	   IN VARCHAR2 DEFAULT NULL
733  			 , p_param4_value  IN VARCHAR2 DEFAULT NULL
734  			 , p_param5	   IN VARCHAR2 DEFAULT NULL
735  			 , p_param5_value  IN VARCHAR2 DEFAULT NULL
736  			 , p_param6n	   IN VARCHAR2 DEFAULT NULL
737  			 , p_param6n_value IN VARCHAR2 DEFAULT NULL
738  			 , p_description   IN VARCHAR2 DEFAULT NULL
739  			 , p_language_id   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
740  			 )
741  	 RETURN VARCHAR2
742    IS
743  	 l_script	 VARCHAR2(256 CHAR) := 'otap_util.build_msg';
744  	 l_text_result	 VARCHAR2(4000 CHAR);
745  	 l_label	 VARCHAR2(256 CHAR);
746  	 l_var_count	 INTEGER;
747    BEGIN
748  	 IF TRIM(p_description) IS NOT NULL
749  	 THEN
750  	   l_text_result := otap_string.reduce(p_description, 4000);
751  	 ELSE
752  	   IF p_cfg_template IS NULL
753  	   THEN
754  	     l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' missing description and template identifier';
755  	     otap_log.log(l_text_result, l_script);
756  	   ELSE
757  	     l_text_result := otap_util.get_config_value(p_cfg_template, p_language_id);
758  	     IF l_text_result = otap_constants.OTAP_INTERNAL_ERROR
759  	     THEN
760  	       l_text_result := otap_constants.OTAP_INTERNAL_ERROR || ' ' || l_script || ' invalid template identifier ' || p_cfg_template;
761  	       otap_log.log(l_text_result, l_script);
762  	     ELSE
763  	       -- check variables, only modify if present, otherwise text is delivered as is
764  	       l_var_count := REGEXP_COUNT(l_text_result, '@');
765  	       -- check also that @@ comes in pairs like valid variables
766  	       IF l_var_count != 0 AND MOD(l_var_count, 2) = 0
767  	       THEN
768  		 -- check type present
769  		 IF	p_type_label					  IS NOT NULL
770  		    AND INSTR(l_text_result, otap_constants.OTAP_TYPE_VAR) > 0
771  		 THEN
772  		   l_label := otap_util.get_config_value(p_type_label, p_language_id);
773  		   -- do nothing on errors
774  		   IF l_label != otap_constants.OTAP_INTERNAL_ERROR
775  		   THEN
776  		     -- replace if exists in template
777  		     l_text_result := REPLACE(l_text_result, otap_constants.OTAP_TYPE_VAR, l_label);
778  		   ELSE
779  		     otap_log.log('Type ignored, Invalid label used: ' || p_type_label, l_script);
780  		   END IF;
781  		 END IF;
782  		 -- check vars and replace if condition met
783  		 IF p_param1_value IS NOT NULL
784  		 THEN
785  		   IF	  p_param1		     IS NOT NULL
786  		      AND REGEXP_COUNT(p_param1, '@') = 2
787  		   THEN
788  		     -- replace, may work, may not
789  		     l_text_result := REPLACE(l_text_result, p_param1, p_param1_value);
790  		   ELSE
791  		     -- ignore, log error
792  		     otap_log.log('Value without variable name: ' || p_param1_value || ' or invalid parameter: ' || NVL(p_param1, 'NULL'), l_script);
793  		   END IF;
794  		 END IF;
795  		 IF p_param2_value IS NOT NULL
796  		 THEN
797  		   IF	  p_param2		     IS NOT NULL
798  		      AND REGEXP_COUNT(p_param2, '@') = 2
799  		   THEN
800  		     -- replace, may work, may not
801  		     l_text_result := REPLACE(l_text_result, p_param2, p_param2_value);
802  		   ELSE
803  		     -- ignore, log error
804  		     otap_log.log('Value without variable name: ' || p_param2_value || ' or invalid parameter: ' || NVL(p_param2, 'NULL'), l_script);
805  		   END IF;
806  		 END IF;
807  		 IF p_param3_value IS NOT NULL
808  		 THEN
809  		   IF	  p_param3		     IS NOT NULL
810  		      AND REGEXP_COUNT(p_param3, '@') = 2
811  		   THEN
812  		     -- replace, may work, may not
813  		     l_text_result := REPLACE(l_text_result, p_param3, p_param3_value);
814  		   ELSE
815  		     -- ignore, log error
816  		     otap_log.log('Value without variable name: ' || p_param3_value || ' or invalid parameter: ' || NVL(p_param3, 'NULL'), l_script);
817  		   END IF;
818  		 END IF;
819  		 IF p_param4_value IS NOT NULL
820  		 THEN
821  		   IF	  p_param4		     IS NOT NULL
822  		      AND REGEXP_COUNT(p_param4, '@') = 2
823  		   THEN
824  		     -- replace, may work, may not
825  		     l_text_result := REPLACE(l_text_result, p_param4, p_param4_value);
826  		   ELSE
827  		     -- ignore, log error
828  		     otap_log.log('Value without variable name: ' || p_param4_value || ' or invalid parameter: ' || NVL(p_param4, 'NULL'), l_script);
829  		   END IF;
830  		 END IF;
831  		 IF p_param5_value IS NOT NULL
832  		 THEN
833  		   IF	  p_param5		     IS NOT NULL
834  		      AND REGEXP_COUNT(p_param5, '@') = 2
835  		   THEN
836  		     -- replace, may work, may not
837  		     l_text_result := REPLACE(l_text_result, p_param5, p_param5_value);
838  		   ELSE
839  		     -- ignore, log error
840  		     otap_log.log('Value without variable name: ' || p_param5_value || ' or invalid parameter: ' || NVL(p_param5, 'NULL'), l_script);
841  		   END IF;
842  		 END IF;
843  		 -- allow NULL value for replace
844  		 IF p_param6n IS NOT NULL
845  		 THEN
846  		   IF REGEXP_COUNT(p_param6n, '@') = 2
847  		   THEN
848  		     -- replace, may work, may not
849  		     l_text_result := REPLACE(l_text_result, p_param6n, p_param6n_value);
850  		   ELSE
851  		     -- ignore, log error
852  		     otap_log.log('Invalid parameter p_param6n: ' || p_param6n, l_script);
853  		   END IF;
854  		 END IF;
855  	       END IF;
856  	     END IF;
857  	   END IF;
858  	 END IF;
859  	 -- remove duplicate space chars
860  	 l_text_result := otap_string.flatten(l_text_result, 4000);
861  	 RETURN l_text_result;
862    EXCEPTION
863  	 WHEN OTHERS THEN
864  	   otap_log.log(SQLERRM, l_script, 'Prepare message from template');
865  	   RAISE;
866  	 RETURN l_text_result;
867    END build_msg;
868  
869    PROCEDURE write_test_result( p_to_delete 	IN NUMBER
870  				  , p_test_passed	IN NUMBER
871  				  , p_test_session_id	IN NUMBER
872  				  , p_test_executor	IN VARCHAR2
873  				  , p_test_set		IN VARCHAR2
874  				  , p_db_user		IN VARCHAR2
875  				  , p_db_schema 	IN VARCHAR2
876  				  , p_test_group	IN VARCHAR2
877  				  , p_test_start	IN TIMESTAMP
878  				  , p_test_end		IN TIMESTAMP
879  				  , p_test_name 	IN VARCHAR2
880  				  , p_test_desc 	IN VARCHAR2
881  				  , p_test_errors	IN VARCHAR2 DEFAULT NULL
882  				  )
883    IS
884  	 PRAGMA AUTONOMOUS_TRANSACTION;
885  	 l_script      VARCHAR2(256 CHAR) := 'otap_util.write_test_result';
886  	 l_to_delete   NUMBER;
887  	 l_test_passed NUMBER;
888  	 l_errors      otap_results.test_errors%TYPE;
889    BEGIN
890  	 l_to_delete   := CASE
891  			    WHEN p_to_delete IN (otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_FALSE)
892  			    THEN p_to_delete
893  			    ELSE otap_constants.OTAP_NUM_TRUE
894  			  END
895  	 ;
896  	 -- this is an error and must be handled
897  	 IF p_test_passed NOT IN (otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
898  	 THEN
899  	   l_errors := otap_string.reduce('Invalid test result: ' || p_test_passed || ' ' || p_test_errors, 4000);
900  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
901  	 ELSE
902  	   l_test_passed := p_test_passed;
903  	   l_errors := p_test_errors;
904  	 END IF;
905  	 INSERT INTO otap_results
906  	   ( to_delete
907  	   , test_passed
908  	   , test_session_id
909  	   , test_executor
910  	   , test_set
911  	   , db_user
912  	   , db_schema
913  	   , test_group
914  	   , test_start
915  	   , test_end
916  	   , test_name
917  	   , test_desc
918  	   , test_errors
919  	   ) VALUES ( l_to_delete
920  		    , l_test_passed
921  		    , p_test_session_id
922  		    , p_test_executor
923  		    , p_test_set
924  		    , p_db_user
925  		    , p_db_schema
926  		    , p_test_group
927  		    , p_test_start
928  		    , p_test_end
929  		    , p_test_name
930  		    , p_test_desc
931  		    , l_errors
932  		    )
933  	 ;
934  	 COMMIT;
935    EXCEPTION
936  	 WHEN OTHERS THEN
937  	   otap_log.log(SQLERRM, l_script, 'INSERT into otap_results');
938  	   ROLLBACK;
939  	   RAISE;
940    END write_test_result;
941  
942    PROCEDURE result_cleanup
943    IS
944  	 PRAGMA AUTONOMOUS_TRANSACTION;
945  	 l_script	     VARCHAR2(256 CHAR) := 'otap_util.result_cleanup';
946  	 l_delete_before     DATE;
947  	 l_delete_start      DATE;
948  	 l_delete_batch_size NUMBER;
949  	 l_delete_delay      NUMBER;
950  	 l_row_counter	     NUMBER;
951  	 l_processed	     NUMBER;
952  	 l_delete_msg	     VARCHAR2(32767 CHAR);
953  	 CURSOR cur_delete_tests(cp_delete_before IN DATE)
954  	 IS
955  	   SELECT *
956  	     FROM otap_results
957  	    WHERE test_run_date < cp_delete_before
958  	      AND to_delete	= otap_constants.OTAP_NUM_TRUE
959  	 ;
960    BEGIN
961  	 -- read config values before starting, values will not change until finished
962  	 l_delete_start      := SYSDATE;
963  	 l_delete_before     := TRUNC(SYSDATE - otap_util.get_config_number(otap_util.CFG_PRESERVE_DAYS));
964  	 l_delete_batch_size := otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE);
965  	 l_delete_delay      := otap_util.get_config_number(otap_util.CFG_DELETE_DELAY);
966  	 l_row_counter	     := 0;
967  	 l_processed	     := 0;
968  	 l_delete_msg	     := 'Start delete with batch size ' || l_delete_batch_size || ', delay ' || l_delete_delay || ' seconds. Delete all marked records older than ' || TO_CHAR(l_delete_before, 'YYYY-MM-DD HH24:MI:SS') || '.';
969  	 otap_log.log(l_delete_msg, l_script, 'Procedure start', 'OTAP_DEBUG');
970  	 FOR rec IN cur_delete_tests(l_delete_before)
971  	 LOOP
972  	   IF l_row_counter >= l_delete_batch_size
973  	   THEN
974  	     l_delete_msg := 'Batch size reached, commit and wait. Processed records ' || l_processed || '.';
975  	     otap_log.log(l_delete_msg, l_script, 'Batch size reached and wait', 'OTAP_DEBUG');
976  	     -- commit the batch
977  	     COMMIT;
978  	     -- reset counter
979  	     l_row_counter := 0;
980  	     -- wait defined time
981  	     DBMS_SESSION.SLEEP(l_delete_delay);
982  	   END IF;
983  	   DELETE FROM otap_results WHERE test_run_id = rec.test_run_id AND test_run_date = rec.test_run_date;
984  	   l_row_counter := l_row_counter + 1;
985  	   l_processed	 := l_processed + 1;
986  	 END LOOP;
987  	 -- commit any pending deletes
988  	 COMMIT;
989  	 l_delete_msg := 'Processed ' || l_processed || ' records for delete. Started at ' || TO_CHAR(l_delete_start, 'YYYY-MM-DD HH24:MI:SS') || ' finished at ' || TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');
990  	 otap_log.log(l_delete_msg, l_script, 'Procedure end', 'OTAP_DEBUG');
991  	 DBMS_OUTPUT.PUT_LINE(l_delete_msg);
992    EXCEPTION
993  	 WHEN OTHERS THEN
994  	   otap_log.log(SQLERRM, l_script, 'DELETE FROM otap_results');
995    END result_cleanup;
996  
997    FUNCTION max_text_size(p_session_id IN NUMBER)
998  	 RETURN NUMBER
999    IS
1000  	  l_result NUMBER;
1001  	BEGIN
1002  	  -- use UNION not GREATEST to get a result in any case
1003  	  SELECT MAX(str_length) AS max_length
1004  	    INTO l_result
1005  	    FROM (SELECT otap_constants.get_otap_num_min_fill_length AS str_length FROM dual
1006  		   UNION ALL
1007  		  SELECT MAX(LENGTH(test_set)) FROM otap_results WHERE test_session_id = p_session_id
1008  		   UNION ALL
1009  		  SELECT MAX(LENGTH(test_group)) FROM otap_results WHERE test_session_id = p_session_id
1010  		   UNION ALL
1011  		  SELECT MAX(LENGTH(test_name)) FROM otap_results WHERE test_session_id = p_session_id
1012  		   UNION ALL
1013  		  SELECT MAX(LENGTH(test_desc)) FROM otap_results WHERE test_session_id = p_session_id
1014  		 )
1015  	  ;
1016  	  RETURN l_result;
1017  	EXCEPTION
1018  	  WHEN OTHERS THEN
1019  	    otap_log.log(SQLERRM, 'otap_util.max_text_size', 'Get max text size for a given session id');
1020  	    RAISE;
1021  	END max_text_size;
1022  
1023  	FUNCTION interval_size
1024  	  RETURN NUMBER
1025  	IS
1026  	  l_interval_size NUMBER;
1027  	BEGIN
1028  	  SELECT LENGTH(TRIM((SYSTIMESTAMP - SYSTIMESTAMP) DAY TO SECOND)) INTO l_interval_size FROM dual;
1029  	  RETURN l_interval_size;
1030  	EXCEPTION
1031  	  WHEN OTHERS THEN
1032  	    otap_log.log(SQLERRM, 'otap_util.interval_size', 'Get interval text size as displayed in SQL');
1033  	    RAISE;
1034  	END interval_size;
1035  
1036  END;
1037  /

