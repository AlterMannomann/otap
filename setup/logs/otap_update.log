100    * @param p_string_length The length of the string to verify.
101    *
102    * @return The given string size or the calculated minimum/maximum size.
103    */
104    FUNCTION check_string_size(p_string_length IN INTEGER DEFAULT 0)
105  	 RETURN NUMBER
106    ;
107  
108    /** FUNCTION otap_string.check_layout
109    * Constraints the layout to allowed values. Invalid values will return otap_constants.OTAP_FALLBACK_LAYOUT_DEFAULT.
110    *
111    * @param p_layout A valid layout orientation indicator as defined in OTAP_CONSTANTS.
112    *
