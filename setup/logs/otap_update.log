242    /** FUNCTION otap_string.decorate_blank
243    * Builds half decorated report lines, like copyright and version messages, with given layout orientation. Will decorate
244    * with blanks if needed. String cutting only if 4000 char are exceeded. Border setting and layout is ignored. Layout is
245    * always Middle.
246    *
247    * @param p_string The string to format with the given orientation.
248    * @param p_min_length The minimum string size to use for padding. Limited by otap_constants.OTAP_NUM_MIN_FILL_LENGTH. Lower values translate to minimum fill length.
249    *
250    * @return The string with a center orientation, decorated with blank if needed.
251    */
252    FUNCTION decorate_blank( p_string      IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
253  			      , p_min_length  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
254  			      )
255  	 RETURN VARCHAR2
256    ;
257  
258    /** FUNCTION otap_string.borderless
259    * Builds not decorated report lines, like results or result headers, with given layout orientation. Only left and right allowed. Middle
260    * will translate to the default otap_constants.OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT. Cutting string is always on the right.
261    * For languages that read from right to left, the templates and headers have to be adjusted accordingly.
262    *
263    * @param p_string The string to format with the given orientation.
264    * @param p_min_length The minimum string size to use for padding. Limited by otap_constants.OTAP_NUM_MIN_FILL_LENGTH. Lower values translate to minimum fill length.
265    * @param p_layout The layout orientation for the string.
266    *
267    * @return The string with the given layout orientation.
268    */
269    FUNCTION borderless( p_string	  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
270  			  , p_min_length  IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
271  			  , p_layout	  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_LAYOUT_RESULT_DEFAULT
272  			  )
273  	 RETURN VARCHAR2
274    ;
