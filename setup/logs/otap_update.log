1253  	FUNCTION generate_schema_tests( p_like_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1254  				      , p_required_user IN VARCHAR2 DEFAULT NULL
1255  				      , p_title_prefix	IN VARCHAR2 DEFAULT NULL
1256  				      , p_show_header	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1257  				      , p_excl_sysgen	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1258  				      )
1259  	  RETURN otap_view_result_tbl PIPELINED
1260  	IS
1261  	  CURSOR cur_tests( cp_like   IN VARCHAR2
1262  			  , cp_users  IN VARCHAR2
1263  			  , cp_prefix IN VARCHAR2
1264  			  , cp_show   IN NUMBER
1265  			  , cp_excl   IN NUMBER
1266  			  )
1267  	  IS
1268  	    SELECT result_text
1269  	      FROM TABLE(otap_generate.schema_tests(cp_like, cp_users, cp_prefix, cp_show, cp_excl))
1270  	  ;
1271  	BEGIN
1272  	  FOR rec IN cur_tests(p_like_schema, p_required_user, p_title_prefix, p_show_header, p_excl_sysgen)
1273  	  LOOP
1274  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1275  	  END LOOP;
1276  	  RETURN;
1277  	EXCEPTION
1278  	  WHEN NO_DATA_NEEDED THEN
1279  	    RAISE;
1280  	END generate_schema_tests;
