270  
271    FUNCTION get_header( p_title_prefix  IN VARCHAR2 DEFAULT NULL
272  			  , p_schema	    IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
273  			  , p_object_type   IN VARCHAR2 DEFAULT NULL
274  			  , p_object	    IN VARCHAR2 DEFAULT NULL
275  			  , p_scope	    IN VARCHAR2 DEFAULT '%'
276  			  , p_script_count  IN NUMBER	DEFAULT 0
277  			  , p_show_header   IN NUMBER	DEFAULT otap_constants.OTAP_NUM_TRUE
278  			  )
279  	 RETURN otap_view_result_tbl PIPELINED
280    IS
281  	 CURSOR cur_fn_header( cp_prefix IN VARCHAR2
282  			     , cp_schema IN VARCHAR2
283  			     , cp_type	 IN VARCHAR2
284  			     , cp_object IN VARCHAR2
285  			     , cp_scope  IN VARCHAR2
286  			     , cp_count  IN NUMBER
287  			     , cp_show	 IN NUMBER
288  			     )
289  	 IS
290  	   SELECT result_text
291  	     FROM TABLE(otap_generate.build_function_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
292  	 ;
293  	 CURSOR cur_prc_header( cp_prefix IN VARCHAR2
294  			      , cp_schema IN VARCHAR2
295  			      , cp_type   IN VARCHAR2
296  			      , cp_object IN VARCHAR2
297  			      , cp_scope  IN VARCHAR2
298  			      , cp_count  IN NUMBER
299  			      , cp_show   IN NUMBER
300  			      )
301  	 IS
302  	   SELECT result_text
303  	     FROM TABLE(otap_generate.build_procedure_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
304  	 ;
305  	 CURSOR cur_scr_header( cp_prefix IN VARCHAR2
306  			      , cp_schema IN VARCHAR2
307  			      , cp_type   IN VARCHAR2
308  			      , cp_object IN VARCHAR2
309  			      , cp_scope  IN VARCHAR2
310  			      , cp_count  IN NUMBER
311  			      , cp_show   IN NUMBER
312  			      )
313  	 IS
314  	   SELECT result_text
315  	     FROM TABLE(otap_generate.build_script_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
316  	 ;
317    BEGIN
318  	 -- only if script count > 0
319  	 IF NVL(p_script_count, 0) > 0
320  	 THEN
321  	   IF generation_type = otap_constants.OTAP_GEN_TYPE_FUNCTION
322  	   THEN
323  	     FOR rec IN cur_fn_header(p_title_prefix, p_schema, p_object_type, p_object, p_scope, p_script_count, p_show_header)
324  	     LOOP
325  	       PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
326  	     END LOOP;
327  	   ELSIF generation_type = otap_constants.OTAP_GEN_TYPE_PROCEDURE
328  	   THEN
329  	     FOR rec IN cur_prc_header(p_title_prefix, p_schema, p_object_type, p_object, p_scope, p_script_count, p_show_header)
330  	     LOOP
331  	       PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
332  	     END LOOP;
333  	   ELSE
334  	     -- all other cases script
335  	     FOR rec IN cur_scr_header(p_title_prefix, p_schema, p_object_type, p_object, p_scope, p_script_count, p_show_header)
336  	     LOOP
337  	       PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
338  	     END LOOP;
339  	   END IF;
340  	 END IF;
341  	 RETURN;
342    EXCEPTION
343  	 WHEN NO_DATA_NEEDED THEN
344  	   RAISE;
345    END get_header;
346  
347    FUNCTION build_script_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
348  	 RETURN otap_view_result_tbl PIPELINED
349    IS
350  	 l_statement   VARCHAR2(4000 CHAR);
351    BEGIN
352  	 -- build finish
353  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
354  	 THEN
355  	   l_statement := '-- end OTAP tests';
356  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
357  	   l_statement := '-- finish test session';
358  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
359  	   l_statement := 'SELECT otap_test.finish_test FROM dual;';
360  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
361  	   l_statement := '/* alternative option get and return finish code';
362  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
363  	   l_statement := 'COLUMN EXIT_CODE NEW_VAL EXIT_CODE';
364  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
365  	   l_statement := 'SELECT otap_test.finish_test_with_exit_code AS EXIT_CODE FROM dual;';
366  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
367  	   l_statement := 'RETURN &' || 'EXIT_CODE';
368  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
369  	   l_statement := '*/';
370  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
371  	   l_statement := '-- get result';
372  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
373  	   l_statement := 'SELECT * FROM otap_latest_test_results_v;';
374  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
375  	   -- add AI and copyright
376  	   l_statement := '-- ' || LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
377  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
378  	   l_statement := '-- ' || LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
379  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
380  	   l_statement := '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT1;
381  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
382  	   l_statement := '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT2;
383  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
384  	   l_statement := '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT3;
385  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
386  	 END IF;
387  	 RETURN;
388    EXCEPTION
389  	 WHEN NO_DATA_NEEDED THEN
390  	   RAISE;
391    END build_script_footer;
392  
393    FUNCTION build_function_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
394  	 RETURN otap_view_result_tbl PIPELINED
395    IS
396  	 l_statement   VARCHAR2(4000 CHAR);
397    BEGIN
398  	 -- build finish
399  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
400  	 THEN
401  	   l_statement := otap_generate.get_code_pad || '-- end OTAP tests';
402  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
403  	   l_statement := otap_generate.get_code_pad || '-- finish test session';
404  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
405  	   l_statement := otap_generate.get_code_pad || 'l_return := otap_test.finish_test_with_exit_code;';
406  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
407  	   l_statement := otap_generate.get_code_pad || '-- you may want to insert functionality to persist the report or id to your system';
408  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
409  	   l_statement := otap_generate.get_code_pad || '-- or consume exceptions to guarantee following functions or procedures will run';
410  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
411  	   -- add AI and copyright
412  	   l_statement := otap_generate.get_code_pad || '-- ' || LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
413  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
414  	   l_statement := otap_generate.get_code_pad || '-- ' || LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
415  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
416  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT1;
417  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
418  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT2;
419  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
420  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT3;
421  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
422  	   l_statement := otap_generate.get_code_pad || 'RETURN l_return;';
423  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
424  	   l_statement := 'END;';
425  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
426  	   l_statement := '/';
427  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
428  	 END IF;
429  	 RETURN;
430    EXCEPTION
431  	 WHEN NO_DATA_NEEDED THEN
432  	   RAISE;
433    END build_function_footer;
434  
435    FUNCTION build_procedure_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
436  	 RETURN otap_view_result_tbl PIPELINED
437    IS
438  	 l_statement   VARCHAR2(4000 CHAR);
439    BEGIN
440  	 -- build finish
441  	 IF p_show_header = otap_constants.OTAP_NUM_TRUE
442  	 THEN
443  	   l_statement := '  -- end OTAP tests';
444  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
445  	   l_statement := otap_generate.get_code_pad || '-- finish test session, consume the return code or act upon result before leaving the procedure';
446  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
447  	   l_statement := otap_generate.get_code_pad || 'l_return := otap_test.finish_test_with_exit_code;';
448  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
449  	   l_statement := otap_generate.get_code_pad || '-- you may want to insert functionality to persist the report or id to your system';
450  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
451  	   l_statement := otap_generate.get_code_pad || '-- or consume exceptions to guarantee following functions or procedures will run';
452  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
453  	   -- add AI and copyright
454  	   l_statement := otap_generate.get_code_pad || '-- ' || LPAD(otap_constants.OTAP_INTERNAL_NAME, 59, ' ');
455  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
456  	   l_statement := otap_generate.get_code_pad || '-- ' || LPAD(otap_constants.OTAP_INTERNAL_VERSION_NR, 47, ' ');
457  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
458  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT1;
459  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
460  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT2;
461  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
462  	   l_statement := otap_generate.get_code_pad || '-- ' || otap_constants.OTAP_INTERNAL_COPYRIGHT3;
463  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
464  	   l_statement := 'END;';
465  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
466  	   l_statement := '/';
467  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
468  	 END IF;
469  	 RETURN;
470    EXCEPTION
471  	 WHEN NO_DATA_NEEDED THEN
472  	   RAISE;
473    END build_procedure_footer;
474  
475    FUNCTION get_footer(p_show_header IN NUMBER DEFAULT otap_constants.OTAP_NUM_TRUE)
476  	 RETURN otap_view_result_tbl PIPELINED
477    IS
478  	 CURSOR cur_fn_footer(cp_show IN NUMBER)
479  	 IS
480  	   SELECT result_text
481  	     FROM TABLE(otap_generate.build_function_footer(cp_show))
482  	 ;
483  	 CURSOR cur_prc_footer(cp_show IN NUMBER)
484  	 IS
485  	   SELECT result_text
486  	     FROM TABLE(otap_generate.build_procedure_footer(cp_show))
487  	 ;
488  	 CURSOR cur_scr_footer(cp_show IN NUMBER)
489  	 IS
490  	   SELECT result_text
491  	     FROM TABLE(otap_generate.build_script_footer(cp_show))
492  	 ;
493    BEGIN
494  	 IF generation_type = otap_constants.OTAP_GEN_TYPE_FUNCTION
495  	 THEN
496  	   FOR rec IN cur_fn_footer(p_show_header)
497  	   LOOP
498  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
499  	   END LOOP;
500  	 ELSIF generation_type = otap_constants.OTAP_GEN_TYPE_PROCEDURE
501  	 THEN
502  	   FOR rec IN cur_prc_footer(p_show_header)
503  	   LOOP
504  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
505  	   END LOOP;
506  	 ELSE
507  	   -- all other cases script
508  	   FOR rec IN cur_scr_footer(p_show_header)
509  	   LOOP
510  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
511  	   END LOOP;
512  	 END IF;
513  	 RETURN;
514    EXCEPTION
515  	 WHEN NO_DATA_NEEDED THEN
516  	   RAISE;
517    END get_footer;
518  
519    FUNCTION column_tests( p_table	      IN VARCHAR2
520  			    , p_like_column   IN VARCHAR2 DEFAULT '%'
521  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
522  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
523  			    , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
524  			    , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
525  			    )
526  	 RETURN otap_view_result_tbl PIPELINED
527    IS
528  	 l_statement   VARCHAR2(4000 CHAR);
529  	 l_schema      VARCHAR2(128 CHAR);
530  	 l_table       VARCHAR2(128 CHAR);
531  	 l_like        VARCHAR2(256 CHAR);
532  	 l_test_count  INTEGER;
533  	 l_pad_par     INTEGER;
534  	 CURSOR cur_columns( cp_schema IN VARCHAR2
535  			   , cp_table  IN VARCHAR2
536  			   , cp_like   IN VARCHAR2
537  			   , cp_excl   IN NUMBER
538  			   )
539  	 IS
540  	   SELECT table_name
541  		, column_name
542  		, owner
543  		, data_type
544  		, data_precision
545  		, data_length
546  		, data_scale
547  		, nullable
548  		, data_default_vc
549  	     FROM dba_tab_columns
550  	    WHERE owner 	 = cp_schema
551  	      AND table_name	 = cp_table
552  	      AND column_name LIKE cp_like ESCAPE '\'
553  	      AND NOT otap_string.is_sys_object(column_name, cp_excl)
554  	    ORDER BY column_id
555  	 ;
556  	 CURSOR cur_header( cp_prefix IN VARCHAR2
557  			  , cp_schema IN VARCHAR2
558  			  , cp_type   IN VARCHAR2
559  			  , cp_object IN VARCHAR2
560  			  , cp_scope  IN VARCHAR2
561  			  , cp_count  IN NUMBER
562  			  , cp_show   IN NUMBER
563  			  )
564  	 IS
565  	   SELECT result_text
566  	     FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
567  	 ;
568  	 CURSOR cur_footer(cp_show IN NUMBER)
569  	 IS
570  	   SELECT result_text
571  	     FROM TABLE(otap_generate.get_footer(cp_show))
572  	 ;
573    BEGIN
574  	 IF p_table IS NOT NULL
575  	 THEN
576  	   l_table	:= otap_string.reduce(p_table, 128);
577  	   l_like	:= NVL(p_like_column, '%');
578  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
579  	   -- get test count
580  	   SELECT COUNT(*)
581  	     INTO l_test_count
582  	     FROM dba_tab_columns
583  	    WHERE owner 	 = l_schema
584  	      AND table_name	 = l_table
585  	      AND column_name LIKE l_like ESCAPE '\'
586  	      AND NOT otap_string.is_sys_object(column_name, p_excl_sysgen)
587  	   ;
588  	   -- get header
589  	   FOR rec IN cur_header(p_title_prefix, l_schema, 'columns', l_table, l_like, l_test_count, p_show_header)
590  	   LOOP
591  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
592  	   END LOOP;
593  	   l_pad_par := otap_generate.get_code_prefix_len + 20;
594  	   FOR rec IN cur_columns(l_schema, l_table, l_like, p_excl_sysgen)
595  	   LOOP
596  	     l_statement := otap_generate.get_code_prefix || 'otap_test.has_column( p_table_name => ''' || rec.table_name || '''';
597  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
598  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
599  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
600  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
601  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
602  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_type => ''' || rec.data_type || '''';
603  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
604  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_length => ' || TRIM(TO_CHAR(rec.data_length));
605  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
606  	     IF rec.data_precision IS NOT NULL
607  	     THEN
608  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_precision => ' || TRIM(TO_CHAR(rec.data_precision));
609  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
610  	     END IF;
611  	     IF rec.data_scale IS NOT NULL
612  	     THEN
613  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_scale => ' || TRIM(TO_CHAR(rec.data_scale));
614  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
615  	     END IF;
616  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_nullable => ''' || rec.nullable || '''';
617  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
618  	     IF     rec.data_default_vc IS NOT NULL
619  		AND NOT otap_string.is_sys_object(rec.data_default_vc, p_excl_sysgen)
620  	     THEN
621  	       IF INSTR(rec.data_default_vc, '''') > 0
622  	       THEN
623  		 l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_default => q''[' || TRIM(rec.data_default_vc) || ']''';
624  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
625  	       ELSE
626  		 l_statement := LPAD(' ', l_pad_par, ' ') || ', p_data_default => ''' || TRIM(rec.data_default_vc) || '''';
627  		 PIPE ROW (otap_view_result_rec(l_statement, NULL));
628  	       END IF;
629  	     END IF;
630  	     l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
631  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
632  	   END LOOP;
633  	   FOR rec IN cur_footer(p_show_header)
634  	   LOOP
635  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
636  	   END LOOP;
637  	 END IF;
638  	 RETURN;
639    EXCEPTION
640  	 WHEN NO_DATA_NEEDED THEN
641  	   RAISE;
642    END column_tests;
643  
644    FUNCTION constraint_tests( p_table	     IN VARCHAR2
645  				, p_like_constraints IN VARCHAR2 DEFAULT '%'
646  				, p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
647  				, p_title_prefix     IN VARCHAR2 DEFAULT NULL
648  				, p_show_header      IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
649  				, p_excl_sysgen      IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
650  				)
651  	 RETURN otap_view_result_tbl PIPELINED
652    IS
653  	 l_statement   VARCHAR2(4000 CHAR);
654  	 l_schema      VARCHAR2(128 CHAR);
655  	 l_table       VARCHAR2(128 CHAR);
656  	 l_like        VARCHAR2(256 CHAR);
657  	 l_test_count  INTEGER;
658  	 l_pad_par     INTEGER;
659  	 -- all constraints except ref and not null
660  	 CURSOR cur_common_constraints( cp_schema IN VARCHAR2
661  				      , cp_table  IN VARCHAR2
662  				      , cp_like   IN VARCHAR2
663  				      , cp_excl   IN NUMBER
664  				      )
665  	 IS
666  	   SELECT dco.owner
667  		, dco.table_name
668  		, dcc.column_name
669  		, dco.constraint_name
670  		, dco.constraint_type
671  		, dco.search_condition_vc
672  		, dco.status
673  		, dco.deferrable
674  		, dco.deferred
675  		, dco.validated
676  		, dco.generated
677  		, dco.index_name
678  		, dco.index_owner
679  	     FROM dba_constraints dco
680  	     LEFT OUTER JOIN dba_cons_columns dcc
681  	       ON dco.owner			   = dcc.owner
682  	      AND dco.constraint_name		   = dcc.constraint_name
683  	      AND dco.table_name		   = dcc.table_name
684  	    WHERE dco.owner			   = cp_schema
685  	      AND dco.table_name		   = cp_table
686  	      AND dco.constraint_name		LIKE cp_like ESCAPE '\'
687  	      AND dco.constraint_type	      NOT IN ('R', 'F')
688  	      AND NVL( INSTR( otap_string.flatten( UPPER(dco.search_condition_vc)
689  						 , 4000)
690  			    , 'IS NOT NULL'
691  			    )
692  		     , 0)			   = 0
693  	      AND NOT otap_string.is_sys_object(dco.constraint_name, cp_excl)
694  	    ORDER BY dco.constraint_type
695  		   , dco.constraint_name
696  		   , dcc.column_name NULLS LAST
697  	 ;
698  	 -- all ref constraints
699  	 CURSOR cur_ref_constraints( cp_schema IN VARCHAR2
700  				   , cp_table  IN VARCHAR2
701  				   , cp_like   IN VARCHAR2
702  				   , cp_excl   IN NUMBER
703  				   )
704  	 IS
705  	   SELECT dco.owner
706  		, dco.table_name
707  		, dcc.column_name
708  		, dco.constraint_name
709  		, dco.constraint_type
710  		, dco.search_condition_vc
711  		, dco.r_owner
712  		, dcr.table_name	   AS r_table_name
713  		, dcr.column_name	   AS r_column_name
714  		, dco.r_constraint_name
715  		, dco.status
716  		, dco.deferrable
717  		, dco.deferred
718  		, dco.validated
719  		, dco.generated
720  		, dco.index_name
721  		, dco.index_owner
722  	     FROM dba_constraints dco
723  	     LEFT OUTER JOIN dba_cons_columns dcc
724  	       ON dco.owner			   = dcc.owner
725  	      AND dco.constraint_name		   = dcc.constraint_name
726  	      AND dco.table_name		   = dcc.table_name
727  	     LEFT OUTER JOIN dba_cons_columns dcr
728  	       ON dco.r_owner			   = dcr.owner
729  	      AND dco.r_constraint_name 	   = dcr.constraint_name
730  	    WHERE dco.owner			   = cp_schema
731  	      AND dco.table_name		   = cp_table
732  	      AND dco.constraint_name		LIKE cp_like ESCAPE '\'
733  	      AND dco.constraint_type		  IN ('R', 'F')
734  	      AND NOT otap_string.is_sys_object(dco.constraint_name, cp_excl)
735  	    ORDER BY dco.constraint_type
736  		   , dco.constraint_name
737  		   , dcc.column_name NULLS LAST
738  	 ;
739  	 -- all not null constraints
740  	 CURSOR cur_not_null_constraints( cp_schema IN VARCHAR2
741  					, cp_table  IN VARCHAR2
742  					, cp_like   IN VARCHAR2
743  					, cp_excl   IN NUMBER
744  					)
745  	 IS
746  	   SELECT dco.owner
747  		, dco.table_name
748  		, dcc.column_name
749  		, dco.constraint_name
750  		, dco.constraint_type
751  		, dco.search_condition_vc
752  		, dco.status
753  		, dco.deferrable
754  		, dco.deferred
755  		, dco.validated
756  		, dco.generated
757  		, dco.index_name
758  		, dco.index_owner
759  	     FROM dba_constraints dco
760  	     LEFT OUTER JOIN dba_cons_columns dcc
761  	       ON dco.owner			   = dcc.owner
762  	      AND dco.constraint_name		   = dcc.constraint_name
763  	      AND dco.table_name		   = dcc.table_name
764  	    WHERE dco.owner			   = cp_schema
765  	      AND dco.table_name		   = cp_table
766  	      AND dco.constraint_name		LIKE cp_like ESCAPE '\'
767  	      AND dco.constraint_type		   = 'C'
768  	      AND INSTR( otap_string.flatten( UPPER(dco.search_condition_vc)
769  					    , 4000)
770  		       , 'IS NOT NULL'
771  		       )			   > 0
772  	    ORDER BY dcc.column_name NULLS LAST
773  	 ;
774  	 CURSOR cur_header( cp_prefix IN VARCHAR2
775  			  , cp_schema IN VARCHAR2
776  			  , cp_type   IN VARCHAR2
777  			  , cp_object IN VARCHAR2
778  			  , cp_scope  IN VARCHAR2
779  			  , cp_count  IN NUMBER
780  			  , cp_show   IN NUMBER
781  			  )
782  	 IS
783  	   SELECT result_text
784  	     FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
785  	 ;
786  	 CURSOR cur_footer(cp_show IN NUMBER)
787  	 IS
788  	   SELECT result_text
789  	     FROM TABLE(otap_generate.get_footer(cp_show))
790  	 ;
791    BEGIN
792  	 IF p_table IS NOT NULL
793  	 THEN
794  	   l_table	:= otap_string.reduce(p_table, 128);
795  	   l_like	:= NVL(p_like_constraints, '%');
796  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
797  	   -- get count
798  	   SELECT COUNT(*)
799  	     INTO l_test_count
800  	     FROM dba_constraints dco
801  	     LEFT OUTER JOIN dba_cons_columns dcc
802  	       ON dco.owner			   = dcc.owner
803  	      AND dco.constraint_name		   = dcc.constraint_name
804  	      AND dco.table_name		   = dcc.table_name
805  	    WHERE dco.owner			   = l_schema
806  	      AND dco.table_name		   = l_table
807  	      AND dco.constraint_name		LIKE l_like ESCAPE '\'
808  	      AND (   INSTR( otap_string.flatten( UPPER(dco.search_condition_vc)
809  						, 4000)
810  			   , 'IS NOT NULL'
811  			   )			     > 0
812  		   OR NOT otap_string.is_sys_object(dco.constraint_name, p_excl_sysgen)
813  		  )
814  	   ;
815  	   -- get header if needed
816  	   FOR rec IN cur_header(p_title_prefix, l_schema, 'constraints', l_table, l_like, l_test_count, p_show_header)
817  	   LOOP
818  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
819  	   END LOOP;
820  	   l_pad_par := otap_generate.get_code_prefix_len + 24;
821  	   -- get first common constraints
822  	   FOR rec IN cur_common_constraints(l_schema, l_table, l_like, p_excl_sysgen)
823  	   LOOP
824  	     l_statement := otap_generate.get_code_prefix || 'otap_test.has_constraint( p_table_name => ''' || rec.table_name || '''';
825  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
826  	     IF rec.constraint_type IS NOT NULL
827  	     THEN
828  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_constraint_type => ''' || rec.constraint_type || '''';
829  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
830  	     END IF;
831  	     IF rec.column_name IS NOT NULL
832  	     THEN
833  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
834  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
835  	     END IF;
836  	     IF rec.constraint_name IS NOT NULL
837  	     THEN
838  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_constraint => ''' || rec.constraint_name || '''';
839  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
840  	     END IF;
841  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
842  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
843  	     l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
844  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
845  	   END LOOP;
846  	   -- then ref constraints
847  	   l_pad_par := otap_generate.get_code_prefix_len + 28;
848  	   FOR rec IN cur_ref_constraints(l_schema, l_table, l_like, p_excl_sysgen)
849  	   LOOP
850  	     l_statement := otap_generate.get_code_prefix || 'otap_test.has_ref_constraint( p_table_name => ''' || rec.table_name || '''';
851  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
852  	     IF rec.constraint_type IS NOT NULL
853  	     THEN
854  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_constraint_type => ''' || rec.constraint_type || '''';
855  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
856  	     END IF;
857  	     IF rec.column_name IS NOT NULL
858  	     THEN
859  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
860  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
861  	     END IF;
862  	     IF rec.constraint_name IS NOT NULL
863  	     THEN
864  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_constraint => ''' || rec.constraint_name || '''';
865  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
866  	     END IF;
867  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
868  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
869  	     IF rec.r_table_name IS NOT NULL
870  	     THEN
871  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_r_table_name => ''' || rec.r_table_name || '''';
872  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
873  	     END IF;
874  	     IF rec.r_column_name IS NOT NULL
875  	     THEN
876  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_r_column_name => ''' || rec.r_column_name || '''';
877  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
878  	     END IF;
879  	     IF rec.r_constraint_name IS NOT NULL
880  	     THEN
881  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_r_constraint => ''' || rec.r_constraint_name || '''';
882  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
883  	     END IF;
884  	     IF rec.r_owner IS NOT NULL
885  	     THEN
886  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_r_schema => ''' || rec.r_owner || '''';
887  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
888  	     END IF;
889  	     l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
890  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
891  	   END LOOP;
892  	   -- finally not null constraints
893  	   l_pad_par := otap_generate.get_code_prefix_len + 33;
894  	   FOR rec IN cur_not_null_constraints(l_schema, l_table, l_like, p_excl_sysgen)
895  	   LOOP
896  	     l_statement := otap_generate.get_code_prefix || 'otap_test.has_not_null_constraint( p_table_name => ''' || rec.table_name || '''';
897  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
898  	     IF rec.column_name IS NOT NULL
899  	     THEN
900  	       l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
901  	       PIPE ROW (otap_view_result_rec(l_statement, NULL));
902  	     END IF;
903  	     l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
904  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
905  	     l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
906  	     PIPE ROW (otap_view_result_rec(l_statement, NULL));
907  	   END LOOP;
908  	   -- add footer if needed
909  	   FOR rec IN cur_footer(p_show_header)
910  	   LOOP
911  	     PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
912  	   END LOOP;
913  	 END IF;
914  	 RETURN;
915    EXCEPTION
916  	 WHEN NO_DATA_NEEDED THEN
917  	   RAISE;
918    END constraint_tests;
919  
920    FUNCTION index_tests( p_table	     IN VARCHAR2
921  			   , p_like_index    IN VARCHAR2 DEFAULT '%'
922  			   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
923  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
924  			   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
925  			   , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
926  			   )
927  	 RETURN otap_view_result_tbl PIPELINED
928    IS
929  	 l_statement   VARCHAR2(4000 CHAR);
930  	 l_schema      VARCHAR2(128 CHAR);
931  	 l_table       VARCHAR2(128 CHAR);
932  	 l_like        VARCHAR2(256 CHAR);
933  	 l_test_count  INTEGER;
934  	 l_pad_par     INTEGER;
935  	 CURSOR cur_indexes( cp_schema IN VARCHAR2
936  			   , cp_table  IN VARCHAR2
937  			   , cp_like   IN VARCHAR2
938  			   , cp_excl   IN NUMBER
939  			   )
940  	 IS
941  	   SELECT dix.index_name
942  		, dix.table_name
943  		, dic.column_name
944  		, dix.index_type
945  		, dix.table_type
946  		, dix.uniqueness
947  		, dix.tablespace_name
948  		, dix.partitioned
949  	     FROM dba_indexes dix
950  	     LEFT OUTER JOIN dba_ind_columns dic
951  	       ON dix.owner	  = dic.index_owner
952  	      AND dix.index_name  = dic.index_name
953  	      AND dix.table_owner = dic.table_owner
954  	      AND dix.table_name  = dic.table_name
955  	    WHERE dix.owner			  = cp_schema
956  	      AND dix.table_name		  = cp_table
957  	      AND dix.index_name	       LIKE cp_like ESCAPE '\'
958  	      AND NOT otap_string.is_sys_object(dix.index_name, cp_excl)
959  	    ORDER BY dix.index_name
960  		   , dic.column_name
961  	 ;
962  	 CURSOR cur_header( cp_prefix IN VARCHAR2
963  			  , cp_schema IN VARCHAR2
964  			  , cp_type   IN VARCHAR2
965  			  , cp_object IN VARCHAR2
966  			  , cp_scope  IN VARCHAR2
967  			  , cp_count  IN NUMBER
968  			  , cp_show   IN NUMBER
969  			  )
970  	 IS
971  	   SELECT result_text
972  	     FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
973  	 ;
974  	 CURSOR cur_footer(cp_show IN NUMBER)
975  	 IS
976  	   SELECT result_text
977  	     FROM TABLE(otap_generate.get_footer(cp_show))
978  	 ;
979    BEGIN
980  	 IF p_table IS NOT NULL
981  	 THEN
982  	   l_table	:= otap_string.reduce(p_table, 128);
983  	   l_like	:= NVL(p_like_index, '%');
984  	   l_schema	:= otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
985  	   -- get count
986  	   SELECT COUNT(*)
987  	     INTO l_test_count
988  	     FROM dba_indexes dix
989  	     LEFT OUTER JOIN dba_ind_columns dic
990  	       ON dix.owner	  = dic.index_owner
991  	      AND dix.index_name  = dic.index_name
992  	      AND dix.table_owner = dic.table_owner
993  	      AND dix.table_name  = dic.table_name
994  	    WHERE dix.owner	    = l_schema
995  	      AND dix.table_name    = l_table
996  	      AND dix.index_name LIKE l_like ESCAPE '\'
997  	      AND NOT otap_string.is_sys_object(dix.index_name, p_excl_sysgen)
998  	   ;
999  	   -- get header if needed
1000  	    FOR rec IN cur_header(p_title_prefix, l_schema, 'indexes', l_table, l_like, l_test_count, p_show_header)
1001  	    LOOP
1002  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1003  	    END LOOP;
1004  	    l_pad_par := otap_generate.get_code_prefix_len + 19;
1005  	    FOR rec IN cur_indexes(l_schema, l_table, l_like, p_excl_sysgen)
1006  	    LOOP
1007  	      l_statement := otap_generate.get_code_prefix || 'otap_test.has_index( p_table_name => ''' || rec.table_name || '''';
1008  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1009  	      IF rec.column_name IS NOT NULL
1010  	      THEN
1011  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
1012  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1013  	      END IF;
1014  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_index_name => ''' || rec.index_name || '''';
1015  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1016  	      IF rec.index_type IS NOT NULL
1017  	      THEN
1018  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_index_type => ''' || rec.index_type || '''';
1019  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1020  	      END IF;
1021  	      IF rec.table_type IS NOT NULL
1022  	      THEN
1023  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_type => ''' || rec.table_type || '''';
1024  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1025  	      END IF;
1026  	      IF rec.uniqueness IS NOT NULL
1027  	      THEN
1028  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_uniqueness => ''' || rec.uniqueness || '''';
1029  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1030  	      END IF;
1031  	      IF rec.tablespace_name IS NOT NULL
1032  	      THEN
1033  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_tablespace_name => ''' || rec.tablespace_name || '''';
1034  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1035  	      END IF;
1036  	      IF rec.partitioned IS NOT NULL
1037  	      THEN
1038  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_partitioned => ''' || rec.partitioned || '''';
1039  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1040  	      END IF;
1041  	      l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1042  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1043  	    END LOOP;
1044  	    -- add footer if needed
1045  	    FOR rec IN cur_footer(p_show_header)
1046  	    LOOP
1047  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1048  	    END LOOP;
1049  	  END IF;
1050  	  RETURN;
1051  	EXCEPTION
1052  	  WHEN NO_DATA_NEEDED THEN
1053  	    RAISE;
1054  	END index_tests;
1055  
1056  	FUNCTION table_tests( p_like_table    IN VARCHAR2 DEFAULT '%'
1057  			    , p_schema	      IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1058  			    , p_title_prefix  IN VARCHAR2 DEFAULT NULL
1059  			    , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1060  			    , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1061  			    )
1062  	  RETURN otap_view_result_tbl PIPELINED
1063  	IS
1064  	  l_statement	VARCHAR2(4000 CHAR);
1065  	  l_schema	VARCHAR2(128 CHAR);
1066  	  l_like	VARCHAR2(256 CHAR);
1067  	  l_test_count	INTEGER;
1068  	  l_pad_par	INTEGER;
1069  	  CURSOR cur_tables( cp_schema IN VARCHAR2
1070  			   , cp_like   IN VARCHAR2
1071  			   , cp_excl   IN NUMBER
1072  			   )
1073  	  IS
1074  	    SELECT object_name AS table_name
1075  	      FROM dba_objects
1076  	     WHERE owner	  = cp_schema
1077  	       AND object_type	  = 'TABLE'
1078  	       AND object_name LIKE cp_like ESCAPE '\'
1079  	       AND NOT otap_string.is_sys_object(object_name, cp_excl)
1080  	  ;
1081  	  CURSOR cur_columns( cp_schema IN VARCHAR2
1082  			    , cp_table	IN VARCHAR2
1083  			    , cp_like	IN VARCHAR2
1084  			    , cp_prefix IN VARCHAR2
1085  			    , cp_excl	IN NUMBER
1086  			    )
1087  	  IS
1088  	    SELECT result_text
1089  	      FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
1090  	  ;
1091  	  CURSOR cur_constraints( cp_schema IN VARCHAR2
1092  				, cp_table  IN VARCHAR2
1093  				, cp_like   IN VARCHAR2
1094  				, cp_prefix IN VARCHAR2
1095  				, cp_excl   IN NUMBER
1096  				)
1097  	  IS
1098  	    SELECT result_text
1099  	      FROM TABLE(otap_generate.constraint_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
1100  	  ;
1101  	  CURSOR cur_indexes( cp_schema IN VARCHAR2
1102  			    , cp_table	IN VARCHAR2
1103  			    , cp_like	IN VARCHAR2
1104  			    , cp_prefix IN VARCHAR2
1105  			    , cp_excl	IN NUMBER
1106  			    )
1107  	  IS
1108  	    SELECT result_text
1109  	      FROM TABLE(otap_generate.index_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
1110  	  ;
1111  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1112  			   , cp_schema IN VARCHAR2
1113  			   , cp_type   IN VARCHAR2
1114  			   , cp_object IN VARCHAR2
1115  			   , cp_scope  IN VARCHAR2
1116  			   , cp_count  IN NUMBER
1117  			   , cp_show   IN NUMBER
1118  			   )
1119  	  IS
1120  	    SELECT result_text
1121  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1122  	  ;
1123  	  CURSOR cur_footer(cp_show IN NUMBER)
1124  	  IS
1125  	    SELECT result_text
1126  	      FROM TABLE(otap_generate.get_footer(cp_show))
1127  	  ;
1128  	BEGIN
1129  	  l_like       := NVL(p_like_table, '%');
1130  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1131  	  -- get test count, simulate conditions of called test generators
1132  	     WITH base AS
1133  		 (SELECT object_name
1134  		       , object_type
1135  		       , owner
1136  		    FROM dba_objects
1137  		   WHERE owner = l_schema
1138  			 -- currently supported objects
1139  		     AND object_type	= 'TABLE'
1140  			 -- user like condition
1141  		     AND object_name LIKE l_like ESCAPE '\'
1142  			 -- user exclude condition
1143  		     AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1144  		 )
1145  		 -- counter objects
1146  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1147  	       , cols AS
1148  		 (SELECT dbc.owner
1149  		       , dbc.table_name
1150  		       , dbc.column_name
1151  		    FROM dba_tab_columns dbc
1152  		   INNER JOIN base
1153  		      ON dbc.owner	= base.owner
1154  		     AND dbc.table_name = base.object_name
1155  			 -- user like condition
1156  		   WHERE dbc.column_name LIKE '%' ESCAPE '\'
1157  			 -- user exclude condition
1158  		     AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
1159  		 )
1160  	       , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
1161  	       , cnt_indexes AS (SELECT COUNT(*) AS expected_count
1162  				   FROM dba_indexes dix
1163  				   LEFT OUTER JOIN dba_ind_columns dic
1164  				     ON dix.owner	= dic.index_owner
1165  				    AND dix.index_name	= dic.index_name
1166  				    AND dix.table_owner = dic.table_owner
1167  				    AND dix.table_name	= dic.table_name
1168  				  WHERE dix.owner = l_schema
1169  				    AND NOT otap_string.is_sys_object(dix.index_name, p_excl_sysgen)
1170  				)
1171  	       , cnt_constraints AS (SELECT COUNT(*) AS expected_count
1172  				       FROM dba_constraints dco
1173  				       LEFT OUTER JOIN dba_cons_columns dcc
1174  					 ON dco.owner			     = dcc.owner
1175  					AND dco.constraint_name 	     = dcc.constraint_name
1176  					AND dco.table_name		     = dcc.table_name
1177  				      WHERE dco.owner			     = l_schema
1178  					AND (	INSTR( otap_string.flatten( UPPER(dco.search_condition_vc)
1179  									  , 4000)
1180  						     , 'IS NOT NULL'
1181  						     )			       > 0
1182  					     OR NOT otap_string.is_sys_object(dco.constraint_name, p_excl_sysgen)
1183  					    )
1184  				    )
1185  	       , cnt AS
1186  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
1187  		   UNION ALL
1188  		  SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
1189  		   UNION ALL
1190  		  SELECT expected_count, 'CONSTRAINTS' AS info FROM cnt_constraints
1191  		   UNION ALL
1192  		  SELECT expected_count, 'INDEXES' AS info FROM cnt_indexes
1193  		 )
1194  	  SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1195  	  -- get header
1196  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'tables', NULL, l_like, l_test_count, p_show_header)
1197  	  LOOP
1198  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1199  	  END LOOP;
1200  	  l_pad_par := otap_generate.get_code_prefix_len + 19;
1201  	  -- build group row
1202  	  l_statement := otap_generate.get_code_pad || '-- set test group for tables';
1203  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1204  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''tables'')' || otap_generate.get_code_postfix;
1205  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1206  	  FOR rec IN cur_tables(l_schema, l_like, p_excl_sysgen)
1207  	  LOOP
1208  	    l_statement := otap_generate.get_code_pad || '-- set test name for table';
1209  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1210  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''table ' || rec.table_name || ''')' || otap_generate.get_code_postfix;
1211  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1212  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_table( p_table_name => ''' || rec.table_name || '''';
1213  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1214  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1215  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1216  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1217  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1218  	    -- columns
1219  	    FOR colrec IN cur_columns(l_schema, rec.table_name, '%', p_title_prefix, p_excl_sysgen)
1220  	    LOOP
1221  	      PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
1222  	    END LOOP;
1223  	    -- constraints
1224  	    FOR consrec IN cur_constraints(l_schema, rec.table_name, '%', p_title_prefix, p_excl_sysgen)
1225  	    LOOP
1226  	      PIPE ROW (otap_view_result_rec(consrec.result_text, NULL));
1227  	    END LOOP;
1228  	    -- indexes
1229  	    FOR consrec IN cur_indexes(l_schema, rec.table_name, '%', p_title_prefix, p_excl_sysgen)
1230  	    LOOP
1231  	      PIPE ROW (otap_view_result_rec(consrec.result_text, NULL));
1232  	    END LOOP;
1233  	  END LOOP;
1234  	  FOR rec IN cur_footer(p_show_header)
1235  	  LOOP
1236  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1237  	  END LOOP;
1238  	  RETURN;
1239  	EXCEPTION
1240  	  WHEN NO_DATA_NEEDED THEN
1241  	    RAISE;
1242  	END table_tests;
1243  
1244  	FUNCTION trigger_tests( p_like_trigger	IN VARCHAR2 DEFAULT '%'
1245  			      , p_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1246  			      , p_title_prefix	IN VARCHAR2 DEFAULT NULL
1247  			      , p_show_header	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1248  			      , p_excl_sysgen	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1249  			      )
1250  	  RETURN otap_view_result_tbl PIPELINED
1251  	IS
1252  	  l_statement	VARCHAR2(4000 CHAR);
1253  	  l_schema	VARCHAR2(128 CHAR);
1254  	  l_like	VARCHAR2(256 CHAR);
1255  	  l_count	INTEGER;
1256  	  l_test_count	INTEGER;
1257  	  l_pad_par	INTEGER;
1258  	  CURSOR cur_table_trigger( cp_schema IN VARCHAR2
1259  				  , cp_like   IN VARCHAR2
1260  				  , cp_excl   IN NUMBER
1261  				  )
1262  	  IS
1263  	    SELECT table_name
1264  	      FROM dba_triggers
1265  	     WHERE owner	   = cp_schema
1266  	       AND table_name	  IS NOT NULL
1267  	       AND trigger_name LIKE cp_like ESCAPE '\'
1268  	       AND NOT otap_string.is_sys_object(table_name, cp_excl)
1269  	       AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
1270  	     GROUP BY table_name
1271  	     ORDER BY table_name
1272  	  ;
1273  	  CURSOR cur_trigger( cp_schema IN VARCHAR2
1274  			    , cp_table	IN VARCHAR2
1275  			    , cp_like	IN VARCHAR2
1276  			    , cp_excl	IN NUMBER
1277  			    )
1278  	  IS
1279  	    SELECT trigger_name
1280  		 , table_name
1281  		 , table_owner
1282  		 , owner
1283  		 , trigger_type
1284  		 , triggering_event
1285  	      FROM dba_triggers
1286  	     WHERE owner	   = cp_schema
1287  	       AND table_name	   = cp_table
1288  	       AND trigger_name LIKE cp_like ESCAPE '\'
1289  	       AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
1290  	     ORDER BY trigger_name
1291  	  ;
1292  	  CURSOR cur_other_trigger( cp_schema IN VARCHAR2
1293  				  , cp_like   IN VARCHAR2
1294  				  , cp_excl   IN NUMBER
1295  				  )
1296  	  IS
1297  	    SELECT trigger_name
1298  		 , owner
1299  		 , trigger_type
1300  		 , triggering_event
1301  	      FROM dba_triggers
1302  	     WHERE owner	   = cp_schema
1303  	       AND table_name	  IS NULL
1304  	       AND trigger_name LIKE cp_like ESCAPE '\'
1305  	       AND NOT otap_string.is_sys_object(trigger_name, cp_excl)
1306  	     ORDER BY trigger_name
1307  	  ;
1308  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1309  			   , cp_schema IN VARCHAR2
1310  			   , cp_type   IN VARCHAR2
1311  			   , cp_object IN VARCHAR2
1312  			   , cp_scope  IN VARCHAR2
1313  			   , cp_count  IN NUMBER
1314  			   , cp_show   IN NUMBER
1315  			   )
1316  	  IS
1317  	    SELECT result_text
1318  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1319  	  ;
1320  	  CURSOR cur_footer(cp_show IN NUMBER)
1321  	  IS
1322  	    SELECT result_text
1323  	      FROM TABLE(otap_generate.get_footer(cp_show))
1324  	  ;
1325  	BEGIN
1326  	  l_like       := NVL(p_like_trigger, '%');
1327  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1328  	  -- get test count
1329  	  SELECT COUNT(*)
1330  	    INTO l_test_count
1331  	    FROM dba_triggers
1332  	   WHERE owner		 = l_schema
1333  	     AND trigger_name LIKE l_like ESCAPE '\'
1334  	     AND NOT otap_string.is_sys_object(trigger_name, p_excl_sysgen)
1335  	  ;
1336  	  -- get header
1337  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'trigger', NULL, l_like, l_test_count, p_show_header)
1338  	  LOOP
1339  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1340  	  END LOOP;
1341  	  l_pad_par := otap_generate.get_code_prefix_len + 21;
1342  	  l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_group(''trigger'')' || otap_generate.get_code_postfix;
1343  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1344  	  SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NOT NULL;
1345  	  IF l_count > 0
1346  	  THEN
1347  	    FOR rec IN cur_table_trigger(l_schema, l_like, p_excl_sysgen)
1348  	    LOOP
1349  	      -- build name
1350  	      l_statement := otap_generate.get_code_pad || '-- set test name for table trigger';
1351  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1352  	      l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_name(''table trigger ' || rec.table_name || ''')' || otap_generate.get_code_postfix;
1353  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1354  	      FOR rectrg IN cur_trigger(l_schema, rec.table_name, '%', p_excl_sysgen)
1355  	      LOOP
1356  		l_statement := otap_generate.get_code_prefix || 'otap_test.has_trigger( p_trigger_name => ''' || rectrg.trigger_name || '''';
1357  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1358  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rectrg.owner || '''';
1359  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1360  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_type => ''' || TRIM(rectrg.trigger_type) || '''';
1361  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1362  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_event => ''' || TRIM(rectrg.triggering_event) || '''';
1363  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1364  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_owner => ''' || TRIM(rectrg.table_owner) || '''';
1365  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1366  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_name => ''' || TRIM(rectrg.table_name) || '''';
1367  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1368  		l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1369  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
1370  	      END LOOP;
1371  	    END LOOP;
1372  	  END IF;
1373  	  -- trigger without table
1374  	  SELECT COUNT(*) INTO l_count FROM dba_triggers WHERE owner = l_schema AND table_name IS NULL;
1375  	  IF l_count > 0
1376  	  THEN
1377  	    l_statement := otap_generate.get_code_pad || '-- set test name for non table trigger';
1378  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1379  	    l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_name(''trigger without table'')' || otap_generate.get_code_postfix;
1380  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1381  	    FOR rec IN cur_other_trigger(l_schema, l_like, p_excl_sysgen)
1382  	    LOOP
1383  	      l_statement := otap_generate.get_code_prefix || 'otap_test.has_trigger( p_trigger_name => ''' || rec.trigger_name || '''';
1384  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1385  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
1386  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1387  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_type => ''' || TRIM(rec.trigger_type) || '''';
1388  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1389  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_trigger_event => ''' || TRIM(rec.triggering_event) || '''';
1390  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1391  	      l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1392  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1393  	    END LOOP;
1394  	  END IF;
1395  	  FOR rec IN cur_footer(p_show_header)
1396  	  LOOP
1397  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1398  	  END LOOP;
1399  	  RETURN;
1400  	EXCEPTION
1401  	  WHEN NO_DATA_NEEDED THEN
1402  	    RAISE;
1403  	END trigger_tests;
1404  
1405  	FUNCTION procedure_tests( p_like_procedure IN VARCHAR2 DEFAULT '%'
1406  				, p_package_name   IN VARCHAR  DEFAULT NULL
1407  				, p_schema	   IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1408  				, p_title_prefix   IN VARCHAR2 DEFAULT NULL
1409  				, p_show_header    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1410  				, p_excl_sysgen    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1411  				)
1412  	  RETURN otap_view_result_tbl PIPELINED
1413  	IS
1414  	  l_statement	VARCHAR2(4000 CHAR);
1415  	  l_schema	VARCHAR2(128 CHAR);
1416  	  l_like	VARCHAR2(256 CHAR);
1417  	  l_package	VARCHAR2(128 CHAR);
1418  	  l_test_count	INTEGER;
1419  	  l_pad_par	INTEGER;
1420  	  CURSOR cur_procedures( cp_schema  IN VARCHAR2
1421  			       , cp_package IN VARCHAR2
1422  			       , cp_like    IN VARCHAR2
1423  			       , cp_excl    IN NUMBER
1424  			       )
1425  	  IS
1426  	      WITH prc AS
1427  		   (SELECT dbo.owner
1428  			 , dbp.procedure_name
1429  			 , CASE
1430  			     WHEN dbr.position	     = 0
1431  			      AND dbr.argument_name IS NULL
1432  			     THEN 'FUNCTION'
1433  			     ELSE 'PROCEDURE'
1434  			   END AS procedure_type
1435  			 , CASE
1436  			     WHEN dbr.position	     = 0
1437  			      AND dbr.argument_name IS NULL
1438  			     THEN dbr.data_type
1439  			     ELSE NULL
1440  			   END AS return_type
1441  			 , dbo.status
1442  			 , dbo.object_name AS package_name
1443  		      FROM dba_objects dbo
1444  		      LEFT OUTER JOIN dba_procedures dbp
1445  			ON dbo.owner	   = dbp.owner
1446  		       AND dbo.object_name = dbp.object_name
1447  		       AND dbo.object_type = dbp.object_type
1448  		      LEFT OUTER JOIN dba_arguments dbr
1449  			ON dbp.owner	     = dbr.owner
1450  		       AND dbp.object_name   = dbr.package_name
1451  		       AND dbp.procedure_name = dbr.object_name
1452  		       AND dbp.object_id     = dbr.object_id
1453  		       AND dbp.subprogram_id = dbr.subprogram_id
1454  		       AND dbr.sequence      = 1
1455  		     WHERE dbo.owner	    = cp_schema
1456  		       AND dbo.object_type  = 'PACKAGE'
1457  			   -- exclude package itself
1458  		       AND dbp.procedure_name IS NOT NULL
1459  		       AND NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl)
1460  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1461  		     UNION ALL
1462  		    SELECT dbo.owner
1463  			 , dbo.object_name AS procedure_name
1464  			 , dbo.object_type AS procedure_type
1465  			 , CASE
1466  			     WHEN dbr.position	     = 0
1467  			      AND dbr.argument_name IS NULL
1468  			     THEN dbr.data_type
1469  			     ELSE NULL
1470  			   END AS return_type
1471  			 , dbo.status
1472  			 , NULL AS package_name
1473  		      FROM dba_objects dbo
1474  		      LEFT OUTER JOIN dba_procedures dbp
1475  			ON dbo.owner	   = dbp.owner
1476  		       AND dbo.object_name = dbp.object_name
1477  		       AND dbo.object_type = dbp.object_type
1478  		      LEFT OUTER JOIN dba_arguments dbr
1479  			ON dbp.owner	     = dbr.owner
1480  		       AND dbp.object_name   = dbr.object_name
1481  		       AND dbp.object_id     = dbr.object_id
1482  		       AND dbp.subprogram_id = dbr.subprogram_id
1483  		       AND dbr.sequence      = 1
1484  		     WHERE dbo.owner	    = cp_schema
1485  		       AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
1486  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1487  		   )
1488  	    SELECT DISTINCT
1489  		   owner
1490  		 , procedure_name
1491  		 , procedure_type
1492  		 , return_type
1493  		 , status
1494  		 , package_name
1495  	      FROM prc
1496  	     WHERE NVL(package_name, 'N/A') = NVL(cp_package, 'N/A')
1497  	       AND procedure_name	 LIKE cp_like ESCAPE '\'
1498  	  ;
1499  	  CURSOR cur_count( cp_schema  IN VARCHAR2
1500  			  , cp_package IN VARCHAR2
1501  			  , cp_like    IN VARCHAR2
1502  			  , cp_excl    IN NUMBER
1503  			  )
1504  	  IS
1505  	      WITH prc AS
1506  		   (SELECT dbo.owner
1507  			 , dbp.procedure_name
1508  			 , CASE
1509  			     WHEN dbr.position	     = 0
1510  			      AND dbr.argument_name IS NULL
1511  			     THEN 'FUNCTION'
1512  			     ELSE 'PROCEDURE'
1513  			   END AS procedure_type
1514  			 , CASE
1515  			     WHEN dbr.position	     = 0
1516  			      AND dbr.argument_name IS NULL
1517  			     THEN dbr.data_type
1518  			     ELSE NULL
1519  			   END AS return_type
1520  			 , dbo.status
1521  			 , dbo.object_name AS package_name
1522  		      FROM dba_objects dbo
1523  		      LEFT OUTER JOIN dba_procedures dbp
1524  			ON dbo.owner	   = dbp.owner
1525  		       AND dbo.object_name = dbp.object_name
1526  		       AND dbo.object_type = dbp.object_type
1527  		      LEFT OUTER JOIN dba_arguments dbr
1528  			ON dbp.owner	     = dbr.owner
1529  		       AND dbp.object_name   = dbr.package_name
1530  		       AND dbp.procedure_name = dbr.object_name
1531  		       AND dbp.object_id     = dbr.object_id
1532  		       AND dbp.subprogram_id = dbr.subprogram_id
1533  		       AND dbr.sequence      = 1
1534  		     WHERE dbo.owner	    = cp_schema
1535  		       AND dbo.object_type  = 'PACKAGE'
1536  			   -- exclude package itself
1537  		       AND dbp.procedure_name IS NOT NULL
1538  		       AND NOT otap_string.is_sys_object(dbp.procedure_name, cp_excl)
1539  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1540  		     UNION ALL
1541  		    SELECT dbo.owner
1542  			 , dbo.object_name AS procedure_name
1543  			 , dbo.object_type AS procedure_type
1544  			 , CASE
1545  			     WHEN dbr.position	     = 0
1546  			      AND dbr.argument_name IS NULL
1547  			     THEN dbr.data_type
1548  			     ELSE NULL
1549  			   END AS return_type
1550  			 , dbo.status
1551  			 , NULL AS package_name
1552  		      FROM dba_objects dbo
1553  		      LEFT OUTER JOIN dba_procedures dbp
1554  			ON dbo.owner	   = dbp.owner
1555  		       AND dbo.object_name = dbp.object_name
1556  		       AND dbo.object_type = dbp.object_type
1557  		      LEFT OUTER JOIN dba_arguments dbr
1558  			ON dbp.owner	     = dbr.owner
1559  		       AND dbp.object_name   = dbr.object_name
1560  		       AND dbp.object_id     = dbr.object_id
1561  		       AND dbp.subprogram_id = dbr.subprogram_id
1562  		       AND dbr.sequence      = 1
1563  		     WHERE dbo.owner	    = cp_schema
1564  		       AND dbo.object_type IN ('FUNCTION', 'PROCEDURE')
1565  		       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
1566  		   )
1567  		 , res AS
1568  		   (SELECT DISTINCT
1569  			   owner
1570  			 , procedure_name
1571  			 , procedure_type
1572  			 , return_type
1573  			 , status
1574  			 , package_name
1575  		      FROM prc
1576  		     WHERE NVL(package_name, 'N/A') = NVL(cp_package, 'N/A')
1577  		       AND procedure_name	 LIKE cp_like ESCAPE '\'
1578  		   )
1579  	  SELECT COUNT(*) AS test_count FROM res;
1580  
1581  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1582  			   , cp_schema IN VARCHAR2
1583  			   , cp_type   IN VARCHAR2
1584  			   , cp_object IN VARCHAR2
1585  			   , cp_scope  IN VARCHAR2
1586  			   , cp_count  IN NUMBER
1587  			   , cp_show   IN NUMBER
1588  			   )
1589  	  IS
1590  	    SELECT result_text
1591  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1592  	  ;
1593  	  CURSOR cur_footer(cp_show IN NUMBER)
1594  	  IS
1595  	    SELECT result_text
1596  	      FROM TABLE(otap_generate.get_footer(cp_show))
1597  	  ;
1598  	BEGIN
1599  	  l_like       := NVL(p_like_procedure, '%');
1600  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1601  	  OPEN cur_count(l_schema, p_package_name, l_like, p_excl_sysgen);
1602  	  FETCH cur_count INTO l_test_count;
1603  	  CLOSE cur_count;
1604  	  -- get header
1605  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'procedures', NULL, l_like, l_test_count, p_show_header)
1606  	  LOOP
1607  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1608  	  END LOOP;
1609  	  l_pad_par := otap_generate.get_code_prefix_len + 23;
1610  	  FOR rec IN cur_procedures(l_schema, p_package_name, l_like, p_excl_sysgen)
1611  	  LOOP
1612  	    IF p_package_name IS NULL
1613  	    THEN
1614  	      -- set name if not package, otherwise name is already set
1615  	      l_statement := otap_generate.get_code_pad || '-- set test name for not package procedures and functions';
1616  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1617  	      l_statement :=  otap_generate.get_code_prefix || 'otap_test.set_test_name(''' || rec.procedure_type || ' ' || rec.procedure_name || ''')' || otap_generate.get_code_postfix;
1618  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1619  	    END IF;
1620  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_procedure( p_procedure_name => ''' || rec.procedure_name || '''';
1621  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1622  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1623  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1624  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_procedure_type => ''' || rec.procedure_type || '''';
1625  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1626  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_package_name => ''' || rec.package_name || '''';
1627  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1628  	    IF rec.procedure_type = 'FUNCTION'
1629  	    THEN
1630  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_return_type => ''' || rec.return_type || '''';
1631  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1632  	    END IF;
1633  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1634  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1635  	  END LOOP;
1636  	  FOR rec IN cur_footer(p_show_header)
1637  	  LOOP
1638  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1639  	  END LOOP;
1640  	  RETURN;
1641  	EXCEPTION
1642  	  WHEN NO_DATA_NEEDED THEN
1643  	    RAISE;
1644  	END procedure_tests;
1645  
1646  	FUNCTION package_tests( p_like_package	IN VARCHAR2 DEFAULT '%'
1647  			      , p_schema	IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1648  			      , p_title_prefix	IN VARCHAR2 DEFAULT NULL
1649  			      , p_show_header	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1650  			      , p_excl_sysgen	IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1651  			      )
1652  	  RETURN otap_view_result_tbl PIPELINED
1653  	IS
1654  	  l_statement	VARCHAR2(4000 CHAR);
1655  	  l_schema	VARCHAR2(128 CHAR);
1656  	  l_like	VARCHAR2(256 CHAR);
1657  	  l_count	INTEGER;
1658  	  l_test_count	INTEGER;
1659  	  l_pad_par	INTEGER;
1660  	  CURSOR cur_packages( cp_schema IN VARCHAR2
1661  			     , cp_like	 IN VARCHAR2
1662  			     , cp_excl	 IN NUMBER
1663  			     )
1664  	  IS
1665  	    SELECT object_name AS package_name
1666  		 , COUNT(*)    AS package_objects
1667  	      FROM dba_objects
1668  	     WHERE owner	  = cp_schema
1669  	       AND object_type LIKE 'PACKAGE%'
1670  	       AND object_name LIKE cp_like ESCAPE '\'
1671  	       AND NOT otap_string.is_sys_object(object_name, cp_excl)
1672  	     GROUP BY object_name
1673  	  ;
1674  	  CURSOR cur_procedures( cp_schema  IN VARCHAR2
1675  			       , cp_package IN VARCHAR2
1676  			       , cp_like    IN VARCHAR2
1677  			       , cp_prefix  IN VARCHAR2
1678  			       , cp_excl    IN NUMBER
1679  			       )
1680  	  IS
1681  	    SELECT result_text
1682  	      FROM TABLE(otap_generate.procedure_tests(cp_like, cp_package, cp_schema, cp_prefix, 0, cp_excl))
1683  	  ;
1684  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1685  			   , cp_schema IN VARCHAR2
1686  			   , cp_type   IN VARCHAR2
1687  			   , cp_object IN VARCHAR2
1688  			   , cp_scope  IN VARCHAR2
1689  			   , cp_count  IN NUMBER
1690  			   , cp_show   IN NUMBER
1691  			   )
1692  	  IS
1693  	    SELECT result_text
1694  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1695  	  ;
1696  	  CURSOR cur_footer(cp_show IN NUMBER)
1697  	  IS
1698  	    SELECT result_text
1699  	      FROM TABLE(otap_generate.get_footer(cp_show))
1700  	  ;
1701  	BEGIN
1702  	  l_like       := NVL(p_like_package, '%');
1703  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1704  	  -- get test count, simulate conditions of called test generators
1705  	     WITH base AS
1706  		 (SELECT object_name
1707  		       , object_type
1708  		       , owner
1709  		    FROM dba_objects
1710  		   WHERE owner = l_schema
1711  			 -- currently supported objects
1712  		     AND object_type LIKE 'PACKAGE%'
1713  			 -- user like condition
1714  		     AND object_name LIKE l_like ESCAPE '\'
1715  			 -- user exclude condition
1716  		     AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1717  		 )
1718  		 -- counter objects
1719  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1720  		 -- depending procedures
1721  	       , prc AS
1722  		 (SELECT dbp.procedure_name
1723  		       , dbp.object_name
1724  		       , dbp.object_type
1725  		    FROM dba_procedures dbp
1726  		   INNER JOIN base
1727  		      ON dbp.object_name = base.object_name
1728  		     AND dbp.object_type = base.object_type
1729  		     AND dbp.owner	 = base.owner
1730  			 -- exclude pure functions and procedures, already counted by base
1731  		     AND base.object_type NOT IN ('FUNCTION', 'PROCEDURE')
1732  			 -- user exclude condition
1733  		   WHERE NOT otap_string.is_sys_object(dbp.procedure_name, p_excl_sysgen)
1734  		 )
1735  	       , cnt_prc AS (SELECT COUNT(*) AS expected_count FROM prc)
1736  	       , cnt AS
1737  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
1738  		   UNION ALL
1739  		  SELECT expected_count, 'PROCEDURES' AS info FROM cnt_prc
1740  		 )
1741  	  SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1742  	  -- get header
1743  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'packages', NULL, l_like, l_test_count, p_show_header)
1744  	  LOOP
1745  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1746  	  END LOOP;
1747  	  l_pad_par := otap_generate.get_code_prefix_len + 21;
1748  	  -- build group row
1749  	  l_statement := otap_generate.get_code_pad || '-- set test group for package';
1750  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1751  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''packages'')' || otap_generate.get_code_postfix;
1752  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1753  	  -- first loop through packages
1754  	  FOR rec IN cur_packages(l_schema, l_like, p_excl_sysgen)
1755  	  LOOP
1756  	    l_statement := otap_generate.get_code_pad || '-- set test name for package';
1757  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1758  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''package ' || rec.package_name || ''')' || otap_generate.get_code_postfix;
1759  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1760  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
1761  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1762  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1763  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1764  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1765  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1766  	    IF rec.package_objects = 2
1767  	    THEN
1768  	      l_statement := otap_generate.get_code_prefix || 'otap_test.has_package( p_package_name => ''' || rec.package_name || '''';
1769  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1770  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1771  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1772  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_package_type => ''PACKAGE BODY''';
1773  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1774  	      l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1775  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
1776  	    END IF;
1777  	    -- now loop through the package procedures and functions
1778  	    FOR recfn IN cur_procedures(l_schema, rec.package_name, '%', p_title_prefix, p_excl_sysgen)
1779  	    LOOP
1780  	      PIPE ROW (otap_view_result_rec(recfn.result_text, NULL));
1781  	    END LOOP;
1782  	  END LOOP;
1783  	  FOR rec IN cur_footer(p_show_header)
1784  	  LOOP
1785  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1786  	  END LOOP;
1787  	  RETURN;
1788  	EXCEPTION
1789  	  WHEN NO_DATA_NEEDED THEN
1790  	    RAISE;
1791  	END package_tests;
1792  
1793  	FUNCTION view_tests( p_like_view     IN VARCHAR2 DEFAULT '%'
1794  			   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
1795  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
1796  			   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1797  			   , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1798  			   )
1799  	  RETURN otap_view_result_tbl PIPELINED
1800  	IS
1801  	  l_statement	VARCHAR2(4000 CHAR);
1802  	  l_schema	VARCHAR2(128 CHAR);
1803  	  l_like	VARCHAR2(256 CHAR);
1804  	  l_test_count	INTEGER;
1805  	  l_pad_par	INTEGER;
1806  	  CURSOR cur_views( cp_schema IN VARCHAR2
1807  			  , cp_like   IN VARCHAR2
1808  			  , cp_excl   IN NUMBER
1809  			  )
1810  	  IS
1811  	    SELECT owner
1812  		 , object_name AS view_name
1813  		 , object_type
1814  	      FROM dba_objects
1815  	     WHERE owner	  = cp_schema
1816  	       AND object_type LIKE '%VIEW'
1817  	       AND object_name LIKE cp_like ESCAPE '\'
1818  	       AND NOT otap_string.is_sys_object(object_name, cp_excl)
1819  	     ORDER BY object_type DESC
1820  		    , object_name
1821  	  ;
1822  	  CURSOR cur_columns( cp_schema IN VARCHAR2
1823  			    , cp_table	IN VARCHAR2
1824  			    , cp_like	IN VARCHAR2
1825  			    , cp_prefix IN VARCHAR2
1826  			    , cp_excl	IN NUMBER
1827  			    )
1828  	  IS
1829  	    SELECT result_text
1830  	      FROM TABLE(otap_generate.column_tests(cp_table, cp_like, cp_schema, cp_prefix, 0, cp_excl))
1831  	  ;
1832  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1833  			   , cp_schema IN VARCHAR2
1834  			   , cp_type   IN VARCHAR2
1835  			   , cp_object IN VARCHAR2
1836  			   , cp_scope  IN VARCHAR2
1837  			   , cp_count  IN NUMBER
1838  			   , cp_show   IN NUMBER
1839  			   )
1840  	  IS
1841  	    SELECT result_text
1842  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1843  	  ;
1844  	  CURSOR cur_footer(cp_show IN NUMBER)
1845  	  IS
1846  	    SELECT result_text
1847  	      FROM TABLE(otap_generate.get_footer(cp_show))
1848  	  ;
1849  	BEGIN
1850  	  l_like       := NVL(p_like_view, '%');
1851  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
1852  	  -- get test count, simulate conditions of called test generators
1853  	     WITH base AS
1854  		 (SELECT object_name
1855  		       , object_type
1856  		       , owner
1857  		    FROM dba_objects
1858  		   WHERE owner = l_schema
1859  			 -- currently supported objects
1860  		     AND object_type LIKE '%VIEW'
1861  			 -- user like condition
1862  		     AND object_name LIKE l_like ESCAPE '\'
1863  			 -- user exclude condition
1864  		     AND NOT otap_string.is_sys_object(object_name, p_excl_sysgen)
1865  		 )
1866  		 -- counter objects
1867  	       , cnt_base AS (SELECT COUNT(*) AS expected_count FROM base)
1868  	       , cols AS
1869  		 (SELECT dbc.owner
1870  		       , dbc.table_name
1871  		       , dbc.column_name
1872  		    FROM dba_tab_columns dbc
1873  		   INNER JOIN base
1874  		      ON dbc.owner	= base.owner
1875  		     AND dbc.table_name = base.object_name
1876  			 -- user like condition
1877  		   WHERE dbc.column_name LIKE '%' ESCAPE '\'
1878  			 -- user exclude condition
1879  		     AND NOT otap_string.is_sys_object(dbc.column_name, p_excl_sysgen)
1880  		 )
1881  	       , cnt_cols AS (SELECT COUNT(*) AS expected_count FROM cols)
1882  	       , cnt AS
1883  		 (SELECT expected_count, 'BASE' AS info FROM cnt_base
1884  		   UNION ALL
1885  		  SELECT expected_count, 'COLUMNS' AS info FROM cnt_cols
1886  		 )
1887  	  SELECT SUM(expected_count) INTO l_test_count FROM cnt;
1888  	  -- get header
1889  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'views', NULL, l_like, l_test_count, p_show_header)
1890  	  LOOP
1891  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1892  	  END LOOP;
1893  	  l_pad_par := otap_generate.get_code_prefix_len + 20;
1894  	  -- build group row
1895  	  l_statement := otap_generate.get_code_pad || '-- set test group for views';
1896  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1897  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''views'')' || otap_generate.get_code_postfix;
1898  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
1899  	  -- first loop through views
1900  	  FOR rec IN cur_views(l_schema, l_like, p_excl_sysgen)
1901  	  LOOP
1902  	    l_statement := otap_generate.get_code_pad || '-- set test name for view';
1903  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1904  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''view ' || rec.view_name || ''')' || otap_generate.get_code_postfix;
1905  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1906  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_object( p_object_name => ''' || rec.view_name || '''';
1907  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1908  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_object_type => ''' || rec.object_type || '''';
1909  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1910  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || l_schema || '''';
1911  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1912  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
1913  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1914  	    FOR colrec IN cur_columns(l_schema, rec.view_name, '%', p_title_prefix, p_excl_sysgen)
1915  	    LOOP
1916  	      PIPE ROW (otap_view_result_rec(colrec.result_text, NULL));
1917  	    END LOOP;
1918  	  END LOOP;
1919  	  FOR rec IN cur_footer(p_show_header)
1920  	  LOOP
1921  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1922  	  END LOOP;
1923  	  RETURN;
1924  	EXCEPTION
1925  	  WHEN NO_DATA_NEEDED THEN
1926  	    RAISE;
1927  	END view_tests;
1928  
1929  	FUNCTION schema_user_test( p_schema	   IN VARCHAR2 DEFAULT NULL
1930  				 , p_title_prefix  IN VARCHAR2 DEFAULT NULL
1931  				 , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
1932  				 )
1933  	  RETURN otap_view_result_tbl PIPELINED
1934  	IS
1935  	  l_statement	VARCHAR2(4000 CHAR);
1936  	  l_test_count	INTEGER;
1937  	  l_pad_par	INTEGER;
1938  	  CURSOR cur_user(cp_schema IN VARCHAR2)
1939  	  IS
1940  	    SELECT username
1941  		 , account_status
1942  		 , default_tablespace
1943  		 , temporary_tablespace
1944  		 , local_temp_tablespace
1945  		 , profile
1946  		 , password_versions
1947  		 , authentication_type
1948  		 , proxy_only_connect
1949  		 , protected
1950  		 , read_only
1951  	      FROM dba_users
1952  	     WHERE username = cp_schema
1953  	  ;
1954  	  CURSOR cur_header( cp_prefix IN VARCHAR2
1955  			   , cp_schema IN VARCHAR2
1956  			   , cp_type   IN VARCHAR2
1957  			   , cp_object IN VARCHAR2
1958  			   , cp_scope  IN VARCHAR2
1959  			   , cp_count  IN NUMBER
1960  			   , cp_show   IN NUMBER
1961  			   )
1962  	  IS
1963  	    SELECT result_text
1964  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
1965  	  ;
1966  	  CURSOR cur_footer(cp_show IN NUMBER)
1967  	  IS
1968  	    SELECT result_text
1969  	      FROM TABLE(otap_generate.get_footer(cp_show))
1970  	  ;
1971  	BEGIN
1972  	  SELECT COUNT(*)
1973  	    INTO l_test_count
1974  	    FROM dba_users
1975  	   WHERE username = p_schema
1976  	  ;
1977  	  -- we expect exactly one user
1978  	  IF l_test_count = 1
1979  	  THEN
1980  	    -- get header
1981  	    FOR rec IN cur_header(p_title_prefix, 'SYS', 'users', NULL, p_schema, l_test_count, p_show_header)
1982  	    LOOP
1983  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
1984  	    END LOOP;
1985  	    l_pad_par := otap_generate.get_code_prefix_len + 18;
1986  	    -- build group and name row
1987  	    l_statement := otap_generate.get_code_pad || '-- set test group for schema user';
1988  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1989  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''schema user'')' || otap_generate.get_code_postfix;
1990  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1991  	    l_statement := otap_generate.get_code_pad || '-- set test name for schema user';
1992  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1993  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''schema user check'')' || otap_generate.get_code_postfix;
1994  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
1995  	    FOR rec IN cur_user(p_schema)
1996  	    LOOP
1997  	      -- build simple user checks
1998  	      l_statement := otap_generate.get_code_prefix || 'otap_test.has_user( p_username => ''' || rec.username || '''';
1999  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2000  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_account_status => '''|| rec.account_status || '''';
2001  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2002  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_default_tablespace => '''|| rec.default_tablespace || '''';
2003  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2004  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_temporary_tablespace => '''|| rec.temporary_tablespace || '''';
2005  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2006  	      IF rec.local_temp_tablespace IS NOT NULL
2007  	      THEN
2008  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_local_temp_tablespace => '''|| rec.local_temp_tablespace || '''';
2009  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2010  	      END IF;
2011  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_profile => '''|| rec.profile || '''';
2012  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2013  	      IF rec.password_versions IS NOT NULL
2014  	      THEN
2015  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_password_versions => '''|| TRIM(rec.password_versions) || '''';
2016  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2017  	      END IF;
2018  	      IF rec.authentication_type IS NOT NULL
2019  	      THEN
2020  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_authentication_type => '''|| rec.authentication_type || '''';
2021  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2022  	      END IF;
2023  	      IF rec.proxy_only_connect IS NOT NULL
2024  	      THEN
2025  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_proxy_only_connect => '''|| rec.proxy_only_connect || '''';
2026  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2027  	      END IF;
2028  	      IF rec.protected IS NOT NULL
2029  	      THEN
2030  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_protected => '''|| rec.protected || '''';
2031  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2032  	      END IF;
2033  	      IF rec.read_only IS NOT NULL
2034  	      THEN
2035  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_read_only => '''|| rec.read_only || '''';
2036  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2037  	      END IF;
2038  	      l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2039  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2040  	    END LOOP;
2041  	    FOR rec IN cur_footer(p_show_header)
2042  	    LOOP
2043  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2044  	    END LOOP;
2045  	  END IF;
2046  	  RETURN;
2047  	EXCEPTION
2048  	  WHEN NO_DATA_NEEDED THEN
2049  	    RAISE;
2050  	END schema_user_test;
2051  
2052  	FUNCTION related_user_tests( p_user_list     IN VARCHAR2 DEFAULT NULL
2053  				   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
2054  				   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2055  				   )
2056  	  RETURN otap_view_result_tbl PIPELINED
2057  	IS
2058  	  l_statement	VARCHAR2(4000 CHAR);
2059  	  l_test_count	INTEGER;
2060  	  l_pad_par	INTEGER;
2061  	  CURSOR cur_user(cp_user_list IN VARCHAR2)
2062  	  IS
2063  	      WITH usr_list AS
2064  		   (SELECT TRIM(REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL)) AS username
2065  		      FROM dual
2066  		   CONNECT BY REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL) IS NOT NULL
2067  		   )
2068  	    SELECT username
2069  	      FROM usr_list
2070  	     WHERE username IS NOT NULL
2071  	  ;
2072  	  CURSOR cur_user_cnt(cp_user_list IN VARCHAR2)
2073  	  IS
2074  	      WITH usr_list AS
2075  		   (SELECT TRIM(REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL)) AS username
2076  		      FROM dual
2077  		   CONNECT BY REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL) IS NOT NULL
2078  		   )
2079  	    SELECT COUNT(*) AS user_cnt
2080  	      FROM usr_list
2081  	     WHERE username IS NOT NULL
2082  	  ;
2083  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2084  			   , cp_schema IN VARCHAR2
2085  			   , cp_type   IN VARCHAR2
2086  			   , cp_object IN VARCHAR2
2087  			   , cp_scope  IN VARCHAR2
2088  			   , cp_count  IN NUMBER
2089  			   , cp_show   IN NUMBER
2090  			   )
2091  	  IS
2092  	    SELECT result_text
2093  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2094  	  ;
2095  	  CURSOR cur_footer(cp_show IN NUMBER)
2096  	  IS
2097  	    SELECT result_text
2098  	      FROM TABLE(otap_generate.get_footer(cp_show))
2099  	  ;
2100  	BEGIN
2101  	  -- todo scope = list string, schema = SYS, type User
2102  	  IF p_user_list IS NOT NULL
2103  	  THEN
2104  	    -- get count
2105  	    OPEN cur_user_cnt(p_user_list);
2106  	    FETCH cur_user_cnt INTO l_test_count;
2107  	    CLOSE cur_user_cnt;
2108  	    -- get header
2109  	    FOR rec IN cur_header(p_title_prefix, 'SYS', 'Simple user list check', NULL, p_user_list, l_test_count, p_show_header)
2110  	    LOOP
2111  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2112  	    END LOOP;
2113  	    l_pad_par := otap_generate.get_code_prefix_len + 18;
2114  	    -- build group and name row
2115  	    l_statement := otap_generate.get_code_pad || '-- set test group for user list';
2116  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2117  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_group(''users'')' || otap_generate.get_code_postfix;
2118  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2119  	    l_statement := otap_generate.get_code_pad || '-- set test name for simple user check';
2120  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2121  	    l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''simple user checks'')' || otap_generate.get_code_postfix;
2122  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2123  	    FOR rec IN cur_user(p_user_list)
2124  	    LOOP
2125  	      -- build simple user checks
2126  	      l_statement := otap_generate.get_code_prefix || 'otap_test.has_user( p_username => ''' || rec.username || '''';
2127  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2128  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_account_status => ''OPEN''';
2129  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2130  	      l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2131  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2132  	    END LOOP;
2133  	    FOR rec IN cur_footer(p_show_header)
2134  	    LOOP
2135  	      PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2136  	    END LOOP;
2137  	  END IF;
2138  	  RETURN;
2139  	EXCEPTION
2140  	  WHEN NO_DATA_NEEDED THEN
2141  	    RAISE;
2142  	END related_user_tests;
2143  
2144  	FUNCTION type_tests( p_like_type     IN VARCHAR2 DEFAULT '%'
2145  			   , p_schema	     IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2146  			   , p_title_prefix  IN VARCHAR2 DEFAULT NULL
2147  			   , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2148  			   , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2149  			   )
2150  	  RETURN otap_view_result_tbl PIPELINED
2151  	IS
2152  	  l_statement	VARCHAR2(4000 CHAR);
2153  	  l_schema	VARCHAR2(128 CHAR);
2154  	  l_like	VARCHAR2(256 CHAR);
2155  	  l_test_count	INTEGER;
2156  	  l_pad_par	INTEGER;
2157  	  CURSOR cur_types( cp_schema IN VARCHAR2
2158  			  , cp_like   IN VARCHAR2
2159  			  , cp_excl   IN NUMBER
2160  			  )
2161  	  IS
2162  	    SELECT dbo.owner
2163  		 , dbo.object_name
2164  		 , dbo.object_type
2165  		 , dbt.typecode
2166  		 , dbt.predefined
2167  		 , dbt.incomplete
2168  		 , dbt.attributes
2169  		 , dbt.methods
2170  		 , dbt.final
2171  		 , dbt.instantiable
2172  		 , dbt.persistable
2173  	      FROM dba_objects dbo
2174  	      LEFT OUTER JOIN dba_types dbt
2175  		ON dbo.owner = dbt.owner
2176  	       AND dbo.object_name = dbt.type_name
2177  	     WHERE dbo.owner	      = cp_schema
2178  	       AND dbo.object_type    = 'TYPE'
2179  	       AND dbo.object_name LIKE cp_like ESCAPE '\'
2180  	       AND NOT otap_string.is_sys_object(dbo.object_name, cp_excl)
2181  	  ;
2182  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2183  			   , cp_schema IN VARCHAR2
2184  			   , cp_type   IN VARCHAR2
2185  			   , cp_object IN VARCHAR2
2186  			   , cp_scope  IN VARCHAR2
2187  			   , cp_count  IN NUMBER
2188  			   , cp_show   IN NUMBER
2189  			   )
2190  	  IS
2191  	    SELECT result_text
2192  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2193  	  ;
2194  	  CURSOR cur_footer(cp_show IN NUMBER)
2195  	  IS
2196  	    SELECT result_text
2197  	      FROM TABLE(otap_generate.get_footer(cp_show))
2198  	  ;
2199  	BEGIN
2200  	  l_like   := NVL(p_like_type, '%');
2201  	  l_schema := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
2202  	  -- get count
2203  	  SELECT COUNT(*)
2204  	    INTO l_test_count
2205  	    FROM dba_objects dbo
2206  	    LEFT OUTER JOIN dba_types dbt
2207  	      ON dbo.owner = dbt.owner
2208  	     AND dbo.object_name = dbt.type_name
2209  	   WHERE dbo.owner	    = l_schema
2210  	     AND dbo.object_type    = 'TYPE'
2211  	     AND dbo.object_name LIKE l_like ESCAPE '\'
2212  	     AND NOT otap_string.is_sys_object(dbo.object_name, p_excl_sysgen)
2213  	  ;
2214  	  -- get header
2215  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'types', NULL, l_like, l_test_count, p_show_header)
2216  	  LOOP
2217  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2218  	  END LOOP;
2219  	  l_pad_par := otap_generate.get_code_prefix_len + 18;
2220  	  -- build name row
2221  	  l_statement := otap_generate.get_code_pad || '-- set test name for types';
2222  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2223  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''types'')' || otap_generate.get_code_postfix;
2224  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2225  	  FOR rec in cur_types(l_schema, l_like, p_excl_sysgen)
2226  	  LOOP
2227  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_type( p_type_name => ''' || rec.object_name || '''';
2228  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2229  	    IF rec.typecode IS NOT NULL
2230  	    THEN
2231  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_typecode => ''' || rec.typecode || '''';
2232  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2233  	    END IF;
2234  	    IF rec.attributes IS NOT NULL
2235  	    THEN
2236  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_attributes => ''' || rec.attributes || '''';
2237  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2238  	    END IF;
2239  	    IF rec.methods IS NOT NULL
2240  	    THEN
2241  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_methods => ''' || rec.methods || '''';
2242  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2243  	    END IF;
2244  	    IF rec.predefined IS NOT NULL
2245  	    THEN
2246  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_predefined => ''' || rec.predefined || '''';
2247  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2248  	    END IF;
2249  	    IF rec.incomplete IS NOT NULL
2250  	    THEN
2251  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_incomplete => ''' || rec.incomplete || '''';
2252  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2253  	    END IF;
2254  	    IF rec.final IS NOT NULL
2255  	    THEN
2256  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_final => ''' || rec.final || '''';
2257  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2258  	    END IF;
2259  	    IF rec.persistable IS NOT NULL
2260  	    THEN
2261  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_persistable => ''' || rec.persistable || '''';
2262  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2263  	    END IF;
2264  	    l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schema => ''' || rec.owner || '''';
2265  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2266  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2267  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2268  	  END LOOP;
2269  	  FOR rec IN cur_footer(p_show_header)
2270  	  LOOP
2271  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2272  	  END LOOP;
2273  	  RETURN;
2274  	EXCEPTION
2275  	  WHEN NO_DATA_NEEDED THEN
2276  	    RAISE;
2277  	END type_tests;
2278  
2279  	FUNCTION sequence_tests( p_like_sequence IN VARCHAR2 DEFAULT '%'
2280  			       , p_schema	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2281  			       , p_title_prefix  IN VARCHAR2 DEFAULT NULL
2282  			       , p_show_header	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2283  			       , p_excl_sysgen	 IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2284  			       )
2285  	  RETURN otap_view_result_tbl PIPELINED
2286  	IS
2287  	  l_statement	VARCHAR2(4000 CHAR);
2288  	  l_schema	VARCHAR2(128 CHAR);
2289  	  l_like	VARCHAR2(256 CHAR);
2290  	  l_test_count	INTEGER;
2291  	  l_pad_par	INTEGER;
2292  	  -- no reduction on system generated, resolve in code
2293  	  CURSOR cur_sequences( cp_schema IN VARCHAR2
2294  			      , cp_like   IN VARCHAR2
2295  			      )
2296  	  IS
2297  	    SELECT dbs.sequence_owner
2298  		 , dbs.sequence_name
2299  		 , dti.table_name
2300  		 , dti.column_name
2301  		 , dbs.min_value
2302  		 , dbs.max_value
2303  		 , dbs.increment_by
2304  		 , dbs.cycle_flag
2305  		 , dbs.order_flag
2306  		 , dbs.cache_size
2307  		 , dbs.scale_flag
2308  		 , dbs.extend_flag
2309  		 , dbs.sharded_flag
2310  		 , dbs.session_flag
2311  		 , dbs.keep_value
2312  		 , dti.owner AS table_owner
2313  	      FROM dba_sequences dbs
2314  	      LEFT OUTER JOIN dba_tab_identity_cols dti
2315  		ON dbs.sequence_name  = dti.sequence_name
2316  	     WHERE dbs.sequence_owner	= cp_schema
2317  	       AND dbs.sequence_name LIKE cp_like ESCAPE '\'
2318  	  ;
2319  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2320  			   , cp_schema IN VARCHAR2
2321  			   , cp_type   IN VARCHAR2
2322  			   , cp_object IN VARCHAR2
2323  			   , cp_scope  IN VARCHAR2
2324  			   , cp_count  IN NUMBER
2325  			   , cp_show   IN NUMBER
2326  			   )
2327  	  IS
2328  	    SELECT result_text
2329  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2330  	  ;
2331  	  CURSOR cur_footer(cp_show IN NUMBER)
2332  	  IS
2333  	    SELECT result_text
2334  	      FROM TABLE(otap_generate.get_footer(cp_show))
2335  	  ;
2336  	BEGIN
2337  	  l_like       := NVL(p_like_sequence, '%');
2338  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
2339  	  -- get count
2340  	  SELECT COUNT(*)
2341  	    INTO l_test_count
2342  	    FROM dba_sequences dbs
2343  	    LEFT OUTER JOIN dba_tab_identity_cols dti
2344  	      ON dbs.sequence_name  = dti.sequence_name
2345  	   WHERE dbs.sequence_owner   = l_schema
2346  	     AND dbs.sequence_name LIKE l_like ESCAPE '\'
2347  	  ;
2348  	  -- get header
2349  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'sequences', NULL, l_like, l_test_count, p_show_header)
2350  	  LOOP
2351  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2352  	  END LOOP;
2353  	  l_pad_par := otap_generate.get_code_prefix_len + 22;
2354  	  -- build name row
2355  	  l_statement := otap_generate.get_code_pad || '-- set test name for sequences';
2356  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2357  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''sequences'')' || otap_generate.get_code_postfix;
2358  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2359  	  FOR rec IN cur_sequences(l_schema, l_like)
2360  	  LOOP
2361  	    -- start with a parameter not in order but guaranteed
2362  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_sequence( p_schema => ''' || rec.sequence_owner || '''';
2363  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2364  	    -- handle system generated identity columns
2365  	    IF NOT otap_string.is_sys_object(rec.sequence_name, 1)
2366  	    THEN
2367  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_sequence_name => ''' || rec.sequence_name || '''';
2368  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2369  	    ELSE
2370  	      -- p_sequence_name is mandatory
2371  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_sequence_name => NULL';
2372  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2373  	    END IF;
2374  	    IF rec.table_name IS NOT NULL
2375  	    THEN
2376  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_name => ''' || rec.table_name || '''';
2377  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2378  	    END IF;
2379  	    IF rec.column_name IS NOT NULL
2380  	    THEN
2381  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_column_name => ''' || rec.column_name || '''';
2382  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2383  	    END IF;
2384  	    IF rec.min_value IS NOT NULL
2385  	    THEN
2386  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_min_value => ' || TRIM(TO_CHAR(rec.min_value));
2387  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2388  	    END IF;
2389  	    IF rec.max_value IS NOT NULL
2390  	    THEN
2391  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_max_value => ' || TRIM(TO_CHAR(rec.max_value));
2392  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2393  	    END IF;
2394  	    IF rec.increment_by IS NOT NULL
2395  	    THEN
2396  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_increment_by => ' || TRIM(TO_CHAR(rec.increment_by));
2397  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2398  	    END IF;
2399  	    IF rec.cycle_flag IS NOT NULL
2400  	    THEN
2401  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_cycle_flag => ''' || rec.cycle_flag || '''';
2402  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2403  	    END IF;
2404  	    IF rec.order_flag IS NOT NULL
2405  	    THEN
2406  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_order_flag => ''' || rec.order_flag || '''';
2407  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2408  	    END IF;
2409  	    IF rec.cache_size IS NOT NULL
2410  	    THEN
2411  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_cache_size => ' || TRIM(TO_CHAR(rec.cache_size));
2412  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2413  	    END IF;
2414  	    IF rec.scale_flag IS NOT NULL
2415  	    THEN
2416  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_scale_flag => ''' || rec.scale_flag || '''';
2417  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2418  	    END IF;
2419  	    IF rec.extend_flag IS NOT NULL
2420  	    THEN
2421  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_extend_flag => ''' || rec.extend_flag || '''';
2422  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2423  	    END IF;
2424  	    IF rec.sharded_flag IS NOT NULL
2425  	    THEN
2426  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_sharded_flag => ''' || rec.sharded_flag || '''';
2427  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2428  	    END IF;
2429  	    IF rec.session_flag IS NOT NULL
2430  	    THEN
2431  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_session_flag => ''' || rec.session_flag || '''';
2432  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2433  	    END IF;
2434  	    IF rec.keep_value IS NOT NULL
2435  	    THEN
2436  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_keep_value => ''' || rec.keep_value || '''';
2437  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2438  	    END IF;
2439  	    IF rec.table_owner IS NOT NULL
2440  	    THEN
2441  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_table_owner => ''' || rec.table_owner || '''';
2442  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2443  	    END IF;
2444  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2445  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2446  	  END LOOP;
2447  	  FOR rec IN cur_footer(p_show_header)
2448  	  LOOP
2449  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2450  	  END LOOP;
2451  	  RETURN;
2452  	EXCEPTION
2453  	  WHEN NO_DATA_NEEDED THEN
2454  	    RAISE;
2455  	END sequence_tests;
2456  
2457  	FUNCTION sched_job_tests( p_like_job	  IN VARCHAR2 DEFAULT '%'
2458  				, p_schema	  IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2459  				, p_title_prefix  IN VARCHAR2 DEFAULT NULL
2460  				, p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2461  				, p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2462  				)
2463  	  RETURN otap_view_result_tbl PIPELINED
2464  	IS
2465  	  l_statement	VARCHAR2(4000 CHAR);
2466  	  l_schema	VARCHAR2(128 CHAR);
2467  	  l_like	VARCHAR2(256 CHAR);
2468  	  l_test_count	INTEGER;
2469  	  l_pad_par	INTEGER;
2470  	  CURSOR cur_jobs( cp_schema IN VARCHAR2
2471  			 , cp_like   IN VARCHAR2
2472  			 , cp_excl   IN NUMBER
2473  			 )
2474  	  IS
2475  	    SELECT owner
2476  		 , job_name
2477  		 , job_style
2478  		 , job_type
2479  		 , job_action
2480  		 , schedule_type
2481  		 , repeat_interval
2482  		 , job_class
2483  		 , logging_level
2484  		 , store_output
2485  	      FROM dba_scheduler_jobs
2486  	     WHERE owner       = cp_schema
2487  	       AND job_name LIKE cp_like ESCAPE '\'
2488  	       AND NOT otap_string.is_sys_object(job_name, cp_excl)
2489  	  ;
2490  	  CURSOR cur_header( cp_prefix IN VARCHAR2
2491  			   , cp_schema IN VARCHAR2
2492  			   , cp_type   IN VARCHAR2
2493  			   , cp_object IN VARCHAR2
2494  			   , cp_scope  IN VARCHAR2
2495  			   , cp_count  IN NUMBER
2496  			   , cp_show   IN NUMBER
2497  			   )
2498  	  IS
2499  	    SELECT result_text
2500  	      FROM TABLE(otap_generate.get_header(cp_prefix, cp_schema, cp_type, cp_object, cp_scope, cp_count, cp_show))
2501  	  ;
2502  	  CURSOR cur_footer(cp_show IN NUMBER)
2503  	  IS
2504  	    SELECT result_text
2505  	      FROM TABLE(otap_generate.get_footer(cp_show))
2506  	  ;
2507  	BEGIN
2508  	  l_like       := NVL(p_like_job, '%');
2509  	  l_schema     := otap_string.reduce(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')), 128);
2510  	  -- get count
2511  	  SELECT COUNT(*)
2512  	    INTO l_test_count
2513  	    FROM dba_scheduler_jobs
2514  	   WHERE owner	     = l_schema
2515  	     AND job_name LIKE l_like ESCAPE '\'
2516  	     AND NOT otap_string.is_sys_object(job_name, p_excl_sysgen)
2517  	  ;
2518  	  -- get header
2519  	  FOR rec IN cur_header(p_title_prefix, l_schema, 'scheduler jobs', NULL, l_like, l_test_count, p_show_header)
2520  	  LOOP
2521  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2522  	  END LOOP;
2523  	  l_pad_par := otap_generate.get_code_prefix_len + 27;
2524  	  -- build name row
2525  	  l_statement := otap_generate.get_code_pad || '-- set test name for scheduler jobs';
2526  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2527  	  l_statement := otap_generate.get_code_prefix || 'otap_test.set_test_name(''scheduler jobs'')' || otap_generate.get_code_postfix;
2528  	  PIPE ROW (otap_view_result_rec(l_statement, NULL));
2529  	  FOR rec IN cur_jobs(l_schema, l_like, p_excl_sysgen)
2530  	  LOOP
2531  	    l_statement := otap_generate.get_code_prefix || 'otap_test.has_scheduler_job( p_job_name => ''' || rec.job_name || '''';
2532  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2533  	    IF rec.job_style IS NOT NULL
2534  	    THEN
2535  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_style => ''' || rec.job_style || '''';
2536  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2537  	    END IF;
2538  	    IF rec.job_type IS NOT NULL
2539  	    THEN
2540  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_type => ''' || rec.job_type || '''';
2541  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2542  	    END IF;
2543  	    IF rec.job_action IS NOT NULL
2544  	    THEN
2545  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_action => ''' || rec.job_action || '''';
2546  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2547  	    END IF;
2548  	    IF rec.schedule_type IS NOT NULL
2549  	    THEN
2550  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_schedule_type => ''' || rec.schedule_type || '''';
2551  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2552  	    END IF;
2553  	    IF rec.repeat_interval IS NOT NULL
2554  	    THEN
2555  	      -- check if we have ' in the string
2556  	      IF INSTR(rec.repeat_interval, '''') > 0
2557  	      THEN
2558  		-- q syntax
2559  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_repeat_interval => q''[' || TRIM(rec.repeat_interval) || ']''';
2560  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2561  	      ELSE
2562  		l_statement := LPAD(' ', l_pad_par, ' ') || ', p_repeat_interval => ''' || TRIM(rec.repeat_interval) || '''';
2563  		PIPE ROW (otap_view_result_rec(l_statement, NULL));
2564  	      END IF;
2565  	    END IF;
2566  	    IF rec.job_class IS NOT NULL
2567  	    THEN
2568  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_job_class => ''' || rec.job_class || '''';
2569  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2570  	    END IF;
2571  	    IF rec.logging_level IS NOT NULL
2572  	    THEN
2573  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_logging_level => ''' || rec.logging_level || '''';
2574  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2575  	    END IF;
2576  	    IF rec.store_output IS NOT NULL
2577  	    THEN
2578  	      l_statement := LPAD(' ', l_pad_par, ' ') || ', p_store_output => ''' || rec.store_output || '''';
2579  	      PIPE ROW (otap_view_result_rec(l_statement, NULL));
2580  	    END IF;
2581  	    l_statement := LPAD(' ', l_pad_par, ' ') || ')' || otap_generate.get_code_postfix;
2582  	    PIPE ROW (otap_view_result_rec(l_statement, NULL));
2583  	  END LOOP;
2584  	  FOR rec IN cur_footer(p_show_header)
2585  	  LOOP
2586  	    PIPE ROW (otap_view_result_rec(rec.result_text, NULL));
2587  	  END LOOP;
2588  	  RETURN;
2589  	EXCEPTION
2590  	  WHEN NO_DATA_NEEDED THEN
2591  	    RAISE;
2592  	END sched_job_tests;
2593  
2594  	FUNCTION schema_tests( p_like_schema   IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
2595  			     , p_required_user IN VARCHAR2 DEFAULT NULL
2596  			     , p_title_prefix  IN VARCHAR2 DEFAULT NULL
2597  			     , p_show_header   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2598  			     , p_excl_sysgen   IN INTEGER  DEFAULT otap_constants.OTAP_NUM_TRUE
2599  			     )
2600  	  RETURN otap_view_result_tbl PIPELINED
2601  	IS
2602  	  l_statement	VARCHAR2(4000 CHAR);
2603  	  l_schema	VARCHAR2(128 CHAR);
2604  	  l_like	VARCHAR2(256 CHAR);
2605  	  l_test_count	INTEGER;
2606  	  l_user_count	INTEGER;
2607  	  l_pad_par	INTEGER;
2608  	  CURSOR cur_user_cnt(cp_user_list IN VARCHAR2)
2609  	  IS
2610  	      WITH usr_list AS
2611  		   (SELECT TRIM(REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL)) AS username
2612  		      FROM dual
2613  		   CONNECT BY REGEXP_SUBSTR(cp_user_list, '[^,]+', 1, LEVEL) IS NOT NULL
2614  		   )
2615  	    SELECT COUNT(*) AS user_cnt
2616  	      FROM usr_list
2617  	     WHERE username IS NOT NULL
2618  	  ;
2619  	  CURSOR cur_schemas( cp_like IN VARCHAR2
2620  			    , cp_excl IN NUMBER
2621  			    )
2622  	  IS
2623  	    SELECT username
2624  	      FROM dba_users
2625  	     WHERE username LIKE cp_like ESCAPE '\'
2626  	       AND NOT otap_string.is_sys_object(username, cp_excl)
2627  	  ;
2628  	  CURSOR cur_related_users( cp_user_list IN VARCHAR2
2629  				  , cp_prefix	 IN VARCHAR2
2630  				  )
2631  	  IS
