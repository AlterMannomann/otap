403    FUNCTION throws_ok( p_statement	     IN 	   VARCHAR2
404  			 , p_sqlerrm	     IN 	   VARCHAR2
405  			 , o_errors		OUT NOCOPY VARCHAR2
406  			 , p_header_def      IN 	   VARCHAR2 DEFAULT NULL
407  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
408  			 )
409  	 RETURN INTEGER
410    IS
411  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_ok';
412  	 l_test_passed	 INTEGER;
413  	 l_expected	 INTEGER;
414  	 l_errors	 VARCHAR2(32767 CHAR);
415  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
416  	 l_sqlcode	 NUMBER;
417    BEGIN
418  	 l_errors      := NULL;
419  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
420  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
421  	 IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
422  	 THEN
423  	   IF l_sqlerrm = p_sqlerrm
424  	   THEN
425  	     l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
426  	   ELSE
427  	     -- decide which case happened
428  	     IF l_sqlcode = -20100
429  	     THEN
430  	       -- invalid header, l_errors should be set and logged already
431  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
432  	     ELSE
433  	       -- exception happened but does not match
434  	       l_errors      := l_errors || 'Given error message does not match with ' || l_sqlerrm;
435  	       l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
436  	       otap_log.log(l_errors, l_script);
437  	     END IF;
438  	   END IF;
439  	 ELSE
440  	   -- no exception raised, l_errors should be set and logged already
441  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
442  	   otap_log.log(l_errors, l_script);
443  	 END IF;
444  	 -- now decide on the expected result the final state and if errors are returned
445  	 IF l_test_passed != l_expected
446  	 THEN
447  	   o_errors := otap_string.reduce(l_errors, 4000);
448  	 ELSE
449  	   -- overwrite states from before, as we fulfill expected
450  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
451  	   -- overwrite errors expected
452  	   o_errors := NULL;
453  	 END IF;
454  	 RETURN l_test_passed;
455    EXCEPTION
456  	 WHEN OTHERS THEN
457  	   IF SQLCODE != -20099
458  	   THEN
459  	     -- log unhandled exceptions
460  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
461  	   END IF;
462  	   RAISE;
463    END throws_ok;
464  
465    FUNCTION throws_ok( p_statement	     IN 	   VARCHAR2
466  			 , p_sqlcode	     IN 	   NUMBER
467  			 , o_errors		OUT NOCOPY VARCHAR2
468  			 , p_header_def      IN 	   VARCHAR2 DEFAULT NULL
469  			 , p_expected_result IN 	   NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
470  			 )
471  	 RETURN INTEGER
472    IS
473  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_ok';
474  	 l_test_passed	 INTEGER;
475  	 l_expected	 INTEGER;
476  	 l_errors	 VARCHAR2(32767 CHAR);
477  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
478  	 l_sqlcode	 NUMBER;
479    BEGIN
480  	 l_errors      := NULL;
481  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
482  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
483  	 IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
484  	 THEN
485  	   IF l_sqlcode = p_sqlcode
486  	   THEN
487  	     l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
488  	   ELSE
489  	     -- decide which case happened
490  	     IF l_sqlcode = -20100
491  	     THEN
492  	       -- invalid header, l_errors should be set and logged already
493  	       l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
494  	     ELSE
495  	       -- exception happened but does not match
496  	       l_errors      := l_errors || 'Given error message does not match with ' || l_sqlerrm;
497  	       l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
498  	       otap_log.log(l_errors, l_script);
499  	     END IF;
500  	   END IF;
501  	 ELSE
502  	   -- no exception raised, l_errors should be set and logged already
503  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
504  	   otap_log.log(l_errors, l_script);
505  	 END IF;
506  	 -- now decide on the expected result the final state and if errors are returned
507  	 IF l_test_passed != l_expected
508  	 THEN
509  	   o_errors := otap_string.reduce(l_errors, 4000);
510  	 ELSE
511  	   -- overwrite states from before, as we fulfill expected
512  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
513  	   -- overwrite errors expected
514  	   o_errors := NULL;
515  	 END IF;
516  	 RETURN l_test_passed;
517    EXCEPTION
518  	 WHEN OTHERS THEN
519  	   IF SQLCODE != -20099
520  	   THEN
521  	     -- log unhandled exceptions
522  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
523  	   END IF;
524  	   RAISE;
525    END throws_ok;
526  
527    FUNCTION throws_matches( p_statement	  IN		VARCHAR2
528  			      , p_regex_sqlerrm   IN		VARCHAR2
529  			      , o_errors	     OUT NOCOPY VARCHAR2
530  			      , p_param 	  IN		VARCHAR2 DEFAULT NULL
531  			      , p_header_def	  IN		VARCHAR2 DEFAULT NULL
532  			      , p_expected_result IN		NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
533  			      )
534  	 RETURN INTEGER
535    IS
536  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.throws_matches';
537  	 l_test_passed	 INTEGER;
538  	 l_expected	 INTEGER;
539  	 l_count	 INTEGER;
540  	 l_errors	 VARCHAR2(32767 CHAR);
541  	 l_sqlerrm	 VARCHAR2(32767 CHAR);
542  	 l_sqlcode	 NUMBER;
543    BEGIN
544  	 l_errors      := NULL;
545  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
546  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
547  	 IF p_param IS NOT NULL
548  	 THEN
549  	   -- check parameter
550  	   SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(p_param, '^[icmnx]*$');
551  	 ELSE
552  	   l_count := 1;
553  	 END IF;
554  	 IF l_count = 1
555  	 THEN
556  	   -- process the statement
557  	   IF otap_logic.has_exception(p_statement, l_errors, l_sqlcode, l_sqlerrm, p_header_def, l_expected)
558  	   THEN
559  	     SELECT COUNT(*) INTO l_count FROM dual WHERE REGEXP_LIKE(l_sqlerrm, p_regex_sqlerrm, p_param);
560  	     IF l_count = 1
561  	     THEN
562  	       l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
563  	     ELSE
564  	       -- decide which case happened
565  	       IF l_sqlcode = -20100
566  	       THEN
567  		 -- invalid header, l_errors should be set and logged already
568  		 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
569  	       ELSE
570  		 -- exception happened but does not match
571  		 l_errors      := l_errors || 'Given regular expression does not match with ' || l_sqlerrm;
572  		 l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
573  		 otap_log.log(l_errors, l_script);
574  	       END IF;
575  	     END IF;
576  	   ELSE
577  	     -- no exception raised, l_errors should be set and logged already
578  	     l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
579  	     otap_log.log(l_errors, l_script);
580  	   END IF;
581  	 ELSE
582  	   -- invalid parameter
583  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
584  	   l_errors	 := l_errors || 'Not allowed: p_param(' || p_param || ') only i, c, m, n or x supported. Case sensitive.';
585  	   -- log error
586  	   otap_log.log(l_errors, l_script);
587  	 END IF;
588  	 -- now decide on the expected result the final state and if errors are returned
589  	 IF l_test_passed != l_expected
590  	 THEN
591  	   o_errors := otap_string.reduce(l_errors, 4000);
592  	 ELSE
593  	   -- overwrite states from before, as we fulfill expected
594  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
595  	   -- overwrite errors expected
596  	   o_errors := NULL;
597  	 END IF;
598  	 RETURN l_test_passed;
599    EXCEPTION
600  	 WHEN OTHERS THEN
601  	   IF SQLCODE != -20099
602  	   THEN
603  	     -- log unhandled exceptions
604  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
605  	   END IF;
606  	   RAISE;
607    END throws_matches;
