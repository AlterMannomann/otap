671  	     LEFT OUTER JOIN dba_cons_columns dcc
672  	       ON dco.owner	      = dcc.owner
673  	      AND dco.constraint_name = dcc.constraint_name
674  	      AND dco.table_name      = dcc.table_name
675  	     LEFT OUTER JOIN dba_cons_columns dcr
676  	       ON dco.r_owner			     = dcr.owner
677  	      AND dco.r_constraint_name 	     = dcr.constraint_name
678  	    WHERE dco.owner			     = l_schema_to_use
679  	      AND dco.table_name		     = l_table_name
680  	      AND NVL(dcc.column_name, 'n/a')	     = NVL(l_column_name, NVL(dcc.column_name, 'n/a'))
681  	      AND dco.constraint_name		     = NVL(l_constraint_name, dco.constraint_name)
682  	      AND NVL(dco.r_owner, 'n/a')	     = NVL(l_r_schema, NVL(dco.r_owner, 'n/a'))
683  	      AND NVL(dco.r_constraint_name, 'n/a')  = NVL(l_r_constraint_name, NVL(dco.r_constraint_name, 'n/a'))
684  	      AND NVL(dcr.table_name, 'n/a')	     = NVL(l_r_table_name, NVL(dcr.table_name, 'n/a'))
685  	      AND NVL(dcr.column_name, 'n/a')	     = NVL(l_r_column_name, NVL(dcr.column_name, 'n/a'))
686  	      AND dco.constraint_type		     = l_constraint_type
687  	   ;
688  	   -- we may find more than one entry for combined primary keys
689  	   l_test_passed := CASE WHEN l_has_constraint = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
690  	 ELSE
691  	   -- missing mandatory table name
692  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
693  	   l_errors	       := 'Not allowed: ' || CASE WHEN l_table_name IS NULL THEN 'p_table_name(NULL) ' END ||
694  						     CASE
695  						       WHEN l_constraint_type NOT IN ('R', 'F')
696  						       THEN 'p_constraint_type(' || NVL(p_constraint_type, 'NULL') || ')'
697  						     END
698  	   ;
699  	   otap_log.log(l_errors, l_script, 'Table name NULL or invalid constraint type');
700  	 END IF;
701  	 -- now decide on the expected result the final state and if errors are returned
702  	 IF l_test_passed != l_expected
703  	 THEN
704  	   o_errors := otap_string.reduce(l_errors, 4000);
705  	 ELSE
706  	   -- overwrite states from before, as we fulfill expected
707  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
708  	   -- overwrite errors expected
709  	   o_errors := NULL;
710  	 END IF;
711  	 RETURN l_test_passed;
712    EXCEPTION
713  	 WHEN OTHERS THEN
714  	   IF SQLCODE != -20099
715  	   THEN
716  	     -- log unhandled exceptions
717  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
718  	   END IF;
719  	   RAISE;
720    END has_ref_constraint;
