  2  AS
  3    -- for description see header file
  4    FUNCTION check_header( p_header_def IN		 VARCHAR2
  5  			    , o_errors	   IN OUT NOCOPY VARCHAR2
  6  			    )
  7  	 RETURN BOOLEAN
  8    IS
  9  	 l_script  VARCHAR2(1024 CHAR) := 'otap_logic.check_header';
 10  	 l_block   VARCHAR2(32767);
 11  	 l_return  BOOLEAN;
 12    BEGIN
 13  	 l_return := FALSE;
 14  	 l_block := 'DECLARE ' || p_header_def || ' BEGIN NULL; END;';
 15  	 -- check header
 16  	 BEGIN
 17  	   EXECUTE IMMEDIATE l_block;
 18  	   l_return := TRUE;
 19  	 EXCEPTION
 20  	   WHEN OTHERS THEN
 21  	     -- log error
 22  	     otap_log.log(SQLERRM, l_script, 'Header block not valid: ' || p_header_def);
 23  	     o_errors := o_errors || ' exception: ' || SQLERRM;
 24  	     l_return := FALSE;
 25  	 END;
 26  	 RETURN l_return;
 27    EXCEPTION
 28  	 WHEN OTHERS THEN
 29  	   IF SQLCODE != -20099
 30  	   THEN
 31  	     -- log unhandled exceptions
 32  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 33  	   END IF;
 34  	   RAISE;
 35    END check_header;
