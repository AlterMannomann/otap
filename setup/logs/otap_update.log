722    FUNCTION has_not_null_constraint( p_table_name	   IN		 VARCHAR2
723  				       , p_column_name	   IN		 VARCHAR2
724  				       , o_errors	      OUT NOCOPY VARCHAR2
725  				       , p_constraint	   IN		 VARCHAR2 DEFAULT NULL
726  				       , p_schema	   IN		 VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
727  				       , p_expected_result IN		 NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
728  				       )
729  	 RETURN INTEGER
730    IS
731  	 l_script	   VARCHAR2(1024 CHAR)	  := 'otap_schema.has_not_null_constraint';
732  	 l_test_passed	   INTEGER;
733  	 l_expected	   INTEGER;
734  	 l_has_constraint  INTEGER;
735  	 l_constraint_type CHAR(1 CHAR);
736  	 l_table_name	   VARCHAR2(128 CHAR);
737  	 l_column_name	   VARCHAR2(128 CHAR);
738  	 l_constraint_name VARCHAR2(128 CHAR);
739  	 l_schema_to_use   VARCHAR2(128 CHAR);
740  	 l_errors	   VARCHAR2(32767 CHAR);
741    BEGIN
742  	 l_errors	   := NULL;
743  	 l_test_passed	   := otap_constants.OTAP_NUM_TEST_UNDEFINED;
744  	 l_expected	   := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
745  	 l_table_name	   := otap_string.reduce(p_table_name, 128);
746  	 l_column_name	   := otap_string.reduce(p_column_name, 128);
747  	 l_constraint_name := otap_string.reduce(p_constraint, 128);
748  	 l_constraint_type := 'C';
749  	 IF	l_table_name	     IS NOT NULL
750  	    AND LENGTH(l_table_name)  > 0
751  	    AND l_column_name	     IS NOT NULL
752  	    AND LENGTH(l_column_name) > 0
753  	 THEN
754  	   -- schema
755  	   l_schema_to_use := otap_string.reduce(TRIM(NVL(p_schema, SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'))), 128);
756  	   -- check
757  	   SELECT COUNT(*)
758  	     INTO l_has_constraint
759  	     FROM dba_constraints dco
760  	     LEFT OUTER JOIN dba_cons_columns dcc
761  	       ON dco.owner						      = dcc.owner
762  	      AND dco.constraint_name					      = dcc.constraint_name
763  	      AND dco.table_name					      = dcc.table_name
764  	    WHERE dco.owner						      = l_schema_to_use
765  	      AND dco.table_name					      = l_table_name
766  	      AND dcc.column_name					      = l_column_name
767  	      AND INSTR(UPPER(dco.search_condition_vc), UPPER(l_column_name)) > 0
768  	      AND INSTR( otap_string.flatten( UPPER(dco.search_condition_vc)
769  					    , 4000)
770  		       , 'IS NOT NULL'
771  		       )						      > 0
772  	      AND dco.constraint_name					      = NVL(l_constraint_name, dco.constraint_name)
773  	      AND dco.constraint_type					      = l_constraint_type
774  	   ;
775  	   -- we may find more than one entry for combined primary keys
776  	   l_test_passed := CASE WHEN l_has_constraint = 0 THEN otap_constants.OTAP_NUM_TEST_FAILED ELSE otap_constants.OTAP_NUM_TEST_PASSED END;
777  	 ELSE
778  	   -- missing mandatory table name
779  	   l_test_passed       := otap_constants.OTAP_NUM_TEST_UNDEFINED;
780  	   l_errors	       := 'Not allowed: ' || CASE WHEN l_table_name IS NULL THEN 'p_table_name(NULL) ' END ||
781  						     CASE WHEN l_column_name IS NULL THEN 'p_column_name(NULL) ' END
782  	   ;
783  	   otap_log.log(l_errors, l_script, 'Table name or column name NULL');
784  	 END IF;
785  	 -- now decide on the expected result the final state and if errors are returned
786  	 IF l_test_passed != l_expected
787  	 THEN
788  	   o_errors := otap_string.reduce(l_errors, 4000);
789  	 ELSE
790  	   -- overwrite states from before, as we fulfill expected
791  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
792  	   -- overwrite errors expected
793  	   o_errors := NULL;
794  	 END IF;
795  	 RETURN l_test_passed;
796    EXCEPTION
797  	 WHEN OTHERS THEN
798  	   IF SQLCODE != -20099
799  	   THEN
800  	     -- log unhandled exceptions
801  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
802  	   END IF;
803  	   RAISE;
804    END has_not_null_constraint;
