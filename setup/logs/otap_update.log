1216  	  l_has_user		  INTEGER;
1217  	  l_username		  VARCHAR2(128 CHAR);
1218  	  l_account_status	  VARCHAR2(32 CHAR);
1219  	  l_default_tablespace	  VARCHAR2(30 CHAR);
1220  	  l_temporary_tablespace  VARCHAR2(30 CHAR);
1221  	  l_local_temp_tablespace VARCHAR2(30 CHAR);
1222  	  l_profile		  VARCHAR2(128 CHAR);
1223  	  l_password_versions	  VARCHAR2(17 CHAR);
1224  	  l_authentication_type   VARCHAR2(8 CHAR);
1225  	  l_proxy_only_connect	  VARCHAR2(1 CHAR);
1226  	  l_protected		  VARCHAR2(3 CHAR);
1227  	  l_read_only		  VARCHAR2(3 CHAR);
1228  	  l_errors		  VARCHAR2(32767 CHAR);
1229  	BEGIN
1230  	  l_errors		  := NULL;
1231  	  l_test_passed 	  := otap_constants.OTAP_NUM_TEST_UNDEFINED;
