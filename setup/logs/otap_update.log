752    /** FUNCTION otap_test.is_eq
753    * Checks given data of type VARCHAR2, NUMBER and DATE against a given value. As "IS" is a reserved word in Oracle
754    * this is the equivalent of is and isnt. isnt is achieved by setting expected result to otap_constants.OTAP_NUM_TEST_FAILED.
755    *
756    * Other types are more or less problematic, e.g. you can't declare in Oracle a function with date and timestamp parameter. If providing
757    * TIMESTAMP Oracle gets confused which function to use. Try to convert or cast the types to the base types. CAST will probably not
758    * preserve all information. TO_CHAR is almost always an option.
759    *
760    * Passing simply NULL, NULL without that datatypes are defined by columns, the function will fail with ORA-06553: Too much declarations
761    * of is_eq. To do a NULL test, use, according to p_have datatype, TO_CHAR(NULL), TO_NUMBER(NULL) or TO_DATE(NULL) so correct function
762    * signature is identified and function does not fail.
763    *
764    * @param p_have The data to check.
765    * @param p_want The expected data. Must have the same datatype as p_have.
766    * @param p_description The test description if any. If not given, a description is generated, see template.
767    * @param p_expected_result The expected test result as number. Default is test passed. See otap_constants.
768    * @param p_schema A schema override of the current test session if needed, taken as is. Compares are not clearly associated to a schema. Case sensitive.
769    *
770    * @return The test result as text.
771    */
772    FUNCTION is_eq( p_have		 IN VARCHAR2
773  		     , p_want		 IN VARCHAR2
774  		     , p_description	 IN VARCHAR2 DEFAULT NULL
775  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
776  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
777  		     )
778  	 RETURN VARCHAR2
779    ;
780    FUNCTION is_eq( p_have		 IN NUMBER
781  		     , p_want		 IN NUMBER
782  		     , p_description	 IN VARCHAR2 DEFAULT NULL
783  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
784  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
785  		     )
786  	 RETURN VARCHAR2
787    ;
788    FUNCTION is_eq( p_have		 IN DATE
789  		     , p_want		 IN DATE
790  		     , p_description	 IN VARCHAR2 DEFAULT NULL
791  		     , p_expected_result IN NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
792  		     , p_schema 	 IN VARCHAR2 DEFAULT SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
