970  	 ELSE
971  	   -- overwrite states from before, as we fulfill expected
972  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
973  	   -- overwrite errors expected
974  	   o_errors := NULL;
975  	 END IF;
