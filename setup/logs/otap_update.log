 47  	 ELSE
 48  	   RETURN LENGTH(PREFIX_PLSQL);
 49  	 END IF;
 50    END get_code_prefix_len;
 51  
 52    FUNCTION get_code_postfix
 53  	 RETURN VARCHAR2
