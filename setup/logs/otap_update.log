977    EXCEPTION
978  	 WHEN OTHERS THEN
979  	   IF SQLCODE != -20099
980  	   THEN
981  	     -- log unhandled exceptions
982  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
983  	   END IF;
984  	   RAISE;
985    END has_type;
