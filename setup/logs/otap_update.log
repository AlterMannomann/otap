SQL> -- Basic package that provides utility functions and procedures for table OTAP_CONFIG.
SQL> CREATE OR REPLACE PACKAGE otap_log
  2  AS
  3    /**
  4    * Provides logging functionality. Dependency on OTAP_CONFIG table for DEBUG_MODE. Other
  5    * functionality of OTAP_CONFIG table is provided in otap_util. Provided as internal
  6    * function not exposed to package header. Fail save implementation. Will do nothing apart
  7    * from DBMS_OUTPUT on exceptions and errors. Logging is not critical for otap.
  8    *
  9    * It is a simple and very reduced log using SPERRORLOG which should have been created by setup.
 10    */
 11  
 12    /** PROCEDURE otap_util.log
 13    * Writes a log message to SPERRORLOG which should be already available by setup. If the identifier
 14    * is not otap_constants.OTAP_INTERNAL_ERROR or otap_constants.OTAP_INTERNAL_WARNING the log output
 15    * will only be stored, if OTAP_CONFIG DEBUG_MODE is set to 1.
 16    * User and timestamp are set by the procedure. Runs as autonomous transaction.
 17    * If SPERRORLOG does not exist, will do nothing apart from DBMS_OUTPUT the exception.
 18    *
 19    * @param p_log_message The message to log in SPERRORLOG.
 20    * @param p_script The script, package or function that caused the message.
 21    * @param p_statement The statement that caused the message.
 22    * @param p_identifier The allowed otap identifier in SPERRORLOG, user-defined only if in debug mode.
 23    */
 24    PROCEDURE log( p_log_message  IN VARCHAR2
 25  		    , p_script	     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 26  		    , p_statement    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 27  		    , p_identifier   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_ERROR
 28  		    )
 29    ;
 30  
 31  END;
 32  /

