242  	 PIPE ROW (otap_view_result_rec(l_statement, NULL));
243  	 IF p_scope IS NOT NULL
244  	 THEN
245  	   l_statement := otap_generate.get_code_pad || '-- LIKE scope: ' || TRIM(p_scope);
246  	   PIPE ROW (otap_view_result_rec(l_statement, NULL));
