944    FUNCTION result_view( p_session_id   IN NUMBER
945  			   , p_language_id  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
946  			   )
947  	 RETURN otap_view_result_tbl PIPELINED
948    IS
949  	 l_delim_updown VARCHAR2(1 CHAR) := '=';
950  	 l_delim_tests	VARCHAR2(1 CHAR) := '-';
951  	 l_text_column	VARCHAR2(4000 CHAR);
952  	 l_setup_set	VARCHAR2(256 CHAR);
953  	 l_setup_group	VARCHAR2(256 CHAR);
954  	 l_setup_name	VARCHAR2(256 CHAR);
955  	 l_has_errors	INTEGER;
956  	 l_has_records	INTEGER;
957  	 l_report_size	INTEGER;
958  	 CURSOR cur_test_sets( cp_session_id  IN NUMBER
959  			     , cp_setup_set   IN VARCHAR2
960  			     )
961  	 IS
962  	   SELECT test_set
963  		, COUNT(*) AS test_runs
964  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
965  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
966  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
967  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
968  	     FROM otap_results
969  	    WHERE test_session_id = cp_session_id
970  	      AND test_set	 != cp_setup_set
971  	    GROUP BY test_set
972  	    ORDER BY MIN(test_run_date)
973  	 ;
974  	 CURSOR cur_test_groups( cp_session_id	IN NUMBER
975  			       , cp_test_set	IN VARCHAR2
976  			       , cp_setup_group IN VARCHAR2
977  			       )
978  	 IS
979  	   SELECT test_group
980  		, COUNT(*) AS test_runs
981  		, SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
982  		, SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
983  		, CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
984  		, CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
985  	     FROM otap_results
986  	    WHERE test_session_id = cp_session_id
987  	      AND test_set	  = cp_test_set
988  	      AND test_group	 != cp_setup_group
989  	    GROUP BY test_group
990  	    ORDER BY MIN(test_run_date)
991  	 ;
992  	 CURSOR cur_test_names( cp_session_id  IN NUMBER
993  			      , cp_test_set    IN VARCHAR2
994  			      , cp_test_group  IN VARCHAR2
995  			      , cp_setup_name  IN VARCHAR2
996  			      )
997  	 IS
998  	   SELECT test_name
999  		, COUNT(*) AS test_runs
1000  		 , SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
1001  		 , SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
1002  		 , CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
1003  		 , CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
1004  	      FROM otap_results
1005  	     WHERE test_session_id = cp_session_id
1006  	       AND test_set	   = cp_test_set
1007  	       AND test_group	   = cp_test_group
1008  	       AND test_name	  != cp_setup_name
1009  	     GROUP BY test_name
1010  	     ORDER BY MIN(test_run_date)
1011  	  ;
1012  	  CURSOR cur_setup_sets( cp_session_id	IN NUMBER
1013  			       , cp_setup_set	IN VARCHAR2
1014  			       )
1015  	  IS
1016  	    SELECT test_set
1017  		 , COUNT(*) AS test_runs
1018  		 , SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
1019  		 , SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
1020  		 , CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
1021  		 , CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
1022  	      FROM otap_results
1023  	     WHERE test_session_id = cp_session_id
1024  	       AND test_set	   = cp_setup_set
1025  	     GROUP BY test_set
1026  	     ORDER BY MIN(test_run_date)
1027  	  ;
1028  	  CURSOR cur_setup_groups( cp_session_id  IN NUMBER
1029  				 , cp_test_set	  IN VARCHAR2
1030  				 , cp_setup_group IN VARCHAR2
1031  				 )
1032  	  IS
1033  	    SELECT test_group
1034  		 , COUNT(*) AS test_runs
1035  		 , SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
1036  		 , SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
1037  		 , CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
1038  		 , CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
1039  	      FROM otap_results
1040  	     WHERE test_session_id = cp_session_id
1041  	       AND test_set	   = cp_test_set
1042  	       AND test_group	   = cp_setup_group
1043  	     GROUP BY test_group
1044  	     ORDER BY MIN(test_run_date)
1045  	  ;
1046  	  CURSOR cur_setup_names( cp_session_id  IN NUMBER
1047  				, cp_test_set	 IN VARCHAR2
1048  				, cp_test_group  IN VARCHAR2
1049  				, cp_setup_name  IN VARCHAR2
1050  				)
1051  	  IS
1052  	    SELECT test_name
1053  		 , COUNT(*) AS test_runs
1054  		 , SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
1055  		 , SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
1056  		 , CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
1057  		 , CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
1058  	      FROM otap_results
1059  	     WHERE test_session_id = cp_session_id
1060  	       AND test_set	   = cp_test_set
1061  	       AND test_group	   = cp_test_group
1062  	       AND test_name	   = cp_setup_name
1063  	     GROUP BY test_name
1064  	     ORDER BY MIN(test_run_date)
1065  	  ;
1066  	  CURSOR cur_session_total(cp_session_id  IN NUMBER)
1067  	  IS
1068  	    SELECT test_session_id
1069  		 , COUNT(DISTINCT test_set) AS test_sets
1070  		 , COUNT(DISTINCT test_group) AS test_groups
1071  		 , COUNT(DISTINCT test_name) AS test_names
1072  		 , COUNT(DISTINCT test_desc) AS test_descs
1073  		 , COUNT(*) AS test_runs
1074  		 , SUM(CASE WHEN test_passed = -1 THEN 1 ELSE 0 END) AS test_errors
1075  		 , SUM(CASE WHEN test_errors IS NOT NULL THEN 1 ELSE 0 END) AS setup_errors
1076  		 , CAST((MAX(test_end) - MIN(test_start)) AS INTERVAL DAY(2) TO SECOND) AS run_time
1077  		 , CAST(SUM(test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS exec_time
1078  	      FROM otap_results
1079  	     WHERE test_session_id = cp_session_id
1080  	     GROUP BY test_session_id
1081  	     ORDER BY MIN(test_run_date)
1082  	  ;
1083  	  CURSOR cur_tests( cp_session_id  IN NUMBER
1084  			  , cp_test_set    IN VARCHAR2
1085  			  , cp_test_group  IN VARCHAR2
1086  			  , cp_test_name   IN VARCHAR2
1087  			  , cp_language_id IN VARCHAR2
1088  			  )
1089  	  IS
1090  	    SELECT test_desc
1091  		 , test_passed
1092  		 , otap_api.test_result_to_text(test_passed, cp_language_id) AS test_state
1093  		 , CAST((test_end - test_start) AS INTERVAL DAY(2) TO SECOND) AS run_time
1094  		 , test_errors
1095  		 , otap_api.test_result_to_text(CASE WHEN test_errors IS NULL THEN 1 ELSE -1 END, cp_language_id) AS issue_state
1096  	      FROM otap_results
1097  	     WHERE test_session_id = cp_session_id
1098  	       AND test_set	   = cp_test_set
1099  	       AND test_group	   = cp_test_group
1100  	       AND test_name	   = cp_test_name
1101  	     ORDER BY test_run_date
1102  	  ;
1103  	BEGIN
1104  	  l_setup_set	:= otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_SET, p_language_id);
1105  	  l_setup_group := otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_GROUP, p_language_id);
1106  	  l_setup_name	:= otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_NAME, p_language_id);
1107  	  l_report_size := otap_api.max_text_size(p_session_id, p_language_id);
1108  	  -- header row
1109  	  l_text_column := otap_api.get_report_header(l_report_size, p_language_id);
1110  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1111  	  l_text_column := otap_api.get_session_id_text(p_session_id, l_report_size);
1112  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1113  	  -- check for records
1114  	  SELECT COUNT(*) INTO l_has_records FROM otap_results WHERE test_session_id = p_session_id;
1115  	  IF l_has_records > 0
1116  	  THEN
1117  	    -- loop through the set
1118  	    FOR rec_set IN cur_test_sets(p_session_id, l_setup_set)
1119  	    LOOP
1120  	      -- build test set column
1121  	      l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size, p_language_id);
1122  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1123  	      -- build test set summary
1124  	      l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1125  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1126  	      l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.exec_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size, p_language_id);
1127  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1128  	      -- loop through the group
1129  	      FOR rec_grp IN cur_test_groups(p_session_id, rec_set.test_set, l_setup_group)
1130  	      LOOP
1131  		l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size, p_language_id);
1132  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1133  		-- build test set summary
1134  		l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1135  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1136  		l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.exec_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size, p_language_id);
1137  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1138  		-- loop through the names
1139  		FOR rec_nam IN cur_test_names(p_session_id, rec_set.test_set, rec_grp.test_group, l_setup_name)
1140  		LOOP
1141  		  l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size, p_language_id);
1142  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1143  		  -- build test set summary
1144  		  l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1145  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1146  		  l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.exec_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size, p_language_id);
1147  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1148  		  -- build header
1149  		  l_text_column := otap_api.get_result_header(l_report_size, p_language_id);
1150  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1151  		  --l_text_column := otap_api.get_result_underline(l_report_size, p_language_id);
1152  		  --PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1153  		  -- loop through the tests
1154  		  FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1155  		  LOOP
1156  		    l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size, p_language_id);
1157  		    PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1158  		  END LOOP;
1159  		  SELECT COUNT(*)
1160  		    INTO l_has_errors
1161  		    FROM otap_results
1162  		   WHERE test_session_id = p_session_id
1163  		     AND test_set	 = rec_set.test_set
1164  		     AND test_group	 = rec_grp.test_group
1165  		     AND test_name	 = rec_nam.test_name
1166  		     AND test_errors	IS NOT NULL
1167  		  ;
1168  		  IF l_has_errors > 0
1169  		  THEN
1170  		    -- build error delimiter for tests
1171  		    l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size, p_language_id);
1172  		    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1173  		    FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1174  		    LOOP
1175  		      IF rec_tst.test_errors IS NOT NULL
1176  		      THEN
1177  			l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size, p_language_id);
1178  			PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1179  		      END IF;
1180  		    END LOOP;
1181  		  END IF;
1182  		END LOOP;
1183  	      END LOOP;
1184  	    END LOOP;
1185  	    -- no loop through the test setup checks like count if exists
1186  	    FOR rec_set IN cur_setup_sets(p_session_id, l_setup_set)
1187  	    LOOP
1188  	      -- build test set column
1189  	      l_text_column := otap_api.get_set_text(rec_set.test_set, l_report_size, p_language_id);
1190  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1191  	      -- build test set summary
1192  	      l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1193  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1194  	      l_text_column := otap_api.get_summary(rec_set.run_time, rec_set.exec_time, rec_set.test_runs, rec_set.test_errors, rec_set.setup_errors, l_report_size, p_language_id);
1195  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1196  	      -- loop through the group
1197  	      FOR rec_grp IN cur_setup_groups(p_session_id, rec_set.test_set, l_setup_group)
1198  	      LOOP
1199  		l_text_column := otap_api.get_group_text(rec_grp.test_group, l_report_size, p_language_id);
1200  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1201  		-- build test set summary
1202  		l_text_column := otap_api.get_summary(rec_grp.run_time, rec_grp.exec_time, rec_grp.test_runs, rec_grp.test_errors, rec_grp.setup_errors, l_report_size, p_language_id);
1203  		PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1204  		-- loop through the names
1205  		FOR rec_nam IN cur_setup_names(p_session_id, rec_set.test_set, rec_grp.test_group, l_setup_name)
1206  		LOOP
1207  		  l_text_column := otap_api.get_test_name_text(rec_nam.test_name, l_report_size, p_language_id);
1208  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1209  		  -- build test set summary
1210  		  l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1211  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1212  		  l_text_column := otap_api.get_summary(rec_nam.run_time, rec_nam.exec_time, rec_nam.test_runs, rec_nam.test_errors, rec_nam.setup_errors, l_report_size, p_language_id);
1213  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1214  		  -- build header
1215  		  l_text_column := otap_api.get_result_header(l_report_size, p_language_id);
1216  		  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1217  		  --l_text_column := otap_api.get_result_underline(l_report_size, p_language_id);
1218  		  --PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1219  		  -- loop through the tests
1220  		  FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1221  		  LOOP
1222  		    l_text_column := otap_api.get_result_line(rec_tst.test_state, rec_tst.issue_state, rec_tst.run_time, rec_tst.test_desc, l_report_size, p_language_id);
1223  		    PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1224  		  END LOOP;
1225  		  SELECT COUNT(*)
1226  		    INTO l_has_errors
1227  		    FROM otap_results
1228  		   WHERE test_session_id = p_session_id
1229  		     AND test_set	 = rec_set.test_set
1230  		     AND test_group	 = rec_grp.test_group
1231  		     AND test_name	 = rec_nam.test_name
1232  		     AND test_errors	IS NOT NULL
1233  		  ;
1234  		  IF l_has_errors > 0
1235  		  THEN
1236  		    -- build error delimiter for tests
1237  		    l_text_column := otap_api.get_error_result_header(rec_nam.test_name, l_report_size, p_language_id);
1238  		    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1239  		    FOR rec_tst IN cur_tests(p_session_id, rec_set.test_set, rec_grp.test_group, rec_nam.test_name, p_language_id)
1240  		    LOOP
1241  		      IF rec_tst.test_errors IS NOT NULL
1242  		      THEN
1243  			l_text_column := otap_api.get_error_details(rec_tst.test_desc, otap_api.flatten(rec_tst.test_errors, 4000), l_report_size, p_language_id);
1244  			PIPE ROW (otap_view_result_rec(l_text_column, rec_tst.test_errors));
1245  		      END IF;
1246  		    END LOOP;
1247  		  END IF;
1248  		END LOOP;
1249  	      END LOOP;
1250  	    END LOOP;
1251  	    -- eventually build the totals for the test session
1252  	    l_text_column := otap_api.get_report_total(l_report_size, p_language_id);
1253  	    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1254  	    FOR rec IN cur_session_total(p_session_id)
1255  	    LOOP
1256  	      l_text_column := otap_api.get_report_total_details(rec.test_sets, rec.test_groups, rec.test_names, rec.test_descs, l_report_size, p_language_id);
1257  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1258  	      l_text_column := otap_api.get_summary_header(l_report_size, p_language_id);
1259  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1260  	      l_text_column := otap_api.get_summary(rec.run_time, rec.exec_time, rec.test_runs, rec.test_errors, rec.setup_errors, l_report_size, p_language_id);
1261  	      PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1262  	    END LOOP;
1263  	  ELSE
1264  	    l_text_column := otap_api.get_no_data_text(p_session_id, l_report_size, p_language_id);
1265  	    PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1266  	  END IF;
1267  	  -- footer row
1268  	  l_text_column := otap_api.get_report_footer(l_report_size, p_language_id);
1269  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1270  	  -- add AI and copyright
1271  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_NAME, l_report_size);
1272  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1273  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_VERSION_NR, l_report_size);
1274  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1275  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_COPYRIGHT1, l_report_size);
1276  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1277  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_COPYRIGHT2, l_report_size);
1278  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1279  	  l_text_column := otap_api.get_version_info(otap_constants.OTAP_INTERNAL_COPYRIGHT3, l_report_size);
1280  	  PIPE ROW (otap_view_result_rec(l_text_column, NULL));
1281  	  RETURN;
1282  	EXCEPTION
1283  	  WHEN NO_DATA_NEEDED THEN
1284  	    RAISE;
1285  	  WHEN OTHERS THEN
1286  	    IF SQLCODE != -20099
1287  	    THEN
1288  	      otap_log.log(SQLERRM, 'otap_api.result_view', 'Unhandled exception otap_api.result_view');
1289  	    END IF;
1290  	    RAISE;
1291  	END result_view;
1292  
1293  	-- test functions
1294  
1295  	FUNCTION has_table( p_table_name      IN	    VARCHAR2
1296  			  , o_otap_session    IN OUT NOCOPY OTAP_SESSION
1297  			  , p_schema	      IN	    VARCHAR2	 DEFAULT NULL
1298  			  , p_description     IN	    VARCHAR2	 DEFAULT NULL
1299  			  , p_expected_result IN	    NUMBER	 DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
1300  			  )
1301  	  RETURN VARCHAR2
1302  	IS
1303  	  l_script	     VARCHAR2(1024 CHAR)		  := 'otap_api.has_table';
1304  	  l_start	     TIMESTAMP;
1305  	  l_result	     INTEGER;
1306  	  l_return	     VARCHAR2(4000 CHAR);
1307  	  l_errors	     otap_results.test_errors%TYPE;
1308  	  l_schema	     otap_results.db_schema%TYPE;
1309  	  l_desc	     otap_results.test_desc%TYPE;
1310  	BEGIN
1311  	  l_start  := SYSTIMESTAMP;
1312  	  -- default return
1313  	  l_return := otap_util.test_result_to_text(otap_constants.OTAP_NUM_TEST_UNDEFINED, o_otap_session.session_language) || ' ' || otap_constants.OTAP_INTERNAL_NA;
1314  	  -- own begin-end for the transaction after the function
1315  	  BEGIN
1316  	    -- own begin-end block for the function itself and prepare
1317  	    BEGIN
1318  	      l_schema := TRIM(NVL(p_schema, o_otap_session.db_schema));
1319  	      l_desc   := otap_string.reduce( otap_report.get_exists_msg( p_object_name => p_table_name
1320  									, p_schema_name => l_schema
1321  									, p_object_type => otap_util.CFG_LABEL_TABLE
1322  									, p_sub_object => NULL
1323  									, p_test_desc => p_description
1324  									, p_language_id => o_otap_session.session_language
1325  									)
1326  					    , 256
1327  					    )
1328  	      ;
1329  	      -- call function
1330  	      l_result := otap_schema.has_table( p_table_name
1331  					       , l_errors
1332  					       , l_schema
1333  					       , p_expected_result
1334  					       )
1335  	      ;
1336  	    EXCEPTION
1337  	      WHEN OTHERS THEN
1338  	      -- consume error
1339  	      l_result := otap_constants.OTAP_NUM_TEST_UNDEFINED;
1340  	      l_errors := otap_string.reduce('Internal error ' || l_script || ': ' || SQLERRM, 4000);
1341  	      otap_log.log(SQLERRM, l_script, 'Execute ' || l_script || ' function');
1342  	    END;
1343  	    -- write result
1344  	    l_return := otap_plan.write_test_result(l_desc, o_otap_session, l_schema, l_result, l_start, l_errors);
