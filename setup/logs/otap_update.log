1197  	FUNCTION has_user( p_username		   IN		 VARCHAR2
1198  			 , o_errors		      OUT NOCOPY VARCHAR2
1199  			 , p_account_status	   IN		 VARCHAR2 DEFAULT NULL
1200  			 , p_default_tablespace    IN		 VARCHAR2 DEFAULT NULL
1201  			 , p_temporary_tablespace  IN		 VARCHAR2 DEFAULT NULL
1202  			 , p_local_temp_tablespace IN		 VARCHAR2 DEFAULT NULL
