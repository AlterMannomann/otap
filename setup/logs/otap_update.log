120    FUNCTION ok( p_boolean	      IN	    BOOLEAN
121  		  , o_errors		 OUT NOCOPY VARCHAR2
122  		  , p_expected_result IN	    NUMBER   DEFAULT otap_constants.OTAP_NUM_TEST_PASSED
123  		  )
124  	 RETURN INTEGER
125    IS
126  	 l_script	 VARCHAR2(1024 CHAR) := 'otap_logic.ok';
127  	 l_test_passed	 INTEGER;
128  	 l_expected	 INTEGER;
129  	 l_errors	 VARCHAR2(32767 CHAR);
130    BEGIN
131  	 l_errors      := NULL;
132  	 l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
133  	 l_expected    := NVL(p_expected_result, otap_constants.OTAP_NUM_TEST_PASSED);
134  	 IF p_boolean IS NOT NULL
135  	 THEN
136  	   l_test_passed := CASE WHEN p_boolean THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
137  	 ELSE
138  	   l_test_passed := otap_constants.OTAP_NUM_TEST_UNDEFINED;
139  	   -- NULL is not a valid boolean
140  	   l_errors := 'Not allowed: p_boolean(NULL)';
141  	   otap_log.log(l_errors, l_script);
142  	 END IF;
143  	 -- now decide on the expected result the final state and if errors are returned
144  	 IF l_test_passed != l_expected
145  	 THEN
146  	   o_errors := otap_string.reduce(l_errors, 4000);
147  	 ELSE
148  	   -- overwrite states from before, as we fulfill expected
149  	   l_test_passed := otap_constants.OTAP_NUM_TEST_PASSED;
150  	   -- overwrite errors expected
151  	   o_errors := NULL;
152  	 END IF;
153  	 RETURN l_test_passed;
154    EXCEPTION
155  	 WHEN OTHERS THEN
156  	   IF SQLCODE != -20099
157  	   THEN
158  	     -- log unhandled exceptions
159  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
160  	   END IF;
161  	   RAISE;
162    END ok;
