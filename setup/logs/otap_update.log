SQL> @@../otap_ddl/packages/otap_log.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_log
  2  AS
  3  
  4    /** internal FUNCTION otap_log.debug_active
  5    * Returns the debug state, defined in OTAP_CONFIG. Can't log errors as log depends on
  6    * this function. Fail save.
  7    *
  8    * @return TRUE if DEBUG_MODE is set to 1 in OTAP_CONFIG, otherwise or on errors FALSE.
  9    */
 10    FUNCTION debug_active
 11  	 RETURN BOOLEAN
 12    IS
 13  	 l_debug_mode  VARCHAR2(1 CHAR);
 14  	 l_return      BOOLEAN;
 15    BEGIN
 16  	 l_return := FALSE;
 17  	 SELECT config_value INTO l_debug_mode FROM otap_config WHERE config_name = otap_constants.OTAP_CFG_DEBUG_MODE;
 18  	 IF l_debug_mode = '1'
 19  	 THEN
 20  	   l_return := TRUE;
 21  	 END IF;
 22  	 RETURN l_return;
 23    EXCEPTION
 24  	 WHEN OTHERS THEN
 25  	   RETURN FALSE;
 26    END debug_active;
 27  
 28    -- for description see header file
 29    PROCEDURE log( p_log_message  IN VARCHAR2
 30  		    , p_script	     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 31  		    , p_statement    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
 32  		    , p_identifier   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_ERROR
 33  		    )
 34    IS
 35  	 PRAGMA AUTONOMOUS_TRANSACTION;
 36  	 l_has_sperrorlog  NUMBER;
 37    BEGIN
 38  	 -- check which type of log
 39  	 IF    p_identifier IN (otap_constants.OTAP_INTERNAL_ERROR, otap_constants.OTAP_INTERNAL_WARNING)
 40  	    OR otap_log.debug_active
 41  	 THEN
 42  	   -- check if table exists
 43  	   SELECT COUNT(*) INTO l_has_sperrorlog FROM user_tables WHERE table_name = 'SPERRORLOG';
 44  	   IF l_has_sperrorlog = 1
 45  	   THEN
 46  	     INSERT INTO sperrorlog
 47  	       ( username
 48  	       , timestamp
 49  	       , script
 50  	       , identifier
 51  	       , message
 52  	       , statement
 53  	       )
 54  	       VALUES ( otap_constants.OTAP_INTERNAL_SCHEMA
 55  		      , SYSTIMESTAMP
 56  		      , p_script
 57  		      , TRIM(SUBSTR(TRIM(p_identifier), 1, 256))
 58  		      , p_log_message
 59  		      , p_statement
 60  		      )
 61  	     ;
 62  	     COMMIT;
 63  	   ELSE
 64  	     -- give some output even if no one will notice it
 65  	     DBMS_OUTPUT.PUT_LINE('No logging possible, SPERRORLOG table does not exist');
 66  	   END IF;
 67  	 END IF;
 68    EXCEPTION
 69  	 WHEN OTHERS THEN
 70  	   -- explicitly do not care about log exceptions, application should fail otherwise
 71  	   -- logging is not critical for otap, only an option, usually not recommended to do
 72  	   -- it this way, give some output even if no one will notice it
 73  	   DBMS_OUTPUT.PUT_LINE(SQLERRM);
 74    END log;
 75  
 76  END;
 77  /

