SQL> @@../otap_ddl/packages/otap_plan.pkb
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> CREATE OR REPLACE PACKAGE BODY otap_plan
  2  AS
  3    -- for description see header file
  4    FUNCTION write_test_result( p_test_description IN	    VARCHAR2
  5  				 , o_otap_session     IN OUT NOCOPY OTAP_SESSION
  6  				 , p_schema_used      IN	    VARCHAR2
  7  				 , p_test_passed      IN	    NUMBER
  8  				 , p_test_start       IN	    TIMESTAMP
  9  				 , p_test_errors      IN	    VARCHAR2
 10  				 )
 11  	 RETURN VARCHAR2
 12    IS
 13  	 l_script	     VARCHAR2(1024 CHAR) := 'otap_plan.write_test_result';
 14  	 l_test_passed	     INTEGER;
 15  	 l_test_description  VARCHAR2(256 CHAR);
 16  	 l_errors	     VARCHAR2(4000 CHAR);
 17  	 l_to_delete	     INTEGER;
 18  	 l_end		     TIMESTAMP;
 19  	 l_return	     VARCHAR2(4000 CHAR);
 20    BEGIN
 21  	 otap_objects.otap_session_verify(o_otap_session);
 22  	 IF NVL(LENGTH(TRIM(p_test_errors)), 0) > 4000
 23  	 THEN
 24  	   l_errors := otap_string.reduce(p_test_errors, 4000);
 25  	 ELSE
 26  	   l_errors := TRIM(p_test_errors);
 27  	 END IF;
 28  	 IF p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)
 29  	 THEN
 30  	   l_test_passed := p_test_passed;
 31  	 ELSE
 32  	   l_test_passed := otap_constants.OTAP_NUM_TEST_FAILED;
 33  	   l_errors	 := otap_string.reduce('Invalid test passed value: ' || p_test_passed || otap_constants.OTAP_INTERNAL_LF || l_errors, 4000);
 34  	   otap_log.log('ERROR The given value for test passed ' || p_test_passed || ' for test description ' || p_test_description || ' is not valid.', l_script, 'p_test_passed IN (otap_constants.OTAP_NUM_TEST_FAILED, otap_constants.OTAP_NUM_TEST_PASSED, otap_constants.OTAP_NUM_TEST_UNDEFINED)');
 35  	 END IF;
 36  	 IF p_test_description IS NULL
 37  	 THEN
 38  	   l_test_description := 'Unspecified test ' || TIMESTAMP_TO_SCN(SYSTIMESTAMP);
 39  	   l_errors	      := otap_string.reduce('Missing test description' || otap_constants.OTAP_INTERNAL_LF || l_errors, 4000);
 40  	 ELSE
 41  	   IF LENGTH(p_test_description) > 256
 42  	   THEN
 43  	     l_test_description := otap_string.reduce(p_test_description, 256);
 44  	     l_errors		:= otap_string.reduce('Test description too long, cutted' || otap_constants.OTAP_INTERNAL_LF || l_errors, 4000);
 45  	   ELSE
 46  	     l_test_description := TRIM(p_test_description);
 47  	   END IF;
 48  	 END IF;
 49  	 -- set delete flag as stored
 50  	 l_to_delete := CASE WHEN o_otap_session.persist_test THEN otap_constants.OTAP_NUM_FALSE ELSE otap_constants.OTAP_NUM_TRUE END;
 51  	 l_end := SYSTIMESTAMP;
 52  	 -- ready to insert
 53  	 otap_util.write_test_result( l_to_delete
 54  				    , l_test_passed
 55  				    , o_otap_session.session_id
 56  				    , o_otap_session.test_executor
 57  				    , o_otap_session.test_set
 58  				    , o_otap_session.db_user
 59  				    , NVL(p_schema_used, o_otap_session.db_schema)
 60  				    , o_otap_session.test_group
 61  				    , p_test_start
 62  				    , l_end
 63  				    , o_otap_session.test_name
 64  				    , l_test_description
 65  				    , l_errors
 66  				    )
 67  	 ;
 68  	 -- add test to session var
 69  	 otap_objects.otap_session_add_test(l_test_passed, o_otap_session);
 70  	 l_return := otap_string.reduce(otap_util.test_result_to_text(l_test_passed, o_otap_session.session_language) || ' ' || l_test_description, 4000);
 71  	 RETURN l_return;
 72    EXCEPTION
 73  	 WHEN OTHERS THEN
 74  	   IF SQLCODE != -20099
 75  	   THEN
 76  	     -- log unhandled exceptions
 77  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
 78  	   END IF;
 79  	   RAISE;
 80    END write_test_result;
 81  
 82    PROCEDURE write_count_result(o_otap_session IN OUT NOCOPY OTAP_SESSION)
 83    IS
 84  	 l_script	     VARCHAR2(1024 CHAR) := 'otap_plan.write_count_result';
 85  	 l_test_passed	     INTEGER;
 86  	 l_test_count	     INTEGER;
 87  	 l_test_description  VARCHAR2(256 CHAR);
 88  	 l_errors	     VARCHAR2(4000 CHAR);
 89  	 l_start	     TIMESTAMP;
 90  	 l_tmp_otap_session  OTAP_SESSION;
 91  	 l_return	     VARCHAR2(4000 CHAR);
 92    BEGIN
 93  	 l_start := SYSTIMESTAMP;
 94  	 -- only write a record, if intended count is set, do nothing otherwise
 95  	 IF o_otap_session.intended_count > 0
 96  	 THEN
 97  	   -- we have a test pending not counted yet
 98  	   l_test_count       := o_otap_session.test_count + 1;
 99  	   l_test_passed      := CASE WHEN l_test_count = o_otap_session.intended_count THEN otap_constants.OTAP_NUM_TEST_PASSED ELSE otap_constants.OTAP_NUM_TEST_FAILED END;
100  	   l_test_description := otap_string.reduce(otap_report.get_count_desc(l_test_count, o_otap_session.intended_count), 256);
101  	   l_errors	      := NULL;
102  	   l_tmp_otap_session := otap_objects.otap_session_test_setup( o_otap_session
103  								     , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_SET, o_otap_session.session_language)
104  								     , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_GROUP, o_otap_session.session_language)
105  								     , otap_util.get_config_value(otap_util.CFG_TEXT_TEST_SETUP_NAME, o_otap_session.session_language)
106  								     )
107  	   ;
108  	   l_tmp_otap_session.test_count := l_test_count;
109  	   l_return := otap_plan.write_test_result(l_test_description, l_tmp_otap_session, NULL, l_test_passed, l_start, l_errors);
110  	   -- take over the test and error count changes
111  	   o_otap_session.test_count  := l_tmp_otap_session.test_count;
112  	   o_otap_session.error_count := l_tmp_otap_session.error_count;
113  	 END IF;
114    EXCEPTION
115  	 WHEN OTHERS THEN
116  	   IF SQLCODE != -20099
117  	   THEN
118  	     -- log unhandled exceptions
119  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
120  	   END IF;
121  	   RAISE;
122    END write_count_result;
123  
124    FUNCTION init_test( p_test_count 	 IN	       NUMBER
125  			 , p_test_set		 IN	       VARCHAR2
126  			 , p_test_group 	 IN	       VARCHAR2
127  			 , p_test_name		 IN	       VARCHAR2
128  			 , p_prefix		 IN	       VARCHAR2
129  			 , p_language_id	 IN	       VARCHAR2
130  			 , p_name_precedence	 IN	       NUMBER
131  			 , p_include_pkg	 IN	       NUMBER
132  			 , p_persist		 IN	       NUMBER
133  			 , p_schema		 IN	       VARCHAR2
134  			 , p_user		 IN	       VARCHAR2
135  			 , p_executor		 IN	       VARCHAR2
136  			 , o_otap_session	 IN OUT NOCOPY OTAP_SESSION
137  			 )
138  	 RETURN VARCHAR2
139    IS
140  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.init_test';
141  	 l_message VARCHAR2(4000 CHAR);
142    BEGIN
143  	 -- if test count is not 0 this is a reset, write a test count record, if intended count is set
144  	 IF	o_otap_session.test_count      > 0
145  	    AND (   o_otap_session.intended_count  > 0
146  		 OR NVL(p_test_count, 0)	   > 0
147  		)
148  	 THEN
149  	   -- write record with current values
150  	   otap_plan.write_count_result(o_otap_session);
151  	   l_message := 'Closed test session summary' || otap_constants.OTAP_INTERNAL_LF;
152  	   l_message := l_message || otap_objects.otap_session_summary(o_otap_session) || otap_constants.OTAP_INTERNAL_LF;
153  	 END IF;
154  	 -- now start setting the new values
155  	 l_message := l_message || otap_objects.otap_session_set( p_test_count
156  								, p_test_set
157  								, p_test_group
158  								, p_test_name
159  								, p_prefix
160  								, p_language_id
161  								, p_name_precedence
162  								, p_include_pkg
163  								, p_persist
164  								, p_schema
165  								, p_user
166  								, p_executor
167  								, o_otap_session
168  								)
169  	 ;
170  	 RETURN l_message;
171    EXCEPTION
172  	 WHEN OTHERS THEN
173  	   IF SQLCODE != -20099
174  	   THEN
175  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
176  	   END IF;
177  	   RAISE;
178    END init_test;
179  
180    FUNCTION finish_test( p_write_count_rec IN	     NUMBER
181  			   , o_otap_session    IN OUT NOCOPY OTAP_SESSION
182  			   )
183  	 RETURN VARCHAR2
184    IS
185  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.finish_test';
186  	 l_message VARCHAR2(4000 CHAR);
187    BEGIN
188  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
189  	 THEN
190  	   otap_plan.write_count_result(o_otap_session);
191  	 END IF;
192  	 l_message := otap_objects.otap_session_finish(o_otap_session);
193  	 RETURN l_message;
194    EXCEPTION
195  	 WHEN OTHERS THEN
196  	   IF SQLCODE != -20099
197  	   THEN
198  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
199  	   END IF;
200  	   RAISE;
201    END finish_test;
202  
203    FUNCTION finish_test_with_exit_code( p_write_count_rec IN	    NUMBER
204  					  , o_otap_session    IN OUT NOCOPY OTAP_SESSION
205  					  )
206  	 RETURN NUMBER
207    IS
208  	 l_script  VARCHAR2(1024 CHAR) := 'otap_plan.finish_test_with_exit_code';
209  	 l_message VARCHAR2(4000 CHAR);
210  	 l_return  INTEGER;
211    BEGIN
212  	 IF p_write_count_rec = otap_constants.OTAP_NUM_TRUE
213  	 THEN
214  	   otap_plan.write_count_result(o_otap_session);
215  	 END IF;
216  	 -- check the test status of the current session before closing
217  	   WITH trl AS
218  		(SELECT test_session_id
219  		      , CASE test_passed WHEN 1 THEN 0 WHEN -1 THEN 1 ELSE 2 END AS exit_code
220  		   FROM otap_results
221  		  WHERE test_session_id = o_otap_session.session_id
222  		)
223  	 SELECT NVL(MAX(exit_code), 2)
224  	   INTO l_return
225  	   FROM trl
226  	 ;
227  	 -- finish the session
228  	 l_message := otap_objects.otap_session_finish(o_otap_session);
229  	 -- return exit code
230  	 RETURN l_return;
231    EXCEPTION
232  	 WHEN OTHERS THEN
233  	   IF SQLCODE != -20099
234  	   THEN
235  	     otap_log.log(SQLERRM, l_script, 'Unhandled exception ' || l_script || ' call');
236  	   END IF;
237  	   RAISE;
238    END finish_test_with_exit_code;
239  
240  END;
241  /

