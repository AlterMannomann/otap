SQL> CREATE OR REPLACE TRIGGER otap_translate_ins_trg
  2    BEFORE INSERT ON otap_translate
  3    FOR EACH ROW
  4  BEGIN
  5    :NEW.created	   := SYSDATE;
  6    :NEW.created_by	   := SYS_CONTEXT('USERENV', 'SESSION_USER');
  7    :NEW.created_by_os  := SYS_CONTEXT('USERENV', 'OS_USER');
  8    :NEW.language_id    := otap_string.reduce(UPPER(NVL(:NEW.language_id, otap_constants.OTAP_INTERNAL_NA)), 3);
  9  
 10    -- check if the label is defined and translatable, deny if not, ignore if not in otap_config
 11    otap_util.validate_translatable(:NEW.otap_identifier);
 12    -- check length constraints on config values
 13    otap_util.validate_translation(:NEW.otap_identifier, :NEW.label_text);
 14  END;
