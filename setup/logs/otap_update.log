479    FUNCTION get_result_line( p_test_state  IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
480  			       , p_issue_state IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
481  			       , p_runtime     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
482  			       , p_test_desc   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
483  			       , p_min_fill    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
484  			       , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
485  			       )
486  	 RETURN VARCHAR2
487    IS
488  	 l_return_text	 VARCHAR2(32767 CHAR);
489  	 l_template_text VARCHAR2(32767 CHAR);
490  	 l_test_state	 VARCHAR2(32767 CHAR);
491  	 l_issue_state	 VARCHAR2(32767 CHAR);
492  	 l_runtime	 VARCHAR2(32767 CHAR);
493  	 l_desc 	 VARCHAR2(32767 CHAR);
494  	 l_runtime_len	 INTEGER;
495  	 l_desc_len	 INTEGER;
496    BEGIN
497  	 -- get and prepare template
498  	 l_runtime_len := otap_util.interval_size;
499  	 l_desc_len    := NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH) - ((2 * otap_util.get_length_test_state(p_language_id)) + l_runtime_len + 3);
500  	 IF l_desc_len <= 0
501  	 THEN
502  	   -- wrong configuration, use a default, display will be not correct but possible
503  	   l_desc_len := otap_constants.OTAP_NUM_MIN_FILL_LENGTH;
504  	 END IF;
505  	 -- states must be padded to max state size for correct formatting and consider the layout
506  	 IF otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT) = otap_constants.OTAP_LAYOUT_RIGHT
507  	 THEN
508  	   l_test_state  := otap_string.cut(LPAD(NVL(p_test_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state(p_language_id), ' '), otap_util.get_length_test_state(p_language_id));
509  	   l_issue_state := otap_string.cut(LPAD(NVL(p_issue_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state(p_language_id), ' '), otap_util.get_length_test_state(p_language_id));
510  	   l_runtime	 := otap_string.cut(LPAD(NVL(p_runtime, otap_constants.OTAP_INTERNAL_NA), l_runtime_len, ' '), l_runtime_len);
511  	   l_desc	 := otap_string.cut(LPAD(NVL(p_test_desc, otap_constants.OTAP_INTERNAL_NA), l_desc_len, ' '), l_desc_len);
512  	 ELSE
513  	   -- treat middle and left the same way
514  	   l_test_state  := otap_string.cut(RPAD(NVL(p_test_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state(p_language_id), ' '), otap_util.get_length_test_state(p_language_id));
515  	   l_issue_state := otap_string.cut(RPAD(NVL(p_issue_state, otap_constants.OTAP_INTERNAL_NA), otap_util.get_length_test_state(p_language_id), ' '), otap_util.get_length_test_state(p_language_id));
516  	   l_runtime	 := otap_string.cut(RPAD(NVL(p_runtime, otap_constants.OTAP_INTERNAL_NA), l_runtime_len, ' '), l_runtime_len);
517  	   l_desc	 := otap_string.cut(RPAD(NVL(p_test_desc, otap_constants.OTAP_INTERNAL_NA), l_desc_len, ' '), l_desc_len);
518  	 END IF;
519  	 l_template_text := otap_util.get_config_value(otap_util.CFG_TEMPLATE_RESULT_LINE, p_language_id);
520  	 l_template_text := REPLACE(l_template_text, '@teststate@', l_test_state);
521  	 l_template_text := REPLACE(l_template_text, '@issuestate@', l_issue_state);
522  	 l_template_text := REPLACE(l_template_text, '@runtime@', l_runtime);
523  	 l_template_text := REPLACE(l_template_text, '@testdesc@', l_desc);
524  	 -- get borderless
525  	 l_return_text := otap_report.borderless( l_template_text
526  						, GREATEST(NVL(p_min_fill, otap_constants.OTAP_NUM_MIN_FILL_LENGTH), NVL(LENGTH(l_template_text), 0), otap_util.get_length_headers(p_language_id))
527  						, p_language_id
528  						)
529  	 ;
530  	 RETURN l_return_text;
531    EXCEPTION
532  	 WHEN OTHERS THEN
533  	   otap_log.log(SQLERRM, 'otap_report.get_result_line', 'Build result line by template');
534  	   RAISE;
535    END get_result_line;
