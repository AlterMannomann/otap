SQL> CREATE OR REPLACE PACKAGE BODY otap_generate
  2  AS
  3    -- internal package constants and variables
  4    PREFIX_SQL	   CONSTANT CHAR(7)  := 'SELECT ';
  5    PREFIX_PLSQL	   CONSTANT CHAR(15) := '  l_message := ';
  6    POSTFIX_SQL	   CONSTANT CHAR(11) := ' FROM dual;';
  7    POSTFIX_PLSQL	   CONSTANT CHAR(1)  := ';';
  8  
  9    generation_type VARCHAR2(1) := otap_constants.OTAP_GEN_TYPE_SCRIPT;
 10  
 11    -- for description see header file
 12    PROCEDURE set_gen_type(p_gen_type IN VARCHAR2)
 13    IS
 14    BEGIN
 15  	 IF TRIM(p_gen_type) IN (otap_constants.OTAP_GEN_TYPE_SCRIPT, otap_constants.OTAP_GEN_TYPE_FUNCTION, otap_constants.OTAP_GEN_TYPE_PROCEDURE)
 16  	 THEN
 17  	   generation_type := TRIM(p_gen_type);
 18  	 END IF;
 19    END set_gen_type;
 20  
 21    FUNCTION get_gen_type
 22  	 RETURN VARCHAR2
 23    IS
 24    BEGIN
 25  	 RETURN generation_type;
 26    END;
