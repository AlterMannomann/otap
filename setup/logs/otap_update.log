1254  	       AND temporary_tablespace 	       = NVL(l_temporary_tablespace, temporary_tablespace)
1255  	       AND NVL(local_temp_tablespace, 'n/a')   = NVL(l_local_temp_tablespace, NVL(local_temp_tablespace, 'n/a'))
1256  	       AND profile			       = NVL(l_profile, profile)
1257  	       AND TRIM(NVL(password_versions, 'n/a')) = NVL(l_password_versions, TRIM(NVL(password_versions, 'n/a')))
1258  	       AND NVL(authentication_type, 'n/a')     = NVL(l_authentication_type, NVL(authentication_type, 'n/a'))
