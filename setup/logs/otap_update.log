687  				, p_rel_object	    IN VARCHAR2 DEFAULT NULL
688  				, p_rel_subobject   IN VARCHAR2 DEFAULT NULL
689  				, p_test_desc	    IN VARCHAR2 DEFAULT NULL
690  				, p_language_id     IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
691  				)
692  	 RETURN VARCHAR2
693    IS
694  	 l_template_text VARCHAR2(32767 CHAR);
695  	 -- '@type@ @name@ for @otype@ @object@.@subobject@ exists check (@schema@)'
696    BEGIN
697  	 IF	p_rel_object	IS NOT NULL
698  	    AND p_rel_subobject IS NOT NULL
699  	 THEN
700  	   l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_EXISTS_FX
701  						 , p_type_label => p_check_type
702  						 , p_param1 => '@otype@'
703  						 , p_param1_value => otap_util.get_config_value(p_rel_object_type)
704  						 , p_param2 => '@schema@'
705  						 , p_param2_value => p_schema_name
706  						 , p_param3 => '@object@'
707  						 , p_param3_value => p_rel_object
708  						 , p_param4 => '@subobject@'
709  						 , p_param4_value => p_rel_subobject
710  						 , p_param6n => '@name@'
711  						 , p_param6n_value => p_check_object
712  						 , p_description => p_test_desc
713  						 , p_language_id => p_language_id
714  						 )
715  	   ;
716  	 ELSE
717  	   IF p_rel_object IS NOT NULL
718  	   THEN
719  	     l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_EXISTS_F
720  						   , p_type_label => p_check_type
721  						   , p_param1 => '@otype@'
722  						   , p_param1_value => otap_util.get_config_value(p_rel_object_type)
723  						   , p_param2 => '@schema@'
724  						   , p_param2_value => p_schema_name
725  						   , p_param3 => '@object@'
726  						   , p_param3_value => p_rel_object
727  						   , p_param6n => '@name@'
728  						   , p_param6n_value => p_check_object
729  						   , p_description => p_test_desc
730  						   , p_language_id => p_language_id
731  						   )
732  	     ;
733  	   ELSE
734  	     l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_EXISTS
735  						   , p_type_label => p_check_type
736  						   , p_param1 => '@object@'
737  						   , p_param1_value => p_check_object
738  						   , p_param2 => '@schema@'
739  						   , p_param2_value => p_schema_name
740  						   , p_description => p_test_desc
741  						   , p_language_id => p_language_id
742  						   )
743  	     ;
744  	   END IF;
745  	 END IF;
746  	 RETURN l_template_text;
747    EXCEPTION
748  	 WHEN OTHERS THEN
749  	   otap_log.log(SQLERRM, 'otap_report.get_exists_f_msg', 'Build related object exists result message');
750  	   RAISE;
751    END get_exists_f_msg;
752  
753    FUNCTION get_match_msg( p_match_type  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
754  			     , p_match_data  IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
755  			     , p_test_desc   IN VARCHAR2 DEFAULT NULL
756  			     , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
757  			     )
758  	 RETURN VARCHAR2
759    IS
760  	 l_template_text VARCHAR2(32767 CHAR); -- '@type@ match (@data@)'
761    BEGIN
762  	 l_template_text := otap_util.build_msg( p_cfg_template => otap_util.CFG_TEMPLATE_MATCH
763  					       , p_type_label => p_match_type
764  					       , p_param1 => '@data@'
765  					       , p_param1_value => p_match_data
766  					       , p_description => p_test_desc
767  					       , p_language_id => p_language_id
768  					       )
769  	 ;
770  	 RETURN l_template_text;
771    EXCEPTION
772  	 WHEN OTHERS THEN
773  	   otap_log.log(SQLERRM, 'otap_report.get_match_msg', 'Build match compare result message');
774  	   RAISE;
775    END get_match_msg;
776  
777  END;
