2641  	  ;
2642  	  CURSOR cur_tables( cp_like   IN VARCHAR2
2643  			   , cp_schema IN VARCHAR2
2644  			   , cp_prefix IN VARCHAR2
2645  			   , cp_excl   IN NUMBER
2646  			   )
2647  	  IS
2648  	    SELECT result_text
