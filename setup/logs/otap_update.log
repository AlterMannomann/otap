240    FUNCTION get_summary( p_status	   IN VARCHAR2 DEFAULT otap_constants.OTAP_FALLBACK_TEXT_TEST_UNDEFINED
241  			   , p_runtime	   IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
242  			   , p_exectime    IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
243  			   , p_runs	   IN NUMBER   DEFAULT 0
244  			   , p_errors	   IN NUMBER   DEFAULT 0
245  			   , p_issues	   IN NUMBER   DEFAULT 0
246  			   , p_min_fill    IN INTEGER  DEFAULT otap_constants.OTAP_NUM_MIN_FILL_LENGTH
247  			   , p_language_id IN VARCHAR2 DEFAULT otap_constants.OTAP_INTERNAL_NA
248  			   )
249  	 RETURN VARCHAR2
250    IS
251  	 l_return_text	 VARCHAR2(32767 CHAR);
252  	 l_template_text VARCHAR2(32767 CHAR);
253  	 l_fallback	 VARCHAR2(4000 CHAR);
254  	 l_fmt_text	 VARCHAR2(4000 CHAR);
255  	 l_runtime	 VARCHAR2(128 CHAR);
256  	 l_exectime	 VARCHAR2(128 CHAR);
257  	 l_layout	 VARCHAR2(1 CHAR);
258  	 l_fmt_len	 INTEGER;
259  	 l_time_len	 INTEGER;
260    BEGIN
261  	 -- fetch template
262  	 l_template_text := otap_util.get_config_value(otap_util.CFG_TEMPLATE_SUMMARY, p_language_id);
263  	 -- replace variables and format them before USE TEST_PASSED (also undefined) delete SUMMARY text
264  	 l_fallback := otap_util.get_config_value(otap_util.CFG_TEXT_TEST_UNDEFINED, p_language_id);
265  	 l_layout   := otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT, p_language_id);
266  	 l_fmt_len  := otap_util.get_length_test_state(p_language_id);
267  	 l_fmt_text := NVL(p_status, l_fallback);
268  	 l_time_len := otap_util.interval_size;
269  	 IF l_layout = otap_constants.OTAP_LAYOUT_RIGHT
270  	 THEN
271  	   l_fmt_text := LPAD(l_fmt_text, l_fmt_len, ' ');
272  	   l_runtime  := LPAD(NVL(p_runtime, otap_constants.OTAP_INTERNAL_NA), l_time_len, ' ');
273  	   l_exectime := LPAD(NVL(p_exectime, otap_constants.OTAP_INTERNAL_NA), l_time_len, ' ');
274  	 ELSE
275  	   l_fmt_text := RPAD(l_fmt_text, l_fmt_len, ' ');
276  	   l_runtime  := RPAD(NVL(p_runtime, otap_constants.OTAP_INTERNAL_NA), l_time_len, ' ');
277  	   l_exectime := RPAD(NVL(p_exectime, otap_constants.OTAP_INTERNAL_NA), l_time_len, ' ');
278  	 END IF;
279  	 l_template_text := REPLACE(l_template_text, '@status@', l_fmt_text);
280  	 l_template_text := REPLACE(l_template_text, '@runtime@', l_runtime);
281  	 l_template_text := REPLACE(l_template_text, '@exectime@', l_exectime);
