SQL> -- Executes the test code for otap_log that handles parameter as currently set.
SQL> -- Parameter can be changed before running this code to test different parameter.
SQL> -- The test name must be set outside of this code.
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> DECLARE
  2    l_return VARCHAR2(4000 CHAR);
  3    l_stamp	TIMESTAMP;
  4    l_finish TIMESTAMP;
  5    l_debug	INTEGER;
  6  BEGIN
  7    l_stamp	 := SYSTIMESTAMP;
  8    otap_log.log('OTAP_TEST: Basic error logging test');
  9    l_finish  := SYSTIMESTAMP;
 10    SELECT otap_test.is_eq(COUNT(*), 1, 'Check basic message logging')
 11  	 INTO l_return
 12  	 FROM sperrorlog
 13  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Basic error logging test'
 14  	  AND TO_CHAR(script)	 = otap_constants.OTAP_INTERNAL_NA
 15  	  AND TO_CHAR(statement) = otap_constants.OTAP_INTERNAL_NA
 16  	  AND identifier	 = otap_constants.OTAP_INTERNAL_ERROR
 17  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 18  	  AND timestamp 	>= l_stamp
 19  	  AND timestamp 	<= l_finish
 20    ;
 21    l_stamp	 := SYSTIMESTAMP;
 22    otap_log.log('OTAP_TEST: Full error logging test', 'otap_log.sql', 'My statement');
 23    l_finish  := SYSTIMESTAMP;
 24    SELECT otap_test.is_eq(COUNT(*), 1, 'Check full message logging')
 25  	 INTO l_return
 26  	 FROM sperrorlog
 27  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Full error logging test'
 28  	  AND TO_CHAR(script)	 = 'otap_log.sql'
 29  	  AND TO_CHAR(statement) = 'My statement'
 30  	  AND identifier	 = otap_constants.OTAP_INTERNAL_ERROR
 31  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 32  	  AND timestamp 	>= l_stamp
 33  	  AND timestamp 	<= l_finish
 34    ;
 35    l_stamp	 := SYSTIMESTAMP;
 36    otap_log.log('OTAP_TEST: Full warning logging test', 'otap_log.sql', 'My statement', otap_constants.OTAP_INTERNAL_WARNING);
 37    l_finish  := SYSTIMESTAMP;
 38    SELECT otap_test.is_eq(COUNT(*), 1, 'Check full warning logging')
 39  	 INTO l_return
 40  	 FROM sperrorlog
 41  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Full warning logging test'
 42  	  AND TO_CHAR(script)	 = 'otap_log.sql'
 43  	  AND TO_CHAR(statement) = 'My statement'
 44  	  AND identifier	 = otap_constants.OTAP_INTERNAL_WARNING
 45  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 46  	  AND timestamp 	>= l_stamp
 47  	  AND timestamp 	<= l_finish
 48    ;
 49    l_return := otap_test.throws_ok('otap_log.log(RPAD(''X'', 38000, ''x''));', -6502, NULL, 'Check exception on message too long for VARCHAR2');
 50    -- check debug state and test if on or test positive debug mode disabled
 51    l_debug := otap_util.get_config_value(otap_constants.OTAP_CFG_DEBUG_MODE);
 52    IF l_debug = otap_constants.OTAP_NUM_FALSE
 53    THEN
 54  	 l_stamp := SYSTIMESTAMP;
 55  	 otap_log.log(p_log_message => 'OTAP_TEST: Should not log with identifier not OTAP_ERROR/OTAP_WARNING', p_identifier => 'MY DEBUG');
 56  	 l_finish  := SYSTIMESTAMP;
 57  	 SELECT otap_test.is_eq(COUNT(*), 0, 'Check only error logging if not debug mode')
 58  	   INTO l_return
 59  	   FROM sperrorlog
 60  	  WHERE TO_CHAR(message)   = 'OTAP_TEST: Should not log with identifier not OTAP_ERROR/OTAP_WARNING'
 61  	    AND TO_CHAR(script)    = otap_constants.OTAP_INTERNAL_NA
 62  	    AND TO_CHAR(statement) = otap_constants.OTAP_INTERNAL_NA
 63  	    AND identifier	   = 'MY DEBUG'
 64  	    AND username	   = otap_constants.OTAP_INTERNAL_SCHEMA
 65  	    AND timestamp	  >= l_stamp
 66  	    AND timestamp	  <= l_finish
 67  	 ;
 68    ELSE
 69  	 l_stamp := SYSTIMESTAMP;
 70  	 otap_log.log(p_log_message => 'OTAP_TEST: Should log with identifier not OTAP_ERROR/OTAP_WARNING', p_identifier => 'MY DEBUG');
 71  	 l_finish  := SYSTIMESTAMP;
 72  	 SELECT otap_test.is_eq(COUNT(*), 1, 'Check debug logging')
 73  	   INTO l_return
 74  	   FROM sperrorlog
 75  	  WHERE TO_CHAR(message)   = 'OTAP_TEST: Should log with identifier not OTAP_ERROR/OTAP_WARNING'
 76  	    AND TO_CHAR(script)    = otap_constants.OTAP_INTERNAL_NA
 77  	    AND TO_CHAR(statement) = otap_constants.OTAP_INTERNAL_NA
 78  	    AND identifier	   = 'MY DEBUG'
 79  	    AND username	   = otap_constants.OTAP_INTERNAL_SCHEMA
 80  	    AND timestamp	  >= l_stamp
 81  	    AND timestamp	  <= l_finish
 82  	 ;
 83    END IF;
 84  EXCEPTION
 85    WHEN OTHERS THEN
 86  	 otap_log.log('Test block OTAP_LOG failed', 'otap_log.sql', SQLERRM);
 87  	 l_return := otap_test.test_error('Complete test block OTAP_LOG failed', SQLERRM);
 88  END;
