100    l_strlen := GREATEST(150, (LENGTH(l_title) + (6 * l_border)));
101    l_xpad	:= l_strlen - (LENGTH(l_title) + l_border);
102    l_lpad	:= FLOOR((l_strlen - LENGTH(l_title)) / 2);
103    l_rpad	:= l_strlen - LENGTH(l_title) - l_lpad;
104    l_want	:= CASE
105  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
106  		     THEN LPAD(' ', l_xpad, l_deco) || l_title || RPAD(' ', l_border, l_deco)
107  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
108  		     THEN LPAD(' ', l_border, l_deco) || l_title || RPAD(' ', l_xpad, l_deco)
109  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
