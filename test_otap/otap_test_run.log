SQL> DECLARE
  2    l_return        VARCHAR2(4000 CHAR);
  3    l_decimal       CHAR(1 CHAR);
  4    l_stamp	       TIMESTAMP;
  5    l_finish        TIMESTAMP;
  6    l_translatable  NUMBER;
  7    l_label_style   VARCHAR2(1 CHAR);
  8    l_testing_id    NUMBER	     := -1;
  9    l_batch_size    NUMBER;
 10    l_batches       NUMBER;
 11    l_curr_date     DATE;
 12    l_setup_start   TIMESTAMP;
 13    l_setup_end     TIMESTAMP;
 14    l_runtime       NUMBER;
 15    l_exists        INTEGER;
 16    l_enabled       VARCHAR2(10);
 17  BEGIN
 18    -- ramp up result cleanup
 19    SELECT enabled
 20  	 INTO l_enabled
 21  	 FROM user_scheduler_jobs
 22  	WHERE job_name = 'OTAP_MAINTENANCE'
 23    ;
 24    l_setup_start := SYSTIMESTAMP;
 25    IF l_enabled = 'TRUE'
 26    THEN
 27  	 -- disable job, if active
 28  	 DBMS_SCHEDULER.DISABLE(name => 'OTAP_MAINTENANCE', force => TRUE);
 29    END IF;
 30    -- get current old records waiting over max delete delay to determine batch size to fake
 31  	 WITH base AS
 32  	      (SELECT otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE) AS batch_size
 33  		    , COUNT(*) AS to_delete_recs
 34  		 FROM otap_results
 35  		WHERE test_run_date < TRUNC(SYSDATE - 7)
 36  	      )
 37    SELECT CASE
 38  		WHEN to_delete_recs > batch_size
 39  		THEN 0
 40  		ELSE (batch_size - to_delete_recs) + 1
 41  	      END
 42  	 INTO l_batch_size
 43  	 FROM base
 44    ;
 45    -- create batch size +1 records with simulated testing session id
 46    FOR rec IN 1..l_batch_size
 47    LOOP
 48  	 otap_util.write_test_result(otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_TEST_PASSED, l_testing_id, NULL, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET, USER, USER, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP, SYSTIMESTAMP, SYSTIMESTAMP, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME, otap_constants.OTAP_INTERNAL_NA);
 49    END LOOP;
 50    -- turn off trigger to be able set an older date
 51    EXECUTE IMMEDIATE 'ALTER TRIGGER otap_results_upd_trg DISABLE';
 52    -- update to a date old enough to beat highest possible value
 53    UPDATE otap_results
 54  	  SET to_delete       = otap_constants.OTAP_NUM_TRUE
 55  	    , deleted_by      = USER
 56  	    , test_run_date   = TRUNC(SYSDATE - 9)
 57  	WHERE test_session_id = l_testing_id
 58    ;
 59    COMMIT;
 60    -- enable trigger again
 61    EXECUTE IMMEDIATE 'ALTER TRIGGER otap_results_upd_trg ENABLE';
 62    -- get amount of batches to execute, might be more than only the test records
 63    SELECT FLOOR(COUNT(*) / otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE))
 64  	 INTO l_batches
 65  	 FROM otap_results
 66  	WHERE to_delete      = otap_constants.OTAP_NUM_TRUE
 67  	  AND test_run_date <= TRUNC(SYSDATE - 7)
 68    ;
 69    -- set max preserve days
 70    otap_util.set_config_value(otap_util.CFG_PRESERVE_DAYS, '7');
 71    -- set debug to be able to control debug log messages
 72    otap_util.set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, TRIM(TO_CHAR(otap_constants.OTAP_NUM_TRUE)));
 73    l_stamp	:= SYSTIMESTAMP;
 74    -- run cleaunup, will delete all simulated session id records
 75    otap_util.result_cleanup;
 76    l_finish := SYSTIMESTAMP;
 77    -- disable debug mode again
 78    otap_util.set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, TRIM(TO_CHAR(otap_constants.OTAP_NUM_FALSE)));
 79    l_setup_end := SYSTIMESTAMP;
 80    -- now check otap_results
 81    SELECT otap_test.is_eq(COUNT(*), 0, 'otap_util.result_cleanup verify delete')
 82  	 INTO l_return
 83  	 FROM otap_results
 84  	WHERE test_session_id = l_testing_id
 85    ;
 86    -- verify debug messages
 87    SELECT otap_test.is_eq(COUNT(*), 1, 'otap_util.result_cleanup verify debug start log message')
 88  	 INTO l_return
 89  	 FROM sperrorlog
 90  	WHERE identifier   = 'OTAP_DEBUG'
 91  	  AND script	LIKE 'otap_util.result_cleanup'
 92  	  AND statement LIKE 'Procedure start'
 93  	  AND message	LIKE 'Start delete with batch size%'
 94  	  AND timestamp   >= l_stamp
 95  	  AND timestamp   <= l_finish
 96    ;
 97    SELECT otap_test.is_eq(COUNT(*), l_batches, 'otap_util.result_cleanup verify debug batch messages')
 98  	 INTO l_return
 99  	 FROM sperrorlog
100  	WHERE identifier   = 'OTAP_DEBUG'
101  	  AND script	LIKE 'otap_util.result_cleanup'
102  	  AND statement LIKE 'Batch size reached and wait'
103  	  AND message	LIKE 'Batch size reached, commit and wait. Processed records%'
104  	  AND timestamp   >= l_stamp
105  	  AND timestamp   <= l_finish
106    ;
107    SELECT otap_test.is_eq(COUNT(*), 1, 'otap_util.result_cleanup verify debug end log message')
108  	 INTO l_return
109  	 FROM sperrorlog
110  	WHERE identifier   = 'OTAP_DEBUG'
111  	  AND script	LIKE 'otap_util.result_cleanup'
112  	  AND statement LIKE 'Procedure end'
113  	  AND message	LIKE 'Processed%records for delete%'
114  	  AND timestamp   >= l_stamp
115  	  AND timestamp   <= l_finish
116    ;
117    -- time preparation diff seconds
118    l_curr_date := SYSDATE;
119    l_runtime   := l_curr_date + ((l_setup_end - l_setup_start) * 86400) - l_curr_date;
120    l_return    := otap_test.ok(l_runtime < 60, 'otap_util.result_cleanup preparation performance seconds: ' || TO_CHAR(l_runtime, '90.09') || ' < 60');
121    IF l_enabled = 'TRUE'
122    THEN
123  	 -- enable job again
124  	 DBMS_SCHEDULER.ENABLE(name => 'OTAP_MAINTENANCE');
125    END IF;
126  EXCEPTION
127    WHEN OTHERS THEN
128  	 otap_log.log('Test block OTAP_UTIL maintenance intrusive failed', 'otap_intrusive.sql', SQLERRM);
129  	 l_return := otap_test.test_error('Complete test block OTAP_UTIL maintenance intrusive failed', SQLERRM);
130  END;
131  /
