SQL> -- restore from backup
SQL> @@otap_config_restore.sql
SQL> -- (C) 2024 Michael Lindenau licensed via https://www.gnu.org/licenses/agpl-3.0.txt
SQL> -- and https://toent.ch/licenses/AI_DISCLOSURE_LICENSE_V1
SQL> -- Not allowed to be used as AI training material without explicite permission.
SQL> -- restores from a temporary backup of the otap_config table
SQL> -- deletes the temporary backup after restore
SQL> 
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> DECLARE
  2    l_has_backup INTEGER;
  3    l_statement  VARCHAR2(32767);
  4  BEGIN
  5    SELECT COUNT(*)
  6  	 INTO l_has_backup
  7  	 FROM user_tables
  8  	WHERE table_name = 'OTAP_CONFIG_BACKUP'
  9    ;
 10    IF l_has_backup = 1
 11    THEN
 12  	 DBMS_OUTPUT.PUT_LINE('Temporary backup detected');
 13  	 -- create statement for execute immediate to not fail, if table does not exist
 14  	 l_statement := q'[MERGE INTO otap_config tgt
 15  USING (SELECT config_name
 16  		 , config_value
 17  		 , config_max_length
 18  		 , config_type
 19  		 , translatable
 20  		 , config_description
 21  	      FROM otap_config_backup
 22  	   ) src
 23  	ON (tgt.config_name = src.config_name)
 24   WHEN MATCHED THEN
 25  	UPDATE SET tgt.config_value = src.config_value WHERE tgt.config_value != src.config_value]';
 26  	 EXECUTE IMMEDIATE l_statement;
 27  	 COMMIT;
 28  	 DBMS_OUTPUT.PUT_LINE('Temporary backup restored');
 29  	 -- if we reach this point, it is safe to drop the backup
 30  	 EXECUTE IMMEDIATE 'DROP TABLE otap_config_backup';
 31  	 DBMS_OUTPUT.PUT_LINE('Temporary backup dropped');
 32    ELSE
 33  	 DBMS_OUTPUT.PUT_LINE('No temporary backup found, nothing to do');
 34    END IF;
 35  END;
 36  /
