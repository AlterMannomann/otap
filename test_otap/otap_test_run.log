SQL> -- creates a temporary backup of the otap_config table
SQL> 
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> DECLARE
  2    l_has_backup INTEGER;
  3  BEGIN
  4    SELECT COUNT(*)
  5  	 INTO l_has_backup
  6  	 FROM user_tables
  7  	WHERE table_name = 'OTAP_CONFIG_BACKUP'
  8    ;
  9    IF l_has_backup = 1
 10    THEN
 11  	 DBMS_OUTPUT.PUT_LINE('Old temporary backup detected and dropped');
 12  	 EXECUTE IMMEDIATE 'DROP TABLE otap_config_backup';
 13    END IF;
 14    EXECUTE IMMEDIATE 'CREATE TABLE otap_config_backup AS SELECT * FROM otap_config';
 15    DBMS_OUTPUT.PUT_LINE('Temporary backup created');
 16  END;
