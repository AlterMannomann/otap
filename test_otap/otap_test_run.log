SQL> -- to verify package constants we use a anonymous PLSQL block
SQL> -- to not overload DBMS_OUTPUT only minimal summary output
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> DECLARE
  2    l_return      VARCHAR2(4000 CHAR);
  3    l_stamp	     TIMESTAMP;
  4    l_finish      TIMESTAMP;
  5    l_layout      VARCHAR2(4000 CHAR);
  6    l_border      INTEGER;
  7    l_want	     VARCHAR2(4000 CHAR);
  8    l_have	     VARCHAR2(4000 CHAR);
  9    l_strlen      INTEGER;
 10    l_xpad	     INTEGER;
 11    l_lpad	     INTEGER;
 12    l_rpad	     INTEGER;
 13    l_fmt_len     INTEGER;
 14    l_iv_len      INTEGER;
 15    l_deco	     VARCHAR2(1 CHAR);
 16    l_title	     VARCHAR2(4000 CHAR);
 17    l_template    VARCHAR2(256 CHAR);
 18    l_par1	     VARCHAR2(4000 CHAR);
 19    l_time1	     VARCHAR2(128 CHAR);
 20    l_time2	     VARCHAR2(128 CHAR);
 21    l_ext	     VARCHAR2(128 CHAR);
 22  BEGIN
 23    -- otap_report uses configured values, get current values and build non intrusive tests on the current values
 24    l_layout := otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT, otap_constants.OTAP_INTERNAL_NA);
 25    l_border := otap_util.get_config_number(otap_util.CFG_DEFAULT_BORDER);
 26    l_iv_len := otap_util.interval_size;
 27    l_ext	:= ' layout/border(' || l_layout || '/' || TRIM(TO_CHAR(l_border)) || ')';
 28    l_return := otap_test.ok((l_layout IN (otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)), 'otap_report loaded layout check' || l_ext);
 29    l_return := otap_test.ok((l_border BETWEEN 1 AND 10), 'otap_report loaded border check' || l_ext);
 30    l_deco	:= otap_util.get_config_value(otap_util.CFG_FORMAT_NAME_CHAR, otap_constants.OTAP_INTERNAL_NA);
 31    -- should be independent from layout
 32    l_return := otap_test.is_eq(otap_report.decorate(NULL, NULL, l_deco, otap_constants.OTAP_INTERNAL_NA), RPAD(l_deco, otap_constants.OTAP_NUM_MIN_FILL_LENGTH, l_deco), 'otap_report.decorate NULL parameter' || l_ext);
 33    l_return := otap_test.is_eq(otap_report.decorate(NULL, NULL, NULL, NULL), RPAD(l_deco, otap_constants.OTAP_NUM_MIN_FILL_LENGTH, l_deco), 'otap_report.decorate full NULL check' || l_ext);
 34    l_return := otap_test.is_eq(otap_report.decorate(NULL, 120, '-', otap_constants.OTAP_INTERNAL_NA), RPAD('-', 120, '-'), 'otap_report.decorate NULL parameter respect min length' || l_ext);
 35    l_return := otap_test.is_eq(otap_report.decorate(NULL, 150, '*', otap_constants.OTAP_INTERNAL_NA), RPAD('*', 150, '*'), 'otap_report.decorate NULL parameter respect min length and decoration' || l_ext);
 36    l_return := otap_test.is_eq(otap_report.decorate(NULL, 60, '-', otap_constants.OTAP_INTERNAL_NA), RPAD('-', otap_constants.OTAP_NUM_MIN_FILL_LENGTH, '-'), 'otap_report.decorate NULL parameter guarantee otap min length' || l_ext);
 37    -- get decorate string for later checks
 38    l_strlen := otap_constants.OTAP_NUM_MIN_FILL_LENGTH - (2 * l_border);
 39    l_have	:= otap_report.decorate(RPAD('a', l_strlen, 'a'), 80, '-', otap_constants.OTAP_INTERNAL_NA);
 40    l_return := otap_test.is_eq(LENGTH(l_have), otap_constants.OTAP_NUM_MIN_FILL_LENGTH, 'otap_report.decorate length full min size min border' || l_ext);
 41    l_want	:= LPAD(' ', l_border, '-') || RPAD('a', l_strlen, 'a') || RPAD(' ', l_border, '-');
 42    l_return := otap_test.is_eq(l_have, l_want, 'otap_report.decorate string full min size min border' || l_ext);
 43  -- depends on layout
 44    l_have	:= otap_report.decorate(RPAD('a', 60, 'a'), 80, '-', otap_constants.OTAP_INTERNAL_NA);
 45    l_want	:= CASE
 46  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
 47  		     THEN LPAD(' ', (20 - l_border), '-') || RPAD('a', 60, 'a') || RPAD(' ', l_border, '-')
 48  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
 49  		     THEN LPAD(' ', l_border, '-') || RPAD('a', 60, 'a') || RPAD(' ', (20 - l_border), '-')
 50  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
 51  		     THEN LPAD(' ', 10, '-') || RPAD('a', 60, 'a') || RPAD(' ', 10, '-')
 52  		     ELSE 'INVALID LAYOUT'
 53  		   END
 54    ;
 55    l_return := otap_test.is_eq(l_have, l_want, 'otap_report.decorate title length 60' || l_ext);
 56    l_return := otap_test.is_eq(otap_report.decorate(RPAD('a', 60, 'a')), l_want, 'otap_report.decorate title length default parameter check' || l_ext);
 57    l_strlen := otap_constants.OTAP_NUM_MIN_FILL_LENGTH - LENGTH(otap_constants.OTAP_INTERNAL_NA);
 58    l_have	:= otap_report.borderless(NULL, NULL, NULL);
 59    l_want	:= CASE
 60  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
 61  		     THEN LPAD(' ', l_strlen, ' ') || otap_constants.OTAP_INTERNAL_NA
 62  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
 63  		     THEN otap_constants.OTAP_INTERNAL_NA || RPAD(' ', l_strlen, ' ')
 64  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
 65  		     THEN otap_constants.OTAP_INTERNAL_NA || RPAD(' ', l_strlen, ' ')
 66  		     ELSE 'INVALID LAYOUT'
 67  		   END
 68    ;
 69    l_return := otap_test.is_eq(l_have, l_want, 'otap_report.borderless full NULL check' || l_ext);
 70    l_have	:= otap_report.borderless(RPAD('a', 10, 'a'), 80, otap_constants.OTAP_INTERNAL_NA);
 71    l_want	:= CASE
 72  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
 73  		     THEN LPAD(' ', 70, ' ') || RPAD('a', 10, 'a')
 74  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
 75  		     THEN RPAD('a', 10, 'a') || RPAD(' ', 70, ' ')
 76  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
 77  		     THEN RPAD('a', 10, 'a') || RPAD(' ', 70, ' ')
 78  		     ELSE 'INVALID LAYOUT'
 79  		   END
 80    ;
 81    l_return := otap_test.is_eq(l_have, l_want, 'otap_report.borderless title length 10' || l_ext);
 82    l_return := otap_test.is_eq(otap_report.borderless(RPAD('a', 10, 'a')), l_want, 'otap_report.borderless title length 10 default parameter check' || l_ext);
 83    l_return := otap_test.is_eq(LENGTH(l_have), otap_constants.OTAP_NUM_MIN_FILL_LENGTH, 'otap_report.borderless string length for title length 10' || l_ext);
 84    l_return := otap_test.is_eq(otap_report.borderless(RPAD('a', 100, 'a')), RPAD('a', 100, 'a'), 'otap_report.borderless title length 100' || l_ext);
 85    l_return := otap_test.is_eq(LENGTH(otap_report.borderless(RPAD('a', 100, 'a'))), 100, 'otap_report.borderless string length title length 100' || l_ext);
 86    l_deco	:= otap_util.get_config_value(otap_util.CFG_FORMAT_HEADER_CHAR, otap_constants.OTAP_INTERNAL_NA);
 87    l_title	:= otap_util.get_config_value(otap_util.CFG_TEXT_REPORT_START, otap_constants.OTAP_INTERNAL_NA);
 88    l_strlen := GREATEST(otap_constants.OTAP_NUM_MIN_FILL_LENGTH, (LENGTH(l_title) + (2 * l_border)));
 89    l_xpad	:= l_strlen - (LENGTH(l_title) + l_border);
 90    l_lpad	:= FLOOR((l_strlen - LENGTH(l_title)) / 2);
 91    l_rpad	:= l_strlen - LENGTH(l_title) - l_lpad;
 92    l_want	:= CASE
 93  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
 94  		     THEN LPAD(' ', l_xpad, l_deco) || l_title || RPAD(' ', l_border, l_deco)
 95  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
 96  		     THEN LPAD(' ', l_border, l_deco) || l_title || RPAD(' ', l_xpad, l_deco)
 97  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
 98  		     THEN LPAD(' ', l_lpad, l_deco) || l_title || RPAD(' ', l_rpad, l_deco)
 99  		     ELSE 'INVALID LAYOUT'
100  		   END
101    ;
102    l_return := otap_test.is_eq(otap_report.get_report_header, l_want, 'otap_report.get_report_header check' || l_ext);
103    l_return := otap_test.is_eq(otap_report.get_report_header(NULL, NULL), l_want, 'otap_report.get_report_header full NULL check' || l_ext);
104    l_strlen := GREATEST(150, (LENGTH(l_title) + (6 * l_border)));
105    l_xpad	:= l_strlen - (LENGTH(l_title) + l_border);
106    l_lpad	:= FLOOR((l_strlen - LENGTH(l_title)) / 2);
107    l_rpad	:= l_strlen - LENGTH(l_title) - l_lpad;
108    l_want	:= CASE
109  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_RIGHT
110  		     THEN LPAD(' ', l_xpad, l_deco) || l_title || RPAD(' ', l_border, l_deco)
111  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_LEFT
112  		     THEN LPAD(' ', l_border, l_deco) || l_title || RPAD(' ', l_xpad, l_deco)
113  		     WHEN l_layout = otap_constants.OTAP_LAYOUT_MIDDLE
114  		     THEN LPAD(' ', l_lpad, l_deco) || l_title || RPAD(' ', l_rpad, l_deco)
115  		     ELSE 'INVALID LAYOUT'
116  		   END
117    ;
118    l_return := otap_test.is_eq(otap_report.get_report_header(l_strlen), l_want, 'otap_report.get_report_header with min fill ' || l_strlen || l_ext);
119    l_title	:= otap_util.get_config_value(otap_util.CFG_TEXT_REPORT_TOTAL, otap_constants.OTAP_INTERNAL_NA);
120    l_strlen := GREATEST(otap_constants.OTAP_NUM_MIN_FILL_LENGTH, (LENGTH(l_title) + (2 * l_border)));
