141    -- check functionality is_number
142    l_return := otap_test.ok(otap_util.is_number('1'), 'otap_util.is_number simple number' || l_ext);
143    l_return := otap_test.ok((NOT otap_util.is_number('A')), 'otap_util.is_number simple char fails' || l_ext);
144    l_return := otap_test.ok(p_boolean => otap_util.is_number('A'), p_description => 'otap_util.is_number simple char and expected result failed' || l_ext, p_expected_result => otap_constants.OTAP_NUM_TEST_FAILED);
145    l_return := otap_test.ok((NOT otap_util.is_number('-1-')), 'otap_util.is_number strange number -1- fails' || l_ext);
146    l_return := otap_test.ok((NOT otap_util.is_number('-1*2+')), 'otap_util.is_number strange number -1*2+ fails' || l_ext);
147    l_return := otap_test.ok((NOT otap_util.is_number('99999999999999999999999999999999999999999999999999')), 'otap_util.is_number too big number 99999999999999999999999999999999999999999999999999 fails' || l_ext);
148    -- get correct current decimal points, thousands divider does not work with TO_NUMBER, without given format
149    SELECT SUBSTR(value, 1, 1)
150  	 INTO l_decimal
151  	 FROM nls_session_parameters
152  	WHERE parameter = 'NLS_NUMERIC_CHARACTERS'
153    ;
154    l_return := otap_test.ok(otap_util.is_number('1' || l_decimal || '234'), 'otap_util.is_number using current decimal point defined 1.234' || l_ext);
155    l_return := otap_test.ok(otap_util.is_number(l_decimal || '234'), 'otap_util.is_number using leading current decimal point defined .234' || l_ext);
156    -- this is something allowed in SQL with wrong results (decimals cut and zeroed) but not with PLSQL
157    l_return := otap_test.ok((NOT otap_util.is_number('1e10')), 'otap_util.is_number scientific notation 1e10 fails' || l_ext);
158    -- check functionality is_integer
159    l_return := otap_test.ok(otap_util.is_integer('1'), 'otap_util.is_integer simple integer' || l_ext);
160    l_return := otap_test.ok((NOT otap_util.is_integer('A')), 'otap_util.is_integer simple char fails' || l_ext);
161    l_return := otap_test.ok((NOT otap_util.is_integer('1.0')), 'otap_util.is_integer decimal 1.0 fails' || l_ext);
162    l_return := otap_test.ok((NOT otap_util.is_integer('.045')), 'otap_util.is_integer decimal .045 fails' || l_ext);
163    l_return := otap_test.ok(otap_util.is_integer('-1'), 'otap_util.is_integer simple negative integer' || l_ext);
164    l_return := otap_test.ok((NOT otap_util.is_integer('-1-')), 'otap_util.is_integer strange number -1- fails' || l_ext);
165    l_return := otap_test.ok((NOT otap_util.is_integer('-1*2+')), 'otap_util.is_integer strange number -1*2+ fails' || l_ext);
166    l_return := otap_test.ok((NOT otap_util.is_integer('99999999999999999999999999999999999999999999999999')), 'otap_util.is_integer too big number 99999999999999999999999999999999999999999999999999 fails' || l_ext);
167    -- check functionality validate_config_name
