SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> DECLARE
  2    l_return VARCHAR2(4000);
  3    l_stamp	TIMESTAMP;
  4  BEGIN
  5    l_stamp := SYSTIMESTAMP;
  6    otap_log.log('OTAP_TEST: Basic error logging test');
  7    SELECT otap_test.is_eq(COUNT(*), 1, 'Check basic message logging')
  8  	 INTO l_return
  9  	 FROM sperrorlog
 10  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Basic error logging test'
 11  	  AND TO_CHAR(script)	 = otap_constants.OTAP_INTERNAL_NA
 12  	  AND TO_CHAR(statement) = otap_constants.OTAP_INTERNAL_NA
 13  	  AND identifier	 = otap_constants.OTAP_INTERNAL_ERROR
 14  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 15  	  AND timestamp 	>= l_stamp
 16    ;
 17    otap_log.log('OTAP_TEST: Full error logging test', 'otap_log.sql', 'My statement');
 18    SELECT otap_test.is_eq(COUNT(*), 1, 'Check full message logging')
 19  	 INTO l_return
 20  	 FROM sperrorlog
 21  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Full error logging test'
 22  	  AND TO_CHAR(script)	 = 'otap_log.sql'
 23  	  AND TO_CHAR(statement) = 'My statement'
 24  	  AND identifier	 = otap_constants.OTAP_INTERNAL_ERROR
 25  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 26  	  AND timestamp 	>= l_stamp
 27    ;
 28    l_return := otap_test.throws_ok('otap_log.log(RPAD(''X'', 38000, ''x''));', -6502, NULL, 'Check exception on message too long for VARCHAR2');
 29    l_stamp := SYSTIMESTAMP;
 30    otap_log.log(p_log_message => 'OTAP_TEST: Should not log with identifier not OTAP_ERROR', p_identifier => 'MY DEBUG');
 31    SELECT otap_test.is_eq(COUNT(*), 0, 'Check only error logging if not debug mode')
 32  	 INTO l_return
 33  	 FROM sperrorlog
 34  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Should not log with identifier not OTAP_ERROR'
 35  	  AND TO_CHAR(script)	 = otap_constants.OTAP_INTERNAL_NA
 36  	  AND TO_CHAR(statement) = otap_constants.OTAP_INTERNAL_NA
 37  	  AND identifier	 = 'MY DEBUG'
 38  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 39  	  AND timestamp 	>= l_stamp
 40    ;
 41    UPDATE otap_config SET config_value = otap_constants.OTAP_NUM_TRUE WHERE config_name = otap_constants.OTAP_CFG_DEBUG_MODE;
 42    -- commit needed due to independent transaction
 43    COMMIT;
 44    otap_log.log(p_log_message => 'OTAP_TEST: Should log with identifier not OTAP_ERROR', p_identifier => 'MY DEBUG');
 45    SELECT otap_test.is_eq(COUNT(*), 1, 'Check debug logging')
 46  	 INTO l_return
 47  	 FROM sperrorlog
 48  	WHERE TO_CHAR(message)	 = 'OTAP_TEST: Should log with identifier not OTAP_ERROR'
 49  	  AND TO_CHAR(script)	 = otap_constants.OTAP_INTERNAL_NA
 50  	  AND TO_CHAR(statement) = otap_constants.OTAP_INTERNAL_NA
 51  	  AND identifier	 = 'MY DEBUG'
 52  	  AND username		 = otap_constants.OTAP_INTERNAL_SCHEMA
 53  	  AND timestamp 	>= l_stamp
 54    ;
