1324  	  INTO l_return
1325  	  FROM sperrorlog
1326  	 WHERE identifier   = 'OTAP_DEBUG'
1327  	   AND script	 LIKE 'otap_util.result_cleanup'
1328  	   AND statement LIKE 'Procedure start'
1329  	   AND message	 LIKE 'Start delete with batch size%'
1330  	   AND timestamp   >= l_stamp
1331  	   AND timestamp   <= l_finish
1332  	;
1333  	SELECT otap_test.is_eq(COUNT(*), l_batches, 'otap_util.result_cleanup verify debug batch messages')
1334  	  INTO l_return
1335  	  FROM sperrorlog
1336  	 WHERE identifier   = 'OTAP_DEBUG'
1337  	   AND script	 LIKE 'otap_util.result_cleanup'
1338  	   AND statement LIKE 'Batch size reached and wait'
1339  	   AND message	 LIKE 'Batch size reached, commit and wait. Processed records%'
1340  	   AND timestamp   >= l_stamp
1341  	   AND timestamp   <= l_finish
1342  	;
1343  	SELECT otap_test.is_eq(COUNT(*), 1, 'otap_util.result_cleanup verify debug end log message')
1344  	  INTO l_return
1345  	  FROM sperrorlog
1346  	 WHERE identifier   = 'OTAP_DEBUG'
1347  	   AND script	 LIKE 'otap_util.result_cleanup'
1348  	   AND statement LIKE 'Procedure end'
1349  	   AND message	 LIKE 'Processed%records for delete%'
1350  	   AND timestamp   >= l_stamp
1351  	   AND timestamp   <= l_finish
1352  	;
1353  	-- enable job again
1354  	DBMS_SCHEDULER.ENABLE(name => 'OTAP_MAINTENANCE');
1355  	-- time preparation diff seconds
1356  	l_curr_date := SYSDATE;
1357  	l_runtime   := l_curr_date + ((l_setup_end - l_setup_start) * 86400) - l_curr_date;
1358  	l_return    := otap_test.ok(l_runtime < 20, 'otap_util.result_cleanup preparation performance seconds: ' || TO_CHAR(l_runtime, '90.09') || ' < 20');
1359  END;
1360  /
