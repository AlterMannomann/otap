SQL> DECLARE
  2    l_has_backup INTEGER;
  3  BEGIN
  4    SELECT COUNT(*)
  5  	 INTO l_has_backup
  6  	 FROM user_tables
  7  	WHERE table_name = 'OTAP_CONFIG_BACKUP'
  8    ;
  9    IF l_has_backup = 1
