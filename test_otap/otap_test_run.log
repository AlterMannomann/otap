SQL> -- independent code block, able to deal with different setup settings
SQL> 
SQL> -- to verify package constants we use a anonymous PLSQL block
SQL> -- to not overload DBMS_OUTPUT only minimal summary output
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> DECLARE
  2    l_return      VARCHAR2(4000 CHAR);
  3    l_stamp	     TIMESTAMP;
  4    l_finish      TIMESTAMP;
  5    l_layout      VARCHAR2(4000 CHAR);
  6    l_border      INTEGER;
  7    l_want	     VARCHAR2(4000 CHAR);
  8    l_have	     VARCHAR2(4000 CHAR);
  9    l_strlen      INTEGER;
 10    l_xpad	     INTEGER;
 11    l_lpad	     INTEGER;
 12    l_rpad	     INTEGER;
 13    l_fmt_len     INTEGER;
 14    l_iv_len      INTEGER;
 15    l_deco	     VARCHAR2(1 CHAR);
 16    l_title	     VARCHAR2(4000 CHAR);
 17    l_template    VARCHAR2(256 CHAR);
 18    l_par1	     VARCHAR2(4000 CHAR);
 19    l_time1	     VARCHAR2(128 CHAR);
 20    l_time2	     VARCHAR2(128 CHAR);
 21    l_ext	     VARCHAR2(128 CHAR);
 22  BEGIN
 23    -- otap_report uses configured values, get current values and build non intrusive tests on the current values
 24    l_layout := otap_util.get_config_value(otap_util.CFG_DEFAULT_LAYOUT, otap_constants.OTAP_INTERNAL_NA);
 25    l_border := otap_util.get_config_number(otap_util.CFG_DEFAULT_BORDER);
 26    l_iv_len := otap_util.interval_size;
 27    l_ext	:= ' layout/border(' || l_layout || '/' || TRIM(TO_CHAR(l_border)) || ')';
 28    l_return := otap_test.ok((l_layout IN (otap_constants.OTAP_LAYOUT_MIDDLE, otap_constants.OTAP_LAYOUT_LEFT, otap_constants.OTAP_LAYOUT_RIGHT)), 'otap_report loaded layout check' || l_ext);
 29    l_return := otap_test.ok((l_border BETWEEN 1 AND 10), 'otap_report loaded border check' || l_ext);
 30    l_deco	:= otap_util.get_config_value(otap_util.CFG_FORMAT_NAME_CHAR, otap_constants.OTAP_INTERNAL_NA);
 31    -- should be independent from layout
 32    l_return := otap_test.is_eq(otap_report.decorate(NULL, NULL, l_deco, otap_constants.OTAP_INTERNAL_NA), RPAD(l_deco, otap_constants.OTAP_NUM_MIN_FILL_LENGTH, l_deco), 'otap_report.decorate NULL parameter' || l_ext);
 33    l_return := otap_test.is_eq(otap_report.decorate(NULL, NULL, NULL, NULL), RPAD(l_deco, otap_constants.OTAP_NUM_MIN_FILL_LENGTH, l_deco), 'otap_report.decorate full NULL check' || l_ext);
 34    l_return := otap_test.is_eq(otap_report.decorate(NULL, 120, '-', otap_constants.OTAP_INTERNAL_NA), RPAD('-', 120, '-'), 'otap_report.decorate NULL parameter respect min length' || l_ext);
 35    l_return := otap_test.is_eq(otap_report.decorate(NULL, 150, '*', otap_constants.OTAP_INTERNAL_NA), RPAD('*', 150, '*'), 'otap_report.decorate NULL parameter respect min length and decoration' || l_ext);
 36    l_return := otap_test.is_eq(otap_report.decorate(NULL, 60, '-', otap_constants.OTAP_INTERNAL_NA), RPAD('-', otap_constants.OTAP_NUM_MIN_FILL_LENGTH, '-'), 'otap_report.decorate NULL parameter guarantee otap min length' || l_ext);
 37    -- get decorate string for later checks
 38    l_strlen := otap_constants.OTAP_NUM_MIN_FILL_LENGTH - (2 * l_border);
 39    l_have	:= otap_report.decorate(RPAD('a', l_strlen, 'a'), 80, '-', otap_constants.OTAP_INTERNAL_NA);
