  5    l_finish        TIMESTAMP;
  6    l_translatable  NUMBER;
  7    l_label_style   VARCHAR2(1);
  8    l_testing_id    NUMBER	     := -1;
  9    l_batch_size    NUMBER;
 10    l_batches       NUMBER;
 11    l_curr_date     DATE;
 12    l_setup_start   TIMESTAMP;
 13    l_setup_end     TIMESTAMP;
 14    l_runtime       NUMBER;
 15    l_exists        INTEGER;
 16  BEGIN
 17    -- disable debug mode
 18    otap_util.set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, TRIM(TO_CHAR(otap_constants.OTAP_NUM_FALSE)));
 19    -- set default prefix
 20    otap_util.set_config_value(otap_util.CFG_DEFAULT_PREFIX, 'TEST');
 21    -- now test it
 22    l_return := otap_test.is_eq(otap_util.get_config_value(otap_util.CFG_DEFAULT_PREFIX), 'TEST', 'otap_util.get_config_value get config value prefix as text');
 23    l_return := otap_test.is_eq(otap_util.get_config_number(otap_constants.OTAP_CFG_DEBUG_MODE), 0, 'otap_util.get_config_number get config value debug mode as number');
 24    -- reset default prefix, leave debug mode off for now
 25    otap_util.set_config_value(otap_util.CFG_DEFAULT_PREFIX, '&ORG_DEFAULT_PREFIX');
 26    -- set the lower layout configuration temporarily and test this configuration
 27    otap_util.set_config_value(otap_util.CFG_DEFAULT_LABEL_COLUMN, otap_constants.OTAP_LABEL_LOWER);
 28    l_return := otap_test.is_eq(otap_util.get_config_value(otap_util.CFG_LABEL_BOOLEAN), 'boolean', 'otap_util.get_config_value label as text format lower');
 29    -- set the upper layout configuration temporarily and test this configuration
 30    otap_util.set_config_value(otap_util.CFG_DEFAULT_LABEL_COLUMN, otap_constants.OTAP_LABEL_UPPER);
 31    l_return := otap_test.is_eq(otap_util.get_config_value(otap_util.CFG_LABEL_BOOLEAN), 'BOOLEAN', 'otap_util.get_config_value label as text format upper');
 32    -- set the initial capitals layout configuration temporarily and test this configuration
 33    otap_util.set_config_value(otap_util.CFG_DEFAULT_LABEL_COLUMN, otap_constants.OTAP_LABEL_INIT_CAP);
 34    l_return := otap_test.is_eq(otap_util.get_config_value(otap_util.CFG_LABEL_BOOLEAN), 'Boolean', 'otap_util.get_config_value label as text format initial capitals');
 35    -- restore the original value
 36    otap_util.set_config_value(otap_util.CFG_DEFAULT_LABEL_COLUMN, '&ORG_DEFAULT_LABEL_COLUMN');
 37  
 38    -- ramp up result cleanup
 39    l_setup_start := SYSTIMESTAMP;
 40    IF '&ORG_MAINTENANCE_JOB' = 'TRUE'
 41    THEN
 42  	 -- disable job, if active
 43  	 DBMS_SCHEDULER.DISABLE(name => 'OTAP_MAINTENANCE', force => TRUE);
 44    END IF;
 45    -- get current old records waiting over max delete delay to determine batch size to fake
 46  	 WITH base AS
 47  	      (SELECT otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE) AS batch_size
 48  		    , COUNT(*) AS to_delete_recs
 49  		 FROM otap_results
 50  		WHERE test_run_date < TRUNC(SYSDATE - 7)
 51  	      )
 52    SELECT CASE
 53  		WHEN to_delete_recs > batch_size
 54  		THEN 0
 55  		ELSE (batch_size - to_delete_recs) + 1
 56  	      END
 57  	 INTO l_batch_size
 58  	 FROM base
 59    ;
 60    -- create batch size +1 records with simulated testing session id
 61    FOR rec IN 1..l_batch_size
 62    LOOP
 63  	 otap_util.write_test_result(otap_constants.OTAP_NUM_TRUE, otap_constants.OTAP_NUM_TEST_PASSED, l_testing_id, NULL, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_SET, USER, USER, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_GROUP, SYSTIMESTAMP, SYSTIMESTAMP, otap_constants.OTAP_FALLBACK_DEFAULT_TEST_NAME, otap_constants.OTAP_INTERNAL_NA);
 64    END LOOP;
 65    -- turn off trigger to be able set an older date
 66    EXECUTE IMMEDIATE 'ALTER TRIGGER otap_results_upd_trg DISABLE';
 67    -- update to a date old enough to beat highest possible value
 68    UPDATE otap_results
 69  	  SET to_delete       = otap_constants.OTAP_NUM_TRUE
 70  	    , deleted_by      = USER
 71  	    , test_run_date   = TRUNC(SYSDATE - 9)
 72  	WHERE test_session_id = l_testing_id
 73    ;
 74    COMMIT;
 75    -- enable trigger again
 76    EXECUTE IMMEDIATE 'ALTER TRIGGER otap_results_upd_trg ENABLE';
 77    -- get amount of batches to execute, might be more than only the test records
 78    SELECT FLOOR(COUNT(*) / otap_util.get_config_number(otap_util.CFG_DELETE_BATCH_SIZE))
 79  	 INTO l_batches
 80  	 FROM otap_results
 81  	WHERE to_delete      = otap_constants.OTAP_NUM_TRUE
 82  	  AND test_run_date <= TRUNC(SYSDATE - 7)
 83    ;
 84    -- set max preserve days
 85    otap_util.set_config_value(otap_util.CFG_PRESERVE_DAYS, '7');
 86    -- set debug to be able to control debug log messages
 87    otap_util.set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, TRIM(TO_CHAR(otap_constants.OTAP_NUM_TRUE)));
 88    l_stamp	:= SYSTIMESTAMP;
 89    -- run cleaunup, will delete all simulated session id records
 90    otap_util.result_cleanup;
 91    l_finish := SYSTIMESTAMP;
 92    -- reset preserve days
 93    otap_util.set_config_value(otap_util.CFG_PRESERVE_DAYS, '&ORG_PRESERVE_DAYS');
 94    -- disable debug mode again
 95    otap_util.set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, TRIM(TO_CHAR(otap_constants.OTAP_NUM_FALSE)));
 96    l_setup_end := SYSTIMESTAMP;
 97    -- now check otap_results
 98    SELECT otap_test.is_eq(COUNT(*), 0, 'otap_util.result_cleanup verify delete')
 99  	 INTO l_return
100  	 FROM otap_results
101  	WHERE test_session_id = l_testing_id
102    ;
103    -- verify debug messages
104    SELECT otap_test.is_eq(COUNT(*), 1, 'otap_util.result_cleanup verify debug start log message')
105  	 INTO l_return
106  	 FROM sperrorlog
107  	WHERE identifier   = 'OTAP_DEBUG'
108  	  AND script	LIKE 'otap_util.result_cleanup'
109  	  AND statement LIKE 'Procedure start'
110  	  AND message	LIKE 'Start delete with batch size%'
111  	  AND timestamp   >= l_stamp
112  	  AND timestamp   <= l_finish
113    ;
114    SELECT otap_test.is_eq(COUNT(*), l_batches, 'otap_util.result_cleanup verify debug batch messages')
115  	 INTO l_return
116  	 FROM sperrorlog
117  	WHERE identifier   = 'OTAP_DEBUG'
118  	  AND script	LIKE 'otap_util.result_cleanup'
119  	  AND statement LIKE 'Batch size reached and wait'
120  	  AND message	LIKE 'Batch size reached, commit and wait. Processed records%'
121  	  AND timestamp   >= l_stamp
122  	  AND timestamp   <= l_finish
123    ;
124    SELECT otap_test.is_eq(COUNT(*), 1, 'otap_util.result_cleanup verify debug end log message')
125  	 INTO l_return
126  	 FROM sperrorlog
127  	WHERE identifier   = 'OTAP_DEBUG'
128  	  AND script	LIKE 'otap_util.result_cleanup'
129  	  AND statement LIKE 'Procedure end'
130  	  AND message	LIKE 'Processed%records for delete%'
131  	  AND timestamp   >= l_stamp
132  	  AND timestamp   <= l_finish
133    ;
134    -- time preparation diff seconds
135    l_curr_date := SYSDATE;
136    l_runtime   := l_curr_date + ((l_setup_end - l_setup_start) * 86400) - l_curr_date;
137    l_return    := otap_test.ok(l_runtime < 60, 'otap_util.result_cleanup preparation performance seconds: ' || TO_CHAR(l_runtime, '90.09') || ' < 60');
138    IF '&ORG_MAINTENANCE_JOB' = 'TRUE'
139    THEN
140  	 -- enable job again
141  	 DBMS_SCHEDULER.ENABLE(name => 'OTAP_MAINTENANCE');
142    END IF;
143    -- reset debug mode
144    otap_util.set_config_value(otap_constants.OTAP_CFG_DEBUG_MODE, '&ORG_DEBUG_MODE');
145    -- test language cleanup before
146    DELETE FROM otap_translate WHERE language_id = otap_constants.OTAP_TEST_LANGUAGE_ID;
147    COMMIT;
