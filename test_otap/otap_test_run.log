 37    l_want	:= LPAD(' ', l_border, '-') || RPAD('a', l_strlen, 'a') || RPAD(' ', l_border, '-');
 38    l_return := otap_test.is_eq(l_have, l_want, 'otap_report.decorate string full min size min border' || l_ext);
